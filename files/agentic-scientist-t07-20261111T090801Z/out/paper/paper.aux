\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Held-out final evaluation (five benchmarks, three seeds, $k{=}100$). (A) Overall MAE of the stacked configuration and three baselines; baseline bars (hatched) are derived as candidate MAE plus the evaluator-reported gain. (B) Paired gain over the best baseline (the random-subset mean) in MAE and utility, with 95\% hierarchical bootstrap intervals; both intervals include zero.}}{6}{figure.caption.17}\protected@file@percent }
\newlabel{fig:main}{{2}{6}{Held-out final evaluation (five benchmarks, three seeds, $k{=}100$). (A) Overall MAE of the stacked configuration and three baselines; baseline bars (hatched) are derived as candidate MAE plus the evaluator-reported gain. (B) Paired gain over the best baseline (the random-subset mean) in MAE and utility, with 95\% hierarchical bootstrap intervals; both intervals include zero}{figure.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Sealed final evaluation on held-out benchmarks (five benchmarks, seeds 9101--9103, $k{=}100$). Gains are positive when the stacked configuration is better. ``Derived'' baseline MAEs equal candidate MAE plus the reported gain.}}{6}{table.caption.18}\protected@file@percent }
\newlabel{tab:final}{{1}{6}{Sealed final evaluation on held-out benchmarks (five benchmarks, seeds 9101--9103, $k{=}100$). Gains are positive when the stacked configuration is better. ``Derived'' baseline MAEs equal candidate MAE plus the reported gain}{table.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Extrapolation to targets stronger than all sources}{6}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Error and rank correlation by target regime for the selected stacked configuration. Development benchmarks (search evaluation, two seeds) and held-out benchmarks (final evaluation, three seeds) are different benchmark sets and are never pooled. (A) MAE. (B) Spearman correlation across targets.}}{7}{figure.caption.19}\protected@file@percent }
\newlabel{fig:gap}{{3}{7}{Error and rank correlation by target regime for the selected stacked configuration. Development benchmarks (search evaluation, two seeds) and held-out benchmarks (final evaluation, three seeds) are different benchmark sets and are never pooled. (A) MAE. (B) Spearman correlation across targets}{figure.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Development benchmarks (five benchmarks, seeds 11 and 12, $k{=}100$): three configurations of the same estimator family. The first row is the linear model-assisted estimator; the second is the configuration carried to the held-out evaluation; the third adds bagged posterior means and tail calibration. Utility is the aggregate defined in Section~\ref {sec:protocol}. Full metrics are in Table~\ref {tab:search-full}.}}{7}{table.caption.20}\protected@file@percent }
\newlabel{tab:search}{{2}{7}{Development benchmarks (five benchmarks, seeds 11 and 12, $k{=}100$): three configurations of the same estimator family. The first row is the linear model-assisted estimator; the second is the configuration carried to the held-out evaluation; the third adds bagged posterior means and tail calibration. Utility is the aggregate defined in Section~\ref {sec:protocol}. Full metrics are in Table~\ref {tab:search-full}}{table.caption.20}{}}
