chat_template([{'role':'user','content':prompt+'\\n\\n'+question}],tokenize=False,add_generation_prompt=True)\n   607\t                    tokens=tokenizer(text,add_special_tokens=False)['input_ids']\n   608\t                    if len(tokens)>2044:\n   609\t                        cache[key]=-1\n   610\t                        continue\n   611\t                    missing.append((row_index,arm,key,tokens))\n   612\t        missing.sort(key=lambda item:len(item[3]))\n   613\t        for offset in range(0,len(missing),8):\n   614\t            batch=missing[offset:offset+8]\n   615\t            if generated_calls+len(batch)>16*4096:\n   616\t                raise RuntimeError('inference call ceiling')\n   617\t            inputs=tokenizer.pad({'input_ids':[item[3] for item in batch]},padding=True,return_tensors='pt')\n   618\t            with torch.inference_mode():\n   619\t                legal_tokens=[]\n   620\t                for item in batch:\n   621\t                    legal=[]\n   622\t                    for letter in range(len(rows[item[0]]['options'])):\n   623\t                        encoded=tokenizer.encode(chr(65+letter),add_special_tokens=False)\n   624\t                        if len(encoded)!=1:\n   625\t                            raise RuntimeError('answer-letter tokenization unsupported')\n   626\t                        legal.append(encoded[0])\n   627\t                    legal_tokens.append(legal)\n   628\t                output=model.generate(**inputs,do_sample=False,max_new_tokens=1,pad_token_id=tokenizer.pad_token_id,use_cache=True,prefix_allowed_tokens_fn=lambda batch_index,input_ids:legal_tokens[batch_index])\n   629\t            generated_calls+=len(batch)\n   630\t            generated_tokens+=len(batch)*(output.shape[1]-inputs['input_ids'].shape[1])\n   631\t            if generated_tokens>16*4096*4:\n   632\t                raise RuntimeError('inference token ceiling')\n   633\t            for item,sequence in zip(batch,output):\n   634\t                text=tokenizer.decode(sequence[inputs['input_ids'].shape[1]:],skip_special_tokens=True).strip()\n   635\t                match=re.fullmatch(r'([A-J])(?:[.\\s]*)',text)\n   636\t                answer=ord(match.group(1))-65 if match else -1\n   637\t                cache[item[2]]=answer\n   638\t                predictions[item[0]][item[1]]=answer\n   639\t        print(json.dumps({'predictions':predictions},separators=(',',':')),flush=True)\n   640\t\n   641\tclass Baseline:\n   642\t    def __init__(self,root,deadline):\n   643\t        environment={name:os.environ[name] for name in ['PATH','LD_LIBRARY_PATH','LANG','LC_ALL','TZ'] if name in os.environ}\n   644\t        environment.update(HOME='/nonexistent',PYTHONNOUSERSITE='1',PYTHONDONTWRITEBYTECODE='1',PYTHONUNBUFFERED='1',OMP_NUM_THREADS='6',OPENBLAS_NUM_THREADS='6',MKL_NUM_THREADS='6',HF_HUB_OFFLINE='1',TRANSFORMERS_OFFLINE='1',TOKENIZERS_PARALLELISM='false')\n   645\t        for name in ['AGENTIC_TASK_DRAFT_SMOKE','AGENTIC_TASK_QUALIFICATION']:\n   646\t            if os.environ.get(name)=='1':\n   647\t                environment[name]='1'\n   648\t        self.worker=PipeWorker([sys.executable,'-I','-u',str(Path(__file__).resolve()),'--inference_worker',str(root)],environment)\n   649\t        self.failure=None\n   650\t        try:\n   651\t            if self.worker.read(min(45,deadline-time.monotonic()))!={'ready':True}:\n   652\t                raise ProtocolFailure('invalid baseline readiness')\n   653\t        except (TimeoutError,ProtocolFailure) as error:\n   654\t            self.failure='baseline_timeout' if isinstance(error,TimeoutError) else self.status() or 'baseline_result_failure'\n   655\t            record_failure(self.failure)\n   656\t            try:\n   657\t                self.worker.close(failed=True,component='baseline')\n   658\t            except Exception:\n   659\t                error.add_note('baseline cleanup failed')\n   660\t    def status(self):\n   661\t        if self.failure:\n   662\t            return self.failure\n   663\t        code=self.worker.process.poll()\n   664\t        return None if code is None else ('baseline_signal' if code<0 else 'baseline_exit')\n   665\t    def fail(self,category):\n   666\t        self.failure=category\n   667\t        fail_required_baseline(category,lambda:self.worker.close(failed=True,component='baseline'),record_failure)\n   668\t    def call(self,request,timeout):\n   669\t        category=self.status()\n   670\t        if category:\n   671\t            self.fail(category)\n   672\t        try:\n   673\t            result=self.worker.call(request,timeout)\n   674\t            category=self.status()\n   675\t            if category:\n   676\t                self.fail(category)\n   677\t            return result\n   678\t        except (TimeoutError,ProtocolFailure) as error:\n   679\t            if isinstance(error,ProtocolFailure) and self.worker.process.poll() is None:\n   680\t                try:\n   681\t                    self.worker.process.wait(timeout=.05)\n   682\t                except subprocess.TimeoutExpired:\n   683\t                    pass\n   684\t            self.fail(self.status() or ('baseline_timeout' if isinstance(error,TimeoutError) else 'baseline_result_failure'))\n   685\t    def close(self):\n   686\t        self.worker.close(component='baseline')\n   687\t\n   688\tdef normalized(text):\n   689\t    return ' '.join(unicodedata.normalize('NFKC',text).split())\n   690\t\n   691\tdef digest(value):\n   692\t    return hashlib.sha256(json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()\n   693\t\n","exit_code":0,"status":"completed"}}
