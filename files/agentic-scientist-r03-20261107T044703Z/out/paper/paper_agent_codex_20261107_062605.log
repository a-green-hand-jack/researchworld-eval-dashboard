{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/sh -lc \"/tmp/apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: retrieve_allowed_references.py\n@@\n-    ('Mazumder', 'ARXIV:1001.3011'), ('Jain', 'ARXIV:1212.0467'),\n+    ('Mazumder', 'TITLE:Spectral Regularization Algorithms for Learning Large Incomplete Matrices'),\n+    ('PMF', 'TITLE:Probabilistic Matrix Factorization'), ('Jain', 'ARXIV:1212.0467'),\n@@\n-    ('Sherman', 'DOI:10.1214/aoms/1177729893'),\n@@\n-    ('Little', 'DOI:10.1002/9781119482260'),\n@@\n def fetch(record):\n     key, identifier = record\n+    if identifier.startswith('TITLE:'):\n+        url = 'https://api.openalex.org/works'\n+        response = requests.get(url, params={'search': identifier[6:], 'per-page': 1}, timeout=60)\n+        response.raise_for_status()\n+        data = response.json()['results'][0]\n+        assert data['title'].lower().replace('-', ' ') == identifier[6:].lower().replace('-', ' '), data['title']\n+        sequence = {position: word for word, indexes in (data.get('abstract_inverted_index') or {}).items() for position in indexes}\n+        abstract = ' '.join(sequence[index] for index in sorted(sequence))\n+        authors = ' and '.join(item['author']['display_name'] for item in data['authorships'])\n+        bib = '@article{' + key + ',\\\\n title = {' + data['title'] + '},\\\\n author = {' + authors + '},\\\\n year = {' + str(data['publication_year']) + '}\\\\n}'\n+        return key, data['id'], response.url, data, bib, abstract\n*** End Patch\nPATCH\npython retrieve_allowed_references.py > /tmp/literature-retrieval.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
