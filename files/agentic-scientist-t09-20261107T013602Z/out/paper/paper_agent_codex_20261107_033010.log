{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,220p' .codex/skills/retrieve-references/scripts/s2_fetch.py; sed -n '1,130p' .codex/skills/retrieve-references/scripts/openalex_fetch.py; sed -n '1,120p' .codex/skills/validate-paper/scripts/validate_figures.py; sed -n '1,130p' .codex/skills/validate-paper/scripts/compile_latex.sh; cat paper.sty | head -38\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Fetch reference candidates from Semantic Scholar APIs.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport time\nimport urllib.error\nimport urllib.parse\nimport urllib.request\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nBASE_URL = \"https://api.semanticscholar.org/graph/v1\"\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef http_json(url: str, *, timeout: int, api_key: str | None) -> dict[str, Any]:\n    \"\"\"Handle http json logic for this module.\"\"\"\n    max_attempts = 5\n    for attempt in range(1, max_attempts + 1):\n        req = urllib.request.Request(\n            url,\n            headers={\n                \"Accept\": \"application/json\",\n                **({\"x-api-key\": api_key} if api_key else {}),\n            },\n            method=\"GET\",\n        )\n        try:\n            with urllib.request.urlopen(req, timeout=timeout) as response:\n                payload = json.loads(response.read().decode(\"utf-8\"))\n        except urllib.error.HTTPError as exc:\n            if exc.code in {403, 429} and attempt < max_attempts:\n                retry_after = exc.headers.get(\"Retry-After\")\n                try:\n                    wait_seconds = float(retry_after) if retry_after is not None else 1.5 * attempt\n                except ValueError:\n                    wait_seconds = 1.5 * attempt\n                time.sleep(max(0.5, min(wait_seconds, 20.0)))\n                continue\n            raise SystemExit(f\"Semantic Scholar HTTP {exc.code}: {url}\") from exc\n        except urllib.error.URLError as exc:\n            raise SystemExit(f\"Semantic Scholar request failed: {exc}\") from exc\n        except json.JSONDecodeError as exc:\n            raise SystemExit(f\"Semantic Scholar returned invalid JSON: {exc}\") from exc\n\n        if not isinstance(payload, dict):\n            raise SystemExit(\"Semantic Scholar response was not a JSON object.\")\n        return payload\n\n    raise SystemExit(f\"Semantic Scholar request failed after retries: {url}\")\n\n\ndef search(query: str, *, limit: int, timeout: int, api_key: str | None) -> list[dict[str, Any]]:\n    \"\"\"Handle search logic for this module.\"\"\"\n    params = urllib.parse.urlencode(\n        {\n            \"query\": query,\n            \"limit\": str(limit),\n            \"fields\": \"paperId,title,year,venue,citationCount\",\n        }\n    )\n    payload = http_json(f\"{BASE_URL}/paper/search?{params}\", timeout=timeout, api_key=api_key)\n    rows = payload.get(\"data\")\n    if not isinstance(rows, list):\n        return []\n    return [row for row in rows if isinstance(row, dict)]\n\n\ndef details(paper_id: str, *, timeout: int, api_key: str | None) -> dict[str, Any]:\n    \"\"\"Handle details logic for this module.\"\"\"\n    safe_paper_id = urllib.parse.quote(paper_id, safe=\"\")\n    params = urllib.parse.urlencode({\"fields\": \"paperId,title,year,venue,citationCount,citationStyles,url\"})\n    return http_json(f\"{BASE_URL}/paper/{safe_paper_id}?{params}\", timeout=timeout, api_key=api_key)\n\n\ndef bibtex_key(bibtex: str) -> str | None:\n    \"\"\"Handle bibtex key logic for this module.\"\"\"\n    match = KEY_RE.search(bibtex)\n    if not match:\n        return None\n    key = match.group(1).strip()\n    return key or None\n\n\ndef normalize_queries(values: list[str]) -> list[str]:\n    \"\"\"Normalize queries.\"\"\"\n    seen: set[str] = set()\n    out: list[str] = []\n    for query in values:\n        clean = \" \".join(query.split()).strip()\n        if not clean:\n            continue\n        if len(clean) > 200:\n            clean = clean[:200].rstrip()\n        token = clean.lower()\n        if token in seen:\n            continue\n        seen.add(token)\n        out.append(clean)\n    return out\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Fetch grounded BibTeX references from Semantic Scholar.\")\n    parser.add_argument(\"--query\", action=\"append\", default=[], help=\"Search query (repeatable).\")\n    parser.add_argument(\"--min-refs\", type=int, default=8, help=\"Minimum required references.\")\n    parser.add_argument(\"--max-refs\", type=int, default=15, help=\"Maximum references to keep.\")\n    parser.add_argument(\"--search-limit\", type=int, default=25, help=\"Search hits per query.\")\n    parser.add_argument(\"--timeout-seconds\", type=int, default=20, help=\"Request timeout.\")\n    parser.add_argument(\"--out-bib\", required=True, help=\"Output path for references.bib.\")\n    parser.add_argument(\"--out-json\", required=True, help=\"Output path for provenance JSON.\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    if args.min_refs <= 0:\n        raise SystemExit(\"--min-refs must be > 0\")\n    if args.max_refs < args.min_refs:\n        raise SystemExit(\"--max-refs must be >= --min-refs\")\n    if args.search_limit <= 0:\n        raise SystemExit(\"--search-limit must be > 0\")\n    if args.timeout_seconds <= 0:\n        raise SystemExit(\"--timeout-seconds must be > 0\")\n\n    api_key = os.environ.get(\"S2_API_KEY\")\n    queries = normalize_queries(list(args.query))\n    if not queries:\n        raise SystemExit(\"At least one non-empty --query is required.\")\n\n    references: list[dict[str, Any]] = []\n    used_keys: set[str] = set()\n    seen_paper_ids: set[str] = set()\n    for query in queries:\n        if len(references) >= args.min_refs:\n            break\n        query_candidates: list[dict[str, Any]] = []\n        for row in search(query, limit=args.search_limit, timeout=args.timeout_seconds, api_key=api_key):\n            paper_id = row.get(\"paperId\")\n            if not isinstance(paper_id, str) or not paper_id.strip():\n                continue\n            paper_id = paper_id.strip()\n            if paper_id in seen_paper_ids:\n                continue\n            query_candidates.append(\n                {\n                    \"paper_id\": paper_id,\n                    \"query\": query,\n                    \"citation_count\": int(row.get(\"citationCount\") or 0),\n                }\n            )\n\n        ranked = sorted(query_candidates, key=lambda item: (-int(item[\"citation_count\"]), item[\"paper_id\"]))\n        for row in ranked:\n            if len(references) >= args.min_refs:\n                break\n            paper_id = str(row[\"paper_id\"])\n            seen_paper_ids.add(paper_id)\n            payload = details(paper_id, timeout=args.timeout_seconds, api_key=api_key)\n            citation_styles = payload.get(\"citationStyles\")\n            bibtex = citation_styles.get(\"bibtex\") if isinstance(citation_styles, dict) else None\n            if not isinstance(bibtex, str) or not bibtex.strip():\n                continue\n            key = bibtex_key(bibtex)\n            if key is None or key in used_keys:\n                continue\n            used_keys.add(key)\n            references.append(\n                {\n                    \"id\": f\"ref.s2.{paper_id}\",\n                    \"paper_id\": paper_id,\n                    \"citation_key\": key,\n                    \"title\": payload.get(\"title\"),\n                    \"year\": payload.get(\"year\"),\n                    \"venue\": payload.get(\"venue\"),\n                    \"citation_count\": payload.get(\"citationCount\", row[\"citation_count\"]),\n                    \"query\": row[\"query\"],\n                    \"source_url\": f\"{BASE_URL}/paper/{urllib.parse.quote(paper_id, safe='')}\",\n                    \"retrieved_at\": utc_now(),\n                    \"bibtex\": bibtex.strip(),\n                }\n            )\n\n    if len(references) < args.min_refs:\n        raise SystemExit(\n            f\"Not enough grounded references: {len(references)} < required {args.min_refs}\"\n        )\n\n    out_bib = Path(args.out_bib)\n    out_json = Path(args.out_json)\n    out_bib.parent.mkdir(parents=True, exist_ok=True)\n    out_json.parent.mkdir(parents=True, exist_ok=True)\n\n    out_bib.write_text(\"\\n\\n\".join(row[\"bibtex\"] for row in references) + \"\\n\", encoding=\"utf-8\")\n    out_json.write_text(\n        json.dumps(\n            {\n                \"generated_at\": utc_now(),\n                \"count\": len(references),\n                \"queries\": queries,\n                \"references\": [{k: v for k, v in row.items() if k != \"bibtex\"} for row in references],\n            },\n            indent=2,\n            sort_keys=True,\n        ),\n        encoding=\"utf-8\",\n    )\n    print(f\"Wrote {len(references)} references to {out_bib} and {out_json}\")\n    return 0\n#!/usr/bin/env python3\n\"\"\"Search OpenAlex and retrieve BibTeX entries for matching works.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport sys\nimport unicodedata\nimport urllib.parse\nimport urllib.request\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\n\nOPENALEX_WORKS_URL = \"https://api.openalex.org/works\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Retrieve BibTeX entries for a query using OpenAlex works search.\"\n    )\n    parser.add_argument(\"--query\", action=\"append\", default=[], help=\"OpenAlex works search query.\")\n    parser.add_argument(\"--min-refs\", type=int, default=8, help=\"Minimum required references.\")\n    parser.add_argument(\"--max-refs\", type=int, default=15, help=\"Maximum references to keep.\")\n    parser.add_argument(\"--search-limit\", type=int, default=10, help=\"Maximum OpenAlex results per query.\")\n    parser.add_argument(\n        \"--mailto\",\n        default=os.getenv(\"OPENALEX_EMAIL\"),\n        help=\"Contact email for OpenAlex polite pool.\",\n    )\n    parser.add_argument(\n        \"--allow-partial-output\",\n        action=\"store_true\",\n        help=\"Write any retrieved references even if count < --min-refs, then exit nonzero.\",\n    )\n    parser.add_argument(\"--out-bib\", required=True, help=\"Output path for references.bib.\")\n    parser.add_argument(\"--out-json\", required=True, help=\"Output path for provenance JSON.\")\n    return parser.parse_args()\n\n\ndef fetch_json(url: str) -> dict[str, Any]:\n    \"\"\"Fetch a JSON object from a URL.\"\"\"\n    req = urllib.request.Request(url, headers={\"Accept\": \"application/json\"}, method=\"GET\")\n    with urllib.request.urlopen(req, timeout=30) as response:\n        payload = json.loads(response.read().decode(\"utf-8\"))\n    if not isinstance(payload, dict):\n        raise SystemExit(f\"Expected JSON object from {url}\")\n    return payload\n\n\ndef normalize_queries(values: list[str]) -> list[str]:\n    \"\"\"Normalize queries without injecting generic fallback terms.\"\"\"\n    seen: set[str] = set()\n    out: list[str] = []\n    for query in values:\n        clean = \" \".join(query.split()).strip()\n        if not clean:\n            continue\n        if len(clean) > 200:\n            clean = clean[:200].rstrip()\n        token = clean.lower()\n        if token in seen:\n            continue\n        seen.add(token)\n        out.append(clean)\n    return out\n\n\ndef search_openalex(query: str, *, limit: int, mailto: str | None) -> list[dict[str, Any]]:\n    \"\"\"Search OpenAlex works.\"\"\"\n    params = {\"search\": query, \"per-page\": str(limit)}\n    if mailto:\n        params[\"mailto\"] = mailto\n    payload = fetch_json(f\"{OPENALEX_WORKS_URL}?{urllib.parse.urlencode(params)}\")\n    results = payload.get(\"results\")\n    if not isinstance(results, list):\n        return []\n    return [row for row in results if isinstance(row, dict)]\n\n\ndef _has_non_latin_letters(name: str) -> bool:\n    \"\"\"Detect letters outside the Latin script, e.g. Cyrillic homoglyphs in profile names.\"\"\"\n    return any(ch.isalpha() and \"LATIN\" not in unicodedata.name(ch, \"\") for ch in name)\n\n\ndef author_names_from_work(work: dict[str, Any]) -> list[str]:\n    \"\"\"Extract ordered author names from an OpenAlex work.\"\"\"\n    authorships = work.get(\"authorships\")\n    if not isinstance(authorships, list):\n        return []\n\n    names: list[str] = []\n    seen: set[str] = set()\n    for authorship in authorships:\n        if not isinstance(authorship, dict):\n            continue\n        author = authorship.get(\"author\")\n        display_name = \"\"\n        if isinstance(author, dict):\n            raw_display_name = author.get(\"display_name\")\n            if isinstance(raw_display_name, str):\n                display_name = \" \".join(raw_display_name.split()).strip()\n        raw_author_name = authorship.get(\"raw_author_name\")\n        fallback_name = (\n            \" \".join(raw_author_name.split()).strip()\n            if isinstance(raw_author_name, str)\n            else \"\"\n        )\n        if display_name and fallback_name and _has_non_latin_letters(display_name):\n            display_name = \"\"\n        name = display_name or fallback_name\n        if not name:\n            continue\n        key = name.casefold()\n        if key in seen:\n            continue\n        seen.add(key)\n        names.append(name)\n    return names\n\n\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n%%%% ICLR Macros (LaTex)\n%%%% Adapted by Hugo Larochelle from the NIPS stylefile Macros\n%%%% Style File\n%%%% Dec 12, 1990   Rev Aug 14, 1991; Sept, 1995; April, 1997; April, 1999; October 2014\n\n% This file can be used with Latex2e whether running in main mode, or\n% 2.09 compatibility mode.\n%\n% If using main mode, you need to include the commands\n%             \\documentclass{article}\n%             \\usepackage{iclr14submit_e,times}\n%\n\n% Change the overall width of the page.  If these parameters are\n%       changed, they will require corresponding changes in the\n%       maketitle section.\n%\n\\usepackage{eso-pic} % used by \\AddToShipoutPicture\n\\RequirePackage{fancyhdr}\n\\RequirePackage{natbib}\n\n% modification to natbib citations\n\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n\n\\renewcommand{\\topfraction}{0.95}   % let figure take up nearly whole page\n\\renewcommand{\\textfraction}{0.05}  % let figure take up nearly whole page\n\n% Define iclrfinal, set to true if iclrfinalcopy is defined\n\\newif\\ificlrfinal\n\\iclrfinalfalse\n\\def\\iclrfinalcopy{\\iclrfinaltrue}\n\\font\\iclrtenhv  = phvb at 8pt\n\n% Specify the dimensions of each page\n\n\\setlength{\\paperheight}{11in}\n\\setlength{\\paperwidth}{8.5in}\n\n","exit_code":0,"status":"completed"}}
