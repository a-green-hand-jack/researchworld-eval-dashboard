 \"completed\": true,\n      \"structural_failure\": 1.0\n    },\n    {\n      \"case\": \"commonsense\",\n      \"seed\": 5003,\n      \"condition\": \"permuted\",\n      \"completed\": true,\n      \"structural_failure\": 1.0\n    },\n    {\n      \"case\": \"commonsense\",\n      \"seed\": 5003,\n      \"condition\": \"primary\",\n      \"completed\": false,\n      \"structural_failure\": 1.0\n    },\n    {\n      \"case\": \"commonsense\",\n      \"seed\": 9001,\n      \"condition\": \"constant\",\n      \"completed\": true,\n      \"structural_failure\": 1.0\n    },\n    {\n      \"case\": \"commonsense\",\n      \"seed\": 9001,\n      \"condition\": \"copy\",\n      \"completed\": true,\n      \"structural_failure\": 1.0\n    },\n    {\n      \"case\": \"commonsense\",\n      \"seed\": 9001,\n      \"condition\": \"no_calibration\",\n      \"completed\": true,\n      \"structural_failure\": 1.0\n    },\n    {\n      \"case\": \"commonsense\",\n      \"seed\": 9001,\n      \"condition\": \"permuted\",\n      \"completed\": true,\n      \"structural_failure\": 1.0\n    },\n    {\n      \"case\": \"commonsense\",\n      \"seed\": 9001,\n      \"condition\": \"primary\",\n      \"completed\": false,\n      \"structural_failure\": 1.0\n    }\n  ]\n}\n[\n  {\n    \"seed\": 5003,\n    \"commonsense\": {\n      \"baseline_predictions\": false,\n      \"conditions\": {\n        \"constant\": {\n          \"completed\": true,\n          \"structural_failure\": 1.0,\n          \"present\": true\n        },\n        \"copy\": {\n          \"completed\": true,\n          \"structural_failure\": 1.0,\n          \"present\": true\n        },\n        \"no_calibration\": {\n          \"completed\": true,\n          \"structural_failure\": 1.0,\n          \"present\": true\n        },\n        \"no_diversity\": {\n          \"completed\": true,\n          \"structural_failure\": 0.0,\n          \"present\": true\n        },\n        \"permuted\": {\n          \"completed\": tr