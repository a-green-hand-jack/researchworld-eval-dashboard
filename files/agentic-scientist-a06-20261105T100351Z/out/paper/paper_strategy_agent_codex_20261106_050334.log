{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, pathlib, hashlib\nroot=pathlib.Path('.')\nstrategy=json.loads((root/'paper_strategy.json').read_text())\ndata=json.loads((root/'paper_data.json').read_text())\nrequired={'status','selected_prompt_family','recommended_title','central_question','central_thesis','narrative_rationale','prior_paper_story_status','edit_framing_decision','staged_input_impact','method_groups','results_focus','figure_plan','figure_specs','supplementary_plan','forbidden_headings','forbidden_phrases','notes_for_writer','failure_reason'}\nassert required <= strategy.keys()\nassert strategy['status']=='ready' and strategy['failure_reason']==''\nassert strategy['selected_prompt_family']=='paper_standalone'\nassert strategy['prior_paper_story_status'] in {'preserved','broadened','recentered','rejected'}\nassert strategy['supplementary_plan']['purpose']\nassert strategy['supplementary_plan']['planned_subsections']\nassert len(strategy['figure_specs'])==len(strategy['figure_plan'])\nassert sum(spec['preferred_generator']=='generate-concept-figure' for spec in strategy['figure_specs'])==1\nsource_ids=set(data['grounding_sources'])\nfor section in strategy['supplementary_plan']['planned_subsections']:\n    assert section['heading'] and section['grounded_content'] and section['source_ids']\n    assert set(section['source_ids'])<=source_ids\nfor spec in strategy['figure_specs']:\n    assert spec['required'] and spec['layout_rationale'] and not spec['allow_progression']\n    assert spec['max_panels']<=4 and spec['max_panels_per_row']<=3\n    assert spec['max_categories_per_panel']<=6 and spec['max_series_per_panel']<=4\n    assert spec['preferred_span'] in {'column','full_width'}\n    assert spec['target_width_fraction']<=1\n    assert set(spec['source_ids'])<=source_ids\n    if spec['figure_type']=='diagram':\n        assert spec['preferred_generator']=='generate-concept-figure'\nfor name in ['paper.tex','claims_grounding.json']:\n    assert not (root/name).exists(), name\nassert hashlib.sha256((root/'task/evaluate_final.py').read_bytes()).hexdigest()==data['final_evaluation']['evaluator_sha256'].removeprefix('sha256:')\nassert (root/'source_evidence/downstream/program/src/program.py').read_bytes()==(root/'source_evidence/downstream/baseline/src/program.py').read_bytes()\nassert data['grounding_sources']['final.qualification.outcome']['value']=='qualified'\nassert sum([1.25,.75,1.5,1,2,.75,1.25])==8.5\nprint('PASS: strategy contract, source IDs, figure budgets, scope checks, exact evaluator linkage, source equality, and page allocation.')\nprint('No final-paper validator, inference, simulations, or figure generation executed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
