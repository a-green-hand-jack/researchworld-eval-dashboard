\newlabel{tab:yard@cref}{{[table][3][]3}{[1][5][]5}{}{}{}}
\newlabel{tab:cert}{{4}{5}{Single-run certificate ($z\ge 1.96$) from permutation runs, mean over four datasets, runs $\times $ instances $\times $ models pooled. acc.: fraction of runs whose top-1 (top-3 set) equals the exact (German: high-budget) reference; coverage: fraction certified; brackets: minimum over datasets}{table.caption.7}{}}
\newlabel{tab:cert@cref}{{[table][4][]4}{[1][5][]5}{}{}{}}
\citation{gorishniy2021}
\newlabel{fig:yard}{{3}{6}{Mean top-3 Jaccard (95\% bootstrap CI over instances) between two independent draws from each source of variability, by dataset and model. perm/kernel$k$d: coalition-sampling noise at $m=k\,d$ (fixed model and background); bg$B$: random backgrounds of size $B$ (exact attributions); retrain: bootstrap-retrained models; pathdep: path-dependent vs.\ interventional TreeSHAP (trees); between\_instance: two different instances (chance level)}{figure.caption.5}{}}
\newlabel{fig:yard@cref}{{[figure][3][]3}{[1][5][]6}{}{}{}}
\newlabel{tab:split}{{5}{6}{Averaging $k$ runs of budget $m/k$ vs.\ one run of budget $m$ (pooled over cells where defined): median over cells of the per-cell median ratio of relative errors to the reference; mean top-3 accuracy}{table.caption.8}{}}
