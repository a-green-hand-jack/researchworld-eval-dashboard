of LLMs},\n year = {2024}\n}\n\n@Article{Xiao2023EvaluatingRC,\n author = {Changrong Xiao and Sean Xin Xu and Kunpeng Zhang and Yufang Wang and Lei Xia},\n booktitle = {Workshop on Innovative Use of NLP for Building Educational Applications},\n pages = {610-625},\n title = {Evaluating Reading Comprehension Exercises Generated by LLMs: A Showcase of ChatGPT in Education Applications},\n year = {2023}\n}\n","exit_code":0,"status":"completed"}}
