\n    ],\n    \"form\": \"count_deg\",\n    \"intercept\": 1.0,\n    \"kappa\": 0.15,\n    \"m_ref\": 10.0,\n    \"sigma\": 1.0,\n    \"tau0\": 1.0,\n    \"tau1\": 0.5\n   },\n   \"name\": \"ba_count_degdep_bernoulli\"\n  },\n  {\n   \"design\": {\n    \"kind\": \"bernoulli\",\n    \"p\": 0.5\n   },\n   \"graph\": {\n    \"blocks\": 10,\n    \"deg_in\": 14,\n    \"deg_out\": 6,\n    \"family\": \"sbm\"\n   },\n   \"id\": 8,\n   \"mech\": {\n    \"beta\": [\n     0.8,\n     -0.5\n    ],\n    \"form\": \"fraction_2hop\",\n    \"gamma\": 1.5,\n    \"gamma2\": 2.0,\n    \"intercept\": 1.0,\n    \"sigma\": 1.0,\n    \"tau0\": 1.0,\n    \"tau1\": 0.5\n   },\n   \"name\": \"sbm_2hop_bernoulli\"\n  }\n ],\n \"gate_floor\": 0.5,\n \"n_production\": 3000,\n \"n_smoke\": 300,\n \"plane\": \"final\",\n \"schema_version\": 1\n}\n\n214c214\n<  \"plane\": \"final\",\n---\n>  \"plane\": \"search\",\n   336 frozen_estimator/program.py\n  1308 evaluator/evaluate.py\n  1308 evaluator/evaluate_final.py\n  2952 total","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
