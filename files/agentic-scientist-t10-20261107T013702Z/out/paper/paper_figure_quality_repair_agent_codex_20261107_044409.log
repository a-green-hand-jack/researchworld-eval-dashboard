age_width_comparison.pdf\",\n      \"path_png\": \"figures/coverage_width_comparison.png\",\n      \"placement\": \"full_width\",\n      \"series_per_panel\": [\n        4,\n        4,\n        4,\n        4\n      ],\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"uses_abbrev_labels\": true,\n      \"uses_progression\": false\n    },\n    {\n      \"categories_per_panel\": [\n        4,\n        4\n      ],\n      \"estimated_min_rendered_font_pt\": 8.5,\n      \"figure_id\": \"rare_outcome_diagnostic\",\n      \"figure_type\": \"composite\",\n      \"font_sizes\": {\n        \"axis\": 9,\n        \"legend\": 8.5,\n        \"ticks\": 8.5,\n        \"title\": 9\n      },\n      \"generator\": \"matplotlib\",\n      \"intended_latex_width_fraction\": 1.0,\n      \"max_label_chars\": 30,\n      \"n_panels\": 2,\n      \"panels_per_row\": 2,\n      \"path_pdf\": \"figures/rare_outcome_diagnostic.pdf\",\n      \"path_png\": \"figures/rare_outcome_diagnostic.png\",\n      \"placement\": \"full_width\",\n      \"series_per_panel\": [\n        4,\n        4\n      ],\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"uses_abbrev_labels\": true,\n      \"uses_progression\": false\n    }\n  ]\n}\n\n--- GENERATOR ---\n19:def provenance(path, inputs=None):\n21:        \"schema_name\": \"scientific-evidence.artifact-manifest\",\n31:def save_panel(figure, name):\n34:        figure.savefig(path, dpi=300, facecolor=\"white\")\n39:def mean_interval(values):\n46:def main():\n107:    plt.rcParams.update({\"font.size\": 9, \"axes.titlesize\": 9, \"axes.labelsize\": 9,\n112:    figure, axes = plt.subplots(2, 2, figsize=(5.5, 4.3), gridspec_kw={\"width_ratios\": [1, 1.1]})\n142:    figure.legend(handles=handles, loc=\"upper center\", ncol=2, frameon=False, fontsize=9, bbox_to_anchor=(.51, 1.005))\n145:    figure, axes = plt.subplots(1, 2, figsize=(5.5, 2.3), gridspec_kw={\"width_ratios\": [1.25, 1]})\n155:    axes[1].set_yticks(range(4), [LABELS[index] for index in selected], fontsize=8.5)\n160:        axes[1].text(count + 2, position, str(count), va=\"center\", fontsize=9)\n163:    figure.legend(handles, labels, loc=\"upper center\", ncol=4, frameon=False, fontsize=8.5, bbox_to_anchor=(.5, 1.015), handlelength=1.2, columnspacing=.9)\n166:    concept = ROOT / \"figures\" / \"frozen_score_overview.png\"\n180:        (\"frozen_score_overview\", 1, 4, 2, 1.8),\n187:                 \"max_label_chars\": 30, \"font_sizes\": {\"title\": 9, \"axis\": 9, \"legend\": 8.5, \"ticks\": 8.5},\n198:    (ROOT / \"figure_manifest.json\").write_text(json.dumps({\"figures\": figures}, indent=2) + \"\\n\")\n\n--- ASSETS ---\ntotal 320\ndrwx------  2 agent agent   4096 Nov  7 05:46 .\ndrwx------ 10 agent agent   4096 Nov  7 05:50 ..\n-rw-r--r--  1 agent agent  29046 Nov  7 05:29 coverage_width_comparison.pdf\n-rw-r--r--  1 agent agent    494 Nov  7 05:29 coverage_width_comparison.pdf.prov.json\n-rw-r--r--  1 agent agent 143707 Nov  7 05:29 coverage_width_comparison.png\n-rw-r--r--  1 agent agent    494 Nov  7 05:29 coverage_width_comparison.png.prov.json\n-rw-r--r--  1 agent agent   7931 Nov  7 05:03 frozen_score_overview.png\n-rw-------  1 agent agent    183 Nov  7 05:46 frozen_score_overview.prompts.json\n-rw-r--r--  1 agent agent  17065 Nov  7 05:29 rare_outcome_diagnostic.pdf\n-rw-r--r--  1 agent agent    492 Nov  7 05:29 rare_outcome_diagnostic.pdf.prov.json\n-rw-r--r--  1 agent agent  89120 Nov  7 05:29 rare_outcome_diagnostic.png\n-rw-r--r--  1 agent agent    492 Nov  7 05:29 rare_outcome_diagnostic.png.prov.json\n\n--- VALIDATOR ---\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
