{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"rg -n '\"'^##|''^###'\"' paper_evidence_audit_packet.md; jq '{keys:keys,summary, reference_statuses:(.references // .results // []|group_by(.status)|map({status:.[0].status,n:length}))}' scientific-evidence/verification-report.json; jq '.claims|to_entries[]|select(.key>=29 and .key<41)' claims_grounding.json\"","aggregated_output":"9:## Expected audit focus\n18:## Artifact checklist\n27:## validation report summary\n46:## scientific-evidence verification summary\n62:## claims_grounding excerpt\n296:## paper_data summary\n319:## references provenance summary\n476:## manuscript source excerpt\n732:## supplementary information excerpt\n{\n  \"keys\": [\n    \"results\",\n    \"root_dir\",\n    \"schema_name\",\n    \"summary\",\n    \"verified_at\"\n  ],\n  \"summary\": {\n    \"anchored_references\": 87,\n    \"dangling_references\": 0,\n    \"manifests_checked\": 18,\n    \"resolved_references\": 148,\n    \"total_references\": 235\n  },\n  \"reference_statuses\": [\n    {\n      \"status\": \"anchored\",\n      \"n\": 87\n    },\n    {\n      \"status\": \"resolved\",\n      \"n\": 148\n    }\n  ]\n}\n{\n  \"key\": 29,\n  \"value\": {\n    \"claim\": \"Local IRT has lower seed-mean MAE on HELM MATH at 5/10/25, LegalBench at 5/25, MedQA at 10/25. The package has lower means on each leaderboard matrix and MMLU at each evaluated budget. No per-cell significance claims.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"analysis/paper_statistics.json#/local_irt_reversals\",\n      \"analysis/paper_statistics.json#/by_case_budget\"\n    ]\n  }\n}\n{\n  \"key\": 30,\n  \"value\": {\n    \"claim\": \"MedQA package MAE rises from 6.68 pp at 5 items to 7.47 at 10, falling to 5.54 at 25; no diagnosed cause.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"analysis/paper_statistics.json#/by_case_budget/med_qa\"\n    ]\n  }\n}\n{\n  \"key\": 31,\n  \"value\": {\n    \"claim\": \"All-zero target observations give MAE 21.58 pp; independently cyclically shifted source rows give 6.26 pp, versus ordinary-condition 3.90 pp. These are observation/representation interventions, not component ablations or proofs of validity.\",\n    \"source_ids\": [\n      \"final.metric.constant_mae\",\n      \"final.metric.permuted_mae\",\n      \"final.metric.mae\",\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/evaluator/evaluate_final.py#L844\"\n    ]\n  }\n}\n{\n  \"key\": 32,\n  \"value\": {\n    \"claim\": \"Source counterpart weighted covariance, full-score target, greedy conditional score-covariance criterion, content-group uniqueness, ridge/offset decoder, clipping and zero-query prior; Schur-complement rationale is an algebraic derivation, not an empirical component claim.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/selected/src/surrogate.py#L6\",\n      \"source_evidence/selected/src/surrogate.py#L31\",\n      \"source_evidence/selected/src/surrogate.py#L75\"\n    ]\n  }\n}\n{\n  \"key\": 33,\n  \"value\": {\n    \"claim\": \"Source counterpart lineage-disjoint refitting/tuning, two folds and 5/10/25 prefixes; optional outer nested decoder tuning.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/selected/src/surrogate.py#L111\",\n      \"source_evidence/selected/src/nonlinear_decoder.py#L142\"\n    ]\n  }\n}\n{\n  \"key\": 34,\n  \"value\": {\n    \"claim\": \"Source counterpart optional log-odds shift, prefix-matched residual ridge and linear fallback; per-case activation and isolated benefit unverified.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/selected/src/nonlinear_decoder.py#L18\",\n      \"source_evidence/selected/src/nonlinear_decoder.py#L65\"\n    ]\n  }\n}\n{\n  \"key\": 35,\n  \"value\": {\n    \"claim\": \"Settings cap 4 and fitting allowance 200; listed capped hyperparameters, 64 shift iterations, bounded shifts and clipping constants describe supplied counterpart, not selected final branch diagnostics.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/selected/src/nonlinear_decoder.py#L18\",\n      \"source_evidence/selected/src/nonlinear_decoder.py#L129\",\n      \"source_evidence/selected/src/surrogate.py#L111\",\n      \"source_evidence/evaluator/evaluate_final.py#L930\"\n    ]\n  }\n}\n{\n  \"key\": 36,\n  \"value\": {\n    \"claim\": \"Local baselines: content-group-mass weighted clipped uniform estimator, constant prior, normalized response embeddings/farthest-point anchors, logistic IRT with 200 source and 40 target updates and clipped initialization. Not exact published systems.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/evaluator/evaluate_final.py#L580\",\n      \"source_evidence/evaluator/evaluate_final.py#L598\"\n    ]\n  }\n}\n{\n  \"key\": 37,\n  \"value\": {\n    \"claim\": \"Lineage-weighted MAE and RMSE, lineage-mean rank correlations, average of cell RMSE rather than pooled RMSE.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/evaluator/evaluate_final.py#L556\",\n      \"source_evidence/evaluator/evaluate_final.py#L1014\",\n      \"source_evidence/evaluator/evaluate_final.py#L1040\"\n    ]\n  }\n}\n{\n  \"key\": 38,\n  \"value\": {\n    \"claim\": \"Known-lineage and common-stem safeguards are metadata-limited and do not prove undocumented ancestry or pretraining independence; retained-column scores differ from unreconciled originals.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/manifests/bbh_manifest.json#/limitations\",\n      \"source_evidence/manifests/bbh_manifest.json#/normalization\"\n    ]\n  }\n}\n{\n  \"key\": 39,\n  \"value\": {\n    \"claim\": \"Readable selection counterpart is supplied, but byte-for-byte source-tree identity is not independently certified. Digests are provenance, not substantive implementation support.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"source_evidence/inventory.json\",\n      \"paper_data.json#/final_evaluation/program_tree_sha256\"\n    ]\n  }\n}\n{\n  \"key\": 40,\n  \"value\": {\n    \"claim\": \"No controlled component ablations, per-case branch activation evidence, or new-benchmark interval; conclusions concern recorded packages, not isolated effects or guaranteed transfer.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/ablation_studies\",\n      \"paper_data.json#/final_evaluation/evaluation_evidence/candidate_diagnostics_trust\"\n    ]\n  }\n}\n","exit_code":0,"status":"completed"}}
