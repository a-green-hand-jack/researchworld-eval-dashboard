\"completed\": true,\n    \"control\": true,\n    \"curve\": [\n      0.9357741280705283,\n      0.9447961427615917,\n      0.9550593589250816\n    ],\n    \"replay\": false,\n    \"score\": 0.945209876585734,\n    \"source\": \"open_llm\",\n    \"split\": \"family\"\n  },\n  {\n    \"baselines\": {\n      \"constant\": 0.9146909518986389,\n      \"copy\": 0.9339719609434258,\n      \"medoid_ridge\": 0.9368695020583436,\n      \"random_lowrank\": 0.9411522553472295,\n      \"selected_ridge\": 0.9499597846739238\n    },\n    \"completed\": true,\n    \"control\": false,\n    \"curve\": [\n      0.9386602687206622,\n      0.9530725305237654,\n      0.9569015247261338,\n      0.9624027861518587\n    ],\n    \"replay\": true,\n    \"score\": 0.9527592775306051,\n    \"source\": \"mteb\",\n    \"split\": \"model\"\n  }\n]\n{\n  \"key\": null,\n  \"citation_key\": \"Zheng2013CollaborativeMF\",\n  \"title\": \"Collaborative matrix factorization with multiple similarities for predicting drug-target interactions\",\n  \"status\": null,\n  \"verification\": null,\n  \"source\": null\n}\n{\n  \"key\": null,\n  \"citation_key\": \"Ranjbar2015AnIM\",\n  \"title\": \"An imputation-based matrix factorization method for improving accuracy of collaborative filtering systems\",\n  \"status\": null,\n  \"verification\": null,\n  \"source\": null\n}\n{\n  \"key\": null,\n  \"citation_key\": \"Kannan2014BoundedMF\",\n  \"title\": \"Bounded matrix factorization for recommender system\",\n  \"status\": null,\n  \"verification\": null,\n  \"source\": null\n}\n{\n  \"key\": null,\n  \"citation_key\": \"Aljunid2018MovieRS\",\n  \"title\": \"Movie Recommender System Based on Collaborative Filtering Using Apache Spark\",\n  \"status\": null,\n  \"verification\": null,\n  \"source\": null\n}\n{\n  \"key\": null,\n  \"citation_key\": \"Zhang2012InducibleRF\",\n  \"title\": \"Inducible regularization for low-rank matrix factorizations for collaborative filtering\",\n  \"status\": null,\n  \"verif