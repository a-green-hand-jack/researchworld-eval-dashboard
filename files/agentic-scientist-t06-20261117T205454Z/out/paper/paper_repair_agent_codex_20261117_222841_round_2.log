\\\"c02_exact_refit_contender_screening_attempt_01\\\",\\n    \\\"id\\\": \\\"result.improvement_002\\\",\\n    \\\"idea_id\\\": \\\"c02_exact_refit_contender_screening\\\",\\n    \\\"program_dir\\\": \\\"work/results/t06/codex/20261117_205956/investigation/ideas/02_exact_refit_contender_screening/program_1\\\",\\n    \\\"program_id\\\": \\\"program_1\\\",\\n    \\\"type\\\": \\\"metric\\\",\\n    \\\"value\\\": 0.01595532053579999\\n  },\\n  \\\"result.top_program_01\\\": {\\n    \\\"attempt_id\\\": \\\"c02_exact_refit_contender_screening_attempt_01\\\",\\n    \\\"id\\\": \\\"result.top_program_01\\\",\\n    \\\"idea_id\\\": \\\"c02_exact_refit_contender_screening\\\",\\n    \\\"program_dir\\\": \\\"work/results/t06/codex/20261117_205956/investigation/ideas/02_exact_refit_contender_screening/program_1\\\",\\n    \\\"program_id\\\": \\\"program_1\\\",\\n    \\\"type\\\": \\\"metric\\\",\\n    \\\"value\\\": 0.01595532053579999\\n  },\\n  \\\"result.top_program_02\\\": {\\n    \\\"attempt_id\\\": \\\"c03_retained_curvature_shortlist_expansion_attempt_01\\\",\\n    \\\"id\\\": \\\"result.top_program_02\\\",\\n    \\\"idea_id\\\": \\\"c03_retained_curvature_shortlist_expansion\\\",\\n    \\\"program_dir\\\": \\\"work/results/t06/codex/20261117_205956/investigation/ideas/03_retained_curvature_shortlist_expansion/program_1\\\",\\n    \\\"program_id\\\": \\\"program_1\\\",\\n    \\\"type\\\": \\\"metric\\\",\\n    \\\"value\\\": 0.01595532053579999\\n  },\\n  \\\"result.top_program_03\\\": {\\n    \\\"attempt_id\\\": \\\"c01_dependence_aware_rank_reversal_frontiers_attempt_01\\\",\\n    \\\"id\\\": \\\"result.top_program_03\\\",\\n    \\\"idea_id\\\": \\\"c01_dependence_aware_rank_reversal_frontiers\\\",\\n    \\\"program_dir\\\": \\\"work/results/t06/codex/20261117_205956/investigation/ideas/01_dependence_aware_rank_reversal_frontiers/program_1\\\",\\n    \\\"program_id\\\": \\\"program_1\\\",\\n    \\\"type\\\": \\\"metric\\\",\\n    \\\"value\\\": 0.013240276724865765\\n  },\\n  \\\"result.total_attempts\\\": {\\n    \\\"id\\\": \\\"result.total_attempts\\\",\\n    \\\"type\\\": \\\"count\\\",\\n    \\\"value\\\": 3\\n  },\\n  \\\"result.total_correct_programs\\\": {\\n    \\\"id\\\": \\\"result.total_correct_programs\\\",\\n    \\\"type\\\": \\\"count\\\",\\n    \\\"value\\\": 3\\n  },\\n  \\\"result.total_evaluated_programs\\\": {\\n    \\\"id\\\": \\\"result.total_evaluated_programs\\\",\\n    \\\"type\\\": \\\"count\\\",\\n    \\\"value\\\": 3\\n  },\\n  \\\"result.total_ideas\\\": {\\n    \\\"id\\\": \\\"result.total_ideas\\\",\\n    \\\"type\\\": \\\"count\\\",\\n    \\\"value\\\": 3\\n  }\\n}\\nstatus \\\"ready\\\"\\nselected_prompt_family \\\"paper_standalone\\\"\\nrecommended_title \\\"Exact-Refit Audits of Pairwise Ranking Sensitivity\\\"\\ncentral_question \\\"How do small, influence-ordered deletions affect regularized Bradley\\\\u2013Terry rankings, and how does their disruption compare with random and high-loss deletion across crowd preferences and historical sports outcomes?\\\"\\ncentral_thesis \\\"A frozen-prefix audit with bounded exact-refit contender selection yields greater aggregate rank disruption than the measured deletion baselines on the final partitions, but its advantage depends on dataset and deletion budget, with fixed-mask group resampling favoring high-loss deletion in Arena and the studied selector in NBA.\\\"\\nnarrative_rationale \\\"The strongest evidence is the direct final comparison on two real-data settings and its conditional uncertainty analysis, not an optimization success story. Use one common sensitivity question with condition-specific evidence blocks, not a causal test of evaluation design. The inspected implementation supports the mechanism description; evaluator refits support measured effectiveness. Search configurations are descriptive supporting material, not independently replicated final ablations. The paper is viable as a bounded empirical audit without universal superiority or novelty-priority claims.\\\"\\nprior_paper_story_status \\\"recentered\\\"\\nedit_framing_decision \\\"This is fresh framing, not an edit pass: no resolved edit-context files, previous_paper, aggregated, extra_tasks, or prior manuscript are staged. The status means recentering the source-task brief, not editing an unseen paper. Compare three alternatives: preserving the proposed dependence-aware, multi-judge frontier story is unsupported; broadening to a universal cross-design robustness method overstates unmatched evidence; centering the shared frozen-prefix row-deletion audit and heterogeneous measured limits is supported. Method detail and figure density are not reasons to preserve an unsupported story.\\\"\\nstaged_input_impact [\\n  \\\"Read final_evaluation independently: final.qualification.status=completed, final.qualification.outcome=qualified, final.qualification.correct=true. There is no downstream_study or study.* grounding. Qualification is not statistical superiority or generalization; missing additional gate diagnostics remain unknown.\\\",\\n  \\\"results/best_program_manifest.json identifies the six-contender exact-refit configuration. Its inspected source supports the named method family; final provenance records a program-tree digest, but an independent reconstruction of that digest is not claimed.\\\",\\n  \\\"Final episodes cover Arena and NBA, not the proposed MT-Bench expert/GPT-4 comparisons. Provenance groups support partitioning and conditional resampling, not whole-group deletion or design labels available to the selector.\\\",\\n  \\\"Final dataset/budget contrasts and unique fixed-mask bootstrap records shift the thesis away from a general improvement claim. Reversed-row cases are controls, not extra datasets; repeated bootstrap exports are not new resamples.\\\",\\n  \\\"Clean-Hessian selection and retained-curvature expansion have descriptive search evidence only. No valid grounded metric for the original starter comparator supports retaining its quantitative comparison.\\\",\\n  \\\"References and provenance include irrelevant retrieval matches and do not resolve all exact planned identities. The bibliography is not evidence of a completed literature review or established novelty.\\\"\\n]\\nmethod_groups [\\n  {\\n    \\\"name\\\": \\\"Frozen-prefix bounded exact-refit selector\\\",\\n    \\\"role\\\": \\\"proposed\\\",\\n    \\\"include_reason\\\": \\\"The studied six-contender configuration computes clean influence orders, selects using retained-data refits, and returns frozen nested prefixes for independent evaluation.\\\"\\n  },\\n  {\\n    \\\"name\\\": \\\"Uniform random row deletion\\\",\\n    \\\"role\\\": \\\"baseline\\\",\\n    \\\"include_reason\\\": \\\"Measured at identical floored row budgets; five seeds reflect deletion randomness, not independent dataset draws.\\\"\\n  },\\n  {\\n    \\\"name\\\": \\\"High-loss row deletion\\\",\\n    \\\"role\\\": \\\"baseline\\\",\\n    \\\"include_reason\\\": \\\"Strong measured comparator ordered by clean per-row Bradley\\\\u2013Terry negative log-likelihood; it is not disagreement between judges. Its Arena advantage is essential.\\\"\\n  },\\n  {\\n    \\\"name\\\": \\\"Unmodified-data and reversed-row controls\\\",\\n    \\\"role\\\": \\\"supporting\\\",\\n    \\\"include_reason\\\": \\\"Numerical zero-change and row-order invariance checks, not reader-facing performance rates or additional replications.\\\"\\n  },\\n  {\\n    \\\"name\\\": \\\"Clean-Hessian-only contender selection\\\",\\n    \\\"role\\\": \\\"ablation\\\",\\n    \\\"include_reason\\\": \\\"Descriptive search-configuration comparison for lookahead, explicitly not a replicated final ablation or causal mechanism attribution.\\\"\\n  },\\n  {\\n    \\\"name\\\": \\\"Retained-curvature shortlist expansion\\\",\\n    \\\"role\\\": \\\"ablation\\\",\\n    \\\"include_reason\\\": \\\"Supporting negative configuration comparison: expanded proxy/exact pools tie the recorded search aggregate. Do not infer identical behavior, equivalence, or efficiency.\\\"\\n  }\\n]\\nresults_focus [\\n  \\\"Lead with final dataset-by-budget normalized inversion fractions for the studied selector, high-loss deletion, and random deletion. Use unpermuted cases for performance summaries and reversed-row cases only for invariance checks.\\\",\\n  \\\"Secondary final aggregate table: studied selector 0.011722185737596697, high-loss deletion 0.009340217174121283, random deletion 0.003902759168170127; paired gains over high-loss and random deletion 0.002381968563475412 and 0.00781942656942657. Sources: final.metric.combined_score, final.metric.disagreement_baseline_score, final.metric.random_baseline_score, final.metric.paired_gain_vs_disagreement, final.metric.paired_gain_vs_random.\\\",\\n  \\\"Display every unique stored conditional group-bootstrap gain. Each dataset has 32 records, repeated identically across five episode exports, not 160 independent records. All stored high-loss-relative gains are negative in Arena and positive in NBA; Arena random-relative gains include negative observations. Source: final.evidence.episodes.\\\",\\n  \\\"Separate seed-resampling intervals from group-weight resampling. The high-loss-relative seed interval has equal endpoints because that contrast is deterministic across recorded seeds; it is not certainty about data variation or general superiority.\\\",\\n  \\\"Use normalized original-leader rank drop 0.03305066318764949 only as a secondary aggregate for the studied selector, grounded in final.metric.mean_leader_rank_drop. Per-budget curves are normalized inversions, not leader drops or minimal reversal budgets.\\\",\\n  \\\"A small descriptive search table may show raw scores only: clean-Hessian-only selection 0.013240276724865765 (result.top_program_03), bounded exact refits 0.01595532053579999 (result.top_program_01), retained-curvature expansion 0.01595532053579999 (result.top_program_02). Keep this separate from final results; no campaign winner, derived search-delta, or scored/unscored count claims without study.* grounding.\\\"\\n]\\nfigure_plan [\\n  \\\"Figure 1: early six-block concept overview of two data settings, shared Bradley\\\\u2013Terry audit, frozen orders, bounded selection, independent refits, and conditional fixed-mask uncertainty.\\\",\\n  \\\"Figure 2: two dataset panels of grouped dots at three deletion budgets, comparing normalized inversions across the studied selector, high-loss deletion, and random deletion.\\\",\\n  \\\"Figure 3: two comparator panels showing all unique stored conditional bootstrap gains for Arena and NBA against zero; explicitly fixed masks and no reselection.\\\"\\n]\\nsupplementary_plan {\\n  \\\"purpose\\\": \\\"Provide implementation, provenance, numerical-control, and uncertainty depth needed to reproduce and audit the narrow claim, without moving the decisive contrasts or limitations out of the main paper.\\\",\\n  \\\"planned_subsections\\\": [\\n    {\\n      \\\"heading\\\": \\\"Retained-mean objective and frozen-prefix selection\\\",\\n      \\\"grounded_content\\\": \\\"Expand centered ridge Bradley\\\\u2013Terry, half-win ties, clean contrast/influence solves, retained-mean displacement correction, deterministic tie rules, six-contender selection, pair-statistic compression, warm starts/cache, convergence tolerances, incomplete-refit fallback, and selector/evaluation metric mismatch. Inspected program.py, IMPLEMENTATION.md, and evaluator explain the mechanism, not unreported internal shortlist decisions.\\\",\\n      \\\"source_ids\\\": [\\n        \\\"final.evidence.episodes\\\"\\n      ]\\n    },\\n    {\\n      \\\"heading\\\": \\\"Data partitioning and reproducibility record\\\",\\n      \\\"grounded_content\\\": \\\"Record pinned Arena/NBA sources, content-group split, largest connected components, NBA copy filtering and historical team-code limitations, source/payload hashes, declared seeds, CPU dependencies and staged-resource commands from inspected manifests/code. Distinguish protocol metadata from measured findings. A complete raw-to-partition builder and all original raw archives are not staged; do not claim otherwise.\\\",\\n      \\\"source_ids\\\": [\\n        \\\"final.evidence.episodes\\\",\\n        \\\"final.qualification.status\\\"\\n      ]\\n    },\\n    {\\n      \\\"heading\\\": \\\"Numerical and row-order checks\\\",\\n      \\\"grounded_content\\\": \\\"Explain residual tolerances, no-deletion zero disruption, invalid constant-certificate rejection, reversed-row invariance, and unverified candidate-authored diagnostics. Preserve the exact final qualification outcome without inferring undocumented gate causes or generalization.\\\",\\n      \\\"source_ids\\\": [\\n        \\\"final.evidence.episodes\\\",\\n        \\\"final.qualification.status\\\",\\n        \\\"final.qualification.outcome\\\",\\n        \\\"final.qualification.correct\\\"\\n      ]\\n    },\\n    {\\n      \\\"heading\\\": \\\"Descriptive search configurations\\\",\\n      \\\"grounded_content\\\": \\\"Archive raw scores and inspected implementations for clean-Hessian selection, bounded exact refits and retained-curvature expansion. State missing final controlled ablations and selection-adjusted uncertainty. A tied aggregate is not identical behavior or an overhead measurement. Do not report campaign counts, unscored losses, derived search deltas, or original-starter performance without study.* sources.\\\",\\n      \\\"source_ids\\\": [\\n        \\\"result.top_program_01\\\",\\n        \\\"result.top_program_02\\\",\\n        \\\"result.top_program_03\\\"\\n      ]\\n    },\\n    {\\n      \\\"heading\\\": \\\"Conditional uncertainty protocol and stored records\\\",\\n      \\\"grounded_content\\\": \\\"Give the complete unique group-weight records and bootstrap algorithm; masks are fixed, weighted removed mass varies, and selection is not rerun. Contrast this with aggregate seed-resampling intervals and their deterministic degeneracy. The main text retains opposite high-loss-relative signs and the conditioning limitations.\\\",\\n      \\\"source_ids\\\": [\\n        \\\"final.evidence.episodes\\\",\\n        \\\"final.metric.paired_gain_disagreement_ci_low\\\",\\n        \\\"final.metric.paired_gain_disagreement_ci_high\\\",\\n        \\\"final.metric.paired_gain_random_ci_low\\\",\\n        \\\"final.metric.paired_gain_random_ci_high\\\"\\n      ]\\n    }\\n  ]\\n}\\nforbidden_headings [\\n  \\\"Search Progression\\\",\\n  \\\"Campaign Phases\\\",\\n  \\\"Milestones\\\",\\n  \\\"First Valid Result\\\",\\n  \\\"Timeline of Improvements\\\",\\n  \\\"Experiment A\\\",\\n  \\\"Experiment B\\\",\\n  \\\"From Failure to Success\\\",\\n  \\\"Winning Configuration\\\"\\n]\\nforbidden_phrases [\\n  \\\"we then tried\\\",\\n  \\\"first valid result\\\",\\n  \\\"subsequent improvements\\\",\\n  \\\"next-best\\\",\\n  \\\"later variants\\\",\\n  \\\"search winner\\\",\\n  \\\"universally superior\\\",\\n  \\\"universally more robust\\\",\\n  \\\"state of the art\\\",\\n  \\\"globally minimal deletion budget\\\",\\n  \\\"causal effect of evaluation design\\\",\\n  \\\"full-procedure bootstrap\\\",\\n  \\\"five independent datasets\\\",\\n  \\\"160 independent bootstrap replicates\\\",\\n  \\\"correctness rate\\\",\\n  \\\"correct and eligible\\\",\\n  \\\"eligible\\\",\\n  \\\"combined_score\\\",\\n  \\\"rubric\\\",\\n  \\\"worker_01\\\",\\n  \\\"worker_02\\\"\\n]\\nnotes_for_writer [\\n  \\\"Scope: this strategy writes neither paper.tex nor claims_grounding.json, drafts no final paper, renders no figures, runs no new experiment, and invokes no final-paper validation. Dotted JSON fields, internal selection terms and hashes in this memo are private-only source maps, not visible manuscript labels. Memory is qualitative planning context only.\\\",\\n  \\\"Venue/layout: use VENUE.md and the supplied ICLR 2026 style. The inspected paper.sty has textwidth=5.5 inches and textheight=9 inches, single-column: column width equals full text width. All three figures use this text block, not a two-column figure* layout. Keep margins and typography unchanged.\\\",\\n  \\\"Body budget, approximately 8.5 pages including figures/tables but excluding references: title/abstract 0.5; introduction 1.0; related work 0.6; method 1.6; data/metrics/uncertainty protocol 1.1; results 2.6; discussion/limitations 0.8; conclusion 0.3. These are planned page equivalents, not measured pagination. Venue requires 8\\\\u20139 body pages; an eight-page body must end at least 75% full. Spend space on scientific explanation, not padding or unsupported experiments.\\\",\\n  \\\"Thesis-first headings: Introduction; Related Work; Frozen-Prefix Ranking Audits; Data, Metrics, and Uncertainty; Dataset- and Budget-Dependent Disruption; Discussion and Limitations; Conclusion. Use three figures plus two compact tables: final aggregate metrics with seed-interval interpretation, and descriptive search configurations. Keep search context brief and distinct from final evidence.\\\",\\n  \\\"Protocol from inspected code: mean negative log-likelihood plus lambda=0.001 ridge, centered scores, ties as half wins, nominal deletion fractions 0.1%, 0.5%, 1%, floored row counts. For removed prefix S of size k among n rows, the screening displacement is H_clean inverse applied to (sum of removed row gradients + k*lambda*theta_clean), divided by n-k. Distinguish that approximation from converged retained-data fits; exact means residual-controlled numerical refitting, not symbolic exactness.\\\",\\n  \\\"Definitions: normalized inversion fraction divides discordant participant pairs by all participant pairs. Normalized original-leader rank drop divides its downward position change by participant count minus one. Per-budget curves are inversions, not leader drops. The selector uses leader-drop objectives, which need not optimize the reported inversion statistic. Larger disruption does not imply ranking inaccuracy or better models.\\\",\\n  \\\"Comparison scope: row fraction normalizes intervention size, not effective sample size, participant exposure, graph geometry, leverage or uncertainty. Two unmatched designs do not identify a causal design effect. NBA historical team codes/eras are heterogeneous. Fit-specific ranking sensitivity is not evidence about present-day platform rankings or participant ability across eras.\\\",\\n  \\\"Uncertainty: the aggregate high-loss-relative seed interval is [0.002381968563475412, 0.002381968563475412]; the random-relative interval is [0.007377907506332164, 0.008168732424939618]. Source each endpoint with its final.metric.paired_gain_*_ci_* ID. Explain seed-resampling construction in the main table caption. Repeated deterministic contrasts do not estimate data uncertainty.\\\",\\n  \\\"Conditional group resampling holds original masks fixed, refits weighted data, and does not rerun contender selection or either baseline order. Removed weighted mass is not fixed by nominal row fraction. There are 32 unique stored records per dataset, repeated across exported episodes; never pool these into 160 independent records. No full-procedure confidence or population-wide significance claim.\\\",\\n  \\\"No matched-support experiment, whole-group deletion frontier, expert/judge comparison, adaptive order refinement, ridge-sensitivity study, runtime ablation or global minimum-deletion certificate was measured. Provenance groups support split/resampling only; the selector receives anonymous rows. Do not turn implementation intent into empirical findings.\\\",\\n  \\\"Qualification: current authoritative final sources report completed and qualified. This does not establish generalization or universal superiority. If later authoritative evidence reports failed qualification, disclose and preserve it through writing, review, audit and revision; distinguish statistical/performance causes from validity/adaptivity causes only when identified by evaluator diagnostics. Missing causes stay unknown.\\\",\\n  \\\"Source map: final.evidence.episodes supports per-case data and conditional resampling; final.metric.* supports aggregate metrics; final.qualification.* alone grounds qualification. No downstream_study or study.* sources exist, so omit campaign selection advantages, derived search-score differences, attempt counts and original-starter quantitative comparison. Use result.top_program_* only for clearly labeled descriptive raw search scores. Unscored performance is missing, not a loss.\\\",\\n  \\\"Positioning: claim an auditable fitted-ranking protocol, measured two-setting budget contrasts and conditional uncertainty with limitations. Do not claim new Bradley\\\\u2013Terry estimation, novelty priority, universally effective attacks, or causal effects of evaluation design. The two exact-refit configurations share a search aggregate, not proven equivalence; no comparative CPU-cost claim is available.\\\",\\n  \\\"References: staged retrieval has irrelevant matches, duplicate Bradley\\\\u2013Terry records, and lacks several exact planned influence-function, finite-sample robustness, Arena, vote-rigging and NBA provenance identities. Later verify exact allowed identities and actually consult their content; use synchronized BibTeX/provenance keys only. Existing matches are not citation permission. No broad leaderboard searches, citation traversal, guessing of the prohibited work, or citations to unconsulted material. This strategy makes no network requests.\\\",\\n  \\\"Figure outputs: quantitative plots require reproducible source, vector PDF and 300-DPI PNG. LaTeX must reference PDF whenever it exists. Prefer editable draw.io plus PDF/PNG for the concept overview; if raster-only, require at least 2400 px width for these full-width figures, or 1200 px for any later justified column-scale raster. Regenerate rather than upscale. Follow concept-figure orchestration later; do not render during strategy generation.\\\",\\n  \\\"Readability: labels should render at 9\\\\u201310 pt or larger. Method colors stay consistent within the comparison; dataset colors in the uncertainty figure have an explicitly different labeled role. A zero reference is not another method. No thresholded success-rate plot is warranted. Simplify or regenerate dense figures rather than shrinking.\\\",\\n  \\\"Supplement: substantive material already exists. After references use a clear page, appendix mode, and Supplementary Information in the same paper source; include a separate LLM Usage subsection. Authoritative posthoc rankings arrive separately; route appendix-ranked analyses there without guessing rankings now or moving central evidence out of the main text. The five source-backed supplementary entries above describe scientific evidence; the separate mandatory LLM Usage subsection is a process disclosure, not an additional result-grounded entry. Disclose the roles documented in supplied agent-run logs and artifacts: research ideation, candidate-code generation, reference-query planning, and manuscript assistance. Distinguish these from the numerical evaluator. Do not invent provider/model identities, human oversight or paid-API experiments; this is process provenance, not a numerical result.\\\",\\n  \\\"Anonymity: omit names, affiliations, acknowledgements, funding, self-identifying links and internal URLs. Remove template final-copy/author scaffolding during drafting while preserving its required watermark. Include the separate LLM Usage disclosure; do not invent a mandatory checklist not supplied for this venue.\\\",\\n  \\\"Reproducibility: inspected sources include the candidate, evaluator, normalized resources/manifests and numpy==2.2.6, scipy==1.15.3 requirements. A complete raw-to-partition builder and all raw originals are not staged. Inventory actual available artifacts/commands and distinguish staged-resource reruns from raw-source reconstruction. Do not claim the broader reproduction package is already complete.\\\"\\n]\\nfailure_reason \\\"\\\"\\nFIGURES [\\n  {\\n    \\\"figure_id\\\": \\\"audit_overview\\\",\\n    \\\"required\\\": true,\\n    \\\"purpose\\\": \\\"Give immediate glance value for the common sensitivity object, method, and conditioning boundary.\\\",\\n    \\\"figure_type\\\": \\\"diagram\\\",\\n    \\\"preferred_generator\\\": \\\"generate-concept-figure\\\",\\n    \\\"group_by\\\": \\\"audit_component\\\",\\n    \\\"metric\\\": \\\"none; conceptual mechanism only\\\",\\n    \\\"split_by\\\": \\\"two dataset badges feeding one common audit\\\",\\n    \\\"preferred_span\\\": \\\"full_width\\\",\\n    \\\"target_width_fraction\\\": 0.98,\\n    \\\"layout_rationale\\\": \\\"Inspected paper.sty specifies one 5.5-inch text column and 9-inch text height. At 0.98 text width, about 5.39 inches, a two-row/three-block arrangement avoids tiny text. Half-width placement would obscure frozen-prefix versus refit distinctions.\\\",\\n    \\\"allow_progression\\\": false,\\n    \\\"max_panels\\\": 1,\\n    \\\"max_panels_per_row\\\": 1,\\n    \\\"max_categories_per_panel\\\": 6,\\n    \\\"max_series_per_panel\\\": 3,\\n    \\\"placement\\\": \\\"Page 1 or 2, before the detailed method, using an ordinary single-column figure.\\\",\\n    \\\"intended_paper_footprint\\\": \\\"About 0.65 page including caption; artwork about 2.6 inches tall.\\\",\\n    \\\"min_rendered_font_pt\\\": 9,\\n    \\\"content_spec\\\": \\\"Six blocks: observed comparisons (Arena crowd preferences / NBA outcomes); regularized Bradley\\\\u2013Terry fit; frozen influence prefixes; bounded exact-refit contender selection; deletion and independent refits; dataset/budget contrasts. Attach a short fixed-mask resampling/no-reselection note to the last block. Do not depict grouped deletion, architecture changes, adaptive row reordering, or causal design effects.\\\",\\n    \\\"source_ids\\\": [\\n      \\\"final.evidence.episodes\\\"\\n    ],\\n    \\\"implementation_sources\\\": [\\n      \\\"results/ideas/02_exact_refit_contender_screening/program_1/src/program.py\\\",\\n      \\\"task/evaluate_final.py\\\"\\n    ]\\n  },\\n  {\\n    \\\"figure_id\\\": \\\"dataset_budget_comparison\\\",\\n    \\\"required\\\": true,\\n    \\\"purpose\\\": \\\"Expose dataset and budget contrasts hidden by aggregation.\\\",\\n    \\\"figure_type\\\": \\\"grouped_dot\\\",\\n    \\\"preferred_generator\\\": \\\"matplotlib\\\",\\n    \\\"group_by\\\": \\\"deletion_rule\\\",\\n    \\\"metric\\\": \\\"normalized pairwise inversion fraction relative to clean fitted ranking\\\",\\n    \\\"split_by\\\": \\\"dataset\\\",\\n    \\\"preferred_span\\\": \\\"full_width\\\",\\n    \\\"target_width_fraction\\\": 1.0,\\n    \\\"layout_rationale\\\": \\\"Use all 5.5 inches for two side-by-side panels, each with three budgets and three methods, common axes and one shared legend. Do not compress the entire figure to half-text width or rescue long labels by shrinking them.\\\",\\n    \\\"allow_progression\\\": false,\\n    \\\"max_panels\\\": 2,\\n    \\\"max_panels_per_row\\\": 2,\\n    \\\"max_categories_per_panel\\\": 3,\\n    \\\"max_series_per_panel\\\": 3,\\n    \\\"placement\\\": \\\"Main results, approximately page 5 or 6.\\\",\\n    \\\"intended_paper_footprint\\\": \\\"About 0.70 page including caption; artwork about 3.0 inches tall.\\\",\\n    \\\"min_rendered_font_pt\\\": 9,\\n    \\\"content_spec\\\": \\\"Three nominal removed-row fractions: 0.1%, 0.5%, 1%, with floored counts stated in the caption. Plot deterministic studied/high-loss markers without manufactured uncertainty bars; show five random-deletion seed values as faint same-color points and their mean. Do not count reversed-row controls as replicates. Shared y scale; larger means greater disruption, not better ranking accuracy. Budget is an experimental condition, not search progression.\\\",\\n    \\\"source_ids\\\": [\\n      \\\"final.evidence.episodes\\\"\\n    ],\\n    \\\"implementation_sources\\\": [\\n      \\\"task/evaluate_final.py:FRACTIONS\\\",\\n      \\\"task/evaluate_final.py:disruption\\\"\\n    ]\\n  },\\n  {\\n    \\\"figure_id\\\": \\\"conditional_resampling_contrasts\\\",\\n    \\\"required\\\": true,\\n    \\\"purpose\\\": \\\"Keep dependence-sensitive conditional uncertainty and dataset-specific comparator ordering visible in the main paper.\\\",\\n    \\\"figure_type\\\": \\\"strip_plot\\\",\\n    \\\"preferred_generator\\\": \\\"matplotlib\\\",\\n    \\\"group_by\\\": \\\"dataset\\\",\\n    \\\"metric\\\": \\\"fixed-mask bootstrap difference in mean normalized inversions: studied selector minus comparator\\\",\\n    \\\"split_by\\\": \\\"high-loss deletion and random deletion comparators\\\",\\n    \\\"preferred_span\\\": \\\"full_width\\\",\\n    \\\"target_width_fraction\\\": 1.0,\\n    \\\"layout_rationale\\\": \\\"Two panels across the full 5.5-inch text block leave room for 32 observations per dataset, explicit comparator titles, zero reference, and labels at least 9 pt. Use reproducible display jitter, not more statistical samples.\\\",\\n    \\\"allow_progression\\\": false,\\n    \\\"max_panels\\\": 2,\\n    \\\"max_panels_per_row\\\": 2,\\n    \\\"max_categories_per_panel\\\": 2,\\n    \\\"max_series_per_panel\\\": 1,\\n    \\\"placement\\\": \\\"Immediately after Figure 2, approximately page 6 or 7; never supplementary-only.\\\",\\n    \\\"intended_paper_footprint\\\": \\\"About 0.65 page including caption; artwork about 2.7 inches tall.\\\",\\n    \\\"min_rendered_font_pt\\\": 9,\\n    \\\"content_spec\\\": \\\"Extract one unique conditional_group_bootstrap block and plot its 32 stored gains per dataset per comparator against zero. Label fixed-mask group-weight resampling. Do not pool duplicated exports, call this full-procedure uncertainty, claim population significance, or infer causal evaluation-design effects.\\\",\\n    \\\"source_ids\\\": [\\n      \\\"final.evidence.episodes\\\"\\n    ],\\n    \\\"implementation_sources\\\": [\\n      \\\"task/evaluate_final.py:final_uncertainty\\\"\\n    ]\\n  }\\n]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nls: cannot access '/usr/bin/pdftotext': No such file or directory\n-rwxr-xr-x 1 root root 59784 Jun 24  2025 /usr/bin/apt-get\ntasks None downstream None\nfinal keys ['correct', 'evaluation_evidence', 'evaluator_sha256', 'manifest_path', 'metrics', 'outcome', 'program_tree_sha256', 'results_tree_sha256', 'status', 'task_tree_sha256']\nqualification sources {\n  \"final.qualification.correct\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.qualification.correct\",\n    \"manifest_path\": \"work/results/t06/codex/20261117_205956/final_evaluation/final_manifest.json\",\n    \"program_tree_sha256\": \"sha256:f1de38e95ce991dcd5e4d0053f19985076f23d8691cbfb1c0b835c4884411fc5\",\n    \"results_tree_sha256\": \"sha256:f526616ee82183b25fe4385c172051e1c0ab17259785fe939369b7eff07cf92e\",\n    \"type\": \"final_qualification\",\n    \"value\": true\n  },\n  \"final.qualification.outcome\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.qualification.outcome\",\n    \"manifest_path\": \"work/results/t06/codex/20261117_205956/final_evaluation/final_manifest.json\",\n    \"program_tree_sha256\": \"sha256:f1de38e95ce991dcd5e4d0053f19985076f23d8691cbfb1c0b835c4884411fc5\",\n    \"results_tree_sha256\": \"sha256:f526616ee82183b25fe4385c172051e1c0ab17259785fe939369b7eff07cf92e\",\n    \"type\": \"final_qualification\",\n    \"value\": \"qualified\"\n  },\n  \"final.qualification.status\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.qualification.status\",\n    \"manifest_path\": \"work/results/t06/codex/20261117_205956/final_evaluation/final_manifest.json\",\n    \"program_tree_sha256\": \"sha256:f1de38e95ce991dcd5e4d0053f19985076f23d8691cbfb1c0b835c4884411fc5\",\n    \"results_tree_sha256\": \"sha256:f526616ee82183b25fe4385c172051e1c0ab17259785fe939369b7eff07cf92e\",\n    \"type\