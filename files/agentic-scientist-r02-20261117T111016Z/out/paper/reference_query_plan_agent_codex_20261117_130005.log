   -0.0312652587890625,\n                          -0.0185699462890625\n                        ],\n                        \"utility_difference\": 0.033945760706014814,\n                        \"volume_difference\": -0.02663421630859375\n                      },\n                      {\n                        \"alpha\": 0.1,\n                        \"bonferroni54_bootstrap_interval\": [\n                          0.010255500674247853,\n                          0.01626838412549758\n                        ],\n                        \"paired_seed_bootstrap95\": [\n                          0.010255500674247853,\n                          0.01626838412549758\n                        ],\n                        \"paired_volume_bootstrap95\": [\n                          -0.01123809814453125,\n                          -0.00711822509765625\n                        ],\n                        \"utility_difference\": 0.012358725070953444,\n                        \"volume_difference\": -0.009211222330729166\n                      },\n                      {\n                        \"alpha\": 0.2,\n                        \"bonferroni54_bootstrap_interval\": [\n                          0.006242372095584869,\n                          0.03678843379020691\n                        ],\n                        \"paired_seed_bootstrap95\": [\n                          0.006242372095584869,\n                          0.03678843379020691\n                        ],\n                        \"paired_volume_bootstrap95\": [\n                          -0.003570556640625,\n                          -0.0014801025390625\n                        ],\n                        \"utility_difference\": 0.017538488532106083,\n                        \"volume_difference\": -0.0024007161458333335\n                      }\n                    ],\n                    \"unscaled_ilr\": [\n                      {\n                        \"alpha\": 0.05,\n                        \"bonferroni54_bootstrap_interval\": [\n                          -0.005117521474236053,\n                          0.015503168106079102\n                        ],\n                        \"paired_seed_bootstrap95\": [\n                          -0.005117521474236053,\n                          0.015503168106079102\n                        ],\n                        \"paired_volume_bootstrap95\": [\n                          -1.52587890625e-05,\n                          0.00109100341796875\n                        ],\n                        \"utility_difference\": 0.007880473868888719,\n                        \"volume_difference\": 0.0006586710611979166\n                      },\n                      {\n                        \"alpha\": 0.1,\n                        \"bonferroni54_bootstrap_interval\": [\n                          -0.003301410211457134,\n                          0.013176603449715607\n                        ],\n                        \"paired_seed_bootstrap95\": [\n                          -0.003301410211457134,\n                          0.013176603449715607\n                        ],\n                        \"paired_volume_bootstrap95\": [\n                          -0.0001678466796875,\n                          5.340576171875e-05\n                        ],\n                        \"utility_difference\": 0.0054434587558110925,\n                        \"volume_difference\": -2.288818359375e-05\n                      },\n                      {\n                        \"alpha\": 0.2,\n                        \"bonferroni54_bootstrap_interval\": [\n                          -0.00858004204928875,\n                          -0.0013246480375528336\n                        ],\n                        \"paired_seed_bootstrap95\": [\n                          -0.00858004204928875,\n                          -0.0013246480375528336\n                        ],\n                        \"paired_volume_bootstrap95\": [\n                          -3.0517578125e-05,\n                          0.0001068115234375\n                        ],\n                        \"utility_difference\": -0.0054871489604314165,\n                        \"volume_difference\": 3.814697265625e-05\n                      }\n                    ]\n                  },\n                  \"seed_count\": 3\n                },\n                \"overall_seed_block\": {\n                  \"bootstrap95\": [\n                    0.6165404563619622,\n                    0.6418229148737103\n                  ],\n                  \"seed_count\": 3\n                }\n              }\n            }\n          }\n        ],\n        \"path\": \"work/results/r02/codex/20261117_111421/investigation/ideas/01_boundary_stratified_conformal_evaluation_without_target_leakage/program_1/evaluation_evidence.json\",\n        \"sha256\": \"sha256:e48f7447eb7946cbfc32f749dcf52960c4944485d1e87b6bcffcaebdf72a84eb\",\n        \"status\": \"available\"\n      },\n      \"idea_dir_name\": \"01_boundary_stratified_conformal_evaluation_without_target_leakage\",\n      \"idea_id\": \"cycle_01_boundary_stratified_geometry\",\n      \"program_dir\": \"work/results/r02/codex/20261117_111421/investigation/ideas/01_boundary_stratified_conformal_evaluation_without_target_leakage/program_1\",\n      \"program_id\": \"program_1\",\n      \"program_idx\": 1\n    }\n  ],\n  \"totals\": {\n    \"attempts\": 3,\n    \"correct_programs\": 3,\n    \"evaluated_programs\": 3,\n    \"ideas\": 3\n  }\n}lrwxrwxrwx 1 agent agent   16 Nov 17 13:00 global_memory -> ../investigation\n\nfigures:\ntotal 8\ndrwx------ 2 agent agent 4096 Nov 17 13:00 .\ndrwx------ 4 agent agent 4096 Nov 17 13:00 ..\nappend_memory.py\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n\ndef _markdown_entry(event: dict[str, Any]) -> str:\n    \"\"\"Handle markdown entry logic for this module.\"\"\"\n    lines = [\n        f\"### {event['timestamp']} | step={event['step']} | scope={event['scope']}\",\n        f\"- summary: {event['summary']}\",\n        f\"- evidence: {event['evidence']}\",\n        f\"- next_action: {event['next_action']}\",\n    ]\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = event.get(key)\n        if isinstance(value, str) and value.strip():\n            lines.append(f\"- {key}: {value.strip()}\")\n\n    metrics = event.get(\"metrics\")\n    if isinstance(metrics, dict) and metrics:\n        lines.append(f\"- metrics: {json.dumps(metrics, sort_keys=True)}\")\n    rubrics = event.get(\"rubrics\")\n    if isinstance(rubrics, list) and rubrics:\n        lines.append(f\"- rubrics: {json.dumps(rubrics, sort_keys=True)}\")\n    tags = event.get(\"tags\")\n    if isinstance(tags, list) and tags:\n        lines.append(f\"- tags: {', '.join(str(item) for item in tags)}\")\n\n    return \"\\n\".join(lines) + \"\\n\\n\"\n\n\ndef _append_text(path: Path, text: str, *, header: str) -> None:\n    \"\"\"Safely initialize and append text to a regular file.\"\"\"\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if not size:\n            _write_all(fd, header.encode(\"utf-8\"))\n        elif os.pread(fd, 1, size - 1) != b\"\\n\":\n            _write_all(fd, b\"\\n\")\n        _write_all(fd, text.encode(\"utf-8\"))\n    finally:\n        try:\n            fcntl.flock(fd, fcntl.LOCK_UN)\n        finally:\n            os.close(fd)\n\n\ndef _append_jsonl(path: Path, payload: dict[str, Any]) -> None:\n    \"\"\"Append one JSON object as a JSONL record.\"\"\"\n    line = (json.dumps(payload, sort_keys=True) + \"\\n\").encode(\"utf-8\")\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if size and os.pread(fd, 1, size - 1) != b\"\\n\":\n            _write_all(fd, b\"\\n\")\n        _write_all(fd, line)\n    finally:\n        try:\n            fcntl.flock(fd, fcntl.LOCK_UN)\n        finally:\n            os.close(fd)\n\n\ndef _open_regular_for_append(path: Path) -> int:\n    \"\"\"Open an append target without following its parent or leaf.\"\"\"\n    directory_fd = _walk_directory_no_follow(path.parent)\n    try:\n        fd = os.open(\n            path.name,\n            os.O_APPEND\n            | os.O_CREAT\n            | os.O_RDWR\n            | getattr(os, \"O_NOFOLLOW\", 0)\n            | getattr(os, \"O_NONBLOCK\", 0),\n            0o644,\n            dir_fd=directory_fd,\n        )\n    finally:\n        os.close(directory_fd)\n    if stat.S_ISREG(os.fstat(fd).st_mode):\n        return fd\n    os.close(fd)\n    raise OSError(f\"unsafe non-regular append target: {path}\")\n\n\ndef _walk_directory_no_follow(directory: Path) -> int:\n    \"\"\"Create and walk a directory path without following any component.\"\"\"\n    flags = os.O_RDONLY | getattr(os, \"O_DIRECTORY\", 0) | getattr(os, \"O_NOFOLLOW\", 0)\n    if directory.is_absolute():\n        descriptor = os.open(directory.anchor, flags)\n        components = directory.parts[1:]\n    else:\n        descriptor = os.open(\".\", flags)\n        components = directory.parts\n    try:\n        for component in components:\n            if component in (\"\", \".\"):\n                continue\n            try:\n                os.mkdir(component, mode=0o777, dir_fd=descriptor)\n            except FileExistsError:\n                pass\n            next_descriptor = os.open(component, flags, dir_fd=descriptor)\n            os.close(descriptor)\n            descriptor = next_descriptor\n","exit_code":0,"status":"completed"}}
