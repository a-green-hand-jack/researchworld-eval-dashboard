ency evidence may be negative or inconclusive. No learning/adaptivity/superiority gate is inferred from state flags or aspirational publication claims.\"\n  },\n  \"candidate\": {\n    \"interface\": \"python_rpc_v1:handle\",\n    \"editable_paths\": [\n      \"program_0/src\"\n    ]\n  },\n  \"evaluators\": {\n    \"search\": \"evaluate.py\",\n    \"final\": \"evaluate_final.py\"\n  },\n  \"resources\": {\n    \"search_root\": \"resources/search\",\n    \"final_root\": \"resources/final\",\n    \"public_artifact_bundle\": null\n  },\n  \"data\": {\n    \"search_roles\": [\n      \"search_synthetic_training\",\n      \"search_synthetic_calibration\",\n      \"search_synthetic_test\"\n    ],\n    \"final_roles\": [\n      \"final_synthetic_training\",\n      \"final_synthetic_calibration\",\n      \"final_synthetic_test\"\n    ]\n  },\n  \"metrics\": {\n    \"search\": [\n      {\n        \"name\": \"combined_score\",\n        \"data_role\": \"search_synthetic_test\"\n      },\n      {\n        \"name\": \"marginal_coverage_error\",\n        \"data_role\": \"search_synthetic_test\"\n      },\n      {\n        \"name\": \"group_coverage_error\",\n        \"data_role\": \"search_synthetic_test\"\n      },\n      {\n        \"name\": \"reference_mass\",\n        \"data_role\": \"search_synthetic_test\"\n      },\n      {\n        \"name\": \"global_ilr_score_gap\",\n        \"data_role\": \"search_synthetic_test\"\n      },\n      {\n        \"name\": \"constant_control_score\",\n        \"data_role\": \"search_synthetic_test\"\n      },\n      {\n        \"name\": \"permuted_control_score\",\n        \"data_role\": \"search_synthetic_test\"\n      },\n      {\n        \"name\": \"control_pass_fraction\",\n        \"data_role\": \"search_synthetic_test\"\n      }\n    ],\n    \"final\": [\n      {\n        \"name\": \"combined_score\",\n        \"data_role\": \"final_synthetic_test\"\n      },\n      {\n        \"name\": \"marginal_coverage_error\",\n        \"data_role