{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"ls task/program_0/src; head -45 task/program_0/src/program.py; jq '{search_cases:([.all_programs[0].evaluation_evidence.episodes[0].solution.episodes[].case]|unique),search_seeds:[.all_programs[0].evaluation_evidence.episodes[].seed],final_qualification:[.grounding_sources|to_entries[]|select(.key|startswith(\\\"final.qualification\\\"))|{id:.key,value:.value.value}]}' paper_data.json; sed -n '900,923p' task/evaluate_final.py; sed -n '106,176p' results/ideas/03_log_odds_shift_residual_decoder/program_1/src/program.py; sed -n '1,100p' task/resources/rebuild.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"ls task/program_0/src; head -45 task/program_0/src/program.py; jq '{search_cases:([.all_programs[0].evaluation_evidence.episodes[0].solution.episodes[].case]|unique),search_seeds:[.all_programs[0].evaluation_evidence.episodes[].seed],final_qualification:[.grounding_sources|to_entries[]|select(.key|startswith(\\\"final.qualification\\\"))|{id:.key,value:.value.value}]}' paper_data.json; sed -n '900,923p' task/evaluate_final.py; sed -n '106,176p' results/ideas/03_log_odds_shift_residual_decoder/program_1/src/program.py; sed -n '1,100p' task/resources/rebuild.py\"","aggregated_output":"        _state.pop('items', None)\n        _state['last_budget'] = 0\n    elif operation == 'select':\n        budget = request['budget']\n        groups = _state['item_groups']\n        maximum = min(_state['config']['max_budget'], np.unique(groups).size)\n        if type(budget) is not int or not (0 <= budget <= maximum):\n            raise ValueError('invalid budget')\n        if budget < _state['last_budget']:\n            raise ValueError('budgets must increase')\n        if budget == 0:\n            return {'items': []}\n        check_selection(_state['selection_order'], groups, budget,\n                        _state.get('chosen', [])[:_state['last_budget']])\n        _state['chosen'] = _state['selection_order'].tolist()\n        _state['last_budget'] = budget\n        return {'items': _state['chosen'][:budget]}\n    elif operation == 'observe':\n        if request['items'] != _state.get('chosen', [])[:_state['last_budget']]:\n            raise ValueError('observation items do not match selection')\n        _state['items'] = request['items']\n        values = np.asarray(request['values'], dtype=float)\n        if (values.shape != (_state['config']['target_count'], len(request['items']))\n                or not np.all((values == 0) | (values == 1))):\n            raise ValueError('invalid observations')\n        _state['observed'] = values\n    elif operation == 'update':\n        indices = np.asarray(_state['items'], dtype=int)\n        observed = _state['observed']\n        if indices.size == _state['item_groups'].size:\n            predictions = observed.mean(axis=1)\n        else:\n            predictions = predict_candidate(_state['model'], indices, observed)\n        check_predictions(observed, predictions)\n        _state['predictions'] = predictions.tolist()\n    elif operation == 'predict':\n        return {'predictions': _state['predictions']}\n    elif operation == 'close':\n        _state = {}\n    else:\n        raise ValueError('unknown operation')\n    return {'ok': True}\n\"\"\"Rebuild frozen arrays/manifests from pinned local inputs; never used at runtime.\n\nAcquire the task.md commit under --upstream-dir and the harness-supplied raw\ncolumn/row provenance tree under --columns-dir. No network access is performed.\nBoth output planes are evaluator-private, not candidate assets.\n\"\"\"\n\nimport argparse\nimport ast\nimport hashlib\nimport json\nimport pathlib\nimport re\nimport unicodedata\n\nimport joblib\nimport numpy as np\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--upstream-dir', required=True)\nparser.add_argument('--columns-dir', required=True)\nparser.add_argument('--output-dir', required=True)\narguments = parser.parse_args()\nEXTRA = pathlib.Path(arguments.columns_dir)\nUP = pathlib.Path(arguments.upstream_dir)\nDEST = pathlib.Path(arguments.output_dir)\nif hashlib.sha256((EXTRA / 'SOURCES.json').read_bytes()).hexdigest() != '6ed297737db27ac59df0cf05f67ec517bba84dd5950abfbd8fca2933122155c1':\n    raise ValueError('raw provenance snapshot mismatch')\nif hashlib.sha256((EXTRA / 'openllm/models.jsonl').read_bytes()).hexdigest() != '64130c9f6b9265283a002daa850e39e4795d89f89c82077ef06944f06f526e46':\n    raise ValueError('lineage metadata snapshot mismatch')\nscore_hashes = json.loads((EXTRA / 'SOURCES.json').read_text())['upstream']['score_files_sha256']\nSEARCH = ['arc_challenge', 'ifeval', 'commonsense', 'gsm']\nFINAL = ['bbh', 'gpqa', 'mmlu_pro', 'musr', 'openllm_math', 'legalbench', 'math', 'med_qa', 'mmlu']\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\ndef norm(text):\n    return ' '.join(unicodedata.normalize('NFKC', str(text)).split())\n\ndef content(record):\n    if 'text' in record:\n        text = record['text']\n        parts = re.split(r'\\s+[A-J][.)]\\s+', text)\n        stem, options = parts[0], parts[1:]\n    else:\n        doc = record['doc']\n        if isinstance(doc, str):\n            doc = ast.literal_eval(doc)\n        stem = doc.get('question', doc.get('Question', doc.get('prompt', doc.get('input', doc.get('problem')))))\n        if stem is None:\n            raise ValueError('unknown raw document schema')\n        if 'narrative' in doc:\n            stem = doc['narrative'] + '\\n' + stem\n        options = doc.get('options', doc.get('choices', []))\n        if isinstance(options, dict):\n            options = options['text']\n        if 'choice1' in doc:\n            options = [doc[f'choice{index}'] for index in range(1, 5)]\n    canonical = json.dumps([norm(stem), [norm(option) for option in options]], ensure_ascii=False, separators=(',', ':'))\n    return sha(canonical.encode()), sha(norm(stem).encode())\n\ndef model_key(name):\n    key = re.sub(r'[^a-z0-9]', '', name.lower())\n    for prefix in ['metallama', 'meta', 'huggingface', 'togethercomputer', 'together', 'mistralai', 'google', 'microsoft', 'eleutherai']:\n        if key.startswith(prefix):\n            key = key[len(prefix):]\n            break\n    key = re.sub(r'(instruct|chat|hf|gptq|awq|gguf|int8|int4|4bit|8bit|turbo|preview)+$', '', key)\n    return key\n\nparent = {}\ndef find(key):\n    parent.setdefault(key, key)\n    if parent[key] != key:\n        parent[key] = find(parent[key])\n    return parent[key]\n\ndef union(left, right):\n    left, right = find(left), find(right)\n    if left != right:\n        parent[max(left, right)] = min(left, right)\n\nfor line in open(EXTRA / 'openllm/models.jsonl'):\n    meta = json.loads(line)\n    name = model_key(meta['fullname'])\n    bases = meta.get('Base Model')\n    if isinstance(bases, str) and bases.strip() and bases not in ('None', 'Unknown', 'N/A'):\n        union(name, model_key(bases))\n    elif isinstance(bases, list):\n        for base in bases:\n            union(name, model_key(base))\n\nrecords = {}\nfor case in SEARCH + FINAL:\n    category = 'openllm' if (EXTRA / 'openllm' / case).exists() else 'helm'\n    root = EXTRA / category / case\n    columns = [json.loads(line) for line in open(root / 'columns.jsonl')]\n    assert [entry['col'] for entry in columns] == list(range(len(columns)))\n    hashes = [content(entry) for entry in columns]\n","exit_code":0,"status":"completed"}}
