{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,65p' references.bib; python - <<'PY'\nimport json\nfrom pathlib import Path\nstrategy=json.loads(Path('paper_strategy.json').read_text())\ndata=json.loads(Path('paper_data.json').read_text())\nmemo=Path('paper_strategy.md').read_text()\nrequired={'status','selected_prompt_family','recommended_title','central_question','central_thesis','narrative_rationale','prior_paper_story_status','edit_framing_decision','staged_input_impact','method_groups','results_focus','figure_plan','figure_specs','supplementary_plan','forbidden_headings','forbidden_phrases','notes_for_writer','failure_reason'}\nassert set(strategy)==required\nassert strategy['status']=='ready' and strategy['selected_prompt_family']=='paper_standalone'\nassert strategy['failure_reason']==''\nassert strategy['central_question'] in memo and strategy['central_thesis'] in memo\nassert strategy['recommended_title'] in memo\nassert strategy['prior_paper_story_status'] in {'preserved','broadened','recentered','rejected'}\nassert all(group['role'] in {'baseline','proposed','ablation','supporting'} for group in strategy['method_groups'])\nfigures=strategy['figure_specs']\nassert len({figure['figure_id'] for figure in figures})==len(figures)\nassert sum(figure['preferred_generator']=='generate-concept-figure' for figure in figures)==1\nfor figure in figures:\n assert figure['required'] and not figure['allow_progression']\n assert figure['max_panels']<=4 and figure['max_panels_per_row']<=3\n assert figure['max_categories_per_panel']<=6 and figure['max_series_per_panel']<=4\n assert figure['preferred_span']=='full_width' and figure['target_width_fraction']==1.0\n assert figure['layout_rationale']\n assert figure['preferred_generator'] in {'matplotlib','tikz','generate-concept-figure','native_latex','manual'}\nsupplement=strategy['supplementary_plan']\nassert supplement['purpose'] and supplement['planned_subsections']\nfor section in supplement['planned_subsections']:\n assert section['heading'] and section['grounded_content'] and section['source_ids']\n assert all(source_id in data['grounding_sources'] for source_id in section['source_ids'])\nfor heading in strategy['forbidden_headings']:\n assert heading in memo\nfor phrase in strategy['forbidden_phrases']:\n assert phrase in memo\nfor field in ['status','outcome','correct']:\n assert data['grounding_sources']['final.qualification.'+field]['value']==data['final_evaluation'][field]\nassert data['final_evaluation']['status']=='completed' and data['final_evaluation']['outcome']=='qualified'\nassert len(data['final_evaluation']['evaluation_evidence']['episodes'])==6\nassert all(not Path(path).exists() for path in ['paper.tex','claims_grounding.json','figure_manifest.json'])\nassert not any(Path('figures').iterdir())\nassert 'downstream_study' not in data\nassert all(not Path(path).exists() for path in ['previous_paper','aggregated','extra_tasks'])\nprint('PASS: strategy contract, memo parity, registered source IDs, qualification facts, figure budgets and stage boundaries.')\nprint('Main paper target: 8.5 pages; required figures: 3; grounded supplementary sections: 7.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
