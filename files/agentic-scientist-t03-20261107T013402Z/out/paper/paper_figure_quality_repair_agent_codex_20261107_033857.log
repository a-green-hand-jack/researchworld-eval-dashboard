igure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n{\n  \"$defs\": {\n    \"FigureFontSizes\": {\n      \"additionalProperties\": false,\n      \"description\": \"Explicit font sizes for the legacy manifest contract.\",\n      \"properties\": {\n        \"axis\": {\n          \"title\": \"Axis\",\n          \"type\": \"number\"\n        },\n        \"legend\": {\n          \"title\": \"Legend\",\n          \"type\": \"number\"\n        },\n        \"ticks\": {\n          \"title\": \"Ticks\",\n          \"type\": \"number\"\n        },\n        \"title\": {\n          \"title\": \"Title\",\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"title\",\n        \"axis\",\n        \"ticks\",\n        \"legend\"\n      ],\n      \"title\": \"FigureFontSizes\",\n      \"type\": \"object\"\n    },\n    \"LegacyFigureManifestFigure\": {\n      \"additionalProperties\": false,\n      \"allOf\": [\n        {\n          \"else\": {\n            \"properties\": {\n              \"path_pdf\": {\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"path_pdf\"\n            ]\n          },\n          \"if\": {\n            \"anyOf\": [\n              {\n                \"properties\": {\n                  \"generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  }\n                },\n                \"required\": [\n                  \"generator\"\n                ]\n              },\n              {\n                \"properties\": {\n                  \"attempted_generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  },\n                  \"fallback_reason\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  },\n                  \"generator\": {\n                    \"type\": \"null\"\n                  },\n                  \"prompt_log_path\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"generator\",\n                  \"attempted_generator\",\n                  \"prompt_log_path\",\n                  \"fallback_reason\"\n                ]\n              }\n            ]\n          }\n        }\n      ],\n      \"description\": \"Original flat figure-manifest entry shape.\",\n      \"properties\": {\n        \"attempted_generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Attempted Generator\"\n        },\n        \"categories_per_panel\": {\n          \"items\": {\n            \"type\": \"integer\"\n          },\n          \"title\": \"Categories Per Panel\",\n          \"type\": \"array\"\n        },\n        \"estimated_min_rendered_font_pt\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Estimated Min Rendered Font Pt\"\n        },\n        \"fallback_reason\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Fallback Reason\"\n        },\n        \"figure_id\": {\n          \"minLength\": 1,\n          \"title\": \"Figure Id\",\n          \"type\": \"string\"\n        },\n        \"figure_type\": {\n          \"enum\": [\n            \"grouped_bar\",\n            \"bar\",\n            \"line\",\n            \"box\",\n            \"violin\",\n            \"scatter\",\n            \"heatmap\",\n            \"table_matrix\",\n            \"table\",\n            \"composite\",\n            \"diagram\"\n          ],\n          \"title\": \"Figure Type\",\n          \"type\": \"string\"\n        },\n        \"font_sizes\": {\n          \"$ref\": \"#/$defs/FigureFontSizes\"\n        },\n        \"generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Generator\"\n        },\n        \"intended_latex_width_fraction\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"maximum\": 1,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Intended Latex Width Fraction\"\n        },\n        \"max_label_chars\": {\n          \"exclusiveMinimum\": 0,\n   