\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pass}{{1}{4}{Fraction of instances whose two-run agreement is $\ge 0.9$ (top: same top-1 feature; bottom: identical top-3 set) vs.\ budget $m/d$; solid: Kernel, dashed: permutation; colour: model; bands: 95\% bootstrap CI over instances. Flat 1.0 for Pima-Kernel at $m/d\ge 32$ is exact enumeration ($m\ge 2^d{-}2$). Dotted line: 0.9}{figure.caption.1}{}}
\newlabel{fig:pass@cref}{{[figure][1][]1}{[1][3][]4}{}{}{}}
\newlabel{tab:pooled}{{1}{4}{Pooled pass rates over the 16 dataset$\times $model cells: mean of cell-level pass rates with 95\% bootstrap CI over cells; median (over cells) of the median relative $\ell _2$ difference between two runs. $^\dagger $: includes the four Pima cells where Kernel is exact for $m\ge 2^d{-}2$. $m/d=2$ for Kernel is ill-conditioned (\cref {sec:validation})}{table.caption.2}{}}
\newlabel{tab:pooled@cref}{{[table][1][]1}{[1][3][]4}{}{}{}}
\newlabel{tab:deployed}{{2}{5}{Default shap explainers (0.51.0), 16 model--dataset cells, 20 instances $\times $ 10 runs. Pass = pair agreement $\ge 0.9$. ``resampled'': a fresh random 100-row background each run. (Interventional TreeExplainer: trees only.)}{table.caption.3}{}}
\newlabel{tab:deployed@cref}{{[table][2][]2}{[1][3][]5}{}{}{}}
\newlabel{fig:collapse}{{2}{5}{Run-pair agreement vs.\ margin-to-noise ratio (binned quantiles of all non-exact configurations on the $d\le 10$ datasets, budgets $m/d\ge 4$). Agreement saturates near 1 once the ratio exceeds about 2 (top-1) or 1.5 (top-3), and the two estimators fall on essentially the same curve. The noise level is measured from the same runs, so this is a consistency check rather than a prediction}{figure.caption.4}{}}
\newlabel{fig:collapse@cref}{{[figure][2][]2}{[1][4][]5}{}{}{}}
