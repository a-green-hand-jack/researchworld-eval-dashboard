gures/audit_overview.prompts.json\",\n      \"required\": true,\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"uses_progression\": false\n    },\n    {\n      \"estimated_min_rendered_font_pt\": 9.3,\n      \"figure_id\": \"dataset_budget_comparison\",\n      \"figure_type\": \"scatter\",\n      \"files\": {\n        \"pdf\": \"figures/dataset_budget_comparison.pdf\",\n        \"png\": \"figures/dataset_budget_comparison.png\"\n      },\n      \"generator\": \"matplotlib\",\n      \"intended_latex_width_fraction\": 1.0,\n      \"min_font_size_pt\": 9.5,\n      \"note\": \"Canonical scatter type; layout follows the strategy content specification.\",\n      \"panel_count\": 2,\n      \"panels\": [\n        {\n          \"category_count\": 3,\n          \"content\": \"Expose dataset and budget contrasts hidden by aggregation.\",\n          \"panel_id\": \"0\",\n          \"series_count\": 3\n        },\n        {\n          \"category_count\": 3,\n          \"content\": \"Expose dataset and budget contrasts hidden by aggregation.\",\n          \"panel_id\": \"1\",\n          \"series_count\": 3\n        }\n      ],\n      \"panels_per_row\": 2,\n      \"placement\": \"full_width\",\n      \"required\": true,\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"uses_progression\": false\n    },\n    {\n      \"estimated_min_rendered_font_pt\": 9.3,\n      \"figure_id\": \"conditional_resampling_contrasts\",\n      \"figure_type\": \"scatter\",\n      \"files\": {\n        \"pdf\": \"figures/conditional_resampling_contrasts.pdf\",\n        \"png\": \"figures/conditional_resampling_contrasts.png\"\n      },\n      \"generator\": \"matplotlib\",\n      \"intended_latex_width_fraction\": 1.0,\n      \"min_font_size_pt\": 9.5,\n      \"note\": \"Canonical scatter type; layout follows the strategy content specification.\",\n      \"panel_count\": 2,\n      \"panels\": [\n        {\n          \"category_count\": 2,\n          \"content\": \"Keep dependence-sensitive conditional uncertainty and dataset-specific comparator ordering visible in the main paper.\",\n          \"panel_id\": \"0\",\n          \"series_count\": 1\n        },\n        {\n          \"category_count\": 2,\n          \"content\": \"Keep dependence-sensitive conditional uncertainty and dataset-specific comparator ordering visible in the main paper.\",\n          \"panel_id\": \"1\",\n          \"series_count\": 1\n        }\n      ],\n      \"panels_per_row\": 2,\n      \"placement\": \"full_width\",\n      \"required\": true,\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"uses_progression\": false\n    }\n  ]\n}\nThe deletion comparison and the uncertainty diagnostic have different reference objects. A deletion witness compares a retained fit with the original clean fit. A weighted draw instead compares weighted retained fits with a newly fitted weighted clean ranking. Thus a change in a conditional gain need not mean that the same participant pair crossed the same original boundary. Rank inversion is also discontinuous in fitted scores: a small score displacement near a tie can change the order, whereas a larger displacement away from a tie may not. The measured inversion fraction cannot by itself identify either the score margin or practical importance of the affected comparisons. Reporting the full budget-resolved curves together with their conditioning assumptions is more informative than treating an aggregate gain or a seed interval as a universal stability certificate.\n\n\\paragraph{Reproducibility and responsible interpretation.}\nThe supplied source snapshots, normalized resources, evidence exports, and figure-generation script support inspection and regeneration of the reported summaries. A complete raw-source-to-partition builder and the original raw archives are not included in the staged materials, so end-to-end reproduction from raw public data remains incomplete. Supplementary Information distinguishes this gap from reproducible figure extraction. The analysis is retrospective: it does not demonstrate access to live votes or practical manipulation of any deployed leaderboard. Results should motivate transparent reporting of sensitivity, not claims that a model's quality or a team's ability changed when observations were removed.\n\n\\section{Conclusion}\n{\n  \"schema_version\": 1,\n  \"family\": \"arena\",\n  \"plane\": \"final\",\n  \"source_sha256\": \"0692154aaf20fc6649090c3f49b6b5dd1e693a765ecb5f0856ae0da5946f5be2\",\n  \"payload_sha256\": \"4edb81fafc71129504bd8ec5d5965fefab5127c9667e594b34c8bccb1250cc6f\",\n  \"split_seed\": \"split-v1-20261027\",\n  \"normalization\": \"NFKC then Unicode whitespace collapse, parsed JSON text turns; null canonicalizes to empty string and empty turns are conservatively hashed/grouped. Group ANY shared prompt/response turn or normalized raw example BEFORE endpoint/outcome extraction. NBA normalized date, sorted original team codes and aligned scores, only _iscopy=0.\",\n  \"cross_plane_content_intersection\": 0,\n  \"cross_plane_source_id_intersection\": 0,\n  \"own_hash_commitment\": \"23c42f8a0bc08e64c2f6df29162764c8d83af9f74a8e0effd72dde2797feb019\",\n  \"peer_hash_commitment\": \"2f3eb10b9423fc2bd1f4e1e05a86ae6ca8c3fe3089ef95816038ad839d2e6d4d\",\n  \"raw_rows_in_partition\": 38192,\n  \"retained_rows\": 38192,\n  \"duplicates_removed\": 0,\n  \"excluded_rows\": 0,\n  \"components\": [\n    [\n      \"RWKV-4-Raven-14B\",\n      \"alpaca-13b\",\n      \"chatglm-6b\",\n      \"chatglm2-6b\",\n      \"chatglm3-6b\",\n      \"claude-1\",\n      \"claude-2.0\",\n      \"claude-2.1\",\n      \"claude-instant-1\",\n      \"codellama-34b-instruct\",\n      \"deepseek-llm-67b-chat\",\n      \"dolly-v2-12b\",\n      \"dolphin-2.2.1-mistral-7b\",\n      \"falcon-180b-chat\",\n      \"fastchat-t5-3b\",\n      \"gemini-pro\",\n      \"gemini-pro-dev-api\",\n      \"gpt-3.5-turbo-0125\",\n      \"gpt-3.5-turbo-0314\",\n      \"gpt-3.5-turbo-0613\",\n      \"gpt-3.5-turbo-1106\",\n      \"gpt-4-0125-preview\",\n      \"gpt-4-0314\",\n      \"gpt-4-0613\",\n      \"gpt-4-1106-preview\",\n      \"gpt4all-13b-snoozy\",\n      \"guanaco-33b\",\n      \"koala-13b\",\n      \"llama-13b\",\n      \"llama-2-13b-chat\",\n      \"llama-2-70b-chat\",\n      \"llama-2-7b-chat\",\n      \"llama2-70b-steerlm-chat\",\n      \"mistral-7b-instruct\",\n      \"mistral-7b-instruct-v0.2\",\n      \"mistral-medium\",\n      \"mixtral-8x7b-instruct-v0.1\",\n      \"mpt-30b-chat\",\n      \"mpt-7b-chat\",\n      \"nous-hermes-2-mixtral-8x7b-dpo\",\n      \"oasst-pythia-12b\",\n      \"openchat-3.5\",\n      \"openchat-3.5-0106\",\n      \"openhermes-2.5-mistral-7b\",\n      \"palm-2\",\n      \"pplx-70b-online\",\n      \"pplx-7b-online\",\n      \"qwen-14b-chat\",\n      \"qwen1.5-4b-chat\",\n      \"qwen1.5-72b-chat\",\n      \"qwen1.5-7b-chat\",\n      \"solar-10.7b-instruct-v1.0\",\n      \"stablelm-tuned-alpha-7b\",\n      \"starling-lm-7b-alpha\",\n      \"stripedhyena-nous-7b\",\n      \"tulu-2-dpo-70b\",\n      \"vicuna-13b\",\n      \"vicuna-33b\",\n      \"vicuna-7b\",\n      \"wizardlm-13b\",\n      \"wizardlm-70b\",\n      \"yi-34b-chat\",\n      \"zephyr-7b-alpha\",\n      \"zephyr-7b-beta\"\n    ]\n  ],\n  \"limitations\": \"Partition-specific largest undirected component; NBA historical team codes and eras heterogeneous. No causal evaluation-design comparison. Raw originals staged privately under /tmp at draft time, never runtime inputs.\"\n}\n","exit_code":0,"status":"completed"}}
