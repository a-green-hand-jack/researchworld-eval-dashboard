valuate_final.py; diff -u results/ideas/03_training_only_conformal_rank_scale_selection/program_0/src/program.py results/ideas/02_training_only_shrunk_local_moment_scale_correction/program_1/src/program.py | head -15; rg -n 'numpy|version|python' task/program_0/program_spec.toml; ls -l figures\"","aggregated_output":"result.top_program_01 {'attempt_id': 'cycle_03_rank_calibrated_scale_selection_attempt_01', 'id': 'result.top_program_01', 'idea_id': 'cycle_03_rank_calibrated_scale_selection', 'value': 0.6450635814905741}\nresult.top_program_02 {'attempt_id': 'cycle_02_shrunk_local_moment_scaling_attempt_01', 'id': 'result.top_program_02', 'idea_id': 'cycle_02_shrunk_local_moment_scaling', 'value': 0.6421289430111841}\nresult.improvement_001 {'attempt_id': 'cycle_01_boundary_stratified_geometry_attempt_01', 'id': 'result.improvement_001', 'idea_id': 'cycle_01_boundary_stratified_geometry', 'value': 0.6283805225369655}\nresult.improvement_002 {'attempt_id': 'cycle_02_shrunk_local_moment_scaling_attempt_01', 'id': 'result.improvement_002', 'idea_id': 'cycle_02_shrunk_local_moment_scaling', 'value': 0.6421289430111841}\nresult.improvement_003 {'attempt_id': 'cycle_03_rank_calibrated_scale_selection_attempt_01', 'id': 'result.improvement_003', 'idea_id': 'cycle_03_rank_calibrated_scale_selection', 'value': 0.6450635814905741}\nFinal score vs selected standard comparator: utility, mean V\nLN_IID_K3 {'scaled_ilr': [0.89008, 0.09863], 'unscaled_ilr': [0.89478, 0.09681], 'simplex_linf': [0.87768, 0.10901], 'bonferroni': [0.85466, 0.12077]}\nLN_IID_K8 {'scaled_ilr': [0.98172, 0.00205], 'unscaled_ilr': [0.9798, 0.00172], 'simplex_linf': [0.97419, 0.0124], 'bonferroni': [0.96563, 0.0151]}\nDIR_IID_K3 {'scaled_ilr': [0.6719, 0.31482], 'unscaled_ilr': [0.63074, 0.36122], 'simplex_linf': [0.67173, 0.3197], 'bonferroni': [0.61486, 0.3641]}\nDIR_IID_K8 {'scaled_ilr': [0.54881, 0.44178], 'unscaled_ilr': [0.29084, 0.70456], 'simplex_linf': [0.37956, 0.61555], 'bonferroni': [0.34608, 0.