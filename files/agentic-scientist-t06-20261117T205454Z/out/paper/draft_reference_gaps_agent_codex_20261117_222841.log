0\",\n      \"consulted_artifact\": \"literature/Efron1979.json\",\n      \"consultation_level\": \"abstract\"\n    },\n    {\n      \"id\": \"ref.Rubin1981\",\n      \"paper_id\": \"10\npaper_strategy.json top-level keys: ['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason']\ncentral_thesis \"A frozen-prefix audit with bounded exact-refit contender selection yields greater aggregate rank disruption than the measured deletion baselines on the final partitions, but its advantage depends on dataset and deletion budget, with fixed-mask group resampling favoring high-loss deletion in Arena and the studied selector in NBA.\"\nprior_paper_story_status \"recentered\"\npaper_data.json top-level keys: ['ablation_studies', 'all_programs', 'best_any', 'best_correct', 'evidence_sources', 'final_evaluation', 'generated_at', 'grounding_sources', 'idea_titles', 'improvement_trace', 'paper_profile', 'presentation_contract', 'results_dir', 'top_programs', 'totals']\nFinal metrics: {\"combined_score\": 0.011722185737596697, \"completion_rate\": 1.0, \"control_pass_rate\": 1.0, \"correct\": 1.0, \"disagreement_baseline_score\": 0.009340217174121283, \"mean_leader_rank_drop\": 0.03305066318764949, \"paired_gain_disagreement_ci_high\": 0.002381968563475412, \"paired_gain_disagreement_ci_low\": 0.002381968563475412, \"paired_gain_random_ci_high\": 0.008168732424939618, \"paired_gain_random_ci_low\": 0.007377907506332164, \"paired_gain_vs_disagreement\": 0.002381968563475412, \"paired_gain_vs_random\": 0.00781942656942657, \"random_baseline_score\": 0.003902759168170127}\nGrounding sources: ['final.evidence.episodes', 'final.metric.combined_score', 'final.metric.completion_rate', 'final.metric.control_pass_rate', 'final.metric.correct', 'final.metric.disagreement_baseline_score', 'final.metric.mean_leader_rank_drop', 'final.metric.paired_gain_disagreement_ci_high', 'final.metric.paired_gain_disagreement_ci_low', 'final.metric.paired_gain_random_ci_high', 'final.metric.paired_gain_random_ci_low', 'final.metric.paired_gain_vs_disagreement', 'final.metric.paired_gain_vs_random', 'final.metric.random_baseline_score', 'final.qualification.correct', 'final.qualification.outcome', 'final.qualification.status', 'result.best_any_score', 'result.best_correct_score', 'result.improvement_001', 'result.improvement_002', 'result.top_program_01', 'result.top_program_02', 'result.top_program_03', 'result.total_attempts', 'result.total_correct_programs', 'result.total_evaluated_programs', 'result.total_ideas']\n","exit_code":0,"status":"completed"}}
