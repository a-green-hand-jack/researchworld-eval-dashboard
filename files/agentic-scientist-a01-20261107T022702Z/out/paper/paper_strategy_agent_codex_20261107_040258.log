statuses',dict(collections.Counter(o['allocation']['status'] for o in first)))\n print('allocations identical across seeds:',all([(o['target'],o['rule'],o['fraction'],o['allocation']) for o in batch]==[(o['target'],o['rule'],o['fraction'],o['allocation']) for o in first] for batch in originals))\n print('all feasible candidate cardinalities match exact reference:',all(len(o['allocation']['tasks'])==o['reference']['upper'] for o in first if o['allocation']['status']=='feasible'))\n for target in ([10,16,40] if fam=='helm' else [1609,1331]):\n  print('example',target,[(o['rule'],o['fraction'],o['allocation']['status'],len(o['allocation']['tasks'])) for o in first if o['target']==target])\n for rule in ['mean','median','borda']:\n  print(rule,[(f,sum(o['allocation']['status']=='feasible' for o in first if o['rule']==rule and o['fraction']==f)) for f in [1.,.5]])\nprint('Grounding final source:',json.dumps(p['grounding_sources']['final.evidence.episodes']))\nr=json.loads(Path('references_provenance.json').read_text())\nprint('provenance count',r.get('count'),'queries',len(r.get('queries',[])))\nif isinstance(r['references'],list):\n for ref in r['references']:\n  if 'Lanctot' in str(ref.get('bibtex_key',ref.get('citation_key',''))) or 'Handbook' in str(ref.get('title','')):\n   print('allowed relevant record',json.dumps(ref)[:1900])\nPY\"","aggregated_output":"helm targets [40, 10, 37, 18, 28, 16, 26, 20]\nExact references 48 of 48 statuses {'feasible': 38, 'unattainable': 10}\nallocations identical across seeds: True\nall feasible candidate cardinalities match exact reference: True\nexample 10 [('mean', 1.0, 'feasible', 9), ('mean', 0.5, 'feasible', 23), ('median', 1.0, 'feasible', 12), ('median', 0.5, 'feasible', 12), ('borda', 1.0, 'feasible', 34), ('borda', 0.5, 'feasible', 39)]\nexample 16 [('mean', 1.0, 'feasible', 21), ('mean', 0.5, 'unattainable', 0), ('median', 1.0, 'feasible', 24), ('median', 0.5, 'unattainable', 0), ('borda', 1.0, 'feasible', 50), ('borda', 0