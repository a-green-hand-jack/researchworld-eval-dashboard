{"type":"item.started","item":{"id":"item_132","type":"command_execution","command":"/bin/sh -lc \"/tmp/paper-tools/apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: build_claim_mapping.py\n+import hashlib\n+import json\n+import pathlib\n+\n+\n+ROOT = pathlib.Path(__file__).resolve().parent\n+\n+\n+def main():\n+    # @evidence[[paper_data.json#/final_evaluation]]\n+    paper = json.loads((ROOT / 'paper_data.json').read_text())\n+    derived = json.loads((ROOT / 'derived_results.json').read_text())\n+    references = json.loads((ROOT / 'references_provenance.json').read_text())\n+    claims = []\n+\n+    def add(claim, source_ids, evidence_refs, citation_keys=None, **extra):\n+        claims.append({'claim': claim, 'source_ids': source_ids, 'citation_keys': citation_keys or [],\n+                       'evidence_refs': evidence_refs, **extra})\n+\n+    for method, metric in [('latent', 'candidate_mae'), ('greedy_ridge', 'greedy_ridge_mae'),\n+                           ('random_lowrank', 'random_lowrank_mae'), ('historical_mean', 'historical_mean_mae'),\n+                           ('score_average', 'observed_copy_mae')]:\n+        value = paper['final_evaluation']['metrics'][metric]\n+        add(f'{method} aggregate remaining-target normalized MAE is {value:.5f}.',\n+            ['final.metric.' + metric], [f'paper_data.json#/final_evaluation/metrics/{metric}'],\n+            scope='Original non-replay final cases; historical mean and score average use latent-policy remaining sets.')\n+    add('The latent procedure has lower aggregate remaining-target and common-audit MAE than the two evaluated predictive baseline pipelines; this is descriptive, not an isolated component effect or significance claim.',\n+        ['final.metric.candidate_mae', 'final.metric.greedy_ridge_mae', 'final.metric.random_lowrank_mae', 'final.evidence.episodes'],\n+        ['derived_results.json#/aggregate_original', 'build_paper_figures.py'],\n+        aggregation='Equal original condition-seed cases after equal checkpoint and row/proxy-family means.')\n+    for method, value in derived['aggregate_original']['audit'].items():\n+        add(f'{method} aggregate common-audit normalized MAE is {value:.5f}.', ['final.evidence.episodes'],\n+            ['derived_results.json#/aggregate_original/audit/' + method, 'build_paper_figures.py'],\n+            derivation='Average original non-replay case audit means; historical mean uses mean_audit_mae in observation records.')\n+    for case in derived['cases']:\n+        if case['arm'] \"'!= '\"'original':\n+            continue\n+        add(f\\\"Original {case['condition']} split {case['seed']}: latent/ridge remaining MAE \\\"\n+            f\\\"{case['remaining']['latent']:.5f}/{case['remaining']['greedy_ridge']:.5f}; \\\"\n+            f\\\"audit MAE {case['audit']['latent']:.5f}/{case['audit']['greedy_ridge']:.5f}.\\\",\n+            ['final.evidence.episodes'], ['paper_data.json#' + case['pointer']],\n+            values={'remaining': case['remaining'], 'audit': case['audit']})\n+    add('Family-disjoint seed 4021 reverses the latent-versus-ridge comparison on both remaining and common-audit targets. No evaluator evidence identifies a validity or adaptivity failure as its cause.',\n+        ['final.evidence.episodes'], ['derived_results.json#/cases'],\n+        scope='A measured performance reversal, not a diagnosed mechanism or qualification failure.')\n+    for condition in ['model_group', 'family_disjoint']:\n+        for method in ['latent', 'greedy_ridge', 'random_lowrank']:\n+            for budget in [1, 2, 4, 8]:\n+                rows = [row for row in derived['audit_budget_curves'] if row['condition'] == condition and row['method'] == method and row['k'] == budget and row['arm'] == 'original']\n+                mean = sum(row['mae'] for row in rows) / len(rows)\n+                add(f'{condition}, {method}, k={budget}: descriptive mean common-audit MAE {mean:.5f}.',\n+                    ['final.evidence.episodes'], ['paper_data.json#' + row['pointer'] for row in rows],\n+                    individual_split_values={str(row['seed']): row['mae'] for row in rows},\n+                    derivation='Checkpoint-specific equal-row/model-group or equal-proxy-family/family-disjoint means, then equal split means.',\n+                    plot_group='common_target_budget_comparison')\n+    add('Family-disjoint mean audit error at k=2 favors ridge over the latent procedure; average audit error for each method decreases over the measured budgets without establishing universal budget sufficiency.',\n+        ['final.evidence.episodes'], ['derived_results.json#/audit_budget_curves'])\n+    for metric in ['permuted_mae', 'permutation_gap']:\n+        add(f\\\"Latent {metric} is {paper['final_evaluation']['metrics'][metric]:.5f}.\\\",\n+            ['final.metric.' + metric], ['paper_data.json#/final_evaluation/metrics/' + metric])\n+    add('Column-permuted history increases common-audit error for the evaluated predictive pipelines; plotted values include every original/permuted split pair and descriptive means. Entire pipelines are refit and retuned, so this is not a covariance-only or adaptation-only ablation.',\n+        ['final.evidence.episodes'], ['derived_results.json#/cases', 'source_evidence/protocol/evaluate_final.py#permute_history'],\n+        plot_group='historical_alignment_control',\n+        plotted_records=[{'seed': case['seed'], 'condition': case['condition'], 'arm': case['arm'], 'audit': case['audit'], 'pointer': case['pointer']} for case in derived['cases']])\n+    for field in ['status', 'outcome']:\n+        value = paper['grounding_sources']['final.qualification.' + field]['value']\n+        add(f'Final evaluation qualification {field} is {value}; operational qualification does not establish generalization, validity beyond checked predicates, or scientific superiority.',\n+            ['final.qualification.' + field], ['paper_data.json#/grounding_sources/final.qualification.' + field + '/value'])\n+    add('The final evidence contains three split seeds (4001, 4009, 4021), two holdout conditions, 48 target rows per condition-seed, four checkpoints (1,2,4,8), original/permuted arms, and a zero-weight reset replay.',\n+        ['final.evidence.episodes'], ['paper_data.json#/final_evaluation/evaluation_evidence/episodes', 'source_evidence/protocol/data_manifest.json#/production'],\n+        scope='Conditions within one embedding benchmark source, not multiple independent datasets.')\n+    add('The final source is pinned English MTEB; panels have 48 benchmark-context columns, eight never-queryable audit columns, 88-99 historical rows, and at least four recorded audit cells per held-out row. Availability and content grouping constrain the population; name-defined families are lineage proxies.',\n+        ['final.evidence.episodes'], ['source_evidence/protocol/data_manifest.json', 'source_evidence/protocol/evaluate_final.py#load_resources', 'source_evidence/protocol/evaluate_final.py#score_cells'],\n+        source_scope='Final source ID identifies the evaluated observations; readable manifest and evaluator substantively support protocol settings, not the evaluation hash alone.')\n+    add('Scalar scores are normalized using declared metric bounds, including (s+1)/2 for signed Spearman; dataset revision stays part of column identity, no imputed cell is a scored target, and no held-out extrema define normalization.',\n+        ['final.evidence.episodes'], ['source_evidence/protocol/evaluate_final.py#score_cells', 'source_evidence/protocol/evaluate_final.py#losses'])\n+    add('Observed-data factor fitting, Gaussian conditional prediction, bounded mixture median prediction, and moment-matched off-diagonal transfer rules are implemented in the selected preserved source. Equation-level optimality applies to the fitted distribution, not real-data Bayes optimality.',\n+        ['result.top_program_01', 'final.evidence.episodes'], ['source_evidence/latent/covariance.py', 'source_evidence/latent/mixture.py', 'source_evidence/protocol/selection_manifest.json'],\n+        source_scope='Registry IDs and selection manifest establish provenance; readable code is the substantive implementation evidence.')\n+    add('Historical model choice uses ranks 2/4/8, residual shrinkage 2/12, optional mixture sizes 2/4, regularization 2/8, at most twelve validation/profile sweeps, thirty outer fitting sweeps, and twenty-five median bisections; the internal replacement margin is max(1e-4,0.5 paired SE). Further floors, initializations and validation dimensions are described directly from the source, not from unverified runtime diagnostics.',\n+        ['result.top_program_01'], ['source_evidence/latent/covariance.py', 'source_evidence/latent/mixture.py', 'source_evidence/protocol/evaluate_final.py#main'],\n+        source_scope='Static settings only; no assertion about realized component, fallback, or selector choices.')\n+    add('Random low-rank uses masked alternating ridge with ranks 2/4, penalties 0.1/1, eight validation sweeps and thirty final sweeps. Greedy ridge uses overlap-shrunk correlations with at least four pairs, n/(n+10) shrinkage, and penalty 0.1.',\n+        ['final.evidence.episodes'], ['source_evidence/protocol/evaluate_final.py#factor_fit', 'source_evidence/protocol/evaluate_final.py#tune_fit', 'source_evidence/protocol/evaluate_final.py#native_ridge'],\n+        source_scope='Readable evaluated baseline implementation, plus retained baseline observation records.')\n+    add('The designated reset replay matches selected columns and predictions under the evaluator check and is excluded from performance means. Candidate-generated diagnostics are explicitly unverified; no externally verified component ablations or additional dataset evaluations are provided.',\n+        ['final.evidence.episodes', 'final.qualification.outcome'], ['paper_data.json#/final_evaluation/evaluation_evidence', 'paper_data.json#/ablation_studies', 'source_evidence/protocol/evaluate_final.py#replay_equal'])\n+    for reference in references['references']:\n+        add('Literature positioning: ' + reference['title'] + '; consulted scope is recorded and no unrun published method comparison is claimed.',\n+            [reference['id']], [reference['reading_record'], 'literature/reading_notes.md'],\n+            citation_keys=[reference['citation_key']])\n+    allowed = set(paper['grounding_sources']) | {reference['id'] for reference in references['references']}\n+    for claim in claims:\n+        assert set(claim['source_ids']) <= allowed\n+    output = ROOT / 'claims_grounding.json'\n+    output.write_text(json.dumps({'claims': claims}, indent=2) + '\\\\n')\n+    sidecars = {'claims_grounding.json': ['paper_data.json', 'derived_results.json', 'references_provenance.json'],\n+                'paper.tex': ['paper_data.json', 'derived_results.json', 'references.bib', 'source_evidence/latent/covariance.py', 'source_evidence/latent/mixture.py'],\n+                'references.bib': [reference['reading_record'] for reference in references['references']],\n+                'references_provenance.json': [reference['reading_record'] for reference in references['references']]}\n+    for name, inputs in sidecars.items():\n+        path = ROOT / name\n+        payload = {'schema_name': 'scientific-evidence.artifact-manifest',\n+                   'artifact': {'path': name, 'kind': 'manuscript' if name == 'paper.tex' else 'derived',\n+                                'sha256': hashlib.sha256(path.read_bytes()).hexdigest()},\n+                   'derived_from': ['@evidence[[' + source + ']]' for source in inputs],\n+                   'generated_by': {'script_path': 'build_claim_mapping.py'},\n+                   'notes': 'Mapping/sidecar emission only; paper and consulted references are authored from the listed inputs.'}\n+        path.with_name(path.name + '.prov.json').write_text(json.dumps(payload, indent=2) + '\\\\n')\n+    snapshot = {}\n+    for path in (ROOT / 'source_evidence').rglob('*'):\n+        if path.is_file():\n+            snapshot[str(path.relative_to(ROOT))] = hashlib.sha256(path.read_bytes()).hexdigest()\n+    (ROOT / 'source_evidence/manifest.json').write_text(json.dumps({'files': snapshot,\n+        'selected_source': 'results/ideas/02_value_adaptive_latent_mixtures_for_absolute_error_benchmark_prediction/program_1',\n+        'scope': 'Readable copied source supports implementation claims; hashes identify provenance, not scientific behavior.'}, indent=2) + '\\\\n')\n+    print('Mapped', len(claims), 'claims')\n+\n+\n+if __name__ == '__main__':\n+    main()\n*** Add File: REPRODUCIBILITY.md\n+# Reproducibility\n+\n+## Scope and frozen evidence\n+\n+This package describes a completed, CPU-only retrospective English embedding-model study. It does not report a newly executed benchmark evaluation. \"'`paper_data.json` is an immutable supplied evidence registry. Final qualification is independently recorded as completed/qualified; that operational status does not establish a generalization or superiority claim. `derived_results.json` is a deterministic reaggregation of retained final records, not a new experiment. All original cases are retained, including the adverse family-disjoint split at seed 4021. No component-specific causal attribution is made. Unverified internal fitting diagnostics are not treated as measurements.\n+\n+There is no downstream-study object, no additional task name list, no external component ablation bundle, and no posthoc analysis bundle in these inputs. Both evaluated holdout conditions are covered. Search scores are not mixed into final measurements.\n+\n+## Files and source identity\n+\n+- `source_evidence/latent/program_spec.toml` identifies the entrypoint `program.py`; `program.py`, `covariance.py`, and `mixture.py` are readable copies of the selected latent-mixture implementation, not the separate quadrature extension.\n+- `source_evidence/protocol/selection_manifest.json` preserves the supplied selected-source linkage. `evaluation_manifest.json` preserves final provenance and qualification. `source_evidence/manifest.json` records local file checksums. These identify provenance; implementation claims rely on the code itself.\n+- `source_evidence/protocol/evaluate_final.py` preserves the complete evaluator, native baseline fitting, scoring, permutation and replay logic.\n+- `source_evidence/protocol/resources/final/{dataset,manifest}.json` are exact copies of the supplied frozen final source documents and split specification. The duplicate `data_manifest.json` is a convenient readable protocol anchor. The source documents retain original source paths, raw checksums, normalized content and missingness.\n+\n+The original MTEB data are public at `https://github.com/embeddings-benchmark/results`, revision `6dabbcc68c28ea5f180ce7df79347b3ca9cc6383` (CC0-1.0 per supplied task metadata). For independent access, clone that named repository and check out exactly this revision. The frozen document subset and benchmark-context identities are recorded in the included dataset and manifest. Do not scrape a changing leaderboard or infer missing targets from aggregates. Signed correlations use fixed declared bounds; all other retained metric normalization is implemented in `score_cells`. Only recorded target cells are scored.\n+\n+## Environment\n+\n+Inference: Python 3.12 and NumPy 2.2.6, CPU only. The native isolated evaluator requires Linux x86-64, at least four assigned CPU cores, Landlock ABI 3 and seccomp support; its budget constants and operating-system restrictions are preserved in source. They are not benchmark-specific predictive inputs. The original supplied dependency specification is `source_evidence/protocol/requirements.txt`.\n+\n+Manuscript environment versions are recorded in `manuscript_environment.json`. Additional plotting/validation packages are installed in a private environment outside the manuscript workspace. A reproducible setup is:\n+\n+```sh\n+python3.12 -m venv /tmp/embedding-paper-env\n+/tmp/embedding-paper-env/bin/pip install -r requirements-paper.txt\n+```\n+\n+No GPU or paid inference API is required to regenerate numeric figures and tables. Optional concept rendering belongs to the orchestration workflow; the guarded placeholder is not a measured result. The writer does not invoke that workflow or modify its completion marker.\n+\n+## Regenerating manuscript artifacts\n+\n+```sh\n+/tmp/embedding-paper-env/bin/python build_paper_figures.py\n+/tmp/embedding-paper-env/bin/python build_claim_mapping.py\n+pdflatex -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\n+bibtex paper\n+pdflatex -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\n+pdflatex -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\n+```\n+\n+Plot generation reads final episode records and asserts agreement with final scalar aggregates. No seed needs to be sampled again: the evaluated split seeds are 4001, 4009 and 4021; query budgets are 1, 2, 4 and 8. Per-row and per-family weighting, zero replay weight and the original/permuted distinction are implemented explicitly. Generating these small plots should take seconds to minutes depending on the machine; this is an expectation, not a measured resource saving. The recorded evidence does not measure benchmark execution costs. Complete evaluation timeouts are source constraints, not runtime estimates.\n+\n+`finalize_references.py` assembles the bibliography from cached, consulted records. Running it with the manuscript environment additionally requires Beautiful Soup, specified below. It only retrieves the three explicitly named original arXiv records if absent. The earlier retrieval scripts document exact-source acquisition, but their partial/mismatched records must not be reintroduced into the final bibliography. `literature/reading_notes.md` records the consultation scope, rejected DOI match, rejected unrelated provider abstract and source-access failures. No prohibited source was searched for or encountered.\n+\n+The ICLR 2026 official template archive was downloaded directly from `https://raw.githubusercontent.com/ICLR/Master-Template/master/iclr2026.zip`. `paper.sty` matches its official style after restoring the two conference header strings omitted by the initially supplied copy; `paper.bst` matches the archive bibliography style. Geometry is unchanged: 5.5-inch single text column, 9-inch text height. The submission remains anonymous and uses the review format, without acknowledgements or funding information. No additional ICLR checklist form is supplied by this template; limitations, reproducibility and LLM Usage disclosures are explicit in the manuscript.\n+\n+## Figure and table mapping\n+\n+| Manuscript object | Reproduction input and code |\n+|---|---|\n+| Figure 1, conceptual overview | Strategy diagram specification and manuscript; rendered by orchestrator. `build_paper_figures.py` only creates an idempotent reservation image if no completed render exists. No numerical cells are invented. |\n+| Figure 2, fixed-audit budget curves | `build_paper_figures.py`, final original non-replay `observations[*].audit_mae` and baseline checkpoint records; `derived_results.json.audit_budget_curves`. |\n+| Figure 3, historical-alignment control | Same script, original/permuted `case.audit_mae` and `case.baseline_audit` in order random-lowrank/ridge; `derived_results.json.cases`. |\n+| Table 1, aggregate accuracy | `derived_results.json.aggregate_original`; remaining means assert agreement with authoritative final scalars; historical-mean audit errors derive from `mean_audit_mae`. Values are rounded to five decimals in `paper.tex`. |\n+| Table 2, original split summaries | `derived_results.json.cases`, restricted to original arms; direct case loss and audit summaries, rounded to five decimals. |\n+\n+All quantitative panel exports are vector PDF and 300-DPI PNG from one source. LaTeX includes the PDF files. One two-panel group occupies the full text width; individual panel width is 0.487 of that span, retaining roughly 9.4-point minimum labels. Raw split points are descriptive, not independent population samples or confidence intervals.\n+\n+## Optional future evaluator replay (not executed for this manuscript)\n+\n+In an environment satisfying the native isolation prerequisites:\n+\n+```sh\n+python3.12 -m venv /tmp/embedding-inference-env\n+/tmp/embedding-inference-env/bin/pip install -r source_evidence/protocol/requirements.txt\n+/tmp/embedding-inference-env/bin/python source_evidence/protocol/evaluate_final.py '\"\\\\\n+  --program_path source_evidence/latent/program.py \\\\\n+  --results_dir /tmp/embedding-final-replay\n+\"'```\n+\n+This command would rerun the supplied evaluator. It was **not** run by the paper-writing step, is not needed to regenerate manuscript figures, and does not overwrite or replace the sealed final evidence. The evaluator allows a final workload wall limit of 1800 seconds; this is not a promised runtime. Exact runtime depends on isolation support, hardware and numerical environment. An unsupported operating-system sandbox is a replay-environment failure, not measured predictive inferiority.\n+\n+## Validation\n+\n+Run the provided `validate-paper` section/reference checks, claim validator, figure validator, compilation and `scientific-evidence` verifier. Keep `.prov.json` files adjacent to derived artifacts. Validation results and any local toolchain adaptations are recorded in `validation_summary.json`. The authoritative report for evidence links is `scientific-evidence/verification-report.json`, which must have zero dangling references. The final concept image and prompt log remain an explicit downstream orchestration dependency rather than a claimed completed writer-produced figure.\n*** End Patch\nPATCH\n/tmp/paper-venv/bin/pip freeze > requirements-paper.txt\n/tmp/paper-venv/bin/python build_claim_mapping.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_132","type":"command_execution","command":"/bin/sh -lc \"/tmp/paper-tools/apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: build_claim_mapping.py\n+import hashlib\n+import json\n+import pathlib\n+\n+\n+ROOT = pathlib.Path(__file__).resolve().parent\n+\n+\n+def main():\n+    # @evidence[[paper_data.json#/final_evaluation]]\n+    paper = json.loads((ROOT / 'paper_data.json').read_text())\n+    derived = json.loads((ROOT / 'derived_results.json').read_text())\n+    references = json.loads((ROOT / 'references_provenance.json').read_text())\n+    claims = []\n+\n+    def add(claim, source_ids, evidence_refs, citation_keys=None, **extra):\n+        claims.append({'claim': claim, 'source_ids': source_ids, 'citation_keys': citation_keys or [],\n+                       'evidence_refs': evidence_refs, **extra})\n+\n+    for method, metric in [('latent', 'candidate_mae'), ('greedy_ridge', 'greedy_ridge_mae'),\n+                           ('random_lowrank', 'random_lowrank_mae'), ('historical_mean', 'historical_mean_mae'),\n+                           ('score_average', 'observed_copy_mae')]:\n+        value = paper['final_evaluation']['metrics'][metric]\n+        add(f'{method} aggregate remaining-target normalized MAE is {value:.5f}.',\n+            ['final.metric.' + metric], [f'paper_data.json#/final_evaluation/metrics/{metric}'],\n+            scope='Original non-replay final cases; historical mean and score average use latent-policy remaining sets.')\n+    add('The latent procedure has lower aggregate remaining-target and common-audit MAE than the two evaluated predictive baseline pipelines; this is descriptive, not an isolated component effect or significance claim.',\n+        ['final.metric.candidate_mae', 'final.metric.greedy_ridge_mae', 'final.metric.random_lowrank_mae', 'final.evidence.episodes'],\n+        ['derived_results.json#/aggregate_original', 'build_paper_figures.py'],\n+        aggregation='Equal original condition-seed cases after equal checkpoint and row/proxy-family means.')\n+    for method, value in derived['aggregate_original']['audit'].items():\n+        add(f'{method} aggregate common-audit normalized MAE is {value:.5f}.', ['final.evidence.episodes'],\n+            ['derived_results.json#/aggregate_original/audit/' + method, 'build_paper_figures.py'],\n+            derivation='Average original non-replay case audit means; historical mean uses mean_audit_mae in observation records.')\n+    for case in derived['cases']:\n+        if case['arm'] \"'!= '\"'original':\n+            continue\n+        add(f\\\"Original {case['condition']} split {case['seed']}: latent/ridge remaining MAE \\\"\n+            f\\\"{case['remaining']['latent']:.5f}/{case['remaining']['greedy_ridge']:.5f}; \\\"\n+            f\\\"audit MAE {case['audit']['latent']:.5f}/{case['audit']['greedy_ridge']:.5f}.\\\",\n+            ['final.evidence.episodes'], ['paper_data.json#' + case['pointer']],\n+            values={'remaining': case['remaining'], 'audit': case['audit']})\n+    add('Family-disjoint seed 4021 reverses the latent-versus-ridge comparison on both remaining and common-audit targets. No evaluator evidence identifies a validity or adaptivity failure as its cause.',\n+        ['final.evidence.episodes'], ['derived_results.json#/cases'],\n+        scope='A measured performance reversal, not a diagnosed mechanism or qualification failure.')\n+    for condition in ['model_group', 'family_disjoint']:\n+        for method in ['latent', 'greedy_ridge', 'random_lowrank']:\n+            for budget in [1, 2, 4, 8]:\n+                rows = [row for row in derived['audit_budget_curves'] if row['condition'] == condition and row['method'] == method and row['k'] == budget and row['arm'] == 'original']\n+                mean = sum(row['mae'] for row in rows) / len(rows)\n+                add(f'{condition}, {method}, k={budget}: descriptive mean common-audit MAE {mean:.5f}.',\n+                    ['final.evidence.episodes'], ['paper_data.json#' + row['pointer'] for row in rows],\n+                    individual_split_values={str(row['seed']): row['mae'] for row in rows},\n+                    derivation='Checkpoint-specific equal-row/model-group or equal-proxy-family/family-disjoint means, then equal split means.',\n+                    plot_group='common_target_budget_comparison')\n+    add('Family-disjoint mean audit error at k=2 favors ridge over the latent procedure; average audit error for each method decreases over the measured budgets without establishing universal budget sufficiency.',\n+        ['final.evidence.episodes'], ['derived_results.json#/audit_budget_curves'])\n+    for metric in ['permuted_mae', 'permutation_gap']:\n+        add(f\\\"Latent {metric} is {paper['final_evaluation']['metrics'][metric]:.5f}.\\\",\n+            ['final.metric.' + metric], ['paper_data.json#/final_evaluation/metrics/' + metric])\n+    add('Column-permuted history increases common-audit error for the evaluated predictive pipelines; plotted values include every original/permuted split pair and descriptive means. Entire pipelines are refit and retuned, so this is not a covariance-only or adaptation-only ablation.',\n+        ['final.evidence.episodes'], ['derived_results.json#/cases', 'source_evidence/protocol/evaluate_final.py#permute_history'],\n+        plot_group='historical_alignment_control',\n+        plotted_records=[{'seed': case['seed'], 'condition': case['condition'], 'arm': case['arm'], 'audit': case['audit'], 'pointer': case['pointer']} for case in derived['cases']])\n+    for field in ['status', 'outcome']:\n+        value = paper['grounding_sources']['final.qualification.' + field]['value']\n+        add(f'Final evaluation qualification {field} is {value}; operational qualification does not establish generalization, validity beyond checked predicates, or scientific superiority.',\n+            ['final.qualification.' + field], ['paper_data.json#/grounding_sources/final.qualification.' + field + '/value'])\n+    add('The final evidence contains three split seeds (4001, 4009, 4021), two holdout conditions, 48 target rows per condition-seed, four checkpoints (1,2,4,8), original/permuted arms, and a zero-weight reset replay.',\n+        ['final.evidence.episodes'], ['paper_data.json#/final_evaluation/evaluation_evidence/episodes', 'source_evidence/protocol/data_manifest.json#/production'],\n+        scope='Conditions within one embedding benchmark source, not multiple independent datasets.')\n+    add('The final source is pinned English MTEB; panels have 48 benchmark-context columns, eight never-queryable audit columns, 88-99 historical rows, and at least four recorded audit cells per held-out row. Availability and content grouping constrain the population; name-defined families are lineage proxies.',\n+        ['final.evidence.episodes'], ['source_evidence/protocol/data_manifest.json', 'source_evidence/protocol/evaluate_final.py#load_resources', 'source_evidence/protocol/evaluate_final.py#score_cells'],\n+        source_scope='Final source ID identifies the evaluated observations; readable manifest and evaluator substantively support protocol settings, not the evaluation hash alone.')\n+    add('Scalar scores are normalized using declared metric bounds, including (s+1)/2 for signed Spearman; dataset revision stays part of column identity, no imputed cell is a scored target, and no held-out extrema define normalization.',\n+        ['final.evidence.episodes'], ['source_evidence/protocol/evaluate_final.py#score_cells', 'source_evidence/protocol/evaluate_final.py#losses'])\n+    add('Observed-data factor fitting, Gaussian conditional prediction, bounded mixture median prediction, and moment-matched off-diagonal transfer rules are implemented in the selected preserved source. Equation-level optimality applies to the fitted distribution, not real-data Bayes optimality.',\n+        ['result.top_program_01', 'final.evidence.episodes'], ['source_evidence/latent/covariance.py', 'source_evidence/latent/mixture.py', 'source_evidence/protocol/selection_manifest.json'],\n+        source_scope='Registry IDs and selection manifest establish provenance; readable code is the substantive implementation evidence.')\n+    add('Historical model choice uses ranks 2/4/8, residual shrinkage 2/12, optional mixture sizes 2/4, regularization 2/8, at most twelve validation/profile sweeps, thirty outer fitting sweeps, and twenty-five median bisections; the internal replacement margin is max(1e-4,0.5 paired SE). Further floors, initializations and validation dimensions are described directly from the source, not from unverified runtime diagnostics.',\n+        ['result.top_program_01'], ['source_evidence/latent/covariance.py', 'source_evidence/latent/mixture.py', 'source_evidence/protocol/evaluate_final.py#main'],\n+        source_scope='Static settings only; no assertion about realized component, fallback, or selector choices.')\n+    add('Random low-rank uses masked alternating ridge with ranks 2/4, penalties 0.1/1, eight validation sweeps and thirty final sweeps. Greedy ridge uses overlap-shrunk correlations with at least four pairs, n/(n+10) shrinkage, and penalty 0.1.',\n+        ['final.evidence.episodes'], ['source_evidence/protocol/evaluate_final.py#factor_fit', 'source_evidence/protocol/evaluate_final.py#tune_fit', 'source_evidence/protocol/evaluate_final.py#native_ridge'],\n+        source_scope='Readable evaluated baseline implementation, plus retained baseline observation records.')\n+    add('The designated reset replay matches selected columns and predictions under the evaluator check and is excluded from performance means. Candidate-generated diagnostics are explicitly unverified; no externally verified component ablations or additional dataset evaluations are provided.',\n+        ['final.evidence.episodes', 'final.qualification.outcome'], ['paper_data.json#/final_evaluation/evaluation_evidence', 'paper_data.json#/ablation_studies', 'source_evidence/protocol/evaluate_final.py#replay_equal'])\n+    for reference in references['references']:\n+        add('Literature positioning: ' + reference['title'] + '; consulted scope is recorded and no unrun published method comparison is claimed.',\n+            [reference['id']], [reference['reading_record'], 'literature/reading_notes.md'],\n+            citation_keys=[reference['citation_key']])\n+    allowed = set(paper['grounding_sources']) | {reference['id'] for reference in references['references']}\n+    for claim in claims:\n+        assert set(claim['source_ids']) <= allowed\n+    output = ROOT / 'claims_grounding.json'\n+    output.write_text(json.dumps({'claims': claims}, indent=2) + '\\\\n')\n+    sidecars = {'claims_grounding.json': ['paper_data.json', 'derived_results.json', 'references_provenance.json'],\n+                'paper.tex': ['paper_data.json', 'derived_results.json', 'references.bib', 'source_evidence/latent/covariance.py', 'source_evidence/latent/mixture.py'],\n+                'references.bib': [reference['reading_record'] for reference in references['references']],\n+                'references_provenance.json': [reference['reading_record'] for reference in references['references']]}\n+    for name, inputs in sidecars.items():\n+        path = ROOT / name\n+        payload = {'schema_name': 'scientific-evidence.artifact-manifest',\n+                   'artifact': {'path': name, 'kind': 'manuscript' if name == 'paper.tex' else 'derived',\n+                                'sha256': hashlib.sha256(path.read_bytes()).hexdigest()},\n+                   'derived_from': ['@evidence[[' + source + ']]' for source in inputs],\n+                   'generated_by': {'script_path': 'build_claim_mapping.py'},\n+                   'notes': 'Mapping/sidecar emission only; paper and consulted references are authored from the listed inputs.'}\n+        path.with_name(path.name + '.prov.json').write_text(json.dumps(payload, indent=2) + '\\\\n')\n+    snapshot = {}\n+    for path in (ROOT / 'source_evidence').rglob('*'):\n+        if path.is_file():\n+            snapshot[str(path.relative_to(ROOT))] = hashlib.sha256(path.read_bytes()).hexdigest()\n+    (ROOT / 'source_evidence/manifest.json').write_text(json.dumps({'files': snapshot,\n+        'selected_source': 'results/ideas/02_value_adaptive_latent_mixtures_for_absolute_error_benchmark_prediction/program_1',\n+        'scope': 'Readable copied source supports implementation claims; hashes identify provenance, not scientific behavior.'}, indent=2) + '\\\\n')\n+    print('Mapped', len(claims), 'claims')\n+\n+\n+if __name__ == '__main__':\n+    main()\n*** Add File: REPRODUCIBILITY.md\n+# Reproducibility\n+\n+## Scope and frozen evidence\n+\n+This package describes a completed, CPU-only retrospective English embedding-model study. It does not report a newly executed benchmark evaluation. \"'`paper_data.json` is an immutable supplied evidence registry. Final qualification is independently recorded as completed/qualified; that operational status does not establish a generalization or superiority claim. `derived_results.json` is a deterministic reaggregation of retained final records, not a new experiment. All original cases are retained, including the adverse family-disjoint split at seed 4021. No component-specific causal attribution is made. Unverified internal fitting diagnostics are not treated as measurements.\n+\n+There is no downstream-study object, no additional task name list, no external component ablation bundle, and no posthoc analysis bundle in these inputs. Both evaluated holdout conditions are covered. Search scores are not mixed into final measurements.\n+\n+## Files and source identity\n+\n+- `source_evidence/latent/program_spec.toml` identifies the entrypoint `program.py`; `program.py`, `covariance.py`, and `mixture.py` are readable copies of the selected latent-mixture implementation, not the separ