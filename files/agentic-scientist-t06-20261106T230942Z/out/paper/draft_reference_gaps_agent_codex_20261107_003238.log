},\n journal={Mathematical Programming},\n doi={10.1007/s10107-010-0419-x},\n volume={127},\n number={1},\n pages={203-244}\n}\n@article{Bubeck2015,\n title={Convex Optimization: Algorithms and Complexity},\n author={Bubeck, Sébastien},\n year={2015},\n journal={Foundations and Trends in Machine Learning},\n volume={8},\n number={3-4},\n pages={231--358},\n doi={10.1561/2200000050},\n url={https://arxiv.org/abs/1405.4980}\n}\n@article{Hampel1974,\n title={The Influence Curve and its Role in Robust Estimation},\n author={Frank R. Hampel},\n year={1974},\n journal={Journal of the American Statistical Association},\n doi={10.1080/01621459.1974.10482962},\n volume={69},\n number={346},\n pages={383-393}\n}\n@article{Cook1977,\n title={Detection of Influential Observation in Linear Regression},\n author={R. Dennis Cook},\n year={1977},\n journal={Technometrics},\n doi={10.1080/00401706.1977.10489493},\n volume={19},\n number={1},\n pages={15-18}\n}\n@article{Efron1979,\n title={Bootstrap Methods: Another Look at the Jackknife},\n author={B. Efron},\n year={1979},\n journal={The Annals of Statistics},\n doi={10.1214/aos/1176344552},\n volume={7},\n number={1},\n pages={1-26}\n}\n@article{Efron1986,\n title={Bootstrap Methods for Standard Errors, Confidence Intervals, and Other Measures of Statistical Accuracy},\n author={B. Efron and R. Tibshirani},\n year={1986},\n journal={Statistical Science},\n doi={10.1214/ss/1177013815},\n volume={1},\n number={1},\n pages={54-75}\n}\n@book{Davison1997,\n title={Bootstrap Methods and their Application},\n author={A. C. Davison and D. V. Hinkley},\n year={1997},\n publisher={Cambridge University Press},\n doi={10.1017/CBO9780511802843}\n}\n@article{Cameron2008,\n title={Bootstrap-Based Improvements for Inference with Clustered Errors},\n author={A. Colin Cameron and Jonah B. Gelbach and Douglas L. Miller},\n year={2008},\n journal={Review of Economics and Statistics},\n doi={10.1162/rest.90.3.414},\n volume={90},\n number={3},\n pages={414-427}\n}\n@article{Huber1964,\n title={Robust Estimation of a Location Parameter},\n author={Peter J. Huber},\n year={1964},\n journal={The Annals of Mathematical Statistics},\n doi={10.1214/aoms/1177703732},\n volume={35},\n number={1},\n pages={73-101}\n}\n@article{Koh2017,\n title={Understanding Black-box Predictions via Influence Functions},\n author={Koh, Pang Wei and Liang, Percy},\n year={2017},\n journal={arXiv preprint arXiv:1703.04730},\n url={https://arxiv.org/abs/1703.04730}\n}\n@article{Broderick2020,\n title={An Automatic Finite-Sample Robustness Metric: When Can Dropping a Little Data Make a Big Difference?},\n author={Broderick, Tamara and Giordano, Ryan and Meager, Rachael},\n year={2020},\n journal={arXiv preprint arXiv:2011.14999},\n url={https://arxiv.org/abs/2011.14999}\n}\n@article{Chiang2024,\n title={Chatbot Arena: An Open Platform for Evaluating LLMs by Human Preference},\n author={Chiang, Wei-Lin and Zheng, Lianmin and Sheng, Ying and Angelopoulos, Anastasios Nikolas and Li, Tianle and Li, Dacheng and Zhang, Hao and Zhu, Banghua and Jordan, Michael and Gonzalez, Joseph E. and Stoica, Ion},\n year={2024},\n journal={arXiv preprint arXiv:2403.04132},\n url={https://arxiv.org/abs/2403.04132}\n}# Global Memory Summary\n\nUse as qualitative context only; do not use as quantitative grounding source.\n\n## Recent Entries\n\n- 2026-11-07 | step=idea | scope=idea\n  - summary: Selected Exposure Matched Block Deletion Stability. gate=kept; trigger=none; reason=No new empirical finding establishes a reusable recommendation; the proposed mechanism remains untested. Final status=idea_bundle_written.\n  - evidence: Supplied incumbent accepted: correct=true, combined_score=0.017824074074074076; no recent attempts or conclusions. Named incumbent source path was unavailable, leaving score causes unknown. No candidate/evaluator execution, numerical experiments, downloads, installations, or literature access. File reads and required patches used a terminal wrapper because dedicated file tools were unavailable, contrary to the literal no-command constraint. Alternatives considered: undifferentiated vote-removal attacks, expensive optimality certificates, and nonstationary pooled NBA comparisons. Selected observable matched MT-Bench human/GPT-4 coverage plus Arena external validation; all scientific claims remain hypotheses. Outputs: idea_bundle.json and target_rubrics.json; sole canonical local memory is ideas/01_exposure_matched_block_deletion_stability/memory.md under the results root.\n- 2026-11-07 | step=verify | scope=idea\n  - summary: Refined the primary endpoint to shared predeclared model-pair contrasts; source-specific winner attacks are secondary. gate=kept; trigger=none; reason=Prospective design clarification supplies no empirical finding to distill. Final status=idea_bundle_written.\n  - evidence: Different human/judge winners would otherwise create unmatched targets. Final plan specifies paired reversal indicators with concordance/support strata and actual discrete block costs. Both rubric arrays remain identically authored, with 1-8 executable literal snippets per implementation verification. Only ideas/01_exposure_matched_block_deletion_stability/memory.md was used as a local memory target; no alternative directory was created. No computational validation or candidate evaluation ran.\n- unknown_ts | step=unknown_step | scope=unknown_scope\n  - summary: (missing summary)\n  - evidence: (missing evidence)\n- unknown_ts | step=unknown_step | scope=unknown_scope\n  - summary: (missing summary)\n  - evidence: (missing evidence)\n- 2026-11-07T00:12:27.194405+00:00 | step=evaluate | scope=attempt\n  - summary: harness evaluated program_1 exactly once\n  - evidence: combined_score=0.04371978197409232, correct=True; scientific acceptance passed; search metrics (data): {\"combined_score\": 0.04371978197409232, \"control_error\": 0.0, \"correct\": true, \"degree_matched_score\": 0.012837054521680958, \"influe