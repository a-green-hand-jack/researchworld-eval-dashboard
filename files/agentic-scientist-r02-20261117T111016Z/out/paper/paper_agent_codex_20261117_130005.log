           {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Fallback Reason\"\n        },\n        \"figure_id\": {\n          \"minLength\": 1,\n          \"title\": \"Figure Id\",\n          \"type\": \"string\"\n        },\n        \"figure_type\": {\n          \"enum\": [\n            \"grouped_bar\",\n            \"bar\",\n            \"line\",\n            \"box\",\n            \"violin\",\n            \"scatter\",\n            \"heatmap\",\n            \"table_matrix\",\n            \"table\",\n            \"composite\",\n            \"diagram\"\n          ],\n          \"title\": \"Figure Type\",\n          \"type\": \"string\"\n        },\n        \"font_sizes\": {\n          \"$ref\": \"#/$defs/FigureFontSizes\"\n        },\n        \"generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Generator\"\n        },\n        \"intended_latex_width_fraction\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"maximum\": 1,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Intended Latex Width Fraction\"\n        },\n        \"max_label_chars\": {\n          \"exclusiveMinimum\": 0,\n          \"title\": \"Max Label Chars\",\n          \"type\": \"integer\"\n        },\n        \"n_panels\": {\n          \"exclusiveMinimum\": 0,\n          \"title\": \"N Panels\",\n          \"type\": \"integer\"\n        },\n        \"panels_per_row\": {\n          \"exclusiveMinimum\": 0,\n          \"title\": \"Panels Per Row\",\n          \"type\": \"integer\"\n        },\n        \"path_pdf\": {\n          \"default\": \"\",\n          \"title\": \"Path Pdf\",\n          \"type\": \"string\"\n        },\n        \"path_png\": {\n          \"minLength\": 1,\n          \"title\": \"Path Png\",\n          \"type\": \"string\"\n        },\n        \"placement\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"column\",\n                \"full_width\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Placement\"\n        },\n        \"prompt_log_path\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Prompt Log Path\"\n        },\n        \"series_per_panel\": {\n          \"items\": {\n            \"type\": \"integer\"\n          },\n          \"title\": \"Series Per Panel\",\n          \"type\": \"array\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"uses_abbrev_labels\": {\n          \"title\": \"Uses Abbrev Labels\",\n          \"type\": \"boolean\"\n        },\n        \"uses_progression\": {\n          \"title\": \"Uses Progression\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"figure_id\",\n        \"path_png\",\n        \"figure_type\",\n        \"n_panels\",\n        \"panels_per_row\",\n        \"categories_per_panel\",\n        \"series_per_panel\",\n        \"max_label_chars\",\n        \"font_sizes\",\n        \"uses_abbrev_labels\",\n        \"uses_progression\"\n      ],\n      \"title\": \"LegacyFigureManifestFigure\",\n      \"type\": \"object\"\n    },\n    \"RichFigureFiles\": {\n      \"additionalProperties\": false,\n      \"description\": \"Nested artifact paths used by the richer manifest shape.\",\n      \"properties\": {\n        \"pdf\": {\n          \"default\": \"\",\n          \"title\": \"Pdf\",\n          \"type\": \"string\"\n        },\n        \"png\": {\n          \"minLength\": 1,\n          \"title\": \"Png\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"png\"\n      ],\n      \"title\": \"RichFigureFiles\",\n      \"type\": \"object\"\n    },\n    \"RichFigureManifestFigure\": {\n      \"additionalProperties\": false,\n      \"allOf\": [\n        {\n          \"else\": {\n            \"properties\": {\n              \"files\": {\n                \"properties\": {\n                  \"pdf\": {\n                    \"minLength\": 1\n                  }\n                },\n                \"required\": [\n                  \"pdf\"\n                ]\n              }\n            }\n          },\n          \"if\": {\n            \"anyOf\": [\n              {\n                \"properties\": {\n                  \"generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  }\n                },\n                \"required\": [\n                  \"generator\"\n                ]\n              },\n              {\n                \"properties\": {\n                  \"attempted_generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  },\n                  \"fallback_reason\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  },\n                  \"generator\": {\n                    \"type\": \"null\"\n                  },\n                  \"prompt_log_path\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"generator\",\n                  \"attempted_generator\",\n                  \"prompt_log_path\",\n                  \"fallback_reason\"\n                ]\n              }\n            ]\n          }\n        }\n      ],\n      \"description\": \"Richer manifest shape used by newer standalone paper runs.\",\n      \"properties\": {\n        \"attempted_generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Attempted Generator\"\n        },\n        \"caption_short\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Caption Short\"\n        },\n        \"estimated_min_rendered_font_pt\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Estimated Min Rendered Font Pt\"\n        },\n        \"fallback_reason\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Fallback Reason\"\n        },\n        \"figure_id\": {\n          \"minLength\": 1,\n          \"title\": \"Figure Id\",\n          \"type