etrics']['selected_accuracy'] for c in cc),'disagreements',sum(c['metrics']['decision_reversal_rate'] for c in cc),'containments',sum(c['metrics']['coverage'] for c in cc))\nprint('All K16 audit intervals:')\nfor e in summary['audit_differences']:\n if e['case'].endswith('K16'):print(e['seed'],e['case'],e['interval'],e['difference'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
