{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re,statistics\nwith open('paper_data.json') as stream: data=json.load(stream)\nepisodes=data['final_evaluation']['evaluation_evidence']['episodes']\nprint('seeds:',[record['seed'] for record in episodes])\nfor family in ['arena','nba']:\n cases=[case for episode in episodes for case in episode['solution']['cases'] if case['family']==family]\n print(family,'cases',len(cases),'participants',len(cases[0]['clean_scores']),'budgets',[len(mask) for mask in cases[0]['candidate_masks']])\n for method in ['candidate','disagreement','random','copy']:\n  curves=[case['curves'][method] for case in cases]\n  print(method, 'means', [statistics.mean(curve[budget] for curve in curves) for budget in range(3)], 'unique curves',len({tuple(curve) for curve in curves}))\n print('row-order equal:',all([case['curves'] for case in episode['solution']['cases'] if case['family']==family and not case['permuted']]==[case['curves'] for case in episode['solution']['cases'] if case['family']==family and case['permuted']] for episode in episodes))\nblock=episodes[0]['solution']['conditional_group_bootstrap']\nprint('bootstrap blocks equal:',all(episode['solution']['conditional_group_bootstrap']==block for episode in episodes))\nfor family,records in block.items():\n print(family,'draws',len(records),'complete',all(record['complete'] for record in records))\n for metric in ['gain_disagreement','gain_random']:\n  vals=[100*record[metric] for record in records]\n  print(metric,'min/mean/max',min(vals),statistics.mean(vals),max(vals))\nwith open('paper.tex') as stream: manuscript=stream.read()\nrows=re.findall(r'\"'^'\"\\\\s*(\\\\d+) & ([-+]\\\\d+\\\\.\\\\d+) & ([-+]\\\\d+\\\\.\\\\d+) & ([-+]\\\\d+\\\\.\\\\d+) & ([-+]\\\\d+\\\\.\\\\d+) \\\\\\\\\\\\\\\\', manuscript,re.M)\nprint('supplementary bootstrap rows:',len(rows))\nfor row in rows:\n index=int(row[0])-1\n expected=[f'{100*block[family][index][metric]:+.3f}' for family in ['arena','nba'] for metric in ['gain_disagreement','gain_random']]\n if list(row[1:])\"'!=expected:print('\"'MISMATCH',row,expected)\nprint('controls:',[episode['solution']['controls'] for episode in episodes])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
