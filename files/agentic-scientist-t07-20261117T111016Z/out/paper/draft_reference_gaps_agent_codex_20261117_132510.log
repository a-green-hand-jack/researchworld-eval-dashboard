{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, re\nfrom pathlib import Path\npaper = Path('paper.tex').read_text()\nprovenance = json.loads(Path('references_provenance.json').read_text())\nclaims = json.loads(Path('claims_grounding.json').read_text())['claims']\ndata = json.loads(Path('paper_data.json').read_text())\nstrategy = json.loads(Path('paper_strategy.json').read_text())\nkeys = set(re.findall(r'@\\\\w+\\\\{([\"'^,]+),'\"', Path('references.bib').read_text()))\nused = {key.strip() for group in re.findall(r'\\\\\\\\cite\\\\w*\\\\{([\"'^}]+)'\"\\\\}', paper) for key in group.split(',')}\nprint('Citation inventory:', len(keys), 'bibliography keys;', len(used), 'cited keys; undefined:', sorted(used-keys))\nprint('Provenance fields:', sorted(provenance))\nfor reference in provenance['references']:\n    print(reference['citation_key'], '|', reference.get('consultation_scope'), '| abstract:', bool(reference.get('abstract')))\nprint('Claim mappings:', len(claims))\nprint('Literature claim mappings:')\nfor claim in claims:\n    if claim.get('citation_keys'):\n        print(json.dumps({'claim': claim['claim'], 'citation_keys': claim['citation_keys']}, ensure_ascii=False))\nprint('Final evaluation:', json.dumps({key: data['final_evaluation'].get(key) for key in ['status', 'outcome', 'metrics']}, ensure_ascii=False))\nprint('Ablations:', data.get('ablation_studies'))\nprint('Strategy literature-related fields:', [key for key in strategy if any(term in key for term in ['literature','reference','citation'])])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
