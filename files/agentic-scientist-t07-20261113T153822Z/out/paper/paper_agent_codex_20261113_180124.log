son_line({'correct': bool(correct)}))\n1108:def main():\n1130:        metrics, correct, evidence = aggregate(episodes, outcomes, investigation)\n1134:        correct = bool(correct and complete and time.monotonic() < hard_deadline)\n1135:        metrics['correct'] = int(correct)\n1136:        feasible = not smoke and complete and investigation.baseline_complete and metrics['missing_episode_rate'] == 0 and time.monotonic() < hard_deadline\n1137:        write_results(directory, metrics, correct, feasible, evidence)\n1142:        metrics.update(combined_score=0.0, spearman=-1.0, kendall_tau_b=-1.0, delta_anchor_ci_low=-1.0, correct=0)\n@Article{Amalberti2005FiveSB,\n author = {R. Amalberti and Y. Auroy and D. Berwick and P. Barach},\n booktitle = {Annals of Internal Medicine},\n journal = {Annals of Internal Medicine},\n pages = {756-764},\n title = {Five System Barriers to Achieving Ultrasafe Health Care},\n volume = {142},\n year = {2005}\n}\n\n@Article{Triantafillou2017FewShotLT,\n author = {Eleni Triantafillou and R. Zemel and R. Urtasun},\n booktitle = {Neural Information Processing Systems},\n pages = {2255-2265},\n title = {Few-Shot Learning Through an Information Retrieval Lens},\n year = {2017}\n}\n\n@Article{Willcocks201025thAE,\n author = {L. Willcocks and C. Sauer},\n booktitle = {Journal of Information and Technology},\n journal = {Journal of Information Technology},\n pages = {333-335},\n title = {25th anniversary edition},\n volume = {25},\n year = {2010}\n}\n\n@Article{Yehuda2022ActiveLT,\n author = {Ofer Yehuda and Avihu Dekel and Guy Hacohen and Daphna Weinshall},\n booktitle = {Neural Information Processing Systems},\n journal = {ArXiv},\n title = {Active Learning Through a Covering Lens},\n volume = {abs/2205.11320},\n year = {2022}\n}\n\n@Article{Vivek2023AnchorPB,\n author = {Rajan Vivek and Kawin Ethayarajh and Diyi Yang and D. Kiela},\n booktitle = {Conference of the European Chapter of the Association for Computational Linguistics},\n journal = {ArXiv},\n title = {Anchor Points: Benchmarking Models with Much Fewer Examples},\n volume = {abs/2309.08638},\n year = {2023}\n}\n\n@Article{Han2026SWESkillsBenchDA,\n author = {Ting-Xu Han and Y. Zhang and Wei Song and Chun-Rong Fang and Zhen-Yu Chen and You-Cheng Sun and Li-Jie Hu},\n booktitle = {arXiv.org},\n journal = {ArXiv},\n title = {SWE-Skills-Bench: Do Agent Skills Actually Help in Real-World Software Engineering?},\n volume = {abs/2603.15401},\n year = {2026}\n}\n\n@Article{Setlur2022AdversarialUR,\n author = {Amrith Rajagopal Setlur and Benjamin Eysenbach and Virginia Smith and S. Levine},\n booktitle = {Neural Information Processing Systems},\n journal = {ArXiv},\n title = {Adversarial Unlearning: Reducing Confidence Along Adversarial Directions},\n volume = {abs/2206.01367},\n year = {2022}\n}\n\n@Article{Cattoni2019AGN,\n author = {E. Cattoni and D. Salciarini and C. Tamagnini},\n booktitle = {Soil Dynamics and Earthquake Engineering},\n journal = {Soil Dynamics and Earthquake Engineering},\n title = {A Generalized Newmark Method for the assessment of permanent displacements of flexible retaining structures under seismic loading conditions},\n year = {2019}\n}\n\n@Inproceedings{Rothermel2017DevelopmentOA,\n author = {M. Rothermel},\n title = {Development of a SGM-based multi-view reconstruction framework for aerial imagery},\n year = {2017}\n}\n\n@Article{Ryu2020UnsupervisedFL,\n author = {Jongbin Ryu and Ming-Hsuan Yang and Jongwoo Lim},\n booktitle = {Neural Networks},\n journal = {Neural networks : the official journal of the International Neural Network Society},\n pages = {\n          103-111\n        },\n title = {Unsupervised feature learning for self-tuning neural networks},\n volume = {133},\n year = {2020}\n}\n\n@Article{Kaartinen2012BENCHMARKINGML,\n author = {H. Kaartinen and A. Kukko and J. Hyyppä and A. Jaakkola},\n journal = {ISPRS - International Archives of the Photogrammetry, Remote Sensing and Spatial Information Sciences},\n pages = {471-476},\n title = {BENCHMARKING MOBILE LASER SCANNING SYSTEMS USING A PERMANENT TEST FIELD},\n year = {2012}\n}\n\n@Article{Pencina2012PencinaEA,\n author = {M. Pencina and R. D'Agostino and Olga V. Demler and A. Janssens and P. Greenland},\n booktitle = {American Journal of Epidemiology},\n journal = {American journal of epidemiology},\n pages = {\n          492-4\n        },\n title = {Pencina et al. respond to \"The incremental value of new markers\" and \"Clinically relevant measures? A note of caution\".},\n volume = {176 6},\n year = {2012}\n}\n\n@Inproceedings{Carroll2017DonT,\n author = {John Carroll},\n title = {Don ’ t bring me down : People , puzzles , and social loafing},\n year = {2017}\n}\n\n@Article{Figdor2019TheML,\n author = {Carrie Figdor},\n booktitle = {Animal Sentience},\n journal = {Animal Sentience},\n title = {The mental lives of sheep and the quest for a psychological taxonomy},\n year = {2019}\n}\n\n@Article{Guo2026SafeAnchorPC,\n author = {Dong-Xing Guo and Ji-Kun Wu and Siu-Ming Yiu},\n booktitle = {arXiv.org},\n journal = {ArXiv},\n title = {SafeAnchor: Preventing Cumulative Safety Erosion in Continual Domain Adaptation of Large Language Models},\n volume = {abs/2604.17691},\n year = {2026}\n}\n\n@Article{Lee2025AgentRepairMA,\n author = {Hyunsoo Lee and Geunseok Yang},\n booktitle = {International Conferences on Dependable Systems and Their Applications},\n journal = {2025 12th International Conference on Dependable Systems and Their Applications (DSA)},\n pages = {121-132},\n title = {AgentRepair: Multi-Agent, AST-Anchored, Retrieval-Augmented Program Repair for Cold-Start Environments},\n year = {2025}\n}\n\n@Inproceedings{Harris2015WorkplaceRF,\n author = {P. Harris and Patricia Scott},\n title = {Workplace relations framework: inquiry report},\n year = {2015}\n}\n\n@Article{Prüfer2026Abstract0,\n author = {Ferdinand Prüfer},\n booktitle = {European Journal of Translational Myology},\n journal = {European Journal of Translati