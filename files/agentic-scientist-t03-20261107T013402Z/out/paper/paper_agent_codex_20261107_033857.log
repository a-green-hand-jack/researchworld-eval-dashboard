\"RichFigureFiles\": {\n      \"additionalProperties\": false,\n      \"description\": \"Nested artifact paths used by the richer manifest shape.\",\n      \"properties\": {\n        \"pdf\": {\n          \"default\": \"\",\n          \"title\": \"Pdf\",\n          \"type\": \"string\"\n        },\n        \"png\": {\n          \"minLength\": 1,\n          \"title\": \"Png\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"png\"\n      ],\n      \"title\": \"RichFigureFiles\",\n      \"type\": \"object\"\n    },\n    \"RichFigureManifestFigure\": {\n      \"additionalProperties\": false,\n      \"allOf\": [\n        {\n          \"else\": {\n            \"properties\": {\n              \"files\": {\n                \"properties\": {\n                  \"pdf\": {\n                    \"minLength\": 1\n                  }\n                },\n                \"required\": [\n                  \"pdf\"\n                ]\n              }\n            }\n          },\n          \"if\": {\n            \"anyOf\": [\n              {\n                \"properties\": {\n                  \"generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  }\n                },\n                \"required\": [\n                  \"generator\"\n                ]\n              },\n              {\n                \"properties\": {\n                  \"attempted_generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  },\n                  \"fallback_reason\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  },\n                  \"generator\": {\n                    \"type\": \"null\"\n                  },\n                  \"prompt_log_path\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"gene