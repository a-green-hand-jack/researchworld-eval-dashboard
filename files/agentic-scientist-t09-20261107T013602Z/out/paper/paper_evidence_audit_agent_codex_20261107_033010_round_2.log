{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, re, numpy as np\nfrom pathlib import Path\npaper=json.loads(Path('paper_data.json').read_text())\nsummary=json.loads(Path('analysis/summary.json').read_text())\nepisodes=paper['final_evaluation']['evaluation_evidence']['episodes']\nerrors=np.full((24,4,6,4),np.nan)\nfits=[]; clipping=[]; gates={}; completed=[]\nfor seed_index,episode in enumerate(episodes):\n for case in episode['solution']['cases']:\n  if case['kind']\"'!='\"'scientific': continue\n  validated=case['validated']; family_index=summary['families'].index(case['family']); condition=case['mechanism']\n  errors[seed_index,family_index,condition]=[validated['uncapped_error']]+[validated['baseline_estimates'][key]-validated['true_gate'] for key in ['difference_in_means','own_treatment_ols','one_hop_ols']]\n  fits.append(validated['observed_fit_rmse']); clipping.append(validated['clipped']); completed.append(case['completed']); gates.setdefault(condition,set()).add(validated['true_gate'])\nrmse=np.sqrt(np.mean(errors**2,axis=0)); bias=np.mean(errors,axis=0)\nprint('Scientific records:',len(fits),'all completed:',all(completed),'clipped:',sum(clipping))\nprint('Max summary RMSE discrepancy:',np.max(np.abs(rmse-summary['cell_rmse'])))\nprint('Max summary bias discrepancy:',np.max(np.abs(bias-summary['cell_signed_bias'])))\nprint('Fit range:',min(fits),max(fits),'GATEs:',gates)\nindices=np.random.default_rng(20261107).integers(0,24,size=(10000,24))\nbootstrap_rmse=np.sqrt(np.mean(errors[indices]**2,axis=1))\nbootstrap_bias=np.abs(np.mean(errors[indices],axis=1))\nchecks={'rmse_ci':np.quantile(bootstrap_rmse.mean(axis=(1,2)),[.025,.975],axis=0),'absolute_bias_ci':np.quantile(bootstrap_bias.mean(axis=(1,2)),[.025,.975],axis=0),'ratio_ci':np.quantile(bootstrap_rmse[...,0,None]/bootstrap_rmse[...,1:],[.025,.975],axis=0),'cell_rmse_ci':np.quantile(bootstrap_rmse,[.025,.975],axis=0),'endpoint_minus_onehop_rmse_ci':np.quantile(bootstrap_rmse[...,0].mean(axis=(1,2))-bootstrap_rmse[...,3].mean(axis=(1,2)),[.025,.975])}\nprint('Bootstrap max discrepancies:',{key:float(np.max(np.abs(value-summary[key]))) for key,value in checks.items()})\ntext=Path('paper.tex').read_text(); table=text.split('Family & Condition & ET & DM & Own & Hop & ET bias')[1].split('\\\\\\\\bottomrule')[0]\nrows=[line for line in table.splitlines() if line.count('&')==6]\nissues=[]\nfor index,line in enumerate(rows):\n cells=line.split('&'); values=[]\n for cell in cells[2:]:\n  number=re.search(r'-?(?:\\\\d+)?\\\\.\\\\d+|\\\\d+',cell)\n  values.append(float(number.group()))\n family_index=index//6; condition=index%6\n expected=list(rmse[family_index,condition])+[bias[family_index,condition,0]]\n if any(abs(first-second)>.000501 for first,second in zip(values,expected)): issues.append(index)\nprint('SI accuracy rows:',len(rows),'incorrect rounding rows:',issues)\nprint('Qualification:', {key:value['value'] for key,value in paper['grounding_sources'].items() if key.startswith('final.qualification')})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
