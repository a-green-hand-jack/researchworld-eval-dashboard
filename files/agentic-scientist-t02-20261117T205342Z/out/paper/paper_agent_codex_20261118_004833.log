 'mean_heldout_percent': 0.2185792309076836, 'sd_heldout_percent': 0.026465686845159736, 'mean_lag': 20000.0}\n{'operation': 'addition', 'decay': 1, 'width': 64, 'memorization': [500, 500, 500], 'generalization_count': 0, 'mean_train_percent': 100.0, 'mean_heldout_percent': 0.09107467893045396, 'sd_heldout_percent': 0.012143290077801808, 'mean_lag': 19500.0}\n{'operation': 'addition', 'decay': 1, 'width': 256, 'memorization': [500, 500, 500], 'generalization_count': 0, 'mean_train_percent': 100.0, 'mean_heldout_percent': 0.09107467893045396, 'sd_heldout_percent': 0.02646568824730374, 'mean_lag': 19500.0}\n{'operation': 'subtraction', 'decay': 0, 'width': 16, 'memorization': [1000, 1000, 1000], 'generalization_count': 0, 'mean_train_percent': 100.0, 'mean_heldout_percent': 0.4068002430722118, 'sd_heldout_percent': 0.006071643438191552, 'mean_lag': 19000.0}\n{'operation': 'subtraction', 'decay': 0, 'width': 64, 'memorization': [500, 500, 500], 'generalization_count': 0, 'mean_train_percent': 100.0, 'mean_heldout_percent': 0.026310462465820212, 'sd_heldout_percent': 0.02453826187154167, 'mean_lag': 19500.0}\n{'operation': 'subtraction', 'decay': 0, 'width': 256, 'memorization': [500, 500, 500], 'generalization_count': 0, 'mean_train_percent': 100.0, 'mean_heldout_percent': 0.0, 'sd_heldout_percent': 0.0, 'mean_lag': 19500.0}\n{'operation': 'subtraction', 'decay': 1, 'width': 16, 'memorization': [None, None, None], 'generalization_count': 0, 'mean_train_percent': 55.62485297520956, 'mean_heldout_percent': 0.17810159401657683, 'sd_heldout_percent': 0.03903521689404029, 'mean_lag': 20000.0}\n{'operation': 'subtraction', 'decay': 1, 'width': 64, 'memorization': [500, 500, 500], 'generalization_count': 0, 'mean_train_percent': 100.0, 'mean_heldout_percent': 0.05262092570774258, 'sd_heldout_percent': 0.027378564826758645, 'mean_lag': 19500.0}\n{'operation': 'subtraction', 'decay': 1, 'width': 256, 'memorization': [500, 500, 500], 'generalization_count': 0, 'mean_train_percen