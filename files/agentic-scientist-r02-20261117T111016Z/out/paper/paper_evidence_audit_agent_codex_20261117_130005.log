95\\\": [0.006472610547452411, 0.028490783198197426], \\\"paired_volume_bootstrap95\\\": [-0.024641036987304688, -0.010268211364746094], \\\"utility_difference\\\": 0.016570245258902272, \\\"volume_difference\\\": -0.016857147216796875}, {\\\"alpha\\\": 0.1, \\\"bonferroni54_bootstrap_interval\\\": [0.005231294559493096, 0.022029672060142638], \\\"paired_seed_bootstrap95\\\": [0.008802328258752837, 0.018651640249623208], \\\"paired_volume_bootstrap95\\\": [-0.014424324035644531, -0.00510406494140625], \\\"utility_difference\\\": 0.013668575013677284, \\\"volume_difference\\\": -0.0098419189453125}, {\\\"alpha\\\": 0.2, \\\"bonferroni54_bootstrap_interval\\\": [-0.009109065714464695, 0.019381617648414826], \\\"paired_seed_bootstrap95\\\": [-0.002829138422384858, 0.015376003101118828], \\\"paired_volume_bootstrap95\\\": [-0.006737709045410156, -0.0022563457489013714], \\\"utility_difference\\\": 0.006960550672374666, \\\"volume_difference\\\": -0.004439353942871094}]\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/summary.json\"], \"evidence_locator\": \"/final_evaluation/evaluation_evidence/episodes/0/solution/seed_block_uncertainty/LN_IID_K3/paired_baselines/simplex_linf\"}\n36 {\"claim\": \"Complete paired utility/mass contrasts for LN_IID_K3, scaled ILR minus unscaled_ilr: [{\\\"alpha\\\": 0.05, \\\"bonferroni54_bootstrap_interval\\\": [-0.008995979534167933, 0.005931490945010582], \\\"paired_seed_bootstrap95\\\": [-0.00738948153478923, 0.0022066902173193126], \\\"paired_volume_bootstrap95\\\": [-0.0009976625442504883, 0.005230903625488281], \\\"utility_difference\\\": -0.002843866320817054, \\\"volume_difference\\\": 0.00226593017578125}, {\\\"alpha\\\": 0.1, \\\"bonferroni54_bootstrap_interval\\\": [-0.011284913403727514, 0.00176049902687353], \\\"paired_seed_bootstrap95\\\": [-0.009367184299561696, -0.0013039144169952749], \\\"paired_volume_bootstrap95\\\": [0.0004367828369140625, 0.0045480728149414