: [\n    {\n      \"citation_count\": 4914,\n      \"citation_key\": \"Bradley1952RANKAO\",\n      \"id\": \"ref.s2.7d47ee5f84103529f84297c98c21dadb4742e3ff\",\n      \"paper_id\": \"7d47ee5f84103529f84297c98c21dadb4742e3ff\",\n      \"query\": \"\\\"Rank Analysis of Incomplete Block Designs: I. The Method of Paired Comparisons\\\"\",\n      \"retrieved_at\": \"2026-11-17T22:32:49.162071+00:00\",\n      \"source_url\": \"https://api.semanticscholar.org/graph/v1/paper/7d47ee5f84103529f84297c98c21dadb4742e3ff?fields=paperId%2Ctitle%2Cyear%2Cvenue%2CcitationCount%2CcitationStyles%2Curl\",\n{\n  \"status\": \"ready\",\n  \"central_topic\": \"Sensitivity of ridge-regularized Bradley-Terry rankings to small, influence-selected row deletions, comparing crowdsourced Chatbot Arena preferences with historical NBA game outcomes using exact refits and random/high-loss deletion controls.\",\n  \"core_methods\": [\n    \"Centered Bradley-Terry estimation with half-win ties and fixed mean-loss ridge regularization\",\n    \"Clean-Hessian inverse influence for leader-contender contrasts and frozen nested deletion prefixes\",\n    \"Bounded contender screening followed by converged retained-data refits using aggregated pair sufficient statistics\",\n    \"Retained-Hessian one-step Newton proxy for bounded shortlist expansion; no observed aggregate improvement over the exact-refit selector\",\n    \"Normalized pairwise ranking inversions and original-leader rank displacement; conditional group-bootstrap refits of fixed deletion masks\"\n  ],\n  \"comparators\": [\n    \"Uniform random row deletion and clean-fit high-log-loss disagreement deletion, with unchanged-data and row-permutation controls\",\n    \"First-order influence and finite-sample data-removal robustness versus exact retained-data refitting\",\n    \"Preference-vote manipulation as related threat-model context, not an implemented vote-insertion baseline\"\n  ],\n  \"benchmarks\": [\n    \"Chatbot Arena arena-human-preference-55k pinned snapshot, partition-specific largest connected component\",\n    \"FiveThirtyEight nba-elo/nbaallelo.csv pinned historical game snapshot, deduplicated with _iscopy=0 and restricted to the partition-specific largest connected component\"\n  ],\n  \"architectural_shifts\": [],\n  \"result_driven_themes\": [\n    \"Bounded exact-refit contender selection improved the recorded search aggregate over clean-Hessian-only selection; retained-curvature expansion tied that aggregate rather than improving it\",\n    \"Final aggregate inversion disruption exceeded random and disagreement deletion, but disagreement-relative gains differ by dataset and deletion budget\",\n    \"Final conditional group-bootstrap gains relative to disagreement deletion are negative on average for Arena and positive on average for NBA; these are fixed-mask refits, not reoptimized attacks\",\n    \"Identical candidate scores across five final seeds and row-permutation controls do not establish independent dataset replication or causal effects of evaluation design\"\n  ],\n  \"queries\": [\n    {\n      \"query\": \"\\\"Rank Analysis of Incomplete Block Designs: I. The Method of Paired Comparisons\\\"\",\n      \"category\": \"core_method\",\n      \"rationale\": \"The actual estimator is Bradley-Terry on both Arena and NBA. Resolve only the supplied Bradley and Terry (1952) work, DOI 10.2307/2334029; distinguish its foundation from this run-specific mean-loss ridge and tie conventions.\"\n    },\n    {\n      \"query\": \"\\\"Understanding Black-box Predictions via Influence Functions\\\"\",\n      \"category\": \"core_method\",\n      \"rationale\": \"Clean-Hessian inverse-gradient contrasts determine every legal deletion prefix. Resolve only the supplied Koh and Liang (2017) work, arXiv:1703.04730, for influence-function context; it does not establish accuracy of this run-specific shortlist or finite deletions.\"\n    },\n    {\n      \"query\": \"\\\"An Automatic Finite-Sample Robustness Metric: When Can Dropping a Little Data Make a Big Difference?\\\"\",\n      \"category\": \"result_driven_theme\",\n      \"rationale\": \"Small-fraction deletion robustness and the gap between local approximations and retained-data conclusions are central to the exact-refit selector and heterogeneous baseline gains. Resolve only the supplied Broderick, Giordano and Meager (2020) work, arXiv:2011.14999; do not claim globally minimal deletion sets or universal fragility.\"\n    },\n    {\n      \"query\": \"\\\"Chatbot Arena: An Open Platform for Evaluating LLMs by Human Preference\\\"\",\n      \"category\": \"benchmark_context\",\n      \"rationale\": \"Arena crowdsourced preferences are actually evaluated, unlike the proposed MT-Bench human/GPT-4 comparison. Resolve only the supplied Chiang et al. (2024) work, arXiv:2403.04132; separately retain the pinned 55k dataset provenance rather than treating the platform paper as snapshot documentation.\"\n    },\n    {\n      \"query\": \"FiveThirtyEight nba-elo nbaallelo.csv\",\n      \"category\": \"benchmark_context\",\n      \"rationale\": \"NBA is the actual second evaluation design. Restrict resolution to the supplied fivethirtyeight/data repository at commit 4c1ff5e3aef1816ae04af63218015066e186c147, its nba-elo documentation and original dataset. Cite data provenance, not a guessed paper; Elo labels identify the source, whereas this run fits Bradley-Terry to game outcomes.\"\n    },\n    {\n      \"query\": \"\\\"Improving Your Model Ranking on Chatbot Arena by Vote Rigging\\\"\",\n      \"category\": \"baseline_comparator\",\n      \"rationale\": \"Resolve only the explicitly supplied Min et al. (2025) work, arXiv:2501.17858, to distinguish deliberate preference manipulation from this run’s constrained row deletions. Random and high-loss deletion are the measured controls; vote insertion, flipping and this publication’s algorithms were not evaluated here.\"\n    }\n  ],\n  \"forbidden_query_patterns\": [\n    \"Any attempt to identify, infer, retrieve or search for the prohibited paper, its authors, results, mirrors or derivative material\",\n    \"Citation/cited-by, related-paper, survey, reproduction, social-media or repository traversal that could expose discussion of the prohibited paper; no snowballing from allowed works\",\n    \"Broad topical searches such as leaderboard preference deletion ranking fragility; use the exact allowed work identities or the pinned dataset source above instead\",\n    \"Retrieving unapproved results returned by an exact-title query; reject identity mismatches before opening abstracts, full text or derivative pages\",\n    \"MT-Bench, expert-versus-GPT-4 judges, WebDev Arena or 140k Arena as evaluated benchmarks; those comparisons are absent from the grounded run\",\n    \"Transformer, mixture-of-experts, architecture transfer, representation learning or model-architecture transitions inferred merely from participant names\",\n    \"Generic optimization, benchmarking, scientific method or paper-writing searches\",\n    \"Globally optimal minimum deletions, adaptive attack reordering, whole-group deletion, causal evaluation-design comparisons, full attack-reoptimized bootstrap or universal baseline superiority as established findings\"\n  ],\n  \"failure_reason\": \"\"\n}\n","exit_code":0,"status":"completed"}}
