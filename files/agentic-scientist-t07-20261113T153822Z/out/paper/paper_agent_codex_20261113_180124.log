' or request['dtype'] != 'uint8':\n   339\t            raise ValueError('invalid observation request')\n   340\t        shape = request['shape']\n   341\t        if len(shape) != 2 or shape[0] < 0 or shape[1] != budget:\n   342\t            raise ValueError('invalid observation shape')\n   343\t        observations = np.frombuffer(base64.b64decode(request['data'], validate=True), dtype=np.uint8).reshape(request['shape']).astype(float)\n   344\t        if not np.isin(observations, [0, 1]).all():\n   345\t            raise ValueError('invalid observations')\n   346\t        query_order = STATE['anchors']\n   347\t        assert np.unique(query_order).size == query_order.size\n   348\t        linear_query_order = query_order[:budget]\n   349\t        mixture_query_order = query_order[:budget]\n   350\t        assert np.array_equal(linear_query_order, mixture_query_order)\n   351\t        if STATE['mode'] == 'no_calibration':\n   352\t            predictions = observations.mean(axis=1)\n   353\t        else:\n   354\t            linear_prediction = linear_predict(STATE['models'][budget], observations)\n   355\t            mixture_weight = STATE['mixture_weight']\n   356\t            if mixture_weight == 0.0:\n   357\t                predictions = linear_prediction\n   358\t            else:\n   359\t                particle_probs, particle_log_prior, totals = STATE['particles']\n   360\t                particle_prediction = predict_particles(particle_probs, particle_log_prior, totals, mixture_query_order, observations)\n   361\t                blended_prediction = (1.0 - mixture_weight) * linear_prediction + mixture_weight * particle_prediction\n   362\t                predictions = blended_prediction\n   363\t        assert np.isfinite(predictions).all()\n   364\t        predictions = np.clip(predictions, 0, 1).astype('<f8')\n   365\t        return {'encoding': 'base64', 'dtype': '<f8', 'shape': [len(predictions)], 'data': base64.b64encode(predictions.tobytes()).decode