values])\n    assert np.allclose(actual,expected,rtol=0,atol=0.000005),filename\n    print(filename+': all values agree with retained arrays at printed precision')\ngroups=sorted({group for episode in episodes for case in 'AB' for group in episode['solution']['cases'][case]['resampling_components']})\nindex={group:position for position,group in enumerate(groups)}\nrng=np.random.default_rng(424242)\nbootstrap=np.zeros((400,5))\nfor draw in range(400):\n    multiplicities=np.bincount(rng.integers(len(groups),size=len(groups)),minlength=len(groups))\n    for episode in episodes:\n        for case in 'AB':\n            evidence=episode['solution']['cases'][case]\n            weights=np.array([multiplicities[index[group]] for group in evidence['resampling_components']])\n            if not weights.sum(): bootstrap[draw]-=np.ones(5)/6\n            else:\n                difference=np.array(evidence['baseline_mae_by_method_row_checkpoint']).mean(axis=2)-np.array(evidence['mae_by_row_checkpoint']).mean(axis=1)\n                bootstrap[draw]+=(difference@weights)/weights.sum()/6\nbounds=np.quantile(bootstrap,[.005,.995],axis=0)\nassert np.allclose(bounds,summary['baseline_gain_bounds'],rtol=0,atol=1e-14)\nprint('Bootstrap bounds independently reproduce retained final metrics:',bounds.min(axis=1))\nfor case in 'AB':\n    print('Case',case,'studied budget means:',arrays[case][:,-1].mean(axis=0),'aggregate comparison:',arrays[case].mean(axis=(0,2)))\nprint('All numeric summaries verified; no files written.')\nPY\"","aggregated_output":"Traceback (most recent call last):\n  File \"<stdin>\", line 2, in <module>\nModuleNotFoundError: No module named 'numpy'\n","exit_code":1,"status":"failed"}}
