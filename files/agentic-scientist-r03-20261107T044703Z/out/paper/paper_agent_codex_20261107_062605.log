{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/apply_patch <<'PY'\n#\"'!/usr/bin/env python3\nimport sys\nfrom pathlib import Path\ntext=sys.stdin.read().splitlines()\nassert text[0]=='\"'*** Begin Patch' and text[-1]=='*** End Patch'\nindex=1\nwhile index < len(text)-1:\n    header=text[index]; index+=1\n    chunk=[]\n    while index<len(text)-1 and not text[index].startswith('*** '):\n        chunk.append(text[index]);index+=1\n    if header.startswith('*** Add File: '):\n        path=Path(header[14:]);assert not path.exists(),path\n        path.parent.mkdir(parents=True,exist_ok=True)\n        path.write_text('\\\\n'.join(line[1:] for line in chunk if line.startswith('+'))+'\\\\n')\n    elif header.startswith('*** Update File: '):\n        path=Path(header[17:]);content=path.read_text();groups=[];group=[]\n        for line in chunk:\n            if line.startswith('@@'):\n                if group:groups.append(group)\n                group=[]\n            else:group.append(line)\n        if group:groups.append(group)\n        for group in groups:\n            old='\\\\n'.join(line[1:] for line in group if line[:1] in (' ','-'))+'\\\\n'\n            new='\\\\n'.join(line[1:] for line in group if line[:1] in (' ','+'))+'\\\\n'\n            assert content.count(old)==1,(path,old[:100],content.count(old))\n            content=content.replace(old,new,1)\n        path.write_text(content)\n    else:raise ValueError(header)\n    print(header)\nPY\nchmod +x /tmp/apply_patch\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
