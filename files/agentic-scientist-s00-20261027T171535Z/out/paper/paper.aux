\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the study. A connected graph ($6\le n\le 30$) is reduced to five relabeling-invariant statistics; a ridge model predicts log cover time, which is compared with a Monte Carlo label. The $2m(n-1)$ bound, a constant predictor and a shuffled-target control are scored through the same pipeline: per-graph clipped log error $\rightarrow $ family mean $\rightarrow $ family-macro mean $\rightarrow $ mean over seeded episodes.}}{2}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{Overview of the study. A connected graph ($6\le n\le 30$) is reduced to five relabeling-invariant statistics; a ridge model predicts log cover time, which is compared with a Monte Carlo label. The $2m(n-1)$ bound, a constant predictor and a shuffled-target control are scored through the same pipeline: per-graph clipped log error $\rightarrow $ family mean $\rightarrow $ family-macro mean $\rightarrow $ mean over seeded episodes}{figure.caption.3}{}}
