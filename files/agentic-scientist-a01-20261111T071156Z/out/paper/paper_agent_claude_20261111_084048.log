mmunication, Electronic and Computer Engineering},\n pages = {7-12},\n title = {Robust Linear Discriminant Analysis with Highest Breakdown Point Estimator},\n volume = {10},\n year = {2018}\n}\n\n@Article{Baguio2008TrimmedMA,\n author = {Carolina B. Baguio},\n journal = {World Academy of Science, Engineering and Technology, International Journal of Mathematical, Computational, Physical, Electrical and Computer Engineering},\n pages = {352-357},\n title = {Trimmed Mean as an Adaptive Robust Estimator of a Location Parameter for Weibull Distribution},\n volume = {2},\n year = {2008}\n}\n\n@Article{Adam2018RobustEB,\n author = {Lukáš Adam and Premysl Bejda},\n booktitle = {Communications in statistics. Simulation and computation},\n journal = {Communications in Statistics - Simulation and Computation},\n pages = {2139 - 2151},\n title = {Robust estimators based on generalization of trimmed mean},\n volume = {47},\n year = {2018}\n}\n\n@Inproceedings{Ahad2017MedianBR,\n author = {N. Ahad and Suhaida Abdullah and N. Zakaria and Sharipah Syed Soaad Yahaya and Norhayati Yusof},\n pages = {050002},\n title = {Median based robust correlation coefficient},\n volume = {1905},\n year = {2017}\n}\n\n@Inproceedings{Sengupta2016ONMM,\n author = {D. Sengupta and S. Ghosh},\n title = {ON MULTIVARIATE MONOTONIC MEASURES OF LOCATION WITH HIGH BREAKDOWN POINT},\n year = {2016}\n}\n\n@Article{Zuo2020FiniteSB,\n author = {Y. Zuo},\n journal = {arXiv: Statistics Theory},\n title = {Finite sample breakdown point of multivariate regression depth median},\n year = {2020}\n}\n\n@Article{Acharya2025GeometricMM,\n author = {Anish Acharya and S. Sanghavi and A. Dimakis and Inderjit S. Dhillon},\n booktitle = {arXiv.org},\n journal = {ArXiv},\n title = {Geometric Median Matching for Robust k-Subset Selection from Noisy Data},\n volume = {abs/2504.00564},\n year = {2025}\n}\n\n@Article{Pang2022RobustLD,\n author = {Yik-Siong Pang and N. Ahad and Sharipah Sooad Syed Yahaya},\n booktitle = {Pertanika journal of science & technology},\n journal = {Pertanika Journal of Science and Technology},\n title = {Robust Linear Discriminant Rule using Double Trimming Location Estimator with Robust Mahalanobis Squared Distance},\n year = {2022}\n}\n\n@Article{Pang2021RobustML,\n author = {Yik-Siong Pang and N. Ahad and Sharipah Syed Soaad Yahaya},\n booktitle = {Mathematics and Statistics},\n journal = {Mathematics and Statistics},\n title = {Robust Multivariate Location Estimation in the Existence of Casewise and Cellwise Outliers},\n year = {2021}\n}\n\n@Inproceedings{Zuo2004ATM,\n author = {Y. Zuo},\n title = {A trimmed mean with a random fraction of trimmed points},\n year = {2004}\n}\n\n@Article{Tuobang2024RobustEF,\n author = {Li Tuobang},\n booktitle = {Social Science Research Network},\n journal = {SSRN Electronic Journal},\n title = {Robust estimations from distribution structures: I. Mean},\n year = {2024}\n}\n\n@Inproceedings{Cholaquidis2025DepthBT,\n author = {A. Cholaquidis and Ricardo Fraiman and L. Moreno and G. Perera},\n title = {Depth based trimmed means},\n year = {2025}\n}\n{\n \"schema_version\": 1,\n \"canonical_task\": {\n  \"path\": \"task.md\",\n  \"sha256\": \"dffbdd684a2c58be9667fb1209b9b603bff1442274fdddc800f78e512533ba30\"\n },\n \"method\": {\n  \"class\": \"Strategic targeted-investment analysis of multi-task leaderboards under aggregation rules: a candidate-implemented investment planner that, for a given public score matrix, aggregation rule, target model and investment model, returns the cheapest per-task score-gain plan that makes the target strictly first; plans are verified and costed by a trusted evaluator-owned rule engine and compared with evaluator-owned baselines and a reference solver.\",\n  \"description\": \"Bounded claim. Investment model (declared before scoring, plane-independent): the developer raises the target model's score on a chosen set of tasks, gains >=0, independent per task, no cross-task spillover and no change to other models; two cost measures: L1 total points with per-task cap at the scale maximum (100), and L0 number of targeted tasks with each targeted task lifted at most to the best score in the field on that task. Field = the top-K (K=min(N,200)) fully-observed models by arithmetic mean; targets = the models at rank 2 and rank 10 under the arithmetic mean; success = target strictly first (ties count against the target) under the rule recomputed by the evaluator. Rules: mean, median, trimmed_mean_20 (drop lowest and highest 20% of tasks), zscore_mean (per-task standardized, recomputed on the modified matrix), borda (mean per-task rank), plurality (number of tasks on which a model is strictly first), copeland (pairwise task-majority wins), maximin (worst-task score). On the pinned public snapshots (HELM MMLU v1.13.0 for search; Open LLM Leaderboard contents and results snapshots for final) the claim is conditional: (i) the minimal investment found by the evaluator-owned reference solver is expected to vary with the aggregation rule (hypothesis, to be supported, refuted or qualified by the paired per-case reference costs, including infeasible cases) and with how correlated task scores are, tested against a within-task shuffled-score null; (ii) a candidate planner is credited only for plans that the trusted verifier confirms, scored relative to the reference solver, and is claimed better than the evaluator-owned naive baselines only if its paired final-plane main efficiency is strictly higher. No claim is made about real training effects, other leaderboards, other fields sizes, spillover or heterogeneous task costs; sensitivity to K, cap policy and field is reported as a limitation or an explicit robustness check, not assumed.\"\n },\n \"candidate\": {\n  \"interface\": \"python_rpc_v1:handle\",\n  \"editable_paths\": [\n   \"program_0/src\"\n  ]\n },\n \"evaluators\": {\n  \"search\": \"evaluate.py\",\n  \"final\": \"evaluate_final.py\"\n },\n \"resources\": {\n  \"search