{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/sh -lc \"PYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport json, math\nfrom collections import Counter\nfrom statistics import mean\nwith open('paper_data.json') as stream:\n    paper=json.load(stream)\nwith open('analysis/paper_statistics.json') as stream:\n    stats=json.load(stream)\nrows=[]\nfor outer in paper['final_evaluation']['evaluation_evidence']['episodes']:\n    assert outer['solution']['paired_mae_uncertainty']==stats['uncertainty']\n    for episode in outer['solution']['episodes']:\n        if episode['condition']\"'!='\"'normal' or episode.get('replay',False):\n            continue\n        for checkpoint in episode['checkpoints']:\n            truth=checkpoint['references']\n            groups=checkpoint['lineage_groups']\n            counts=Counter(groups)\n            weights=[1/(len(counts)*counts[group]) for group in groups]\n            for method in stats['aggregate']:\n                predictions=checkpoint['predictions'] if method=='selected' else checkpoint['baseline_predictions'][method]\n                errors=[predicted-reference for predicted,reference in zip(predictions,truth)]\n                rows.append({'case':episode['case'],'budget':str(checkpoint['budget']),'seed':str(outer['seed']),'method':method,'mae':sum(weight*abs(error) for weight,error in zip(weights,errors)),'rmse':math.sqrt(sum(weight*error**2 for weight,error in zip(weights,errors)))})\nchecked=0\nfor kind in ('aggregate','by_budget','by_seed','by_case_budget'):\n    if kind=='aggregate':\n        checks=[({},stats[kind])]\n    elif kind=='by_case_budget':\n        checks=[({'case':case,'budget':budget},values) for case,budgets in stats[kind].items() for budget,values in budgets.items()]\n    else:\n        field='budget' if kind=='by_budget' else 'seed'\n        checks=[({field:key},values) for key,values in stats[kind].items()]\n    for filters,methods in checks:\n        for method,metrics in methods.items():\n            retained=[row for row in rows if row['method']==method and all(row[key]==value for key,value in filters.items())]\n            for metric in ('mae','rmse'):\n                assert math.isclose(mean(row[metric] for row in retained),metrics[metric],rel_tol=0,abs_tol=1e-12),(kind,filters,method,metric)\n                checked+=1\nwith open('paper.tex') as stream:\n    tex=stream.read()\nfor name in ('case_budget','seeds'):\n    with open('tables/'+name+'.tex') as stream:\n        expected=stream.read().strip()\n    block=tex.split('% BEGIN GENERATED '+name)[1].split('% END GENERATED '+name)[0].strip()\n    assert block==expected,name\nprint('Verified',len(rows)//5,'normal cells and',checked,'MAE/RMSE summary values against retained prediction arrays; both embedded supplementary tables match generated sources.')\nprint('Grounded final qualification:',{key:paper['grounding_sources']['final.qualification.'+key]['value'] for key in ('status','outcome')})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
