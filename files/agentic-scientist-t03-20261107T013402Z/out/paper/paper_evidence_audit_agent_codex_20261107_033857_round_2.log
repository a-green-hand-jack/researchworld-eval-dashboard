ath\": \"writing_validation.json.prov.json\",\n      \"target\": \"writing_validation.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper.pdf]]\",\n      \"resolved_path\": \"paper.pdf\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"writing_validation.json.prov.json\",\n      \"target\": \"paper.pdf\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper.tex]]\",\n      \"resolved_path\": \"paper.tex\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"writing_validation.json.prov.json\",\n      \"target\": \"paper.tex\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[claims_grounding.json]]\",\n      \"resolved_path\": \"claims_grounding.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"writing_validation.json.prov.json\",\n      \"target\": \"claims_grounding.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[figure_manifest.json]]\",\n      \"resolved_path\": \"figure_manifest.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"writing_validation.json.prov.json\",\n      \"target\": \"figure_manifest.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[VENUE.md]]\",\n      \"resolved_path\": \"VENUE.md\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"writing_validation.json.prov.json\",\n      \"target\": \"VENUE.md\"\n    },\n    {\n      \"messages\": [\n        \"generated_by.script_path exists.\"\n      ],\n      \"raw_reference\": \"<generated_by.script_path>\",\n      \"resolved_path\": \"audit_writing.py\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"writing_validation.json.prov.json\",\n      \"target\": \"audit_writing.py\"\n    }\n  ],\n  \"root_dir\": \"work/results/t03/codex/20261107_013849/.paper_evidence_audit_workspaces-1000/agentic-evidence-audit-1000-20261107_033857-paper_evidence_audit_round_2-cvombf1s/workspace\",\n  \"schema_name\": \"scientific-evidence.verification-report\",\n  \"summary\": {\n    \"anchored_references\": 90,\n    \"dangling_references\": 0,\n    \"manifests_checked\": 16,\n    \"resolved_references\": 112,\n    \"total_references\": 202\n  },\n  \"verified_at\": \"2026-11-07T04:32:54.844438+00:00\"\n}\n","exit_code":0,"status":"completed"}}
