{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"rg -n '\"'^##|''^###'\"' paper_evidence_audit_packet.md; sed -n '1,80p' build_artifacts.py; sed -n '335,352p' paper.tex; ls paper_evidence_audit_stage_feedback.* 2>/dev/null || true; python - <<'PY'\nimport json\nfor ref in json.load(open('references_provenance.json'))['references']:\n obj=json.load(open(ref['consultation_path']));print(ref['citation_key'],list(obj))\nPY\"","aggregated_output":"9:## Expected audit focus\n18:## Artifact checklist\n27:## validation report summary\n46:## scientific-evidence verification summary\n62:## claims_grounding excerpt\n254:## paper_data summary\n311:## references provenance summary\n569:## manuscript source excerpt\n817:## supplementary information excerpt\nimport csv\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n\nROOT = Path(__file__).resolve().parent\nplt.rcParams.update({'font.size': 9, 'axes.labelsize': 9, 'axes.titlesize': 9,\n                     'xtick.labelsize': 8.5, 'ytick.labelsize': 8.5,\n                     'legend.fontsize': 8.5, 'font.family': 'DejaVu Sans',\n                     'axes.spines.top': False, 'axes.spines.right': False,\n                     'pdf.fonttype': 42})\nCOLORS = ['#147D92', '#C45B26', '#635A9B']\nMETHODS = ['report_mse', 'reuse_mse', 'full_budget_naive_mse',\n           'honest_half_mse', 'fixed_prompt_mse', 'random_prompt_mse']\n\n\ndef write_json(path, data):\n    Path(path).write_text(json.dumps(data, indent=2) + '\\n')\n\n\ndef provenance(path, kind='derived'):\n    write_json(str(path) + '.prov.json', {\n        'schema_name': 'scientific-evidence.artifact-manifest',\n        'artifact': {'path': str(path), 'kind': kind,\n                     'sha256': hashlib.sha256(Path(path).read_bytes()).hexdigest()},\n        'derived_from': ['@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]',\n                         '@evidence[[source_evidence/evaluate_final.py#L746]]'],\n        'generated_by': {'script_path': 'build_artifacts.py',\n                         'command': ['python', 'build_artifacts.py']}})\n\n\ndef save_figure(figure, figure_id):\n    for extension in ['pdf', 'png']:\n        path = Path('figures') / (figure_id + '.' + extension)\n        figure.savefig(path, dpi=300, bbox_inches='tight', pad_inches=0.025)\n        provenance(path, 'figure')\n    plt.close(figure)\n\n\ndef manifest_entry(figure_id, figure_type, panels, rows, categories, series):\n    return {'figure_id': figure_id, 'figure_type': figure_type,\n            'path_pdf': f'figures/{figure_id}.pdf', 'path_png': f'figures/{figure_id}.png',\n            'generator': 'matplotlib', 'n_panels': panels, 'panels_per_row': rows,\n            'categories_per_panel': categories, 'series_per_panel': series,\n            'max_label_chars': 35, 'font_sizes': {'title': 9, 'axis': 9, 'ticks': 8.5, 'legend': 8.5},\n            'uses_abbrev_labels': True, 'uses_progression': False,\n            'placement': 'full_width', 'intended_latex_width_fraction': 1.0,\n            'estimated_min_rendered_font_pt': 8.5,\n            'source_ids': ['final.evidence.episodes']}\n\n\ndef main():\n    Path('figures').mkdir(exist_ok=True)\n    Path('tables').mkdir(exist_ok=True)\n    Path('analysis').mkdir(exist_ok=True)\n    # @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    paper_data = json.loads(Path('paper_data.json').read_text())\n    episodes = paper_data['final_evaluation']['evaluation_evidence']['episodes']\n    cases = [{**case, 'seed': episode['seed']} for episode in episodes for case in episode['solution']['cases']]\n    labels = [case['case'] for case in episodes[0]['solution']['cases']]\n    means = {label: {metric: float(np.mean([case['metrics'][metric] for case in cases if case['case'] == label]))\n                     for metric in cases[0]['metrics']} for label in labels}\n    regimes = {}\n    for regime in range(len(cases[0]['details'])):\n        regimes[str(regime)] = {}\n        for label in [label for label in labels if label.startswith('S')]:\n            regimes[str(regime)][label] = {metric: float(np.mean([case['details'][regime]['metrics'][metric]\n                                                                for case in cases if case['case'] == label]))\n                                          for metric in cases[0]['metrics']}\n    audit = [{ 'seed': case['seed'], 'case': case['case'],\n               'difference': case['details'][0]['target'] - case['details'][0]['fixed'][1],\n               'interval': case['details'][0]['paired_subject_bootstrap_interval'],\n               'target': case['details'][0]['target'], 'fixed': case['details'][0]['fixed'][1]}\n             for case in cases if case['case'].startswith('R')]\nThe fixed model revision is \\texttt{12fd25f77366fa6b3b4b768ec3050bf629380bac}; MMLU-Pro is fixed at revision \\texttt{b189ec765aa7ed75c8acfea42df31fdae71f97be}. The retained real pool has $4096$ examples. Normalization uses Unicode NFKC and collapses whitespace; option-content matching sorts normalized options. The split manifest records $11711$ unique groups and allocation seed $732091$. These describe dataset preparation, not additional measured performance. Data may have appeared in pretraining.\n% @evidence[[source_evidence/resources/runtime_manifest.json]]\n% @evidence[[source_evidence/resources/split_manifest.json]]\n% @evidence[[source_evidence/resources/examples.json]]\n\nThe supplied dependency specification pins NumPy 2.2.6, PyArrow 19.0.1, PyTorch 2.6.0, Transformers 4.51.3, Safetensors 0.5.3, SciPy 1.15.3, and Matplotlib 3.10.3. The runtime manifest identifies CPython 3.12 on Linux x86\\_64, CPU float32 inference and float64 statistics. The answer worker uses two tensor threads and one interoperation thread. These are the supplied environment specification and inspected settings; a separately retained package inventory proving every version actually loaded is unavailable. The paper-artifact environment is recorded separately in the reproduction guide.\n% @evidence[[source_evidence/requirements.txt]]\n% @evidence[[source_evidence/resources/runtime_manifest.json]]\n% @evidence[[source_evidence/evaluate_final.py#L574]]\n\nTo regenerate manuscript analyses without model calls, run \\texttt{python build\\_artifacts.py}. It reads the immutable final record and produces both quantitative figures as PDF and 300-DPI PNG, the main comparison table, the regime table, the complete seed table, and their evidence sidecars. It leaves an orchestrator-rendered overview untouched. The exact final-evaluation entrypoint, resource acquisition details, and validation commands are in \\texttt{REPRODUCIBILITY.md}. Evaluation commands there describe future reproduction, not additional executions during manuscript preparation. Predicted reproduction time is uncertain because the recorded durations include shared caching and orchestration overhead; the measured duration sum is the only supplied wall-time accounting.\n% @evidence[[build_artifacts.py]]\n% @evidence[[analysis/summary.json#/duration_sum_seconds]]\n\nReferences were consulted through fixed original arXiv abstracts, original journal pages, or original publisher-deposited abstracts and bibliographic records, as individually recorded in \\texttt{references\\_provenance.json}. No citation graph or broad topical discovery was used. Full-text reading is not claimed when only an abstract was consulted. No known encounter with the prohibited study occurred. The official ICLR 2026 style and bibliography style were obtained directly from the ICLR template repository, rather than relabeling a template for another year.\n\n\\subsection{LLM Usage}\nLLM-based research assistance contributed to proposal generation, implementation editing, reference planning, narrative selection, plotting code, manuscript drafting, and evidence checking. The research assistance is distinct from the evaluated answer generator, SmolLM2-135M-Instruct. Its role in evaluation is limited to producing the constrained answer letters described in the method. The writing assistant inspected the supplied results and source, generated deterministic summaries and figures, and validated the manuscript; it did not run new scientific inference or simulations for this paper. Literature retrieval used fixed identifiers for permitted originals. No unrecorded human validation, external audit, or independent replication is asserted.\nWang2024MMLUPro ['title', 'authors', 'year', 'abstract', 'url']\nDemsar2006Comparisons ['title', 'authors', 'year', 'abstract', 'url']\nDietterich1998Tests ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nPolo2024MultiPrompt ['title', 'authors', 'year', 'abstract', 'url']\nShi2024BestArm ['title', 'authors', 'year', 'abstract', 'url']\nSclar2024Formatting ['title', 'authors', 'year', 'abstract', 'url']\nDwork2015Adaptive ['title', 'authors', 'year', 'abstract', 'url']\nBlum2015Ladder ['title', 'authors', 'year', 'abstract', 'url']\nChernozhukov2013Gaussian ['title', 'authors', 'year', 'abstract', 'url']\nAndrews2018Winners ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata', 'original_status', 'original_url', 'consulted_text']\nBerk2013PostSelection ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nBates2021CrossValidation ['title', 'authors', 'year', 'abstract', 'url']\nBrown2001Binomial ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nEfron1979Bootstrap ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nStone1974CrossValidation ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nGuyon2003Selection ['title', 'authors', 'year', 'abstract', 'url']\nVaroquaux2018CrossValidation ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata', 'original_status', 'original_url', 'original_abstract_record']\nNadeau2003Inference ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata', 'original_status', 'original_url']\nBenjamini1995 ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nVarma2006Bias ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nAmbroise2002Selection ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nArlot2010Survey ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\nCawley2010Overfitting ['title', 'authors', 'year', 'abstract', 'url']\nBengio2004Variance ['title', 'authors', 'year', 'abstract', 'url']\nDiCiccio1996Bootstrap ['title', 'authors', 'year', 'abstract', 'url', 'doi', 'metadata']\n","exit_code":0,"status":"completed"}}
