 = milp(c=c, integrality=integrality, bounds=Bounds(lb, ub),\n730:               options={\"time_limit\": float(time_limit), \"mip_rel_gap\": 0.0, \"disp\": False})\n780:    \"\"\"Upper bound on the MILP objective: strictly below the incumbent (None if nothing can be gained).\"\"\"\n788:def _milp_borda(inst, cutoff, time_limit):\n808:    z = _run_milp(cost, np.ones(E), np.zeros(E), np.ones(E), rows, time_limit)\n812:def _milp_copeland(inst, cutoff, time_limit):\n847:    z = _run_milp(c, np.ones(n), np.zeros(n), np.ones(n), rows, time_limit)\n851:def _milp_plurality(inst, cutoff, time_limit):\n885:    z = _run_milp(cost, np.ones(E), np.zeros(E), np.ones(E), rows, time_limit)\n889:def _milp_trimmed(inst, cutoff, time_limit):\n944:    z = _run_milp(c, integ, lb, ub, rows, time_limit)\n948:def _l0_exchange_polish(inst, g, budget_s):\n976:_MILP_SOLVERS = {\n977:    \"borda\": _milp_borda,\n978:    \"copeland\": _milp_copeland,\n979:    \"plurality\": _milp_plurality,\n980:    \"trimmed_mean_20\": _milp_trimmed,\n984:def _milp_candidates(inst, best, t0):\n985:    \"\"\"Extra candidate plans (unverified) from the MILP / exchange layer; [] when out of budget or on any error.\"\"\"\n987:    remaining = min(_MILP_BUDGET_S, _EPISODE_LIMIT_S - _REFINE_RESERVE_S - (time.perf_counter() - t0))\n991:    if inst.rule in _MILP_SOLVERS:\n995:            g = _MILP_SOLVERS[inst.rule](inst, cutoff, remaining)\n1002:            g = _l0_exchange_polish(inst, best, min(2.0, remaining))\n1035:    # MILP / exchange layer: extra candidates only; the verified heuristic plan stays as the fallback.\n1037:        extra = _milp_candidates(inst, best, t0)\n1042:        pass  # any MILP failure keeps the heuristic plan\n1343:def _selfcheck_milp(n_trials=20, seed=0, budget_s=5.0):\n1344:    \"\"\"Offline (never called by ``handle``): on random small instances, the MILP layer's plan must verify and the\n1346:    models). Returns {(rule, cost_model): [n, n_milp_strictly_better, total_gain]}; asserts on 