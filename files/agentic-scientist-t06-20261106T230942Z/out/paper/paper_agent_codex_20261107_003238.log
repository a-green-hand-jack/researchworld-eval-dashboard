on]\n                swap_gain = np.zeros(len(current_path))\n                crosses_checkpoint = np.zeros(len(current_path), dtype=bool)\n                replacement_gain = np.zeros(len(replacement_rows))\n                for budget in checkpoints:\n                    type_gain = checkpoint_gains[budget]\n                    crossing = (path_positions < budget) != (position < budget)\n                    sign = 1 if position < budget else -1\n                    swap_gain[crossing] += sign * (type_gain[selected_types[crossing]]\n                                                   - type_gain[selected_type])\n                    crosses_checkpoint |= crossing\n                    if budget > position:\n                        replacement_gain += type_gain[replacement_types] - type_gain[selected_type]\n\n                proposals = []\n                valid_swap = crosses_checkpoint & (selected_types != selected_type)\n                if np.any(valid_swap):\n                    partner = int(np.argmax(np.where(valid_swap, swap_gain, -np.inf)))\n                    left, right = sorted((position, partner))\n                    proposal_path = current_path.copy()\n                    proposal_path[left], proposal_path[right] = proposal_path[right], proposal_path[left]\n                    affected_checkpoints = [budget for budget in checkpoints if left < budget <= right]\n                    proposals.append((proposal_path, affected_checkpoints))\n                valid_replacement = replacement_types != selected_type\n                if np.any(valid_replacement):\n                    replacement_index = int(np.argmax(np.where(valid_replacement, replacement_gain, -np.inf)))\n                    replacement_row = int(replacement_rows[replacement_index])\n                    if replacement_row in current_path:\n                        raise ValueError(\"duplicate-row replacement\")\n                    proposal_path = current_path.copy()\n                    proposal_path[position] = replacement_row\n                    affected_checkpoints = [budget for budget in checkpoints if budget > position]\n                    proposals.append((proposal_path, affected_checkpoints))\n\n                best_value = current_value\n                best_path = None\n                best_scores = None\n                for proposal_path, proposal_checkpoints in proposals:\n                    if proposal_count >= proposal_cap or time.monotonic() >= deadline:\n                        break\n                    proposal_count += 1\n                    affected_checkpoints = proposal_checkpoints\n                    proposal_value = score_prefix_path(proposal_path, checkpoints, baseline_theta)\n                    if proposal_value > best_value:\n                        best_value = proposal_value\n                        best_path = proposal_path\n                        best_scores = last_checkpoint_scores\n                if best_path is not None:\n                    proposal_path = best_path\n                    proposal_value = best_value\n\"\"\"Pinned, offline-capable preparation: python prepare_data.py --arena data/train.csv --nba data/nbaallelo.csv.\nRaw downloads stay outside the submission; this deterministic script records all derived provenance.\n\"\"\"\nimport argparse\nimport csv\nimport hashlib\nimport json\nimport pathlib\nimport unicodedata\nfrom collections import defaultdict\n\nSOURCES = {\n    \"arena\": (\"18c298340948c0e7f7727399fd459cca6ce0ca6f\", \"0692154aaf20fc6649090c3f49b6b5dd1e693a765ecb5f0856ae0da5946f5be2\"),\n    \"nba\": (\"4c1ff5e3aef1816ae04af63218015066e186c147\", \"d46ed3540ee8d9eca31b3e94cc8c777e0be5156173d814ebf65b8195e8d616bc\"),\n}\n\n\ndef canonical(value):\n    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False)\n\n\ndef digest(value):\n    return hashlib.sha256(canonical(value).encode()).hexdigest()\n\n\ndef normalize(value, strict=False):\n    if isinstance(value, str):\n        value = unicodedata.normalize(\"NFKC\" if strict else \"NFC\", value.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\"))\n        return \" \".join(value.split()) if strict else value\n    if isinstance(value, list):\n        return [normalize(item, strict) for item in value]\n    return value\n\n\ndef prepare(arena_path, nba_path, root):\n    for name, path in ((\"arena\", arena_path), (\"nba\", nba_path)):\n        if hashlib.sha256(path.read_bytes()).hexdigest() != SOURCES[name][1]:\n            raise ValueError(\"source checksum mismatch: \" + name)\n    csv.field_size_limit(16 * 1024 * 1024)\n    arena, parent, owners = [], [], {}\n\n    def find(index):\n        while parent[index] != index:\n            parent[index] = parent[parent[index]]\n            index = parent[index]\n        return index\n\n    with arena_path.open(newline=\"\", encoding=\"utf-8\") as stream:\n        for source_row, row in enumerate(csv.DictReader(stream), 2):\n            model_a, model_b = row[\"model_a\"], row[\"model_b\"]\n            flags = [int(row[key]) for key in (\"winner_model_a\", \"winner_model_b\", \"winner_tie\")]\n            if sum(flags) != 1 or model_a == model_b:\n                continue\n            outcome = 1.0 if flags[0] else 0.0 if flags[1] else 0.5\n            prompt, answer_a, answer_b = [json.loads(row[key]) for key in (\"prompt\", \"response_a\", \"response_b\")]\n            hashes = set()\n            for strict in (False, True):\n                documents = [normalize(doc, strict) for doc in (prompt, answer_a, answer_b)]\n                hashes.update(digest(doc) for doc in documents if any(str(item).strip() for item in doc))\n                left = [model_a, documents[1]]\n                right = [model_b, documents[2]]\n                if canonical(left) > canonical(right):\n                    left, right, mapped = right, left, 1 - outcome\n                else:\n                    mapped = outcome\n                hashes.add(digest([documents[0], left, right, mapped]))\n            index = len(arena)\n            parent.append(index)\n            for content_hash in sorted(hashes):\n                if content_hash in owners:\n                    parent[find(index)] = find(owners[content_hash])\n                else:\n                    owners[content_hash] = index\n            arena.append({\"source_id\": row[\"id\"], \"source_row\": source_row, \"a\": model_a, \"b\": model_b,\n                          \"y\": outcome, \"z\": 0.0, \"hashes\": sorted(hashes)})\n    members = defaultdict(list)\n    for index in range(len(arena)):\n        members[find(index)].append(index)\n    panels = {\"search\": {\"arena\": []}, \"final\": {\"arena\": []}}\n    for indices in members.values():\n        group = min(content_hash for index in indices for content_hash in arena[index][\"hashes\"])\n        plane = \"search\" if int(hashlib.sha256((\"split-v1:\" + group).encode()).hexdigest(), 16) % 4 == 0 else \"final\"\n        for index in indices:\n            arena[index][\"group\"] = group\n            panels[plane][\"arena\"].append(arena[index])\n    games = defaultdict(list)\n    with nba_path.open(newline=\"\", encoding=\"utf-8\") as stream:\n        for source_row, row in enumerate(csv.DictReader(stream), 2):\n            if int(row[\"year_id\"]) in (2006, 2007, 2008, 2011, 2012, 2013, 2014, 2015):\n                games[row[\"game_id\"]].append((source_row, row))\n    exclusions = []\n    for identity, rows in sorted(games.items()):\n        primary = [item for item in rows if item[1][\"_iscopy\"] == \"0\"]\n        if len(primary) != 1 or len(rows) != 2:\n            exclusions.append([identity, \"incomplete_reciprocal\", int(rows[0][1][\"year_id\"])])\n            continue\n        source_row, row = primary[0]\n        other = next(item[1] for item in rows if item[1][\"_iscopy\"] == \"1\")\n        if not (row[\"team_id\"] == other[\"opp_id\"] and row[\"opp_id\"] == other[\"team_id\"]\n                and row[\"pts\"] == other[\"opp_pts\"] and row[\"opp_pts\"] == other[\"pts\"]):\n            raise ValueError(\"inconsistent reciprocal game\")\n        year = int(row[\"year_id\"])\n        plane = \"search\" if year < 2010 else \"final\"\n        teams = sorted([row[\"team_id\"], row[\"opp_id\"]])\n        scores = {row[\"team_id\"]: int(row[\"pts\"]), row[\"opp_id\"]: int(row[\"opp_pts\"])}\n        location = {\"H\": 1.0, \"A\": -1.0, \"N\": 0.0}[row[\"game_location\"]]\n        home = row[\"team_id\"] if location == 1 else row[\"opp_id\"] if location == -1 else None\n        raw = [row[\"date_game\"], year, teams, [scores[team] for team in teams], home, row[\"is_playoffs\"]]\n        content_hash = digest(raw)\n        example_hash = digest([teams, [scores[team] for team in teams], row[\"date_game\"], home])\n        record = {\"source_id\": identity, \"source_row\": source_row, \"reciprocal_rows\": [item[0] for item in rows],\n                  \"a\": row[\"team_id\"], \"b\": row[\"opp_id\"], \"y\": float(int(row[\"pts\"]) > int(row[\"opp_pts\"])),\n                  \"z\": location, \"hashes\": [content_hash, example_hash], \"group\": content_hash}\n        panels[plane].setdefault(\"nba-\" + str(year), []).append(record)\n    sets = {plane: {content_hash for records in cases.values() for row in records for content_hash in row[\"hashes\"]}\n            for plane, cases in panels.items()}\n    if sets[\"search\"] & sets[\"final\"]:\n        raise ValueError(\"normalized raw document/example overlap\")\n    ids = {plane: {row[\"source_id\"] for cases in panels[plane].values() for row in cases} for plane in panels}\n    if ids[\"search\"] & ids[\"final\"]:\n        raise ValueError(\"source ID overlap\")\n    for plane, cases in panels.items():\n        destination = root / \"resources\" / plane\n        destination.mkdir(parents=True, exist_ok=True)\n        manifest = {\"normalization\": \"v1 NFC line endings preserve case/whitespace; additional NFKC whitespace-collapsed audit; JSON parsed before hashing; swapped example canonicalization; transitive document groups\",\n                    \"sources\": SOURCES, \"content_disjoint\": True, \"source_disjoint\": True,\n                    \"hash_count\": len(sets[plane]), \"group_rule\": \"sha256(split-v1:minimum-content-hash) modulo 4 equals 0 for search\",\n                    \"nba_exclusions\": [item for item in exclusions if (item[2] < 2010) == (plane == \"search\")], \"cases\": {}}\n        for case, records in cases.items():\n            records.sort(key=lambda row: row[\"source_row\"])\n            if len(records) < 1000:\n                raise ValueError(\"insufficient panel: \" + case)\n            names = sorted({row[side] for row in records for side in (\"a\", \"b\")})\n            index = {name: ordinal for ordinal, name in enumerate(names)}\n            data = {\"case\": case, \"participants\": names, \"rows\": [[index[row[\"a\"]], index[row[\"b\"]], row[\"y\"], row[\"z\"]] for row in records],\n                    \"provenance\": [{key: value for key, value in row.items() if key not in (\"a\", \"b\", \"y\", \"z\")} for row in records]}\n            (destination / (case + \".json\")).write_text(canonical(data) + \"\\n\")\n            manifest[\"cases\"][case] = {\"rows\": len(records), \"participants\": len(names), \"groups\": len({row[\"group\"] for row in records})}\n        (destination / \"manifest.json\").write_text(canonical(manifest) + \"\\n\")\n    print(canonical({plane: {case: len(rows) for case, rows in cases.items()} for plane, cases in panels.items()}))\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--arena\", type=pathlib.Path, required=True)\n    parser.add_argument(\"--nba\", type=pathlib.Path, required=True)\n    options = parser.parse_args()\n    prepare(options.arena, options.nba, pathlib.Path(__file__).resolve().parent)\n{\n  \"$id\": \"https://schemas.agentic-scientist.local/scientific-evidence/artifact-manifest.schema.json\",\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"artifact\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"source\",\n            \"derived\",\n            \"manuscript\",\n            \"figure\",\n            \"table\",\n            \"script\",\n            \"log\",\n            \"other\"\n          ],\n          \"type\": \"string\"\n        },\n        \"media_type\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Path to the artifact relative to the scientific-evidence root when possible.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"sha256\": {\n          \"description\": \"Optional hash recorded when the producing workflow computes one.\",\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"kind\"\n      ],\n      \"type\": \"object\"\n    },\n    \"derived_from\": {\n      \"description\": \"Inline @evidence refs or stable ids describing the artifact inputs.\",\n      \"items\": {\n        \"minLength\": 1,\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"type\": \"array\"\n    },\n    \"generated_by\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"command\": {\n          \"items\": {\n            \"minLength\": 1,\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"type\": \"array\"\n        },\n        \"cwd\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"finished_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        },\n        \"script_path\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"script_sha256\": {\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        },\n        \"started_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"script_path\"\n      ],\n      \"type\": \"object\"\n    },\n    \"named_outputs\": {\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"number\",\n          \"integer\",\n          \"boolean\",\n          \"array\",\n          \"object\",\n          \"null\"\n        ]\n      },\n      \"description\": \"Optional machine-readable outputs emitted by the derivation.\",\n      \"type\": \"object\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"schema_name\": {\n      \"const\": \"scientific-evidence.artifact-manifest\"\n    }\n  },\n  \"required\": [\n    \"schema_name\",\n    \"artifact\",\n    \"derived_from\"\n  ],\n  \"title\": \"Scientific Evidence Artifact Manifest\",\n  \"type\": \"object\"\n}\n.codex/skills/retrieve-references/scripts/openalex_fetch.py\n.codex/skills/retrieve-references/templates/provenance.schema.json\n.codex/skills/write-paper-standalone/scripts/validate_claims.py\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n@Article{Koh2017UnderstandingBP,\n author = {Pang Wei Koh and Percy Liang},\n booktitle = {International Conference on Machine Learning},\n pages = {1885-1894},\n title = {Understanding Black-box Predictions via Influence Functions},\n year = {2017}\n}\n\n@Article{Saunshi2022UnderstandingIF,\n author = {Nikunj Saunshi and Arushi Gupta and M. Braverman and Sanjeev Arora},\n booktitle = {International Conference on Learning Representations},\n journal = {ArXiv},\n title = {Understanding Influence Functions and Datamodels via Harmonic Analysis},\n volume = {abs/2210.01072},\n year = {2022}\n}\n\n@Article{Husain2017ImprovingLI,\n author = {S. Husain and M. Bober},\n booktitle = {IEEE Transactions on Pattern Analysis and Machine Intelligence},\n journal = {IEEE Transactions on Pattern Analysis and Machine Intelligence},\n pages = {1783-1796},\n title = {Improving Large-Scale Image Retrieval Through Robust Aggregation of Local Descriptors},\n volume = {39},\n year = {2017}\n}\n\n@Article{Gao2016DemocraticDA,\n author = {Zhan-Ning Gao and Jian-Ru Xue and Wen-Gang Zhou and Shan-Min Pang and Q. Tian},\n booktitle = {IEEE transactions on multimedia},\n journal = {IEEE Transactions on Multimedia},\n pages = {1661-1674},\n title = {Democratic Diffusion Aggregation for Image Retrieval},\n volume = {18},\n year = {2016}\n","exit_code":0,"status":"completed"}}
