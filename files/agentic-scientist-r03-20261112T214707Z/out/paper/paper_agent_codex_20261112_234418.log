  \"max_categories_per_panel\": 6,\n    \"max_series_per_panel\": 1,\n    \"max_panels_per_row\": 1,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"source_paths\": [\n      \"task/task_contract.json\",\n      \"task/evaluate_final.py\",\n      \"results/ideas/02_value_adaptive_latent_mixtures_for_absolute_error_benchmark_prediction/program_1/src/program.py\",\n      \"results/ideas/02_value_adaptive_latent_mixtures_for_absolute_error_benchmark_prediction/program_1/src/mixture.py\"\n    ],\n    \"export_requirements\": \"Keep the editable draw.io source and vector PDF; export a 300-DPI PNG companion and reference PDF in LaTeX. If only raster is available, regenerate at at least 2400 pixels wide; never upscale.\"\n  },\n  {\n    \"figure_id\": \"common_target_budget_comparison\",\n    \"required\": true,\n    \"purpose\": \"Compare useful small-budget prediction on unchanged audit targets and show between-split variability without conflating removal of queried targets with predictive improvement.\",\n    \"figure_type\": \"point_line\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"acquisition and prediction pipeline\",\n    \"metric\": \"fixed-audit normalized MAE, lower is better\",\n    \"split_by\": \"model-group versus name-proxy-family-disjoint holdout\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Use two side-by-side panels across the inspected single 5.5-inch text width, each about 2.5 inches wide, at a total height near 2.5 inches plus caption, about one third of a body page. Four discrete budget ticks and three method colors fit with 9-point labels and one shared legend. Do not shrink to a half-width float; simplify labels or stack panels if the final labels fall below 9 points.\",\n    \"allow_progression\": false,\n    \"max_panels\": 2,\n    \"max_categories_per_panel\": 4,\n    \"max_series_per_panel\": 3,\n    \"max_panels_per_row\": 2,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"aggregation\": \"Exclude replay and permuted arms. At each checkpoint aggregate observations.audit_mae or baselines[method].audit_mae across rows; model-group uses equal row weights, family-disjoint uses equal family means; then average equally over the three seeds. Plot the three aggregate seed values as unconnected small points in the method color and one descriptive mean curve, not as additional method series. The horizontal axis is evaluation budget, not campaign progress.\",\n    \"export_requirements\": \"Export PDF and PNG from the same plotting source, PNG at 300 DPI; LaTeX must use PDF. Raster-only fallback must be regenerated at at least 2400 pixels wide.\"\n  },\n  {\n    \"figure_id\": \"historical_alignment_control\",\n    \"required\": true,\n    \"purpose\": \"Show whether the evaluated prediction pipelines rely on historical cross-task alignment while maintaining common held-out targets and identifying the control\\u2019s non-causal limitations.\",\n    \"figure_type\": \"paired_dot\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"proposed, greedy ridge, and random low-rank pipelines\",\n    \"metric\": \"fixed-audit normalized MAE averaged equally over the recorded query budgets\",\n    \"split_by\": \"model-group versus name-proxy-family-disjoint holdout; original versus column-permuted historical scores\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Two side-by-side panels use the full single-column 5.5-inch text width, about 2.2 inches high plus caption, roughly one quarter to one third of a page. Three abbreviated method categories and two arm styles per panel leave room for 9-point labels, visible raw split-seed points, and a common y scale. No inset or third cramped panel is needed.\",\n    \"allow_progression\": false,\n    \"max_panels\": 2,\n    \"max_categories_per_panel\": 3,\n    \"max_series_per_panel\": 2,\n    \"max_panels_per_row\": 2,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"aggregation\": \"Use each non-replay case.audit_mae for the proposed pipeline and case.baseline_audit in documented order [random_lowrank, greedy_ridge]. These already average checkpoints with the appropriate row/family weighting. Pair original and permuted points within seed and condition; show all seeds and descriptive means. This refits/tunes the complete pipeline on permuted history and is not a pure covariance-only, mixture-only, or adaptivity-only ablation.\",\n    \"export_requirements\": \"Export vector PDF plus 300-DPI PNG from plotting source and reference PDF in LaTeX; raster-only fallback at least 2400 pixels wide, regenerated rather than enlarged.\"\n  }\n]\nrefs sample {'campaign_results_dir': 'work/results/r03/codex/20261112_215151/investigation', 'count': 25, 'generated_at': '2026-11-12T23:47:55.354316+00:00', 'queries': ['factor analysis expectation maximization missing observations diagonal residual covariance', 'mixtures of factor analyzers missing data latent Gaussian mixture', 'Bayesian active feature acquisition expected prediction loss experimental design', 'low rank matrix completion collaborative filtering matrix factorization', '\"MTEB: Massive Text Embedding Benchmark\"', '\"tinyBenchmarks: evaluating LLMs with fewer examples\"', '\"metabench\" \"A Sparse Benchmark of Reasoning and Knowledge in Large Language Models\"', '\"Observational Scaling Laws and the Predictability of Language Model Performance\"', '\"Sloth: scaling laws for LLM skills to predict multi-benchmark performance across families\"', 'Bayesian decision theory posterior median absolute error loss'], 'reference_query_plan': {'architectural_shifts': [], 'benchmarks': ['MTEB embeddings-benchmark/results at revision 6dabbcc68c28ea5f180ce7df79347b3ca9cc6383; local model-by-task panels retain natural missingness', 'English MTEB task contexts visible in the p