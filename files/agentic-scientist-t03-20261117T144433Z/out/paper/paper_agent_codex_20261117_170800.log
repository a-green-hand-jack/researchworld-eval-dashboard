{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/apply_patch; ls -l /tmp/apply_patch; command -v apply_patch || true'","aggregated_output":"#!/usr/bin/env python3\nimport sys,pathlib\ntext=sys.stdin.read().splitlines(); index=1\nwhile index<len(text):\n line=text[index]\n if line=='*** End Patch': break\n if line.startswith('*** Add File: '):\n  path=pathlib.Path(line[14:]); index+=1; content=[]\n  while index<len(text) and not text[index].startswith('*** '): content.append(text[index][1:]);index+=1\n  path.parent.mkdir(parents=True,exist_ok=True);path.write_text('\\n'.join(content)+'\\n');print('Added',path)\n elif line.startswith('*** Update File: '):\n  path=pathlib.Path(line[17:]); data=path.read_text();index+=1\n  while index<len(text) and not text[index].startswith('*** '):\n   if text[index].startswith('@@'): index+=1\n   old=[];new=[]\n   while index<len(text) and not text[index].startswith(('@@','*** ')):\n    entry=text[index];index+=1\n    if not entry: continue\n    if entry[0] in ' -': old.append(entry[1:])\n    if entry[0] in ' +': new.append(entry[1:])\n   before='\\n'.join(old);after='\\n'.join(new)\n   if before not in data: raise SystemExit('Missing context '+str(path))\n   data=data.replace(before,after,1)\n  path.write_text(data);print('Updated',path)\n else: raise SystemExit('Unknown directive '+line)\n-rwxr-xr-x 1 agent agent 1176 Nov 17 17:24 /tmp/apply_patch\n","exit_code":0,"status":"completed"}}
