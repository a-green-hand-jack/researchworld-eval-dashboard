 mid = 0.5 * (lo + hi)\n        good, gg = ok(mid)\n        if good:\n            hi, best = mid, gg\n        else:\n            lo = mid\n    return {\"status\": \"plan\", \"gains\": best}\n\n\ndef baseline_greedy(inst, clock, until):\n    dl = Deadline(clock, until)\n    T = inst.T\n    if strictly_first(inst.X, inst.i, inst.rule):\n        return {\"status\": \"first\", \"gains\": np.zeros(T)}\n    if inst.cost_model == \"l0_tasks\":\n        f = _set_margin_fn(inst)\n        movable = inst.room > 0\n        S = np.zeros(T, dtype=bool)\n        while f(S[None, :])[0] < SAFE:\n            dl.check()\n            cand = np.where(movable & ~S)[0]\n            if cand.size == 0:\n                return {\"status\": \"infeasible\", \"gains\": np.zeros(T)}\n            M = np.tile(S, (cand.size, 1))\n17:  combined_score     = 0.8 * main_efficiency + 0.2 * control_efficiency\n88:        k = T // 5\n225:            k = self.T // 5\n1148:                if not selector.select(timeout=min(remaining, 0.25)):\n1600:        \"combined_score\": 0.8 * main_eff + 0.2 * ctrl_eff,\n10:  episode efficiency = min(2, ref_cost / verified_plan_cost) for a verified successful plan (costs under\n11:    0.01 point count as 0.01; L0 costs are task counts); 1 for a correct 'infeasible' claim or a correct\n57:EPISODE_SECONDS = 12.0\n333:        q = np.unique(np.concatenate([2.0 ** -np.arange(0, 11), np.arange(1, 17) / 16.0]))\n1316:COST_FLOOR = 0.01          # points; sub-0.01-point cost differences (tie breaking) are equivalent\n1417:        eff = 2.0 if success else 0.0\n1422:        eff = min(2.0, max(ref[\"cost\"], floor) / max(cost, floor))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
