tained_time(curve, \"evaluation_accuracy\", .95)\n1012:    delay = max(0, generalize - fit) if uncensored else horizon\n1013:    return {\"memorization_step\": fit, \"generalization_step\": generalize,\n1014:            \"right_censored\": not uncensored, \"restricted_delay\": delay / horizon,\n1015:            \"grokking\": uncensored and delay >= 1000}\n1020:    horizon = 4 if smoke else HORIZON\n1021:    checkpoints = list(range(5)) if smoke else list(range(0, horizon + 1, 100))\n1022:    configuration = validate_plan(call(plan_request(episode[\"width\"], horizon, checkpoints)))\n1042:               \"arm\": arm, \"updates\": horizon, \"checkpoints\": checkpoints, \"train\": train,\n1057:    events = {arm: curve_events(arms[arm][\"curves\"], horizon) for arm in ARMS}\n1059:                                    accuracy, float(events[\"candidate\"][\"grokking\"]),\n1062:            \"solution\": {\"width\": episode[\"width\"], \"horizon\": horizon, \"configuration\": configuration,\n1079:    for field in (\"memorization_step\", \"generalization_step\", \"restricted_delay\"):\n1085:                horizon = by_width[32][\"horizon\"]\n1086:                low = 1. if low is None else low / horizon\n1087:                high = 1. if high is None else high / horizon\n1108:        for field in (\"memorization_step\", \"generalization_step\", \"restricted_delay\"):\n","exit_code":0,"status":"completed"}}
