{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, re, statistics\nfrom pathlib import Path\nregistry = json.loads(Path('paper_data.json').read_text())\nsummary = json.loads(Path('analysis_summary.json').read_text())\npaper = Path('paper.tex').read_text()\nnames = {'german_logistic':'German / logistic','german_forest':'German / forest','acs_logistic':'ACS / logistic','acs_forest':'ACS / forest'}\nerrors = []\nagreements = []\nsigns = []\nrepeat_max = 0\ncases = []\nfor episode in registry['final_evaluation']['evaluation_evidence']['episodes']:\n    for case in episode['solution']['cases']:\n        if case.get('replay') or case['case'] not in names:\n            continue\n        observed = case['observations']\n        reference = observed['reference']\n        cases.append((episode['seed'],case['case'],observed['model_diagnostics']))\n        interval = observed['fidelity_instance_bootstrap_ci95']\n        interval_row = f\\\"{episode['seed']} & {names[case['case']]} & [{interval[0]:.10f}, {interval[1]:.10f}]\\\"\n        if interval_row not in paper:\n            errors.append('Missing/mismatched interval: '+interval_row)\n        for cap_index, cap in enumerate([64,256,1024]):\n            estimates = observed['attributions'][cap_index]\n            for repeat in estimates[1:]:\n                repeat_max = max(repeat_max,max(abs(value-first) for row,first_row in zip(repeat,estimates[0]) for value,first in zip(row,first_row)))\n            def agreement(estimate):\n                return statistics.mean(1/(1+sum(abs(value-target) for value,target in zip(row,ref))/max(sum(abs(target) for target in ref),.001)) for row,ref in zip(estimate,reference))\n            scores = [agreement(observed[method][cap_index]) for method in ('standard','multistart')]\n            structure = statistics.mean(agreement(estimate) for estimate in estimates)\n            scores.append(structure)\n            agreements.append(structure)\n            signs.extend(float((0 if abs(value)<=1e-8 else (1 if value>0 else -1))==(0 if abs(target)<=1e-8 else (1 if target>0 else -1))) for estimate in estimates for row,ref in zip(estimate,reference) for value,target in zip(row,ref))\n            table_row = f\\\"{episode['seed']} & {names[case['case']]} & {cap} & \\\"+' & '.join(f'{score:.4f}' for score in scores)\n            if table_row not in paper:\n                errors.append('Mismatched table: '+table_row)\n            stored = next(row for row in summary['final'] if row['seed']==episode['seed'] and row['case']==case['case'] and row['cap']==cap)\n            for method,score in zip(('standard','multistart','structure'),scores):\n                if abs(stored[method][0]-score)>1e-12:\n                    errors.append('Mismatch summary: '+str((episode['seed'],case['case'],cap,method)))\nprint('Final table and summary discrepancies:',errors)\nprint('Independent aggregate agreement:',statistics.mean(agreements))\nprint('Independent reference sign agreement:',statistics.mean(signs))\nprint('Maximum repeat vector difference:',repeat_max)\nprint('Model diagnostics:',cases)\nprint('Downstream study present:', 'downstream_study' in registry)\nfor fragment in ('main_rows','extended_rows','interval_rows'):\n    rows = [line for line in Path('tables/'+fragment+'.tex').read_text().splitlines() if not line.startswith('%')]\n    print(fragment, 'rows:',len(rows),'all verbatim in paper:', all(row in paper for row in rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
