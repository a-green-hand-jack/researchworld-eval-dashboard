ts[: len(prefix)] == prefix for prefix in AGENT_SKILL_DIR_PREFIXES\n    )\n\n\ndef _is_approved_latex_system_input(input_path: Path) -> bool:\n    for system_root in LATEX_SYSTEM_INPUT_ROOTS:\n        if not input_path.is_relative_to(system_root):\n            continue\n        if not input_path.exists():\n            return True\n        try:\n            resolved_input = input_path.resolve(strict=True)\n            resolved_root = system_root.resolve(strict=True)\n        except OSError:\n            return False\n        return resolved_input.is_relative_to(resolved_root)\n    return False\n\n\ndef validate_latex_recorder_inputs(paper_dir: Path, fls_name: str) -> None:\n    root = paper_dir.resolve()\n    fls_path = root / fls_name\n    if not fls_path.is_file():\n        raise RuntimeError(f\"LaTeX recorder output missing: {fls_path}\")\n    recorder_lines = fls_path.read_text(\n        encoding=\"utf-8\", errors=\"replace\"\n    ).splitlines()\n    recorded_pwd = next(\n        (\n            Path(line.removeprefix(\"PWD \").strip())\n            for line in recorder_lines\n            if line.startswith(\"PWD \") and line.removeprefix(\"PWD \").strip()\n        ),\n        root,\n    )\n/usr/share/texlive/texmf-dist\n/usr/share/texlive\nlrwxrwxrwx 1 root root 40 Mar 13  2025 /usr/share/texmf/web2c/texmf.cnf -> ../../texlive/texmf-dist/web2c/texmf.cnf\ntotal 1776\ndrwxr-xr-x  7 root root     280 Oct 26 13:57 .\ndrwxr-xr-x  1 root root     200 Oct 26 14:00 ..\n-rw-r--r--  1 root root    2098 Sep 28  2006 LICENSE.CTAN\n-rw-r--r--  1 root root    5129 Mar 14  2024 LICENSE.TL\n-rw-r--r--  1 root root     182 May  8  2016 README\n-rw-r--r--  1 root root     250 Aug  9  2008 README.usergroups\ndrwxr-xr-x  2 root root      60 Oct 26 13:57 debian\n-rw-r--r--  1 root root 1789769 Mar  8  2025 doc.html\n-rw-r--r--  1 root root    1852 Apr 19  2022 index.html\ndrwxr-xr-x  2 root root     320 Oct 26 13:57 readme-html.dir\ndrwxr-xr-x  2 root root     360 Oct 26 13:57 readme