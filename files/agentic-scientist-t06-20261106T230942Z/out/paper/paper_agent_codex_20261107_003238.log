{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/sh -lc \"/tmp/apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: retrieve_permitted.py\n@@\n-    ('Kendall1938', '10.1093/biomet/30.1-2.81'),\n+    ('Fagin2003', '10.1137/S0097539702412850'),\n@@\n-    ('Efron1993', '10.1007/978-1-4899-4541-9'),\n+    ('Efron1986', '10.1214/ss/1177013815'),\n@@\n-    ('White1982', '10.2307/1912526'),\n+    ('Huber1967', '10.1214/1900796889'),\n@@\n-        title = cross.get('title', [title])[0]\n+        title = re.sub('<[\"'^>]+>'\"', '', cross.get('title', [title])[0]).replace('&', '\\\\\\\\&')\n*** End Patch\nPATCH\npython retrieve_permitted.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/sh -lc \"/tmp/apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: retrieve_permitted.py\n@@\n-    ('Kendall1938', '10.1093/biomet/30.1-2.81'),\n+    ('Fagin2003', '10.1137/S0097539702412850'),\n@@\n-    ('Efron1993', '10.1007/978-1-4899-4541-9'),\n+    ('Efron1986', '10.1214/ss/1177013815'),\n@@\n-    ('White1982', '10.2307/1912526'),\n+    ('Huber1967', '10.1214/1900796889'),\n@@\n-        title = cross.get('title', [title])[0]\n+        title = re.sub('<[\"'^>]+>'\"', '', cross.get('title', [title])[0]).replace('&', '\\\\\\\\&')\n*** End Patch\nPATCH\npython retrieve_permitted.py\"","aggregated_output":"Ford1957 Solution of a Ranking Problem from Binary Comparisons abstract True\nZermelo1929 Die Berechnung der Turnier-Ergebnisse als ein Maximumproblem der Wahrscheinlichkeitsrechnung abstract False\nThurstone1927 A law of comparative judgment. abstract True\nDavidson1970 On Extending the Bradley-Terry Model to Accommodate Ties in Paired Comparison Experiments abstract True\nBradley1952 RANK ANALYSIS OF INCOMPLETE BLOCK DESIGNS abstract False\nRao1967 Ties in Paired-Comparison Experiments: A Generalization of the Bradley-Terry Model abstract True\nAlbert1984 On the existence of maximum likelihood estimates in logistic regression models abstract True\nTurner2012 Bradley-Terry Models in\n                    R\n                    : The\n                    BradleyTerry2\n                    Package abstract True\nFirth1993 Bias reduction of maximum likelihood estimates abstract True\nHunter2004 MM algorithms for generalized Bradley-Terry models abstract True\nDiaconis1977 Spearman's Footrule as a Measure of Disarray abstract True\nHampel1974 The Influence Curve and its Role in Robust Estimation abstract True\nNegahban2017 Rank Centrality: Ranking from Pairwise Comparisons abstract True\nBubeck2015 Convex Optimization: Algorithms and Complexity abstract True\nJiang2011 Statistical ranking and combinatorial Hodge theory abstract True\nTraceback (most recent call last):\n  File \"/workspace/paper/retrieve_permitted.py\", line 110, in <module>\n    results = list(pool.map(retrieve, RECORDS))\n              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/usr/local/lib/python3.12/concurrent/futures/_base.py\", line 619, in result_iterator\n    yield _result_or_cancel(fs.pop())\n          ^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/usr/local/lib/python3.12/concurrent/futures/_base.py\", line 317, in _result_or_cancel\n    return fut.result(timeout)\n           ^^^^^^^^^^^^^^^^^^^\n  File \"/usr/local/lib/python3.12/concurrent/futures/_base.py\", line 449, in result\n    return self.__get_result()\n           ^^^^^^^^^^^^^^^^^^^\n  File \"/usr/local/lib/python3.12/concurrent/futures/_base.py\", line 401, in __get_result\n    raise self._exception\n  File \"/usr/local/lib/python3.12/concurrent/futures/thread.py\", line 59, in run\n    result = self.fn(*self.args, **self.kwargs)\n             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/workspace/paper/retrieve_permitted.py\", line 62, in retrieve\n    response.raise_for_status()\n  File \"/usr/local/lib/python3.12/site-packages/requests/models.py\", line 1167, in raise_for_status\n    raise HTTPError(http_error_msg, response=self)\nrequests.exceptions.HTTPError: 404 Client Error: Not Found for url: https://api.openalex.org/works/https://doi.org/10.1137/S0097539702412850\n","exit_code":1,"status":"failed"}}
