{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re\nfrom pathlib import Path\nfor name in ['claims_grounding.json','paper_data.json','paper_strategy.json','references_provenance.json']:\n data=json.loads(Path(name).read_text()); print('\\\\n'+name)\n for key,value in data.items():\n  if isinstance(value,dict): print(key, 'object keys:', ', '.join(value.keys()))\n  elif isinstance(value,list): print(key, 'list length:',len(value), 'first item keys:', list(value[0]) if value and isinstance(value[0],dict) else '')\n  else: print(key, str(value)[:240])\ntex=Path('paper.tex').read_text(); bib=Path('references.bib').read_text()\nprint('\\\\nSECTIONS')\nfor number,line in enumerate(tex.splitlines(),1):\n if re.search(r'\\\\\\\\(?:sub)?section|\\\\\\\\cite',line): print(number,line[:450])\nkeys=re.findall(r'@\\\\w+\\\\{([\"'^,]+)'\"',bib); used=set()\nfor group in re.findall(r'\\\\\\\\cite\\\\w*\\\\{([\"'^}]+)'\"\\\\}',tex): used.update(group.split(','))\nprint('\\\\nBIB KEYS',keys);print('UNUSED',sorted(set(keys)-used)); print('UNRESOLVED',sorted(used-set(keys)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
