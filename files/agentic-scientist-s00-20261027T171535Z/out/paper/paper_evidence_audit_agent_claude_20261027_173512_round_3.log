315677655\n},\n\"final.metric.const_macro_log_mae\": {\n\"evaluation_scope\": \"sealed_final\",\n\"id\": \"final.metric.const_macro_log_mae\",\n\"manifest_path\": \"/home/user/orca/projects/researchworld-eval/.project/runs/agentic-scientist-s00-20261027T171535Z/work/results/s00/claude/20261027_171558/final_evaluation/final_manifest.json\",\n\"results_tree_sha256\": \"sha256:05c857ccb4c51d79fd445a071615a2449cd16381d0a2a122177285cdbe3bb344\",\n\"type\": \"metric\",\n\"value\": 0.8697567125910498\n},\n\"final.metric.improvement_vs_bound\": {\n\"evaluation_scope\": \"sealed_final\",\n\"id\": \"final.metric.improvement_vs_bound\",\n\"manifest_path\": \"/home/user/orca/projects/researchworld-eval/.project/runs/agentic-scientist-s00-20261027T171535Z/work/results/s00/claude/20261027_171558/final_evaluation/final_manifest.json\",\n\"results_tree_sha256\": \"sha256:05c857ccb4c51d79fd445a071615a2449cd16381d0a2a122177285cdbe3bb344\",\n\"type\": \"metric\",\n\"value\": 1.572325638009669\n},\n\"final.metric.macro_log_mae\": {\n\"evaluation_scope\": \"sealed_final\",\n\"id\": \"final.metric.macro_log_mae\",\n\"manifest_path\": \"/home/user/orca/projects/researchworld-eval/.project/runs/agentic-scientist-s00-20261027T171535Z/work/results/s00/claude/20261027_171558/final_evaluation/final_manifest.json\",\n\"results_tree_sha256\": \"sha256:05c857ccb4c51d79fd445a071615a2449cd16381d0a2a122177285cdbe3bb344\",\n\"type\": \"metric\",\n\"value\": 0.1813722315677655\n},\n\"final.metric.mc_rel_se_median\": {\n\"evaluation_scope\": \"sealed_final\",\n\"id\": \"final.metric.mc_rel_se_median\",\n\"manifest_path\": \"/home/user/orca/projects/researchworld-eval/.project/runs/agentic-scientist-s00-20261027T171535Z/work/results/s00/claude/20261027_171558/final_evaluation/final_manifest.json\",\n\"results_tree_sha256\": \"sha256:05c857ccb4c51d79fd445a071615a2449cd16381d0a2a122177285cdbe3bb344\",\n\"type\": \"metric\",\n\"value\": 0.0286925494322401\n},\n\"final.metric.perm_max_rel_dev\": {\n\"evaluation_scope\": \"sealed_final\",\n\"id\": \"final.metric.perm_max_rel_dev\",\n\"manifest_path\": \"/home/user/orca/projects/researchworld-eval/.project/runs/agentic-scientist-s00-20261027T171535Z/work/results/s00/claude/20261027_171558/final_evaluation/final_manifest.json\",\n\"results_tree_sha256\": \"sha256:05c857ccb4c51d79fd445a071615a2449cd16381d0a2a122177285cdbe3bb344\",\n\"type\": \"metric\",\n\"value\": 0.0\n},\n\"final.metric.shuffle_macro_log_mae\": {\n\"evaluation_scope\": \"sealed_final\",\n\"id\": \"final.metric.shuffle_macro_log_mae\",\n\"manifest_path\": \"/home/user/orca/projects/researchworld-eval/.project/runs/agentic-scientist-s00-20261027T171535Z/work/results/s00/claude/20261027_171558/final_evaluation/final_manifest.json\",\n\"results_tree_sha256\": \"sha256:05c857ccb4c51d79fd445a071615a2449cd16381d0a2a122177285cdbe3bb344\",\n\"type\": \"metric\",\n\"value\": 1.4232280738969472\n},\n\"final.qualification.correct\": {\n\"evaluation_scope\": \"sealed_final\",\n\"id\": \"final.qualification.correct\",\n\"manifest_path\": \"/home/user/orca/projects/researchworld-eval/.project/runs/agentic-scientist-s00-20261027T171535Z/work/results/s00/claude/20261027_171558/final_evaluation/final_manifest.json\",\n\"program_tree_sha256\": \"sha256:6ffaa2fe42bb3ca9d67f03594b4aef6d7694ca7633e4926b0ea72f2868888565\",\n\"results_tree_sha256\": \"sha256:05c857ccb4c51d79fd445a071615a2449cd16381d0a2a122177285cdbe\n     1\t\"\"\"Baseline candidate: ridge regression of log cover time on cheap graph statistics.\n     2\t\n     3\tTask: predict the start-averaged expected cover time of the simple random walk on small\n     4\tconnected undirected graphs (6 <= n <= 30). The evaluator owns the Monte Carlo ground\n     5\ttruth; this candidate only sees labelled training graphs (via ``fit``) and unlabeled\n     6\tgraphs to predict (via ``predict``).\n     7\t\n     8\tInterface: ``handle(request) -> response`` over finite JSON values. Every request is a\n     9\tdict with an ``\"op\"`` key. Exactly one ``reset`` is sent at the start of every episode\n    10\t(the process may also be restarted before it); a reset clears all candidate state.\n    11\t\n    12\tOperations\n    13\t----------\n    14\t``{\"op\": \"reset\", \"seed\": int}``\n    15\t    ``seed`` >= 0 initializes randomness only. Response must be exactly ``{\"ok\": true}``.\n    16\t\n    17\t``{\"op\": \"fit\", \"graphs\": [G, ...]}``\n    18\t    1..16 labelled training graphs per call; several calls per episode, accumulate them.\n    19\t    ``G = {\"id\": int, \"n\": int, \"edges\": [[u, v], ...], \"target\": float, \"se\": float}``\n    20\t    Vertices are ``0..n-1``; edges are undirected, listed once, in arbitrary order and\n    21\t    with arbitrary orientation. ``target`` is the Monte Carlo estimate of the\n    22\t    start-averaged cover time (positive); ``se`` is its Monte Carlo standard error.\n    23\t    Family names, test targets and any other metadata are never sent.\n    24\t    Response must be exactly ``{\"ok\": true}``.\n    25\t\n    26\t``{\"op\": \"predict\", \"graphs\": [G, ...]}``\n    27\t    1..16 unlabeled graphs per call, ``G = {\"id\": int, \"n\": int, \"edges\": [[u, v], ...]}``.\n    28\t    Response must be exactly ``{\"predictions\": {\"<id>\": float, ...}}`` with one key per\n    29\t    requested id (the decimal string of the id, no extras) and every value a finite\n    30\t    positive number. A malformed response, a missing id or a non-positive/non-finite\n    31\t    value fails the whole episode. Vertex numbering and edge order carry no information\n    32\t    (the evaluator also sends randomly relabeled / edge-shuffled copies of the test\n    33\t    graphs and requires predictions equal up to a relative 1e-6), so use only\n    34\t    relabeling-invariant graph statistics.\n    35\t\n    36\t``predict`` may be called after any number of ``fit`` calls (including zero). Calls\n    37\twithin an episode arrive in the order reset, fit*, predict*. Responses must not contain\n    38\tadditional keys. Any other op, or an invalid request, should raise an exception.\n    39\t\n    40\tMethod: features are log n, log m, log mean degree, log max degree, log diameter\n    41\t(standardised); ridge regression (intercept unpenalised) on log(target). Fallback when\n    42\tno training data was supplied: the generic bound 2 m (n - 1).\n    43\t\"\"\"\n    44\t\n    45\timport math\n    46\tfrom collections import deque\n    47\t\n    48\t_FEATURES = 5\n    49\t_RIDGE = 1.0\n    50\t\n    51\t_state = {\"seed\": None, \"rows\": [], \"model\": None}\n    52\t\n    53\t\n    54\tdef _stats(graph):\n    55\t    n = int(graph[\"n\"])\n    56\t    adj = [set() for _ in range(n)]\n    57\t    for u, v in graph[\"edges\"]:\n    58\t        u, v = int(u), int(v)\n    59\t        if u != v:\n    60\t            adj[u].add(v)\n    61\t            adj[v].add(u)\n    62\t    m = sum(len(a) for a in adj) // 2\n    63\t    dmax = max(len(a) for a in adj)\n    64\t    diam = 0\n    65\t    for s in range(n):\n    66\t        dist = {s: 0}\n    67\t        queue = deque([s])\n    68\t        while queue:\n    69\t            x = queue.popleft()\n    70\t            for y in adj[x]:\n    71\t                if y not in dist:\n    72\t                    dist[y] = dist[x] + 1\n    73\t                    queue.append(y)\n    74\t        diam = max(diam, max(dist.values()))\n    75\t    return n, m, dmax, max(diam, 1)\n    76\t\n    77\t\n    78\tdef _features(graph):\n    79\t    n, m, dmax, diam = _stats(graph)\n    80\t    mean_deg = 2.0 * m / n\n    81\t    return [math.log(n), math.log(m), math.log(mean_deg), math.log(dmax), math.log(diam)]\n    82\t\n    83\t\n    84\tdef _bound(graph):\n    85\t    n, m, _, _ = _stats(graph)\n    86\t    return 2.0 * m * (n - 1)\n    87\t\n    88\t\n    89\tdef _solve(a, b):\n    90\t    k = len(b)\n    91\t    mat = [row[:] + [b[i]] for i, row in enumerate(a)]\n    92\t    for c in range(k):\n    93\t        p = max(range(c, k), key=lambda r: abs(mat[r][c]))\n    94\t        mat[c], mat[p] = mat[p], mat[c]\n    95\t        piv = mat[c][c]\n    96\t        for r in range(c + 1, k):\n    97\t            f = mat[r][c] / piv\n    98\t            for j in range(c, k + 1):\n    99\t                mat[r][j] -= f * mat[c][j]\n   100\t    x = [0.0] * k\n   101\t    for r in range(k - 1, -1, -1):\n   102\t        x[r] = (mat[r][k] - sum(mat[r][j] * x[j] for j in range(r + 1, k))) / mat[r][r]\n   103\t    return x\n   104\t\n   105\t\n   106\tdef _fit_model(rows):\n   107\t    count = len(rows)\n   108\t    xs = [r[0] for r in rows]\n   109\t    ys = [r[1] for r in rows]\n   110\t    mean = [sum(x[j] for x in xs) / count for j in range(_FEATURES)]\n   111\t    std = [math.sqrt(sum((x[j] - mean[j]) ** 2 for x in xs) / count) or 1.0 for j in range(_FEATURES)]\n   112\t    z = [[(x[j] - mean[j]) / std[j] for j in range(_FEATURES)] for x in xs]\n   113\t    ybar = sum(ys) / count\n   114\t    a = [[sum(z[i][p] * z[i][q] for i in range(count)) + (_RIDGE if p == q else 0.0)\n   115\t          for q in range(_FEATURES)] for p in range(_FEATURES)]\n   116\t    b = [sum(z[i][p] * (ys[i] - ybar) for i in range(count)) for p in range(_FEATURES)]\n   117\t    return {\"mean\": mean, \"std\": std, \"w\": _solve(a, b), \"b\": ybar}\n   118\t\n   119\t\n   120\tdef _predict_one(graph):\n   121\t    model = _state[\"model\"]\n   122\t    if model is None:\n   123\t        return _bound(graph)\n   124\t    f = _features(graph)\n   125\t    z = sum(model[\"w\"][j] * (f[j] - model[\"mean\"][j]) / model[\"std\"][j] for j in range(_FEATURES))\n   126\t    return max(math.exp(model[\"b\"] + z), 1e-9)\n   127\t\n   128\t\n   129\tdef handle(request):\n   130\t    op = request[\"op\"]\n   131\t    if op == \"reset\":\n   132\t        _state[\"seed\"] = int(request[\"seed\"])\n   133\t        _state[\"rows\"] = []\n   134\t        _state[\"model\"] = None\n   135\t        return {\"ok\": True}\n   136\t    if op == \"fit\":\n   137\t        for g in request[\"graphs\"]:\n   138\t            _state[\"rows\"].append((_features(g), math.log(float(g[\"target\"]))))\n   139\t        _state[\"model\"] = _fit_model(_state[\"rows\"])\n   140\t        return {\"ok\": True}\n   141\t    if op == \"predict\":\n   142\t        return {\"predictions\": {str(int(g[\"id\"])): float(_predict_one(g)) for g in request[\"graphs\"]}}\n   143\t    raise ValueError(\"unknown op\")\nschema_version = 1\ncode_root = \"src\"\n\n[entrypoint]\npath = \"program.py\"\nlanguage = \"python\"\ntype = \"script\"\n\n[copy]\nexclude = [\n  \"**/__pycache__/**\",\n  \"**/*.pyc\",\n  \".venv/**\",\n  \"node_modules/**\",\n  \".git/**\",\n  \".mypy_cache/**\",\n  \".pytest_cache/**\",\n  \".ruff_cache/**\",\n  \".tox/**\",\n  \".nox/**\",\n  \"dist/**\",\n  \"build/**\",\n]\ninclude = [\n]\n\n[integration]\nkind = \"generic\"\nnotes = \"\"\nsame","is_error":false}]},"parent_tool_use_id":null,"session_id":"12cfe8e1-3f02-4854-9a60-0123e40e0786","uuid":"327a6d47-6b8e-452e-948f-cf2152a9bfd6","timestamp":"2026-10-27T17:57:56.180Z","tool_use_result":{"stdout":"{\n \"correct\": true,\n \"evaluation_evidence\": {\n  \"candidate_diagnostics_trust\": \"unverified\",\n  \"episode_count\": 3,\n  \"episodes\": [\n   {\n    \"correct\": true,\n    \"duration_seconds\": 0.05828403797931969,\n    \"score\": -0.18137223156776552,\n    \"seed\": 201\n   },\n   {\n    \"correct\": true,\n    \"duration_seconds\": 0.0562510818708688,\n    \"score\": -0.18137223156776552,\n    \"seed\": 202\n   },\n   {\n    \"correct\": true,\n    \"duration_seconds\": 0.05980929592624307,\n    \"score\": -0.18137223156776552,\n    \"seed\": 203\n   }\n  ],\n  \"path\": \"/home/user/orca/projects/researchworld-eval/.project/runs/agentic-scientist-s00-20261027T171535Z/work/results/s00/claude/20261027_171558/final_evaluation/results/evaluation_evidence.json\",\n  \"sha256\": \"sha256:ded82b4197df97809616607192337c55e99d3bf