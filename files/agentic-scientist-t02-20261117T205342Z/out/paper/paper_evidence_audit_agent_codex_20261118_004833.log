{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json, re, hashlib, statistics, math, unicodedata\nfrom pathlib import Path\nfrom collections import defaultdict\npaper=Path('paper.tex').read_text()\ndata=json.loads(Path('paper_data.json').read_text())\nfinal=data['final_evaluation']\nepisodes=final['evaluation_evidence']['episodes']\nsource=json.loads(Path('source_evidence/evaluation_evidence.json').read_text())\nassert source['episodes']==episodes\nfor path, expected in [('source_evidence/evaluate_final.py', final['evaluator_sha256']), ('source_evidence/evaluation_evidence.json',final['evaluation_evidence']['sha256'])]:\n    assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==expected.removeprefix('sha256:')\nfor field in ['status','outcome','correct']:\n    assert data['grounding_sources']['final.qualification.'+field]['value']==final[field]\nderived=json.loads(Path('analysis/derived_results.json').read_text())\nrecords=[]\ngroups=defaultdict(list)\nfor episode in episodes:\n    for entry in episode['solution']:\n        case=entry['case']; observed=entry['observations']; trace=observed['trace']\n        assert observed['complete']\n        assert [point['step'] for point in trace]==list(range(0,20001,500))\n        events=[]\n        for field, threshold in [('train_accuracy',.99),('heldout_accuracy',.95)]:\n            events.append(next((trace[index]['step'] for index in range(len(trace)-2) if all(point[field]>=threshold for point in trace[index:index+3])),None))\n        memorization,generalization=events\n        lag=20000 if memorization is None else max(0,(20000 if generalization is None else generalization)-memorization)\n        assert events==[observed['memorization'],observed['generalization']]\n        assert lag==observed['lag']\n        late=trace[-5:]\n        row=dict(case, memorization=memorization,generalization=generalization,lag=lag,\n            late_train=statistics.fmean(point['train_accuracy'] for point in late),\n            late_heldout=statistics.fmean(point['heldout_accuracy'] for point in late),\n            complete=observed['complete'],parameter_count=trace[0]['parameter_count'],\n            final_train_loss=trace[-1]['train_loss'],final_heldout_loss=trace[-1]['heldout_loss'],\n            initial_norm=trace[0]['weight_norm'],final_norm=trace[-1]['weight_norm'],\n            controls={control:statistics.fmean(point['controls'][control] for point in late) for control in late[0]['controls']})\n        assert row['parameter_count']==292*case['width']+97\n        assert math.isclose(row['late_heldout'],observed['score'],abs_tol=1e-12)\n        records.append(row); groups[(case['operation'],case['decay'],case['width'])].append(row)\nassert records==derived['records']\nfor operation, decay, width, seed, memorization, lag, train, heldout in re.findall(r'\"'^(add'\"\\\\.|sub\\\\.) & (\\\\d) & (\\\\d+) & (\\\\d+) & (.*?) & (\\\\d+) & ([\\\\d.]+) & ([\\\\d.]+) \\\\\\\\\\\\\\\\', paper, re.M):\n    matches=[row for row in records if row['operation']=={'add.':'addition','sub.':'subtraction'}[operation] and row['decay']==int(decay) and row['width']==int(width) and row['seed']==int(seed)]\n    assert len(matches)==1\n    row=matches[0]\n    assert memorization==('\\\\\\\\textemdash' if row['memorization'] is None else str(row['memorization']))\n    assert int(lag)==row['lag']\n    assert train==f\\\"{100*row['late_train']:.3f}\\\" and heldout==f\\\"{100*row['late_heldout']:.3f}\\\"\nassert len(re.findall(r'\"'^(?:add'\"\\\\.|sub\\\\.) &',paper,re.M))==36\nfor operation,decay,width,train_loss,heldout_loss,norm in re.findall(r'\"'^(Addition|Subtraction) & ('\"\\\\d) & (\\\\d+) & ([\\\\de.\\\\-]+) & ([\\\\de.\\\\-]+) & ([\\\\de.\\\\-]+) \\\\\\\\\\\\\\\\',paper,re.M):\n    rows=groups[(operation.lower(),int(decay),int(width))]\n    assert [train_loss,heldout_loss,norm]==[f'{statistics.fmean(row[field] for row in rows):.3g}' for field in ['final_train_loss','final_heldout_loss','final_norm']]\nassert len(re.findall(r'\"'^(?:Addition|Subtraction) &'\"',paper,re.M))==12\nresource=json.loads(Path('source_evidence/resources/final/benchmark.json').read_text())\nfor operation in ['addition','subtraction']:\n    rows=[]\n    for first in range(97):\n        for second in range(97):\n            encoded=json.dumps({'operation':operation,'p':97,'a':first,'b':second},ensure_ascii=False,separators=(',',':'))\n            digest=hashlib.sha256(' '.join(unicodedata.normalize('NFKC',encoded).split()).encode()).hexdigest()\n            rows.append((digest,first,second))\n    rows=sorted(rows)[9409//2:]\n    rows.sort(key=lambda row:hashlib.sha256(('train-v1:'+row[0]).encode()).digest())\n    assert len(resource['examples'][operation])==len(rows)==4705\n    for index, (stored,(digest,first,second)) in enumerate(zip(resource['examples'][operation],rows)):\n        assert stored['content_sha256']==digest and stored['a']==first and stored['b']==second\n        assert stored['label']==(first+second if operation=='addition' else first-second)%97\n        assert stored['split']==('train' if index<1411 else 'heldout')\nprint('Verified exact supplied source/observation hashes; source and registry episode equality; independent final qualification; all 36 record events, lags, checkpoints, parameter counts and SI observation rows; all 12 SI diagnostics rows; both exact hashed data partitions.')\nprint('Completed:',len(records),'Memorized:',sum(row['memorization'] is not None for row in records),'Generalized:',sum(row['generalization'] is not None for row in records))\nprint('Condition means: operation decay width train% heldout% heldout-SD% heldout-CE final-norm')\nfor key,rows in groups.items():\n    print(*key,*[round(statistics.fmean(row[field] for row in rows)*(100 if field.startswith('late_') else 1),6) for field in ['late_train','late_heldout']],round(100*statistics.stdev(row['late_heldout'] for row in rows),6),round(statistics.fmean(row['final_heldout_loss'] for row in rows),6),round(statistics.fmean(row['final_norm'] for row in rows),6))\nprint('Initial norm means:',{width:statistics.fmean(row['initial_norm'] for row in records if row['width']==width) for width in [16,64,256]})\nprint('Reference means%:',{control:100*statistics.fmean(row['controls'][control] for row in records) for control in records[0]['controls']})\nprint('Overall mean%:',100*statistics.fmean(row['late_heldout'] for row in records))\nprint('Contrasts:',derived['paired_contrasts'])\nprint('All read-only numeric checks passed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json, re, hashlib, statistics, math, unicodedata\nfrom pathlib import Path\nfrom collections import defaultdict\npaper=Path('paper.tex').read_text()\ndata=json.loads(Path('paper_data.json').read_text())\nfinal=data['final_evaluation']\nepisodes=final['evaluation_evidence']['episodes']\nsource=json.loads(Path('source_evidence/evaluation_evidence.json').read_text())\nassert source['episodes']==episodes\nfor path, expected in [('source_evidence/evaluate_final.py', final['evaluator_sha256']), ('source_evidence/evaluation_evidence.json',final['evaluation_evidence']['sha256'])]:\n    assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==expected.removeprefix('sha256:')\nfor field in ['status','outcome','correct']:\n    assert data['grounding_sources']['final.qualification.'+field]['value']==final[field]\nderived=json.loads(Path('analysis/derived_results.json').read_text())\nrecords=[]\ngroups=defaultdict(list)\nfor episode in episodes:\n    for entry in episode['solution']:\n        case=entry['case']; observed=entry['observations']; trace=observed['trace']\n        assert observed['complete']\n        assert [point['step'] for point in trace]==list(range(0,20001,500))\n        events=[]\n        for field, threshold in [('train_accuracy',.99),('heldout_accuracy',.95)]:\n            events.append(next((trace[index]['step'] for index in range(len(trace)-2) if all(point[field]>=threshold for point in trace[index:index+3])),None))\n        memorization,generalization=events\n        lag=20000 if memorization is None else max(0,(20000 if generalization is None else generalization)-memorization)\n        assert events==[observed['memorization'],observed['generalization']]\n        assert lag==observed['lag']\n        late=trace[-5:]\n        row=dict(case, memorization=memorization,generalization=generalization,lag=lag,\n            late_train=st