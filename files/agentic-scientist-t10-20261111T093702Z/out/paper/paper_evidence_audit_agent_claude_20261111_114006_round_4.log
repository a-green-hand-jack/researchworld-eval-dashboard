alse}\n    except (ArithmeticError, ValueError, RuntimeError, FloatingPointError):\n        fallback = 2 * 1.959963984540054 * work[\"sd\"] / math.sqrt(work[\"n\"])\n        return {\"C\": fallback, \"L\": fallback, \"P\": fallback, \"failed\": True}\n\n\n6:family pool (or an analytic synthetic generator) with evaluator-private RNG keyed on a private master\n49:    \"galaxies\": (\"galaxies.npz\", \"Y\", \"Yhat\", 300, 5000),\n50:    \"forest\": (\"forest.npz\", \"Y\", \"Yhat\", 100, 1000),\n51:    \"gene_expression\": (\"gene_expression.npz\", \"Y\", \"Yhat\", 500, 10000),\n52:    \"alphafold\": (\"alphafold.npz\", \"Y\", \"Yhat\", 300, 5000),\n55:    \"galaxies.npz\": \"7be1d40a049f524fc51e150281541359a47c5eca80343dfac5b1c457fd7eae99\",\n56:    \"forest.npz\": \"9708f3be14850a55d03f88dad235c87b4a3b6c6e8cb81173cc580de8f7386ade\",\n57:    \"gene_expression.npz\": \"72565d2d88ed6a16331b3423da5dee036e97f2220fad054eb139ced1942e3303\",\n58:    \"alphafold.npz\": \"93f680d2f0d48844b96c4495efec1a3a84e8dd572ba3f17c4f07401ad20534f9\",\n60:MAIN_FAMILIES = [\"galaxies\", \"forest\", \"gene_expression\", \"alphafold\", \"synthetic\"]\n61:CONTROL_BASES = [\"galaxies\", \"gene_expression\"]\n62:REPS_MAIN = 60\n63:REPS_CONTROL = 20\n64:SEEDS = [1001, 1002, 1003, 1004, 1005]\n68:    (\"nonlinear_miscalibrated\", 1.0, dict(a=1.0, b=1.5, s=0.5, kind=\"exp\", rate=0.9, noise_hat=0.05)),\n74:WALL_SECONDS = 3600.0\n75:SMOKE_PLAN = [(\"galaxies\", \"main\"), (\"forest\", \"main\"), (\"gene_expression\", \"main\"),\n76:              (\"alphafold\", \"main\"), (\"synthetic\", \"main\"),\n77:              (\"galaxies\", \"const\"), (\"galaxies\", \"perm\"), (\"galaxies\", \"shift\")]\n84:STARTUP_ALLOWANCE = 60.0\n124:    \"\"\"Expected candidate-side transport failure (crash, closed channel, raised exception).\"\"\"\n132:    \"\"\"Explicit response-validation failure with a fixed category.\"\"\"\n381:        pools[name] = {\"y\": y, \"yhat\": yhat, \"n\": n, \"N\": big_n, \"truth\": float(