try.schema.json\n- schemas/verification-report.schema.json\n- bundle.manifest.json\n- ledger.jsonl\n{\n  \"keys\": [\n    \"campaign_results_dir\",\n    \"count\",\n    \"generated_at\",\n    \"queries\",\n    \"reference_query_plan\",\n    \"references\",\n    \"results_dir\"\n  ],\n  \"first\": {\n    \"citation_count\": 223,\n    \"citation_key\": \"Hedges1996EstimatingES\",\n    \"id\": \"ref.s2.3c91bee5b23c8bdcbc1330e7c42781299b1051a6\",\n    \"paper_id\": \"3c91bee5b23c8bdcbc1330e7c42781299b1051a6\",\n    \"query\": \"sample splitting model selection independent test error bias variance\",\n    \"retrieved_at\": \"2026-11-06T05:07:42.226851+00:00\",\n    \"source_url\": \"https://api.semanticscholar.org/graph/v1/paper/3c91bee5b23c8bdcbc1330e7c42781299b1051a6?fields=paperId%2Ctitle%2Cyear%2Cvenue%2CcitationCount%2CcitationStyles%2Curl\",\n    \"title\": \"Estimating Effect Size Under Publication Bias: Small Sample Properties and Robustness of a Random Effects Selection Model\",\n    \"venue\": \"\",\n    \"year\": 1996\n  }\n}\n{\n  \"candidate_diagnostics_trust\": \"unverified\",\n  \"episode_count\": 5,\n  \"path\": \"work/results/a06/codex/20261105_100448/final_evaluation/results/evaluation_evidence.json\",\n  \"sha256\": \"sha256:4fac2b8c82f0ca0b7099446024b11ff1714ff18d3fb2875a1327f0c1fd750bae\",\n  \"status\": \"available\"\n}\n52:def require_reset_ack(response):\n56:def bounded_failure_name(value, fallback):\n64:def describe_episode_failure(error, operation):\n80:def fail_required_baseline(category, cancel_work, record_failure):\n92:def collect_required_baseline(result, *, deadline, clock, cancel_work, record_failure):\n107:def guard_required_baseline(call, failure_category, cancel_work, record_failure):\n119:def record_failure(failure):\n129:def bounded_json_line(value, wire_limit=WIRE_LIMIT):\n138:def no_duplicates(pairs):\n146:def decode(data):\n232:def repair_mode():\n235:def report_worker_exception(error):\n256:def candidate_subprocess_settings(parent_environment):\n263:def record_rpc_failure(error,request,started,timeout,call_index):\n298:roots=[str(pathlib.Path(sys.argv[1]).parent),sys.prefix,'/usr','/lib','/lib64','/etc/ld.so.cache','/dev/null','/dev/urandom']\n446:def bounded_candidate_dispatch(call,request,*,timeout,check_required):\n574:def inference_worker(root):\n585:    model=AutoModelForCausalLM.from_pretrained(str(Path(root)/'model'),local_files_only=True,torch_dtype=torch.float32,attn_implementation='sdpa').eval()\n586:    tokenizer=AutoTokenizer.from_pretrained(str(Path(root)/'model'),local_files_only=True)\n590:    cache={}\n603:                if key in cache:\n604:                    predictions[row_index][arm]=cache[key]\n609:                        cache[key]=-1\n628:                output=model.generate(**inputs,do_sample=False,max_new_tokens=1,pad_token_id=tokenizer.pad_token_id,use_cache=True,prefix_allowed_tokens_fn=lambda batch_index,input_ids:legal_tokens[batch_index])\n637:                cache[item[2]]=answer\n688:def normalized(text):\n691:def digest(value):\n694:def load_resources(root,smoke):\n715:    return rows,json.loads((root/'synthetic_manifest.json').read_text())\n717:def validate_plan(response,request):\n746:def wilson(mean,count):\n753:def estimate(matrix,selection,report,order,weights=None):\n760:def summarize(matrix,truth,selection,report,order,random_arm):\n785:def controls(matrix,selection,report,order,permuted,effective_changes):\n809:def worst_case(episode):\n816:def average(values):\n823:def reserved_method_deadline(*,now,episode_deadline,methods_remaining,work_seconds,cleanup_seconds):\n829:def run_declared_episodes(episodes,*,hard_deadline,finish_reserve,reset_timeout,episode_overhead,rpc_cap,clock,rpc,evaluate,worst_case,record_failure,startup_reset_timeout=None):\n882:def preflight(smoke):\n898:def plan_episodes(smoke):\n905:def experiment(rows,synthetic_manifest,baseline,smoke):\n936:            for regime in range(4):\n937:                generator=np.random.default_rng(np.random.SeedSequence([seed,size,arms,regime]))\n938:                truth=np.full(arms,.6) if regime//2==0 else np.linspace(.4,.8,arms)\n939:                correlation=.1 if regime%2==0 else .9\n941:                regime_values=[]\n955:                    regime_values.append(value)\n957:                details.append({'regime':regime,'metrics':{name:average([value[name] for value in regime_values]) for name in ORDINARY},'permutation_report_mean':average(control_values),'copy_report_independence_audit_passed':False,'report_mse_standard_error':float(np.std([value['report_mse'] for value in regime_values],ddof=1)/math.sqrt(len(regime_values)))})\n958:            expected=synthetic_manifest['episodes'][f\"{seed}-{size}-{arms}-{episode['reps']}\"]\n960:                raise RuntimeError('synthetic raw-content hash audit failed')\n991:            bootstrap=[]\n995:                sample=generator.choice(subjects,len(subjects),replace=True)\n996:                indices=[index for subject in sample for index in subject_indices[subject]]\n997:                bootstrap.append(float(differences[indices].mean()))\n1000:            detail.update(paired_subject_bootstrap_interval=np.quantile(bootstrap,[.025,.975]).tolist(),invalid_answer_count=int(np.count_nonzero(outputs<0)),audit_size=len(items)-size,controls=control_values,permutation_null_by_arm=permutation_null)\n1015:def validated_evidence_bytes(evidence):\n1075:def write_results(directory,metrics,correct,feasible,evidence=None):\n1091:def main():\n1116:        planned_cache=set()\n1124:                episode['work_seconds']=.55*len(cells-planned_cache)+10\n1125:                planned_cache.update(cells)\n\"\"\"Offline, evaluator-owned post-selection reporting experiment.\n\nRun with --program_path ENTRYPOINT --results_dir DIRECTORY. Final is standalone.\nScientific validity has no superiority threshold; publication claims require analysis.\n\"\"\"\nimport argparse\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport re\nimport selectors\nimport shutil\nimport signal\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unicodedata\n\nPLANE = 'final'\nSEEDS = [1009, 2027, 3037, 4051, 5059]\nREPLICATES = 1024\nWALL_SECONDS = 43200\nRPC_BUDGET = 82\nDEFAULT_PROMPT = 'Answer the multiple-choice question. Return only the correct option letter A through J.'\nWIRE_LIMIT = 64 * 1024 * 1024\nINLINE_LIMIT = 8 * 1024 * 1024\nMETRICS = ('combined_score report_mse reuse_mse full_budget_naive_mse honest_half_mse fixed_prompt_mse random_prompt_mse selected_accuracy report_bias signed_optimism coverage interval_width decision_reversal_rate failure_rate control_failure_rate replay_discrepancy correct').split()\nORDINARY = METRICS[1:-2]\nSTARTED = time.monotonic()\nFAILURE_RECORDED = False\n\nclass ProtocolFailure(RuntimeError):\n    pass\n\nclass TransportFailure(RuntimeError):\n    pass\n\nclass CandidateCallInterrupted(BaseException):\n    def __init__(self,failure):\n        self.failure=failure\n\nclass InvalidResetResponse(RuntimeError):\n    pass\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {'ok'} or response['ok'] is not True:\n        raise InvalidResetResponse('invalid reset response')\n\ndef bounded_failure_name(value, fallback):\n    return value if isinstance(value, str) and re.fullmatch(r'[a-z][a-z0-9_]{0,79}', value) else fallback\n\nclass RequiredBaselineFailure(RuntimeError):\n    def __init__(self, category):\nfinal\nsearch\n%%%% ICLR Macros (LaTex)\n%%%% Adapted by Hugo Larochelle from the NIPS stylefile Macros\n%%%% Style File\n%%%% Dec 12, 1990   Rev Aug 14, 1991; Sept, 1995; April, 1997; April, 1999; October 2014\n\n% This file can be used with Latex2e whether running in main mode, or\n% 2.09 compatibility mode.\n%\n% If using main mode, you need to include the commands\n%             \\documentclass{article}\n%             \\usepackage{iclr14submit_e,times}\n%\n\n% Change the overall width of the page.  If these parameters are\n%       changed, they will require corresponding changes in the\n%       maketitle section.\n%\n\\usepackage{eso-pic} % used by \\AddToShipoutPicture\n\\RequirePackage{fancyhdr}\n\\RequirePackage{natbib}\n\n% modification to natbib citations\n\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n\n\\renewcommand{\\topfraction}{0.95}   % let figure take up nearly whole page\n\\renewcommand{\\textfraction}{0.05}  % let figure take up nearly whole page\n\n% Define iclrfinal, set to true if iclrfinalcopy is defined\n\\newif\\ificlrfinal\n\\iclrfinalfalse\n\\def\\iclrfinalcopy{\\iclrfinaltrue}\n\\font\\iclrtenhv  = phvb at 8pt\n\n% Specify the dimensions of each page\n\n\\setlength{\\paperheight}{11in}\n\\setlength{\\paperwidth}{8.5in}\n\n\n\\oddsidemargin .5in    %   Note \\oddsidemargin = \\evensidemargin\n\\evensidemargin .5in\n\\marginparwidth 0.07 true in\n%\\marginparwidth 0.75 true in\n%\\topmargin 0 true pt           % Nominal distance from top of page to top of\n%\\topmargin 0.125in\n\\topmargin -0.625in\n\\addtolength{\\headsep}{0.25in}\n\\textheight 9.0 true in       % Height of text (including footnotes & figures)\n\\textwidth 5.5 true in        % Width of text line.\n\\widowpenalty=10000\n\\clubpenalty=10000\n\n% \\thispagestyle{empty}        \\pagestyle{empty}\n\\flushbottom \\sloppy\n\n% We're never going to need a table of contents, so just flush it to\n% save space --- suggested by drstrip@sandia-2\n\\def\\addcontentsline#1#2#3{}\n\n% Title stuff, taken from deproc.\n\\def\\maketitle{\\par\n\\begingroup\n   \\def\\thefootnote{\\fnsymbol{footnote}}\n   \\def\\@makefnmark{\\hbox to 0pt{$^{\\@thefnmark}$\\hss}} % for perfect author\n                                                        % name centering\n%   The footnote-mark was overlapping the footnote-text,\n%   added the following to fix this problem         