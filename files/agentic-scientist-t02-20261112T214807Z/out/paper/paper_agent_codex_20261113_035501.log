ic.complete_episode_fraction\",\n    \"manifest_path\": \"work/results/t02/codex/20261112_215258/final_evaluation/final_manifest.json\",\n    \"results_tree_sha256\": \"sha256:70740ed8b8d2de21796c9f5331d030141e44dce4ea08654c924f1465f4565e90\",\n    \"type\": \"metric\",\n    \"value\": 0.5555555555555556\n  },\n  \"final.metric.control_validity_rate\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.metric.control_validity_rate\",\n    \"manifest_path\": \"work/results/t02/codex/20261112_215258/final_evaluation/final_manifest.json\",\n    \"results_tree_sha256\": \"sha256:70740ed8b8d2de21796c9f5331d030141e44dce4ea08654c924f1465f4565e90\",\n    \"type\": \"metric\",\n    \"value\": 0.5555555555555556\n  },\n  \"final.metric.evidence_score\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.metric.evidence_score\",\n    \"manifest_path\": \"work/results/t02/codex/20261112_215258/final_evaluation/final_manifest.json\",\n    \"results_tree_sha256\": \"sha256:70740ed8b8d2de21796c9f5331d030141e44dce4ea08654c924f1465f4565e90\",\n    \"type\": \"metric\",\n    \"value\": 0.5386999645766914\n  },\n  \"final.metric.grokking_incidence\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.metric.grokking_incidence\",\n    \"manifest_path\": \"work/results/t02/codex/20261112_215258/final_evaluation/final_manifest.json\",\n    \"results_tree_sha256\": \"sha256:70740ed8b8d2de21796c9f5331d030141e44dce4ea08654c924f1465f4565e90\",\n    \"type\": \"metric\",\n    \"value\": 0.2222222222222222\n  },\n  \"final.metric.mean_final_accuracy\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.metric.mean_final_accuracy\",\n    \"manifest_path\": \"work/results/t02/codex/20261112_215258/final_evaluation/final_manifest.json\",\n    \"results_tree_sha256\": \"sha256:70740ed8b8d2de21796c9f5331d030141e44dce4ea08654c924f1465f4565e90\",\n    \"type\": \"metric\",\n    \"value\": 0.48813319164009916\n  },\n  \"final.metric.r