erformance evidence, not measured losses.', 'Search scores and sealed final metrics belong to different evaluation scopes.', 'An unqualified final outcome may reflect validity or other criteria; do not infer that failure means only an inferior score. Interpret metrics within those limitations.'], 'search_score_delta': 0.0, 'selection_kind': 'baseline'}\nstrategy keys ['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason']\nthesis In the evaluated public score panels, aggregation robustness is conditional on the response ceiling: exact six-task results reverse the mean–median minimum-support ordering between half and full headroom on matched attainable targets, while larger subject-level panels establish feasible investment bounds rather than exact rule rankings.\nfigure specs [('investment_overview', 'generate-concept-figure'), ('exact_rule_contrast', 'matplotlib'), ('attainability_and_support_scope', 'matplotlib')]\nmanifest {'figures': [{'figure_id': 'investment_overview', 'figure_type': 'diagram', 'path_png': 'figures/investment_overview.png', 'n_panels': 1, 'panels_per_row': 1, 'categories_per_panel': [6], 'series_per_panel': [3], 'max_label_chars': 40, 'font_sizes': {'axis': 10, 'ticks': 9, 'legend': 9, 'title': 10}, 'uses_abbrev_labels': False, 'uses_progression': False, 'generator': 'generate-concept-figure', 'source_ids': [], 'prompt_log_path': 'figures/investment_overview.prompts.json', 'placement': 'full_width', 'intended_latex_width_fraction': 1.0, 'estimated_min_rendered_font_pt': 9}, {'figure_id': 'exact_rule_contrast', 'figure_type': 'composite', 'path_pdf': 'figures/exact_rule_contrast.pdf', 'path_png': 'figures/exact_rule_contrast.png', 'n_panels': 2, 'panels_per_row': 2, 'categories_per_panel': [3, 3], 'series_per_panel': [1, 1], 'max_label_chars': 28, 'font_sizes': {'axis': 10, 'ticks': 9, 'legend': 9, 'title': 10}, 'uses_abbrev_labels': True, 'uses_progression': False, 'generator': 'matplotlib', 'source_ids': ['final.evidence.episodes'], 'placement': 'full_width', 'intended_latex_width_fraction': 1.0, 'estimated_min_rendered_font_pt': 9}, {'figure_id': 'attainability_and_support_scope', 'figure_type': 'composite', 'path_pdf': 'figures/attainability_and_support_scope.pdf', 'path_png': 'figures/attainability_and_support_scope.png', 'n_panels': 4, 'panels_per_row': 2, 'categories_per_panel': [3, 3, 3, 3], 'series_per_panel': [3, 3, 3, 3], 'max_label_chars': 28, 'font_sizes': {'axis': 10, 'ticks': 9, 'legend': 9, 'title': 10}, 'uses_abbrev_labels': True, 'uses_progression': False, 'generator': 'matplotlib', 'source_ids': ['final.evidence.episodes'], 'placement': 'full_width', 'intended_latex_width_fraction': 1.0, 'estimated_min_rendered_font_pt': 9}]}\n#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")/..\"\npdflatex -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\nbibtex paper\npdflatex -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\npdflatex -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\nimport hashlib\nimport json\nfrom pathlib import Path\n\n\ndef main():\n    contracts = [\n        (\"paper.tex\", \"manuscript\", \"scripts/build_paper_artifacts.py\", [\"paper_data.json\", \"derived/summary.json\", \"source_evidence/downstream/program/src/program.py\", \"source_evidence/evaluation/evaluate_final.py\", \"references_provenance.json\"]),\n        (\"paper.pdf\", \"manuscript\", \"scripts/compile_paper.sh\", [\"paper.tex\", \"references.bib\", \"iclr2026_conference.sty\", \"iclr2026_conference.bst\", \"figures/investment_overview.png\", \"figures/exact_rule_contrast.pdf\", \"figures/attainability_and_support_scope.pdf\"]),\n        (\"claims_grounding.json\", \"derived\", \"scripts/map_claims.py\", [\"paper_data.json\", \"derived/summary.json\", \"references_provenance.json\"]),\n        (\"figure_manifest.json\", \"derived\", \"scripts/build_paper_artifacts.py\", [\"paper_strategy.json\", \"derived/summary.json\"]),\n        (\"references.bib\", \"derived\", \"scripts/curate_references.py\", [str(path) for path in sorted(Path(\"literature\").glob(\"*.json\"))]),\n        (\"references_provenance.json\", \"derived\", \"scripts/curate_references.py\", [str(path) for path in sorted(Path(\"literature\").glob(\"*.json\"))]),\n        (\"derived/writer_validation.json\", \"derived\", \"scripts/audit_manuscript.py\", [\"paper.tex\", \"paper.pdf\", \"claims_grounding.json\", \"figure_manifest.json\", \"scientific-evidence/verification-report.json\"]),\n    ]\n    for filename, kind, script, inputs in contracts:\n        sidecar = {\"schema_name\": \"scientific-evidence.artifact-manifest\",\n                   \"artifact\": {\"path\": filename, \"kind\": kind,\n                                \"sha256\": hashlib.sha256(Path(filename).read_bytes()).hexdigest()},\n                   \"derived_from\": [\"@evidence\"+\"[[\"+item+\"]]\" for item in inputs],\n                   \"generated_by\": {\"script_path\": script}}\n        Path(filename+\".prov.json\").write_text(json.dumps(sidecar, indent=2)+\"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()\nimport hashlib\nimport importlib.util\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nfrom datetime import datetime, timezone\n\nfrom jsonschema import validate\nfrom pypdf import PdfReader\n\n\ndef digest(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef main():\n    source = Path(\"paper.tex\").read_text()\n    registry = json.loads(Path(\"paper_data.json\").read_text())\n    summary = json.loads(Path(\"derived/summary.json\").read_text())\n    report = {\"checked_at\": datetime.now(timezone.utc).isoformat(), \"checks\": {}, \"pending\": []}\n    checks = report[\"checks\"]\n    claims = json.loads(Path(\"claims_grounding.json\").read_text())[\"claims\"]\n    references = json.loads(Path(\"references_provenance.json\").read_text())\n    validate(references, json.loads(Path(\".codex/skills/retrieve-references/templates/provenance.schema.json\").read_text()))\n    checks[\"reference_provenance_schema\"] = True\n    validate(json.loads(Path(\"figure_manifest.json\").read_text()), json.loads(Path(\".codex/skills/validate-paper/templates/figure_manifest.schema.json\").read_text()))\n    checks[\"figure_manifest_schema\"] = True\n    assert 25 <= references[\"count\"] <= 30\n    checks[\"reference_count\"] = references[\"count\"]\n    identifiers = set(registry[\"grounding_sources\"]) | {item[\"id\"] for item in references[\"references\"]}\n    assert all(set(claim[\"source_ids\"]) <= identifiers for claim in claims)\n    checks[\"grounded_claims\"] = len(claims)\n    selected = \"source_evidence/downstream/program/src/program.py\"\n    baseline = \"source_evidence/downstream/baseline/src/program.py\"\n/usr/local/bin/codex\nautoillustrate-venv\ndrawio\nheadless\nTASK_PYTHON=/workspace/task/.venv/bin/python\nVENV_PY=/opt/autoillustrate-venv/bin/python\nPYTHON_SHA256=c2c4321961fab0fb999d66e0cecf521c2ab3994c7992873ea99e306c1094fd5a\nTMPDIR=/agent-tmp\nWRAPPER_PYTHON=python\nPYTHON_VERSION=3.12.15\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n---\nname: retrieve-references\ndescription: Retrieve grounded BibTeX references from Semantic Scholar Graph API, OpenAlex, or Google Scholar (`scholarly`) and write references.bib plus provenance JSON for paper generation.\n---\n\n# What the skill is about\nFetch references from Semantic Scholar Graph API, OpenAlex, or Google Scholar (via `scholarly`) and keep only real BibTeX entries.\n\n# When to use the skill\n- Final report/paper generation.\n- Related-work section needs grounded citations.\n\n# What to do\n1. Build focused search queries from task goal, method names, and top experiment ideas.\n2. Preferred path (Semantic Scholar Graph API):\n```bash\npython scripts/s2_fetch.py \\\n  --query \"query one\" \\\n  --query \"query two\" \\\n  --min-refs 8 \\\n  --max-refs 15 \\\n  --out-bib references.bib \\\n  --out-json references_provenance.json\n```\n3. Fallback path (OpenAlex):\n```bash\npython scripts/openalex_fetch.py \\\n  --query \"query one\" \\\n  --query \"query two\" \\\n  --min-refs 8 \\\n  --max-refs 15 \\\n  --search-limit 10 \\\n  --out-bib references.bib \\\n  --out-json references_provenance.json\n```\n   Optional:\n   - `--mailto you@example.com` to enter the OpenAlex polite pool\n   - Env fallback: `OPENALEX_EMAIL`\n4. Alternate path (Google Scholar API wrapper with `scholarly`):\n```bash\npython -m pip install scholarly\npython scripts/scholarly_fetch.py \\\n  --query \"query one\" \\\n  --query \"query two\" \\\n  --min-refs 8 \\\n  --max-refs 15 \\\n  --search-limit 25 \\\n  --sort-by relevance \\\n  --proxy-mode auto \\\n  --delay-seconds 0.5 \\\n  --out-bib references.bib \\\n  --out-json references_provenance.json\n```\n   Proxy options:\n   - `--proxy-mode auto|none|free|single`\n   - `--proxy-http <url>` / `--proxy-https <url>` for `single`\n   - Env fallbacks: `SCHOLARLY_PROXY_MODE`, `SCHOLARLY_PROXY_HTTP`, `SCHOLARLY_PROXY_HTTPS`\n   - Global `HTTP_PROXY` / `HTTPS_PROXY` are intentionally ignored to avoid accidental ambient proxying\n5. Require `S2_API_KEY` when available for `s2_fetch.py` (script reads env automatically).\n6. Keep only references with valid BibTeX and citation key.\n7. Dedupe by citation key and paper id.\n8. Fail hard if references found `< min-refs`.\n9. Use `s2_fetch.py` first for stability, `openalex_fetch.py` as the next fallback, and `scholarly_fetch.py` last if the other sources fail.\n\n# Outputs\n- `references.bib`\n- `references_provenance.json`\n\n# Notes\n- Use `templates/provenance.schema.json` for expected shape.\n","exit_code":0,"status":"completed"}}
