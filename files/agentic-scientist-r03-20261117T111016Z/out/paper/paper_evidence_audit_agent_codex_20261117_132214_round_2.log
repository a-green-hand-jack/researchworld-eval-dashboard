{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/evaluate_final.py | sed -n '999,1050p'; jq 'keys' source_evidence/resources/final/manifest.json; jq '.final_evaluation.evaluation_evidence.episodes[0].solution.cases|keys' paper_data.json; cat tables/main_comparison.tex; jq 'keys' references_provenance.json; jq 'keys' derived_results.json\"","aggregated_output":"   999\tdef bootstrap_gain(episodes, outcomes, rows):\n  1000\t    primary = [index for index, episode in enumerate(episodes) if episode['case'] in ['A', 'B'] and not episode['replay']]\n  1001\t    groups = sorted({rows[row]['component'] for index in primary for row in episodes[index]['test']})\n  1002\t    if not groups:\n  1003\t        return -1.0, -1.0\n  1004\t    group_index = {group: index for index, group in enumerate(groups)}\n  1005\t    rng = np.random.default_rng(424242)\n  1006\t    samples = np.zeros((400, 5))\n  1007\t    for resample in range(400):\n  1008\t        multiplicity = np.bincount(rng.integers(len(groups), size=len(groups)), minlength=len(groups))\n  1009\t        for index in primary:\n  1010\t            weights = np.asarray([multiplicity[group_index[rows[row]['component']]] for row in episodes[index]['test']], dtype=float)\n  1011\t            if weights.sum() == 0:\n  1012\t                samples[resample] += -np.ones(5) / len(primary)\n  1013\t            else:\n  1014\t                gain = outcomes[index]['baselines'].mean(axis=2) - outcomes[index]['mae'].mean(axis=1)\n  1015\t                samples[resample] += gain @ weights / weights.sum() / len(primary)\n  1016\t    intervals = np.quantile(samples, [.005, .995], axis=0)\n  1017\t    return float(intervals[0].min()), float(intervals[1].min())\n  1018\t\n  1019\t\n  1020\tdef make_evaluation_evidence(episodes, outcomes, rows, seeds):\n  1021\t    records = []\n  1022\t    for seed in seeds:\n  1023\t        indices = [index for index, episode in enumerate(episodes) if episode['seed']==seed and not episode['replay']]\n  1024\t        scored = [index for index in indices if episodes[index]['case'] in ['A', 'B']]\n  1025\t        solution = {'cases': {}}\n  1026\t        for index in indices:\n  1027\t            outcome, episode = outcomes[index], episodes[index]\n  1028\t            solution['cases'][episode['case']] = {\n  1029\t                'completed': outcome['complete'], 'mae_by_row_checkpoint': outcome['mae'].tolist(),\n  1030\t                'all_unqueried_mae_by_row_checkpoint': outcome['all_unqueried_mae'].tolist(),\n  1031\t                'baseline_mae_by_method_row_checkpoint': outcome['baselines'].tolist(),\n  1032\t                'selected_indices': outcome['queries'],\n  1033\t                'observed_counts': [sum(value is not None for value in rows[row]['values']) for row in episode['test']],\n  1034\t                'resampling_components': [rows[row]['component'] for row in episode['test']]}\n  1035\t        seed_correct = all(outcomes[index]['complete'] for index, episode in enumerate(episodes) if episode['seed']==seed)\n  1036\t        if seed == episodes[0]['seed']:\n  1037\t            original, replay = outcomes[0], outcomes[-1]\n  1038\t            seed_correct = bool(seed_correct and original['queries'] == replay['queries']\n  1039\t                                and original['predictions'] is not None and replay['predictions'] is not None\n  1040\t                                and np.max(np.abs(np.asarray(original['predictions'])-np.asarray(replay['predictions']))) <= 1e-10)\n  1041\t        records.append({'seed': seed, 'score': 1-fixed_average([float(outcomes[index]['mae'].mean()) for index in scored]),\n  1042\t                        'correct': seed_correct,\n  1043\t                        'duration_seconds': sum(outcomes[index]['duration'] for index, episode in enumerate(episodes) if episode['seed']==seed),\n  1044\t                        'solution': solution})\n  1045\t    return {'schema_version': 1, 'episodes': records}\n  1046\t\n  1047\t\n  1048\tdef write_outputs(directory, metrics, correct, feasible, evidence=None):\n  1049\t    directory = pathlib.Path(directory)\n  1050\t    directory.mkdir(parents=True, exist_ok=True)\n[\n  \"allocation\",\n  \"columns\",\n  \"coverage_rule\",\n  \"cross_plane_disjoint\",\n  \"exclusions\",\n  \"license_evidence\",\n  \"limitations\",\n  \"normalization\",\n  \"peer_aliases\",\n  \"peer_document_hashes\",\n  \"peer_families\",\n  \"peer_row_hashes\",\n  \"peer_source_ids\",\n  \"repository\",\n  \"revision\",\n  \"schema_version\",\n  \"source_row_count\"\n]\n[\n  \"A\",\n  \"B\",\n  \"C\",\n  \"D\"\n]\n% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n\n\\begin{tabular}{lrrr}\n\\toprule\nEstimator & Model holdout & Family holdout & Overall \\\\\n\\midrule\nColumn mean & 0.06437 & 0.06411 & 0.06424 \\\\\nQuery mean & 0.23861 & 0.23562 & 0.23711 \\\\\nRandom low-rank & 0.04686 & 0.04933 & 0.04810 \\\\\nVariance low-rank & 0.04479 & 0.04745 & 0.04612 \\\\\nLinear ridge & 0.04512 & 0.04538 & 0.04525 \\\\\nResidual transfer & 0.03831 & 0.04330 & 0.04081 \\\\\n\\bottomrule\n\\end{tabular}\n[\n  \"count\",\n  \"generated_at\",\n  \"queries\",\n  \"references\"\n]\n[\n  \"baseline_gain_bounds\",\n  \"cases\",\n  \"changing_target_mae\",\n  \"methods\",\n  \"primary_mean\",\n  \"primary_seed\",\n  \"primary_seed_sd\",\n  \"relative_reduction\",\n  \"seeds\"\n]\n","exit_code":0,"status":"completed"}}
