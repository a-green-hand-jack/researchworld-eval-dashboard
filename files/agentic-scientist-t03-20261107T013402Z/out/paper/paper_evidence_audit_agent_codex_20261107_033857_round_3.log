{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"jq '.all_programs|map({program_id,program_idx,eval_index,idea_id,combined_score,correct,eligible,evidence_keys:(.evaluation_evidence|keys),seeds:(.evaluation_evidence.episodes|map(.seed))})' paper_data.json; sed -n '98,131p' build_artifacts.py; jq -r '.references[] | [.citation_key,.title,.year,.read_scope] | @tsv' references_provenance.json; cat literature_evidence/Krishna2022.json | head -45\"","aggregated_output":"[\n  {\n    \"program_id\": \"program_1\",\n    \"program_idx\": 1,\n    \"eval_index\": 1,\n    \"idea_id\": \"cycle01_single_call_shap_certificates\",\n    \"combined_score\": 0.9426474742464885,\n    \"correct\": true,\n    \"eligible\": true,\n    \"evidence_keys\": [\n      \"candidate_diagnostics_trust\",\n      \"episode_count\",\n      \"episodes\",\n      \"path\",\n      \"sha256\",\n      \"status\"\n    ],\n    \"seeds\": [\n      1729,\n      2718\n    ]\n  },\n  {\n    \"program_id\": \"program_1\",\n    \"program_idx\": 1,\n    \"eval_index\": 2,\n    \"idea_id\": \"cycle02_exact_leaf_game_shap\",\n    \"combined_score\": 0.9747236091254068,\n    \"correct\": true,\n    \"eligible\": true,\n    \"evidence_keys\": [\n      \"candidate_diagnostics_trust\",\n      \"episode_count\",\n      \"episodes\",\n      \"path\",\n      \"sha256\",\n      \"status\"\n    ],\n    \"seeds\": [\n      1729,\n      2718\n    ]\n  },\n  {\n    \"program_id\": \"program_1\",\n    \"program_idx\": 1,\n    \"eval_index\": 3,\n    \"idea_id\": \"cycle03_logistic_fourier_shap\",\n    \"combined_score\": 0.9977844815380661,\n    \"correct\": true,\n    \"eligible\": true,\n    \"evidence_keys\": [\n      \"candidate_diagnostics_trust\",\n      \"episode_count\",\n      \"episodes\",\n      \"path\",\n      \"sha256\",\n      \"status\"\n    ],\n    \"seeds\": [\n      1729,\n      2718\n    ]\n  }\n]\n    # @evidence[[paper_data.json#/all_programs]]\n    development = []\n    for config_index, config in enumerate(data['all_programs']):\n        for seed, case in selected_cases(config['evaluation_evidence']['episodes']):\n            for cap_index, cap in enumerate(development_caps):\n                development.append({'configuration': config_index, 'seed': seed, 'case': case['case'], 'cap': cap, 'agreement': float(np.asarray(case['cells'])[cap_index, :, :, 0].mean())})\n    summary['development'] = development\n    figure, axes = plt.subplots(1, 2, figsize=(8, 2.65 * PLOT_SCALE), sharey=True)\n    for axis, kind, before, after in zip(axes, ('forest', 'logistic'), (0, 1), (1, 2)):\n        categories = [(dataset + '_' + kind, cap) for dataset in ('german', 'acs') for cap in development_caps]\n        for config_index, offset, color, label in ((before, -.09, '#9b9b9b', 'Without component'), (after, .09, '#176b8c', 'With component')):\n            for category_index, (name, cap) in enumerate(categories):\n                values = [row['agreement'] for row in development if row['configuration'] == config_index and row['case'] == name and row['cap'] == cap]\n                axis.scatter(np.full(len(values), category_index + offset), values, color=color, s=19 * PLOT_SCALE ** 2, label=label if category_index == 0 else None, zorder=3)\n                axis.plot([category_index + offset - .055, category_index + offset + .055], [np.mean(values)] * 2, color=color, linewidth=2 * PLOT_SCALE)\n        axis.set_xticks(range(len(categories)), [name.split('_')[0].replace('german', 'Ger').replace('acs', 'ACS') + '\\n' + str(cap) for name, cap in categories])\n        axis.set_title('Exact forest component' if kind == 'forest' else 'Logistic integration component')\n        axis.set_ylim(.80, 1.01)\n        axis.set_yticks([.8, .9, 1.])\n        axis.grid(axis='y', alpha=.18)\n    axes[0].set_ylabel('Reference agreement')\n    figure.legend(*axes[0].get_legend_handles_labels(), loc='lower center', ncol=2, frameon=False)\n    figure.subplots_adjust(left=.12, right=.985, top=.85, bottom=.28, wspace=.25)\n    save_plot(figure, 'component_comparison', ['@evidence[[paper_data.json#/all_programs]]'])\n    figure, axes = plt.subplots(1, 2, figsize=(8, 2.65 * PLOT_SCALE))\n    for axis, name in zip(axes, ('german_logistic', 'german_forest')):\n        for seed, case in final:\n            if case['case'] != name:\n                continue\n            reference = np.asarray(case['observations']['reference'])\n            estimate = np.asarray(case['observations']['attributions'])[0, 0]\n            half_difference = np.abs(np.asarray(case['observations']['reference_uncertainty'])).sum(axis=-1)\n            observed_distance = np.abs(estimate - reference).sum(axis=-1)\n            axis.scatter(half_difference, observed_distance, alpha=.6, s=12 * PLOT_SCALE ** 2)\nLundberg2017\tA Unified Approach to Interpreting Model Predictions\t2017\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nKrishna2022\tThe Disagreement Problem in Explainable Machine Learning: A Practitioner's Perspective\t2023\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nYuan2022\tAn empirical study of the effect of background data size on the stability of SHapley Additive exPlanations (SHAP) for deep learning models\t2022\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nMusco2024\tProvably Accurate Shapley Value Estimation via Leverage Score Sampling\t2024\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nChen2020\tTrue to the Model or True to the Data?\t2020\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nMarx2020\tPredictive Multiplicity in Classification\t2019\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nNogueira2018\tOn the stability of feature selection algorithms\t2018\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nWebber2010\tA similarity measure for indefinite rankings\t2010\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nDing2021\tRetiring Adult: New Datasets for Fair Machine Learning\t2021\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nGorishniy2021\tRevisiting Deep Learning Models for Tabular Data\t2021\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nLundberg2018\tConsistent Individualized Feature Attribution for Tree Ensembles\t2018\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nOwen1972\tMultilinear Extensions of Games\t1972\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nShapley1953\t17. A Value for n-Person Games\t1953\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nCastro2009\tPolynomial calculation of the Shapley value based on sampling\t2008\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nHoeffding1963\tProbability Inequalities for Sums of Bounded Random Variables\t1963\tPrimary bibliographic record and abstract when available; no references, citing works, related pages, or full-text search accessed.\nMaurer2