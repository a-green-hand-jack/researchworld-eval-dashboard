iction = np.clip(means + factors @ latent, 0, 1)\n        predictions = _apply_residual_correction(base_prediction, observed, _state['scores'], _state['correction'])\n        return {'predictions': predictions.tolist()}\n    raise ValueError('unsupported operation')\ntask/evaluate_final.py:43:class ProtocolFailure(RuntimeError):\ntask/evaluate_final.py:50:class FatalBrokerTransportFailure(RuntimeError):\ntask/evaluate_final.py:56:class InvalidResetResponse(RuntimeError):\ntask/evaluate_final.py:60:def require_reset_ack(response):\ntask/evaluate_final.py:65:class RequiredBaselineFailure(RuntimeError):\ntask/evaluate_final.py:71:def bounded_failure_name(value, fallback):\ntask/evaluate_final.py:75:def describe_episode_failure(error, operation):\ntask/evaluate_final.py:91:def fail_required_baseline(category, cancel_work, record_failure):\ntask/evaluate_final.py:104:def collect_required_baseline(result, *, deadline, clock, cancel_work, record_failure):\ntask/evaluate_final.py:120:def guard_required_baseline(call, failure_category, cancel_work, record_failure):\ntask/evaluate_final.py:133:class BoundedWorkerStderr:\ntask/evaluate_final.py:218:def report_worker_exception(error):\ntask/evaluate_final.py:231:def cpu_limit_seconds(wall_seconds, allowed_threads):\ntask/evaluate_final.py:238:def finite_budget_seconds(value):\ntask/evaluate_final.py:244:def positive_work_seconds(value):\ntask/evaluate_final.py:250:def require_joint_workload_budget(*, search, final):\ntask/evaluate_final.py:267:def reserved_method_deadline(*, now, episode_deadline, methods_remaining, work_seconds, cleanup_seconds):\ntask/evaluate_final.py:279:def until(deadline):\ntask/evaluate_final.py:299:def bounded_json_line(value, wire_limit=WIRE_LIMIT):\ntask/evaluate_final.py:306:def preflight_wire(columns):\ntask/evaluate_final.py:319:def candidate_subprocess_settings(parent_environment):\ntask/evaluate_final.py:340:def isolate():\ntask/evaluate_final.py:430:class CandidateClient:\ntask/evaluate_final.py