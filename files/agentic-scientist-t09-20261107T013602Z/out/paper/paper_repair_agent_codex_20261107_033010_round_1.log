{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"ls -l /home/agent-home/.codex/tmp/arg0/codex-arg0ZRI9eJ/apply_patch; sed -n '1,100p' .codex/skills/validate-paper/scripts/compile_latex.sh; sed -n '1,115p' build_paper_artifacts.py; sed -n '25,60p' map_claims.py; sed -n '1,70p' paper.tex; python - <<'PY'\nimport json\nfrom pathlib import Path\np=json.loads(Path('paper_data.json').read_text())\nprint('Tasks:',p.get('task_names'))\nprint('Downstream:',p.get('downstream_study'))\nprint('Final keys:',list(p['final_evaluation']))\nfor key in ['status','outcome','correct']: print(key,p['grounding_sources']['final.qualification.'+key])\ns=json.loads(Path('paper_strategy.json').read_text()); print('Strategy keys:',list(s)); print('Figure IDs:',[f['figure_id'] for f in s['figure_specs']])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"ls -l /home/agent-home/.codex/tmp/arg0/codex-arg0ZRI9eJ/apply_patch; sed -n '1,100p' .codex/skills/validate-paper/scripts/compile_latex.sh; sed -n '1,115p' build_paper_artifacts.py; sed -n '25,60p' map_claims.py; sed -n '1,70p' paper.tex; python - <<'PY'\nimport json\nfrom pathlib import Path\np=json.loads(Path('paper_data.json').read_text())\nprint('Tasks:',p.get('task_names'))\nprint('Downstream:',p.get('downstream_study'))\nprint('Final keys:',list(p['final_evaluation']))\nfor key in ['status','outcome','correct']: print(key,p['grounding_sources']['final.qualification.'+key])\ns=json.loads(Path('paper_strategy.json').read_text()); print('Strategy keys:',list(s)); print('Figure IDs:',[f['figure_id'] for f in s['figure_specs']])\nPY\"","aggregated_output":"lrwxrwxrwx 1 agent agent 121 Nov  7 04:19 /home/agent-home/.codex/tmp/arg0/codex-arg0ZRI9eJ/apply_patch -> /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\nimport csv\nimport hashlib\nimport json\nimport shutil\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom PIL import Image, ImageDraw\n\n\nFAMILIES = ['SBM', 'BA', 'WS', 'Stanford3']\nCONDITIONS = ['No spill', 'Weak linear', 'Strong linear', 'Threshold', 'Two-hop', 'Cluster']\nMETHODS = ['Endpoint-tuned', 'Difference in means', 'Own-treatment OLS', 'One-hop OLS']\nBASELINE_KEYS = ['difference_in_means', 'own_treatment_ols', 'one_hop_ols']\nBOOTSTRAP_SEED = 20261107\nRESAMPLES = 10000\nCOLORS = ['#007c83', '#b75824', '#8665ad', '#31599a']\n\n\ndef provenance(path, inputs, kind='derived', notes=None):\n    manifest = {'schema_name': 'scientific-evidence.artifact-manifest',\n        'artifact': {'path': str(path), 'kind': kind,\n                     'sha256': hashlib.sha256(Path(path).read_bytes()).hexdigest()},\n        'derived_from': ['@' + 'evidence[[' + source + ']]' for source in inputs],\n        'generated_by': {'script_path': 'build_paper_artifacts.py',\n                         'command': ['python', 'build_paper_artifacts.py']}}\n    if notes:\n        manifest['notes'] = notes\n    Path(str(path) + '.prov.json').write_text(json.dumps(manifest, indent=2))\n\n\ndef interval(values):\n    return np.quantile(values, [.025, .975], axis=0).tolist()\n\n\ndef save_figure(figure, name):\n    for extension in ['pdf', 'png']:\n        target = Path('figures') / (name + '.' + extension)\n        figure.savefig(target, dpi=300, facecolor='white')\n        provenance(target, ['paper_data.json#/final_evaluation/evaluation_evidence/episodes',\n                            'analysis/summary.json', 'build_paper_artifacts.py'], 'figure')\n    plt.close(figure)\n\n\ndef main():\n    Path('analysis').mkdir(exist_ok=True)\n    Path('source_evidence').mkdir(exist_ok=True)\n    source_dir = Path('results/ideas/03_endpoint_contrast_sure_for_exposure_regression/program_1')\n    copies = {'estimator.py': source_dir / 'src/program.py',\n              'program_spec.toml': source_dir / 'program_spec.toml',\n              'evaluate_final.py': Path('task/evaluate_final.py'),\n              'benchmark_manifest.json': Path('task/resources/final/manifest.json'),\n              'requirements.txt': Path('task/requirements.txt'),\n              'final_manifest.json': Path('../final_evaluation/final_manifest.json'),\n              'task_contract.json': Path('task/task_contract.json'),\n              'missing_comparison_failure.json': Path('results/ideas/02_nonbacktracking_two_hop_regression_with_invariant_gcv/program_1/evaluation_failure.json'),\n              'missing_comparison_stderr.log': Path('results/ideas/02_nonbacktracking_two_hop_regression_with_invariant_gcv/program_1/harness_evaluate_stderr.log')}\n    for destination, origin in copies.items():\n        target = Path('source_evidence') / destination\n        shutil.copyfile(origin, target)\n        context = 'paper_data.json#/best_correct' if origin.is_relative_to(source_dir) else 'paper_data.json'\n        provenance(target, [context], 'source', notes='Raw source snapshot copied byte-for-byte from ' +\n                   str(origin) + '. Registry link supplies run context, not substantive proof of source contents or executable identity.')\n    # @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    data = json.loads(Path('paper_data.json').read_text())\n    episodes = data['final_evaluation']['evaluation_evidence']['episodes']\n    seeds = [episode['seed'] for episode in episodes]\n    errors = np.full((len(seeds), len(FAMILIES), len(CONDITIONS), len(METHODS)), np.nan)\n    fit = np.full(errors.shape[:-1], np.nan)\n    support = {}\n    records = []\n    for seed_index, episode in enumerate(episodes):\n        for case in episode['solution']['cases']:\n            if case['kind'] != 'scientific':\n                continue\n            assert case['completed']\n            family_index = FAMILIES.index(case['family'])\n            condition_index = case['mechanism']\n            measured = case['validated']\n            assert not measured['clipped']\n            error_vector = [measured['uncapped_error']] + [\n                measured['baseline_estimates'][name] - measured['true_gate'] for name in BASELINE_KEYS]\n            errors[seed_index, family_index, condition_index] = error_vector\n            fit[seed_index, family_index, condition_index] = measured['observed_fit_rmse']\n            for method, error in zip(METHODS, error_vector):\n                records.append({'seed': episode['seed'], 'family': case['family'],\n                    'condition': CONDITIONS[condition_index], 'method': method,\n                    'true_gate': measured['true_gate'], 'error': error,\n                    'observed_fit_rmse': measured['observed_fit_rmse']})\n            support.setdefault((case['family'], condition_index), []).append(measured['exposure_support'])\n    assert np.isfinite(errors).all()\n    with Path('analysis/observations.csv').open('w') as output:\n        writer = csv.DictWriter(output, fieldnames=records[0].keys())\n        writer.writeheader()\n        writer.writerows(records)\n    provenance('analysis/observations.csv', ['paper_data.json#/final_evaluation/evaluation_evidence/episodes'])\n    # @evidence[[analysis/observations.csv]]\n    cell_rmse = np.sqrt(np.mean(errors ** 2, axis=0))\n    cell_bias = np.mean(errors, axis=0)\n    generator = np.random.default_rng(BOOTSTRAP_SEED)\n    indices = generator.integers(0, len(seeds), size=(RESAMPLES, len(seeds)))\n    bootstrap_rmse = np.sqrt(np.mean(errors[indices] ** 2, axis=1))\n    bootstrap_bias = np.abs(np.mean(errors[indices], axis=1))\n    overall_rmse = cell_rmse.mean(axis=(0, 1))\n    overall_abias = np.abs(cell_bias).mean(axis=(0, 1))\n    bootstrap_overall = bootstrap_rmse.mean(axis=(1, 2))\n    ratios = cell_rmse[..., 0, None] / cell_rmse[..., 1:]\n    bootstrap_ratios = bootstrap_rmse[..., 0, None] / bootstrap_rmse[..., 1:]\n    difference = overall_rmse[0] - overall_rmse[3]\n    bootstrap_difference = bootstrap_overall[:, 0] - bootstrap_overall[:, 3]\n    summary = {'seeds': seeds, 'seed_count': len(seeds), 'scientific_count': int(fit.size),\n        'bootstrap': {'seed': BOOTSTRAP_SEED, 'resamples': RESAMPLES,\n        values['absolute_bias_ci'] = [bound[method_index] for bound in summary['absolute_bias_ci']]\n        add(method + ' equal-cell summaries: ' + json.dumps(values),\n            evidence_refs=['analysis/summary.json#/rmse', 'analysis/summary.json#/absolute_bias',\n                           'analysis/summary.json#/rmse_ci', 'analysis/summary.json#/absolute_bias_ci'])\n    add('Endpoint-tuned minus one-hop OLS mean cell RMSE is ' + str(summary['endpoint_minus_onehop_rmse']) +\n        ' with 95% paired seed-block interval ' + str(summary['endpoint_minus_onehop_rmse_ci']) +\n        '; endpoint-tuned point RMSE is lower in only three of 24 cells, without multiplicity-adjusted win claims.',\n        evidence_refs=['analysis/summary.json#/endpoint_minus_onehop_rmse',\n                       'analysis/summary.json#/favorable_cells_vs_onehop'])\n    for family_index, family in enumerate(summary['families']):\n        for condition_index, condition in enumerate(summary['conditions']):\n            values = dict(zip(summary['methods'], summary['cell_rmse'][family_index][condition_index]))\n            values['endpoint_signed_bias'] = summary['cell_signed_bias'][family_index][condition_index][0]\n            values['mean_observed_fit_rmse'] = summary['mean_fit_rmse'][family_index][condition_index]\n            add(family + ', ' + condition + ': ' + json.dumps(values),\n                evidence_refs=['analysis/summary.json#/cell_rmse', 'analysis/summary.json#/cell_signed_bias',\n                               'analysis/summary.json#/mean_fit_rmse'])\n    add('Observed-assignment fitted residual RMSE spans ' + str(summary['fit_rmse_range']) +\n        ', near unit noise, while threshold and two-hop endpoint errors are substantial; this is descriptive, not causal.',\n        evidence_refs=['analysis/summary.json#/fit_rmse_range', 'analysis/observations.csv'])\n    for family in summary['families']:\n        for condition in [2, 5]:\n            support = summary['support'][family + ':' + str(condition)]\n            add(family + ' ' + summary['conditions'][condition] + ' seed-mean exposure support: ' +\n                json.dumps({field: values['mean'] for field, values in support.items()}),\n                evidence_refs=['analysis/summary.json#/support'])\n    add('Ratio plots divide cell RMSEs and bootstrap complete seed blocks. The resampling uses 10000 draws, seed 20261107, and 95% percentile intervals. Intervals quantify fixed-benchmark Monte Carlo variation, not causal coverage or graph-population generalization.',\n        evidence_refs=['analysis/summary.json#/bootstrap', 'build_paper_artifacts.py'])\n    add('The benchmark uses 4096-node synthetic SBM, BA and WS graphs, and fixed Stanford3 with 11586 nodes and 568309 undirected edges. SBM uses four blocks with probabilities .04/.002; BA attachment is five; WS neighborhood is ten with rewiring .15. Covariates have one column. Synthetic topologies vary by seed and Stanford3 topology does not.',\n        evidence_refs=['source_evidence/benchmark_manifest.json#/generator',\n                       'source_evidence/benchmark_manifest.json#/records',\n                       'reproducibility/resources/final/benchmark.npz'])\n    add('The outcome model is .5*x + z + spillover + unit Gaussian noise. Six spillovers are 0, .25*e, 2*e, 2*I(e>=.75)+z*e, 2*h, and 2*e under cluster assignment. Recorded GATEs are respectively 1, 1.25, 3, 4, 3, 3. Two-hop exposure includes backtracking; isolates have zero exposure.',\n        evidence_refs=['source_evidence/evaluate_final.py#L676-L694',\n                       'source_evidence/benchmark_manifest.json#/mechanisms',\n                       'paper_data.json#/final_evaluation/evaluation_evidence/episodes'])\n\\documentclass{article}\n% --- watermark (auto-inserted) ---\n\\usepackage{xcolor}\n\\usepackage{xfp}% \\fpeval; in the kernel since 2022, harmless on older LaTeX\n\\usepackage{draftwatermark}\n\\newlength{\\watermarkTextWidth}\n\\AddToHook{begindocument/end}{%\n  \\SetWatermarkText{\\normalfont Generated by The Agentic Scientist}%\n  \\SetWatermarkFontSize{10pt}%\n  \\SetWatermarkLightness{0.85}%\n  \\settowidth{\\watermarkTextWidth}{\\normalfont\\fontsize{10pt}{12pt}\\selectfont Generated by The Agentic Scientist}%\n  \\edef\\watermarkScale{\\fpeval{0.8 * sqrt(\\paperwidth**2 + \\paperheight**2) / \\watermarkTextWidth}}%\n  \\edef\\watermarkAngle{\\fpeval{atand(\\paperheight/\\paperwidth)}}%\n  \\SetWatermarkScale{\\watermarkScale}%\n  \\SetWatermarkAngle{\\watermarkAngle}%\n}\n% --- end watermark ---\n\\usepackage{source_evidence/iclr2026_conference,times}\n\\usepackage[T1]{fontenc}\n\\usepackage[utf8]{inputenc}\n\\usepackage{amsmath,amssymb,booktabs,graphicx,subcaption}\n\\usepackage{hyperref,url}\n\\newcommand{\\gate}{\\tau}\n\\newcommand{\\R}{\\mathbb{R}}\n\\title{Endpoint-Tuned Regression under Network Interference: Accuracy and Limits}\n\\author{}\n\\begin{document}\n\\maketitle\n\n\\begin{abstract}\nRegression can estimate the effect of treating an entire network by predicting outcomes under all-treated and all-control assignments. However, fitting observed outcomes and estimating this intervention contrast are different statistical objectives. We study a one-hop exposure regression that tunes ridge regularization using an endpoint-contrast risk criterion, comparing it with difference in means, own-treatment regression, and linear one-hop regression. A fixed evaluation comprises 24 seed blocks, four network families, and six interference/design conditions, including synthetic outcomes on Stanford3. The endpoint-tuned estimator has mean cell RMSE 0.614, compared with 1.368 for difference in means but 0.460 for one-hop ordinary least squares. The paired RMSE disadvantage relative to one-hop regression is 0.154, with a 95\\% seed-block bootstrap interval of [0.127, 0.179]. Threshold and omitted two-hop spillovers produce substantial endpoint errors despite near-unit observed-fit residuals. These results support a conditional accuracy study, not superiority of target-aware tuning: regression specification, assignment design, and the distinction between observed support and endpoint prediction remain consequential limitations.\n% @evidence[[analysis/summary.json]] @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n\\end{abstract}\n\n\\section{Introduction}\nRandomized experiments on connected populations have an estimand problem as well as an estimation problem. An individual assigned to control can still be affected by treated neighbors. Consequently, a contrast between the observed treatment arms need not estimate what a platform would obtain by treating everyone rather than no one. Potential-outcome formulations make the intervention explicit \\citep{Neyman1990,Rubin1974}; under interference, the outcome must depend on a vector of assignments rather than only the individual's assignment \\citep{Hudgens2008,Manski2013}. Network experimentation at scale makes this distinction practically relevant \\citep{Karrer2021}.\n\nA natural response is to regress outcomes on treatment, covariates, and summaries of neighbors' assignments, and evaluate the fitted function at the two global interventions \\citep{Chin2019}. This approach separates observed experimental data from the intervention of interest, but introduces a delicate extrapolation problem. A model can predict outcomes accurately near the observed treatment saturation while predicting the difference between saturation extremes poorly. Conversely, restricting a regression to a correctly specified low-dimensional exposure model can be more effective than adding flexible terms and regularization. Model complexity is not automatically useful for the target contrast.\n\nWe examine whether tuning regularization toward the endpoint contrast is sufficient to make a richer one-hop regression competitive. The estimator uses a quadratic exposure reference and a finite ridge grid. Its risk criterion is motivated by a fixed-design linear-model calculation, not by a general identification result. The comparison is deliberately anchored to meaningful simple alternatives: difference in means, covariate-adjusted own-treatment regression, and linear one-hop ordinary least squares (OLS). The scientific question is how their errors change across network structures, interference mechanisms, and assignment designs, rather than whether a single aggregate evaluation measure is high.\n\nThe evidence yields a negative answer to general superiority. Across the fixed benchmark, endpoint tuning substantially reduces aggregate error relative to assignment-only analysis but loses to linear one-hop OLS. The latter comparison is essential: a gain over a baseline that omits spillovers is not evidence that a more elaborate exposure regression is preferable. Threshold and two-hop conditions also show that small residuals on observed assignments do not certify accurate global intervention prediction.\n\nOur contributions are a concrete endpoint-functional tuning construction, a matched comparison across the complete recorded condition matrix, and an analysis of its observed limitations. We report Monte Carlo uncertainty at the seed-block level and distinguish it from causal confidence-interval coverage. Because feature expansion and tuning are not separately ablated, the results compare complete estimators; they do not attribute error differences to the tuning objective alone. Figure~\\ref{fig:overview} summarizes the distinction that organizes the study.\n\n\\begin{figure}[t]\n\\centering\n\\includegraphics[width=.98\\textwidth]{figures/endpoint_overview.png}\n\\caption{The target is an intervention contrast, not observed prediction error. A graph, covariates, observed assignment, and observed outcomes determine the fitted regression. All-treated and all-control assignments are separate prediction inputs; their outcomes are withheld from fitting. Algebraic estimability of the fitted contrast does not establish exposure support or robustness to misspecification.}\n\\label{fig:overview}\n\\end{figure}\n\n\\section{Related Work}\n\\paragraph{Interference and experimental design.}\n\\citet{Aronow2017} distinguish the assignment design, exposure mapping, and causal estimand in a randomization-based framework. Graph cluster randomization changes exposure probabilities and can improve design-based estimation under suitable exposure assumptions \\citep{Ugander2013}. Design and analysis can both reduce interference bias without eliminating the dependence on modeling assumptions \\citep{Eckles2017}. Staggered rollout provides another route under low-order interaction assumptions without requiring the graph \\citep{Cortez2022}. These are distinct designs and inferential targets; our static assignment comparisons do not evaluate their complete estimators or variance guarantees.\n\n\\paragraph{Regression adjustment.}\nGlobal intervention prediction from regression is established by \\citet{Chin2019}. Graph- and treatment-based covariate generation and selection, together with block-bootstrap inference, are studied by \\citet{Han2023}. We do not introduce regression adjustment for interference or compare against that full covariate-selection procedure. Instead, we evaluate a small, explicitly specified one-hop reference. The broader regression-adjustment literature cautions against treating model fitting as automatically beneficial \\citep{Freedman2008}; favorable asymptotic results require attention to interactions and variance estimation \\citep{Lin2013}. Those results under individualistic response cannot be transferred directly to the present endpoint-extrapolation setting.\n\n\\paragraph{Regularization and assessment.}\nRidge regression addresses unstable estimation with correlated predictors \\citep{Hoerl1970}. Generalized cross-validation targets prediction through a rotation-invariant criterion \\citep{Golub1979}. Unbiased risk estimation motivates target-specific assessment \\citep{Stein1981}, but apparent error can be optimistic when the same data are used for fitting and evaluation \\citep{Efron1986}. We distinguish a fixed-penalty identity from the selected minimum. Estimable linear functions are a linear-algebraic notion \\citep{Searle1965}; neither estimability nor heteroskedasticity-consistent variance estimation \\citep{White1980} alone addresses a missing spillover mechanism. Our bootstrap summarizes repeated experimental realizations \\citep{Efron1979}, not unmeasured inferential coverage. Finally, the graph families represent block structure \\citep{Choi2012}, preferential attachment \\citep{Barabasi1999}, small-world structure \\citep{Watts1998}, and a public social-network topology \\citep{Traud2012,Rossi2015}; they are not a random sample of online platforms.\n\n\\section{Method}\n\\subsection{Problem Setup and Design Rationale}\nFor an undirected graph with adjacency matrix $A$, let $d_i=\\sum_j A_{ij}$ and define the one-hop exposure and length-two exposure by\n\\begin{equation}\ne_i(z)=\\frac{\\sum_j A_{ij}z_j}{\\max(d_i,1)},\\qquad\nh_i(z)=\\frac{\\sum_j A_{ij}e_j(z)}{\\max(d_i,1)}.\n\\label{eq:exposure}\n\\end{equation}\nTasks: None\nDownstream: None\nFinal keys: ['correct', 'evaluation_evidence', 'evaluator_sha256', 'manifest_path', 'metrics', 'outcome', 'program_tree_sha256', 'results_tree_sha256', 'status', 'task_tree_sha256']\nstatus {'evaluation_scope': 'sealed_final', 'id': 'final.qualification.status', 'manifest_path': 'work/results/t09/codex/20261107_014043/final_evaluation/final_manifest.json', 'program_tree_sha256': 'sha256:37121e22c23552d3c9168e22661f12879935b238b6838ce94dc038a7eaa15e72', 'results_tree_sha256': 'sha256:3c3bcb43740a1d90e9761ad07a965974af2ceb71ec65e586784027ba8e9f049a', 'type': 'final_qualification', 'value': 'completed'}\noutcome {'evaluation_scope': 'sealed_final', 'id': 'final.qualification.outcome', 'manifest_path': 'work/results/t09/codex/20261107_014043/final_evaluation/final_manifest.json', 'program_tree_sha256': 'sha256:37121e22c23552d3c9168e22661f12879935b238b6838ce94dc038a7eaa15e72', 'results_tree_sha256': 'sha256:3c3bcb43740a1d90e9761ad07a965974af2ceb71ec65e586784027ba8e9f049a', 'type': 'final_qualification', 'value': 'qualified'}\ncorrect {'evaluation_scope': 'sealed_final', 'id': 'final.qualification.correct', 'manifest_path': 'work/results/t09/codex/20261107_014043/final_evaluation/final_manifest.json', 'program_tree_sha256': 'sha256:37121e22c23552d3c9168e22661f12879935b238b6838ce94dc038a7eaa15e72', 'results_tree_sha256': 'sha256:3c3bcb43740a1d90e9761ad07a965974af2ceb71ec65e586784027ba8e9f049a', 'type': 'final_qualification', 'value': True}\nStr