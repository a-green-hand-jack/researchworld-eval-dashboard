json\nfrom PIL import Image\nimport jsonschema\nmanifest=json.loads(Path('figure_manifest.json').read_text())\nstrategy=json.loads(Path('paper_strategy.json').read_text())\nschema=json.loads(Path('.codex/skills/validate-paper/templates/figure_manifest.schema.json').read_text())\njsonschema.validate(manifest,schema)\nspecs={spec['figure_id']:spec for spec in strategy['figure_specs']}\nfor entry in manifest['figures']:\n spec=specs[entry['figure_id']]\n assert entry['figure_type']==spec['figure_type']\n assert entry['n_panels']<=spec['max_panels']\n assert max(entry['categories_per_panel'])<=spec['max_categories_per_panel']\n assert max(entry['series_per_panel'])<=spec['max_series_per_panel']\n image=Image.open(entry['path_png'])\n print(entry['figure_id'],entry['figure_type'],image.size)\n if entry['generator']=='matplotlib':\n  assert image.width>=2400 and image.height>=700\nunchanged=json.loads(Path('/tmp/paper-repair-unchanged.json').read_text())\nfor name,digest in unchanged.items():\n assert hashlib.sha256(Path(name).read_bytes()).hexdigest()==digest,name\nprint('Schema, strategy types, density budgets and PNG resolution pass; manuscript, claims, references, evidence registry and concept assets unchanged.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
