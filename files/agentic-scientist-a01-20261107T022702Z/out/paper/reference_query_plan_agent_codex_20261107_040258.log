{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"find task/resources -maxdepth 4 -type f -print; sed -n '520,555p' task/evaluate_final.py; sed -n '1,75p' source_evidence/downstream/program/src/program.py; python - <<'PY'\nimport json\nfrom pathlib import Path\nobj=json.loads(Path('paper_data.json').read_text())\nfor ep in obj['final_evaluation']['evaluation_evidence']['episodes']:\n for case in ep['solution']['cases']:\n  if case['case']\"'!='\"'original':continue\n  grouped={}\n  for obs in case['observations']:\n   grouped.setdefault((obs['target'],obs['fraction']),{})[obs['rule']]=obs\n  relations={'mean_less':0,'median_less':0,'equal':0,'infeasible_pair':0}\n  examples={}\n  for key,rules in grouped.items():\n   if not all(rules[r]['allocation']['status']=='feasible' for r in ['mean','median']):\n    relations['infeasible_pair']+=1;continue\n   mean=len(rules['mean']['allocation']['tasks']);median=len(rules['median']['allocation']['tasks'])\n   relation='mean_less' if mean<median else 'median_less' if median<mean else 'equal'\n   relations[relation]+=1; examples.setdefault(relation,(key,mean,median))\n  print('PAIRED',ep['seed'],case['family'],relations,examples)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
