{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"command -v codex; ls /opt; sed -n '1,90p' .codex/skills/validate-paper/scripts/compile_latex.sh; sed -n '1,65p' .codex/skills/memory-log/scripts/append_memory.py; sed -n '1,65p' audit_writing.py; sed -n '1,60p' .codex/skills/validate-paper/scripts/validate_tex_refs.py; cat .codex/skills/validate-paper/scripts/validate_figures.py\"","aggregated_output":"/usr/local/bin/codex\nautoillustrate-venv\ndrawio\nheadless\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\nimport hashlib\nimport json\nimport re\nfrom pathlib import Path\n\nimport jsonschema\nfrom src.orchestrator.paper_step import find_reference_start_page, find_supplement_start_page, measure_last_body_page_fill_ratio, read_pdf_page_texts, validate_figure_manifest\n\n\ndef digest_tree(root):\n    hasher = hashlib.sha256()\n    for path in sorted(root.rglob('*'), key=lambda path: path.relative_to(root).as_posix()):\n        if path.is_symlink():\n            raise RuntimeError('Unexpected symlink in evaluated tree')\n        relative = path.relative_to(root).as_posix().encode()\n        if path.is_dir():\n            hasher.update(b'dir\\0' + relative + b'\\0')\n        else:\n            content = path.read_bytes()\n            hasher.update(b'file\\0' + relative + b'\\0' + str(len(content)).encode() + b'\\0' + content)\n    return 'sha256:' + hasher.hexdigest()\n\n\ndef check_locator(reference):\n    target, separator, locator = reference.partition('#')\n    path = Path(target)\n    if not path.is_file():\n        raise RuntimeError('Missing target: ' + reference)\n    if locator.startswith('/') and path.suffix == '.json':\n        value = json.loads(path.read_text())\n        for segment in locator[1:].split('/'):\n            segment = segment.replace('~1', '/').replace('~0', '~')\n            value = value[int(segment)] if isinstance(value, list) else value[segment]\n    elif locator.startswith('L'):\n        match = re.fullmatch(r'L(\\d+)(?:-L(\\d+))?', locator)\n        if match:\n            start = int(match[1])\n            end = int(match[2] or match[1])\n            if not 1 <= start <= end <= len(path.read_text().splitlines()):\n                raise RuntimeError('Invalid source line range: ' + reference)\n\n\ndef main():\n    # @evidence[[paper_data.json]]\n    # @evidence[[paper.tex]]\n    data = json.loads(Path('paper_data.json').read_text())\n    claims = json.loads(Path('claims_grounding.json').read_text())\n    tex = Path('paper.tex').read_text()\n    refs = set()\n    owned = [Path('paper.tex'), Path('build_artifacts.py'), Path('build_claims.py')] + list(Path('tables').glob('*.tex'))\n    for file in owned:\n        refs.update(re.findall(r'@evidence\\[\\[([^\\]]+)\\]\\]', file.read_text()))\n    for claim in claims['claims']:\n        refs.update(claim['evidence_refs'])\n    for reference in refs:\n        check_locator(reference)\n    for table in Path('tables').glob('*_rows.tex'):\n        for row in table.read_text().splitlines():\n            if row and not row.startswith('%') and row not in tex:\n                raise RuntimeError('Stale embedded table row: ' + row)\n    root = next(Path('results/ideas').glob('03*/program_1')).resolve()\n    digest = digest_tree(root)\n    expected = data['final_evaluation']['program_tree_sha256']\n    if digest != expected:\n        raise RuntimeError('Retained selected source does not match evaluated tree')\n#!/usr/bin/env python3\n\"\"\"Validate that paper citations align with bibliography entries.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport re\nfrom pathlib import Path\n\nSECTION_PATTERNS = {\n    \"abstract\": re.compile(\n        r\"\\\\begin\\{abstract\\}|\\\\section\\*?\\{[^}]*abstract[^}]*\\}\",\n        re.IGNORECASE,\n    ),\n    \"introduction\": re.compile(r\"\\\\section\\*?\\{[^}]*introduction[^}]*\\}\", re.IGNORECASE),\n    \"related work\": re.compile(r\"\\\\section\\*?\\{[^}]*related work[^}]*\\}\", re.IGNORECASE),\n    \"method\": re.compile(r\"\\\\section\\*?\\{[^}]*method[^}]*\\}\", re.IGNORECASE),\n    \"results\": re.compile(r\"\\\\section\\*?\\{[^}]*results[^}]*\\}\", re.IGNORECASE),\n    \"conclusion\": re.compile(r\"\\\\section\\*?\\{[^}]*conclusion[^}]*\\}\", re.IGNORECASE),\n    \"references\": re.compile(\n        r\"\\\\bibliography\\{|\\\\printbibliography|\\\\begin\\{thebibliography\\}|\\\\section\\*?\\{[^}]*references[^}]*\\}\",\n        re.IGNORECASE,\n    ),\n}\nCITE_RE = re.compile(r\"\\\\cite[a-zA-Z*]*\\{([^}]+)\\}\")\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nSUPPLEMENT_HEADING_RE = re.compile(\n    r\"\\\\section\\s*\\{\\s*supplementary\\s+information\\s*\\}\",\n    re.IGNORECASE,\n)\nBIBLIOGRAPHY_RE = re.compile(\n    r\"\\\\bibliography\\s*\\{[^}]+\\}|\\\\printbibliography\\b(?:\\[[^\\]]*\\])?\"\n    r\"|\\\\begin\\s*\\{thebibliography\\}\",\n    re.IGNORECASE,\n)\nCLEARPAGE_RE = re.compile(r\"\\\\clearpage\\b\", re.IGNORECASE)\nNEXT_SECTION_RE = re.compile(r\"\\\\section\\*?\\s*(?:\\[[^\\[\\]]*\\]\\s*)?\\{\")\nLET_SECTION_ALIAS_RE = re.compile(\n    r\"\\\\let\\s*\\\\[a-zA-Z@]+\\s*=?\\s*\\\\section\\b\", re.IGNORECASE\n)\nNEWCOMMAND_DEFINITION_RE = re.compile(\n    r\"\\\\(?:newcommand|renewcommand)\\*?\\s*\\{\", re.IGNORECASE\n)\nDEF_DEFINITION_RE = re.compile(\n    r\"\\\\(?:def|gdef|edef|xdef)\\s*\\\\[a-zA-Z@]+\", re.IGNORECASE\n)\nTEX_IMPORT_RE = re.compile(r\"\\\\(?:input|include)\\b\", re.IGNORECASE)\nSUBSTANTIVE_SUPPLEMENT_RE = re.compile(\n    r\"\\\\subsection\\*?\\s*\\{|\\\\begin\\s*\\{(?:table|figure)\\*?\\}\",\n    re.IGNORECASE,\n)\nSUPPLEMENT_PLACEHOLDER_TEXTS = (\n    \"add supplementary material only when grounded artifacts support it\",\n    \"replace with grounded extended methods, reproducibility details, additional analyses, or supporting tables and figures\",\n)\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\[a-zA-Z@]+\")\nNEWIF_RE = re.compile(r\"\\\\newif\\s*(?P<name>\\\\if[a-zA-Z@]+)\")\nCONDITIONAL_OPENERS = frozenset(\n    {\n        r\"\\if\",\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
