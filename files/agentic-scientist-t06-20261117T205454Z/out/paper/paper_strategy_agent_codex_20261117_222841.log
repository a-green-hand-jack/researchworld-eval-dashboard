sum('ij,j->i', inverse_hessian, removed_gradient + budget * regularization * theta, optimize=False) / (total_rows - budget)\n203:        kept = {record['contender'] for record in sorted(screen_records, key=lambda record: record['score'], reverse=True)[:6]}\n211:    shortlist = shortlist_contenders(screen_records, incumbent_contender, runner_up, limit=6)\n212:    frozen_selections = [selection_cache[contender] for contender in shortlist]\n260:def handle(request):\n272:        if type(index) is not int or not 0 <= index < math.ceil(len(STATE['output']) / CHUNK):\n274:        return {'data': base64.b64encode(STATE['output'][index*CHUNK:(index+1)*CHUNK]).decode('ascii')}\n277:        if not (type(count) is int and 1 <= count <= 100000 and type(players) is int and 2 <= players <= 256):\n279:        if (request['dtype'], request['shape'], request['encoding'], request['byte_order'],request['nbytes']) != ('<f8',[count,4],'base64','little',count*32):\n290:        chunk = base64.b64decode(request['data'], validate=True)\n291:        if len(chunk)>CHUNK or len(STATE['staging'])+len(chunk)>STATE['metadata']['nbytes']:\n298:        if len(STATE['staging']) != metadata['nbytes'] or STATE['next_chunk'] != metadata['chunks']:\n312:        budgets = [int(fraction * len(rows)) for fraction in fractions]\n316:        if len(output)>64*1024*1024:\n319:        STATE['token'] = hashlib.sha256(output).hexdigest()\n322:        return {'token':STATE['token'],'nbytes':len(STATE['output']),'chunks':math.ceil(len(STATE['output'])/CHUNK),\n323:                'encoding':'base64','dtype':'json','shape':[],'byte_order':'none'}\n","exit_code":1,"status":"failed"}}
