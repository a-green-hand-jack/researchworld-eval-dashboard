\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Final reference agreement by dataset, classifier, and coalition cap. Dots show the three fitted-condition seeds; lines connect cap-wise means, not a temporal trajectory. German references average two high-cap estimates; ACS references are exhaustive. The common zero-to-one scale makes the severe split-cap German failure visible; Table~\ref {tab:main} resolves near-ceiling differences.}}{6}{figure.caption.12}\protected@file@percent }
\newlabel{fig:final}{{2}{6}{Final reference agreement by dataset, classifier, and coalition cap. Dots show the three fitted-condition seeds; lines connect cap-wise means, not a temporal trajectory. German references average two high-cap estimates; ACS references are exhaustive. The common zero-to-one scale makes the severe split-cap German failure visible; Table~\ref {tab:main} resolves near-ceiling differences}{figure.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Final cap-64 mean reference agreement and structure-aware reference sign agreement, averaged over seeds. The top-three reference overlap is 1 throughout for the structure-aware computation. Values rounded to 1.0000 are not claims of exact real-arithmetic equality.}}{6}{table.caption.13}\protected@file@percent }
\newlabel{tab:main}{{1}{6}{Final cap-64 mean reference agreement and structure-aware reference sign agreement, averaged over seeds. The top-three reference overlap is 1 throughout for the structure-aware computation. Values rounded to 1.0000 are not claims of exact real-arithmetic equality}{table.caption.13}{}}
