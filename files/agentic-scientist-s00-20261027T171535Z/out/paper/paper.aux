\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Family-macro log MAE on the sealed held-out graphs (lower is better). The ridge predictor is compared with the $2m(n-1)$ bound, a constant predictor equal to the training geometric mean, and the ridge predictions scored against shuffled targets. Each bar is one evaluator-computed value; no error bars are shown because no uncertainty over graph draws was computed.}}{6}{figure.caption.19}\protected@file@percent }
\newlabel{fig:main}{{3}{6}{Family-macro log MAE on the sealed held-out graphs (lower is better). The ridge predictor is compared with the $2m(n-1)$ bound, a constant predictor equal to the training geometric mean, and the ridge predictions scored against shuffled targets. Each bar is one evaluator-computed value; no error bars are shown because no uncertainty over graph draws was computed}{figure.caption.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Sealed-evaluation results. ``Factor'' is $\exp $ of the family-macro log MAE and ``Ratio'' is the log MAE divided by that of the ridge predictor; both are arithmetic conversions of the reported values.}}{6}{table.caption.20}\protected@file@percent }
