dict.fromkeys(affected_checkpoints):\n   343\t            cache_key = tuple(sorted(path[:budget]))\n   344\t            if cache_key not in prefix_theta_cache:\n   345\t                if exact_refit_count >= exact_refit_cap:\n   346\t                    raise _PathSearchExhausted(\"exact-refit cap\")\n   347\t                if deadline is not None and time.monotonic() >= deadline:\n   348\t                    raise _PathSearchExhausted(\"optional-search deadline\")\n   349\t                prefix_theta_cache[cache_key] = refit_flip_prefix(baseline_rows, path[:budget], ridge=ridge)\n   350\t                exact_refit_count += 1\n   351\t            fitted_theta = prefix_theta_cache[cache_key]\n   352\t            if not np.isfinite(fitted_theta).all():\n   353\t                raise ValueError(\"nonfinite prefix fit\")\n   354\t            if cache_key not in prefix_quality_cache:\n   355\t                prefix_quality_cache[cache_key] = quality(fitted_theta)\n   356\t            checkpoint_scores[budget] = prefix_quality_cache[cache_key]\n   357\t        complete_value = np.sum([checkpoint_scores[budget] for budget in checkpoints], axis=0)\n   358\t        if not np.isfinite(complete_value).all():\n   359\t            raise ValueError(\"nonfinite complete-path score\")\n   360\t        last_checkpoint_scores = checkpoint_scores\n   361\t        return tuple(complete_value)\n   362\t\n   363\t    selected_path = incumbent_path\n   364\t    assert len(selected_path) == len(set(selected_path))\n   365\t    assert all(0 <= row_id < len(rows) for row_id in selected_path)\n   366\t    assert len(selected_path) >= max(checkpoints, default=0)\n   367\t    assert all(rows[row_id, 2] in (0, 1) for row_id in selected_path)\n   368\t\n   369\t    try:\n   370\t        incumbent_value = score_prefix_path(incumbent_path, checkpoints, baseline_theta)\n   371\t        current_value = incumbent_value\n   372\t        current_checkpoint_scores = last_checkpoint_scores\n   373\t        _verify_checkpoint_locality()\n   374\t        exact_refit_cap += 72 if model.dimension <= 64 else 24\n   375\t        deadline = time.monotonic() + 2.0\n   376\t        eligible_rows = np.flatnonzero(rows[:, 2] != .5)\n   377\t        row_types = 2 * model.inverse + (rows[:, 2] == 1).astype(int)\n   378\t        path_positions = np.arange(len(current_path))\n   379\t        sweep_positions = set(np.linspace(0, len(current_path) - 1,\n   380\t                                         num=min(24, len(current_path)), dtype=int).tolist())\n   381\t        for budget in checkpoints:\n   382\t            sweep_positions.update(position for position in (budget - 1, budget)\n   383\t                                   if 0 <= position < len(current_path))\n   384\t        sweep_positions = sorted(sweep_positions)\n   385\t        position_cursor = 0\n   386\t\n   387\t        while proposal_count < proposal_cap and time.monotonic() < deadline:\n   388\t            if exact_refit_count >= exact_refit_cap:\n   389\t                break\n   390\t            selected_types = row_types[np.asarray(current_path, dtype=int)]\n   391\t            unused = np.ones(len(rows), dtype=bool)\n   392\t            unused[current_path] = False\n   393\t            unused_rows = eligible_rows[unused[eligible_rows]]\n   394\t            first_unused = np.full(len(model.capacity), len(rows), dtype=int)\n   395\t            np.minimum.at(first_unused, row_types[unused_rows], unused_rows)\n   396\t            replacement_rows = np.sort(first_unused[first_unused < len(rows)])\n   397\t            replacement_types = row_types[replacement_rows]\n   398\t            checkpoint_gains = {}\n   399\t            for budget in dict.fromkeys(checkpoints):\n   400\t                cache_key = tuple(sorted(current_path[:budget]))\n   401\t                checkpoint_theta = prefix_theta_cache[cache_key]\n   402\t                probability = expit((checkpoint_theta[lower] - checkpoint_theta[upper]) / scale)\n   403\t                gap_weight = probability * (1 - probability) / scale\n   404\t                gradient = np.zeros(model.dimension)\n   405\t                np.add.at(gradient, lower, gap_weight)\n   406\t                np.add.at(gradient, upper, -gap_weight)\n   407\t                direction = cho_solve(baseline_factor, gradient, check_finite=False)\n   408\t                group_gain = model.project(direction)\n   409\t                checkpoint_gains[budget] = np.column_stack((group_gain, -group_gain)).ravel()\n   410\t\n   411\t            accepted = False\n   412\t            for offset in range(len(sweep_positions)):\n   413\t                if proposal_count >= proposal_cap or time.monotonic() >= deadline:\n   414\t                    break\n   415\t                position = sweep_positions[(position_cursor + offset) % len(sweep_positions)]\n   416\t                selected_type = selected_types[position]\n   417\t                swap_gain = np.zeros(len(current_path))\n   418\t                crosses_checkpoint = np.zeros(len(current_path), dtype=bool)\n   419\t                replacement_gain = np.zeros(len(replacement_rows))\n   420\t                for budget in checkpoints:\n   421\t                    type_gain = checkpoint_gains[budget]\n   422\t                    crossing = (path_positions < budget) != (position < budget)\n   423\t                    sign = 1 if position < budget else -1\n   424\t                    swap_gain[crossing] += sign * (type_gain[selected_types[crossing]]\n   425\t                                                   - type_gain[selected_type])\n   426\t                    crosses_checkpoint |= crossing\n   427\t                    if budget > position:\n   428\t                        replacement_gain += type_gain[replacement_types] - type_gain[selected_type]\n   429\t\n   430\t                proposals = []\n   431\t                valid_swap = crosses_checkpoint & (selected_types != selected_type)\n   432\t                if np.any(valid_swap):\n   433\t                    partner = int(np.argmax(np.where(valid_swap, swap_gain, -np.inf)))\n   434\t                    left, right = sorted((position, partner))\n   435\t                    proposal_path = current_path.copy()\n   436\t                    proposal_path[left], proposal_path[right] = proposal_path[right], proposal_path[left]\n   437\t                    affected_checkpoints = [budget for budget in checkpoints if left < budget <= right]\n   438\t                    proposals.append((proposal_path, affected_checkpoints))\n   439\t                valid_replacement = replacement_types != selected_type\n   440\t                if np.any(valid_replacement):\n   441\t                    replacement_index = int(np.argmax(np.where(valid_replacement, replacement_gain, -np.inf)))\n   442\t                    replacement_row = int(replacement_rows[replacement_index])\n   443\t                    if replacement_row in current_path:\n   444\t                        raise ValueError(\"duplicate-row replacement\")\n   445\t                    proposal_path = current_path.copy()\n   446\t                    proposal_path[position] = replacement_row\n   447\t                    affected_checkpoints = [budget for budget in checkpoints if budget > position]\n   448\t                    proposals.append((proposal_path, affected_checkpoints))\n   449\t\n   450\t                best_value = current_value\n   451\t                best_path = None\n   452\t                best_scores = None\n   453\t                for proposal_path, proposal_checkpoints in proposals:\n   454\t                    if proposal_count >= proposal_cap or time.monotonic() >= deadline:\n   455\t                        break\n   456\t                    proposal_count += 1\n   457\t                    affected_checkpoints = proposal_checkpoints\n   458\t                    proposal_value = score_prefix_path(proposal_path, checkpoints, baseline_theta)\n   459\t                    if proposal_value > best_value:\n   460\t                        best_value = proposal_value\n   461\t                        best_path = proposal_path\n   462\t                        best_scores = last_checkpoint_scores\n   463\t                if best_path is not None:\n   464\t                    proposal_path = best_path\n   465\t                    proposal_value = best_value\n   466\t                    if proposal_value > current_value:\n   467\t                        current_path = proposal_path\n   468\t                        current_value = proposal_value\n   469\t                        current_checkpoint_scores = best_scores\n   470\t                        position_cursor = (position_cursor + offset + 1) % len(sweep_positions)\n   471\t                        accepted = True\n   472\t                        break\n   473\t            if not accepted:\n   474\t                break\n   475\t    except Exception:\n","exit_code":0,"status":"completed"}}
