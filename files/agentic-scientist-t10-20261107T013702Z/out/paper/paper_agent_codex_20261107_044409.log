{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/sh -lc \"python -u - <<'PY'\nimport importlib.util,json,time,requests,pathlib\nspec=importlib.util.spec_from_file_location('consult','scripts/consult_references.py'); module=importlib.util.module_from_spec(spec); spec.loader.exec_module(module)\ncorrect=[('Chernozhukov2018DML','10.1111/ectj.12097'),('AgrestiCoull1998','10.1080/00031305.1998.10480550'),('Hoeffding1963','10.1080/01621459.1963.10500830'),('Audibert2009','10.1016/j.tcs.2009.01.016'),('Efron1979','10.1214/aos/1176344552'),('Student1908','10.1093/biomet/6.1.1'),('BenjaminiHochberg1995','10.1111/j.2517-6161.1995.tb02031.x'),('NeweyMcFadden1994','10.1016/S1573-4412(05)80005-4')]\nresults=[]\nfor record in correct:\n for repeat in range(3):\n  try:\n   item=module.retrieve(record); results.append(item); print(item[0],item[2]['title'],item[3][:220]); break\n  except Exception as exc: print('retry',record,str(exc));time.sleep(4)\n time.sleep(.8)\npathlib.Path('literature/corrections.json').write_text(json.dumps([{'bib':v[1],'ref':v[2]} for v in results],indent=2))\nfor key,doi in [('Hastie2009','10.1007/978-0-387-84858-7'),('Glasserman2004','10.1007/978-0-387-21617-1'),('Sarndal1992','10.1007/978-1-4612-4378-6')]:\n url='https://link.springer.com/book/'+doi\n r=requests.get(url,timeout=40); texts=[]\n import re,html\n for match in re.findall(r'<div[\"'^>]*class=\"[''^\"]*Formatted[''^\"]*\"[''^>]*>(.*?)</div>'\"',r.text,re.S):\n  plain=html.unescape(re.sub('<[\"'^>]+>'\"',' ',match));\n  if len(plain)>100: texts.append(plain)\n if not texts:\n  texts=re.findall(r'<meta name=\\\"description\\\" content=\\\"([\"'^\"]+)\"'\"',r.text)\n pathlib.Path('literature/'+key+'_consulted.json').write_text(json.dumps({'url':url,'status':r.status_code,'description':texts},indent=2))\n print('BOOK',key,r.status_code,str(texts)[:900])\nurl='https://artowen.su.domains/mc/Ch-var-basic.pdf'; r=requests.get(url,timeout=45); print('OWEN',r.status_code,len(r.content)); pathlib.Path('literature/Owen2013.pdf').write_bytes(r.content)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
