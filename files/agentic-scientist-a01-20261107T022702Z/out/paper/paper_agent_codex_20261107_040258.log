{"type":"item.completed","item":{"id":"item_96","type":"command_execution","command":"/bin/sh -lc \"sed -n '59,108p' source_evidence/downstream/baseline/src/program.py; sed -n '1,140p' .codex/skills/validate-paper/scripts/validate_tex_refs.py; /agent-tmp/paper-tools/bin/python - <<'PY'\nfrom pathlib import Path\nprint('acquisition lines',len(Path('task/resources/search/acquire.py').read_text().splitlines()))\nPY\"","aggregated_output":"def _solve(matrix, target, rule, fraction, tolerance, deadline):\n    original = matrix[target]\n    caps = np.round(original + fraction * (1 - original), 10)\n    if rule == 'borda':\n        initial = _ranks(matrix)\n        before = (original > matrix).astype(float) + .5 * (original == matrix)\n        after = (caps > matrix).astype(float) + .5 * (caps == matrix)\n        delta = after - before\n        delta[target] = 0\n        gains = delta.sum(axis=0)\n        coefficients = (delta + gains) / ((matrix.shape[0] - 1) * matrix.shape[1])\n        def gap(indices):\n            updated = initial[target] - initial + coefficients[:, indices].sum(axis=1)\n            return float(updated.min())\n    else:\n        aggregate = np.mean if rule == 'mean' else np.median\n        competitors = np.delete(aggregate(matrix, axis=1), target).max()\n        def gap(indices):\n            value = original.copy()\n            value[indices] = caps[indices]\n            return float(aggregate(value) - competitors)\n    count = matrix.shape[1]\n    if gap([]) >= -tolerance:\n        return {'status': 'feasible', 'tasks': []}\n    if gap(list(range(count))) < -tolerance:\n        return {'status': 'unattainable', 'tasks': []}\n    if count <= 6:\n        for size in range(1, count + 1):\n            for subset in itertools.combinations(range(count), size):\n                if time.monotonic() >= deadline:\n                    return {'status': 'unresolved', 'tasks': []}\n                indices = list(subset)\n                if gap(indices) >= -tolerance:\n                    return {'status': 'feasible', 'tasks': indices}\n    selected = []\n    remaining = set(range(count))\n    while gap(selected) < -tolerance:\n        if time.monotonic() >= deadline:\n            return {'status': 'feasible', 'tasks': list(range(count))}\n        best = max(sorted(remaining), key=lambda column: gap(selected + [column]))\n        selected.append(best)\n        remaining.remove(best)\n    for column in selected.copy():\n        trial = [item for item in selected if item != column]\n        if gap(trial) >= -tolerance:\n            selected = trial\n    return {'status': 'feasible', 'tasks': sorted(selected)}\n\n\ndef handle(request):\n#!/usr/bin/env python3\n\"\"\"Validate that paper citations align with bibliography entries.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport re\nfrom pathlib import Path\n\nSECTION_PATTERNS = {\n    \"abstract\": re.compile(\n        r\"\\\\begin\\{abstract\\}|\\\\section\\*?\\{[^}]*abstract[^}]*\\}\",\n        re.IGNORECASE,\n    ),\n    \"introduction\": re.compile(r\"\\\\section\\*?\\{[^}]*introduction[^}]*\\}\", re.IGNORECASE),\n    \"related work\": re.compile(r\"\\\\section\\*?\\{[^}]*related work[^}]*\\}\", re.IGNORECASE),\n    \"method\": re.compile(r\"\\\\section\\*?\\{[^}]*method[^}]*\\}\", re.IGNORECASE),\n    \"results\": re.compile(r\"\\\\section\\*?\\{[^}]*results[^}]*\\}\", re.IGNORECASE),\n    \"conclusion\": re.compile(r\"\\\\section\\*?\\{[^}]*conclusion[^}]*\\}\", re.IGNORECASE),\n    \"references\": re.compile(\n        r\"\\\\bibliography\\{|\\\\printbibliography|\\\\begin\\{thebibliography\\}|\\\\section\\*?\\{[^}]*references[^}]*\\}\",\n        re.IGNORECASE,\n    ),\n}\nCITE_RE = re.compile(r\"\\\\cite[a-zA-Z*]*\\{([^}]+)\\}\")\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nSUPPLEMENT_HEADING_RE = re.compile(\n    r\"\\\\section\\s*\\{\\s*supplementary\\s+information\\s*\\}\",\n    re.IGNORECASE,\n)\nBIBLIOGRAPHY_RE = re.compile(\n    r\"\\\\bibliography\\s*\\{[^}]+\\}|\\\\printbibliography\\b(?:\\[[^\\]]*\\])?\"\n    r\"|\\\\begin\\s*\\{thebibliography\\}\",\n    re.IGNORECASE,\n)\nCLEARPAGE_RE = re.compile(r\"\\\\clearpage\\b\", re.IGNORECASE)\nNEXT_SECTION_RE = re.compile(r\"\\\\section\\*?\\s*(?:\\[[^\\[\\]]*\\]\\s*)?\\{\")\nLET_SECTION_ALIAS_RE = re.compile(\n    r\"\\\\let\\s*\\\\[a-zA-Z@]+\\s*=?\\s*\\\\section\\b\", re.IGNORECASE\n)\nNEWCOMMAND_DEFINITION_RE = re.compile(\n    r\"\\\\(?:newcommand|renewcommand)\\*?\\s*\\{\", re.IGNORECASE\n)\nDEF_DEFINITION_RE = re.compile(\n    r\"\\\\(?:def|gdef|edef|xdef)\\s*\\\\[a-zA-Z@]+\", re.IGNORECASE\n)\nTEX_IMPORT_RE = re.compile(r\"\\\\(?:input|include)\\b\", re.IGNORECASE)\nSUBSTANTIVE_SUPPLEMENT_RE = re.compile(\n    r\"\\\\subsection\\*?\\s*\\{|\\\\begin\\s*\\{(?:table|figure)\\*?\\}\",\n    re.IGNORECASE,\n)\nSUPPLEMENT_PLACEHOLDER_TEXTS = (\n    \"add supplementary material only when grounded artifacts support it\",\n    \"replace with grounded extended methods, reproducibility details, additional analyses, or supporting tables and figures\",\n)\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\[a-zA-Z@]+\")\nNEWIF_RE = re.compile(r\"\\\\newif\\s*(?P<name>\\\\if[a-zA-Z@]+)\")\nCONDITIONAL_OPENERS = frozenset(\n    {\n        r\"\\if\",\n        r\"\\ifcase\",\n        r\"\\ifcat\",\n        r\"\\ifcondition\",\n        r\"\\ifcsname\",\n        r\"\\ifdefined\",\n        r\"\\ifdim\",\n        r\"\\ifeof\",\n        r\"\\iffalse\",\n        r\"\\iffontchar\",\n        r\"\\ifhbox\",\n        r\"\\ifhmode\",\n        r\"\\ifincsname\",\n        r\"\\ifinner\",\n        r\"\\ifluatex\",\n        r\"\\ifmmode\",\n        r\"\\ifnum\",\n        r\"\\ifodd\",\n        r\"\\ifpdf\",\n        r\"\\ifpdfabsdim\",\n        r\"\\ifpdfabsnum\",\n        r\"\\ifpdfprimitive\",\n        r\"\\iftrue\",\n        r\"\\ifvbox\",\n        r\"\\ifvmode\",\n        r\"\\ifvoid\",\n        r\"\\ifx\",\n        r\"\\ifxetex\",\n    }\n)\nNON_CONDITIONAL_IF_MACROS = frozenset(\n    {\n        r\"\\ifblank\",\n        r\"\\ifbool\",\n        r\"\\ifboolexpr\",\n        r\"\\ifcsdef\",\n        r\"\\ifcsempty\",\n        r\"\\ifcsequal\",\n        r\"\\ifcsmacro\",\n        r\"\\ifcsparam\",\n        r\"\\ifcsprotected\",\n        r\"\\ifcsstring\",\n        r\"\\ifcsundef\",\n        r\"\\ifcsvoid\",\n        r\"\\ifdimcomp\",\n        r\"\\ifdimequal\",\n        r\"\\ifdimgreater\",\n        r\"\\ifdimless\",\n        r\"\\ifdef\",\n        r\"\\ifdefempty\",\n        r\"\\ifdefequal\",\n        r\"\\ifdefltxprotect\",\n        r\"\\ifdefmacro\",\n        r\"\\ifdefparam\",\n        r\"\\ifdefprotected\",\n        r\"\\ifdefstring\",\n        r\"\\ifdefvoid\",\n        r\"\\iflanguage\",\n        r\"\\ifltxcount\",\n        r\"\\ifltxcounter\",\n        r\"\\ifnumcomp\",\n        r\"\\ifnumequal\",\n        r\"\\ifnumgreater\",\n        r\"\\ifnumless\",\n        r\"\\ifstrequal\",\n        r\"\\ifstrempty\",\n        r\"\\ifthenelse\",\n        r\"\\iftoggle\",\n        r\"\\ifundef\",\n    }\n)\nVERBATIM_ENV_RE = re.compile(\n    r\"\\\\begin\\s*\\{(?P<env>verbatim\\*?|lstlisting|minted)\\}.*?\"\n    r\"\\\\end\\s*\\{(?P=env)\\}\",\n    re.DOTALL,\n)\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate LaTeX sections and citation keys.\")\nacquisition lines 131\n","exit_code":0,"status":"completed"}}
