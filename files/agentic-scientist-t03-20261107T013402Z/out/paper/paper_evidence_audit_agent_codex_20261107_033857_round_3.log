ckground_row in enumerate(background):\n   113\t        increments = coefficients * (query_values - background_row)\n   114\t        base_logit = float(background_row @ coefficients + intercept)\n   115\t        if not math.isfinite(base_logit) or not np.all(np.isfinite(increments)):\n   116\t            return None\n   117\t        base_probability = 1.0 / (1.0 + np.exp(-np.clip(base_logit, -700, 700)))\n   118\t        endpoint_difference = float(query_probability - base_probability)\n   119\t        row_phi = _integrate_row(base_logit, increments, endpoint_difference,\n   120\t                                 inclusion_nodes, inclusion_weights,\n   121\t                                 frequency_nodes, frequency_weights)\n   122\t        if row_phi is None:\n   123\t            return None\n   124\t        background_phi[row_index] = row_phi\n   125\t    return background_phi.mean(axis=0)\n   126\t\n   127\t\n   128\tdef logistic_fourier_shapley(model, query):\n   129\t    \"\"\"Average every supplied row, or reject without consuming sampling RNG.\n   130\t\n   131\t    Sigmoid(z) = 1/2 + integral sin(omega*z)/sinh(pi*omega) d omega.\n   132\t    The integrand's zero-frequency limit is increments/pi. Interior frequency\n   133\t    nodes and expm1 avoid subtracting nearly equal complex phases. Clipping at\n   134\t    magnitude 700 perturbs sigmoid below ordinary float64 absolute precision.\n   135\t    \"\"\"\n   136\t    try:\n   137\t        with np.errstate(over='raise', invalid='raise', divide='raise', under='ignore'):\n   138\t            return _logistic_fourier_shapley(model, query)\n   139\t    except (FloatingPointError, OverflowError):\n   140\t        return None\n     1\t\"\"\"Fixed empirical-background estimation; diagnostics never extend RPC responses.\"\"\"\n     2\t\n     3\timport math\n     4\t\n     5\timport numpy as np\n     6\t\n     7\tfrom forest import exact_forest_shapley\n     8\tfrom logistic_fourier import logistic_fourier_shapley\n     9\t\n    10\t\n    11\tclass FrozenProbabilityGame:\n    12\t    \"\"\"Mask original supplied columns, without refitting or resampling background.\n    13\t\n    14\t    The transport already applies frozen scalar preprocessing. It supplies no\n    15\t    raw dataframe or pipeline; no claim about unobserved preprocessing is made.\n    16\t    The cache is query-local, and contains only predictions requested here.\n    17\t    \"\"\"\n    18\t\n    19\t    def __init__(self, model, query, predict):\n    20\t        self.model = model\n    21\t        self.query = np.array(query, dtype=np.float64, copy=True)\n    22\t        self.background = np.array(model['background'], dtype=np.float64, copy=True)\n    23\t        self.predict = predict\n    24\t        self.dimension = model['dimension']\n    25\t        self.cache = {}\n    26\t        self.prediction_rows = 0\n    27\t        self.unique_coalitions = 0\n    28\t\n    29\t    def values(self, coalition_masks):\n    30\t        coalition_masks = np.asarray(coalition_masks, dtype=np.uint32)\n    31\t        missing = sorted(set(map(int, coalition_masks)) - self.cache.keys())\n    32\t        for offset in range(0, len(missing), 128):\n    33\t            chunk = np.asarray(missing[offset:offset + 128], dtype=np.uint32)\n    34\t            included = ((chunk[:, None] >> np.arange(self.dimension)) & 1).astype(bool)\n    35\t            hybrid = np.where(included[:, None, :], self.query, self.background[None, :, :])\n    36\t            predictions = self.predict(self.model, hybrid.reshape(-1, self.dimension))\n    37\t            means = predictions.reshape(len(chunk), len(self.background)).mean(axis=1)\n    38\t            for mask, mean in zip(chunk, means):\n    39\t                self.cache[int(mask)] = float(mean)\n    40\t            self.prediction_rows += len(chunk) * len(self.background)\n    41\t            self.unique_coalitions += len(chunk)\n    42\t        return np.asarray([self.cache[int(mask)] for mask in coalition_masks])\n    43\t\n    44\t\n    45\tdef exact_shapley(game):\n    46\t    \"\"\"Exhaustive fixed-game solution, used only when the budget covers it.\n    47\t\n    48\t    This is not an independent experimental reference for a deployment call.\n    49\t    It neither supplies a table to a sampled call nor reuses another call's cache.\n    50\t    \"\"\"\n    51\t    feature_count = game.dimension\n    52\t    coalition_values = game.values(np.arange(1 << feature_count, dtype=np.uint32))\n    53\t    reference_phi = np.zeros(feature_count)\n    54\t    for coalition_mask in range(1 << feature_count):\n    55\t        coalition_size = coalition_mask.bit_count()\n    56\t        if coalition_size == feature_count:\n    57\t            continue\n    58\t        coalition_weight = 1.0 / (feature_count * math.comb(feature_count - 1, coalition_size))\n    59\t        for feature_index in range(feature_count):\n    60\t            if not coalition_mask & (1 << feature_index):\n    61\t                reference_phi[feature_index] += coalition_weight * (coalition_values[coalition_mask | (1 << feature_index)] - coalition_values[coalition_mask])\n    62\t    assert np.isclose(reference_phi.sum(), coalition_values[-1] - coalition_values[0], atol=1e-8)\n    63\t    return reference_phi\n    64\t\n    65\t\n    66\tdef independent_paths(game, path_count, rng):\n    67\t    \"\"\"Complete uniform paths; no antithetic paths or adaptive stopping.\n    68\t\n    69\t    Reusing a deterministic coalition value does not couple the independently\n    70\t    sampled permutations. Each row, not each marginal, is a sampling unit.\n    71\t    \"\"\"\n    72\t    feature_count = game.dimension\n    73\t    permutations = np.asarray([rng.permutation(feature_count) for _ in range(path_count)])\n    74\t    prefixes = np.bitwise_or.accumulate(np.left_shift(np.uint32(1), permutations.astype(np.uint32)), axis=1)\n    75\t    masks = prefixes[:, :-1].reshape(-1)\n    76\t    endpoints = game.values([0, (1 << feature_count) - 1])\n    77\t    path_values = np.empty((path_count, feature_count + 1))\n    78\t    path_values[:, 0] = endpoints[0]\n    79\t    path_values[:, -1] = endpoints[1]\n    80\t    path_values[:, 1:-1] = game.values(masks).reshape(path_count, feature_count - 1)\n    81\t    path_marginals = np.empty((path_count, feature_count))\n    82\t    np.put_along_axis(path_marginals, permutations, np.diff(path_values, axis=1), axis=1)\n    83\t    if not np.all(np.abs(path_marginals) <= 1.0 + 1e-12):\n    84\t        raise ValueError('probability marginal outside its bounded domain')\n    85\t    if not np.allclose(path_marginals.sum(axis=1), endpoints[1] - endpoints[0], atol=1e-10, rtol=0):\n    86\t        raise ValueError('incomplete permutation path')\n    87\t    return path_marginals, masks\n    88\t\n    89\t\n    90\tdef simultaneous_certificate(path_marginals, alpha=0.05):\n    91\t    \"\"\"At most alpha unconditional wrong-certificate probability per fixed call.\n    92\t\n    93\t    The bound is on independent complete-path means, never regression estimates.\n    94\t    It is not a conditional-on-acceptance guarantee. Strict separation rejects\n    95\t    ties, with original column order breaking estimate ties deterministically.\n    96\t    \"\"\"\n    97\t    path_count, feature_count = path_marginals.shape\n    98\t    if path_count < 2 or not 0 < alpha < 1:\n    99\t        raise ValueError('certificate requires two paths and valid alpha')\n   100\t    estimate = path_marginals.mean(axis=0)\n   101\t    sample_variance = path_marginals.var(axis=0, ddof=1)\n   102\t    log_term = np.log(4.0 * feature_count / alpha)\n   103\t    radius = np.sqrt(2.0 * sample_variance * log_term / path_count) + 14.0 * log_term / (3.0 * (path_count - 1))\n   104\t    magnitude_lower = np.maximum(0.0, np.abs(estimate) - radius)\n   105\t    magnitude_upper = np.abs(estimate) + radius\n   106\t    order = np.argsort(-np.abs(estimate), kind='stable')\n   107\t    selected = order[:min(3, feature_count - 1)]\n   108\t    excluded = order[min(3, feature_count - 1):]\n   109\t    topk_certified = bool(magnitude_lower[selected].min() > magnitude_upper[excluded].max())\n   110\t    signs_certified = bool(np.all(np.abs(estimate[selected]) > radius[selected]))\n","exit_code":0,"status":"completed"}}
