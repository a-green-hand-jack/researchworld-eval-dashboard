{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, re, statistics\nfrom pathlib import Path\npaper = Path('paper.tex').read_text()\ndata = json.loads(Path('paper_data.json').read_text())\nsummary = json.loads(Path('analysis_summary.json').read_text())\nepisodes = data['final_evaluation']['evaluation_evidence']['episodes']\nerrors = []\nfor case, methods in summary['cases'].items():\n    records = [next(item for item in episode['solution']['cases'] if item['case'] == case) for episode in episodes]\n    for method, fields in methods.items():\n        group = 'variants' if method in ('actual','constant','permuted') else 'baselines'\n        for field in ('utility','mass','marginal','group'):\n            values = [record[group][method][field] for record in records]\n            expected = fields[field]\n            if isinstance(expected, dict):\n                if abs(statistics.mean(values)-expected['mean']) > 1e-12 or abs(statistics.stdev(values)-expected['sd']) > 1e-12 or values \"'!= expected['\"'seeds']:\n                    errors.append((case,method,field))\n            elif values \"'!= expected:\n                errors.append((case,method,field))\n        if '\"'coverage' in fields:\n            actual = [[record[group][method]['details'][level]['coverage'] for record in records] for level in (0,1)]\n            if actual \"'!= fields['\"'coverage']: errors.append((case,method,'coverage'))\nfor table, name in [('condition_utility','tab:case'),('group_mass','tab:group')]:\n    fragment = Path('tables/'+table+'.tex').read_text().strip()\n    if fragment not in paper: errors.append(('table content',name))\nfor method, fields in summary['aggregate'].items():\n    for field,value in fields.items():\n        actual = statistics.mean(summary['cases'][case][method][field]['mean'] for case in summary['cases'])\n        if abs(actual-value)>1e-12: errors.append(('aggregate',method,field))\nfor control, expected in [('full_simplex',1),('copy_center',0)]:\n    for episode in episodes:\n        for case in episode['solution']['cases']:\n            result = case['baselines'][control]\n            if result['mass'] \"'!= expected or any(item['\"'coverage'] \"'!= expected for item in result['\"'details']):\n                errors.append(('control',control,episode['seed'],case['case']))\nprint('Frozen-data summary, supplementary table, aggregate, and degenerate-control mismatches:',errors)\nprint('Seeds:',[episode['seed'] for episode in episodes])\nfor case in summary['cases']:\n    print(case, '; '.join(method+' U='+format(record['utility']['mean'],'.5f')+' cov95/90='+','.join(format(statistics.mean(values),'.5f') for values in record['coverage']) for method,record in summary['cases'][case].items() if 'coverage' in record))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
