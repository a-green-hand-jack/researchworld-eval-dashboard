set_ylabel('MAE (percentage points)')\n    axes[1].set_ylabel('Spearman correlation')\n    axes[1].set_xlabel('Queried items per target')\n    axes[1].set_xticks(budgets)\n    axes[0].legend(ncol=2, fontsize=9, frameon=False)\n    for axis in axes:\n        axis.grid(alpha=0.15)\n    save_figure(figure, 'budget_sensitivity')\n    concept_png = ROOT / 'figures/score_prediction_overview.png'\n    concept_log = ROOT / 'figures/score_prediction_overview.prompts.json'\n    completed = (ROOT / '.concept_figure_complete').exists()\n    populated_log = concept_log.exists() and concept_log.read_text().strip() not in ['', '{}']\n    if not completed and not populated_log and not concept_png.exists():\n        figure = plt.figure(figsize=(8, 2.9))\n        figure.text(0.5, 0.5, 'Conceptual overview reserved for orchestrator rendering', ha='center', va='center', fontsize=15, color='#555555')\n        figure.savefig(concept_png, dpi=300, facecolor='#fafafa')\n        plt.close(figure)\n        concept_log.write_text('{}\\n')\n    entries = [dict(figure_id='score_prediction_overview', path_png='figures/score_prediction_overview.png',\n                    generator='generate-concept-figure', prompt_log_path='figures/score_prediction_overview.prompts.json',\n                    figure_type='diagram', n_panels=1, panels_per_row=1, categories_per_panel=[6], series_per_panel=[1],\n                    max_label_chars=30, font_sizes=dict(title=10, axis=9, ticks=9, legend=9),\n                    uses_abbrev_labels=True, uses_progression=False, placement='full_width',\n                    intended_latex_width_fraction=1.0, estimated_min_rendered_font_pt=9.0, source_ids=[])]\n    entries += [figure_entry('paired_error_comparison', 'scatter', 1, [4], [1]),\n                figure_entry('case_budget_reversals', 'composite', 2, [5, 4], [3, 3]),\n                figure_entry('budget_sensitivity', 'line', 2, [3, 3], [4, 4])]\n    write_json(ROOT / 'figure_manifest.json', {'figures': entries})\n    print(json.dumps(summary, indent=2))\n\n\nif __name__ == '__main__':\n    main()\n#!/bin/sh\nset -eu\npython .codex/skills/validate-paper/scripts/validate_compile_inputs.py run -- \\\n    pdflatex -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\npython .codex/skills/validate-paper/scripts/validate_compile_inputs.py bibtex --paper-dir . --aux paper.aux\npython .codex/skills/validate-paper/scripts/validate_compile_inputs.py run -- bibtex paper\npython .codex/skills/validate-paper/scripts/validate_compile_inputs.py run -- \\\n    pdflatex -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\npython .codex/skills/validate-paper/scripts/validate_compile_inputs.py run -- \\\n    pdflatex -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error paper.tex\npython .codex/skills/validate-paper/scripts/validate_rendered_si.py --pdf paper.pdf\npython - <<'PY'\nimport json\nfrom pathlib import Path\nsidecar = dict(schema_name='scientific-evidence.artifact-manifest',\n               artifact=dict(path='paper.pdf', kind='manuscript'),\n               derived_from=['paper.tex', 'references.bib', 'tables/aggregate.tex',\n                             'figures/score_prediction_overview.png',\n                             'figures/paired_error_comparison.pdf',\n                             'figures/case_budget_reversals.pdf', 'figures/budget_sensitivity.pdf'],\n               generated_by=dict(script_path='scripts/compile_local.sh'),\n               notes='Input dependency trail; the orchestrator replaces the reserved conceptual overview and recompiles the final PDF.')\nsidecar['derived_from'] = ['@' + 'evidence' + '[' * 2 + target + ']' * 2 for target in sidecar['derived_from']]\nPath('paper.pdf.prov.json').write_text(json.dumps(sidecar, indent=2) + '\\n')\nsidecar = dict(schema_name='scientific-evidence.artifact-manifest',\n               artifact=dict(path='paper.tex', kind='manuscript'),\n               derived_from=['paper_data.json', 'analysis/paper_statistics.json',\n                             'references_provenance.json', 'source_evidence/inventory.json'],\n               notes='Evidence inputs for agent-authored manuscript; not an assertion of automatic text generation by a script.')\nsidecar['derived_from'] = ['@' + 'evidence' + '[' * 2 + target + ']' * 2 for target in sidecar['derived_from']]\nPath('paper.tex.prov.json').write_text(json.dumps(sidecar, indent=2) + '\\n')\nPY\n\"\"\"Supplement canonical checks with explicit rendered and JSON-locator audits.\n\nThis does not replace the parent orchestrator's authoritative venue validation.\n@evidence[[paper.tex]]\n@evidence[[analysis/paper_statistics.json]]\n\"\"\"\n\nimport datetime\nimport importlib.util\nimport json\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport fitz\nimport jsonschema\n\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef check_pointer(reference):\n    prefix = '@' + 'evidence' + '[' * 2\n    inner = reference.removeprefix(prefix).removesuffix(']' * 2)\n    target, separator, locator = inner.partition('#')\n    path = ROOT / target\n    if not path.is_file():\n        raise ValueError('Missing local evidence: ' + reference)\n    if separator and locator.startswith('/') and path.suffix == '.json':\n        value = json.loads(path.read_text())\n        for component in locator[1:].split('/'):\n            component = component.replace('~1', '/').replace('~0', '~')\n            value = value[int(component)] if isinstance(value, list) else value[component]\n    if separator and re.fullmatch(r'L\\d+', locator):\n        assert 1 <= int(locator[1:]) <= len(path.read_text().splitlines()), reference\n\n\ndef main():\n    commands = [\n        ['python', '.codex/skills/validate-paper/scripts/validate_tex_refs.py', '--tex', 'paper.tex', '--bib', 'references.bib'],\n        [sys.executable, '.codex/skills/write-paper-standalone/scripts/validate_claims.py', '--paper-data', 'paper_data.json', '--references', 'references_provenance.json', '--bib', 'references.bib', '--claims', 'claims_grounding.json', '--paper-dir', '.'],\n        ['python', '.codex/skills/validate-paper/scripts/validate_rendered_si.py', '--pdf', 'paper.pdf'],\n    ]\n    for command in commands:\n        subprocess.run(command, cwd=ROOT, check=True)\n    figure_schema = json.loads((ROOT / '.codex/skills/validate-paper/templates/figure_manifest.schema.json').read_text())\n    figure_manifest = json.loads((ROOT / 'figure_manifest.json').read_text())\n    jsonschema.validate(figure_manifest, figure_schema)\n    sidecar_schema = json.loads((ROOT / 'scientific-evidence/schemas/artifact-manifest.schema.json').read_text())\n    for path in ROOT.rglob('*.prov.json'):\n        jsonschema.validate(json.loads(path.read_text()), sidecar_schema)\n    texts = [ROOT / 'paper.tex', *list((ROOT / 'scripts').glob('*.py')), *list((ROOT / 'tables').glob('*.tex'))]\n    checked = 0\n    for path in texts:\n        for reference in re.findall(r'@evidence\\[\\[[^\\]]+\\]\\]', path.read_text()):\n            check_pointer(reference)\n            checked += 1\n    manuscript = (ROOT / 'paper.tex').read_text()\n    for table in ['case_budget', 'seeds']:\n        embedded = manuscript.split('% BEGIN GENERATED ' + table + '\\n')[1].split('% END GENERATED ' + table)[0]\n        assert embedded.strip() == (ROOT / ('tables/' + table + '.tex')).read_text().strip()\n    claims = json.loads((ROOT / 'claims_grounding.json').read_text())['claims']\n    for claim in claims:\n        for reference in claim.get('evidence_refs', []):\n            check_pointer(reference)\n    registry = json.loads((ROOT / 'paper_data.json').read_text())\n    for source in ['final.qualification.status', 'final.qualification.outcome']:\n        assert source in registry['grounding_sources']\n    reference_records = json.loads((ROOT / 'references_provenance.json').read_text())['references']\n    cited = set()\n    for group in re.findall(r'\\\\cite\\w*\\{([^}]+)\\}', (ROOT / 'paper.tex').read_text()):\n        cited.update(key.strip() for key in group.split(','))\n    assert cited == {record['citation_key'] for record in reference_records}\n    assert 25 <= len(cited) <= 30\n    specifications = json.loads((ROOT / 'paper_strategy.json').read_text())['figure_specs']\n    figures = {figure['figure_id']: figure for figure in figure_manifest['figures']}\n    for spec in specifications:\n        actual = figures[spec['figure_id']]\n        assert actual['n_panels'] <= spec['max_panels']\n        assert max(actual['categories_per_panel']) <= spec['max_categories_per_panel']\n        assert max(actual['series_per_panel']) <= spec['max_series_per_panel']\n    module_path = ROOT / '.codex/skills/validate-paper/scripts/validate_compile_inputs.py'\n    spec = importlib.util.spec_from_file_location('compile_guard', module_path)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    roots = [path.resolve() for path in module.LATEX_SYSTEM_INPUT_ROOTS]\n    safe_inputs = set()\n    for line in (ROOT / 'paper.fls').read_text().splitlines():\n        if not line.startswith('INPUT '):\n            continue\n        path = Path(line.removeprefix('INPUT '))\n        if not path.is_absolute():\n            path = ROOT / path\n        resolved = path.resolve()\n        assert resolved.is_relative_to(ROOT) or any(resolved.is_relative_to(root) for root in roots), str(path)\n        assert not resolved.is_relative_to(ROOT / '.codex'), str(path)\n        safe_inputs.add(str(resolved))\n    document = fitz.open(ROOT / 'paper.pdf')\n    pages = [page.get_text() for page in document]\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n\ndef _markdown_entry(event: dict[str, Any]) -> str:\n    \"\"\"Handle markdown entry logic for this module.\"\"\"\n    lines = [\n        f\"### {event['timestamp']} | step={event['step']} | scope={event['scope']}\",\n/opt/autoillustrate-venv/bin/activate\n/workspace/task/.venv/bin/activate\nls: cannot access '.codex/skills/write-paper/scripts': No such file or directory\n","exit_code":2,"status":"failed"}}
