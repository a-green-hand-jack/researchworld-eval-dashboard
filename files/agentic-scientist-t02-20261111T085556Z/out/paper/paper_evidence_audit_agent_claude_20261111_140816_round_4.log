type\": \"metric\",\n  \"value\": 0.7976868327402136\n },\n \"result.improvement_002\": {\n  \"attempt_id\": \"c02_param_scaling_lazy_rich_width_attempt_01\",\n  \"id\": \"result.improvement_002\",\n  \"idea_id\": \"c02_param_scaling_lazy_rich_width\",\n  \"program_dir\": \"work/results/t02/claude/20261111_085902/investigation/ideas/02_parametrization_controlled_lazy_to_rich_transition_shapes_width_dependence_of_grokking_delay/program_1\",\n  \"program_id\": \"program_1\",\n  \"type\": \"metric\",\n  \"value\": 0.828466629206468\n },\n \"result.improvement_003\": {\n  \"attempt_id\": \"c03_hidden_lr_multiplier_width_confound_attempt_01\",\n  \"id\": \"result.improvement_003\",\n  \"idea_id\": \"c03_hidden_lr_multiplier_width_confound\",\n  \"program_dir\nderived:\nresolution.json\nresolution.json.prov.json\n\nscripts:\nbuild_figures.py\nderive_resolution.py\nwrite_prov.py\n\nsource_evidence/evaluator:\nevaluate.py\nevaluate_final.py\nstock_program0.py\n\nsource_evidence/final:\nevaluation_evidence.json\nfinal_manifest.json\nmetrics.json\n\nsource_evidence/frozen_model:\nprogram.py\n\nsource_evidence/search_variants:\nvariant1_evidence.json\nvariant1_metrics.json\nvariant1_program.py\nvariant2_evidence.json\nvariant2_metrics.json\nvariant2_program.py\nvariant3_evidence.json\nvariant3_metrics.json\nvariant3_program.py\n\nsource_evidence/workload:\nfinal_manifest.json\nsearch_manifest.json","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
