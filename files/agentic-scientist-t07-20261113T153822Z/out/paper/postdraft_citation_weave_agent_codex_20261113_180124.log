{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,100p' verify_paper_artifacts.py; rg -n 'argparse|--|pdf|validation' verify_paper_artifacts.py | tail -25; cat paper.tex.prov.json; cat references.bib.prov.json; python .codex/skills/memory-log/scripts/append_memory.py --help | head -35; python - <<'PY'\nimport json\np=json.load(open('paper_strategy.json')); print('strategy keys',list(p)); print('figures',[(x.get('figure_id'),x.get('preferred_generator')) for x in p.get('figure_specs',[])]);\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,100p' verify_paper_artifacts.py; rg -n 'argparse|--|pdf|validation' verify_paper_artifacts.py | tail -25; cat paper.tex.prov.json; cat references.bib.prov.json; python .codex/skills/memory-log/scripts/append_memory.py --help | head -35; python - <<'PY'\nimport json\np=json.load(open('paper_strategy.json')); print('strategy keys',list(p)); print('figures',[(x.get('figure_id'),x.get('preferred_generator')) for x in p.get('figure_specs',[])]);\nPY\"","aggregated_output":"import json\nimport re\nfrom pathlib import Path\n\nimport jsonschema\nimport numpy as np\nimport pymupdf\n\nROOT = Path(__file__).resolve().parent\n\n\ndef main():\n    manifest = json.loads((ROOT / 'figure_manifest.json').read_text())\n    schema = json.loads((ROOT / '.codex/skills/validate-paper/templates/figure_manifest.schema.json').read_text())\n    jsonschema.validate(manifest, schema)\n    verified_pointers = 0\n    for path in [ROOT / 'paper.tex', ROOT / 'claims_grounding.json', ROOT / 'build_paper_artifacts.py']:\n        for target, pointer in re.findall(r'@evidence\\[\\[([^#\\]]+)#(/[^\\]]*)\\]\\]', path.read_text()):\n            value = json.loads((ROOT / target).read_text())\n            for part in pointer.lstrip('/').split('/'):\n                part = part.replace('~1', '/').replace('~0', '~')\n                value = value[int(part)] if isinstance(value, list) else value[part]\n            verified_pointers += 1\n    # @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    data = json.loads((ROOT / 'paper_data.json').read_text())\n    summary = json.loads((ROOT / 'derived_results.json').read_text())\n    assert sum(map(len, summary['common_support'].values())) == 28\n    assert summary['common_support']['commonsense'] == [7001]\n    assert data['final_evaluation']['outcome'] == 'not_qualified'\n    for episode in data['final_evaluation']['evaluation_evidence']['episodes']:\n        for name, case in episode['solution']['cases'].items():\n            if episode['seed'] in summary['common_support'][name]:\n                truth = np.asarray(case['target_full_means'])\n                array = np.asarray(case['conditions']['primary']['predictions'])\n                expected = summary['case_seed_mae'][summary['cases'].index(name)][summary['seeds'].index(episode['seed'])][0]\n                assert np.isclose(np.abs(array - truth).mean(), expected, rtol=1e-12, atol=1e-12)\n    tex = (ROOT / 'paper.tex').read_text()\n    referenced = re.findall(r'\\\\includegraphics(?:\\[[^\\]]*\\])?\\{([^}]+)\\}', tex)\n    assert set(referenced) == {figure['files'].get('pdf', figure['files']['png']) for figure in manifest['figures']}\n    for figure in manifest['figures']:\n        for path in figure['files'].values():\n            assert (ROOT / path).is_file()\n        assert figure['estimated_min_rendered_font_pt'] >= 8.5\n    document = pymupdf.open(ROOT / 'paper.pdf')\n    text_pages = [page.get_text() for page in document]\n    references_page = next(index for index, text in enumerate(text_pages) if re.search(r'\\bREFERENCES\\b', text))\n    supplement_page = next(index for index, text in enumerate(text_pages) if re.search(r'SUPPLEMENTARY\\s+INFORMATION', text))\n    assert references_page in [8, 9], references_page\n    assert supplement_page > references_page\n    last_body = document[references_page - 1]\n    blocks = [block for block in last_body.get_text('blocks') if block[0] > 100 and block[1] > 60 and block[3] < 730]\n    body_bottom = max(block[3] for block in blocks)\n    fill = (body_bottom - 72) / (9 * 72)\n    assert references_page == 9 or fill >= .75\n    body_text = '\\n'.join(text_pages[:references_page])\n    forbidden = ['idea', 'ideas', 'program', 'programs', 'attempt', 'attempts', 'eligible', 'worker_01', 'worker_02', 'combined_score', 'rubric']\n    assert not re.search(r'\\b(?:' + '|'.join(forbidden) + r')\\b', body_text, re.I)\n    assert 'failed qualification' in body_text.lower() or 'failed\\nqualification' in body_text.lower()\n    approved_roots = [ROOT] + [Path(root).resolve() for root in ['/etc/texmf', '/opt/texlive', '/usr/share/texlive', '/usr/share/texmf', '/var/lib/texmf']]\n    recorder_inputs = set()\n    for line in (ROOT / 'paper.fls').read_text().splitlines():\n        if line.startswith('INPUT '):\n            path = Path(line[6:])\n            resolved = (path if path.is_absolute() else ROOT / path).resolve()\n            assert any(resolved.is_relative_to(root) for root in approved_roots), str(resolved)\n            recorder_inputs.add(str(resolved))\n    report = dict(figure_schema='passed', json_pointers_checked=verified_pointers,\n                  available_pair_recalculation='passed', figures_referenced='passed',\n                  body_pages=references_page, last_body_geometric_fill=fill,\n                  supplementary_start_page=supplement_page + 1, standalone_language='passed',\n                  resolved_recorder_inputs_checked=len(recorder_inputs),\n                  note='Local checks. Orchestrator-owned diagram is a placeholder pending rendering. Canonical figure validator cannot import src.orchestrator in this workspace; canonical recorder rejects a standard TeX configuration symlink across two approved roots.')\n    (ROOT / 'local_validation_report.json').write_text(json.dumps(report, indent=2))\n    print(json.dumps(report, indent=2))\n\n\nif __name__ == '__main__':\n    main()\n7:import pymupdf\n39:    assert set(referenced) == {figure['files'].get('pdf', figure['files']['png']) for figure in manifest['figures']}\n44:    document = pymupdf.open(ROOT / 'paper.pdf')\n73:    (ROOT / 'local_validation_report.json').write_text(json.dumps(report, indent=2))\n{\n  \"schema_name\": \"scientific-evidence.artifact-manifest\",\n  \"artifact\": {\n    \"path\": \"paper.tex\",\n    \"kind\": \"manuscript\"\n  },\n  \"derived_from\": [\n    \"@evidence[[paper_data.json]]\",\n    \"@evidence[[derived_results.json]]\",\n    \"@evidence[[references.bib]]\",\n    \"@evidence[[source_evidence/selected_method.py]]\",\n    \"@evidence[[source_evidence/evaluate_final.py]]\"\n  ],\n  \"notes\": \"Authored from frozen evidence. The plotting script refreshes generated table rows only.\"\n}{\n  \"schema_name\": \"scientific-evidence.artifact-manifest\",\n  \"artifact\": {\n    \"path\": \"references.bib\",\n    \"kind\": \"derived\"\n  },\n  \"derived_from\": [\n    \"@evidence[[references_provenance.json]]\"\n  ],\n  \"notes\": \"Exact-DOI metadata used for bibliography.\",\n  \"generated_by\": {\n    \"script_path\": \"retrieve_vetted_references.py\",\n    \"command\": [\n      \"python\",\n      \"retrieve_vetted_references.py\"\n    ]\n  }\n}usage: append_memory.py [-h] [--write-conclusions] [--event-json EVENT_JSON]\n                        [--event-file EVENT_FILE]\n                        [--local-memory-md LOCAL_MEMORY_MD]\n                        [--global-memory-md GLOBAL_MEMORY_MD]\n                        [--global-memory-jsonl GLOBAL_MEMORY_JSONL]\n                        [--conclusions-md CONCLUSIONS_MD]\n                        [--conclusions-history-jsonl CONCLUSIONS_HISTORY_JSONL]\n                        [--conclusions-text CONCLUSIONS_TEXT]\n                        [--cycle-index CYCLE_INDEX]\n                        [--worker-index WORKER_INDEX]\n                        [--gate-trigger GATE_TRIGGER]\n                        [--gate-reason GATE_REASON]\n\nAppend one memory event, or atomically rewrite conclusions.md.\n\noptions:\n  -h, --help            show this help message and exit\n  --write-conclusions   Switch into conclusions-write mode (validates and\n                        replaces conclusions.md).\n  --event-json EVENT_JSON\n                        Event payload as JSON object string\n  --event-file EVENT_FILE\n                        Path to event JSON file\n  --local-memory-md LOCAL_MEMORY_MD\n                        Local workspace memory markdown path\n  --global-memory-md GLOBAL_MEMORY_MD\n                        Global markdown memory path (event mode)\n  --global-memory-jsonl GLOBAL_MEMORY_JSONL\n                        Global JSONL memory path (event mode)\n  --conclusions-md CONCLUSIONS_MD\n                        Path of conclusions.md to overwrite (--write-\n                        conclusions mode)\n  --conclusions-history-jsonl CONCLUSIONS_HISTORY_JSONL\n                        Path of conclusions_history.jsonl to append a record\n                        to\nstrategy keys ['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason']\nfigures [('method_and_evidence_overview', 'generate-concept-figure'), ('available_pair_method_comparison', 'matplotlib'), ('budget_accuracy_and_ranking', 'matplotlib')]\n","exit_code":0,"status":"completed"}}
