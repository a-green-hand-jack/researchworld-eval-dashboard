observed_orcids\": [\n          \"https://orcid.org/0009-0006-0202-8404\"\n        ]\n      },\n      \"institutions\": [\n        {\n          \"id\": \"https://openalex.org/I1341030882\",\n          \"display_name\": \"Educational Testing Service\",\n{\n  \"id\": \"https://openalex.org/W2112090702\",\n  \"doi\": \"https://doi.org/10.1038/30918\",\n  \"title\": \"Collective dynamics of \\u2018small-world\\u2019 networks\",\n  \"publication_year\": 1998,\n  \"authorships\": [\n    {\n      \"author_position\": \"first\",\n      \"author\": {\n        \"id\": \"https://openalex.org/A5000679279\",\n        \"display_name\": \"Duncan J. Watts\",\n        \"orcid\": \"https://orcid.org/0000-0001-5005-4961\",\n        \"observed_orcids\": [\n          \"https://orcid.org/0000-0001-5005-4961\"\n        ]\n","exit_code":0,"status":"completed"}}
