{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/sh -lc \"cat .codex/skills/validate-paper/scripts/validate_figures.py; rg -n 'LLM|checklist|pages|length' literature/template_iclr2026_conference.tex | head -20; sed -n '1,38p' iclr2026_conference.sty; /tmp/paper-tools/bin/python - <<'PY'\nimport json\np=json.load(open('paper_strategy.json')); print([(v['figure_id'],v['max_panels'],v['max_categories_per_panel']) for v in p['figure_specs']]); print('keys',list(p))\nPY\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n119:All pages should start at 1~inch (6~picas) from the top of the page.\n131:There will be a strict upper limit of \\textbf{9 pages} for the main text of the initial submission, with unlimited additional pages for citations. This limit will be expanded to \\textbf{10 pages} for rebuttal/camera ready.\n354:In particular, do not modify the width or length of the rectangle the text\n356:\\textsc{References} section; see below). Please note that pages should be\n%%%% ICLR Macros (LaTex)\n%%%% Adapted by Hugo Larochelle from the NIPS stylefile Macros\n%%%% Style File\n%%%% Dec 12, 1990   Rev Aug 14, 1991; Sept, 1995; April, 1997; April, 1999; October 2014\n\n% This file can be used with Latex2e whether running in main mode, or\n% 2.09 compatibility mode.\n%\n% If using main mode, you need to include the commands\n%             \\documentclass{article}\n%             \\usepackage{iclr14submit_e,times}\n%\n\n% Change the overall width of the page.  If these parameters are\n%       changed, they will require corresponding changes in the\n%       maketitle section.\n%\n\\usepackage{eso-pic} % used by \\AddToShipoutPicture\n\\RequirePackage{fancyhdr}\n\\RequirePackage{natbib}\n\n% modification to natbib citations\n\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n\n\\renewcommand{\\topfraction}{0.95}   % let figure take up nearly whole page\n\\renewcommand{\\textfraction}{0.05}  % let figure take up nearly whole page\n\n% Define iclrfinal, set to true if iclrfinalcopy is defined\n\\newif\\ificlrfinal\n\\iclrfinalfalse\n\\def\\iclrfinalcopy{\\iclrfinaltrue}\n\\font\\iclrtenhv  = phvb at 8pt\n\n% Specify the dimensions of each page\n\n\\setlength{\\paperheight}{11in}\n\\setlength{\\paperwidth}{8.5in}\n\n[('frozen_score_overview', 1, 5), ('coverage_width_comparison', 4, 4), ('rare_outcome_diagnostic', 2, 4)]\nkeys ['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason']\n","exit_code":0,"status":"completed"}}
