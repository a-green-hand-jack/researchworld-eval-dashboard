{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"cat .codex/skills/retrieve-references/templates/provenance.schema.json; cat scientific-evidence/schemas/artifact-manifest.schema.json; sed -n '1,170p' .codex/skills/write-paper-standalone/scripts/validate_claims.py; sed -n '1,125p' task/evaluate_final.py; cat task/requirements.txt; ls task/resources\"","aggregated_output":"{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"ReferenceProvenance\",\n  \"type\": \"object\",\n  \"required\": [\"generated_at\", \"count\", \"queries\", \"references\"],\n  \"properties\": {\n    \"generated_at\": {\"type\": \"string\"},\n    \"count\": {\"type\": \"integer\", \"minimum\": 0},\n    \"queries\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\"}\n    },\n    \"references\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"paper_id\", \"citation_key\", \"query\", \"source_url\"],\n        \"properties\": {\n          \"id\": {\"type\": \"string\"},\n          \"paper_id\": {\"type\": \"string\"},\n          \"citation_key\": {\"type\": \"string\"},\n          \"title\": {\"type\": [\"string\", \"null\"]},\n          \"year\": {\"type\": [\"integer\", \"null\"]},\n          \"venue\": {\"type\": [\"string\", \"null\"]},\n          \"citation_count\": {\"type\": [\"integer\", \"null\"]},\n          \"query\": {\"type\": \"string\"},\n          \"source_url\": {\"type\": \"string\"},\n          \"retrieved_at\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n{\n  \"$id\": \"https://schemas.agentic-scientist.local/scientific-evidence/artifact-manifest.schema.json\",\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"artifact\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"source\",\n            \"derived\",\n            \"manuscript\",\n            \"figure\",\n            \"table\",\n            \"script\",\n            \"log\",\n            \"other\"\n          ],\n          \"type\": \"string\"\n        },\n        \"media_type\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Path to the artifact relative to the scientific-evidence root when possible.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"sha256\": {\n          \"description\": \"Optional hash recorded when the producing workflow computes one.\",\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"kind\"\n      ],\n      \"type\": \"object\"\n    },\n    \"derived_from\": {\n      \"description\": \"Inline @evidence refs or stable ids describing the artifact inputs.\",\n      \"items\": {\n        \"minLength\": 1,\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"type\": \"array\"\n    },\n    \"generated_by\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"command\": {\n          \"items\": {\n            \"minLength\": 1,\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"type\": \"array\"\n        },\n        \"cwd\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"finished_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        },\n        \"script_path\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"script_sha256\": {\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        },\n        \"started_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"script_path\"\n      ],\n      \"type\": \"object\"\n    },\n    \"named_outputs\": {\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"number\",\n          \"integer\",\n          \"boolean\",\n          \"array\",\n          \"object\",\n          \"null\"\n        ]\n      },\n      \"description\": \"Optional machine-readable outputs emitted by the derivation.\",\n      \"type\": \"object\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"schema_name\": {\n      \"const\": \"scientific-evidence.artifact-manifest\"\n    }\n  },\n  \"required\": [\n    \"schema_name\",\n    \"artifact\",\n    \"derived_from\"\n  ],\n  \"title\": \"Scientific Evidence Artifact Manifest\",\n  \"type\": \"object\"\n}\n#!/usr/bin/env python3\n\"\"\"Validate generated claim-grounding artifacts before paper finalization.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nEVIDENCE_REF_RE = re.compile(r\"@evidence\\[\\[[^\\]]+\\]\\]\")\nTEX_INPUT_RE = re.compile(\n    r\"\\\\(?:input|include)(?![A-Za-z@])\\s*\"\n    r\"(?:\\{(?P<braced>[^{}]+)\\}|(?P<unbraced>[^\\s%{}]+))\"\n)\nTEX_IMPORT_COMMAND_RE = re.compile(r\"\\\\(?:input|include)(?![A-Za-z@])\")\nTEX_LOCAL_SUPPORT_RE = re.compile(\n    r\"\\\\(?P<command>usepackage|RequirePackage|documentclass|LoadClass)\"\n    r\"(?![A-Za-z@])(?:\\s*\\[[^\\]]*\\])?\\s*\\{(?P<targets>[^{}]+)\\}\"\n)\nTEX_LOCAL_SUPPORT_COMMAND_RE = re.compile(\n    r\"\\\\(?:usepackage|RequirePackage|documentclass|LoadClass)(?![A-Za-z@])\"\n)\nDYNAMIC_TEX_IMPORT_RE = re.compile(r\"\\\\csname\\s*(?:input|include)\\s*\\\\endcsname\")\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\if[a-zA-Z@]+\\b|\\\\else\\b|\\\\fi\\b\")\nVERBATIM_ENV_RE = re.compile(\n    r\"\\\\begin\\s*\\{(?P<env>verbatim\\*?|lstlisting|minted)\\}.*?\"\n    r\"\\\\end\\s*\\{(?P=env)\\}\",\n    re.DOTALL,\n)\nPROMPT_ARTIFACT_RE = re.compile(r\".+_prompt(?:_round_\\d+(?:_contract_retry_\\d+)?)?\\.md$\")\nGENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\n    \"validation_feedback.json\",\n    \"validation_feedback.md\",\n    \"verification-report.json\",\n}\nROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\"validation_report.json\"}\nGENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES = (\n    \"paper_evidence_audit\",\n)\nEVIDENCE_BUNDLE_DIRNAME = \"scientific-evidence\"\nEVIDENCE_SCAN_SUFFIXES = (\n    \".tex\",\n    \".md\",\n    \".json\",\n    \".yaml\",\n    \".yml\",\n    \".py\",\n    \".sh\",\n    \".r\",\n    \".csv\",\n    \".tsv\",\n)\nEVIDENCE_SKIP_DIR_NAMES = {\n    \".git\",\n    \"__pycache__\",\n    EVIDENCE_BUNDLE_DIRNAME,\n}\nAGENT_SKILL_DIR_PREFIXES = (\n    (\".claude\", \"skills\"),\n    (\".codex\", \"skills\"),\n    (\".cursor\", \"skills\"),\n    (\".opencode\", \"skills\"),\n    (\".gemini\", \"skills\"),\n    (\".pi\", \"agent\", \"skills\"),\n)\nVERIFICATION_SUMMARY_KEYS = (\n    \"total_references\",\n    \"resolved_references\",\n    \"anchored_references\",\n    \"dangling_references\",\n    \"manifests_checked\",\n)\nSCIENTIFIC_EVIDENCE_SCRIPT = (\n    Path(__file__).resolve().parent.parent.parent\n    / \"scientific-evidence\"\n    / \"scripts\"\n    / \"scientific_evidence.py\"\n)\n\n\ndef read_json(path: Path) -> dict[str, Any]:\n    \"\"\"Read JSON data from disk when available.\"\"\"\n    try:\n        payload = json.loads(path.read_text(encoding=\"utf-8\"))\n    except json.JSONDecodeError as exc:\n        raise SystemExit(f\"Invalid JSON in {path}: {exc}\") from exc\n    if not isinstance(payload, dict):\n        raise SystemExit(f\"Expected JSON object in {path}\")\n    return payload\n\n\ndef read_bib_keys(path: Path) -> set[str]:\n    \"\"\"Read bib keys.\"\"\"\n    text = path.read_text(encoding=\"utf-8\")\n    return {match.group(1).strip() for match in KEY_RE.finditer(text) if match.group(1).strip()}\n\n\ndef validate_reference_provenance(*, references_payload: dict[str, Any], bib_keys: set[str]) -> tuple[set[str], list[str]]:\n    \"\"\"Validate references_provenance.json against references.bib.\"\"\"\n    errors: list[str] = []\n    refs = references_payload.get(\"references\")\n    if not isinstance(refs, list):\n        return set(), [\"references_provenance.json must contain a `references` list.\"]\n\n    provenance_keys: set[str] = set()\n    provenance_ids: set[str] = set()\n    for idx, row in enumerate(refs):\n        if not isinstance(row, dict):\n            errors.append(f\"references[{idx}] must be object\")\n            continue\n        source_id = row.get(\"id\")\n        if not isinstance(source_id, str) or not source_id.strip():\n            errors.append(f\"references[{idx}].id missing\")\n        else:\n            if source_id in provenance_ids:\n                errors.append(f\"references[{idx}].id duplicates existing id: {source_id!r}\")\n            provenance_ids.add(source_id)\n\n        citation_key = row.get(\"citation_key\")\n        if not isinstance(citation_key, str) or not citation_key.strip():\n            errors.append(f\"references[{idx}].citation_key missing\")\n            continue\n        if citation_key in provenance_keys:\n            errors.append(\n                f\"references[{idx}].citation_key duplicates existing key: {citation_key!r}\"\n            )\n        provenance_keys.add(citation_key)\n\n    missing_in_provenance = sorted(bib_keys - provenance_keys)\n    if missing_in_provenance:\n        errors.append(\n            \"references.bib keys missing from references_provenance.json: \"\n            + \", \".join(repr(key) for key in missing_in_provenance)\n        )\n\n    missing_in_bib = sorted(provenance_keys - bib_keys)\n    if missing_in_bib:\n        errors.append(\n            \"references_provenance.json keys missing from references.bib: \"\n            + \", \".join(repr(key) for key in missing_in_bib)\n        )\n\n    return provenance_ids, errors\n\n\ndef is_excluded_evidence_scan_path(path: Path, *, paper_dir: Path) -> bool:\n    \"\"\"Return True for operational artifacts that should not enter evidence scans.\"\"\"\n    rel_parts = path.relative_to(paper_dir).parts\n    if any(rel_parts[: len(prefix)] == prefix for prefix in AGENT_SKILL_DIR_PREFIXES):\n        return True\n    if any(part in EVIDENCE_SKIP_DIR_NAMES for part in rel_parts):\n        return True\n    if len(rel_parts) == 1 and rel_parts[0] in ROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES:\n        return True\n    if path.name in GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES:\n        return True\n    if any(path.name.startswith(prefix) for prefix in GENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES):\n        return True\n    return bool(PROMPT_ARTIFACT_RE.fullmatch(path.name))\n\n\ndef strip_tex_comments(tex_text: str) -> str:\n\"\"\"Self-contained offline evaluator. Only this plane's frozen root is readable.\n\nScientific validity, operational search eligibility, and publication claims are\nseparate: supported negative findings are eligible; this scaffold does not\ncertify arbitrary candidates' theoretical variance assumptions or paper quality.\n\"\"\"\nimport argparse\nimport base64\nimport collections\nimport ctypes\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport re\nimport resource\nimport selectors\nimport signal\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\n\nPLANE = \"final\"\nSEEDS = [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009, 1010, 1011, 1012, 1013, 1014, 1015, 1016, 1017, 1018, 1019, 1020, 1021, 1022, 1023, 1024, 1025, 1026, 1027, 1028, 1029, 1030, 1031, 1032, 1033, 1034, 1035, 1036, 1037, 1038, 1039, 1040, 1041, 1042, 1043, 1044, 1045, 1046, 1047, 1048, 1049, 1050, 1051, 1052, 1053, 1054, 1055, 1056, 1057, 1058, 1059, 1060, 1061, 1062, 1063, 1064, 1065, 1066, 1067, 1068, 1069, 1070, 1071, 1072, 1073, 1074, 1075, 1076, 1077, 1078, 1079, 1080, 1081, 1082, 1083, 1084, 1085, 1086, 1087, 1088, 1089, 1090, 1091, 1092, 1093, 1094, 1095, 1096, 1097, 1098, 1099, 1100, 1101, 1102, 1103, 1104, 1105, 1106, 1107, 1108, 1109, 1110, 1111, 1112, 1113, 1114, 1115, 1116, 1117, 1118, 1119, 1120, 1121, 1122, 1123, 1124, 1125, 1126, 1127, 1128, 1129, 1130, 1131, 1132, 1133, 1134, 1135, 1136, 1137, 1138, 1139, 1140, 1141, 1142, 1143, 1144, 1145, 1146, 1147, 1148, 1149, 1150, 1151, 1152, 1153, 1154, 1155, 1156, 1157, 1158, 1159, 1160, 1161, 1162, 1163, 1164, 1165, 1166, 1167, 1168, 1169, 1170, 1171, 1172, 1173, 1174, 1175, 1176, 1177, 1178, 1179, 1180, 1181, 1182, 1183, 1184, 1185, 1186, 1187, 1188, 1189, 1190, 1191, 1192, 1193, 1194, 1195, 1196, 1197, 1198, 1199, 1200, 1201, 1202, 1203, 1204, 1205, 1206, 1207, 1208, 1209, 1210, 1211, 1212, 1213, 1214, 1215, 1216, 1217, 1218, 1219, 1220, 1221, 1222, 1223, 1224, 1225, 1226, 1227, 1228, 1229, 1230, 1231, 1232, 1233, 1234, 1235, 1236, 1237, 1238, 1239, 1240, 1241, 1242, 1243, 1244, 1245, 1246, 1247, 1248, 1249, 1250, 1251, 1252, 1253, 1254, 1255, 1256, 1257, 1258, 1259, 1260, 1261, 1262, 1263, 1264, 1265, 1266, 1267, 1268, 1269, 1270, 1271, 1272, 1273, 1274, 1275, 1276, 1277, 1278, 1279, 1280, 1281, 1282, 1283, 1284, 1285, 1286, 1287, 1288, 1289, 1290, 1291, 1292, 1293, 1294, 1295, 1296, 1297, 1298, 1299, 1300, 1301, 1302, 1303, 1304, 1305, 1306, 1307, 1308, 1309, 1310, 1311, 1312, 1313, 1314, 1315, 1316, 1317, 1318, 1319, 1320, 1321, 1322, 1323, 1324, 1325, 1326, 1327, 1328, 1329, 1330, 1331, 1332, 1333, 1334, 1335, 1336, 1337, 1338, 1339, 1340, 1341, 1342, 1343, 1344, 1345, 1346, 1347, 1348, 1349, 1350, 1351, 1352, 1353, 1354, 1355, 1356, 1357, 1358, 1359, 1360, 1361, 1362, 1363, 1364, 1365, 1366, 1367, 1368, 1369, 1370, 1371, 1372, 1373, 1374, 1375, 1376, 1377, 1378, 1379, 1380, 1381, 1382, 1383, 1384, 1385, 1386, 1387, 1388, 1389, 1390, 1391, 1392, 1393, 1394, 1395, 1396, 1397, 1398, 1399]\nWALL_SECONDS = 14400\nCASES = (\"linear\", \"nonlinear\", \"uninformative\", \"rare_outcome\", \"gene_expression\",\n         \"constant_nonlinear\", \"permuted_nonlinear\")\nMAX_CHUNKS = 8\nCHUNK_BYTES = 1024**2\nWIRE_LIMIT = 64 * 1024**2\nRPC_BUDGET = (7 * len(SEEDS) + 1) * (1 + 1 + MAX_CHUNKS + 1 + 2)\nMETRICS = (\"combined_score\", \"nominal_coverage\", \"empirical_coverage\", \"minimum_case_coverage\",\n           \"mean_width_ratio\", \"width_utility\", \"failure_fraction\", \"control_pass\",\n           \"scientific_validity\", \"correct\")\n\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {\"ok\"} or response[\"ok\"] is not True:\n        raise InvalidResetResponse(\"invalid reset response\")\n\n\nclass RequiredBaselineFailure(RuntimeError):\n    def __init__(self, category):\n        self.category = bounded_failure_name(category, \"invalid_baseline_diagnostic\")\n        super().__init__(\"required baseline failed\")\n\n\ndef bounded_failure_name(value, fallback):\n    import re\n    return value if isinstance(value, str) and re.fullmatch(r\"[a-z][a-z0-9_]{0,79}\", value) else fallback\n\n\ndef describe_episode_failure(error, operation):\n    # A finally-block cleanup exception may wrap the original required-worker failure.\n    context = error\n    for _ in range(8):\n        if isinstance(context, InvalidResetResponse):\n            return {\"component\": \"candidate\", \"category\": \"invalid_reset_response\",\n                    \"operation\": \"reset\"}\n        if isinstance(context, RequiredBaselineFailure):\n            return {\"component\": \"baseline\", \"category\": context.category,\n                    \"operation\": \"baseline_worker\"}\n        context = context.__context__\n        if context is None:\n            break\n    return {\"component\": \"candidate\", \"category\": \"timeout\",\n            \"operation\": bounded_failure_name(operation, \"unknown\")}\n\n\n\ndef fail_required_baseline(category, cancel_work, record_failure):\n    failure = RequiredBaselineFailure(category)\n    try:\n        record_failure(failure.category)\n    except Exception:\n        failure.add_note(\"baseline diagnostic recording failed\")\n    try:\n        cancel_work()\n    except Exception:\n        failure.add_note(\"baseline cleanup failed\")\n    raise failure from None\n\n\ndef collect_required_baseline(result, *, deadline, clock, cancel_work, record_failure):\n    try:\n        remaining = deadline - clock()\n        if remaining <= 0:\n            raise TimeoutError()\n        value = result(timeout=remaining)\n        if clock() > deadline:\n            raise TimeoutError()\n        return value\n    except RequiredBaselineFailure:\n        raise\n    except (RuntimeError, TimeoutError) as error:\n        category = \"baseline_timeout\" if isinstance(error, TimeoutError) else \"baseline_result_failure\"\n        fail_required_baseline(category, cancel_work, record_failure)\n\n\ndef guard_required_baseline(call, failure_category, cancel_work, record_failure):\n    def check():\n        category = failure_category()\n        if category is not None:\n            fail_required_baseline(category, cancel_work, record_failure)\n    def guarded(request):\n        check()\n        result = call(request)\n        check()\n        return result\n    return guarded\n\n\nimport collections\nimport os\nimport selectors\nimport sys\nimport threading\nnumpy==1.26.4\nscipy==1.12.0\nppi-python==0.2.3\nmatplotlib==3.8.4\nnumba==0.68.1\npandas==3.0.6\nstatsmodels==0.15.0\nscikit-learn==1.9.1\ngdown==6.5.1\nfinal\nsearch\n","exit_code":0,"status":"completed"}}
