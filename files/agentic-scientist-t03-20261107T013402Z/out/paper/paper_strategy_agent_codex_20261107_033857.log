{PAPER_EDIT_CONTEXT_PATH}} False\n{{PAPER_EDIT_CONTEXT_JSON_PATH}} False\nprevious_paper False\naggregated False\nextra_tasks False\ncontributions.md False\nresults_readme.md False\n_idea_generation\nattempts_history.jsonl\nbest_program_manifest.json\nconclusions.md\nconclusions_history.jsonl\nconclusions_other_workers.md\nevents.jsonl\nidea_generation_failures.jsonl\nideas\nideas_history.jsonl\nlatest_run_manifest.json\nmemory.jsonl\nmemory.md\nouter_state.json\ntask\nevaluator cmp exit=1\n33:PLANE = 'final'\n45:if PLANE == 'search':\n82:    return PLANE == 'search' and (os.environ.get('AGENTIC_TASK_QUALIFICATION') == '1' or os.environ.get('AGENTIC_TASK_DRAFT_SMOKE') == '1')\n98:    if PLANE == 'search':\n1209:    if production_counts(PLANE)[1]!=RPC_BUDGET:\n1268:    if PLANE=='search':\n1317:    settings = {'instances':2 if smoke else 8 if PLANE=='search' else 16,'background':4 if smoke else 16,\n1318:                'repetitions':2 if smoke else 4 if PLANE=='search' else 6,'budgets':[16] if smoke else [64,256] if PLANE=='search' else [64,256,1024]}\n1321:    startup_allowance = 5 if smoke else 300 if PLANE=='search' else 600\n1324:    work_seconds = 2.5 if smoke else 50 if PLANE=='search' else 110\n","exit_code":0,"status":"completed"}}
