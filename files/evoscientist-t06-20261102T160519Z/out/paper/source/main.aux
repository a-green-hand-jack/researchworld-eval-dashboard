\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Full fixed-target sensitivity results. Each row retains the corresponding primary target identities. The gap is before outcome edits under the changed estimator/data convention. $k=0$ with ``Already reversed'' means the specification change alone reverses the original pair, not a successful zero-edit attack on the primary specification. Other $k$ values are sufficient witnesses, not minima. Tie removal changes $N$ and $E_{ab}$; ridge alone does not. Source: \texttt  {artifacts/fixed\_target\_ablations.csv}; generated input: \texttt  {paper/tables/fixed\_ablations.tex}.}}{15}{table.6}\protected@file@percent }
\newlabel{tab:ablations}{{6}{15}{Full fixed-target sensitivity results. Each row retains the corresponding primary target identities. The gap is before outcome edits under the changed estimator/data convention. $k=0$ with ``Already reversed'' means the specification change alone reverses the original pair, not a successful zero-edit attack on the primary specification. Other $k$ values are sufficient witnesses, not minima. Tie removal changes $N$ and $E_{ab}$; ridge alone does not. Source: \texttt {artifacts/fixed\_target\_ablations.csv}; generated input: \texttt {paper/tables/fixed\_ablations.tex}}{table.6}{}}
