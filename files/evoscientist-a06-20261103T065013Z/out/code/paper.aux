\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Primary setting $K=8,n=64,m=128$, 2,000 repetitions. Coverage is percent $\pm $ one plug-in MCSE (percentage points); width is in percentage points. Zero MCSE at observed 100\% coverage is not certainty: exact binomial Monte Carlo intervals are also supplied in the CSV. Targets: known $p_J$ for iid simulation and exact $\mu _J$ for the real cache. Methods use different additional-data budgets: audit methods consume $m$ fresh audit responses for accuracy. Guarded and raw multiplier agree when the guard never fires.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:primary}{{1}{6}{Primary setting $K=8,n=64,m=128$, 2,000 repetitions. Coverage is percent $\pm $ one plug-in MCSE (percentage points); width is in percentage points. Zero MCSE at observed 100\% coverage is not certainty: exact binomial Monte Carlo intervals are also supplied in the CSV. Targets: known $p_J$ for iid simulation and exact $\mu _J$ for the real cache. Methods use different additional-data budgets: audit methods consume $m$ fresh audit responses for accuracy. Guarded and raw multiplier agree when the guard never fires}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Coverage--precision trade-off for the two primary targets. Square markers denote the finite-sample-guaranteed procedures under their stated designs; circles denote approximate procedures. The horizontal line is 95\%. Narrowness without coverage is not improved reporting. Primary guarded/raw multiplier points can overlap.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:coverage}{{2}{6}{Coverage--precision trade-off for the two primary targets. Square markers denote the finite-sample-guaranteed procedures under their stated designs; circles denote approximate procedures. The horizontal line is 95\%. Narrowness without coverage is not improved reporting. Primary guarded/raw multiplier points can overlap}{figure.2}{}}
