"\n        },\n        \"fallback_reason\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Fallback Reason\"\n        },\n        \"figure_id\": {\n          \"minLength\": 1,\n          \"title\": \"Figure Id\",\n          \"type\": \"string\"\n        },\n        \"figure_type\": {\n          \"enum\": [\n            \"grouped_bar\",\n            \"bar\",\n            \"line\",\n            \"box\",\n            \"violin\",\n            \"scatter\",\n            \"heatmap\",\n            \"table_matrix\",\n            \"table\",\n            \"composite\",\n            \"diagram\"\n          ],\n          \"title\": \"Figure Type\",\n          \"type\": \"string\"\n        },\n        \"files\": {\n          \"$ref\": \"#/$defs/RichFigureFiles\"\n        },\n        \"font_sizes\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/FigureFontSizes\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Generator\"\n        },\n        \"intended_latex_width_fraction\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"maximum\": 1,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": n