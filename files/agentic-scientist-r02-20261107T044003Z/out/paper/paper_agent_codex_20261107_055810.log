{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/sh -lc \"head -60 task/evaluate_final.py; sed -n '490,535p' task/evaluate_final.py; sed -n '190,220p' source_evidence/adaptive.py; cat .codex/skills/validate-paper/scripts/validate_figures.py | head -75; ls /opt/autoillustrate-venv/bin | grep pdf\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/sh -lc \"head -60 task/evaluate_final.py; sed -n '490,535p' task/evaluate_final.py; sed -n '190,220p' source_evidence/adaptive.py; cat .codex/skills/validate-paper/scripts/validate_figures.py | head -75; ls /opt/autoillustrate-venv/bin | grep pdf\"","aggregated_output":"\"\"\"Standalone evaluator; all candidate measurements are reconstructed privately.\n\nFrozen resources include raw numeric SHA256 inventories before any ILR/features.\nCandidate/evaluator communication never conveys filesystem names or private targets.\n\"\"\"\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport resource\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\n\nSTARTED = time.monotonic()\nCPU_IDS = sorted(os.sched_getaffinity(0))\nNATIVE_CPU_IDS = CPU_IDS[4:8] if len(CPU_IDS) >= 8 else CPU_IDS[:4]\nos.sched_setaffinity(0, CPU_IDS[:4])\nfor THREAD_NAME in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):\n    os.environ[THREAD_NAME] = '4'\nos.environ['PYTHONDONTWRITEBYTECODE'] = '1'\nimport numpy as np\n\nPLANE = 'final'\nSEEDS = [1009, 2027, 3049, 4051, 5059]\nCOUNTS = (4096, 2048, 3840)\nPROBES = 4096\nWALL_SECONDS = 3600\nRPC_BUDGET = 775\nMETRICS = ['combined_score', 'marginal_coverage', 'normalized_volume', 'worst_stratum_coverage', 'coverage_gap_vs_euclidean', 'volume_gain_vs_euclidean', 'coverage_gap_vs_ilr', 'volume_gain_vs_ilr']\nCHUNK = 1048576\nMAX_CHUNKS = 4\nWIRE_LIMIT = 8 * 1024 * 1024\nCASE_IDS = ('C1', 'C2', 'C3', 'C4', 'C5', 'C6')\nREPAIR = PLANE == 'search' and (os.environ.get('AGENTIC_TASK_QUALIFICATION') == '1'\n                              or os.environ.get('AGENTIC_TASK_DRAFT_SMOKE') == '1')\n\n\nclass ProtocolError(RuntimeError):\n    pass\n\n\nclass FatalTransportError(RuntimeError):\n    pass\n\n\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\n        self.capture = BoundedWorkerStderr(self.process.stderr)\n        self.closed = False\n        self.snapshot = None\n        self.exit_status = None\n        self.forwarded = False\n\n    def request(self, value, timeout):\n        return exchange(self.process, value, timeout)\n\n    def close(self, failed=False):\n        if self.closed:\n            if failed and REPAIR and self.snapshot and self.snapshot['stderr'] and not self.forwarded:\n                self.forwarded = True\n                print(self.snapshot['stderr'], end='', file=sys.stderr, flush=True)\n            return\n        self.closed = True\n        process = self.process\n        try:\n            if process.poll() is None:\n                try:\n                    os.killpg(process.pid, signal.SIGTERM)\n                except ProcessLookupError:\n                    pass\n                try:\n                    process.wait(timeout=1)\n                except subprocess.TimeoutExpired:\n                    os.killpg(process.pid, signal.SIGKILL)\n                    process.wait(timeout=1)\n            else:\n                try:\n                    os.killpg(process.pid, signal.SIGKILL)\n                except ProcessLookupError:\n                    pass\n            self.exit_status = process.returncode\n        finally:\n            process.stdin.close()\n            process.stdout.close()\n            self.snapshot = self.capture.close()\n            if failed and REPAIR and self.snapshot['stderr']:\n                self.forwarded = True\n                print(self.snapshot['stderr'], end='', file=sys.stderr, flush=True)\n\n\nclass Candidate:\n    def __init__(self, path, work_seconds, reset_seconds):\n        self.path = path\n            raise ValueError('invalid query shape')\n        design = features(covariates)\n        location, variance, boundary_edges, group_factors = STATE['model']\n        dimension = STATE['dimension']\n        means = design @ location\n        scales = np.exp(0.5 * np.clip(design @ variance, -6, 5))\n        groups = boundary_groups(predicted_boundary(means, STATE['basis']), boundary_edges)\n        factors = scales[:, :, None] * group_factors[groups]\n        output = np.concatenate((means, factors.reshape(len(covariates), -1)), axis=1).astype('<f8')\n        STATE['prediction'] = output.tobytes()\n        STATE['prediction_index'] = 0\n        return {'n_rows': len(covariates), 'dimension': dimension, 'nbytes': output.nbytes,\n                'chunks': math.ceil(output.nbytes / CHUNK), 'encoding': 'base64',\n                'dtype': '<f8', 'shape': list(output.shape)}\n    if operation == 'predict_chunk':\n        if request['index'] != STATE['prediction_index']:\n            raise ValueError('invalid download order')\n        start = request['index'] * CHUNK\n        raw = STATE['prediction'][start:start + CHUNK]\n        if not raw:\n            raise ValueError('invalid download index')\n        STATE['prediction_index'] += 1\n        return {'block': encode(np.frombuffer(raw, dtype='<f8'))}\n    if operation == 'predict_release':\n        if STATE['prediction_index'] != math.ceil(len(STATE['prediction']) / CHUNK):\n            raise ValueError('incomplete download')\n        del STATE['prediction']\n        return {'ok': True}\n    raise ValueError('unknown operation')\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":1,"status":"failed"}}
