,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"source\",\n            \"derived\",\n            \"manuscript\",\n            \"figure\",\n            \"table\",\n            \"script\",\n            \"log\",\n            \"other\"\n          ],\n          \"type\": \"string\"\n        },\n        \"media_type\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Path to the artifact relative to the scientific-evidence root when possible.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"sha256\": {\n          \"description\": \"Optional hash recorded when the producing workflow computes one.\",\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"kind\"\n      ],\n      \"type\": \"object\"\n    },\n    \"derived_from\": {\n      \"description\": \"Inline @evidence refs or stable ids describing the artifact inputs.\",\n      \"items\": {\n        \"minLength\": 1,\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"type\": \"array\"\n    },\n    \"generated_by\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"command\": {\n          \"items\": {\n            \"minLength\": 1,\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"type\": \"array\"\n        },\n        \"cwd\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"finished_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        },\n        \"script_path\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"script_sha256\": {\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        },\n        \"started_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"script_path\"\n      ],\n      \"type\": \"object\"\n    },\n    \"named_outputs\": {\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"number\",\n          \"integer\",\n          \"boolean\",\n          \"array\",\n          \"object\",\n          \"null\"\n        ]\n      },\n      \"description\": \"Optional machine-readable outputs emitted by the derivation.\",\n      \"type\": \"object\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"schema_name\": {\n      \"const\": \"scientific-evidence.artifact-manifest\"\n    }\n  },\n  \"required\": [\n    \"schema_name\",\n    \"artifact\",\n    \"derived_from\"\n  ],\n  \"title\": \"Scientific Evidence Artifact Manifest\",\n  \"type\": \"object\"\n}\n{\n  \"schema_version\": 1,\n  \"plane\": \"final\",\n  \"seeds\": [\n    1009,\n    2027,\n    3049,\n    4051,\n    5059\n  ],\n  \"counts\": [\n    4096,\n    2048,\n    3840\n  ],\n  \"alpha\": 0.1,\n  \"datasets\": [\n    {\n      \"case\": \"C1\",\n      \"seed\": 1009,\n      \"dimension\": 3,\n      \"file\": \"C1-1009.npz\",\n      \"sha256\": \"6ea8e9cf3057e6c54d22240d232df162ee733864b5c9b1ad341a430e1297deee\",\n      \"source_id\": \"local-logistic-normal-dirichlet-v2-private/final/C1/1009\",\n      \"rng_substreams\": {\n        \"parameters\": \"family1/parameters\",\n        \"covariates\": \"family1/covariates\",\n        \"responses\": \"family1/responses\",\n        \"volume_probes\": \"volume_probes\"\n      },\n      \"row_provenance\": {\n        \"train\": [\n          0,\n          4096\n        ],\n        \"calibration\": [\n          4096,\n          6144\n        ],\n        \"test\": [\n          6144,\n          9984\n        ]\n      },\n      \"private_provenance\": \"generation_entropy: 32 independent OS-random bytes retained only inside this evaluator-private corpus member; 