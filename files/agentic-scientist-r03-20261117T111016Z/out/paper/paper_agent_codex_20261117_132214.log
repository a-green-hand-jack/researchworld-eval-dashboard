{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/sh -lc \"/tmp/apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: retrieve_paper_references.py\n@@\n-    ('Pukelsheim2006', 'DOI:10.1137/1.9780898719109'),\n-    ('Ledoit2004', 'DOI:10.1016/S0047-259X(03)00096-4'),\n+    ('Harris2020', 'DOI:10.1038/s41586-020-2649-2'),\n+    ('Hunter2007', 'DOI:10.1109/MCSE.2007.55'),\n*** End Patch\nPATCH\npython retrieve_paper_references.py > /tmp/reference_consultation.txt 2>&1\npython - <<'PY'\nimport urllib.request,json,pathlib\nurl='https://api.semanticscholar.org/graph/v1/paper/DOI:10.2307/1913643?fields=title,abstract'\ntry:\n p=json.load(urllib.request.urlopen(url,timeout=25));pathlib.Path('literature_evidence/Koenker1978_consultation.json').write_text(json.dumps(p,indent=2));print(p.get('abstract'))\nexcept Exception as exc: print(exc)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
