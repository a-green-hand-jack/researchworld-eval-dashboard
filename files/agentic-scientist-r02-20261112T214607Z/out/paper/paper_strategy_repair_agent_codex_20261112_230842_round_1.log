{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nfrom pathlib import Path\nstrategy = json.loads(Path('paper_strategy.json').read_text())\ndata = json.loads(Path('paper_data.json').read_text())\nmemo = Path('paper_strategy.md').read_text()\nerrors = []\ndef check(condition, message):\n    if not condition:\n        errors.append(message)\nrequired = ['status','selected_prompt_family','recommended_title','central_question','central_thesis','narrative_rationale','prior_paper_story_status','edit_framing_decision','staged_input_impact','method_groups','results_focus','figure_plan','figure_specs','supplementary_plan','forbidden_headings','forbidden_phrases','notes_for_writer','failure_reason']\nfor field in required:\n    check(field in strategy, f'Missing {field}')\ncheck(strategy['status'] == 'ready', 'Not ready')\ncheck(strategy['selected_prompt_family'] == 'paper_standalone', 'Wrong prompt family')\ncheck(strategy['failure_reason'] == '', 'Unexpected failure reason')\nfor field in ['recommended_title','central_question','central_thesis','narrative_rationale','edit_framing_decision']:\n    check(isinstance(strategy[field],str) and bool(strategy[field].strip()), f'Empty {field}')\nfor field in ['recommended_title','central_question','central_thesis']:\n    check(strategy[field] in memo, f'Memo mismatch: {field}')\ncheck(strategy['prior_paper_story_status'] in ['preserved','broadened','recentered','rejected'], 'Invalid framing status')\nfor group in strategy['method_groups']:\n    check(group['role'] in ['baseline','proposed','ablation','supporting'], 'Invalid method role')\n    check(bool(group['name']) and bool(group['include_reason']), 'Incomplete method group')\nsupplement = strategy['supplementary_plan']\ncheck(isinstance(supplement.get('purpose'),str) and bool(supplement['purpose'].strip()), 'Missing supplementary purpose')\ncheck(bool(supplement.get('planned_subsections')), 'No supplementary subsections')\nfor index, section in enumerate(supplement['planned_subsections']):\n    check(bool(section.get('heading')) and bool(section.get('grounded_content')), f'Incomplete supplementary section {index}')\n    source_ids = section.get('source_ids')\n    check(isinstance(source_ids,list) and bool(source_ids), f'Supplementary section {index}: source_ids must be non-empty')\n    for source_id in source_ids or []:\n        check(source_id in data['grounding_sources'], f'Unknown source {source_id}')\n    check(section['heading'] in memo, f'Memo missing supplementary heading {index}')\nconcept_count = 0\nfor figure in strategy['figure_specs']:\n    for field in ['figure_id','required','purpose','figure_type','preferred_generator','group_by','metric','split_by','preferred_span','target_width_fraction','layout_rationale','allow_progression','max_panels','max_categories_per_panel','max_series_per_panel']:\n        check(field in figure, f'Figure missing {field}')\n    concept_count += figure['preferred_generator'] == 'generate-concept-figure'\n    check(figure['preferred_generator'] in ['matplotlib','tikz','generate-concept-figure','native_latex','manual'], 'Invalid generator')\n    check(figure['preferred_span'] in ['column','full_width'], 'Invalid span')\n    check(0 < figure['target_width_fraction'] <= 1, 'Invalid width fraction')\n    check(figure['max_panels'] <= 4 and figure.get('max_panels_per_row',3) <= 3, 'Panel budget exceeded')\n    check(figure['max_categories_per_panel'] <= 6 and figure['max_series_per_panel'] <= 4, 'Density budget exceeded')\n    check(not figure['allow_progression'], 'Unexpected progression view')\n    check('5.5' in figure['layout_rationale'], 'Missing template geometry')\ncheck(concept_count <= 1, 'Multiple concept generators')\ncheck(any('LLM Usage' in note and 'mandatory' in note for note in strategy['notes_for_writer']), 'Lost mandatory disclosure')\ncheck('Separate Required Disclosure' in memo, 'Missing separate disclosure memo')\ncheck(not Path('paper.tex').exists() and not Path('claims_grounding.json').exists(), 'Stage boundary violated')\nfor suffix in ['status','outcome','correct']:\n    source = data['grounding_sources']['final.qualification.' + suffix]\n    check(source.get('value') == data['final_evaluation'][suffix], f'Qualification anchor mismatch: {suffix}')\nprint(json.dumps({'validation_scope':'strategy_only','ok':not errors,'hard_errors':errors,'grounded_supplementary_subsections':len(supplement['planned_subsections']),'required_figures':sum(figure['required'] for figure in strategy['figure_specs']),'final_qualification':{key:data['final_evaluation'][key] for key in ['status','outcome','correct']}},indent=2))\nif errors:\n    raise SystemExit(1)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
