aper/templates/:\nfigure_manifest.schema.json\n=== scientific-evidence\nscientific-evidence:\nSKILL.md\nscripts\n\nscientific-evidence/scripts/:\nscientific_evidence.py\nscientific_evidence.sh\n=== retrieve-references\nretrieve-references:\nSKILL.md\nscripts\ntemplates\n\nretrieve-references/scripts/:\nopenalex_fetch.py\ns2_fetch.py\nscholarly_fetch.py\n\nretrieve-references/templates/:\nprovenance.schema.json\n=== memory-log\nmemory-log:\nSKILL.md\nscripts\n\nmemory-log/scripts/:\nappend_memory.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
