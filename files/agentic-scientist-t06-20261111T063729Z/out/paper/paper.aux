\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Protocol overview (schematic). A comparison table is fit with a ridge-penalised Bradley--Terry model; a target adjacent pair (top or mid) is selected; a removal search proposes at most $2\%$ of rows; the task's metric, as we understand it, records the budget $k$ and score $1-k/k_{\mathrm  {cap}}$ for the returned set. The evaluator box, its refit step and the ``search again'' arrow depict this metric as we understand it, not an inspected implementation; the only refit we could inspect is the candidate's own. Random, influence-only and opponent-targeted removal serve as comparators; empty-set, label-permutation and cross-table copy runs serve as controls. Development tables (Arena 55k, MT-Bench human) and held-out tables (Arena 140k deduplicated, NBA) are kept separate.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:overview}{{1}{6}{Protocol overview (schematic). A comparison table is fit with a ridge-penalised Bradley--Terry model; a target adjacent pair (top or mid) is selected; a removal search proposes at most $2\%$ of rows; the task's metric, as we understand it, records the budget $k$ and score $1-k/\kcap $ for the returned set. The evaluator box, its refit step and the ``search again'' arrow depict this metric as we understand it, not an inspected implementation; the only refit we could inspect is the candidate's own. Random, influence-only and opponent-targeted removal serve as comparators; empty-set, label-permutation and cross-table copy runs serve as controls. Development tables (Arena 55k, MT-Bench human) and held-out tables (Arena 140k deduplicated, NBA) are kept separate}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Held-out removal budgets. $k$ is the recorded number of removed rows; percentages are $k/N$ (derived). B1 reports how many of 20 random orders flipped within the cap; B2 and B3 report the recorded budget of each comparator. The studied configuration and B2 coincide in every case.}}{6}{table.caption.11}\protected@file@percent }
\newlabel{tab:cases}{{2}{6}{Held-out removal budgets. $k$ is the recorded number of removed rows; percentages are $k/N$ (derived). B1 reports how many of 20 random orders flipped within the cap; B2 and B3 report the recorded budget of each comparator. The studied configuration and B2 coincide in every case}{table.caption.11}{}}
