{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018en35HnyhHHZxRUB7XCvLZ","type":"tool_result","content":"def fatal_result(started, smoke):\n    sequence = SMOKE_RESET_SEQUENCE if smoke else RESET_SEQUENCE\n    elapsed = time.monotonic() - started\n    episodes = [{\"seed\": s, \"kind\": \"primary\"} for s in dict.fromkeys(sequence)]\n    outcomes = [{\"score\": 0.0, \"duration\": elapsed / len(episodes)} for _ in episodes]\n    return {\"metrics\": worst_case_metrics(len(sequence)), \"correct\": False,\n            \"evidence\": seed_evidence(episodes, outcomes, [False] * len(episodes)), \"feasible\": False}\n\n\ndef slope_statistics(wl, episodes, outcomes):\n    widths, seeds = wl[\"widths\"], wl[\"seeds_used\"]\n    log_gap = np.zeros((len(widths), len(seeds)))\n    for i, e in enumerate(episodes):\n        if e[\"kind\"] == \"primary\":\n            log_gap[widths.index(e[\"width\"]), seeds.index(e[\"seed\"])] = math.log(outcomes[i][\"gap\"])\n    x = np.log2(np.asarray(widths, dtype=float))\n    xc = x - x.mean()\n    denom = float((xc ** 2).sum())\n    point = ols_slope(np.repeat(x, len(seeds)), log_gap.ravel())\n    if denom == 0.0:\n        return point, point, point\n    rng = np.random.default_rng(BOOTSTRAP_SEED)\n    draws = rng.integers(0, len(seeds), size=(BOOTSTRAP_RESAMPLES, len(seeds)))\n    # a seed resamples all of its widths together (cluster bootstrap over seeds)\n    means = log_gap[:, draws].mean(axis=2)                       # [width, resample]\n    slopes = (xc[:, None] * means).sum(axis=0) / denom\n    low, high = np.percentile(slopes, [2.5, 97.5])\n    return point, float(low), float(high)\n\n\ndef aggregate_plane(wl, episodes, outcomes, complete, reference, baseline_failures, elapsed, hard_deadline,\n                    total_rpc, rpc_count, reset_log, sequence):\n    prim = [i for i, e in enumerate(episodes) if e[\"kind\"] == \"primary\"]\n    ctrl = [i for i, e in enumerate(episodes) if e[\"kind\"] != \"primary\"