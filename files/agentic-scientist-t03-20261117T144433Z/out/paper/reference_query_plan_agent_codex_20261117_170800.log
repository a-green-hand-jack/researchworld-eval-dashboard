odes']).__name__)\nif isinstance(e['episodes'], list):\n print('EPISODES_LEN',len(e['episodes']))\n print('FIRST_EPISODE_KEYS',list(e['episodes'][0]))\n print('FIRST_EPISODE_SHAPES')\n for k,v in e['episodes'][0].items():\n  print(k, type(v).__name__, list(v) if isinstance(v,dict) else 'len='+str(len(v)) if isinstance(v,list) else str(v)[:500])\nPY\nsed -n '1,240p' source_evidence/downstream/program/src/program.py; cat source_evidence/downstream/program/src/IMPLEMENTATION_NOTES.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/sh -lc \"apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: memory.md\n+# Memory Log\n+## Context\n+- 2026-11-17 | step=paper | Reference planning only; no literature retrieval authorized. Apply the memory-log skill and preserve all existing global entries.\n+## Idea Discoveries\n+- 2026-11-17 | step=paper | Discovery: paper_data.json includes final evaluation episodes and copied candidate/baseline sources, so these take precedence over private recent-memory proposals. Next action: inspect episode metadata and method implementations before selecting queries.\n+## Program Evaluations\n+## Failures / Regressions\n+## Next Hypotheses\n*** End Patch\nPATCH\npython .codex/skills/memory-log/scripts/append_memory.py --global-memory-md ./global_memory/memory.md --global-memory-jsonl ./global_memory/memory.jsonl --event-json '{\\\"step\\\":\\\"paper\\\",\\\"scope\\\":\\\"paper\\\",\\\"summary\\\":\\\"Started reference planning from artifact evidence, not private proposal memory. gate=kept; trigger=none; reason=No new experimental result or revised method recommendation.\\\",\\\"evidence\\\":\\\"paper_data.json contains final_evaluation, episode-level evidence, three evaluated programs, and downstream source snapshots; no existing references.bib or references_provenance.json in workspace.\\\",\\\"next_action\\\":\\\"Inspect episode metadata and copied source to identify actual datasets, model families, sampling methods and negative results; do not retrieve references.\\\"}'\npython - <<'PY'\nimport json\nfrom pathlib import Path\np=json.loads(Path('paper_data.json').read_text())\nprint('FINAL_METRICS',json.dumps(p['final_evaluation']['metrics']))\nprint('LIMITATIONS',json.dumps(p['downstream_study']['limitations']))\ne=p['final_evaluation']['evaluation_evidence']\nprint('EVIDENCE_METADATA',json.dumps({k:v for k,v in e.items() if k\"'!='\"'episodes'}))\nprint('EPISODES_TYPE',type(e['episodes']).__name__)\nif isinstance(e['episodes'], list):\n print('EPISODES_LEN',len(e['episodes']))\n print('FIRST_EPISODE_KEYS',list(e['episodes'][0]))\n print('FIRST_EPISODE_SHAPES')\n for k,v in e['episodes'][0].items():\n  print(k, type(v).__name__, list(v) if isinstance(v,dict) else 'len='+str(len(v)) if isinstance(v,list) else str(v)[:500])\nPY\nsed -n '1,240p' source_evidence/downstream/program/src/program.py; cat source_evidence/downstream/program/src/IMPLEMENTATION_NOTES.md\"","aggregated_output":"FINAL_METRICS {\"combined_score\": 1.0, \"control_pass_fraction\": 1.0, \"correct\": 1, \"coverage\": 1.0, \"local_accuracy_quality\": 0.9999999999999954, \"matched_budget_gain\": -0.03883354541895445, \"reference_fidelity\": 0.9289530659189914, \"reference_resolution_quality\": 0.992225794670848, \"repeat_agreement\": 0.9458719135802469}\nLIMITATIONS [\"Investigation found no qualifying winner; selection used search evidence only.\", \"Unscored attempts are missing performance evidence, not measured losses.\", \"Search scores and sealed final metrics belong to different evaluation scopes.\", \"An unqualified final outcome may reflect validity or other criteria; do not infer that failure means only an inferior score. Interpret metrics within those limitations.\"]\nEVIDENCE_METADATA {\"candidate_diagnostics_trust\": \"unverified\", \"episode_count\": 2, \"path\": \"work/results/t03/codex/20261117_144926/final_evaluation/results/evaluation_evidence.json\", \"sha256\": \"sha256:f7e395541efdf4f0e1205b6bd2ed7a07f0a59d8b931f2ca8dfbe425ddfb1d1c5\", \"status\": \"available\"}\nEPISODES_TYPE list\nEPISODES_LEN 2\nFIRST_EPISODE_KEYS ['correct', 'duration_seconds', 'score', 'seed', 'solution']\nFIRST_EPISODE_SHAPES\ncorrect bool True\nduration_seconds float 222.47809640003834\nscore float 1.0\nseed int 7301\nsolution dict ['case_0', 'case_1', 'case_2', 'case_3', 'case_4', 'case_5', 'case_6', 'case_7']\n\"\"\"Finite-budget interventional Kernel SHAP, CPU/NumPy, handle-only API.\n\nAll requests/responses are finite JSON objects. Extra response keys are forbidden.\nSeeds are arbitrary nonnegative integers and initialize randomness, never workload.\nEvery episode starts with reset; subsequent independent explanations use start.\n\nreset: {\"op\":\"reset\",\"seed\":int} -> {\"ok\":true}. Erases all state.\nstart: {\"op\":\"start\", \"features\":int in [2,20], \"budget\":int in [32,256],\n        \"stream\":nonnegative int, \"input\":list[features],\n        \"background\":list[1..32][features], \"output\":\"positive_probability\",\n        \"value_function\":\"interventional_grouped\"}\n  Original columns are the players; numeric/string category values are opaque.\n  The evaluator masks complete original columns before training-fitted encoding.\n  Returns {\"masks\":list[budget][features]} of integer 0/1 values, first empty,\n  second full. All interior masks must be nonempty/nonfull. One live explanation;\n  start may discard prior state after a failure. No paths or model labels exist.\nobserve: {\"op\":\"observe\",\"values\":list[budget] of finite probabilities}\n  Supplies the background-averaged black-box model values in mask order.\n  Returns {\"phi\":list[features] of finite numbers, abs(value)<=1e6} on the\n  probability scale. Strings and booleans are not attribution numbers.\n  Consumes the live explanation. Solve a Shapley-kernel sampled constrained\n  regression: sampling a size proportional to 1/(size*(d-size)), then a uniform\n  subset, makes the interior least-squares weights equal. This implementation\n  stratifies that distribution, pairs complements when the design has enough\n  rows, and covers each size stratum without replacement before recycling.\n  Samples are dependent within a run, with the same kernel marginals.\n  Empty/full endpoints\n  impose exact efficiency (lstsq rcond=1e-10). Regression auditing uses\n  rtol=1e-6, atol=1e-7. The evaluator checks masks, budgets, the regression,\n  synthetic exact controls and reset replay, not candidate internal claims.\n\nBudgets include endpoints, duplicates and all model evaluations. No optimization\nor metric feedback is delivered. Independent repetitions have distinct stream\nIDs; same reset/stream/settings must replay deterministically. No training,\nstate export, file exchange, or large-value transport is needed: all bounded\nmessages fit below 64 MiB including JSON/envelope/framing. Larger shapes are\ninvalid, not requests to load files. Each run has exactly start + observe RPCs.\nSearch ranks evidence completion, not a favorable reliability conclusion. The\npaper still needs real results, uncertainty, references, official conference\ntemplate/checklist and all reproduction code; this starter is not a paper.\n\"\"\"\n\nfrom math import comb\n\nimport numpy as np\n\n_seed = 0\n_active = None\n\n\ndef _stratified_sizes(feature_count, count, generator):\n    \"\"\"Sample unordered complement strata with kernel-proportional marginals.\"\"\"\n    if count == 0:\n        return np.empty(0, dtype=np.int64)\n    sizes = np.arange(1, feature_count // 2 + 1, dtype=np.int64)\n    weights = 1.0 / (sizes * (feature_count - sizes))\n    weights *= np.where(2 * sizes == feature_count, 1.0, 2.0)\n    cumulative = np.cumsum(weights / weights.sum())\n    cumulative[-1] = 1.0\n    positions = (np.arange(count) + generator.random(count)) / count\n    selected = sizes[np.searchsorted(cumulative, positions, side=\"right\")]\n    generator.shuffle(selected)\n    return selected\n\n\ndef _draw_mask(feature_count, size, generator, visited):\n    \"\"\"Draw a uniformly oriented pair, without replacement within each cycle.\"\"\"\n    full_mask = (1 << feature_count) - 1\n    capacity = comb(feature_count, size)\n    if 2 * size == feature_count:\n        capacity //= 2\n    seen = visited.setdefault(size, set())\n    if len(seen) == capacity:\n        seen.clear()\n    while True:\n        columns = generator.choice(feature_count, size=size, replace=False)\n        encoded = sum(1 << int(column_index) for column_index in columns)\n        if 2 * size == feature_count:\n            encoded = min(encoded, full_mask ^ encoded)\n        if encoded not in seen:\n            seen.add(encoded)\n            break\n    if generator.integers(2):\n        encoded = full_mask ^ encoded\n    return np.asarray(\n        [(encoded >> column_index) & 1 for column_index in range(feature_count)],\n        dtype=np.int64,\n    )\n\n\ndef _coalition_design(feature_count, budget, generator):\n    \"\"\"Spend exactly budget rows, retaining rank headroom before pairing.\"\"\"\n    masks = np.zeros((budget, feature_count), dtype=np.int64)\n    masks[1] = 1\n    interior_count = budget - 2\n    pair_count = min(\n        interior_count // 2,\n        max(0, interior_count - 2 * (feature_count - 1)),\n    )\n    single_count = interior_count - 2 * pair_count\n    pair_sizes = _stratified_sizes(feature_count, pair_count, generator)\n    single_sizes = _stratified_sizes(feature_count, single_count, generator)\n    visited = {}\n    row_index = 2\n    for size in pair_sizes:\n        mask = _draw_mask(feature_count, int(size), generator, visited)\n        masks[row_index] = mask\n        masks[row_index + 1] = 1 - mask\n        row_index += 2\n    for size in single_sizes:\n        masks[row_index] = _draw_mask(feature_count, int(size), generator, visited)\n        row_index += 1\n    generator.shuffle(masks[2:])\n    return masks\n\n\ndef handle(request):\n    global _seed, _active\n    operation = request[\"op\"]\n    if operation == \"reset\":\n        if type(request[\"seed\"]) is not int or request[\"seed\"] < 0:\n            raise ValueError(\"invalid seed\")\n        _seed = request[\"seed\"]\n        _active = None\n        return {\"ok\": True}\n    if operation == \"start\":\n        features = request[\"features\"]\n        budget = request[\"budget\"]\n        if not 2 <= features <= 20 or not 32 <= budget <= 256:\n            raise ValueError(\"unsupported shape\")\n        generator = np.random.default_rng(np.random.SeedSequence([_seed, request[\"stream\"]]))\n        masks = _coalition_design(features, budget, generator)\n        _active = masks\n        return {\"masks\": masks.tolist()}\n    if operation == \"observe\":\n        if _active is None:\n            raise ValueError(\"no active explanation\")\n        masks = _active\n        values = np.asarray(request[\"values\"], dtype=np.float64)\n        total = values[1] - values[0]\n        design = masks[2:, :-1] - masks[2:, -1:]\n        target = values[2:] - values[0] - masks[2:, -1] * total\n        partial = np.linalg.lstsq(design, target, rcond=1e-10)[0]\n        attribution = np.append(partial, total - partial.sum())\n        _active = None\n        return {\"phi\": attribution.tolist()}\n    raise ValueError(\"unknown operation\")\n# Budget-matched coalition design\n\n## Implemented scope\n\nThe entrypoint remains `program.py:handle`. Its only responses are the original\n`{\"ok\": true}`, `{\"masks\": ...}`, and `{\"phi\": ...}`. Reset erases the live\nexplanation; start creates or replaces it; observe consumes it. Seed and stream\ninitialize all randomness. Input/background fields remain opaque: the supplied\ninterface owns masking, fitted preprocessing, and probability evaluation.\n\nThe candidate changes the coalition design, not the estimand or regression.\nEmpty and full coalitions remain first and second. Exactly the requested number\nof rows is returned, including duplicate rows and endpoints; no hidden model\ncalls or extra observations are used. Observe uses the starter's identical\nefficiency-constrained, equal-weight least-squares solve and tolerance.\n\n## Sampling method\n\nFor dimension d, combine sizes s and d-s into an unordered complement stratum.\nIts probability is proportional to 2/[s(d-s)], except the central size in even\ndimensions, whose weight is 1/[s(d-s)]. Randomized equal-probability strata of\nthe cumulative distribution reduce variation in size counts. Randomly permute\nthe selected sizes and choose uniform subsets within each size. Remember chosen\nunordered complement pairs until that size's finite population is exhausted,\nthen start another cycle. Random orientation restores the original distribution\nover individual masks. Each mask has the original kernel marginal distribution;\nthe masks are intentionally not independent within a run.\n\nComplementary observations constrain the odd part of the coalition response\ntogether and can reduce Monte Carlo variability. However, their regression\ndesign rows are negatives of one another, so they do not provide two independent\ndesign directions. If N is the interior row budget, use at most\nmin(floor(N/2), max(0, N-2(d-1))) pairs. The remaining rows are individually\nsampled from the same stratified distribution. Thus pairing alone cannot reduce\nthe number of potentially distinct directions below min(N, 2(d-1)). This is\nrank headroom, not a guarantee of full rank; the original least-squares rule\nstill handles singular designs. All mask generation is local to start, with\nno cross-explanation cache of coalition values or other run observations.\n\nThis design is a variance-reduction hypothesis, not an accuracy guarantee.\nKernel marginals alone do not imply unbiasedness of a finite-sample regression\ncoefficient, nor universal improvement from pairing. Neither repeat agreement\nnor exact efficiency establishes attribution accuracy or causal validity.\n\n## Interface limitations and unperformed work\n\nThe interface does not expose a prediction callable, dataset identifiers,\ntraining controls, original row identifiers, timing of black-box evaluation,\nor independently queryable reference values. Consequently this candidate cannot\nimplement the proposed fixed-model Pima/ACS exact-reference study, German Credit\nreference ensembles, prediction-row cap calibration, package-based SHAP calls,\nbackground-resampling experiments, clustered reliability bootstrap, or empirical\npaper. The background length is visible, but is not evidence of how many model\nrows the external implementation actually evaluated. No such measurements or\nartifacts are fabricated, and no diagnostic keys are added to the response.\n\nNo experiments, tests, literature searches, package installations, or evaluations\nwere run during this implementation stage. In particular there are no measured\nreliability claims, performance results, verified official conference templates,\nor completed paper deliverables. Only static source inspection was authorized.\n","exit_code":0,"status":"completed"}}
