{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nj=json.load(open('claims_grounding.json'))\nprint('KEYS',list(j))\nfor n,c in enumerate(j['claims']):print(n,json.dumps(c))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nj=json.load(open('claims_grounding.json'))\nprint('KEYS',list(j))\nfor n,c in enumerate(j['claims']):print(n,json.dumps(c))\nPY\"","aggregated_output":"KEYS ['claims']\n0 {\"claim\": \"The independent final evaluation completed, was qualified, and reports successful specified checks; qualification is not a superiority or shifted-validity result.\", \"source_ids\": [\"final.qualification.status\", \"final.qualification.outcome\", \"final.qualification.correct\", \"final.metric.control_check_pass_rate\"], \"citation_keys\": []}\n1 {\"claim\": \"The final study comprises eight seeds, six conditions (logistic-normal IID, Dirichlet IID, shifted Dirichlet at K=3 and 8), and alpha=0.05,0.10,0.20. All recorded cases are complete.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:37\", \"source_evidence/data_manifest.json\"], \"evidence_locator\": \"/final_evaluation/evaluation_evidence/episodes\"}\n2 {\"claim\": \"Final seeds are 1009,1013,1019,1021,1031,1033,1039,1049; train/calibration/test sizes are 1024/512/2048 with six covariates.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/data_manifest.json\", \"source_evidence/evaluate_final.py:727\"]}\n3 {\"claim\": \"Positive observed continuous compositions, not categorical labels or latent probabilities, are the response. The fixed Helmert ILR basis has K-1 coordinates.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:37\"]}\n4 {\"claim\": \"The design uses intercept, raw features, squares, sines and x0*x1. Center and log-residual ridge penalties are 1 and 10; intercept penalty is 1e-8; residual floor is .02.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:98\"]}\n5 {\"claim\": \"Centers are clipped to [-100,100] and positive base and corrected scales to [1e-4,100]. The base log-residual fit uses in-sample residuals; correction moments are cross-fitted.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:114\"]}\n6 {\"claim\": \"Three-fold training permutations use random seed 0. Moment features use standard deviation floor 1e-8; standardized residuals use scale floor 1e-4; queries are batched in 128 rows.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:109\"]}\n7 {\"claim\": \"Local moments average squared standardized ILR residuals over K-1 coordinates, Gaussian-smooth them over standardized covariates, and shrink the ratio toward 1 by prior mass.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:133\"]}\n8 {\"claim\": \"Moment ratios are clipped to [.25,4]; a common row-scalar multiplies all ILR scales, preserving their within-row ratios. The correction blends are 0,.5,1; bandwidths .5*sqrt(6),sqrt(6); prior masses 10,50.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:172\"]}\n9 {\"claim\": \"Nested three-fold training selection uses swapped pseudo-calibration/evaluation halves; the row-weighted alpha-averaged log arithmetic mean ILR-box volume is minimized, with smaller blend breaking ties.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:275\"]}\n10 {\"claim\": \"The selector uses exact finite ranks, Gaussian-loss fallback for unavailable ranks or invalid radii/objectives, and a neutral tiny-sample fallback. Realized fallback frequencies and selected settings are not retained.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:188\"]}\n11 {\"claim\": \"Global constant scale multiplication cancels its conformal radius, apart from clipping. At alpha .05, 18 internal calibration observations are insufficient for a finite rank; 19 suffice. Numerical invariance assertions are source checks, not a scientific ablation.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:237\"]}\n12 {\"claim\": \"Independent final calibration uses ceil((m+1)*(1-alpha)) order statistic with infinity when unavailable, and closed membership. It is not selected on calibration labels.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:836\"]}\n13 {\"claim\": \"The unscaled ILR comparator sets scales to one at the same center. Simplex max uses a joint coordinate maximum. Bonferroni calibrates K simplex coordinates at alpha/K, not ILR coordinates.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:857\"]}\n14 {\"claim\": \"Mass is uniform-simplex probability content estimated at 128 test contexts using 1024 shared Dirichlet(1) probes; utility equals (1-mass)*max(0,1-absolute_coverage_error/(1-alpha)). Errors are absolute before averaging.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:727\"]}\n15 {\"claim\": \"IID covariates are uniform on [-1.5,1.5]^6, logistic-normal noise standard deviation is .25, Dirichlet concentration is 4+35/(1+exp(2*x0)), and gamma coordinates are floored at 1e-12 before closure.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:727\"]}\n16 {\"claim\": \"The fixed mean is .7*sin(XW)+.3*x0*cos(j), with W[l,j]=sin(l*(K-1)+j+1)/3. Shift changes only test X to clipped N(.8,1) in [-2.5,3], changing covariate support as well as frequency.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:727\"]}\n17 {\"claim\": \"Independent random streams use SeedSequence([seed,case,split,202611]); reference split index is 3. Frozen resources are checked for numeric row-content disjointness, positivity, closure and hashes.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:727\"]}\n18 {\"claim\": \"Per-context mass resolution is 1/1024. Zero hits have a one-sided .95 upper bound 1-.05**(1/1024)=.00292124, not zero mass. Averaged plugin context standard errors do not quantify joint mass uncertainty.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:905\"]}\n19 {\"claim\": \"The evaluator resamples seed blocks 20000 times using RNG seed 62845. Paired utility intervals have optional tail probability .05/(2*54); volume intervals are unadjusted. Repeated uncertainty summaries are deduplicated.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:1036\"]}\n20 {\"claim\": \"Constant-input queries use training-mean features; nonidentity permutations rotate calibration and test rows separately. Whole-simplex and zero-radius references are degenerate metric controls, not useful calibrated baselines.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:929\"]}\n21 {\"claim\": \"The evaluated environment requires CPython 3.11 or 3.12 and NumPy 1.26.4 with native Linux isolation. No external dataset is downloaded for the synthetic study.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/evaluate_final.py:1186\"]}\n22 {\"claim\": \"The matched final evidence does not contain a selector-only Gaussian-versus-rank comparison or an original-initializer comparison. The earlier configurations are development evidence, not final ablations.\", \"source_ids\": [\"final.evidence.episodes\", \"result.top_program_01\", \"result.top_program_02\", \"result.top_program_03\"], \"citation_keys\": [], \"supporting_artifacts\": [\"source_evidence/selected_model.py:275\", \"source_evidence/development_gaussian.py:185\", \"source_evidence/development_joint.py:152\", \"paper_data.json\"]}\n23 {\"claim\": \"IID and shifted scaled-ILR absolute coverage errors are 0.013562011718750005 and 0.13034261067708333, respectively.\", \"source_ids\": [\"final.metric.iid_coverage_error\", \"final.metric.shift_coverage_error\"], \"citation_keys\": []}\n24 {\"claim\": \"The scaled-ILR mean utility is 0.661819668104677, mass 0.3034934467739529, and aggregate utility gap to the strongest standard comparator is 0.011594669497844157.\", \"source_ids\": [\"final.metric.final_score\", \"final.metric.mean_volume\", \"final.metric.baseline_utility_gap\"], \"citation_keys\": []}\n25 {\"claim\": \"Main summary table, scaled_ilr: {\\\"iid_error\\\": 0.013562011718750005, \\\"shift_error\\\": 0.13034261067708333, \\\"mass\\\": 0.3034934467739529, \\\"utility\\\": 0.6618196681046769, \\\"utility_ci95\\\": [0.6541870135283389, 0.6702210518782714]}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/summary.json\", \"build_analysis.py\"], \"evidence_locator\": \"analysis/summary.json#/methods/scaled_ilr\"}\n26 {\"claim\": \"Main summary table, unscaled_ilr: {\\\"iid_error\\\": 0.011428833007812512, \\\"shift_error\\\": 0.21623942057291665, \\\"mass\\\": 0.33818605211046004, \\\"utility\\\": 0.6046676445264709, \\\"utility_ci95\\\": [0.5979837051081343, 0.6106757253591186]}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/summary.json\", \"build_analysis.py\"], \"evidence_locator\": \"analysis/summary.json#/methods/unscaled_ilr\"}\n27 {\"claim\": \"Main summary table, simplex_linf: {\\\"iid_error\\\": 0.011170450846354164, \\\"shift_error\\\": 0.19736938476562502, \\\"mass\\\": 0.29170094596015084, \\\"utility\\\": 0.6502249986068328, \\\"utility_ci95\\\": [0.6438168744995187, 0.656831114206901]}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/summary.json\", \"build_analysis.py\"], \"evidence_locator\": \"analysis/summary.json#/methods/simplex_linf\"}\n28 {\"claim\": \"Main summary table, bonferroni: {\\\"iid_error\\\": 0.02037251790364582, \\\"shift_error\\\": 0.16195882161458333, \\\"mass\\\": 0.3192414707607693, \\\"utility\\\": 0.629594813617563, \\\"utility_ci95\\\": [0.6223210736029817, 0.6367253124148236]}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/summary.json\", \"build_analysis.py\"], \"evidence_locator\": \"analysis/summary.json#/methods/bonferroni\"}\n29 {\"claim\": \"New retained-data descriptive paired aggregate utility contrast, scaled ILR minus unscaled_ilr: {\\\"mean\\\": 0.05715202357820612, \\\"ci95\\\": [0.05093218763917902, 0.06416155229759228]}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/summary.json\", \"build_analysis.py\"], \"evidence_locator\": \"analysis/summary.json#/paired_overall/unscaled_ilr\"}\n30 {\"claim\": \"New retained-data descriptive paired aggregate utility contrast, scaled ILR minus simplex_linf: {\\\"mean\\\": 0.01159466949784424, \\\"ci95\\\": [0.004737770703221511, 0.017943424925238635]}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/summary.json\", \"build_analysis.py\"], \"evidence_locator\": \"analysis/summary.json#/paired_overall/simplex_linf\"}\n31 {\"claim\": \"New retained-data descriptive paired aggregate utility contrast, scaled ILR minus bonferroni: {\\\"mean\\\": 0.032224854487114, \\\"ci95\\\": [0.026729505955964253, 0.03770666663783662]}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/summary.json\", \"build_analysis.py\"], \"evidence_locator\": \"analysis/summary.json#/paired_overall/bonferroni\"}\n32 {\"claim\": \"Supplementary scaled-ILR mass and utility means for LN_IID_K3: [{\\\"alpha\\\": 0.05, \\\"mass\\\": 0.1307659149169922, \\\"utility\\\": 0.8620208903755012}, {\\\"alpha\\\": 0.1, \\\"mass\\\": 0.0975809097290039, \\\"utility\\\": 0.8955460136963261}, {\\\"alpha\\\": 0.2, \\\"mass\\\": 0.06755447387695312, \\\"utility\\\": 0.9126746720867231}]\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"supporting_artifacts\": [\"analysis/coverage_table.tex\", \"build_analysis.py\"]}\n33 {\"claim\": \"Coverage figure, text and extended table for LN_IID_K3: [{\\\"alpha\\\": 0.05, \\\"mean\\\": 0.9490966796875, \\\"ci95\\\": [0.94317626953125, 0.955810546875]}, {\\\"alpha\\\": 0.1, \\\"mean\\\": 0.89654541015625, \\\"ci95\\\": [0.890625, 0.9019775390625]}, {\\\"alpha\\\": 0.2, \\\"mean\\\": 0.7