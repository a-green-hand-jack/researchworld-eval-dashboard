 agreements.append(structure)\n            signs.extend(float((0 if abs(value)<=1e-8 else (1 if value>0 else -1))==(0 if abs(target)<=1e-8 else (1 if target>0 else -1))) for estimate in estimates for row,ref in zip(estimate,reference) for value,target in zip(row,ref))\n            table_row = f\\\"{episode['seed']} & {names[case['case']]} & {cap} & \\\"+' & '.join(f'{score:.4f}' for score in scores)\n            if table_row not in paper:\n                errors.append('Mismatched table: '+table_row)\n            stored = next(row for row in summary['final'] if row['seed']==episode['seed'] and row['case']==case['case'] and row['cap']==cap)\n            for method,score in zip(('standard','multistart','structure'),scores):\n                if abs(stored[method][0]-score)>1e-12:\n                    errors.append('Mismatch summary: '+str((episode['seed'],case['case'],cap,method)))\nprint('Final table and summary discrepancies:',errors)\nprint('Independent aggregate agreement:',statistics.mean(agreements))\nprint('Independent reference sign agreement:',statistics.mean(signs))\nprint('Maximum repeat vector difference:',repeat_max)\nprint('Model diagnostics:',cases)\nprint('Downstream study present:', 'downstream_study' in registry)\nfor fragment in ('main_rows','extended_rows','interval_rows'):\n    rows = [line for line in Path('tables/'+fragment+'.tex').read_text().splitlines() if not line.startswith('%')]\n    print(fragment, 'rows:',len(rows),'all verbatim in paper:', all(row in paper for row in rows))\nPY\"","aggregated_output":"Final table and summary discrepancies: []\nIndependent aggregate agreement: 0.9975639445869277\nIndependent reference sign agreement: 0.9993055555555556\nMaximum repeat vector difference: 0\nModel diagnostics: [(104729, 'german_logistic', {'fit_converged': True, 'fit_iterations': 19, 'validation_accuracy': 0.67}), (104729, 'german_forest', {'fit_converged': True, 'fit_iterations': 0, 'validation_accuracy': 0.65}), (104729, 'acs_logistic', {'fit_converged': True, 'fit_iterations': 13, 'validation_accuracy': 0.7609119544022799}), (104729, 'acs_forest', {'fit_converged': True, 'fit_iterations': 0, 'validation_accuracy': 0.7772611369431528}), (130363, 'german_logistic', {'fit_converged': True, 'fit_iterations': 19, 'validation_accuracy': 0.67}), (130363, 'german_forest', {'fit_converged': True, 'fit_iterations': 0, 'validation_accuracy': 0.69}), (130363, 'acs_logistic', {'fit_converged': True, 'fit_iterations': 13, 'validation_accuracy': 0.7609119544022799}), (130363, 'acs_forest', {'fit_converged': True, 'fit_iterations': 0, 'validation_accuracy': 0.775461226938653}), (155921, 'german_logistic', {'fit_converged': True, 'fit_iterations': 19, 'validation_accuracy': 0.67}), (155921, 'german_forest', {'fit_converged': True, 'fit_iterations': 0, 'validation_accuracy': 0.67}), (155921, 'acs_logistic', {'fit_converged': True, 'fit_iterations': 13, 'validation_accuracy': 0.7609119544022799}), (155921, 'acs_forest', {'fit_converged': True, 'fit_iterations': 0, 'validation_accuracy': 0.7765111744412779})]\nDownstream study present: False\nmain_rows rows: 4 all verbatim in paper: True\nextended_rows rows: 36 all verbatim in paper: True\ninterval_rows rows: 12 all verbatim in paper: True\n","exit_code":0,"status":"completed"}}
