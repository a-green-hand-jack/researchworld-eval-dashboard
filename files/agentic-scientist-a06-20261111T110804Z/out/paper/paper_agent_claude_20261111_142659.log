{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"Exit code 1\n\"\"\"Draft-time builder of the real-LLM outcome tensors (MMLU-Pro x 24 prompt configs).\nUsage: prep <search_n> <final_n> | score <model_dir> <pool> <shard> <nshards> <threads> [limit]\n\"\"\"\nimport sys, os\nead_parquet(f\"{W}/mmlu_pro/data/validation-00000-of-00001.parquet\")\n    def rows(df, split):\n        out = []\n        for r in df.itertuples():\n            opts = [str(o) for o in r.options]\n            out.append(dict(split=split, qid=int(r.question_id), q=r.question, opts=opts, ans=r.answer, cat=r.category,\n                            h=content_hash(r.question, opts)))\n        return out\n    T, V = rows(te, \"test\"), rows(va, \"validation\")\n    stats = dict(test_raw=len(T), validation_raw=len(V))\n    # dedup: validation (demonstration source) wins; within-split first occurrence wins\n    seen = {}\n    Vd = []\n    for r in V:\n        if r[\"h\"] not in seen: seen[r[\"h\"]] = 1; Vd.append(r)\n    Td = []\n    for r in T:\n        if r[\"h\"] not in seen: seen[r[\"h\"]] = 1; Td.append(r)\n    stats.update(validation_dedup=len(Vd), test_dedup=len(Td))\n    # length filter\n    keep = []\n    for r in Td:\n        n = len(tok(body_text(r[\"q\"], r[\"opts\"]))[\"input_ids\"])\n        if n <= MAX_BODY_TOKENS and len(r[\"opts\"]) == 10: keep.append(r)\n    stats[\"test_after_length_filter\"] = len(keep)\n    cats = sorted({r[\"cat\"] for r in keep})\n    assert len(cats) == 14, cats\n    rng = np.random.default_rng(20261027)\n    bycat = {c: [r for r in keep if r[\"cat\"] == c] for c in cats}\n    for c in cats:\n        idx = rng.permutation(len(bycat[c])); bycat[c] = [bycat[c][i] for i in idx]\n    total = sum(len(v) for v in bycat.values())\n    def take(n, offset):\n        sel = []\n        for c in cats:\n            k = int(round(n * len(bycat[c]) / total))\n            sel.extend(bycat[c][offset[c]:offset[c] + k]); offset[c] += k\n        return sel\n    off = {c: 0 for c in cats}\n    S = take(search_n, off); F = take(final_n, off)\n    # deterministic order within pool shuffled by seed\n    for name, P, sd in ((\"search\", S, 1), (\"final\", F, 2)):\n        idx = np.random.default_rng(777 + sd).permutation(len(P)); P[:] = [P[i] for i in idx]\n    hs, hf, hd = {r[\"h\"] for r in S}, {r[\"h\"] for r in F}, {r[\"h\"] for r in Vd}\n    ids_s, ids_f = {r[\"qid\"] for r in S}, {r[\"qid\"] for r in F}\n    assert not (hs & hf) and not (hs & hd) and not (hf & hd) and not (ids_s & ids_f)\n    assert len(hs) == len(S) and len(hf) == len(F)\n    stats.update(search_pool=len(S), final_pool=len(F), overlap_search_final=0, overlap_search_demo=0, overlap_final_demo=0)\n    # demonstrations: 3 per set from validation, seeded, distinct categories, sets disjoint\n    drng = np.random.default_rng(31337)\n    order = drng.permutation(len(Vd))\n    picked, used = [], set()\n    for i in order:\n        if Vd[i][\"cat\"] not in used: used.add(Vd[i][\"cat\"]); picked.append(Vd[i])\n        if len(picked) == 6: break\n    demos = [picked[:3], picked[3:]]\n    json.dump(dict(stats=stats, cats=cats, demos=[[dict(qid=d[\"qid\"], q=d[\"q\"], opts=d[\"opts\"], ans=d[\"ans\"], cat=d[\"cat\"], h=d[\"h\"]) for d in ds] for ds in demos],\n                   search=[dict(qid=r[\"qid\"], q=r[\"q\"], opts=r[\"opts\"], ans=r[\"ans\"], cat=r[\"cat\"], h=r[\"h\"]) for r in S],\n                   final=[dict(qid=r[\"qid\"], q=r[\"q\"], opts=r[\"opts\"], ans=r[\"ans\"], cat=r[\"cat\"], h=r[\"h\"]) for r in F]),\n              open(f\"{W}/pools.json\", \"w\"))\n    print(json.dumps(stats))\n\ndef score(model_dir, pool, shard, nshards, threads, limit=None):\n    import torch\n    torch.set_num_threads(threads)\n    from transformers import AutoTokenizer, AutoModelForCausalLM\n    tok = AutoTokenizer.from_pretrained(model_dir)\n    model = AutoModelForCausalLM.from_pretrained(model_dir, dtype=torch.bfloat1\n{'audit': {'checked': 'normalized con