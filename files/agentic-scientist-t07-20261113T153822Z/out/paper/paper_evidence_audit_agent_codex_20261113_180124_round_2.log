{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/sh -lc \"PYTHONDONTWRITEBYTECODE=1 /opt/autoillustrate-venv/bin/python - <<'PY'\nimport json,csv,math\nfrom pathlib import Path\nimport numpy as np\n\ndef ranks(values):\n    order=np.argsort(values,kind='stable'); result=np.empty(len(values),float); start=0\n    while start<len(values):\n        stop=start+1\n        while stop<len(values) and values[order[stop]]==values[order[start]]: stop+=1\n        result[order[start:stop]]=(start+stop-1)/2\n        start=stop\n    return result\n\ndef stats(truth,predicted):\n    error=predicted-truth\n    if np.ptp(truth)==0 or np.ptp(predicted)==0: spearman=kendall=0.\n    else:\n        spearman=float(np.corrcoef(ranks(truth),ranks(predicted))[0,1])\n        truth_sign=np.sign(truth[:,None]-truth[None,:]); prediction_sign=np.sign(predicted[:,None]-predicted[None,:])\n        kendall=float((truth_sign*prediction_sign).sum()/math.sqrt(np.count_nonzero(truth_sign)*np.count_nonzero(prediction_sign)))\n    return [float(np.abs(error).mean()),float(np.sqrt((error**2).mean())),spearman,kendall]\n\nregistry=json.loads(Path('paper_data.json').read_text()); derived=json.loads(Path('derived_results.json').read_text())\nepisodes=registry['final_evaluation']['evaluation_evidence']['episodes']; issues=[]\nmethods=derived['methods']; budget_methods=derived['budget_methods']; cases=derived['cases']; weights=[.5/4]*4+[.5/6]*6\ncase_means=[]; budget_mae=np.zeros((4,3)); budget_rank=np.zeros((4,3)); ledger={}; expected_seed_lines=[]\nlabels=['BBH','GPQA','MuSR','OL-Math','Commonsense','GSM','LegalBench','MATH','MedQA','MMLU']\nfor index,name in enumerate(cases):\n    available=[]; errors=[]; correlations=[]; case_metrics=[]\n    for episode in episodes:\n        case=episode['solution']['cases'][name]; truth=np.asarray(case['target_full_means'])\n        values={key:np.asarray(value['predictions']) if value['completed'] and value['predictions'] is not None else None for key,value in case['conditions'].items()}\n        values.update({key:np.asarray(value) for key,value in (case['baseline_predictions'] or {}).items()})\n        for method in list(case['conditions'])+['anchor','irt','uniform','source_mean']:\n            for budget_index,budget in enumerate(episode['solution']['budgets']):\n                predicted=values.get(method)\n                ledger[name,episode['seed'],budget,method]=None if predicted is None else stats(truth,predicted[budget_index])\n        if all(values.get(method) is not None for method in methods):\n            available.append(episode['seed']); case_metrics.append([np.abs(values[method]-truth).mean() for method in methods])\n        if all(values.get(method) is not None for method in budget_methods):\n            errors.append([[ledger[name,episode['seed'],budget,method][0] for budget in episode['solution']['budgets']] for method in budget_methods])\n            correlations.append([[ledger[name,episode['seed'],budget,method][2] for budget in episode['solution']['budgets']] for method in budget_methods])\n        for method,condition in case['conditions'].items():\n            if condition['completed']:\n                expected=np.mean([ledger[name,episode['seed'],budget,method] for budget in episode['solution']['budgets']],axis=0)\n                recorded=[condition[key] for key in ['mae','rmse','spearman','kendall_tau_b']]\n                if not np.allclose(expected,recorded,atol=1e-12): issues.append(('recorded metrics',name,episode['seed'],method))\n        primary=case['conditions']['primary']; metric_text=' & '.join(f'{primary[field]:.4f}' for field in ['mae','rmse','spearman','kendall_tau_b']) if primary['completed'] else r'\\\\multicolumn{4}{c}{Missing; not a measured loss}'\n        expected_seed_lines.append(f'{labels[index]} & {episode[\\\"seed\\\"]} & {len(truth)} & {len(set(case[\\\"target_lineages\\\"]))} & '+metric_text+r' \\\\\\\\')\n    if available\"'!=derived['\"'common_support'][name]: issues.append(('support',name))\n    case_means.append(np.mean(case_metrics,axis=0)); budget_mae+=weights[index]*np.mean(errors,axis=0); budget_rank+=weights[index]*np.mean(correlations,axis=0)\nfor label,calculated in [('case_mae',case_means),('budget_mae',budget_mae),('budget_spearman',budget_rank)]:\n    if not np.allclose(calculated,derived[label],atol=1e-12): issues.append(('derived',label))\nrows=list(csv.DictReader(Path('complete_metrics.csv').open()))\nfor row in rows:\n    key=row['case'],int(row['seed']),int(row['budget']),row['method']; expected=ledger.pop(key)\n    actual=[row[field] for field in ['mae','rmse','spearman','kendall_tau_b']]\n    if expected is None:\n        if any(actual): issues.append(('missing ledger',key))\n    elif not np.allclose(expected,list(map(float,actual)),atol=1e-12): issues.append(('ledger',key))\nif ledger: issues.append(('missing CSV rows',len(ledger)))\ntext=Path('paper.tex').read_text()\nfor label,path in [('case_mae','tables/case_mae.tex'),('budget_metrics','tables/budget_metrics.tex'),('primary_seed_metrics','tables/primary_seed_metrics.tex')]:\n    body=text.split('% BEGIN GENERATED '+label+'\\\\n')[1].split('% END GENERATED '+label)[0]\n    if body.strip()\"'!=Path(path).read_text().strip(): issues.append(('\"'embedded table mismatch',label))\nif any(line not in text for line in expected_seed_lines): issues.append('seed table mismatch')\nprint('Numerical inconsistencies:',issues); print('Verified CSV rows:',len(rows)); print('Budget MAEs:',budget_mae.tolist()); print('Budget Spearman:',budget_rank.tolist())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
