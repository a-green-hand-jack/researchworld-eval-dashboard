{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\np=json.load(open('paper_data.json')); print(str(p['final_evaluation']['evaluation_evidence']['episodes'][0]['solution']['fixed_item_universes'])[:1300])\nPY\nsed -n '1,100p' .codex/skills/validate-paper/scripts/compile_latex.sh; sed -n '1,90p' .codex/skills/validate-paper/scripts/validate_figures.py\"","aggregated_output":"True\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
