\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Tokenization bias on a first-order Markov chain (Example~\ref {ex:markov}). Given the context token \texttt  {A}, the model never samples a next token starting with \texttt  {A}, although the correct probability is $1-\alpha $. This occurs when prompts end with a token that is part of a longer token, as is common in FIM tasks.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:markov1}{{2}{5}{Tokenization bias on a first-order Markov chain (Example~\ref {ex:markov}). Given the context token \str {A}, the model never samples a next token starting with \str {A}, although the correct probability is $1-\alpha $. This occurs when prompts end with a token that is part of a longer token, as is common in FIM tasks}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Third-order Markov chain: our conversion (Section~\ref {sec:method_sample}) recovers $P(x_{n+1}|x_{n-2}^{n})$.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:markov3}{{3}{5}{Third-order Markov chain: our conversion (Section~\ref {sec:method_sample}) recovers $P(x_{n+1}|x_{n-2}^{n})$}{figure.3}{}}
