ont_sizes'] = dict(title=9, axis=9, ticks=8.5, legend=8.5)\n+            entry['categories_per_panel'] = [3] * entry['n_panels']\n+            entry['series_per_panel'] = [4 if identifier == 'deployment_estimator_comparison' else 2] * entry['n_panels']\n+        manifest.append(entry)\n+    (ROOT / 'figure_manifest.json').write_text(json.dumps(dict(figures=manifest), indent=2) + '\\\\n')\n+    print('Reconstructed', len(cases), 'cases;', summary['cells'], 'cells; maximum error', max(errors))\n+    for case in cases:\n+        print(case['dataset'], case['family'], case['seed'], {key: round(value, 5) for key, value in case['metrics'].items()})\n+\n+\n+if __name__ == '__main__':\n+    main()\n*** End Patch\nPATCH\n/tmp/paper-tools/bin/python scripts/build_figures.py\"","aggregated_output":"Reconstructed 12 cases; 288 cells; maximum error 2.220446049250313e-16\ngerman logistic 7301 {'local_accuracy_quality': 1.0, 'matched_budget_gain': -0.05257, 'reference_fidelity': 0.91534, 'reference_resolution_quality': 0.98933, 'repeat_agreement': 0.90926}\ngerman forest 7301 {'local_accuracy_quality': 1.0, 'matched_budget_gain': -0.07376, 'reference_fidelity': 0.87102, 'reference_resolution_quality': 0.98104, 'repeat_agreement': 0.90185}\ngerman boosting 7301 {'local_accuracy_quality': 1.0, 'matched_budget_gain': -0.07966, 'reference_fidelity': 0.86417, 'reference_resolution_quality': 0.9809, 'repeat_agreement': 0.88287}\nacs logistic 7301 {'local_accuracy_quality': 1.0, 'matched_budget_gain': -0.00781, 'reference_fidelity': 0.96325, 'reference_resolution_quality': 1.0, 'repeat_agreement': 0.98056}\nacs forest 7301 {'local_accuracy_quality': 1.0, 'matched_budget_gain': -0.00176, 'reference_fidelity': 0.98973, 'reference_resolution_quality': 1.0, 'repeat_agreement': 0.99398}\nacs boosting 7301 {'local_accuracy_quality': 1.0, 'matched_budget_gain': -0.00347, 'reference_fidelity': 0.97728, 'reference_resolution_quality': 1.0, 'repeat_agreement': 0.98333}\ngerman logistic 9109 {'loca