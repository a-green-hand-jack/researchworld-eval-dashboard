{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"sed -n '195,280p' source_evidence/calibration/program.py; cat source_evidence/calibration/study.py; cat source_evidence/manifest.json\"","aggregated_output":"    return calibrator\n\n\ndef handle(request):\n    global _state\n    operation = request.get(\"op\")\n    if operation == \"reset\":\n        if set(request) != {\"op\", \"seed\"} or type(request[\"seed\"]) is not int or request[\"seed\"] < 0:\n            raise ValueError(\"invalid reset\")\n        _state = {\"seed\": request[\"seed\"], \"buffer\": bytearray(), \"chunks\": 0, \"meta\": None, \"done\": False}\n        return {\"ok\": True}\n    if _state is None or _state[\"done\"]:\n        raise ValueError(\"reset required\")\n    if operation == \"input\":\n        keys = {\"op\", \"n\", \"N\", \"alpha\", \"dtype\", \"encoding\", \"shape\", \"total_bytes\", \"chunk_count\", \"chunk_index\", \"offset\", \"data\"}\n        if set(request) != keys:\n            raise ValueError(\"invalid input schema\")\n        labeled_size, unlabeled_size = request[\"n\"], request[\"N\"]\n        total = request[\"total_bytes\"]\n        if any(type(request[key]) is not int for key in (\"n\", \"N\", \"total_bytes\", \"chunk_count\", \"chunk_index\", \"offset\")):\n            raise ValueError(\"integer metadata required\")\n        if min(labeled_size, unlabeled_size) < 2 or total != 8 * (2 * labeled_size + unlabeled_size) or not 0 < total <= 4 * 1024**2:\n            raise ValueError(\"invalid size\")\n        if request[\"dtype\"] != \"<f8\" or request[\"encoding\"] != \"base64\" or request[\"shape\"] != [2 * labeled_size + unlabeled_size] or request[\"alpha\"] != 0.05:\n            raise ValueError(\"invalid metadata\")\n        if not 1 <= request[\"chunk_count\"] <= 4 or request[\"chunk_index\"] != _state[\"chunks\"] or request[\"chunk_index\"] >= request[\"chunk_count\"] or request[\"offset\"] != len(_state[\"buffer\"]):\n            raise ValueError(\"invalid chunk sequence\")\n        metadata = {key: request[key] for key in (\"n\", \"N\", \"alpha\", \"dtype\", \"encoding\", \"shape\", \"total_bytes\", \"chunk_count\")}\n        if _state[\"meta\"] is not None and _state[\"meta\"] != metadata:\n            raise ValueError(\"metadata changed\")\n        if not isinstance(request[\"data\"], str) or len(request[\"data\"]) > 1398104:\n            raise ValueError(\"oversized chunk\")\n        raw = base64.b64decode(request[\"data\"], validate=True)\n        if not 0 < len(raw) <= 1024**2 or len(_state[\"buffer\"]) + len(raw) > total:\n            raise ValueError(\"invalid chunk size\")\n        _state[\"meta\"] = metadata\n        _state[\"buffer\"].extend(raw)\n        _state[\"chunks\"] += 1\n        return {\"ok\": True, \"received_bytes\": len(_state[\"buffer\"])}\n    if operation != \"infer\" or set(request) != {\"op\"}:\n        raise ValueError(\"invalid operation\")\n    metadata = _state[\"meta\"]\n    if metadata is None or _state[\"chunks\"] != metadata[\"chunk_count\"] or len(_state[\"buffer\"]) != metadata[\"total_bytes\"]:\n        raise ValueError(\"incomplete input\")\n    from scipy.special import betaincinv\n    values = np.frombuffer(_state[\"buffer\"], dtype=\"<f8\")\n    labeled_size, unlabeled_size = metadata[\"n\"], metadata[\"N\"]\n    labels = values[:labeled_size]\n    predictions = values[labeled_size:2 * labeled_size]\n    unlabeled = values[2 * labeled_size:]\n    if not np.isfinite(values).all() or np.any(values < 0) or np.any(values > 1) or np.any((labels != 0) & (labels != 1)):\n        raise ValueError(\"invalid array values\")\n    count = int(labels.sum())\n    alpha = metadata[\"alpha\"]\n    if labeled_size < 16:\n        estimate = float(labels.mean())\n        lower = 0.0 if count == 0 else float(betaincinv(count, labeled_size - count + 1, alpha / 2))\n        upper = 1.0 if count == labeled_size else float(betaincinv(count + 1, labeled_size - count, 1 - alpha / 2))\n    else:\n        intervals = honest_score_intervals(labels, predictions, unlabeled, alpha, _state[\"seed\"])\n        estimate = intervals[\"estimate\"]\n        lower, upper = intervals[\"wald\"]\n    _state[\"done\"] = True\n    _state[\"buffer\"] = bytearray()\n    return {\"estimate\": float(estimate), \"lower\": lower, \"upper\": upper}\n\"\"\"Offline mathematical/reporting utilities, not additional RPC operations.\n\nThese helpers have not been executed in this stage. They do not generate or\nclaim empirical evidence and are never called by candidate inference. All\ncomparisons must use identical observations and repetition identifiers.\n\"\"\"\n\nimport math\n\nimport numpy as np\nfrom scipy.stats import binomtest, t\n\n\ndef oracle_frontier(labeled_count, unlabeled_count, conditional_noise_variance,\n                    regression_variance, nonlinear_projection_error):\n    \"\"\"Population moments must be known analytically, not estimated from truth leaks.\"\"\"\n    if min(labeled_count, unlabeled_count) < 2:\n        raise ValueError(\"two nonempty variance samples required\")\n    if min(conditional_noise_variance, regression_variance, nonlinear_projection_error) < 0:\n        raise ValueError(\"negative variance moment\")\n    if nonlinear_projection_error > regression_variance + 1e-12:\n        raise ValueError(\"projection error exceeds regression variance\")\n    oracle_variance = conditional_noise_variance / labeled_count + regression_variance / (labeled_count + unlabeled_count)\n    oracle_gain = unlabeled_count * nonlinear_projection_error / (labeled_count * (labeled_count + unlabeled_count))\n    return {\"oracle_variance\": float(oracle_variance),\n            \"best_affine_variance\": float(oracle_variance + oracle_gain),\n            \"oracle_gain\": float(oracle_gain)}\n\n\ndef paired_uncertainty(covered, candidate_widths, baseline_widths):\n    \"\"\"Exact binomial coverage CI and paired t width-difference CI across iid runs.\"\"\"\n    covered = np.asarray(covered, dtype=bool)\n    candidate_widths = np.asarray(candidate_widths, dtype=float)\n    baseline_widths = np.asarray(baseline_widths, dtype=float)\n    if covered.ndim != 1 or candidate_widths.shape != covered.shape or baseline_widths.shape != covered.shape or covered.size < 2:\n        raise ValueError(\"at least two paired repetitions required\")\n    if not np.isfinite(candidate_widths).all() or not np.isfinite(baseline_widths).all() or np.any(candidate_widths < 0) or np.any(baseline_widths < 0):\n        raise ValueError(\"invalid widths\")\n    coverage_count = int(np.count_nonzero(covered))\n    coverage_interval = binomtest(coverage_count, len(covered)).proportion_ci(confidence_level=0.95, method='exact')\n    paired_width_difference = candidate_widths - baseline_widths\n    difference_mean = float(np.mean(paired_width_difference))\n    difference_se = float(np.std(paired_width_difference, ddof=1) / math.sqrt(len(covered)))\n    critical = float(t.ppf(0.975, len(covered) - 1))\n    return {\n        \"repetitions\": len(covered),\n        \"coverage_count\": coverage_count,\n        \"coverage\": float(np.mean(covered)),\n        \"coverage_interval\": [float(coverage_interval.low), float(coverage_interval.high)],\n        \"mean_width\": float(np.mean(candidate_widths)),\n        \"mean_width_se\": float(np.std(candidate_widths, ddof=1) / math.sqrt(len(covered))),\n        \"baseline_mean_width\": float(np.mean(baseline_widths)),\n        \"paired_width_difference\": difference_mean,\n        \"paired_width_difference_interval\": [difference_mean - critical * difference_se,\n                                             difference_mean + critical * difference_se],\n    }\n\n\ndef repetition_record(repetition, method, estimate, lower, upper, validity_track):\n    \"\"\"Serializable per-repetition record; caller controls persistence, not RPC.\"\"\"\n    if validity_track not in {\"asymptotic\", \"finite_sample\", \"oracle_asymptotic\"}:\n        raise ValueError(\"unknown validity track\")\n    record = {\"repetition\": int(repetition), \"method\": str(method),\n              \"estimate\": float(estimate), \"lower\": float(lower),\n              \"upper\": float(upper), \"width\": float(upper - lower)}\n    record['validity_track'] = validity_track\n    return record\n{\n  \"sources\": [\n    {\n      \"path\": \"source_evidence/calibration/METHOD.md\",\n      \"sha256\": \"69da4d2347b598b1490950e3c7342c437c055455ce3a1929a4d88251f84ab336\",\n      \"copied_from\": \"results/ideas/02_honest_nonlinear_score_controls_with_a_finite_sample_safety_track/program_1/src/METHOD.md\",\n      \"mounted_original_checked\": true\n    },\n    {\n      \"path\": \"source_evidence/calibration/program.py\",\n      \"sha256\": \"0bfc70abb5bf7e7542f664b52f6a8ac1644447b26d3fcf6647f69f2d49ca0b35\",\n      \"copied_from\": \"results/ideas/02_honest_nonlinear_score_controls_with_a_finite_sample_safety_track/program_1/src/program.py\",\n      \"mounted_original_checked\": true\n    },\n    {\n      \"path\": \"source_evidence/calibration/program_spec.toml\",\n      \"sha256\": \"a48b9b611bd9c1404b766f8fca65f0e2b2882b8b1ef410903f7e712fcfca4f1d\",\n      \"copied_from\": \"results/ideas/02_honest_nonlinear_score_controls_with_a_finite_sample_safety_track/program_1/program_spec.toml\",\n      \"mounted_original_checked\": true\n    },\n    {\n      \"path\": \"source_evidence/calibration/study.py\",\n      \"sha256\": \"9131305c119e13308c353dbfd98506efa09d5462065ac0e89d96df0121efb888\",\n      \"copied_from\": \"results/ideas/02_honest_nonlinear_score_controls_with_a_finite_sample_safety_track/program_1/src/study.py\",\n      \"mounted_original_checked\": true\n    }\n  ],\n  \"final_source_identity\": \"unverified\",\n  \"final_tree_hash\": \"sha256:980ddc8e93b7f07cab282a238d5934762740a6ace7b280c34d278de79a94c00b\"\n}\n","exit_code":0,"status":"completed"}}
