\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Mean interval width on the population-mean scale. Smaller values are not automatically preferable when coverage differs. PPI++ is slightly wider than score control only in C2; the exact-binomial comparison in C5 is unresolved by paired uncertainty.}}{6}{table.caption.6}\protected@file@percent }
\newlabel{tab:width}{{2}{6}{Mean interval width on the population-mean scale. Smaller values are not automatically preferable when coverage differs. PPI++ is slightly wider than score control only in C2; the exact-binomial comparison in C5 is unresolved by paired uncertainty}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Coverage and paired width differences across all conditions. (a,c) Empirical coverage with pointwise 95\% exact-binomial limits; dashed lines indicate nominal coverage. (b,d) Score-control minus comparator mean widths with paired-$t$ limits; negative values mean narrower. Colors identify the comparator in width panels and the interval method in coverage panels. Coverage and width scales differ between rows. PPI is retained in the tables and Figure~\ref {fig:rare}. No interval here is multiplicity-adjusted.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:comparison}{{2}{6}{Coverage and paired width differences across all conditions. (a,c) Empirical coverage with pointwise 95\% exact-binomial limits; dashed lines indicate nominal coverage. (b,d) Score-control minus comparator mean widths with paired-$t$ limits; negative values mean narrower. Colors identify the comparator in width panels and the interval method in coverage panels. Coverage and width scales differ between rows. PPI is retained in the tables and Figure~\ref {fig:rare}. No interval here is multiplicity-adjusted}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces C5 rare-outcome diagnostic, using all 256 endpoint records. (a) Empirical CDFs retain the mass at zero on a linear width axis. (b) Collapsed-interval counts. Labeled normal inference, omitted from this four-method display, also has 115 zero-width intervals. The associated coverage values appear in Table~\ref {tab:coverage}. Avoiding collapse does not establish nominal coverage or superiority to exact-binomial inference.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:rare}{{3}{7}{C5 rare-outcome diagnostic, using all 256 endpoint records. (a) Empirical CDFs retain the mass at zero on a linear width axis. (b) Collapsed-interval counts. Labeled normal inference, omitted from this four-method display, also has 115 zero-width intervals. The associated coverage values appear in Table~\ref {tab:coverage}. Avoiding collapse does not establish nominal coverage or superiority to exact-binomial inference}{figure.caption.8}{}}
