{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"diff -u source_evidence/development_gaussian.py source_evidence/selected_model.py | head -150; sed -n '225,238p' paper.tex; sed -n '100,112p' paper.tex; sed -n '929,958p' source_evidence/evaluate_final.py\"","aggregated_output":"--- source_evidence/development_gaussian.py\t2026-11-17 13:49:50.723294056 +0000\n+++ source_evidence/selected_model.py\t2026-11-17 13:23:55.382642990 +0000\n@@ -1,10 +1,13 @@\n-\"\"\"Deterministic training-only shrunk local-moment scaled-ILR regression.\n+\"\"\"Deterministic training-only rank-selected local-moment ILR regression.\n \n The incumbent centers and base scales are unchanged. Three outer training folds\n-select a scalar scale correction using nested three-fold residual tables and a\n-Gaussian log-score surrogate, not conformal outcomes. Fewer than five training\n-rows use the exact neutral correction because nested three-fold fitting is then\n-unavailable. No conditional or covariate-shift coverage guarantee is added.\n+select the existing scalar scale correction using nested residual tables and\n+swapped held-out pseudo-calibration/evaluation halves. Selection minimizes a\n+row-weighted, alpha-averaged log arithmetic mean ILR-box volume, not simplex\n+volume. Unavailable finite-sample ranks or invalid radii fall back to the original\n+Gaussian selector for the entire fit. Fewer than five training rows retain its\n+exact neutral correction. Independent evaluator calibration is untouched; no\n+conditional or covariate-shift coverage guarantee is added.\n \n Interface: handle(request: dict) -> dict, finite JSON only, no extra response keys.\n Keep the entrypoint self-contained in this file; native validation stages only this\n@@ -182,7 +185,7 @@\n     return adjusted_scales\n \n \n-def _select_correction(train_features, train_targets):\n+def _select_correction_gaussian(train_features, train_targets):\n     candidate_blends = (0.0, 0.5, 1.0)\n     feature_dimension = train_features.shape[1]\n     candidate_bandwidths = (0.5 * math.sqrt(feature_dimension), math.sqrt(feature_dimension))\n@@ -226,6 +229,125 @@\n     residual_table = build_oof_residual_table(train_features, train_targets)\n     distant_query = residual_table['location'][None, :] + 1e6 * residual_table['spread'][None, :]\n     assert np.allclose(_local_moment_ratio(residual_table, distant_query,\n+                                          selected_setting['bandwidth'],\n+                                          selected_setting['prior_mass']), 1.0)\n+    return selected_setting, residual_table\n+\n+\n+def _conformal_radius(calibration_scores, alpha):\n+    rank = math.ceil((len(calibration_scores) + 1) * (1.0 - alpha))\n+    if rank > len(calibration_scores): return None\n+    if not np.isfinite(calibration_scores).all(): return None\n+    radius = np.partition(calibration_scores, rank - 1)[rank - 1]\n+    if not np.isfinite(radius) or radius <= 0.0: return None\n+    return float(radius)\n+\n+\n+def _log_mean_box_volume(validation_scales, radius):\n+    coordinate_count = validation_scales.shape[1]\n+    log_box_volume = coordinate_count * np.log(2.0 * radius) + np.sum(np.log(validation_scales), axis=1)\n+    volume_shift = np.max(log_box_volume)\n+    log_mean_volume = volume_shift + np.log(np.mean(np.exp(log_box_volume - volume_shift)))\n+    return float(log_mean_volume)\n+\n+\n+def _assert_rank_selection_controls(calibration_scores, calibration_scales,\n+                                    validation_scales, selection_alphas):\n+    assert _conformal_radius(np.ones(18), 0.05) is None\n+    assert _conformal_radius(np.ones(19), 0.05) == 1.0\n+    assert _conformal_radius(np.zeros(19), 0.05) is None\n+    assert _conformal_radius(np.full(19, np.inf), 0.05) is None\n+    if (np.any(calibration_scales <= 1e-4) or np.any(calibration_scales >= 50.0)\n+            or np.any(validation_scales <= 1e-4) or np.any(validation_scales >= 50.0)):\n+        return\n+    for alpha in selection_alphas:\n+        radius = _conformal_radius(calibration_scores, alpha)\n+        rescaled_radius = _conformal_radius(calibration_scores / 2.0, alpha)\n+        assert radius is not None and rescaled_radius is not None\n+        assert np.allclose(radius * validation_scales,\n+                           rescaled_radius * (2.0 * validation_scales),\n+                           rtol=1e-12, atol=1e-12)\n+        assert np.isclose(_log_mean_box_volume(validation_scales, radius),\n+                          _log_mean_box_volume(2.0 * validation_scales, rescaled_radius),\n+                          rtol=1e-12, atol=1e-12)\n+\n+\n+def _select_correction(train_features, train_targets):\n+    selection_alphas = (0.05, 0.10, 0.20)\n+    outer_folds = _training_folds(len(train_features))\n+    rank_selection_available = all(\n+        math.ceil((len(half) + 1) * (1.0 - alpha)) <= len(half)\n+        for fold in outer_folds for half in np.array_split(fold, 2)\n+        for alpha in selection_alphas)\n+    if not rank_selection_available: return _select_correction_gaussian(train_features, train_targets)\n+    candidate_blends = (0.0, 0.5, 1.0)\n+    feature_dimension = train_features.shape[1]\n+    candidate_bandwidths = (0.5 * math.sqrt(feature_dimension), math.sqrt(feature_dimension))\n+    candidate_results = [\n+        {'blend': blend, 'bandwidth': bandwidth, 'prior_mass': prior_mass,\n+         'selection_loss': 0.0}\n+        for blend in candidate_blends for bandwidth in candidate_bandwidths\n+        for prior_mass in (10.0, 50.0)]\n+    all_indices = np.arange(len(train_features))\n+    for outer_valid_indices in outer_folds:\n+        outer_train_indices = np.setdiff1d(all_indices, outer_valid_indices)\n+        assert np.intersect1d(outer_train_indices, outer_valid_indices).size == 0\n+        half_positions = np.array_split(np.arange(len(outer_valid_indices)), 2)\n+        pseudo_splits = []\n+        for split_index in range(2):\n+            calibration_positions = half_positions[split_index]\n+            evaluation_positions = half_positions[1 - split_index]\n+            pseudo_calibration_indices = outer_valid_indices[calibration_positions]\n+            pseudo_evaluation_indices = outer_valid_indices[evaluation_positions]\n+            assert np.intersect1d(outer_train_indices, pseudo_calibration_indices).size == 0\n+            assert np.intersect1d(outer_train_indices, pseudo_evaluation_indices).size == 0\n+            assert np.intersect1d(pseudo_calibration_indices, pseudo_evaluation_indices).size == 0\n+            pseudo_splits.append((calibration_positions, evaluation_positions))\n+        outer_residual_table = build_oof_residual_table(train_features[outer_train_indices], train_targets[outer_train_indices])\n+        model = _fit_incumbent(train_features[outer_train_indices],\n+                               train_targets[outer_train_indices])\n+        heldout_centers, base_scales = _incumbent_predictions(\n+            model, train_features[outer_valid_indices])\n+        heldout_targets = (np.log(train_targets[outer_valid_indices])\n+                           @ _basis(train_targets.shape[1]))\n+        ratio_cache = {}\n+        for setting in candidate_results:\n+            blend = setting['blend']\n+            cache_key = (setting['bandwidth'], setting['prior_mass'])\n+            if blend == 0.0:\n+                moment_ratio = np.ones(len(outer_valid_indices))\n+            else:\n+                if cache_key not in ratio_cache:\n+                    ratio_cache[cache_key] = _local_moment_ratio(\n+                        outer_residual_table, train_features[outer_valid_indices],\n+                        setting['bandwidth'], setting['prior_mass'])\n+                moment_ratio = ratio_cache[cache_key]\n+            heldout_scales = apply_scale_correction(base_scales, moment_ratio, blend)\n+            assert np.array_equal(apply_scale_correction(base_scales, moment_ratio, 0.0), base_scales)\n+            for calibration_positions, evaluation_positions in pseudo_splits:\n+                calibration_targets = heldout_targets[calibration_positions]\n+                calibration_centers = heldout_centers[calibration_positions]\n+                calibration_scales = heldout_scales[calibration_positions]\n+                validation_scales = heldout_scales[evaluation_positions]\n+                calibration_scores = np.max(np.abs(calibration_targets - calibration_centers) / calibration_scales, axis=1)\n+                alpha_log_mean_volumes = []\n+                for alpha in selection_alphas:\n+                    radius = _conformal_radius(calibration_scores, alpha)\n+                    rank_selection_available = radius is not None\n+                    if not rank_selection_available: return _select_correction_gaussian(train_features, train_targets)\n+                    log_mean_volume = _log_mean_box_volume(validation_scales, radius)\n+                    rank_selection_available = np.isfinite(log_mean_volume)\n+                    if not rank_selection_available: return _select_correction_gaussian(train_features, train_targets)\n+                    alpha_log_mean_volumes.append(log_mean_volume)\n+                if setting is candidate_results[0]:\n+                    _assert_rank_selection_controls(calibration_scores, calibration_scales,\n+                                                    validation_scales, selection_alphas)\n+                fold_weight = len(evaluation_positions) / len(train_features)\n+                setting['selection_loss'] += fold_weight * float(np.mean(alpha_log_mean_volumes))\n+    selected_setting = min(candidate_results, key=lambda setting: (setting['selection_loss'], setting['blend']))\n\\paragraph{Why the negative comparisons matter.}\nThe mismatch between the selection objective and the evaluation reference measure is an explicit limitation of the construction. The result is compatible with that mismatch, but does not isolate it as the cause of unfavorable mass differences. The shift also jointly changes support, feature frequencies, and the frequency of high-variability responses. Its adverse coverage cannot be attributed solely to extrapolation, scale misspecification, or one design choice without additional controlled evidence. Standard exchangeability theory explains why no unchanged guarantee is available, not the magnitude of the observed deficit.\n\n\\paragraph{Uncertainty and selection scope.}\nOnly the retained seed blocks quantify repetition. The audit framing is retrospective; its intervals do not adjust for choosing the manuscript's emphasis. Paired resampling respects dependence across conditions and nominal levels, but few independent blocks limit precision, especially at multiplicity-adjusted tails. Conditional-on-fit Wilson intervals, Monte Carlo mass diagnostics, and seed-bootstrap intervals answer different questions. Shared probes introduce dependence across contexts, so an average of per-context standard errors is not a confidence interval for the overall mass. The main comparisons and the overall utility gap are descriptive; no claim is made that they remain significant after arbitrary selection of endpoints or across unobserved tasks.\n\n\\paragraph{Domain and geometric scope.}\nThe study has no public-data experiment, alternative ILR basis, learned covariance region, structural-zero response, or independent boundary-face reference measure. Positivity flooring makes logratios computable but is not a principled solution for true zeros. Uniform-simplex mass is a clearly defined reference measure, not a universal notion of user-relevant uncertainty. Its dimension dependence and finite probe resolution can hide small or boundary-concentrated regions. Conversely, a smaller mass need not imply better prediction for the actual response law. These limitations prevent conclusions about classification label sets, latent probability regions, or general deployment reliability.\n\n\\paragraph{Practical interpretation.}\nThe evidence recommends an evaluation discipline rather than a universal method choice: specify the response being covered, state the reference measure, compare matched configurations, retain condition-specific failures, and distinguish marginal from conditional and shifted validity. Aggregate utility can be useful for summarization only after its components are visible. Where support changes or calibration is reused for selection, assumptions must be reassessed rather than inferred from an apparently favorable score. Neither issue is repaired by a publication decision or by satisfying a completion check.\n\n\\section{Conclusion}\nScale-adaptive conformal regions for continuous compositions exhibit a measurable but bounded reliability--efficiency trade-off. In the evaluated synthetic settings, independent split calibration gives near-target IID behavior, and the complete scaling construction improves aggregate utility relative to the unscaled matched-center alternative. Against the simplex-coordinate maximum-residual baseline, however, the positive aggregate utility difference coexists with larger overall simplex mass, favorable higher-dimensional IID Dirichlet comparisons, and adverse shifted comparisons. No uniformly superior region construction emerges from these measurements.\n\n\\subsection{Compared region constructions}\n\\textbf{Scaled ILR} uses Eq.~\\eqref{eq:score} with the fitted scales described below. \\textbf{Unscaled ILR} retains exactly the same center and basis but sets every scale to one; it removes the entire scaling package, not only the local correction. \\textbf{Simplex max} maps the common center through $h$ and calibrates $\\max_k|y_k-h_k(\\widehat\\mu(x))|$. \\textbf{Bonferroni} calibrates separate absolute residuals in each simplex coordinate at miscoverage $\\alpha/K$ and intersects the resulting intervals with the simplex. The latter is a simultaneous-coordinate baseline, not a collection of independently claimed marginal intervals. The unscaled joint-maximum and coordinatewise Bonferroni constructions are also described in multivariate conformal prediction \\citep{FanSesia2025}; here, both are intersected with the simplex. All thresholds use their own appropriate calibration residuals from the same calibration split. % @evidence[[source_evidence/evaluate_final.py#method_records]]\n% @evidence[[literature/FanSesia2025.json#/excerpts/algorithms_S1_S2]]\n\nThese comparisons hold center predictions fixed while changing the residual geometry or scaling. The unscaled comparison can support conclusions about the complete scaling construction within this evaluation. It cannot identify the effect of local smoothing, cross-fitting, shrinkage, or the selector individually. The simplex comparison additionally changes coordinates, so any observed contrast is a comparison between region constructions rather than a causal estimate for one isolated component.\n\n\\section{Method: Training-Only Scale Adaptation}\n\\label{sec:method}\n\\subsection{Rationale and base fits}\nThe design hypothesis is that feature-dependent residual variability makes constant-width ILR regions inefficient, and that a bounded, shrunk correction may allocate widths more usefully. The counter-hypothesis is equally important: a correction selected using a transformed-space size objective may not reduce simplex mass, especially under extrapolation. The study evaluates these possibilities through paired region comparisons, not through a claim of optimal scale estimation.\n\nThe design vector is $\\phi(x)=(1,x,x^{\\odot2},\\sin x,x_0x_1)$, with coordinatewise squares and sine terms. Ridge regression of $z(Y)$ on $\\phi(X)$ uses penalty 1. A second ridge fit, with penalty 10, predicts $\\log\\max(|z_j(Y)-\\widehat\\mu_j(X)|,0.02)$ from the same design. These base-scale residuals are in-sample; cross-fitting is used for the subsequent moment correction, not retroactively for the base log-residual fit. The intercept penalty is $10^{-8}$. Predicted centers are clipped to $[-100,100]$ and base scales to $[10^{-4},100]$. These are numerical bounds, not distributional assumptions. % @evidence[[source_evidence/selected_model.py#_features]]\n\n\ndef evaluate_episode(episode, call, work_deadline):\n    arrays = episode['arrays']\n    dimension = arrays['y_train'].shape[1]\n    methods_remaining = 13\n    local_deadline = min(work_deadline, time.monotonic() + 13 * (WORK_SECONDS + METHOD_CLEANUP) + .5)\n    def allowance():\n        nonlocal methods_remaining\n        methods_remaining -= 1\n        return reserved_method_deadline(now=time.monotonic(), episode_deadline=local_deadline,\n            methods_remaining=methods_remaining, work_seconds=WORK_SECONDS, cleanup_seconds=METHOD_CLEANUP)\n    active_deadline = allowance()\n    def bounded_call(request):\n        check_deadline(active_deadline)\n        response = call(request, deadline=active_deadline)\n        check_deadline(active_deadline)\n        return response\n    completed = set()\n    unfitted = bounded_call({'op': 'predict', 'x': encode_array(arrays['x_train'][:2])})\n    if unfitted != {'status': 'unfitted'}:\n        raise ProtocolFailure('reset leakage control')\n    completed.add('reset_unfitted')\n    center_ack = bounded_call({'op': 'fit_center', 'x': encode_array(arrays['x_train']),\n                               'y': encode_array(arrays['y_train']), 'dimension': dimension})\n    if type(center_ack) is not dict or set(center_ack) != {'ok'} or center_ack['ok'] is not True:\n        raise ProtocolFailure('fit center acknowledgment')\n    scale_ack = bounded_call({'op': 'fit_scale'})\n    if type(scale_ack) is not dict or set(scale_ack) != {'ok'} or scale_ack['ok'] is not True:\n        raise ProtocolFailure('fit scale acknowledgment')\n","exit_code":0,"status":"completed"}}
