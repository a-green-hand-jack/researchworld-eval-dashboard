ources', 'final_evaluation', 'generated_at', 'grounding_sources', 'idea_titles', 'improvement_trace', 'paper_profile', 'presentation_contract', 'results_dir', 'top_programs', 'totals']\nFinal keys ['correct', 'evaluation_evidence', 'evaluator_sha256', 'manifest_path', 'metrics', 'outcome', 'program_tree_sha256', 'results_tree_sha256', 'status', 'task_tree_sha256']\n","exit_code":0,"status":"completed"}}
