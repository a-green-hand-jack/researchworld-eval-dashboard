{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"sed -n '566,627p' task/evaluate_final.py; sed -n '670,775p' task/evaluate_final.py; sed -n '945,986p' task/evaluate_final.py; sed -n '1,230p' results/ideas/02_cross_fitted_tail_adaptive_residual_scaling/program_1/src/program.py; cat .codex/skills/retrieve-references/templates/provenance.schema.json; cat scientific-evidence/schemas/artifact-manifest.schema.json; sed -n '1,130p' .codex/skills/write-paper-standalone/scripts/validate_claims.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"sed -n '566,627p' task/evaluate_final.py; sed -n '670,775p' task/evaluate_final.py; sed -n '945,986p' task/evaluate_final.py; sed -n '1,230p' results/ideas/02_cross_fitted_tail_adaptive_residual_scaling/program_1/src/program.py; cat .codex/skills/retrieve-references/templates/provenance.schema.json; cat scientific-evidence/schemas/artifact-manifest.schema.json; sed -n '1,130p' .codex/skills/write-paper-standalone/scripts/validate_claims.py\"","aggregated_output":"def basis(dimension):\n    result = np.zeros((dimension, dimension - 1))\n    for index in range(dimension - 1):\n        result[:index + 1, index] = 1 / math.sqrt((index + 1) * (index + 2))\n        result[index + 1, index] = -(index + 1) / math.sqrt((index + 1) * (index + 2))\n    return result\n\n\ndef simplex(latent, matrix):\n    logits = latent @ matrix.T\n    logits -= logits.max(axis=-1, keepdims=True)\n    probabilities = np.exp(logits)\n    return probabilities / probabilities.sum(axis=-1, keepdims=True)\n\n\ndef quantile(values, alpha):\n    rank = math.ceil((len(values) + 1) * (1 - alpha))\n    if rank > len(values):\n        return np.full(np.shape(values)[1:], np.inf)\n    return np.sort(values, axis=0)[rank - 1]\n\n\ndef geometry_tests():\n    for dimension in (3, 10):\n        matrix = basis(dimension)\n        assert np.allclose(matrix.T @ matrix, np.eye(dimension - 1), atol=1e-14)\n        assert np.allclose(matrix.sum(axis=0), 0, atol=1e-14)\n        latent = np.arange(dimension - 1)[None, :] / 10\n        response = simplex(latent, matrix)\n        assert np.all(response > 0) and np.allclose(response.sum(axis=1), 1)\n        assert np.allclose(np.log(response) @ matrix, latent)\n    assert quantile(np.arange(9), .2) == 7\n    assert math.isinf(float(quantile(np.arange(3), .05)))\n    assert np.array_equal(quantile(np.array([[1, 9], [3, 5], [2, 8]]), .5), [2, 8])\n    assert np.linalg.norm(np.array([3., 4.])) == 5\n    assert np.max(np.abs(np.array([.2, -.1, -.1]))) == .2\n\n\ndef generate_raw(case, lineage, sizes):\n    \"\"\"Reproduce the frozen original raw examples, before transforms or features.\"\"\"\n    dimension = int(case[1:])\n    matrix = basis(dimension)\n    rng = np.random.default_rng(np.random.SeedSequence(lineage))\n    covariates = rng.normal(size=(sum(sizes), 6))\n    if case[0] == 'S':\n        covariates[-sizes[-1]:, 0] += 1.25\n    coefficients = np.random.default_rng(333 + dimension).normal(0, .18, size=(6, dimension - 1))\n    latent_mean = covariates @ coefficients\n    if case[0] != 'H':\n        dominant = np.zeros(dimension)\n        dominant[0] = 4.5\n        latent_mean += dominant @ matrix\n    sigma = (np.full(len(covariates), .35) if case[0] == 'H'\n             else .12 + .8 / (1 + np.exp(-1.5 * covariates[:, 0])))\n    latent = latent_mean + sigma[:, None] * rng.normal(size=latent_mean.shape)\n    responses = simplex(latent, matrix)\n    if not np.isfinite(responses).all() or not np.all(responses > 0):\n        raise ValueError('invalid generated composition')\n    return covariates, responses\n\n\ndef raw_digest(array):\ndef wilson(hits, count):\n    if count <= 0:\n        raise ValueError('empty coverage group')\n    proportion = hits / count\n    denominator = 1 + 1.96**2 / count\n    center = (proportion + 1.96**2 / (2 * count)) / denominator\n    radius = 1.96 * math.sqrt(proportion * (1 - proportion) / count + 1.96**2 / (4 * count**2)) / denominator\n    return [max(0., center - radius), min(1., center + radius)]\n\n\ndef summarize(context, calibration_scores, test_scores, probe_scores, coordinatewise=False, conformal=True):\n    errors, group_errors, masses, details = [], [], [], []\n    for alpha in (.05, .10):\n        threshold = (quantile(calibration_scores, alpha / context['dimension'] if coordinatewise else alpha)\n                     if conformal else np.sort(calibration_scores, axis=0)[math.ceil(len(calibration_scores) * (1 - alpha)) - 1])\n        test_hits = np.all(test_scores <= threshold, axis=-1) if coordinatewise else test_scores <= threshold\n        probe_hits = np.all(probe_scores <= threshold, axis=-1) if coordinatewise else probe_scores <= threshold\n        coverage = float(test_hits.mean())\n        group_values, intervals = [], []\n        for group in (context['groups'], ~context['groups']):\n            if not group.any():\n                raise RequiredBaselineFailure('empty_fixed_group')\n            group_values.append(float(test_hits[group].mean()))\n            intervals.append(wilson(int(test_hits[group].sum()), int(group.sum())))\n        mass = float(probe_hits.mean())\n        errors.append(abs(coverage - (1 - alpha)))\n        group_errors.append(float(np.mean(np.abs(np.array(group_values) - (1 - alpha)))))\n        masses.append(mass)\n        details.append(dict(alpha=alpha, coverage=coverage, coverage_ci=wilson(int(test_hits.sum()), len(test_hits)),\n                            group_coverage=group_values, group_ci=intervals, reference_mass=mass,\n                            reference_mass_ci=wilson(int(probe_hits.sum()), probe_hits.size)))\n    marginal, group_error, mass = float(np.mean(errors)), float(np.mean(group_errors)), float(np.mean(masses))\n    utility = 1 - (.75 * (.5 * marginal + .5 * group_error) + .25 * mass)\n    if not all(math.isfinite(value) and 0 <= value <= 1 for value in (marginal, group_error, mass, utility)):\n        raise ValueError('nonfinite metric')\n    return dict(utility=utility, marginal=marginal, group=group_error, mass=mass, details=details)\n\n\ndef deranged_targets(residuals):\n    permutation = np.roll(np.arange(len(residuals)), 1)\n    if (np.any(permutation == np.arange(len(residuals)))\n            or np.array_equal(residuals[permutation], residuals)):\n        raise RequiredBaselineFailure('vacuous_permutation')\n    return permutation\n\n\ndef prepare_context(case, seed, raw, smoke):\n    covariates, responses, sizes = raw\n    dimension = responses.shape[1]\n    matrix = basis(dimension)\n    latent = np.log(responses) @ matrix\n    boundaries = np.cumsum([0] + sizes)\n    center_slice, train_slice, calibration_slice, test_slice = [slice(boundaries[index], boundaries[index + 1])\n                                                               for index in range(4)]\n    design = np.column_stack((np.ones(len(covariates)), covariates))\n    center_design = design[center_slice]\n    penalty = np.eye(7) * .01\n    penalty[0, 0] = 0\n    coefficients = np.linalg.solve(center_design.T @ center_design + penalty,\n                                   center_design.T @ latent[center_slice])\n    center = design @ coefficients\n    residual_vectors = latent - center\n    residuals = np.linalg.norm(residual_vectors, axis=1)\n    context = dict(dimension=dimension, train_x=covariates[train_slice], residuals=residuals[train_slice],\n                   calibration_x=covariates[calibration_slice], test_x=covariates[test_slice],\n                   calibration_residuals=residuals[calibration_slice], test_residuals=residuals[test_slice],\n                   groups=covariates[test_slice, 0] < 0)\n    count, probes = (8, 32) if smoke else (128, 1024)\n    selected = np.linspace(0, sizes[3] - 1, count, dtype=int)\n    reference_rng = np.random.default_rng(np.random.SeedSequence([seed, dimension, ord(case[0]), 8821]))\n    train_residuals = residual_vectors[:boundaries[2]]\n    covariance = np.cov(train_residuals, rowvar=False) + np.eye(dimension - 1) * .01\n    reference_noise = reference_rng.multivariate_normal(np.zeros(dimension - 1), covariance,\n                                                       size=(count, probes // 2))\n    reference_latent = center[test_slice][selected, None, :] + reference_noise\n    uniform_response = reference_rng.dirichlet(np.ones(dimension), size=(count, probes // 2))\n    uniform_latent = np.log(uniform_response) @ matrix\n    probe_latent = np.concatenate((reference_latent, uniform_latent), axis=1)\n    context['selected'] = selected\n    context['probe_residuals'] = np.linalg.norm(probe_latent - center[test_slice][selected, None, :], axis=-1)\n    raw_center = simplex(center, matrix)\n    raw_residuals = np.abs(responses - raw_center)\n    raw_probe_residuals = np.abs(simplex(probe_latent, matrix) - raw_center[test_slice][selected, None, :])\n    baselines = {}\n    baselines['global_ilr'] = summarize(context, residuals[calibration_slice], residuals[test_slice],\n                                       context['probe_residuals'])\n    baselines['raw_linf'] = summarize(context, raw_residuals[calibration_slice].max(axis=1),\n                                     raw_residuals[test_slice].max(axis=1), raw_probe_residuals.max(axis=-1))\n    baselines['bonferroni'] = summarize(context, raw_residuals[calibration_slice],\n                                       raw_residuals[test_slice], raw_probe_residuals, coordinatewise=True)\n    baselines['uncalibrated'] = summarize(context, residuals[train_slice], residuals[test_slice],\n                                        context['probe_residuals'], conformal=False)\n    full = summarize(context, np.ones(sizes[2]), np.zeros(sizes[3]), np.zeros((count, probes)))\n    copy = summarize(context, np.zeros(sizes[2]), residuals[test_slice], context['probe_residuals'])\n    if full['mass'] != 1 or any(item['coverage'] != 1 for item in full['details']):\n        raise RequiredBaselineFailure('full_simplex_sanity')\n    baselines['full_simplex'], baselines['copy_center'] = full, copy\n    context['copy_ok'] = (copy['mass'] == float(np.mean(context['probe_residuals'] == 0))\n                          and all(item['coverage'] == float(np.mean(residuals[test_slice] == 0))\n                                  for item in copy['details']))\n    context['baselines'] = baselines\n    context['permutation'] = deranged_targets(residuals[train_slice])\n    return context\n\n\ndef penalty():\n            control_passes += int(constant_ok) + int(permutation_ok) + int(copy_ok)\n            control_valid[key] = constant_ok and permutation_ok and copy_ok\n    control_fraction = control_passes / (3 * count + 1)\n    def mean_field(variant, field):\n        return float(np.mean([table[case, seed, variant][field] for case in CASES for seed in seeds]))\n    gaps = [table[case, seed, 'actual']['utility'] - contexts[case, seed]['baselines']['global_ilr']['utility']\n            if contexts[case, seed] is not None and (case, seed, 'actual') in completion else -1.\n            for case in CASES for seed in seeds]\n    metrics = dict(combined_score=mean_field('actual', 'utility') * control_fraction,\n                   marginal_coverage_error=mean_field('actual', 'marginal'),\n                   group_coverage_error=mean_field('actual', 'group'), reference_mass=mean_field('actual', 'mass'),\n                   global_ilr_score_gap=float(np.mean(gaps)), constant_control_score=mean_field('constant', 'utility'),\n                   permuted_control_score=mean_field('permuted', 'utility'), control_pass_fraction=control_fraction)\n    seed_scores = np.array([[table[case, seed, 'actual']['utility'] for seed in seeds] for case in CASES])\n    bootstrap = np.random.default_rng(67219).integers(0, len(seeds), size=(2000, len(seeds)))\n    sampled = seed_scores[:, bootstrap].mean(axis=(0, 2)) * control_fraction\n    paired_intervals = {}\n    for comparison in ('global_ilr', 'raw_linf', 'bonferroni', 'uncalibrated', 'constant', 'permuted'):\n        paired = np.array([[table[case, seed, 'actual']['utility'] - (\n            table[case, seed, comparison]['utility'] if comparison in VARIANTS\n            else contexts[case, seed]['baselines'][comparison]['utility'])\n            if contexts[case, seed] is not None and (case, seed, 'actual') in completion\n               and (comparison not in VARIANTS or ((case, seed, comparison) in completion\n                                                    and table[case, seed, comparison]['details'])) else -1.\n            for seed in seeds] for case in CASES])\n        paired_intervals[comparison] = list(map(float, np.quantile(paired[:, bootstrap].mean(axis=(0, 2)), [.025, .975])))\n    if PLANE == 'final':\n        metrics['combined_score_ci_low'], metrics['combined_score_ci_high'] = map(float, np.quantile(sampled, [.025, .975]))\n    feasible = (complete and not preparation_failed and len(completion) == 3 * count\n                and control_fraction == 1 and time.monotonic() < hard_deadline)\n    correct = feasible and control_fraction == 1 and not smoke\n    evidence = []\n    for seed in seeds:\n        solutions = []\n        for case in CASES:\n            context = contexts[case, seed]\n            solutions.append(dict(case=case,\n                                  variants={variant: table[case, seed, variant] for variant in VARIANTS},\n                                  baselines=context['baselines'] if context is not None else {},\n                                  controls_valid=control_valid[case, seed]))\n        evidence.append(dict(seed=seed, score=float(np.mean([table[case, seed, 'actual']['utility']\n                                                            for case in CASES])) * control_fraction,\n\"\"\"Train-only positive compositional residual-scale learner, python_rpc_v1:handle.\n\nAll requests/responses are finite JSON objects; extra response keys are forbidden.\nreset: {op:'reset', seed: nonnegative int} -> {ok:true}. Clears all model/transfer\nstate. Any seed is accepted; seeds initialize randomness, never select a workload.\nfit: {op:'fit', x:Array[n,6], residuals:Array[n], dimension:int>=2,\n      scale_min:0.0001, scale_max:10000.0} -> {ok:true}.\nOnly training covariates and training residual norms are provided. Fits replace the\nmodel. Prediction is read-only and requires a completed fit after reset.\npredict: {op:'predict', x:Array[n,6]} -> {scales:Array[n]}.\nReturn strictly positive finite scales; the evaluator consistently clips them to\n[0.0001,10000]. No calibration/test outcomes or later scoring feedback is given.\nArray is exactly {encoding:'base64',dtype:'<f8',shape:[...],nbytes:int,data:str}.\nData is C-order little-endian float64, n<=2048 normally; no file paths are used.\nWorkload dimensions/settings come from fit, not reset seeds. Candidate changes may\nchange the scale estimator but not evaluator-owned center, geometry or calibration.\n\nOptional bounded fallback, exercised by maximum-protocol tests, not needed for\nordinary shapes: begin {op:'begin',method:'fit'|'predict',fields:object,\narrays:{name:{shape:list,nbytes:int}},nbytes:int} -> {token:str}.\nfields holds the non-array logical request fields except op. Arrays, in insertion\norder, concatenate raw <f8 bytes; total <=8 MiB. upload {op:'upload',token:str,\noffset:int,data:base64str} -> {ok:true}, sequential <=2 chunks of <=4 MiB.\ncommit {op:'commit',token:str} -> {ok:true} validates lengths and computes once.\nexport_start {op:'export_start',token:str} -> {nbytes:int,chunks:int}.\nfetch {op:'fetch',token:str,index:int} -> {data:base64str}, sequential <=2 chunks.\nOutput is UTF-8 JSON for fit, raw <f8 scales for predict. release\n{op:'release',token:str} -> {ok:true} destroys buffers. One live token, <=32 MiB\ntransfer storage; reset invalidates it. No token is a path. At most 8 calls per\nlogical operation (begin,2 uploads,commit,export_start,2 fetches,release).\nNo self-reported learning, timing or diagnostics are accepted as scientific evidence.\n\"\"\"\nimport base64\nimport json\nimport math\nimport numpy as np\n\nMODEL = None\nTRANSFER = None\nCHUNK = 4 * 1024 * 1024\n\n\ndef decode(value):\n    if set(value) != {'encoding', 'dtype', 'shape', 'nbytes', 'data'}:\n        raise ValueError('array schema')\n    if value['encoding'] != 'base64' or value['dtype'] != '<f8':\n        raise ValueError('array encoding')\n    raw = base64.b64decode(value['data'], validate=True)\n    if len(raw) != value['nbytes'] or len(raw) != math.prod(value['shape']) * 8:\n        raise ValueError('array size')\n    result = np.frombuffer(raw, dtype='<f8').reshape(value['shape'])\n    if not np.isfinite(result).all():\n        raise ValueError('nonfinite input')\n    return result\n\n\ndef encode(array):\n    array = np.asarray(array, dtype='<f8', order='C')\n    return dict(encoding='base64', dtype='<f8', shape=list(array.shape),\n                nbytes=array.nbytes, data=base64.b64encode(array.tobytes()).decode('ascii'))\n\n\ndef features(array):\n    return np.column_stack((np.ones(len(array)), array, array * array))\n\n\ndef pinball_loss(target, prediction, quantile):\n    return np.maximum(quantile * (target - prediction), (quantile - 1.0) * (target - prediction))\n\n\ndef blend_log_scales(incumbent_log_scale, tail_log_scale, tail_weight):\n    return (1.0 - tail_weight) * incumbent_log_scale + tail_weight * tail_log_scale\n\n\ndef quantiles_from_counts(sorted_values, cumulative_counts, leaf_sizes, quantile):\n    positions = quantile * (leaf_sizes - 1)\n    lower_ranks = np.floor(positions)\n    upper_ranks = np.ceil(positions)\n    lower_indices = np.argmax(cumulative_counts > lower_ranks[:, None], axis=1)\n    upper_indices = np.argmax(cumulative_counts > upper_ranks[:, None], axis=1)\n    return (sorted_values[lower_indices]\n            + (positions - lower_ranks)\n            * (sorted_values[upper_indices] - sorted_values[lower_indices]))\n\n\ndef fit_quantile_stumps(features, log_norms, quantile, max_rounds, min_leaf):\n    learning_rate = 0.1\n    intercept = float(np.quantile(log_norms, quantile))\n    model = dict(intercept=intercept, learning_rate=learning_rate, stumps=[])\n    fitted_log_scale = np.full(len(log_norms), intercept)\n    if len(log_norms) < 2 * min_leaf:\n        return model\n    splits, masks = [], []\n    for feature_index in range(features.shape[1]):\n        thresholds = np.unique(np.quantile(features[:, feature_index],\n                                           np.linspace(0.05, 0.95, 15)))\n        for threshold in thresholds:\n            left_mask = features[:, feature_index] <= threshold\n            left_size = int(left_mask.sum())\n            if min_leaf <= left_size <= len(log_norms) - min_leaf:\n                splits.append((feature_index, float(threshold)))\n                masks.append(left_mask)\n    if not splits:\n        return model\n    split_masks = np.asarray(masks, dtype=bool)\n    left_sizes = split_masks.sum(axis=1)\n    right_sizes = len(log_norms) - left_sizes\n    observation_counts = np.arange(1, len(log_norms) + 1)\n    for round_index in range(min(max_rounds, 80)):\n        working_residuals = log_norms - fitted_log_scale\n        sorted_indices = np.argsort(working_residuals, kind='stable')\n        sorted_values = working_residuals[sorted_indices]\n        left_counts = np.cumsum(split_masks[:, sorted_indices], axis=1)\n        left_updates = quantiles_from_counts(sorted_values, left_counts,\n                                            left_sizes, quantile)\n        right_updates = quantiles_from_counts(sorted_values,\n                                             observation_counts - left_counts,\n                                             right_sizes, quantile)\n        updates = learning_rate * np.where(split_masks, left_updates[:, None],\n                                          right_updates[:, None])\n        losses = pinball_loss(working_residuals[None, :], updates, quantile).mean(axis=1)\n        best_index = int(np.argmin(losses))\n        current_loss = float(pinball_loss(working_residuals, 0.0, quantile).mean())\n        if losses[best_index] >= current_loss - 1e-12 * max(1.0, current_loss):\n            break\n        left_mask = split_masks[best_index]\n        left_update = float(np.quantile(working_residuals[left_mask], quantile))\n        right_update = float(np.quantile(working_residuals[~left_mask], quantile))\n        fitted_log_scale += learning_rate * np.where(left_mask, left_update, right_update)\n        feature_index, threshold = splits[best_index]\n        model['stumps'].append((feature_index, threshold, left_update, right_update))\n    return model\n\n\ndef predict_quantile_stumps(model, covariates):\n    prediction = np.full(len(covariates), model['intercept'])\n    for feature_index, threshold, left_update, right_update in model['stumps']:\n        left_mask = covariates[:, feature_index] <= threshold\n        prediction += model['learning_rate'] * np.where(left_mask, left_update, right_update)\n    return prediction\n\n\ndef fit_incumbent(covariates, residual_norms):\n    mean = covariates.mean(axis=0)\n    deviation = np.maximum(covariates.std(axis=0), 1e-8)\n    design = features((covariates - mean) / deviation)\n    target = np.log(np.maximum(residual_norms, 1e-8))\n    penalty = np.eye(design.shape[1]) * 2.0\n    penalty[0, 0] = 1e-8\n    coefficients = np.linalg.solve(design.T @ design + penalty, design.T @ target)\n    return mean, deviation, coefficients\n\n\ndef predict_incumbent_log(model, covariates):\n    mean, deviation, coefficients = model\n    return np.clip(features((covariates - mean) / deviation) @ coefficients,\n                   np.log(1e-4), np.log(1e4))\n\n\ndef raw_candidate_logs(incumbent, tail_model, covariates):\n    incumbent_log_scale = predict_incumbent_log(incumbent, covariates)\n    tail_log_scale = predict_quantile_stumps(tail_model, covariates)\n    return np.column_stack((incumbent_log_scale, np.zeros(len(covariates)),\n                            *(blend_log_scales(incumbent_log_scale, tail_log_scale, weight)\n                              for weight in (0.25, 0.5, 0.75, 1.0))))\n\n\ndef align_log_scale(log_norms, fitted_log_scale, quantile):\n    alignment_offset = float(np.quantile(log_norms - fitted_log_scale, quantile))\n    return alignment_offset\n\n\ndef fit_scale_family(covariates, residual_norms, log_norms, tail_model, quantile):\n    incumbent = fit_incumbent(covariates, residual_norms)\n    fitted_candidates = raw_candidate_logs(incumbent, tail_model, covariates)\n    offsets = np.asarray([align_log_scale(log_norms, fitted_candidates[:, index], quantile)\n                          for index in range(fitted_candidates.shape[1])])\n    return dict(incumbent=incumbent, tail=tail_model, alignment_offsets=offsets)\n\n\ndef fit_scale(features, residual_norms):\n    quantile, max_rounds = 0.9, 80\n    log_norms = np.log(np.maximum(residual_norms, 1e-12))\n    selected_index = 0\n    if len(log_norms) >= 3:\n        indices = np.random.default_rng(0).permutation(len(log_norms))\n        folds = np.array_split(indices, 3)\n        fold_losses = []\n        for fold_index, validation_indices in enumerate(folds):\n            fit_indices = np.concatenate([fold for index, fold in enumerate(folds)\n                                          if index != fold_index])\n            assert np.intersect1d(fit_indices, validation_indices).size == 0\n            min_leaf = max(20, math.ceil(0.03 * len(fit_indices)))\n            fold_tail_model = fit_quantile_stumps(features[fit_indices], log_norms[fit_indices], quantile, max_rounds, min_leaf)\n            family = fit_scale_family(features[fit_indices], residual_norms[fit_indices],\n                                      log_norms[fit_indices], fold_tail_model, quantile)\n            held_out = raw_candidate_logs(family['incumbent'], family['tail'],\n                                          features[validation_indices])\n            held_out += family['alignment_offsets']\n            fold_losses.append(pinball_loss(log_norms[validation_indices, None],\n                                            held_out, quantile).mean(axis=0))\n        fold_losses = np.asarray(fold_losses)\n        mean_losses = fold_losses.mean(axis=0)\n        standard_errors = fold_losses.std(axis=0, ddof=1) / np.sqrt(len(folds))\n        best_index = int(np.argmin(mean_losses))\n        selection_limit = mean_losses[best_index] + standard_errors[best_index]\n        simplicity_order = (0, 1, 2, 3, 4, 5)\n        selected_index = next(index for index in simplicity_order if mean_losses[index] <= selection_limit)\n    min_leaf = max(20, math.ceil(0.03 * len(log_norms)))\n    tail_model = fit_quantile_stumps(features, log_norms, quantile, max_rounds, min_leaf)\n    model = fit_scale_family(features, residual_norms, log_norms, tail_model, quantile)\n    model['selected_index'] = selected_index\n    return model\n\n\ndef predict_scale(model, covariates):\n    selected_index = model['selected_index']\n    if selected_index == 1:\n        raw_log_scale = np.zeros(len(covariates))\n    elif selected_index == 0:\n        raw_log_scale = predict_incumbent_log(model['incumbent'], covariates)\n    else:\n        incumbent_log_scale = predict_incumbent_log(model['incumbent'], covariates)\n        tail_log_scale = predict_quantile_stumps(model['tail'], covariates)\n        tail_weight = (0.25, 0.5, 0.75, 1.0)[selected_index - 2]\n        raw_log_scale = blend_log_scales(incumbent_log_scale, tail_log_scale, tail_weight)\n    alignment_offset = model['alignment_offsets'][selected_index]\n    blended_log_scale = raw_log_scale + alignment_offset\n    return np.maximum(np.exp(np.clip(blended_log_scale, -30.0, 30.0)), 1e-12)\n\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"ReferenceProvenance\",\n  \"type\": \"object\",\n  \"required\": [\"generated_at\", \"count\", \"queries\", \"references\"],\n  \"properties\": {\n    \"generated_at\": {\"type\": \"string\"},\n    \"count\": {\"type\": \"integer\", \"minimum\": 0},\n    \"queries\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\"}\n    },\n    \"references\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"paper_id\", \"citation_key\", \"query\", \"source_url\"],\n        \"properties\": {\n          \"id\": {\"type\": \"string\"},\n          \"paper_id\": {\"type\": \"string\"},\n          \"citation_key\": {\"type\": \"string\"},\n          \"title\": {\"type\": [\"string\", \"null\"]},\n          \"year\": {\"type\": [\"integer\", \"null\"]},\n          \"venue\": {\"type\": [\"string\", \"null\"]},\n          \"citation_count\": {\"type\": [\"integer\", \"null\"]},\n          \"query\": {\"type\": \"string\"},\n          \"source_url\": {\"type\": \"string\"},\n          \"retrieved_at\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n{\n  \"$id\": \"https://schemas.agentic-scientist.local/scientific-evidence/artifact-manifest.schema.json\",\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"artifact\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"source\",\n            \"derived\",\n            \"manuscript\",\n            \"figure\",\n            \"table\",\n            \"script\",\n            \"log\",\n            \"other\"\n          ],\n          \"type\": \"string\"\n        },\n        \"media_type\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Path to the artifact relative to the scientific-evidence root when possible.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"sha256\": {\n          \"description\": \"Optional hash recorded when the producing workflow computes one.\",\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"kind\"\n      ],\n      \"type\": \"object\"\n    },\n    \"derived_from\": {\n      \"description\": \"Inline @evidence refs or stable ids describing the artifact inputs.\",\n      \"items\": {\n        \"minLength\": 1,\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"type\": \"array\"\n    },\n    \"generated_by\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"command\": {\n          \"items\": {\n            \"minLength\": 1,\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"type\": \"array\"\n        },\n        \"cwd\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"finished_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        },\n        \"script_path\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"script_sha256\": {\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        },\n        \"started_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"script_path\"\n      ],\n      \"type\": \"object\"\n    },\n    \"named_outputs\": {\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"number\",\n          \"integer\",\n          \"boolean\",\n          \"array\",\n          \"object\",\n          \"null\"\n        ]\n      },\n      \"description\": \"Optional machine-readable outputs emitted by the derivation.\",\n      \"type\": \"object\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"schema_name\": {\n      \"const\": \"scientific-evidence.artifact-manifest\"\n    }\n  },\n  \"required\": [\n    \"schema_name\",\n    \"artifact\",\n    \"derived_from\"\n  ],\n  \"title\": \"Scientific Evidence Artifact Manifest\",\n  \"type\": \"object\"\n}\n#!/usr/bin/env python3\n\"\"\"Validate generated claim-grounding artifacts before paper finalization.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nEVIDENCE_REF_RE = re.compile(r\"@evidence\\[\\[[^\\]]+\\]\\]\")\nTEX_INPUT_RE = re.compile(\n    r\"\\\\(?:input|include)(?![A-Za-z@])\\s*\"\n    r\"(?:\\{(?P<braced>[^{}]+)\\}|(?P<unbraced>[^\\s%{}]+))\"\n)\nTEX_IMPORT_COMMAND_RE = re.compile(r\"\\\\(?:input|include)(?![A-Za-z@])\")\nTEX_LOCAL_SUPPORT_RE = re.compile(\n    r\"\\\\(?P<command>usepackage|RequirePackage|documentclass|LoadClass)\"\n    r\"(?![A-Za-z@])(?:\\s*\\[[^\\]]*\\])?\\s*\\{(?P<targets>[^{}]+)\\}\"\n)\nTEX_LOCAL_SUPPORT_COMMAND_RE = re.compile(\n    r\"\\\\(?:usepackage|RequirePackage|documentclass|LoadClass)(?![A-Za-z@])\"\n)\nDYNAMIC_TEX_IMPORT_RE = re.compile(r\"\\\\csname\\s*(?:input|include)\\s*\\\\endcsname\")\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\if[a-zA-Z@]+\\b|\\\\else\\b|\\\\fi\\b\")\nVERBATIM_ENV_RE = re.compile(\n    r\"\\\\begin\\s*\\{(?P<env>verbatim\\*?|lstlisting|minted)\\}.*?\"\n    r\"\\\\end\\s*\\{(?P=env)\\}\",\n    re.DOTALL,\n)\nPROMPT_ARTIFACT_RE = re.compile(r\".+_prompt(?:_round_\\d+(?:_contract_retry_\\d+)?)?\\.md$\")\nGENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\n    \"validation_feedback.json\",\n    \"validation_feedback.md\",\n    \"verification-report.json\",\n}\nROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\"validation_report.json\"}\nGENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES = (\n    \"paper_evidence_audit\",\n)\nEVIDENCE_BUNDLE_DIRNAME = \"scientific-evidence\"\nEVIDENCE_SCAN_SUFFIXES = (\n    \".tex\",\n    \".md\",\n    \".json\",\n    \".yaml\",\n    \".yml\",\n    \".py\",\n    \".sh\",\n    \".r\",\n    \".csv\",\n    \".tsv\",\n)\nEVIDENCE_SKIP_DIR_NAMES = {\n    \".git\",\n    \"__pycache__\",\n    EVIDENCE_BUNDLE_DIRNAME,\n}\nAGENT_SKILL_DIR_PREFIXES = (\n    (\".claude\", \"skills\"),\n    (\".codex\", \"skills\"),\n    (\".cursor\", \"skills\"),\n    (\".opencode\", \"skills\"),\n    (\".gemini\", \"skills\"),\n    (\".pi\", \"agent\", \"skills\"),\n)\nVERIFICATION_SUMMARY_KEYS = (\n    \"total_references\",\n    \"resolved_references\",\n    \"anchored_references\",\n    \"dangling_references\",\n    \"manifests_checked\",\n)\nSCIENTIFIC_EVIDENCE_SCRIPT = (\n    Path(__file__).resolve().parent.parent.parent\n    / \"scientific-evidence\"\n    / \"scripts\"\n    / \"scientific_evidence.py\"\n)\n\n\ndef read_json(path: Path) -> dict[str, Any]:\n    \"\"\"Read JSON data from disk when available.\"\"\"\n    try:\n        payload = json.loads(path.read_text(encoding=\"utf-8\"))\n    except json.JSONDecodeError as exc:\n        raise SystemExit(f\"Invalid JSON in {path}: {exc}\") from exc\n    if not isinstance(payload, dict):\n        raise SystemExit(f\"Expected JSON object in {path}\")\n    return payload\n\n\ndef read_bib_keys(path: Path) -> set[str]:\n    \"\"\"Read bib keys.\"\"\"\n    text = path.read_text(encoding=\"utf-8\")\n    return {match.group(1).strip() for match in KEY_RE.finditer(text) if match.group(1).strip()}\n\n\ndef validate_reference_provenance(*, references_payload: dict[str, Any], bib_keys: set[str]) -> tuple[set[str], list[str]]:\n    \"\"\"Validate references_provenance.json against references.bib.\"\"\"\n    errors: list[str] = []\n    refs = references_payload.get(\"references\")\n    if not isinstance(refs, list):\n        return set(), [\"references_provenance.json must contain a `references` list.\"]\n\n    provenance_keys: set[str] = set()\n    provenance_ids: set[str] = set()\n    for idx, row in enumerate(refs):\n        if not isinstance(row, dict):\n            errors.append(f\"references[{idx}] must be object\")\n            continue\n        source_id = row.get(\"id\")\n        if not isinstance(source_id, str) or not source_id.strip():\n            errors.append(f\"references[{idx}].id missing\")\n        else:\n            if source_id in provenance_ids:\n                errors.append(f\"references[{idx}].id duplicates existing id: {source_id!r}\")\n            provenance_ids.add(source_id)\n\n        citation_key = row.get(\"citation_key\")\n        if not isinstance(citation_key, str) or not citation_key.strip():\n            errors.append(f\"references[{idx}].citation_key missing\")\n            continue\n","exit_code":0,"status":"completed"}}
