anifest['target_rows']) != len(target):\n        raise ValueError('row provenance mismatch')\n    if smoke:\n        data['source'] = source[:12, :80]\n        data['target'] = target[:8, :80]\n        data['source_groups'] = data['source_groups'][:12]\n        data['target_groups'] = data['target_groups'][:8]\n        data['item_groups'] = np.unique(data['item_groups'][:80], return_inverse=True)[1]\n    data['source_weights'] = weights_for(data['source_groups'])\n    return data\n\n\ndef preflight_messages():\ndef execute_episode(episode, call, work_deadline, *, data, client, budgets, work_seconds, smoke):\n    import numpy as np\n    begin = time.monotonic()\n    source = data['source'].copy()\n    target = data['target']\n    groups = data['item_groups']\n    rng = np.random.default_rng(episode['seed'])\n    if episode['condition'] == 'permuted':\n        original = source.copy()\n        for row in range(len(source)):\n            offset = int(rng.integers(1, source.shape[1]))\n            order = np.roll(np.arange(source.shape[1]), offset)\n            if np.any(order == np.arange(source.shape[1])):\n                raise ProtocolFailure('vacuous_permutation')\n            source[row] = source[row, order]\n        if np.array_equal(source, original):\n            raise ProtocolFailure('vacuous_permutation')\n    extended = np.vstack([target, target[0]])\n    permutation = np.random.default_rng(episode['seed']).permutation(len(extended))\n    extended = extended[permutation]\n    copy_positions = [int(np.flatnonzero(permutation == value)[0]) for value in (0, len(target))]\n    real_positions = np.array([int(np.flatnonzero(permutation == value)[0]) for value in range(len(target))])\n    baseline = None\n    baseline_metrics = {name: [1.]*len(budgets) for name in ('uniform_mae', 'prior_mae', 'anchor_mae', 'irt_mae')}\n    operation = 'upload_start'\n    primary = None\n    baseline_recorded = False\n    signature = hashlib.sha256()\ndef aggregate_results(episodes, outcomes, complete):\n    normal = [value for episode, value in zip(episodes, outcomes) if episode['condition'] == 'normal' and not episode['replay']]\n    result = {name: sum(value[name] for value in normal)/len(normal)\n              for name in ('mae', 'rmse', 'spearman', 'kendall', 'uniform_mae', 'prior_mae', 'anchor_mae', 'irt_mae')}\n    controls = all(value['control'] and value['completed'] for value in outcomes)\n    first, replay = outcomes[0]['solution'], outcomes[-1]['solution']\n    replay_matches = first is not None and replay is not None and len(first) == len(replay)\n    if replay_matches:\n        replay_matches = all(reference['items'] == repeated['items']\n            and len(reference['predictions']) == len(repeated['predictions'])\n            and all(abs(float(left)-float(right)) <= 1e-10\n                    for left, right in zip(reference['predictions'], repeated['predictions']))\n            for reference, repeated in zip(first, replay))\n    controls &= replay_matches\n    for condition in ('constant', 'permuted'):\n        values = [value['mae'] if value['completed'] and value['control'] else 1.\n                  for episode, value in zip(episodes, outcomes) if episode['condition'] == condition]\n        result[condition+'_mae'] = sum(values)/len(values)\n    result['control_correct'] = float(controls)\n    result['correct'] = float(complete and controls)\n    if PLANE == 'search':\n        result['combined_score'] = 1-result['mae']\n    return result\n\n\ndef paired_uncertainty(episodes, outcomes, loaded, cases):\n    import numpy as np\n    rng = np.random.default_rng(1729)\n    names = ['uniform_mae', 'prior_mae', 'anchor_mae', 'irt_mae']\n    distributions = {name: [] for name in names}\n    points = {name: [] for name in names}\n    failed = 0\n    for case in cases:\n        groups = loaded[case]['target_groups']\n        unique = np.unique(groups)\n        cells = [value for episode, value in zip(episodes, outcomes)\n                 if episode['case'] == case and episode['condition'] == 'normal' and not episode['replay']]\n        differences = {name: np.zeros(len(unique)) for name in names}\n        for cell in cells:\n            if not cell['completed']:\n                failed += 1\n                continue\n            for checkpoint in cell['solution']:\n                truth = np.array(checkpoint['references'])\n                candidate_errors = np.abs(np.array(checkpoint['predictions'])-truth)\n                for name in names:\n                    baseline_errors = np.abs(np.array(checkpoint['baseline_predictions'][name])-truth)\n                    for index, group in enumerate(unique):\n                        differences[name][index] += float(np.mean((candidate_errors-baseline_errors)[groups == group])) / (len(cells)*len(cell['solution']))\n        sampled = rng.integers(0, len(unique), size=(200, len(unique)))\n        for name in names:\n            points[name].append(float(differences[name].mean()))\n            distributions[name].append(differences[name][sampled].mean(axis=1))\n    return dict(policy='paired lineage-block bootstrap; checkpoints/seeds retained within groups; equal case weights; 200 draws; fixed failure differences 1-1=0; conditional on fixed cases',\n                failed_normal_cells=failed,\n                comparisons={name: dict(candidate_minus_baseline_mae=float(np.mean(points[name])),\n                    lower_95=float(np.quantile(np.mean(distributions[name], axis=0), .025)),\n                    upper_95=float(np.quantile(np.mean(distributions[name], axis=0), .975))) for name in names})\n\n\n\"\"\"Search-only, offline, evaluator-owned benchmark prediction experiment.\n\nThe sealed evaluator is a standalone copy, not an import of this module.\nAll controls, losses, fixed weights and budgets are specified before execution.\n\"\"\"\n\nimport argparse\nimport base64\nimport collections\nimport ctypes\nimport errno\nimport hashlib\nimport importlib.util\nimport inspect\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport resource\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\n\nPLANE = 'final'\nCASES = ['bbh', 'gpqa', 'mmlu_pro', 'musr', 'openllm_math', 'legalbench', 'math', 'med_qa', 'mmlu']\nSEEDS = [1009, 2003, 3001]\nWALL_SECONDS = 10800\nSTARTUP_SECONDS = 300\nRPC_BUDGET = 2296\nMETHOD_SECONDS = 45\nRESOURCE_HASHES = {'openllm_math.npz': 'd8c0d6dbfe1708328d0d4c33ea1c900a1f74c4873bc64e6130d3e0d56c2d5c0b', 'mmlu_pro_manifest.json': '99065071efc895d868f85cabb55c858fecb59efbb51f45564c0ca5c716d7ba14', 'musr_columns.jsonl': '6d16c374d97042d62aee5d268106a97b0c95f38cfd13efe7474d1349ee426f0b', 'mmlu_columns.jsonl': '28b0fe67a2c10801119e3dfc73577d5cd21d3ef1466404eaeb12193109576906', 'musr.npz': 'a7058a1055a554822c8abe1a2f5c32ce820f8c8705df39a5e6565d87a68e6937', 'med_qa_columns.jsonl': 'bc915b8a789cfe4f48e54c16ebab6afd7e1c694e1b6d88412a8c12d8c4737e9b', 'med_qa.npz': '9fa09c987c1e9acddfe0e2ee6f5ca4ac402ac7d35c00476682f8ee908306af97', 'openllm_math_columns.jsonl': '4dc994df201bb04bd7fd5c7a9bd1bd82e5ae3714789355b773f13f68d8aed6ef', 'gpqa_manifest.json': '75f7c54422e7995ca15534d2f029ac2ef33aee33c409b73cabd8392284e5f255', 'bbh_columns.jsonl': '2777d6e6ce7d41aecf52f3030f0901f08f4744d6cc575b630997c3297a6353c2', 'mmlu_manifest.json': 'a3ce7b25d0bf9fce8e747cbd15f813fa2e47c87fd8b0e91c96029d87a8f032f6', 'bbh_manifest.json': 'af350d20ad315503861c11184c56fe62bd5ca43d714ac25acc85dc0968fd90ff', 'math_manifest.json': '92a8af30528a79f90d7ea195997882671cd0345935dba2d458503b29cf9861d2', 'legalbench.npz': 'ca6867f4806d7288b87555fd45ec0d297294cfd7d3fd21cd7d698c1989259bad', 'mmlu_pro.npz': '73b3735fc30bd6f0c95b1dad53a619bcc57070ab0fbde7c9aaee63f0aea81c40', 'mmlu.npz': 'd55600c5a4aa4e41895625e59800df068188d103ddbdd8710e7490cf91fc7261', 'bbh.npz': 'a6d7e913a17e89a5dfc00f1a7bba8588b01b6e3c107c543d7942021a65945ffa', 'math_columns.jsonl': 'ca3cd676f2932edf627f24c2a8cb56828a68f0c1d9260431a0dabe7a00e175c6', 'musr_manifest.json': '186c02892db925b9bc52c3a2b30211d12fa8a73b64ed0a19cb26b548eb51dd71', 'openllm_math_manifest.json': '0d1264fae644fc924c61653cfbd5e9636308c46bb9004eb92c81e57058031784', 'mmlu_pro_columns.jsonl': 'c9118bc36f8fc649ebb587ac856788c721807c84b173f94eb225ecfade4b8be2', 'med_qa_manifest.json': 'f35753274e462203b62936a3b3a56794e000e5ba52a3860eea836c48891ef6de', 'math.npz': '303c2d864eccdc48edadb838405df9d96937c36b48718bfc8cd433c2b5b0cbda', 'legalbench_manifest.json': '02ddfaadd54f2fd244d809c2538a6b25f900d9a1eea7de5ca6f8c2850a5526d4', 'gpqa_columns.jsonl': '9fcf6f21f8ac38869136d0f4d02bc4fe7142f4bcc92759da66e3ac08f5dfcfd5', 'gpqa.npz': '119a43f68daacf2666c3518e27abfb4ce98d7690ffa5a90c6d3e4f77c81a89fe', 'legalbench_columns.jsonl': '53807d38d3edd142c64911e3d887458e9102c1f66d872f09274baaa37cfc7994'}\nMETRICS = ['mae', 'rmse', 'spearman', 'kendall', 'uniform_mae', 'prior_mae',\n           'anchor_mae', 'irt_mae', 'constant_mae', 'permuted_mae', 'control_correct', 'correct']\nCONDITIONS = ['normal', 'constant', 'permuted']\nWIRE_LIMIT = 64 * 1024 * 1024\nOPERATING_LIMIT = 16 * 1024 * 1024\nCHUNK_BYTES = 3 * 1024 * 1024\nMAX_CHUNKS = 11\nFINISH_RESERVE = 10\nEPISODE_OVERHEAD = 7\nRESET_TIMEOUT = 2\n\n\ndef strict_json(raw):\n    def pairs(items):\n        result = {}\n        for key, value in items:\n            if key in result:\n                raise ProtocolFailure('duplicate_key')\n            result[key] = value\n        return result\n    def constant(value):\n        raise ProtocolFailure('nonfinite_response')\n    try:\n        return json.loads(raw, object_pairs_hook=pairs, parse_constant=constant)\n    except (ValueError, UnicodeError, RecursionError) as error:\n        raise ProtocolFailure('invalid_json') from error\n\n\ndef bounded_json_line(value, wire_limit=WIRE_LIMIT):\n\"\"\"Search-only, offline, evaluator-owned benchmark prediction experiment.\n\nThe sealed evaluator is a standalone copy, not an import of this module.\nAll controls, losses, fixed weights and budgets are specified before execution.\n\"\"\"\n\nimport argparse\nimport base64\nimport collections\nimport ctypes\nimport errno\nimport hashlib\nimport importlib.util\nimport inspect\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport resource\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\n\nPLANE = 'search'\nCASES = ['arc_challenge', 'ifeval', 'commonsense', 'gsm']\nSEEDS = [101, 211]\nWALL_SECONDS = 2700\nSTARTUP_SECONDS = 180\nRPC_BUDGET = 700\nMETHOD_SECONDS = 20\nRESOURCE_HASHES = {'commonsense.npz': '61ebe7ef736a79e09f611f8c98f7d1dac1896c046b113835a9c72ed307ae5165', 'ifeval_manifest.json': 'cce4b7a3aafa0e35ce67d1ba7991fa0aa6f330aad69616354987b6454d531fa9', 'commonsense_columns.jsonl': '6706b3742314a48d7735b2c817ac9b3e35b216bc2e427aaeb0876b8d534425b5', 'gsm_columns.jsonl': '92d0ed300cc45f09543524414d9dbe11916342e6c3bb2a6e7003bbdf378e659a', 'commonsense_manifest.json': '62eb4687b1e34702507acf3b9c4ba13be01475516925534a24752b22a37b9a5b', 'gsm_manifest.json': '8c158e58dea6893d6a1b289a07d194ae7ee4aa75c71d20fe8b4257ee91c6d508', 'ifeval_columns.jsonl': 'a1b4b2c26220ecfaa7c5c694b9dd6316622260990242b298736242b0ab2f8eaa', 'ifeval.npz': 'b5fd28eb3083a3af6a3dc5f16e1d180caa60c51e2c5bbd2944f2f3da9511dd19', 'gsm.npz': '8307c84e3ce1a7d39dc0fdd916fa0125c7107b0a4efd92501b24adaab49e422b', 'arc_challenge_manifest.json': '712236caa769ac9dee69e613f0eea0a696e41361e0a99ccae72903d71a5e9684', 'arc_challenge_columns.jsonl': '8b0cb07f0495cd4b112a7cf0a8db0897392fd0e6c9c10b25315f32ab9c27710c', 'arc_challenge.npz': '15387364d2f93105678a1bceb0b09da3769b829f0e5e61a769fa2bed269b83f1'}\nMETRICS = ['mae', 'rmse', 'spearman', 'kendall', 'uniform_mae', 'prior_mae',\n           'anchor_mae', 'irt_mae', 'constant_mae', 'permuted_mae', 'control_correct', 'correct']\nCONDITIONS = ['normal', 'constant', 'permuted']\nWIRE_LIMIT = 64 * 1024 * 1024\nOPERATING_LIMIT = 16 * 1024 * 1024\nCHUNK_BYTES = 3 * 1024 * 1024\nMAX_CHUNKS = 11\nFINISH_RESERVE = 10\nEPISODE_OVERHEAD = 7\nRESET_TIMEOUT = 2\n\n\ndef strict_json(raw):\n    def pairs(items):\n        result = {}\n        for key, value in items:\n            if key in result:\n                raise ProtocolFailure('duplicate_key')\n            result[key] = value\n        return result\n    def constant(value):\n        raise ProtocolFailure('nonfinite_response')\n    try:\n        return json.loads(raw, object_pairs_hook=pairs, parse_constant=constant)\n    except (ValueError, UnicodeError, RecursionError) as error:\n        raise ProtocolFailure('invalid_json') from error\n\n\ndef bounded_json_line(value, wire_limit=WIRE_LIMIT):\n---\nname: memory-log\ndescription: Maintain a continuous, append-only `./memory.md` log of discoveries, evaluations, failures, and next hypotheses during agent runs.\n---\n\n# What the skill is about\nKeep durable run memory so idea evolution and program evidence are never lost between steps.\n\n# When to use the skill\n- At run start to initialize memory.\n- After every meaningful step (`idea`, `edit`, `evaluate`, `verify`, `paper`, `draft`).\n- Immediately after every `evaluate-program -> verify-rubrics` pair.\n\n# What to do\n1. Initialize `./memory.md` if missing with these section headers:\n- `# Memory Log`\n- `## Context`\n- `## Idea Discoveries`\n- `## Program Evaluations`\n- `## Failures / Regressions`\n- `## Next Hypotheses`\n2. Also initialize global files if missing:\n- `./global_memory/memory.md`\n- `./global_memory/memory.jsonl`\n3. Never delete or rewrite prior entries; append only.\n4. For each appended entry, include:\n- timestamp\n- step type\n- change/discovery summary\n- concrete evidence\n- next action\n5. After every `evaluate-program -> verify-rubrics` pair, append a `Program Evaluations` entry that includes:\n- `program_<idx>`\n- `combined_score`\n- `correct`\n- rubric pass/fail summary\n- `next_recommendation`\n6. For regressions or failed rubrics, append one root-cause hypothesis under `Failures / Regressions`.\n7. Before exit, append final status (`rubric_pass`, `cap_reached`, or task-specific stop reason) and next hypothesis under `Next Hypotheses`.\n8. When command execution is unavailable, use read/edit/write tools to append directly\nto the required markdown and JSONL files. Preserve all existing content. When command\nexecution is available, prefer the helper for deterministic dual-write:\n- script: detect the active agent config directory first, then use `<that-dir>/skills/memory-log/scripts/append_memory.py`\n- command template:\n```bash\nMEMORY_HELPER=\"$(find ./.claude ./.codex ./.cursor ./.opencode ./.gemini ./.pi -path '*/skills/memory-log/scripts/append_memory.py' -print -quit 2>/dev/null)\"\npython \"${MEMORY_HELPER}\" \\\n  --global-memory-md \"./global_memory/memory.md\" \\\n  --global-memory-jsonl \"./global_memory/memory.jsonl\" \\\n  --event-json '{\"step\":\"evaluate\",\"scope\":\"attempt\",\"summary\":\"...\",\"evidence\":\"...\",\"next_action\":\"...\",\"attempt_id\":\"{{ATTEMPT_ID}}\",\"idea_id\":\"{{IDEA_ID}}\",\"program_id\":\"program_2\",\"metrics\":{\"combined_score\":2.54,\"correct\":true}}'\n```\n9. JSONL event schema (required keys):\n- `timestamp` (auto-filled if omitted)\n- `step` (`idea|edit|evaluate|verify|paper|draft|final|conclusions_skip`)\n- `scope` (`idea|attempt|paper|campaign`)\n- `summary`\n- `evidence`\n- `next_action`\n- optional: `idea_id`, `attempt_id`, `program_id`, `metrics`, `rubrics`, `tags`\n\n10. Update distilled conclusions (`conclusions.md`).\n**Purpose.** `conclusions.md` is a *forward-looking guide* for the next worker (or your future self in a later cycle). Its job is to help readers (a) focus their effort on directions you've found promising, and (b) avoid spending compute on directions you've already shown to be unpromising. Each sentence should either point at a lead worth pursuing or warn against a dead end, framed so a researcher who has not read your `memory.md` can still act on it. Avoid chronology, restate-of-results, and post-mortem narration — those belong in `memory.md`. Conclusions are the synthesis layer that makes other workers' next cycles more efficient.\n\n**When.** After every memory-append in the cycle (idea / edit / evaluate / verify / paper / final), evaluate whether `conclusions.md` should be updated.\n\n**Update gate (the only valid triggers).**\n- (a) cycle **contradicts** an existing sentence → rewrite that sentence.\n- (b) cycle opens a **new category** not yet covered → add a sentence.\n- (c) cycle **flips a Do/Don't** recommendation → flip it.\n- (d) cycle **meaningfully refines** an existing sentence — narrows the conditions under which a rule holds, broadens its applicability to a config it wasn't known to apply to, sharpens a tentative claim into a confident one, or adds a qualifier the prior phrasing didn't cover → edit the sentence to incorporate the refinement. Simple re-confirmation in the same regime is **not** sufficient; you must identify the refinement dimension (narrow / broaden / sharpen / qualify) in `--gate-reason`.\n- otherwise → **keep**, do not invoke the helper.\n\n**Format constraints.** Single paragraph. ≤300 words. No blank lines (`\\n\\n`). Avoid detailed numerical figures — use qualitative thresholds (e.g. \"low LR\", \"small batch\") instead of precise floats like `LR=0.205`.\n\n**Update mechanism.** When execution is unavailable, apply the same validation rules\nand update the conclusions files directly with read/edit/write tools. When execution\nis available, use this helper invocation:\n```bash\npython \"${MEMORY_HELPER}\" --write-conclusions \\\n  --conclusions-md \"{{CONCLUSIONS_MD_FILE}}\" \\\n  --conclusions-history-jsonl \"{{CONCLUSIONS_HISTORY_FILE}}\" \\\n  --cycle-index {{CYCLE_INDEX}} \\\n  --worker-index {{WORKER_INDEX}} \\\n  --gate-trigger <a|b|c|d> \\\n  --gate-reason \"<one sentence; for (d) name the dimension>\" \\\n  --conclusions-text \"<the full new paragraph>\"\n```\n\n**Pre-flight self-check.** Before invoking the helper, count words (`len(paragraph.split())`) and confirm ≤300, and that the paragraph contains no blank line. Most validation rejections can be avoided here.\n\n**Retry budget — exactly 3 attempts per cycle.** On non-zero exit, read the stderr error, shorten the paragraph (drop the least-decisive sentence, merge two related sentences, or remove qualifiers), and retry. After **3 total attempts** with no success, the update is **discarded** for this cycle: do not retry further, do not write the rejected text anywhere, and append a single memory event with `step=\"conclusions_skip\"` whose `summary` names the last validation error. Underlying findings are not lost — they are already durable in `memory.md`.\n\n**Always log the gate decision.** Inside the regular memory append for the cycle, include `gate=<updated|kept|skipped>; trigger=<a|b|c|d|none>; reason=<one sentence>` in the entry's `summary` or `tags`. Use `skipped` only after the 3-attempt budget is exhausted.\n\n# Example evaluation entry\n```markdown\n### 2026-02-13T16:58:00Z | step=evaluate\n- program: program_3\n- combined_score: 2.54\n- correct: true\n- rubrics: uses_restarts=pass, constraint_optimization=pass, score_threshold=fail\n- evidence: late-stage overlap still visible in stdout trace\n- next_recommendation: raise late-stage overlap penalty and diversify restart seeds\n```\n","exit_code":0,"status":"completed"}}
