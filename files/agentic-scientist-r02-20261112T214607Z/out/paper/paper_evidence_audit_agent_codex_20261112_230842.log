or control, expected in [('full_simplex',1),('copy_center',0)]:\n    for episode in episodes:\n        for case in episode['solution']['cases']:\n            result = case['baselines'][control]\n            if result['mass'] \"'!= expected or any(item['\"'coverage'] \"'!= expected for item in result['\"'details']):\n                errors.append(('control',control,episode['seed'],case['case']))\nprint('Frozen-data summary, supplementary table, aggregate, and degenerate-control mismatches:',errors)\nprint('Seeds:',[episode['seed'] for episode in episodes])\nfor case in summary['cases']:\n    print(case, '; '.join(method+' U='+format(record['utility']['mean'],'.5f')+' cov95/90='+','.join(format(statistics.mean(values),'.5f') for values in record['coverage']) for method,record in summary['cases'][case].items() if 'coverage' in record))\nPY\"","aggregated_output":"Frozen-data summary, supplementary table, aggregate, and degenerate-control mismatches: []\nSeeds: [1009, 2003, 3001, 4001, 5003, 6007]\nH3 actual U=0.85319 cov95/90=0.94979,0.89266; global_ilr U=0.85326 cov95/90=0.94946,0.89355; raw_linf U=0.84552 cov95/90=0.95353,0.89209; bonferroni U=0.84220 cov95/90=0.95931,0.90934\nH10 actual U=0.87887 cov95/90=0.95321,0.89827; global_ilr U=0.88028 cov95/90=0.95264,0.89876; raw_linf U=0.86555 cov95/90=0.95133,0.90487; bonferroni U=0.86010 cov95/90=0.96021,0.90771\nB3 actual U=0.89045 cov95/90=0.95011,0.89689; global_ilr U=0.84703 cov95/90=0.94279,0.88949; raw_linf U=0.85644 cov95/90=0.94588,0.89160; bonferroni U=0.85188 cov95/90=0.96541,0.93465\nB10 actual U=0.90820 cov95/90=0.96159,0.90706; global_ilr U=0.84162 cov95/90=0.95492,0.90120; raw_linf U=0.85931 cov95/90=0.95752,0.90804; bonferroni U=0.85302 cov95/90=0.97274,0.93717\nS3 actual U=0.86043 cov95/90=0.94979,0.89933; global_ilr U=0.79235 cov95/90=0.85067,0.74748; raw_linf U=0.82036 cov95/90=0.88843,0.77873; bonferroni U=0.84448 cov95/90=0.91626,0.86955\nS10 actual U=0.87222 cov95/90=0.95768,0.91610; global_ilr U=0.76308 cov95/90=0.81405,0.70190; raw_linf U=0.83270 cov95/90=0.89819,0.80973; bonferroni U=0.84148 cov95/90=0.92114,0.84578\n","exit_code":0,"status":"completed"}}
