{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc 'nl -ba source_evidence/selected/logistic_fourier.py; nl -ba source_evidence/selected/forest.py'","aggregated_output":"     1\t\"\"\"Bounded probability-game Fourier/Owen integration; failure returns None.\n     2\t\n     3\tMesh agreement and endpoint efficiency are numerical diagnostics, not rigorous\n     4\tcoordinate-error certificates. No coalition predictions or random draws occur.\n     5\t\"\"\"\n     6\t\n     7\timport math\n     8\t\n     9\timport numpy as np\n    10\t\n    11\t\n    12\tdef _frequency_marginals(frequencies, base_logit, increments,\n    13\t                         inclusion_nodes, inclusion_weights):\n    14\t    phase_steps = np.exp(1j * frequencies[:, None] * increments[None, :])\n    15\t    mixture_factors = 1.0 - inclusion_nodes[None, :, None] + inclusion_nodes[None, :, None] * phase_steps[:, None, :]\n    16\t    ones = np.ones((*mixture_factors.shape[:2], 1), dtype=np.complex128)\n    17\t    prefix = np.concatenate((ones, np.cumprod(mixture_factors, axis=2)), axis=2)\n    18\t    suffix = np.concatenate((np.cumprod(mixture_factors[:, :, ::-1], axis=2)[:, :, ::-1], ones), axis=2)\n    19\t    excluded_products = prefix[:, :, :-1] * suffix[:, :, 1:]\n    20\t    t_integrals = np.einsum('q,fqj->fj', inclusion_weights, excluded_products)\n    21\t    complex_marginals = np.exp(1j * frequencies[:, None] * base_logit) * np.expm1(1j * frequencies[:, None] * increments[None, :]) * t_integrals\n    22\t    return np.imag(complex_marginals) / np.sinh(np.pi * frequencies[:, None])\n    23\t\n    24\t\n    25\tdef _frequency_mesh(base_logit, increments, inclusion_nodes, inclusion_weights,\n    26\t                    cutoff, panel_count, frequency_nodes, frequency_weights):\n    27\t    frequency_block_size = 32\n    28\t    panels_per_block = frequency_block_size // len(frequency_nodes)\n    29\t    panel_width = cutoff / panel_count\n    30\t    estimate = np.zeros(len(increments), dtype=np.float64)\n    31\t    for panel_start in range(0, panel_count, panels_per_block):\n    32\t        panel_indices = np.arange(panel_start, min(panel_count, panel_start + panels_per_block))\n    33\t        frequencies = (panel_width * (panel_indices[:, None] + 0.5 * (frequency_nodes + 1.0))).reshape(-1)\n    34\t        weights = np.tile(0.5 * panel_width * frequency_weights, len(panel_indices))\n    35\t        marginals = _frequency_marginals(frequencies, base_logit, increments,\n    36\t                                        inclusion_nodes, inclusion_weights)\n    37\t        if not np.all(np.isfinite(marginals)):\n    38\t            return None\n    39\t        estimate += weights @ marginals\n    40\t    return estimate\n    41\t\n    42\t\n    43\tdef _integrate_row(base_logit, increments, endpoint_difference,\n    44\t                   inclusion_nodes, inclusion_weights, frequency_nodes,\n    45\t                   frequency_weights):\n    46\t    cutoff = 8.0\n    47\t    tail_tolerance = 1e-10\n    48\t    quadrature_tolerance = 1e-8\n    49\t    efficiency_tolerance = 1e-8\n    50\t    maximum_frequency_nodes = 2048\n    51\t    tail_bound = -(2.0 / np.pi) * np.log(np.tanh(np.pi * cutoff / 2.0))\n    52\t    minimum_logit = base_logit + np.minimum(increments, 0.0).sum()\n    53\t    maximum_logit = base_logit + np.maximum(increments, 0.0).sum()\n    54\t    maximum_phase = max(abs(minimum_logit), abs(maximum_logit))\n    55\t    if not math.isfinite(maximum_phase):\n    56\t        return None\n    57\t    initial_panel_limit = maximum_frequency_nodes // (4 * len(frequency_nodes))\n    58\t    if maximum_phase > initial_panel_limit * (8.0 / cutoff):\n    59\t        return None\n    60\t    panel_count = max(1, math.ceil(cutoff * maximum_phase / 8.0))\n    61\t    required_frequency_nodes = 4 * panel_count * len(frequency_nodes)\n    62\t    if required_frequency_nodes > maximum_frequency_nodes:\n    63\t        return None\n    64\t    if tail_bound > tail_tolerance or not math.isfinite(endpoint_difference):\n    65\t        return None\n    66\t    coarse_phi = _frequency_mesh(base_logit, increments, inclusion_nodes,\n    67\t                                 inclusion_weights, cutoff, panel_count,\n    68\t                                 frequency_nodes, frequency_weights)\n    69\t    if coarse_phi is None or not np.all(np.isfinite(coarse_phi)):\n    70\t        return None\n    71\t    consecutive_agreements = 0\n    72\t    while True:\n    73\t        panel_count *= 2\n    74\t        required_frequency_nodes = panel_count * len(frequency_nodes)\n    75\t        if required_frequency_nodes > maximum_frequency_nodes:\n    76\t            return None\n    77\t        refined_phi = _frequency_mesh(base_logit, increments, inclusion_nodes,\n    78\t                                      inclusion_weights, cutoff, panel_count,\n    79\t                                      frequency_nodes, frequency_weights)\n    80\t        if refined_phi is None:\n    81\t            return None\n    82\t        if not np.all(np.isfinite(refined_phi)):\n    83\t            return None\n    84\t        discretization_error = np.max(np.abs(refined_phi - coarse_phi))\n    85\t        efficiency_error = abs(refined_phi.sum() - endpoint_difference)\n    86\t        if tail_bound <= tail_tolerance and discretization_error <= quadrature_tolerance and efficiency_error <= efficiency_tolerance:\n    87\t            consecutive_agreements += 1\n    88\t            if consecutive_agreements >= 2:\n    89\t                return refined_phi\n    90\t        else:\n    91\t            consecutive_agreements = 0\n    92\t        coarse_phi = refined_phi\n    93\t\n    94\t\n    95\tdef _logistic_fourier_shapley(model, query):\n    96\t    coefficients = np.asarray(model['parameters']['coef'], dtype=np.float64)\n    97\t    intercept = float(model['parameters']['intercept'])\n    98\t    query_values = np.asarray(query, dtype=np.float64)\n    99\t    background = np.asarray(model['background'], dtype=np.float64)\n   100\t    feature_count = model['dimension']\n   101\t    if not (np.all(np.isfinite(coefficients)) and math.isfinite(intercept)):\n   102\t        return None\n   103\t    raw_nodes, raw_weights = np.polynomial.legendre.leggauss((feature_count + 1) // 2)\n   104\t    inclusion_nodes = 0.5 * (raw_nodes + 1.0)\n   105\t    inclusion_weights = 0.5 * raw_weights\n   106\t    frequency_nodes, frequency_weights = np.polynomial.legendre.leggauss(8)\n   107\t    query_logit = float(query_values @ coefficients + intercept)\n   108\t    if not math.isfinite(query_logit):\n   109\t        return None\n   110\t    query_probability = 1.0 / (1.0 + np.exp(-np.clip(query_logit, -700, 700)))\n   111\t    background_phi = np.empty((len(background), feature_count), dtype=np.float64)\n   112\t    for row_index, background_row in enumerate(background):\n   113\t        increments = coefficients * (query_values - background_row)\n   114\t        base_logit = float(background_row @ coefficients + intercept)\n   115\t        if not math.isfinite(base_logit) or not np.all(np.isfinite(increments)):\n   116\t            return None\n   117\t        base_probability = 1.0 / (1.0 + np.exp(-np.clip(base_logit, -700, 700)))\n   118\t        endpoint_difference = float(query_probability - base_probability)\n   119\t        row_phi = _integrate_row(base_logit, increments, endpoint_difference,\n   120\t                                 inclusion_nodes, inclusion_weights,\n   121\t                                 frequency_nodes, frequency_weights)\n   122\t        if row_phi is None:\n   123\t            return None\n   124\t        background_phi[row_index] = row_phi\n   125\t    return background_phi.mean(axis=0)\n   126\t\n   127\t\n   128\tdef logistic_fourier_shapley(model, query):\n   129\t    \"\"\"Average every supplied row, or reject without consuming sampling RNG.\n   130\t\n   131\t    Sigmoid(z) = 1/2 + integral sin(omega*z)/sinh(pi*omega) d omega.\n   132\t    The integrand's zero-frequency limit is increments/pi. Interior frequency\n   133\t    nodes and expm1 avoid subtracting nearly equal complex phases. Clipping at\n   134\t    magnitude 700 perturbs sigmoid below ordinary float64 absolute precision.\n   135\t    \"\"\"\n   136\t    try:\n   137\t        with np.errstate(over='raise', invalid='raise', divide='raise', under='ignore'):\n   138\t            return _logistic_fourier_shapley(model, query)\n   139\t    except (FloatingPointError, OverflowError):\n   140\t        return None\n     1\t\"\"\"Exact interventional Shapley values of the uploaded empirical forest game.\"\"\"\n     2\t\n     3\timport math\n     4\t\n     5\timport numpy as np\n     6\t\n     7\t\n     8\tdef compile_leaf_constraints(tree, dimension):\n     9\t    \"\"\"Intersect repeated splits into lower-exclusive, upper-inclusive bounds.\"\"\"\n    10\t    leaves = []\n    11\t    stack = [(0, np.full(dimension, -np.inf), np.full(dimension, np.inf), ())]\n    12\t    while stack:\n    13\t        node, lower_bounds, upper_bounds, used = stack.pop()\n    14\t        if tree['left'][node] < 0:\n    15\t            used_features = np.asarray(sorted(used), dtype=np.int64)\n    16\t            leaves.append((used_features, lower_bounds[used_features],\n    17\t                           upper_bounds[used_features], float(tree['probability'][node])))\n    18\t            continue\n    19\t        feature = int(tree['feature'][node])\n    20\t        threshold = float(tree['threshold'][node])\n    21\t        next_used = used if feature in used else used + (feature,)\n    22\t        left_upper = upper_bounds.copy()\n    23\t        left_upper[feature] = min(left_upper[feature], threshold)\n    24\t        if lower_bounds[feature] < left_upper[feature]:\n    25\t            stack.append((int(tree['left'][node]), lower_bounds, left_upper, next_used))\n    26\t        right_lower = lower_bounds.copy()\n    27\t        right_lower[feature] = max(right_lower[feature], threshold)\n    28\t        if right_lower[feature] < upper_bounds[feature]:\n    29\t            stack.append((int(tree['right'][node]), right_lower, upper_bounds, next_used))\n    30\t    return leaves\n    31\t\n    32\t\n    33\tdef literal_beta_tables(dimension):\n    34\t    \"\"\"Integrate each required positive or negative literal's marginal.\"\"\"\n    35\t    positive_beta = np.zeros((dimension + 1, dimension + 1), dtype=np.float64)\n    36\t    negative_beta = np.zeros_like(positive_beta)\n    37\t    for positive_count in range(dimension + 1):\n    38\t        for negative_count in range(dimension + 1 - positive_count):\n    39\t            if positive_count:\n    40\t                positive_beta[positive_count, negative_count] = 1.0 / (positive_count * math.comb(positive_count + negative_count, positive_count))\n    41\t            if negative_count:\n    42\t                negative_beta[positive_count, negative_count] = 1.0 / (negative_count * math.comb(positive_count + negative_count, positive_count))\n    43\t    return positive_beta, negative_beta\n    44\t\n    45\t\n    46\tdef exact_forest_shapley(model, query):\n    47\t    \"\"\"Sum leaf-literal games without sampling or enumerating coalitions.\n    48\t\n    49\t    Each background row defines a game by choosing query or background values\n    50\t    independently for each original feature group. A leaf is a conjunction of\n    51\t    required inclusions and exclusions; both-pass features are dummy players.\n    52\t    Average these exact games over every supplied row and tree. Compilation and\n    53\t    all intermediates are local to this call; no query or coalition cache lives\n    54\t    across calls. Float32 overflow to negative infinity also preserves traversal\n    55\t    semantics when a path has no lower constraint.\n    56\t    \"\"\"\n    57\t    query_values = np.asarray(query, dtype=np.float32)\n    58\t    background_values = np.asarray(model['background'], dtype=np.float32)\n    59\t    dimension = model['dimension']\n    60\t    positive_beta, negative_beta = literal_beta_tables(dimension)\n    61\t    forest_phi = np.zeros(dimension, dtype=np.float64)\n    62\t    for tree in model['parameters']['trees']:\n    63\t        tree_phi = np.zeros(dimension, dtype=np.float64)\n    64\t        leaves = compile_leaf_constraints(tree, dimension)\n    65\t        for used_features, lower_bounds, upper_bounds, leaf_probability in leaves:\n    66\t            if not len(used_features):\n    67\t                continue\n    68\t            query_pass = (query_values[used_features] > lower_bounds) & (query_values[used_features] <= upper_bounds)\n    69\t            background_pass = (background_values[:, used_features] > lower_bounds) & (background_values[:, used_features] <= upper_bounds)\n    70\t            query_pass |= np.isneginf(lower_bounds) & (query_values[used_features] <= upper_bounds)\n    71\t            background_pass |= np.isneginf(lower_bounds) & (background_values[:, used_features] <= upper_bounds)\n    72\t            positive_required = query_pass[None, :] & ~background_pass\n    73\t            negative_required = ~query_pass[None, :] & background_pass\n    74\t            viable_rows = np.all(query_pass[None, :] | background_pass, axis=1)\n    75\t            positive_counts = positive_required.sum(axis=1)\n    76\t            negative_counts = negative_required.sum(axis=1)\n    77\t            leaf_delta = positive_required * positive_beta[positive_counts, negative_counts][:, None] - negative_required * negative_beta[positive_counts, negative_counts][:, None]\n    78\t            leaf_delta[~viable_rows] = 0.0\n    79\t            tree_phi[used_features] += leaf_probability * leaf_delta.mean(axis=0)\n    80\t        forest_phi += tree_phi\n    81\t    return forest_phi / len(model['parameters']['trees'])\n","exit_code":0,"status":"completed"}}
