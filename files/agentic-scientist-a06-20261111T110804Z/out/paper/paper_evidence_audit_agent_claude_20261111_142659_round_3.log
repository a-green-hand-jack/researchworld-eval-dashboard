efully and select the single best answer from options A to J.\\\",\\n    \\\"Choose the correct answer. Respond with the letter of the option only.\\\",\\n    \\\"Think about the question, then pick the option that is most likely correct.\\\",\\n]\\nSUFFIXES = [\\\"The answer is (\\\", \\\"Answer: The answer is (\\\"]\\nMAX_BODY_TOKENS = 400\\n\\ndef norm(t):\\n    return \\\" \\\".join(unicodedata.normalize(\\\"NFKC\\\", t).casefold().split())\\n\\ndef content_hash(q, opts):\\n    return hashlib.sha256((norm(q) + \\\"\\\\n\\\" + \\\"\\\\n\\\".join(norm(o) for o in opts)).encode(\\\"utf-8\\\")).hexdigest()\\n\\ndef body_text(q, opts):\\n    return \\\"Question: \\\" + q.strip() + \\\"\\\\nOptions:\\\\n\\\" + \\\"\\\\n\\\".join(f\\\"{LETTERS[i]}. {o}\\\" for i, o in enumerate(opts)) + \\\"\\\\n\\\"\\n\\ndef demo_text(q, opts, ans):\\n    return body_text(q, opts) + f\\\"Answer: The answer is ({ans}).\\\\n\\\\n\\\"\\n\\ndef prep(search_n, final_n):\\n    from transformers import AutoTokenizer\\n    tok = AutoTokenizer.from_pretrained(f\\\"{W}/model\\\")\\n    te = pd.read_parquet(f\\\"{W}/mmlu_pro/data/test-00000-of-00001.parquet\\\")\\n    va = pd.read_parquet(f\\\"{W}/mmlu_pro/data/validation-00000-of-00001.parquet\\\")\\n    def rows(df, split):\\n        out = []\\n        for r in df.itertuples():\\n            opts = [str(o) for o in r.options]\\n            out.append(dict(split=split, qid=int(r.question_id), q=r.question, opts=opts, ans=r.answer, cat=r.category,\\n                            h=content_hash(r.question, opts)))\\n        return out\\n    T, V = rows(te, \\\"test\\\"), rows(va, \\\"validation\\\")\\n    stats = dict(test_raw=len(T), validation_raw=len(V))\\n    # dedup: validation (demonstration source) wins; within-split first occurrence wins\\n    seen = {}\\n    Vd = []\\n    for r in V:\\n        if r[\\\"h\\\"] not in seen: seen[r[\\\"h\\\"]] = 1; Vd.append(r)\\n    Td = []\\n    for r in T:\\n        if r[\\\"h\\\"] not in seen: seen[r[\\\"h\\\"]] = 1; Td.append(r)\\n    stats.update(validation_dedup=len(Vd), test_dedup=len(Td))\\n    # length filter\\n    keep = []\\n    for r in Td:\\n        n = len(tok(body_text(r[\\\"q\\\"], r[\\\"opts\\\"]))[\\\"input_ids\\\"])\\n        if n <= MAX_BODY_TOKENS and len(r[\\\"opts\\\"]) == 10: keep.append(r)\\n    stats[\\\"test_after_length_filter\\\"] = len(keep)\\n    cats = sorted({r[\\\"cat\\\"] for r in keep})\\n    assert len(cats) == 14, cats\\n    rng = np.random.default_rng(20261027)\\n    bycat = {c: [r for r in keep if r[\\\"cat\\\"] == c] for c in cats}\\n    for c in cats:\\n        idx = rng.permutation(len(bycat[c])); bycat[c] = [bycat[c][i] for i in idx]\\n    total = sum(len(v) for v in bycat.values())\\n    def take(n, offset):\\n        sel = []\\n        for c in cats:\\n            k = int(round(n * len(bycat[c]) / total))\\n            sel.extend(bycat[c][offset[c]:offset[c] + k]); offset[c] += k\\n        return sel\\n    off = {c: 0 for c in cats}\\n    S = take(search_n, off); F = take(final_n, off)\\n    # deterministic order within pool shuffled by seed\\n    for name, P, sd in ((\\\"search\\\", S, 1), (\\\"final\\\", F, 2)):\\n        idx = np.random.default_rng(777 + sd).permutation(len(P)); P[:] = [P[i] for i in idx]\\n    hs, hf, hd = {r[\\\"h\\\"] for r in S}, {r[\\\"h\\\"] for r in F}, {r[\\\"h\\\"] for r in Vd}\\n    ids_s, ids_f = {r[\\\"qid\\\"] for r in S}, {r[\\\"qid\\\"] for r in F}\\n    assert not (hs & hf) and not (hs & hd) and not (hf & hd) and not (ids_s & ids_f)\\n    assert len(hs) == len(S) and len(hf) == len(F)\\n    stats.update(search_pool=len(S), final_pool=len(F), overlap_search_final=0, overlap_search_demo=0, overlap_final_demo=0)\\n    # demonstrations: 3 per set from validation, seeded, distinct categories, sets disjoint\\n    drng = np.random.default_rng(31337)\\n    order = drng.permutation(len(Vd))\\n    picked, used = [], set()\\n    for i in order:\\n        if Vd[i][\\\"cat\\\"] not in used: used.add(Vd[i][\\\"cat\\\"]); picked.append(Vd[i])\\n        if len(picked) == 6: break\\n    demos = [picked[:3], picked[3:]]\\n    json.dump(dict(stats=stats, cats=cats, demos=[[dict(qid=d[\\\"qid\\\"], q=d[\\\"q\\\"], opts=d[\\\"opts\\\"], ans=d[\\\"ans\\\"], cat=d[\\\"cat\\\"], h=d[\\\"h\\\"]) for d in ds] for ds in demos],\\n                   search=[dict(qid=r[\\\"qid\\\"], q=r[\\\"q\\\"], opts=r[\\\"opts\\\"], ans=r[\\\"ans\\\"], cat=r[\\\"cat\\\"], h=r[\\\"h\\\"]) for r in S],\\n                   final=[dict(qid=r[\\\"qid\\\"], q=r[\\\"q\\\"], opts=r[\\\"opts\\\"], ans=r[\\\"ans\\\"], cat=r[\\\"cat\\\"], h=r[\\\"h\\\"]) for r in F]),\\n              open(f\\\"{W}/pools.json\\\", \\\"w\\\"))\\n    print(json.dumps(stats))\\n\\ndef score(model_dir, pool, shard, nshards, threads, limit=None):\\n    import torch\\n    torch.set_num_threads(threads)\\n    from transformers import AutoTokenizer, AutoModelForCausalLM\\n    tok = AutoTokenizer.from_pretrained(model_dir)\\n    model = AutoModelForCausalLM.from_pretrained(model_dir, dtype=torch.bfloat16 if os.environ.get(\\\"BF16\\\") else torch.float32).eval()\\n    P = json.load(open(f\\\"{W}/pools.json\\\"))\\n    qs = P[pool]; demos = P[\\\"demos\\\"]\\n    if limit: qs = qs[:int(limit)]\\n    my = list(range(shard, len(qs), nshards))\\n    enc = lambda s: tok(s, add_special_tokens=False)[\\\"input_ids\\\"]\\n    letter_ids = [tok.convert_tokens_to_ids(c) for c in LETTERS]\\n    assert all(isinstance(i, int) and i >= 0 for i in letter_ids) and len(set(letter_ids)) == 10\\n    suffix_ids = [enc(s) for s in SUFFIXES]\\n    sysmsg = \\\"<|im_start|>system\\\\nYou are a helpful assistant.<|im_end|>\\\\n<|im_start|>user\\\\n\\\"\\n    tail = \\\"<|im_end|>\\\\n<|im_start|>assistant\\\\n\\\"\\n    demo_strs = [\\\"\\\"] + [\\\"\\\".join(demo_text(d[\\\"q\\\"], d[\\\"opts\\\"], d[\\\"ans\\\"]) for d in ds) for ds in demos]\\n    prefixes = []  # (wording, demo) -> cache after prefix\\n    from transformers import DynamicCache\\n    for w in range(4):\\n        for dsi in range(3):\\n            ids = enc(sysmsg + WORDINGS[w] + \\\"\\\\n\\\\n\\\" + demo_strs[dsi])\\n            with torch.no_grad():\\n                c = DynamicCache(); out = model(torch.tensor([ids]), past_key_values=c, use_cache=True)\\n            prefixes.append((len(ids), c))\\n    Y = np.zeros((len(qs), 24), dtype=np.uint8)\\n    done = np.zeros(len(qs), dtype=bool)\\n    import time; t0 = time.time(); ntok = 0\\n    for n, qi in enumerate(my):\\n        r = qs[qi]; body = enc(body_text(r[\\\"q\\\"], r[\\\"opts\\\"]) + \\\"Answer the question above.\\\" * 0)\\n        body = body + enc(tail)\\n        gold = LETTERS.index(r[\\\"ans\\\"])\\n        for w in range(4):\\n            for dsi in range(3):\\n                plen, c = prefixes[w * 3 + dsi]\\n                with torch.no_grad():\\n                    model(torch.tensor([body]), past_key_values=c, use_cache=True)\\n                    blen = plen + len(body)\\n                    for f in range(2):\\n                        o = model(torch.tensor([suffix_ids[f]]), past_key_values=c, use_cache=True)\\n                        lg = o.logits[0, -1].float()[letter_ids]\\n                        Y[qi, (w * 3 + dsi) * 2 + f] = int(int(torch.argmax(lg)) == gold)\\n                        c.crop(-len(suffix_ids[f]))\\n                    c.crop(-len(body))\\n                ntok += len(body) + 2 * len(suffix_ids[0])\\n        done[qi] = True\\n        if n % 10 == 0:\\n            print(f\\\"shard {shard} {n+1}/{len(my)} tok/s={ntok/(time.time()-t0):.0f}\\\", flush=True)\\n            np.savez(f\\\"{W}/Y_{pool}_{shard}of{nshards}.npz\\\", Y=Y, done=done)\\n    np.savez(f\\\"{W}/Y_{pool}_{shard}of{nshards}.npz\\\", Y=Y, done=done)\\n\\nif __name__ == \\\"__main__\\\":\\n    if sys.argv[1] == \\\"prep\\\": prep(int(sys.argv[2]), int(sys.argv[3]))\\n    else:\\n        a = sys.argv[2:]\\n        score(a[0], a[1], int(a[2]), int(a[3]), int(a[4]), a[5] if len(a) > 5 else N