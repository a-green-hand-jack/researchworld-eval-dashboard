ns']\nfor section in supplement['planned_subsections']:\n assert section['heading'] and section['grounded_content'] and section['source_ids']\n assert all(source_id in data['grounding_sources'] for source_id in section['source_ids'])\nfor heading in strategy['forbidden_headings']:\n assert heading in memo\nfor phrase in strategy['forbidden_phrases']:\n assert phrase in memo\nfor field in ['status','outcome','correct']:\n assert data['grounding_sources']['final.qualification.'+field]['value']==data['final_evaluation'][field]\nassert data['final_evaluation']['status']=='completed' and data['final_evaluation']['outcome']=='qualified'\nassert len(data['final_evaluation']['evaluation_evidence']['episodes'])==6\nassert all(not Path(path).exists() for path in ['paper.tex','claims_grounding.json','figure_manifest.json'])\nassert not any(Path('figures').iterdir())\nassert 'downstream_study' not in data\nassert all(not Path(path).exists() for path in ['previous_paper','aggregated','extra_tasks'])\nprint('PASS: strategy contract, memo parity, registered source IDs, qualification facts, figure budgets and stage boundaries.')\nprint('Main paper target: 8.5 pages; required figures: 3; grounded supplementary sections: 7.')\nPY\"","aggregated_output":"@Article{Lei2016DistributionFreePI,\n author = {Jing Lei and Max G'Sell and A. Rinaldo and R. Tibshirani and L. Wasserman},\n booktitle = {Journal of the American Statistical Association},\n journal = {Journal of the American Statistical Association},\n pages = {1094 - 1111},\n title = {Distribution-Free Predictive Inference for Regression},\n volume = {113},\n year = {2016}\n}\n\n@Article{Xu2022SequentialPC,\n author = {Chen Xu and Yao Xie},\n booktitle = {International Conference on Machine Learning},\n journal = {ArXiv},\n title = {Sequential Predictive Conformal Inference for Time Series},\n volume = {abs/2212.03463},\n year = {2022}\n}\n\n@Article{Harrison2024VariationalBL,\n author = {James Harrison and John Willes and Jasper Snoek},\n booktitle = {International Conference on Learning Representations},\n journal = {ArXiv},\n title = {Variational Bayesian Last Layers},\n volume = {abs/2404.11599},\n year = {2024}\n}\n\n@Article{Kivaranovic2019AdaptiveDP,\n author = {D. Kivaranovic and Kory D. Johnson and H. Leeb},\n booktitle = {International Conference on Artificial Intelligence and Statistics},\n pages = {4346-4356},\n title = {Adaptive, Distribution-Free Prediction Intervals for Deep Networks},\n year = {2019}\n}\n\n@Article{Bian2022TrainingconditionalCF,\n author = {Michael Y. Bian and R. F. Barber},\n booktitle = {Electronic Journal of Statistics},\n journal = {Electronic Journal of Statistics},\n title = {Training-conditional coverage for distribution-free predictive inference},\n year = {2022}\n}\n\n@Article{Solari2021MultiSC,\n author = {A. Solari and Vera Djordjilovi'c},\n booktitle = {Statistics and Probability Letters},\n journal = {Statistics & Probability Letters},\n title = {Multi split conformal prediction},\n year = {2021}\n}\n\n@Article{Gui2023ConformalizedMC,\n author = {Yu Gui and R. F. Barber and Cong Ma},\n booktitle = {Neural Information Processing Systems},\n journal = {Advances in Neural Information Processing Systems 36},\n title = {Conformalized matrix completion},\n year = {2023}\n}\n\n@Article{Gonçalves2017DynamicQL,\n author = {Kelly C. M. Gonçalves and H. Migon and L. Bastos},\n booktitle = {Bayesian Analysis},\n journal = {Bayesian Analysis},\n title = {Dynamic Quantile Linear Models: A Bayesian Approach},\nPASS: strategy contract, memo parity, registered source IDs, qualification facts, figure budgets and stage boundaries.\nMain paper target: 8.5 pages; required figures: 3; grounded supplementary sections: 7.\n","exit_code":0,"status":"completed"}}
