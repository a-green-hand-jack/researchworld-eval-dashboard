{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json,csv,math,re,hashlib\nfrom pathlib import Path\npaper_data=json.loads(Path('paper_data.json').read_text())\nepisodes=paper_data['final_evaluation']['evaluation_evidence']['episodes']\nsummary=json.loads(Path('analysis/summary.json').read_text())\ncase_map={(episode['seed'],case['case']):case for episode in episodes for case in episode['solution']['cases']}\nissues=[]\nfor row in csv.DictReader(Path('analysis/condition_results.csv').open()):\n    metrics=case_map[(int(row['seed']),row['case'])]['metrics']\n    for name,value in metrics.items():\n        if not math.isclose(float(row[name]),value,rel_tol=1e-12,abs_tol=1e-14):issues.append(('CSV',row['seed'],row['case'],name))\nfor label,metrics in summary['condition_means'].items():\n    rows=[case['metrics'] for (seed,key),case in case_map.items() if key==label]\n    for name,value in metrics.items():\n        actual=math.fsum(row[name] for row in rows)/len(rows)\n        if not math.isclose(actual,value,rel_tol=1e-12,abs_tol=1e-14):issues.append(('mean',label,name))\nfor name,value in paper_data['final_evaluation']['metrics'].items():\n    if name in next(iter(case_map.values()))['metrics']:\n        actual=math.fsum(case['metrics'][name] for case in case_map.values())/len(case_map)\n        if not math.isclose(actual,value,rel_tol=1e-12,abs_tol=1e-14):issues.append(('aggregate',name,actual,value))\ntext=Path('paper.tex').read_text()\ncount=0\nfor line in text.splitlines():\n    if re.match(r'\"'^'\"\\\\d+ & \\\\d+ & (Synth\\\\.|Real) &',line):\n        fields=[field.strip() for field in line.rstrip('\\\\\\\\').split('&')]\n        seed,size,setting,arms=fields[:4]\n        label=('S' if setting=='Synth.' else 'R')+size+'K'+arms\n        metrics=case_map[(int(seed),label)]['metrics']\n        expected=[f'{metrics[name]*scale:.4f}' for name,scale in [('report_mse',1000),('reuse_mse',1000),('selected_accuracy',1),('coverage',1),('interval_width',1)]]\n        if fields[4:]\"'!=expected:issues.append(('\"'table',seed,label,fields[4:],expected))\n        count+=1\nclaims=json.loads(Path('claims_grounding.json').read_text())['claims']\nfor index,claim in enumerate(claims[:40]):\n    prefix,metrics=claim['claim'].split(': ',1)\n    seed,label=re.search(r'seed (\\\\d+), condition (\\\\S+)',prefix).groups()\n    actual=json.loads(metrics.rstrip('.'))\n    if actual\"'!=case_map[(int(seed),label)]['\"'metrics']:issues.append(('grounded-row',index))\nprint('Read-only numeric checks:',len(case_map),'evidence rows;',count,'visible seed-table rows;',len(issues),'discrepancies')\nfor issue in issues:print(issue)\nprint('Evaluator digest:',hashlib.sha256(Path('source_evidence/evaluate_final.py').read_bytes()).hexdigest(),paper_data['final_evaluation']['evaluator_sha256'])\nprint('Policy files identical:',Path('source_evidence/downstream/program/src/program.py').read_bytes()==Path('source_evidence/downstream/baseline/src/program.py').read_bytes())\nprint('Dataset examples:',len(json.loads(Path('source_evidence/resources/examples.json').read_text())))\nprint('Audits excluding zero:',[(row['seed'],row['case'],row['interval']) for row in summary['audit_differences'] if row['interval'][0]>0 or row['interval'][1]<0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
