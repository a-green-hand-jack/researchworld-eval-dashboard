 in [('coverage',count/size),('covered',count),('coverage_lower95',lower),('coverage_upper95',upper),('zero_width_count',sum(value==0 for value in values))]:check(actual,stated[key],(position,method,key))\n        assert stated['widths']==values\n        check(statistics.fmean(values),stated['width']['mean'],(position,method,'width'))\n    for method,stated in case['differences'].items():\n        values=[first-second for first,second in zip(widths['candidate'],widths[method])];mean=statistics.fmean(values);reference=summary['comparisons'][method]['difference']\n        for key,actual in [('mean',mean),('lower95',reference['lower95']),('upper95',reference['upper95'])]:check(actual,stated[key],(position,method,key))\n        critical_values.append((stated['upper95']-mean)/(statistics.stdev(values)/math.sqrt(len(values))))\n    for record in records:assert record['baselines']['full_range_sanity_interval']['lower']==0 and record['baselines']['full_range_sanity_interval']['upper']==1\nmarginal_count=paired_count=0\nfor line in tex.splitlines():\n    if not re.match(r'C\\\\d.*&',line):continue\n    fields=[item.strip() for item in line.rstrip(' \\\\\\\\').split('&')]\n    case=int(fields[0][1:])-1;method=labels[fields[1]]\n    if len(fields)==5:\n        value=analysis['cases'][case]['methods'][method];expected=[f\\\"{value['coverage']:.3f} [{value['coverage_lower95']:.3f}, {value['coverage_upper95']:.3f}]\\\",f\\\"{value['width']['mean']:.5f}\\\",str(value['zero_width_count'])];marginal_count+=1\n    elif len(fields)==4:\n        value=analysis['cases'][case]['differences'][method];expected=[f\\\"{value['mean']:+.6f}\\\",f\\\"[{value['lower95']:+.6f}, {value['upper95']:+.6f}]\\\"];paired_count+=1\n    if fields[2:]\"'!=expected:errors.append(('\"'tex-row',line,expected))\nfor name,metric,fmt in [('coverage','coverage','.3f'),('width','width','.5f')]:\n    for line in Path(f'tables/{name}.tex').read_text().splitlines():\n        if not re.match(r'C\\\\d',line):continue\n        fields=[item.strip() for item in line.rstrip(' \\\\\\\\').split('&')];case=analysis['cases'][int(fields[0][1:])-1]\n        expected=[format(case['methods'][method][metric]['mean'] if metric=='width' else case['methods'][method][metric],fmt) for method in labels.values()]\n        if fields[1:]\"'!=expected:errors.append(('\"'main-table',name,line,expected))\nassert analysis['seeds']==list(range(1001,1257));assert len(episodes)==256\nfor field in ['coverage','mean_width']:\n    values=[case['methods']['candidate']['coverage'] if field=='coverage' else case['methods']['candidate']['width']['mean'] for case in analysis['cases']]\n    check(statistics.fmean(values),paper['final_evaluation']['metrics'][field],field)\nprint('Verified 7x5 raw endpoint summaries, exact coverage limits, 35 supplementary marginal rows, 28 supplementary paired rows, main tables, seeds, pooled metrics.')\nprint('Paired critical value range:',min(critical_values),max(critical_values))\nprint('Discrepancies:',errors)\nprint('Missing grounding source IDs:',sorted({source for claim in claims for source in claim['source_ids'] if source not in paper['grounding_sources']}))\nPY\"","aggregated_output":"Verified 7x5 raw endpoint summaries, exact coverage limits, 35 supplementary marginal rows, 28 supplementary paired rows, main tables, seeds, pooled metrics.\nPaired critical value range: 1.9693105698498679 1.9693105698498805\nDiscrepancies: []\nMissing grounding source IDs: ['ref.arxiv.0907.3740', 'ref.arxiv.2311.01453', 'ref.doi.10.1002/(sici)1097-0258(19980430)17:8<857::aid-sim777>3.0.co;2-e', 'ref.doi.10.1002/9781119013563', 'ref.doi.10.1007/978-0-387-21617-1', 'ref.doi.10.1007/978-0-387-84858-7', 'ref.doi.10.1007/978-1-4612-4378-6', 'ref.doi.10.1007/978-1-4899-4541-9', 'ref.doi.10.1016/j.tcs.2009.01.016', 'ref.doi.10.1017/cbo9780511802256', 'ref.doi.10.1080/00031305.1998.10480550', 'ref.doi.10.1080/00401706.1970.10488634', 'ref.doi.10.1080/00401706.1979.10489751', 'ref.doi.10.1080/01621459.1963.10500830', 'ref.doi.10.1080/01621459.1983.10477938', 'ref.doi.10.1080/01621459.1992.10475217', 'ref.doi.10.1093/biomet/6.1.1', 'ref.doi.10.1111/ectj.12097', 'ref.doi.10.1111/j.2517-6161.1974.tb00994.x', 'ref.doi.10.1111/j.2517-6161.1995.tb02031.x', 'ref.doi.10.1126/science.adi6000', 'ref.doi.10.1214/aos/1176344552', 'ref.doi.10.1214/aos/1176345462', 'ref.doi.10.1214/ss/1009213286', 'ref.doi.10.2307/1912705']\n","exit_code":0,"status":"completed"}}
