ask/resources/search/dataset.json','task/resources/final/dataset.json']:\n d=json.load(open(path)); print(path,[(s,len(v['train']),len(v['evaluation'])) for s,v in d['splits'].items()])\nPY\"","aggregated_output":"evidence source keys dict_keys(['path', 'status'])\ntask/resources/search/dataset.json [('101', 2822, 1882), ('211', 2822, 1882)]\ntask/resources/final/dataset.json [('60613', 2823, 1882), ('70717', 2823, 1882), ('80821', 2823, 1882)]\n","exit_code":0,"status":"completed"}}
