rovement_001': {'attempt_id': 'cycle_02_honest_nonlinear_score_controls_attempt_01', 'id': 'result.improvement_001', 'idea_id': 'cycle_02_honest_nonlinear_score_controls', 'program_dir': 'work/results/t10/codex/20261107_014149/investigation/ideas/02_honest_nonlinear_score_controls_with_a_finite_sample_safety_track/program_1', 'program_id': 'program_1', 'type': 'metric', 'value': 0.8696058899689192}, 'result.top_program_01': {'attempt_id': 'cycle_02_honest_nonlinear_score_controls_attempt_01', 'id': 'result.top_program_01', 'idea_id': 'cycle_02_honest_nonlinear_score_controls', 'program_dir': 'work/results/t10/codex/20261107_014149/investigation/ideas/02_honest_nonlinear_score_controls_with_a_finite_sample_safety_track/program_1', 'program_id': 'program_1', 'type': 'metric', 'value': 0.8696058899689192}, 'result.total_attempts': {'id': 'result.total_attempts', 'type': 'count', 'value': 3}, 'result.total_correct_programs': {'id': 'result.total_correct_programs', 'type': 'count', 'value': 1}, 'result.total_evaluated_programs': {'id': 'result.total_evaluated_programs', 'type': 'count', 'value': 1}, 'result.total_ideas': {'id': 'result.total_ideas', 'type': 'count', 'value': 3}}\nSTRATEGY KEYS dict_keys(['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason'])\nFIGURES [\n  {\n    \"figure_id\": \"frozen_score_overview\",\n    \"required\": true,\n    \"purpose\": \"Make the estimand, immutable-input restriction, fold isolation, and distinction between evaluated primary and unmeasured safety intervals immediately legible.\",\n    \"figure_type\": \"diagram\",\n    \"preferred_generator\": \"generate-concept-figure\",\n    \"group_by\": \"information_flow\",\n    \"metric\": \"none_conceptual\",\n    \"split_by\": \"evaluated_primary_vs_unmeasured_safety\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"The inspected ICLR article style is single-column with a 5.5-inch text width and 9-inch text height. Use all 5.5 inches for a shallow five-object diagram; a half-text-width placement would crowd the fold-isolation labels. Place on page 1 or 2, preferably page 2 near the problem definition.\",\n    \"allow_progression\": false,\n    \"max_panels\": 1,\n    \"max_panels_per_row\": 1,\n    \"max_categories_per_panel\": 5,\n    \"max_series_per_panel\": 3,\n    \"source_ids\": [\n      \"result.top_program_01\",\n      \"final.evidence.episodes\"\n    ],\n    \"content_spec\": \"Five grouped objects: immutable labeled/unlabeled score inputs; complementary-fold fit/evaluate pairing; finite-N residual correction for E[Y]; evaluated stabilized asymptotic interval with size-only exact fallback; separate unmeasured bounded safety interval. Use solid primary and dashed safety connectors. No extra labels, predictor retraining, chronological arrows, or empirical-gain badge.\",\n    \"target_size_inches\": [\n      5.5,\n      1.8\n    ],\n    \"estimated_min_rendered_font_pt\": 9,\n    \"intended_paper_footprint\": \"About one quarter page including caption, inside the formulation allocation.\",\n    \"export_contract\": \"Retain editable draw.io source and prompt log; export vector PDF when available plus PNG at 300 DPI. Use PDF in LaTeX whenever present. If genuinely raster-only, regenerate at least 2400 pixels wide rather than upscaling.\"\n  },\n  {\n    \"figure_id\": \"coverage_width_comparison\",\n    \"required\": true,\n    \"purpose\": \"Show that the small isolated PPI++ width gain and other width increases must be assessed jointly with empirical coverage and its uncertainty.\",\n    \"figure_type\": \"paired_forest_composite\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"evaluation_condition\",\n    \"metric\": \"empirical_coverage_and_paired_mean_width_difference\",\n    \"split_by\": \"C1-C4_then_C5-C7_with_coverage_and_width_columns\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Use a 5.5-inch-wide, 2-by-2 grid in the inspected single-column style: coverage left, width difference right, C1-C4 above C5-C7. This keeps at most four conditions in any panel without shrinking seven long case labels or five method series into half a text column. Subpanels are approximately 2.4 inches wide and use concise labels and shared legends.\",\n    \"allow_progression\": false,\n    \"max_panels\": 4,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 4,\n    \"max_series_per_panel\": 4,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_spec\": \"Coverage panels: candidate, evaluated PPI++, labeled-only asymptotic, and exact binomial, with the reported 95% coverage intervals and a 0.95 reference. Width panels: paired candidate-minus-PPI++, candidate-minus-labeled-asymptotic, and candidate-minus-exact differences with reported 95% intervals and a zero line. Negative means narrower, not necessarily valid or superior. Preserve all seven conditions in fixed numeric order; group them only to satisfy readability. Width panels may use separately labeled linear scales because C5's difference is much larger. State pointwise rather than simultaneous uncertainty. PPI comparisons remain in the table and rare-outcome figure.\",\n    \"target_size_inches\": [\n      5.5,\n      4.3\n    ],\n    \"estimated_min_rendered_font_pt\": 8.5,\n    \"intended_paper_footprint\": \"About three fifths of a page including caption, inside the main comparison allocation.\",\n    \"export_contract\": \"Generate both PDF and PNG from plotting source, with PNG at 300 DPI; reference the PDF from LaTeX. Never recover legibility by raster upscaling.\"\n  },\n  {\n    \"figure_id\": \"rare_outcome_diagnostic\",\n    \"required\": true,\n    \"purpose\": \"Expose degenerate comparator intervals and the inconclusive width comparison with exact-binomial inference in the observed low-mean condition.\",\n    \"figure_type\": \"ecdf_and_zero_width_counts\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"interval_method\",\n    \"metric\": \"interval_width_distribution_and_zero_width_count\",\n    \"split_by\": \"C5_only\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Two side-by-side quantitative panels need the complete 5.5-inch single-column text width for readable ECDF axes, zero-width annotations, and four method labels. A half-width figure would make each panel too narrow. Use a shared four-method legend and label counts rather than a thresholded success metric.\",\n    \"allow_progression\": false,\n    \"max_panels\": 2,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 4,\n    \"max_series_per_panel\": 4,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_spec\": \"Use candidate, evaluated PPI++, evaluated PPI, and exact binomial. Plot empirical width CDFs from the 256 C5 endpoint records, retaining the mass at zero on a linear axis; show the corresponding zero-width counts in panel two. Mention that the labeled-only asymptotic comparator also has 115 zero-width intervals in the caption and main table. Pair the figure with coverage values and intervals in the main text, not only in the supplement. Do not claim the zero-width diagnostic proves the internal cause of every miss.\",\n    \"target_size_inches\": [\n      5.5,\n      2.2\n    ],\n    \"estimated_min_rendered_font_pt\": 8.5,\n    \"intended_paper_footprint\": \"About one third page including caption, inside the failure-analysis allocation.\",\n    \"export_contract\": \"Generate PDF and 300-DPI PNG from the same plotting source and reference the PDF. Any unavoidable raster-only full-width replacement must be regenerated at least 2400 pixels wide.\"\n  }\n]\n","exit_code":0,"status":"completed"}}
