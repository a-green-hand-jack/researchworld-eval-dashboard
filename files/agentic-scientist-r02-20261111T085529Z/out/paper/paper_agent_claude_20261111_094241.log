{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XscLT7bxGbzhdH7t5WCt4J","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Conformal prediction-set reliability evaluator for compositional (softmax) outputs.\n3\t\n4\tPlane: search (self-contained; reads only its own resource root).\n5\t\n6\tThe evaluator owns all data (in-memory NumPy synthetic generator), all labels, all\n7\tbaselines, all controls and all scoring.  The candidate only sees calibration\n8\tprobabilities + labels and unlabeled test probabilities through ``handle(request)``.\n9\t\"\"\"\n10\timport argparse\n11\timport base64\n12\timport collections\n13\timport hashlib\n14\timport importlib.util\n15\timport json\n16\timport math\n17\timport os\n18\timport re\n19\timport resource\n20\timport selectors\n21\timport shutil\n22\timport signal\n23\timport subprocess\n24\timport sys\n25\timport tempfile\n26\timport threading\n27\timport time\n28\t\n29\tos.environ.setdefault(\"OMP_NUM_THREADS\", \"2\")\n30\tos.environ.setdefault(\"OPENBLAS_NUM_THREADS\", \"2\")\n31\tos.environ.setdefault(\"MKL_NUM_THREADS\", \"2\")\n32\t\n33\timport numpy as np  # noqa: E402\n34\t\n35\t# ----------------------------------------------------------------------------\n36\t# Plane configuration (the only part that differs between the two evaluators)\n37\t# ----------------------------------------------------------------------------\n38\tPLANE = \"search\"\n39\tPLANE_WALL = 900.0\n40\tRESOURCE_ROOT = \"resources/search\"\n41\tSEEDS = [101, 102, 103]\n42\tCONTROL_PLAN = [(\"C1\", \"S1\", 101), (\"C2\", \"S1\", 101), (\"C3\", \"S1\", 101)]\n43\tRESET_SEQUENCE = [s for _ in range(4) for s in SEEDS] + [c[2] for c in CONTROL_PLAN]\n44\tMAX_RPC = 105  # 15 episodes x (1 reset + 2 calibrate + 4 predict) declared maximum\n45\tMETRIC_NAMES = ['combined_score', 'mean_marginal_coverage_gap_exchangeable', 'worst_slice_coverage_gap', 'mean_set_size_ratio', 'shift_coverage_gap', 'controls_passed_fraction', 'n_failed_episodes']\n46\t\n47\tWIRE_LIMIT = 64 * 1024 * 1024\n48\tCHUNK_ROWS = 1000\n49\tMAX_CAL_CHUNKS = 2\n50\tMAX_TEST_CHUNKS = 4\n51\tOPS_PER_EPISODE = 1 + MAX_CAL_CHUNKS + MAX_TEST_CHUNKS  # reset + calibrate + predict\n52\tBROKER_PROXY_PATH = \"/broker-code/candidate_proxy.py\"\n53\tMIN_SLICE_COUNT = 30\n54\tCOVERAGE_Z = 3.0\n55\tNEAR_FULL_RATIO = 0.9\n56\tSMOKE_N_CAL = 100\n57\tSMOKE_N_TEST = 200\n58\tRAPS_LAMBDA = 0.01\n59\tBOOTSTRAP_B = 2000\n60\tBASELINE_NAMES = (\"lac\", \"aps\", \"raps\", \"classwise\", \"uncalibrated_topmass\", \"full_set\", \"argmax_only\")\n61\tSCORED_BASELINES = (\"lac\", \"aps\", \"raps\", \"classwise\")\n62\tCONTROL_NAMES = (\"C1\", \"C2\", \"C3\")\n63\t\n64\tPROFILES = {\n65\t    \"production\": dict(wall=PLANE_WALL, startup=30.0, finish=15.0, reset=20.0, overhead=6.0,\n66\t                       rpc_cap=20.0, work=20.0, cleanup=6.0),\n67\t    \"smoke\": dict(wall=120.0, startup=10.0, finish=5.0, reset=10.0, overhead=4.0,\n68\t                  rpc_cap=10.0, work=10.0, cleanup=4.0),\n69\t}\n70\t\n71\t\n72\t# ----------------------------------------------------------------------------\n73\t# Failure identity helpers\n74\t# ----------------------------------------------------------------------------\n75\tclass InvalidResetResponse(RuntimeError):\n76\t    pass\n77\t\n78\t\n79\tdef require_reset_ack(response):\n80\t    if type(response) is not dict or set(response) != {\"ok\"} or response[\"ok\"] is not True:\n81\t        raise InvalidResetResponse(\"invalid reset response\")\n82\t\n83\t\n84\tdef bounded_failure_name(value, fallback):\n85\t    return value if isinstance(value, str) and re.fullmatch(r\"[a-z][a-z0-9_]{0,79}\", value) else fallback\n86\t\n87\t\n88\tclass RequiredBaselineFailure(RuntimeError):\n89\t    def __init__(self, category):\n90\t        self.category = bounded_failure_name(category, \"invalid_baseline_diagnostic\")\n91\t        super().__init__(\"required baseline failed\")\n92\t\n93\t\n94\tclass CandidateFailure(RuntimeError):\n95\t    \"\"\"Expected candidate-side protocol failure with a fixed category.\"\"\"\n96\t\n97\t    def __init__(self, category):\n98\t        self.category = bounded_failure_name(category, \"candidate_failure\")\n99\t        super().__init__(\"candidate failure\")\n100\t\n101\t\n102\tdef describe_episode_failure(error, operation):\n103\t    context = error\n104\t    for _ in range(8):\n105\t        if isinstance(context, InvalidResetResponse):\n106\t            return {\"component\": \"candidate\", \"category\": \"invalid_reset_response\", \"operation\": \"reset\"}\n107\t        if isinstance(context, RequiredBaselineFailure):\n108\t            return {\"component\": \"baseline\", \"category\": context.category, \"operation\": \"baseline_worker\"}\n109\t        if isinstance(context, CandidateFailure):\n110\t            return {\"component\": \"candidate\", \"category\": context.category,\n111\t                    \"operation\": bounded_failure_name(operation, \"unknown\")}\n112\t        context = context.__context__\n113\t        if context is None:\n114\t            break\n115\t    return {\"component\": \"candidate\", \"category\": \"timeout\",\n116\t            \"operation\": bounded_failure_name(operation, \"unknown\")}\n117\t\n118\t\n119\tdef fail_required_baseline(category, cancel_work, record_failure):\n120\t    failure = RequiredBaselineFailure(category)\n121\t    try:\n122\t        record_failure(failure.category)\n123\t    except Exception:\n124\t        failure.add_note(\"baseline diagnostic recording failed\")\n125\t    try:\n126\t        cancel_work()\n127\t    except Exception:\n128\t        failure.add_note(\"baseline cleanup failed\")\n129\t    raise failure from None\n130\t\n131\t\n132\t# ----------------------------------------------------------------------------\n133\t# Bounded worker stderr capture (used for the native smoke candidate subprocess)\n134\t# ----------------------------------------------------------------------------\n135\tclass BoundedWorkerStderr:\n136\t    LIMIT = 4096\n137\t\n138\t    def __init__(self, stream):\n139\t        self.stream = stream\n140\t        self.fd = stream.fileno()\n141\t        os.set_blocking(self.fd, False)\n142\t        self.lines = collections.deque()\n143\t        self.pending = bytearray()\n144\t        self.dropping_line = False\n145\t        self.observed_bytes = 0\n146\t        self.retained_bytes = 0\n147\t        self.truncated = False\n148\t        self.capture_error = None\n149\t        self.stop = threading.Event()\n150\t        self.result = None\n151\t        self.reader = threading.Thread(target=self._drain, name=\"worker-stderr-reader\", daemon=True)\n152\t        self.reader.start()\n153\t\n154\t    def _accept(self, chunk):\n155\t        self.observed_bytes += len(chunk)\n156\t        for segment in chunk.splitlines(keepends=True):\n157\t            complete = segment.endswith(b\"\\n\")\n158\t            if not self.dropping_line:\n159\t                if len(self.pending) + len(segment) > self.LIMIT:\n160\t                    self.pending.clear()\n161\t                    self.dropping_line = True\n162\t                    self.truncated = True\n163\t                else:\n164\t                    self.pending.extend(segment)\n165\t            if complete:\n166\t                if not self.dropping_line:\n167\t                    line = bytes(self.pending).decode(\"utf-8\", errors=\"replace\")\n168\t                    size = len(line.encode(\"utf-8\"))\n169\t                    if size <= self.LIMIT:\n170\t                        while self.retained_bytes + size > self.LIMIT:\n171\t                            self.retained_bytes -= len(self.lines.popleft().encode(\"utf-8\"))\n172\t                            self.truncated = True\n173\t                        self.lines.append(line)\n174\t                        self.retained_bytes += size\n175\t                    else:\n176\t                        self.truncated = True\n177\t                self.pending.clear()\n178\t                self.dropping_line = False\n179\t\n180\t    def _drain(self):\n181\t        try:\n182\t            with selectors.DefaultSelector() as selector:\n183\t                selector.register(self.fd, selectors.EVENT_READ)\n184\t                while not self.stop.is_set():\n185\t                    if not selector.select(timeout=.05):\n186\t                        continue\n187\t                    try:\n188\t                        chunk = os.read(self.fd, 8192)\n189\t                    except BlockingIOError:\n190\t                        continue\n191\t                    if not chunk:\n192\t                        return\n193\t                    self._accept(chunk)\n194\t                self.capture_error = \"reader_stopped_before_eof\"\n195\t                self.truncated = True\n196\t        except (OSError, ValueError):\n197\t            self.capture_error = \"stderr_capture_failed\"\n198\t            self.truncated = True\n199\t        finally:\n200\t            if self.pending or self.dropping_line:\n201\t                self.truncated = True\n202\t            self.pending.clear()\n203\t            self.stream.close()\n204\t\n205\t    def close(self):\n206\t        if self.result is not None:\n207\t            return dict(self.result)\n208\t        self.reader.join(timeout=.2)\n209\t        if self.reader.is_alive():\n210\t            self.stop.set()\n211\t            self.reader.join(timeout=.2)\n212\t        if self.reader.is_alive():\n213\t            raise RuntimeError(\"stderr reader cleanup unresolved\")\n214\t        self.result = {\n215\t            \"stderr\": \"\".join(self.lines),\n216\t            \"observed_bytes\": self.observed_bytes,\n217\t            \"retained_bytes\": self.retained_bytes,\n218\t            \"truncated\": self.truncated,\n219\t            \"capture_error\": self.capture_error,\n220\t        }\n221\t        return dict(self.result)\n222\t\n223\t\n224\t# ----------------------------------------------------------------------------\n225\t# Budget helpers\n226\t# ----------------------------------------------------------------------------\n227\tdef finite_budget_seconds(value):\n228\t    if type(value) not in (int, float) or not math.isfinite(value) or value < 0:\n229\t        raise ValueError(\"invalid time allowance\")\n230\t    return value\n231\t\n232\t\n233\tdef positive_work_seconds(value):\n234\t    if finite_budget_seconds(value) == 0:\n235\t        raise ValueError(\"work allowance must be positive\")\n236\t    return value\n237\t\n238\t\n239\tdef cpu_limit_seconds(wall_seconds, allowed_threads):\n240\t    if (type(wall_seconds) not in (int, float) or not math.isfinite(wall_seconds)\n241\t            or wall_seconds <= 0 or type(allowed_threads) is not int or allowed_threads <= 0):\n242\t        raise ValueError(\"invalid CPU budget\")\n243\t    return math.ceil(wall_seconds * allowed_threads)\n244\t\n245\t\n246\tdef require_joint_workload_budget(*, episode_count, method_count, wall_seconds, startup_seconds,\n247\t                                  reset_seconds, cleanup_seconds, finish_seconds, work_seconds):\n248\t    if any(type(c) is not int or c <= 0 for c in (episode_count, method_count)):\n249\t        raise ValueError(\"invalid episode or method count\")\n250\t    for v in (wall_seconds, startup_seconds, reset_seconds, cleanup_seconds, finish_seconds):\n251\t        finite_budget_seconds(v)\n252\t    work = positive_work_seconds(work_seconds)\n253\t    needed = (startup_seconds + finish_seconds\n254\t              + episode_count * (reset_seconds + method_count * (work + cleanup_seconds)))\n255\t    if needed > wall_seconds:\n256\t        raise ValueError(\"productive work exceeds the declared wall budget\")\n257\t    return needed\n258\t\n259\t\n260\tdef bounded_json_line(value, wire_limit=WIRE_LIMIT):\n261\t    encoded = json.dumps(value, allow_nan=False, separators=(\",\", \":\")).encode(\"utf-8\") + b\"\\n\"\n262\t    if len(encoded) >= wire_limit:\n263\t        raise ValueError(\"complete message exceeds wire limit\")\n264\t    return encoded\n265\t\n266\t\n267\tdef _reject_constant(name):\n268\t    raise ValueError(\"non-finite JSON constant\")\n269\t\n270\t\n271\tdef _no_duplicate_pairs(pairs):\n272\t    out = {}\n273\t    for key, value in pairs:\n274\t        if key in out:\n275\t            raise ValueError(\"duplicate JSON key\")\n276\t        out[key] = value\n277\t    return out\n278\t\n279\t\n280\tdef strict_json_loads(text):\n281\t    return json.loads(text, parse_constant=_reject_constant, object_pairs_hook=_no_duplicate_pairs)\n282\t\n283\t\n284\t# ----------------------------------------------------------------------------\n285\t# Candidate transports\n286\t# ----------------------------------------------------------------------------\n287\tNATIVE_RUNNER = r'''\n288\timport importlib.util, json, os, sys\n289\tout = os.fdopen(os.dup(1), \"w\", buffering=1, encoding=\"utf-8\")\n290\tos.dup2(2, 1)\n291\tsys.stdout = sys.stderr\n292\tpath = os.path.abspath(sys.argv[1])\n293\trepair = sys.argv[2] == \"1\"\n294\tsys.path.insert(0, os.path.dirname(path))\n295\tspec = importlib.util.spec_from_file_location(\"candidate_program\", path)\n296\tmod = importlib.util.module_from_spec(spec)\n297\tspec.loader.exec_module(mod)\n298\thandle = mod.handle\n299\tfor line in sys.stdin:\n300\t    try:\n301\t        resp = handle(json.loads(line))\n302\t        data = json.dumps(resp, allow_nan=False, separators=(\",\", \":\"))\n303\t    except BaseException as error:\n304\t        if repair:\n305\t            msg = str(error)\n306\t            if len(msg) > 2048:\n307\t                msg = \"<message omitted>\"\n308\t            sys.stderr.write(\"worker_exception type=%s\\n%s\\n\" % (type(error).__name__, msg))\n309\t        else:\n310\t            sys.stderr.write(\"worker_exception\\n\")\n311\t        sys.stderr.flush()\n312\t        data = json.dumps({\"__runner_error__\": 1})\n313\t    out.write(data + \"\\n\")\n314\t    out.flush()\n315\t'''\n316\t\n317\t\n318\tdef candidate_subprocess_settings(parent_environment):\n319\t    runtime_names = (\n320\t        \"PATH\", \"LD_LIBRARY_PATH\", \"LANG\", \"LC_ALL\", \"TZ\",\n321\t        \"CUDA_VISIBLE_DEVICES\", \"NVIDIA_VISIBLE_DEVICES\", \"NVIDIA_DRIVER_CAPABILITIES\",\n322\t        \"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\",\n323\t        \"XLA_PYTHON_CLIENT_PREALLOCATE\", \"XLA_PYTHON_CLIENT_MEM_FRACTION\",\n324\t        \"XLA_PYTHON_CLIENT_ALLOCATOR\",\n325\t    )\n326\t    environment = {name: parent_environment[name] for name in runtime_names if name in parent_environment}\n327\t    environment.update(HOME=\"/nonexistent\", PYTHONNOUSERSITE=\"1\", PYTHONDONTWRITEBYTECODE=\"1\",\n328\t                       PYTHONUNBUFFERED=\"1\")\n329\t    for name in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\"):\n330\t        environment[name] = \"4\"\n331\t    return parent_environment.get(\"TASK_PYTHON\", sys.executable), environment\n332\t\n333\t\n334\tclass NativeCandidate:\n335\t    \"\"\"Untrusted candidate in a killable, resource-limited subprocess (native smoke runs).\"\"\"\n336\t\n337\t    def __init__(self, program_path, wall_seconds, repair_mode):\n338\t        self.program_path = os.path.abspath(program_path)\n339\t        self.cpu_seconds = cpu_limit_seconds(wall_seconds, 4)\n340\t        self.repair_mode = repair_mode\n341\t        self.proc = None\n342\t        self.capture = None\n343\t        self.snapshot = None\n344\t        self.rbuf = bytearray()\n345\t        self.cwd = tempfile.mkdtemp(prefix=\"cand_cwd_\", dir=\"/tmp\")\n346\t\n347\t    def _limits(self):\n348\t        resource.setrlimit(resource.RLIMIT_CPU, (self.cpu_seconds, self.cpu_seconds + 5))\n349\t        resource.setrlimit(resource.RLIMIT_AS, (8 << 30, 8 << 30))\n350\t        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))\n351\t\n352\t    def start(self):\n353\t        self.stop()\n354\t        python, env = candidate_subprocess_settings(os.environ)\n355\t        self.proc = subprocess.Popen(\n356\t            [python, \"-c\", NATIVE_RUNNER, self.program_path, \"1\" if self.repair_mode else \"0\"],\n357\t            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,\n358\t            cwd=self.cwd, shell=False, start_new_session=True, preexec_fn=self._limits, close_fds=True)\n359\t        self.capture = BoundedWorkerStderr(self.proc.stderr)\n360\t        self.snapshot = None\n361\t        self.rbuf = bytearray()\n362\t        os.set_blocking(self.proc.stdin.fileno(), False)\n363\t        os.set_blocking(self.proc.stdout.fileno(), False)\n364\t\n365\t    def stop(self):\n366\t        proc, self.proc = self.proc, None\n367\t        if proc is None:\n368\t            return self.snapshot\n369\t        try:\n370\t            try:\n371\t                os.killpg(proc.pid, signal.SIGKILL)\n372\t            except (ProcessLookupError, PermissionError):\n373\t                pass\n374\t            for stream in (proc.stdin, proc.stdout):\n375\t                try:\n376\t                    stream.close()\n377\t                except OSError:\n378\t                    pass\n379\t            try:\n380\t                proc.wait(timeout=2.0)\n381\t            except subprocess.TimeoutExpired:\n382\t                pass\n383\t        finally:\n384\t            try:\n385\t                self.snapshot = self.capture.close()\n386\t            except RuntimeError:\n387\t                self.snapshot = {\"stderr\": \"\", \"observed_bytes\": 0, \"retained_bytes\": 0,\n388\t                                 \"truncated\": True, \"capture_error\": \"cleanup_unresolved\"}\n389\t        return self.snapshot\n390\t\n391\t    def cleanup(self):\n392\t        self.stop()\n393\t        shutil.rmtree(self.cwd, ignore_errors=True)\n394\t\n395\t    def call(self, request, timeout):\n396\t        if self.proc is None:\n397\t            raise CandidateFailure(\"transport_closed\")\n398\t        deadline = time.monotonic() + timeout\n399\t        data = bounded_json_line(request)\n400\t        fd_in = self.proc.stdin.fileno()"}]},"parent_tool_use_id":null,"session_id":"163efe90-675b-4e09-a080-713d4bfbbf15","uuid":"a498a418-d59e-4e72-8a47-79928c68a29c","timestamp":"2026-11-11T09:47:56.137Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/paper/results/task/evaluate.py","content":"#!/usr/bin/env python3\n\"\"\"Conformal prediction-set reliability evaluator for compositional (softmax) outputs.\n\nPlane: search (self-contained; reads only its own resource root).\n\nThe evaluator owns all data (in-memory NumPy synthetic generator), all labels, all\nbaselines, all controls and all scoring.  The candidate only sees calibration\nprobabilities + labels and unlabeled test probabilities through ``handle(request)``.\n\"\"\"\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nimport re\nimport resource\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\n\nos.environ.setdefault(\"OMP_NUM_THREADS\", \"2\")\nos.environ.setdefault(\"OPENBLAS_NUM_THREADS\", \"2\")\nos.environ.setdefault(\"MKL_NUM_THREADS\", \"2\")\n\nimport numpy as np  # noqa: E402\n\n# ----------------------------------------------------------------------------\n# Plane configuration (the only part that differs between the two evaluators)\n# ----------------------------------------------------------------------------\nPLANE = \"search\"\nPLANE_WALL = 900.0\nRESOURCE_ROOT = \"resources/search\"\nSEEDS = [101, 102, 103]\nCONTROL_PLAN = [(\"C1\", \"S1\", 101), (\"C2\", \"S1\", 101), (\"C3\", \"S1\", 101)]\nRESET_SEQUENCE = [s for _ in range(4) for s in SEEDS] + [c[2] for c in CONTROL_PLAN]\nMAX_RPC = 105  # 15 episodes x (1 reset + 2 calibrate + 4 predict) declared maximum\nMETRIC_NAMES = ['combined_score', 'mean_marginal_coverage_gap_exchangeable', 'worst_slice_coverage_gap', 'mean_set_size_ratio', 'shift_coverage_gap', 'controls_passed_fraction', 'n_failed_episodes']\n\nWIRE_LIMIT = 64 * 1024 * 1024\nCHUNK_ROWS = 1000\nMAX_CAL_CHUNKS = 2\nMAX_TEST_CHUNKS = 4\nOPS_PER_EPISODE = 1 + MAX_CAL_CHUNKS + MAX_TEST_CHUNKS  # reset + calibrate + predict\nBROKER_PROXY_PATH = \"/broker-code/candidate_proxy.py\"\nMIN_SLICE_COUNT = 30\nCOVERAGE_Z = 3.0\nNEAR_FULL_RATIO = 0.9\nSMOKE_N_CAL = 100\nSMOKE_N_TEST = 200\nRAPS_LAMBDA = 0.01\nBOOTSTRAP_B = 2000\nBASELINE_NAMES = (\"lac\", \"aps\", \"raps\", \"classwise\", \"uncalibrated_topmass\", \"full_set\", \"argmax_only\")\nSCORED_BASELINES = (\"lac\", \"aps\", \"raps\", \"classwise\")\nCONTROL_NAMES = (\"C1\", \"C2\", \"C3\")\n\nPROFILES = {\n    \"production\": dict(wall=PLANE_WALL, startup=30.0, finish=15.0, reset=20.0, overhead=6.0,\n                       rpc_cap=20.0, work=20.0, cleanup=6.0),\n    \"smoke\": dict(wall=120.0, startup=10.0, finish=5.0, reset=10.0, overhead=4.0,\n                  rpc_cap=10.0, work=10.0, cleanup=4.0),\n}\n\n\n# ----------------------------------------------------------------------------\n# Failure identity helpers\n# ----------------------------------------------------------------------------\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {\"ok\"} or response[\"ok\"] is not True:\n        raise InvalidResetResponse(\"invalid reset response\")\n\n\ndef bounded_failure_name(value, fallback):\n    return value if isinstance(value, str) and re.fullmatch(r\"[a-z][a-z0-9_]{0,79}\", value) else fallback\n\n\nclass RequiredBaselineFailure(RuntimeError):\n    def __init__(self, category):\n        self.category = bounded_failure_name(category, \"invalid_baseline_diagnostic\")\n        super().__init__(\"required baseline failed\")\n\n\nclass CandidateFailure(RuntimeError):\n    \"\"\"Expected candidate-side protocol failure with a fixed category.\"\"\"\n\n    def __init__(self, category):\n        self.category = bounded_failure_name(category, \"candidate_failure\")\n        super().__init__(\"candidate failure\")\n\n\ndef describe_episode_failure(error, operation):\n    context = error\n    for _ in range(8):\n        if isinstance(context, InvalidResetResponse):\n            return {\"component\": \"candidate\", \"category\": \"invalid_reset_response\", \"operation\": \"reset\"}\n        if isinstance(context, RequiredBaselineFailure):\n            return {\"component\": \"baseline\", \"category\": context.category, \"operation\": \"baseline_worker\"}\n        if isinstance(context, CandidateFailure):\n            return {\"component\": \"candidate\", \"category\": context.category,\n                    \"operation\": bounded_failure_name(operation, \"unknown\")}\n        context = context.__context__\n        if context is None:\n            break\n    return {\"component\": \"candidate\", \"category\": \"timeout\",\n            \"operation\": bounded_failure_name(operation, \"unknown\")}\n\n\ndef fail_required_baseline(category, cancel_work, record_failure):\n    failure = RequiredBaselineFailure(category)\n    try:\n        record_failure(failure.category)\n    except Exception:\n        failure.add_note(\"baseline diagnostic recording failed\")\n    try:\n        cancel_work()\n    except Exception:\n        failure.add_note(\"baseline cleanup failed\")\n    raise failure from None\n\n\n# ----------------------------------------------------------------------------\n# Bounded worker stderr capture (used for the native smoke candidate subprocess)\n# ----------------------------------------------------------------------------\nclass BoundedWorkerStderr:\n    LIMIT = 4096\n\n    def __init__(self, stream):\n        self.stream = stream\n        self.fd = stream.fileno()\n        os.set_blocking(self.fd, False)\n        self.lines = collections.deque()\n        self.pending = bytearray()\n        self.dropping_line = False\n        self.observed_bytes = 0\n        self.retained_bytes = 0\n        self.truncated = False\n        self.capture_error = None\n        self.stop = threading.Event()\n        self.result = None\n        self.reader = threading.Thread(target=self._drain, name=\"worker-stderr-reader\", daemon=True)\n        self.reader.start()\n\n    def _accept(self, chunk):\n        self.observed_bytes += len(chunk)\n        for segment in chunk.splitlines(keepends=True):\n            complete = segment.endswith(b\"\\n\")\n            if not self.dropping_line:\n                if len(self.pending) + len(segment) > self.LIMIT:\n                    self.pending.clear()\n                    self.dropping_line = True\n                    self.truncated = True\n                else:\n                    self.pending.extend(segment)\n            if complete:\n                if not self.dropping_line:\n                    line = bytes(self.pending).decode(\"utf-8\", errors=\"replace\")\n                    size = len(line.encode(\"utf-8\"))\n                    if size <= self.LIMIT:\n                        while self.retained_bytes + size > self.LIMIT:\n                            self.retained_bytes -= len(self.lines.popleft().encode(\"utf-8\"))\n                            self.truncated = True\n                        self.lines.append(line)\n                        self.retained_bytes += size\n                    else:\n                        self.truncated = True\n                self.pending.clear()\n                self.dropping_line = False\n\n    def _drain(self):\n        try:\n            with selectors.DefaultSelector() as selector:\n                selector.register(self.fd, selectors.EVENT_READ)\n                while not self.stop.is_set():\n                    if not selector.select(timeout=.05):\n                        continue\n                    try:\n                        chunk = os.read(self.fd, 8192)\n                    except BlockingIOError:\n                        continue\n                    if not chunk:\n                        return\n                    self._accept(chunk)\n                self.capture_error = \"reader_stopped_before_eof\"\n                self.truncated = True\n        except (OSError, ValueError):\n            self.capture_error = \"stderr_capture_failed\"\n            self.truncated = True\n        finally:\n            if self.pending or self.dropping_line:\n                self.truncated = True\n            self.pending.clear()\n            self.stream.close()\n\n    def close(self):\n        if self.result is not None:\n            return dict(self.result)\n        self.reader.join(timeout=.2)\n        if self.reader.is_alive():\n            self.stop.set()\n            self.reader.join(timeout=.2)\n        if self.reader.is_alive():\n            raise RuntimeError(\"stderr reader cleanup unresolved\")\n        self.result = {\n            \"stderr\": \"\".join(self.lines),\n            \"observed_bytes\": self.observed_bytes,\n            \"retained_bytes\": self.retained_bytes,\n            \"truncated\": self.truncated,\n            \"capture_error\": self.capture_error,\n        }\n        return dict(self.result)\n\n\n# ----------------------------------------------------------------------------\n# Budget helpers\n# ----------------------------------------------------------------------------\ndef finite_budget_seconds(value):\n    if type(value) not in (int, float) or not math.isfinite(value) or value < 0:\n        raise ValueError(\"invalid time allowance\")\n    return value\n\n\ndef positive_work_seconds(value):\n    if finite_budget_seconds(value) == 0:\n        raise ValueError(\"work allowance must be positive\")\n    return value\n\n\ndef cpu_limit_seconds(wall_seconds, allowed_threads):\n    if (type(wall_seconds) not in (int, float) or not math.isfinite(wall_seconds)\n            or wall_seconds <= 0 or type(allowed_threads) is not int or allowed_threads <= 0):\n        raise ValueError(\"invalid CPU budget\")\n    return math.ceil(wall_seconds * allowed_threads)\n\n\ndef require_joint_workload_budget(*, episode_count, method_count, wall_seconds, startup_seconds,\n                                  reset_seconds, cleanup_seconds, finish_seconds, work_seconds):\n    if any(type(c) is not int or c <= 0 for c in (episode_count, method_count)):\n        raise ValueError(\"invalid episode or method count\")\n    for v in (wall_seconds, startup_seconds, reset_seconds, cleanup_seconds, finish_seconds):\n        finite_budget_seconds(v)\n    work = positive_work_seconds(work_seconds)\n    needed = (startup_seconds + finish_seconds\n              + episode_count * (reset_seconds + method_count * (work + cleanup_seconds)))\n    if needed > wall_seconds:\n        raise ValueError(\"productive work exceeds the declared wall budget\")\n    return needed\n\n\ndef bounded_json_line(value, wire_limit=WIRE_LIMIT):\n    encoded = json.dumps(value, allow_nan=False, separators=(\",\", \":\")).encode(\"utf-8\") + b\"\\n\"\n    if len(encoded) >= wire_limit:\n        raise ValueError(\"complete message exceeds wire limit\")\n    return encoded\n\n\ndef _reject_constant(name):\n    raise ValueError(\"non-finite JSON constant\")\n\n\ndef _no_duplicate_pairs(pairs):\n    out = {}\n    for key, value in pairs:\n        if key in out:\n            raise ValueError(\"duplicate JSON key\")\n        out[key] = value\n    return out\n\n\ndef strict_json_loads(text):\n    return json.loads(text, parse_constant=_reject_constant, object_pairs_hook=_no_duplicate_pairs)\n\n\n# ----------------------------------------------------------------------------\n# Candidate transports\n# ----------------------------------------------------------------------------\nNATIVE_RUNNER = r'''\nimport importlib.util, json, os, sys\nout = os.fdopen(os.dup(1), \"w\", buffering=1, encoding=\"utf-8\")\nos.dup2(2, 1)\nsys.stdout = sys.stderr\npath = os.path.abspath(sys.argv[1])\nrepair = sys.argv[2] == \"1\"\nsys.path.insert(0, os.path.dirname(path))\nspec = importlib.util.spec_from_file_location(\"candidate_program\", path)\nmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mod)\nhandle = mod.handle\nfor line in sys.stdin:\n    try:\n        resp = handle(json.loads(line))\n        data = json.dumps(resp, allow_nan=False, separators=(\",\", \":\"))\n    except BaseException as error:\n        if repair:\n            msg = str(error)\n            if len(msg) > 2048:\n                msg = \"<message omitted>\"\n            sys.stderr.write(\"worker_exception type=%s\\n%s\\n\" % (type(error).__name__, msg))\n        else:\n            sys.stderr.write(\"worker_exception\\n\")\n        sys.stderr.flush()\n        data = json.dumps({\"__runner_error__\": 1})\n    out.write(data + \"\\n\")\n    out.flush()\n'''\n\n\ndef candidate_subprocess_settings(parent_environment):\n    runtime_names = (\n        \"PATH\", \"LD_LIBRARY_PATH\", \"LANG\", \"LC_ALL\", \"TZ\",\n        \"CUDA_VISIBLE_DEVICES\", \"NVIDIA_VISIBLE_DEVICES\", \"NVIDIA_DRIVER_CAPABILITIES\",\n        \"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\",\n        \"XLA_PYTHON_CLIENT_PREALLOCATE\", \"XLA_PYTHON_CLIENT_MEM_FRACTION\",\n        \"XLA_PYTHON_CLIENT_ALLOCATOR\",\n    )\n    environment = {name: parent_environment[name] for name in runtime_names if name in parent_environment}\n    environment.update(HOME=\"/nonexistent\", PYTHONNOUSERSITE=\"1\", PYTHONDONTWRITEBYTECODE=\"1\",\n                       PYTHONUNBUFFERED=\"1\")\n    for name in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\"):\n        environment[name] = \"4\"\n    return parent_environment.get(\"TASK_PYTHON\", sys.executable), environment\n\n\nclass NativeCandidate:\n    \"\"\"Untrusted candidate in a killable, resource-limited subprocess (native smoke runs).\"\"\"\n\n    def __init__(self, program_path, wall_seconds, repair_mode):\n        self.program_path = os.path.abspath(program_path)\n        self.cpu_seconds = cpu_limit_seconds(wall_seconds, 4)\n        self.repair_mode = repair_mode\n        self.proc = None\n        self.capture = None\n        self.snapshot = None\n        self.rbuf = bytearray()\n        self.cwd = tempfile.mkdtemp(prefix=\"cand_cwd_\", dir=\"/tmp\")\n\n    def _limits(self):\n        resource.setrlimit(resource.RLIMIT_CPU, (self.cpu_seconds, self.cpu_seconds + 5))\n        resource.setrlimit(resource.RLIMIT_AS, (8 << 30, 8 << 30))\n        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))\n\n    def start(self):\n        self.stop()\n        python, env = candidate_subprocess_settings(os.environ)\n        self.proc = subprocess.Popen(\n            [python, \"-c\", NATIVE_RUNNER, self.program_path, \"1\" if self.repair_mode else \"0\"],\n            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,\n            cwd=self.cwd, shell=False, start_new_session=True, preexec_fn=self._limits, close_fds=True)\n        self.capture = BoundedWorkerStderr(self.proc.stderr)\n        self.snapshot = None\n        self.rbuf = bytearray()\n        os.set_blocking(self.proc.stdin.fileno(), False)\n        os.set_blocking(self.proc.stdout.fileno(), False)\n\n    def stop(self):\n        proc, self.proc = self.proc, None\n        if proc is None:\n            return self.snapshot\n        try:\n            try:\n                os.killpg(proc.pid, signal.SIGKILL)\n            except (ProcessLookupError, PermissionError):\n                pass\n            for stream in (proc.stdin, proc.stdout):\n                try:\n                    stream.close()\n                except OSError:\n                    pass\n            try:\n                proc.wait(timeout=2.0)\n            except subprocess.TimeoutExpired:\n                pass\n        finally:\n            try:\n                self.snapshot = self.capture.close()\n            except RuntimeError:\n                self.snapshot = {\"stderr\": \"\", \"observed_bytes\": 0, \"retained_bytes\": 0,\n                                 \"truncated\": True, \"capture_error\": \"cleanup_unresolved\"}\n        return self.snapshot\n\n    def cleanup(self):\n        self.stop()\n        shutil.rmtree(self.cwd, ignore_errors=True)\n\n    def call(self, request, timeout):\n        if self.proc is None:\n            raise CandidateFailure(\"transport_closed\")\n        deadline = time.monotonic() + timeout\n        data = bounded_json_line(request)\n        fd_in = self.proc.stdin.fileno()","numLines":400,"startLine":1,"totalLines":1210}}}
