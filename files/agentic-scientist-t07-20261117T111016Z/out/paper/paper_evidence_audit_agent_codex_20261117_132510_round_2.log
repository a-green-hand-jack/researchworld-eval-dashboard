14632649205711504\n      },\n      \"prior_mae\": {\n        \"candidate_minus_baseline_mae\": -0.04435856081606998,\n        \"lower_95\": -0.0584542588406073,\n        \"upper_95\": -0.032429878882884206\n      },\n      \"uniform_mae\": {\n        \"candidate_minus_baseline_mae\": -0.0662138125648232,\n        \"lower_95\": -0.07118833982860809,\n        \"upper_95\": -0.06124024345684073\n      }\n    },\n    \"failed_normal_cells\": 0,\n    \"policy\": \"paired lineage-block bootstrap; checkpoints/seeds retained within groups; equal case weights; 200 draws; fixed failure differences 1-1=0; conditional on fixed cases\"\n  },\n  \"local_irt_reversals\": [\n    [\n      \"legalbench\",\n      5\n    ],\n    [\n      \"legalbench\",\n      25\n    ],\n    [\n      \"math\",\n      5\n    ],\n    [\n      \"math\",\n      10\n    ],\n    [\n      \"math\",\n      25\n    ],\n    [\n      \"med_qa\",\n      10\n    ],\n    [\n      \"med_qa\",\n      25\n    ]\n  ]\n}\nLeaderboard MATH & 10 & 1.60 & 3.34 & 3.95 & 4.33 & 3.80 \\\\\nLeaderboard MATH & 25 & 1.11 & 2.60 & 2.31 & 4.33 & 2.75 \\\\\nLegalBench & 5 & 5.66 & 5.52 & 12.41 & 7.04 & 12.79 \\\\\nLegalBench & 10 & 4.73 & 5.07 & 7.93 & 7.04 & 11.01 \\\\\nLegalBench & 25 & 4.47 & 4.38 & 6.94 & 7.04 & 8.80 \\\\\nHELM MATH & 5 & 11.63 & 9.53 & 15.15 & 17.14 & 27.42 \\\\\nHELM MATH & 10 & 8.92 & 7.59 & 12.33 & 17.14 & 25.07 \\\\\nHELM MATH & 25 & 6.19 & 5.61 & 6.66 & 17.14 & 20.86 \\\\\nMedQA & 5 & 6.68 & 8.21 & 9.81 & 11.67 & 22.63 \\\\\nMedQA & 10 & 7.47 & 6.56 & 10.96 & 11.67 & 20.71 \\\\\nMedQA & 25 & 5.54 & 4.51 & 10.00 & 11.67 & 12.36 \\\\\nMMLU & 5 & 4.58 & 7.88 & 20.88 & 7.47 & 14.34 \\\\\nMMLU & 10 & 3.56 & 5.43 & 8.30 & 7.47 & 9.81 \\\\\nMMLU & 25 & 3.05 & 3.20 & 4.74 & 7.47 & 6.62 \\\\\n\\bottomrule\n\\end{tabular}\n% END GENERATED case_budget\n% @evidence[[analysis/paper_statistics.json#/by_case_budget]]\n\\end{table}\n\n\\begin{figure}[ht]\n\\centering\n\\includegraphics[width=\\textwidth]{figures/budget_sensitivity.pdf}\n\\caption{Budget sensitivity, averaging over the same retained benchmarks and seeds. Top: absolute score error. Bottom: lineage-level Spearman correlation. Lines connect query budgets on nested paths, not an optimization history. The constant source prior is omitted from both panels to keep the common four-method legend readable.}\n\\label{fig:budget}\n% @evidence[[analysis/paper_statistics.json#/by_budget]]\n\\end{figure}\n\n\\subsection{Paired Uncertainty, Seeds, and Controls}\nFor a given benchmark, errors are first averaged within each target lineage over its rows, query budgets, and seeds. The difference between package and comparator is formed before resampling. Lineage identifiers are sampled with replacement within each benchmark, and the sampled means are averaged with equal benchmark weights. The stored 200 draws give the 2.5th and 97.5th percentiles. Bootstrap randomness uses seed 1729. The four comparator intervals share this procedure, but are not presented as simultaneous confidence intervals. Repeating the same stored uncertainty object in seed records adds no information.\n% @evidence[[source_evidence/evaluator/evaluate_final.py#L1065]]\n% @evidence[[analysis/paper_statistics.json#/uncertainty]]\n\n\\begin{table}[ht]\n\\centering\n\\caption{Descriptive seed variation for the package, with equal benchmark and budget weights. Error units are percentage points. These seeds do not change the frozen data partitions.}\n\\label{tab:seeds}\n% @evidence[[analysis/paper_statistics.json#/aggregate]]\n\\begin{tabular}{lrrrrr}\n\\toprule\nEstimator & Answers & MAE (pp) & RMSE (pp) & Spearman & Kendall\\\\\n\\midrule\nScore-targeted package & $k$ & 3.90 & 4.84 & 0.816 & 0.672 \\\\\nLocal IRT & $k$ & 5.91 & 7.30 & 0.603 & 0.491 \\\\\nUniform & $k$ & 10.52 & 12.89 & 0.604 & 0.494 \\\\\nSource prior & 0 & 8.34 & 10.08 & -- & -- \\\\\nLocal anchors & $k$ & 15.67 & 18.36 & 0.437 & 0.346 \\\\\n\\bottomrule\n\\end{tabular}\n                baseline.close(failed=primary is not None)\n            except Exception:\n                if primary is None:\n                    raise\n\n\ndef aggregate_results(episodes, outcomes, complete):\n    normal = [value for episode, value in zip(episodes, outcomes) if episode['condition'] == 'normal' and not episode['replay']]\n    result = {name: sum(value[name] for value in normal)/len(normal)\n              for name in ('mae', 'rmse', 'spearman', 'kendall', 'uniform_mae', 'prior_mae', 'anchor_mae', 'irt_mae')}\n    controls = all(value['control'] and value['completed'] for value in outcomes)\n    first, replay = outcomes[0]['solution'], outcomes[-1]['solution']\n    replay_matches = first is not None and replay is not None and len(first) == len(replay)\n    if replay_matches:\n        replay_matches = all(reference['items'] == repeated['items']\n            and len(reference['predictions']) == len(repeated['predictions'])\n            and all(abs(float(left)-float(right)) <= 1e-10\n                    for left, right in zip(reference['predictions'], repeated['predictions']))\n            for reference, repeated in zip(first, replay))\n    controls &= replay_matches\n    for condition in ('constant', 'permuted'):\n        values = [value['mae'] if value['completed'] and value['control'] else 1.\n                  for episode, value in zip(episodes, outcomes) if episode['condition'] == condition]\n        result[condition+'_mae'] = sum(values)/len(values)\n    result['control_correct'] = float(controls)\n    result['correct'] = float(complete and controls)\n    if PLANE == 'search':\n        result['combined_score'] = 1-result['mae']\n    return result\n\n\ndef paired_uncertainty(episodes, outcomes, loaded, cases):\n    import numpy as np\n    rng = np.random.default_rng(1729)\n    names = ['uniform_mae', 'prior_mae', 'anchor_mae', 'irt_mae']\n    distributions = {name: [] for name in names}\n    points = {name: [] for name in names}\n    failed = 0\n    for case in cases:\n        groups = loaded[case]['target_groups']\n        unique = np.unique(groups)\n        cells = [value for episode, value in zip(episodes, outcomes)\n                 if episode['case'] == case and episode['condition'] == 'normal' and not episode['replay']]\n        differences = {name: np.zeros(len(unique)) for name in names}\n        for cell in cells:\n            if not cell['completed']:\n                failed += 1\n                continue\n            for checkpoint in cell['solution']:\n                truth = np.array(checkpoint['references'])\n                candidate_errors = np.abs(np.array(checkpoint['predictions'])-truth)\n                for name in names:\n                    baseline_errors = np.abs(np.array(checkpoint['baseline_predictions'][name])-truth)\n                    for index, group in enumerate(unique):\n                        differences[name][index] += float(np.mean((candidate_errors-baseline_errors)[groups == group])) / (len(cells)*len(cell['solution']))\n        sampled = rng.integers(0, len(unique), size=(200, len(unique)))\n        for name in names:\n            points[name].append(float(differences[name].mean()))\n            distributions[name].append(differences[name][sampled].mean(axis=1))\n    return dict(policy='paired lineage-block bootstrap; checkpoints/seeds retained within groups; equal case weights; 200 draws; fixed failure differences 1-1=0; conditional on fixed cases',\n                failed_normal_cells=failed,\n                comparisons={name: dict(candidate_minus_baseline_mae=float(np.mean(points[name])),\n                    lower_95=float(np.quantile(np.mean(distributions[name], axis=0), .025)),\n                    upper_95=float(np.quantile(np.mean(distributions[name], axis=0), .975))) for name in names})\n\n\ndef write_results(directory, metrics, feasible):\n","exit_code":0,"status":"completed"}}
