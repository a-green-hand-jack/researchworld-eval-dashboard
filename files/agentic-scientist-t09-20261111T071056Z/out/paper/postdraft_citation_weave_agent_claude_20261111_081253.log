es},\n@Inproceedings{Eichhorn2024LoworderOA,\n title = {Low-order outcomes and clustered designs: combining design and analysis for causal inference under network interference},\n@Article{Han2023ModelbasedRA,\n booktitle = {Journal of Causal Inference},\n title = {Model-based regression adjustment with model-free covariates for network interference},\n@Article{Chen2023OptimizedCD,\n booktitle = {Neural Information Processing Systems},\n title = {Optimized Covariance Design for AB Test on Social Network under Interference},\n@Inproceedings{Offer-Westort2021DesigningME,\n title = {Designing Multi-Arm Experiments for Global Average Treatment Effects Under Partial Interference},\n@Article{Shankar2024ABTU,\n booktitle = {International Conference on Artificial Intelligence and Statistics},\n title = {A/B testing under Interference with Partial Network Information},\n@misc{Ugander2013GraphCluster,\n  title = {Graph cluster randomization: network exposure to multiple universes},\n@misc{Tiwari2024Quasi,\n  title = {Quasi-randomization tests for network interference: a random graph approach},\n@misc{Cortez2024TwoStage,\n  title = {Analysis of Two-Stage Rollout Designs with Clustering for Causal Inference under Network Interference},\n@misc{Jiang2023Mixture,\n  title = {Causal Inference under Network Interference Using a Mixture of Randomized Experiments},\n@misc{Sussman2017Elements,\n  title = {Elements of estimation theory for causal effects in the presence of network interference},\n@misc{Viviano2020Experimental,\n  title = {Experimental Design under Network Interference},\n@misc{Thiyageswaran2024DataAdaptive,\n  title = {Data-adaptive exposure thresholds for the Horvitz-Thompson estimator of the Average Treatment Effect in experiments with network interference},\n@misc{Kipf2016GCN,\n  title = {Semi-Supervised Classification with Graph Convolutional Networks},\n@misc{Viviano2023CausalClustering,\n  title = {Causal clustering: design of cluster experiments under network interference},\n@misc{Bhattacharya2019Uncertainty,\n  title = {Causal Inference Under Interference And Network Uncertainty},\n@misc{Ting2023Limits,\n  title = {On the Limits of Regression Adjustment},\n@misc{Chin2018Stein,\n  title = {Central limit theorems via Stein's method for randomized experiments under interference},\n@misc{Zhou2020ClusterAdaptive,\n  title = {Cluster-Adaptive Network A/B Testing: From Randomization to Estimation},\n@misc{Nandy2019Dense,\n  title = {A/B Testing in Dense Large-Scale Networks: Design and Inference},\n@misc{Li2021Noise,\n  title = {Causal Inference under Network Interference with Noise},\n@misc{Alzubaidi2023KNN,\n  title = {Estimation of Causal Effects Under K-Nearest Neighbors Interference},\n@misc{Karwa2023Admissibility,\n  title = {On the admissibility of Horvitz-Thompson estimator for estimating causal effects under network interference},\n28 28\n[\n\"regression adjustment global average treatment effect network interference\",\n\"model-based regression adjustment network interference graph covariates bootstrap confidence intervals\",\n\"exposure mapping misspecification bias network interference total treatment effect estimation\",\n\"Horvitz-Thompson Hajek estimator general interference exposure probability variance\",\n\"graph cluster randomization network exposure bias variance tradeoff\",\n\"difference-in-means bias under interference randomized experiments SUTVA violation\",\n\"augmented inverse probability weighting doubly robust residual correction interference network\",\n\"staggered rollout design total treatment effect interference without network knowledge\",\n\"extrapolation all-treated all-control counterfactual positivity violation network exposure\",\n\"Facebook100 social structure of Facebook networks\"\n]\n{\"citation_count\": 258, \"citation_key\": \"Aronow2013EstimatingAC\", \"id\": \"ref.s2.148c698ad34d340ffee56ed7b0870b5b6b095d04\", \"paper_id\": \"148c698ad34d340ffee56ed7b0870b5b6b095d04\", \"query\": \"reg