le{Newcombe1998,\n  title {{Two-sided confidence intervals for the single proportion: comparison of seven methods}},\n  year {1998},\n  doi {10.1002/(sici)1097-0258(19980430)17:8<857::aid-sim777>3.0.co;2-e},\n@article{Robinson1988,\n  title {{Root-N-Consistent Semiparametric Regression}},\n  year {1988},\n  doi {10.2307/1912705},\n@book{Sarndal1992,\n  title {{Model Assisted Survey Sampling}},\n  year {1992},\n  doi {10.1007/978-1-4612-4378-6},\n@article{Stone1974,\n  title {{Cross-Validatory Choice and Assessment of Statistical Predictions}},\n  year {1974},\n  doi {10.1111/j.2517-6161.1974.tb00994.x},\n@article{Student1908,\n  title {{The Probable Error of a Mean}},\n  year {1908},\n  doi {10.1093/biomet/6.1.1},\n@article{VanDerVaart1998,\n  title {{Asymptotic Statistics}},\n  year {1998},\n  doi {10.1017/CBO9780511802256}\n","exit_code":0,"status":"completed"}}
