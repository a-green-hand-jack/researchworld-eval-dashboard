{"type":"item.started","item":{"id":"item_101","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nfor key in ['Ghahramani1996Mixture','Gneiting2011Quantiles','Lindley1956Information','McNicholas2010Mixture','Koenker1978Quantiles']:\n p=json.load(open('literature/records/'+key+'.json'));print(key,p['data'].get('openAccessPdf'),p['data'].get('url'),p.get('read_abstract','')[:100])\nPY\npython - <<'PY'\nimport requests,concurrent.futures,pathlib,json\nfrom bs4 import BeautifulSoup\nspec=[('Ghahramani1996Mixture','https://www.cs.toronto.edu/~fritz/absps/factor.pdf'),('Lindley1956Information','https://projecteuclid.org/journalArticle/Download?urlId=10.1214%2Faoms%2F1177728069'),('McNicholas2010Mixture','https://www.sciencedirect.com/science/article/abs/pii/S0378375809004079')]\ndef one(item):\n key,url=item\n try:\n  r=requests.get(url,timeout=20);r.raise_for_status();print(key,len(r.content),r.headers.get('Content-Type'),r.text[:40] if not r.content.startswith(b'%PDF') else 'PDF',flush=True)\n  if r.content.startswith(b'%PDF'):pathlib.Path('literature/'+key+'.pdf').write_bytes(r.content)\n except Exception as e:print(key,e,flush=True)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=3) as ex:list(ex.map(one,spec))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
