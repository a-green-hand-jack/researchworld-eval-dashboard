{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nfrom pathlib import Path\nstrategy=json.loads(Path('paper_strategy.json').read_text())\npaper_data=json.loads(Path('paper_data.json').read_text())\nrequired={'status','selected_prompt_family','recommended_title','central_question','central_thesis','narrative_rationale','prior_paper_story_status','edit_framing_decision','staged_input_impact','method_groups','results_focus','figure_plan','figure_specs','supplementary_plan','forbidden_headings','forbidden_phrases','notes_for_writer','failure_reason'}\nassert required <= strategy.keys()\nassert strategy['status']=='ready' and not strategy['failure_reason']\nassert strategy['selected_prompt_family']=='paper_standalone'\nassert strategy['prior_paper_story_status'] in {'preserved','broadened','recentered','rejected'}\nassert strategy['supplementary_plan']['purpose']\nassert strategy['supplementary_plan']['planned_subsections']\nsources=set(paper_data['grounding_sources'])\nfor entry in strategy['supplementary_plan']['planned_subsections']:\n    assert entry['heading'] and entry['grounded_content'] and entry['source_ids']\n    assert set(entry['source_ids']) <= sources\nfor figure in strategy['figure_specs']:\n    assert figure['required'] and figure['layout_rationale']\n    assert figure['max_panels']<=4 and figure['max_panels_per_row']<=3\n    assert figure['max_categories_per_panel']<=6 and figure['max_series_per_panel']<=4\n    assert 0<figure['target_width_fraction']<=1\n    assert not figure['allow_progression']\n    assert set(figure['source_ids']) <= sources\nassert sum(figure['preferred_generator']=='generate-concept-figure' for figure in strategy['figure_specs'])==1\nmemo=Path('paper_strategy.md').read_text()\nfor figure in strategy['figure_specs']:\n    assert figure['figure_id'] in memo\nfor section in strategy['supplementary_plan']['planned_subsections']:\n    assert section['heading']