esolved_path\": \"tables/synthetic_regimes.tex\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/synthetic_regimes.tex.prov.json\",\n      \"target\": \"tables/synthetic_regimes.tex\"\n    },\n    {\n      \"locator\": \"/final_evaluation/evaluation_evidence/episodes\",\n      \"messages\": [\n        \"Target path exists, but locator semantics were not interpreted by the base verifier.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\",\n      \"resolved_path\": \"paper_data.json\",\n      \"status\": \"anchored\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/synthetic_regimes.tex.prov.json\",\n      \"target\": \"paper_data.json\"\n    },\n    {\n      \"locator\": \"L746\",\n      \"messages\": [\n        \"Target path exists, but locator semantics were not interpreted by the base verifier.\"\n      ],\n      \"raw_reference\": \"@evidence[[source_evidence/evaluate_final.py#L746]]\",\n      \"resolved_path\": \"source_evidence/evaluate_final.py\",\n      \"status\": \"anchored\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/synthetic_regimes.tex.prov.json\",\n      \"target\": \"source_evidence/evaluate_final.py\"\n    },\n    {\n      \"messages\": [\n        \"generated_by.script_path exists.\"\n      ],\n      \"raw_reference\": \"<generated_by.script_path>\",\n      \"resolved_path\": \"build_artifacts.py\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/synthetic_regimes.tex.prov.json\",\n      \"target\": \"build_artifacts.py\"\n    }\n  ],\n  \"root_dir\": \"work/results/a06/codex/20261105_100448/.paper_evidence_audit_workspaces-1000/agentic-evidence-audit-1000-20261106_050334-paper_evidence_audit_round_4-boqspjdq/workspace\",\n  \"schema_name\": \"scientific-evidence.verification-report\",\n  \"summary\": {\n    \"anch