\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Inverted participant pairs (\%) on final partitions. Removed-row counts are floored at the nominal 0.1\%, 0.5\%, and 1\% budgets. Exact-refit and high-loss values are deterministic in the recorded evaluations; random entries average the five seeds. Greater inversion means greater sensitivity, not better estimation.}}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:budgets}{{1}{6}{Inverted participant pairs (\%) on final partitions. Removed-row counts are floored at the nominal 0.1\%, 0.5\%, and 1\% budgets. Exact-refit and high-loss values are deterministic in the recorded evaluations; random entries average the five seeds. Greater inversion means greater sensitivity, not better estimation}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Budget-resolved disruption on (a) Arena and (b) NBA, with a shared vertical scale. Solid markers show deterministic values or random-mask means; faint random markers show the five seeds, not uncertainty bounds. Removed-row counts are Arena: 38/190/381; NBA: 41/207/414. Input-order controls are not plotted as additional replicates.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:budgets}{{2}{6}{Budget-resolved disruption on (a) Arena and (b) NBA, with a shared vertical scale. Solid markers show deterministic values or random-mask means; faint random markers show the five seeds, not uncertainty bounds. Removed-row counts are Arena: 38/190/381; NBA: 41/207/414. Input-order controls are not plotted as additional replicates}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Conditional differences in mean inversion disruption, exact-refit minus (a) high-loss or (b) random deletion. Each dataset contributes its 32 unique group-weight draws; horizontal jitter only separates points. Dataset colors have the same meaning in both panels. The zero line denotes equal disruption. Masks remain fixed, weighted removed mass varies, and no selection is repeated. These are not full-procedure confidence intervals.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:conditional}{{3}{7}{Conditional differences in mean inversion disruption, exact-refit minus (a) high-loss or (b) random deletion. Each dataset contributes its 32 unique group-weight draws; horizontal jitter only separates points. Dataset colors have the same meaning in both panels. The zero line denotes equal disruption. Masks remain fixed, weighted removed mass varies, and no selection is repeated. These are not full-procedure confidence intervals}{figure.caption.7}{}}
