\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A common audit for contrasting pairwise-data settings. A regularized fit supplies clean influence orders; bounded contender selection uses retained-data refits without changing those orders. Independent refits measure disruption. The uncertainty branch reweights provenance groups with deletion masks fixed: it does not repeat contender selection.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{A common audit for contrasting pairwise-data settings. A regularized fit supplies clean influence orders; bounded contender selection uses retained-data refits without changing those orders. Independent refits measure disruption. The uncertainty branch reweights provenance groups with deletion masks fixed: it does not repeat contender selection}{figure.caption.1}{}}
