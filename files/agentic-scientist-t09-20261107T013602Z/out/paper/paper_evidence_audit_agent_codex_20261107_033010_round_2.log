ariate widths:',sorted(set(data[record['key']+'_x'].shape[1] for record in manifest['records'])))\nprint('Downstream study present:', 'downstream_study' in paper)\nprint('Final metrics agree with manifest:',paper['final_evaluation']['metrics']==json.loads(Path('source_evidence/final_manifest.json').read_text())['metrics'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
