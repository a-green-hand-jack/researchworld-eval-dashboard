\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the few-item prediction protocol and the evaluated configuration. A binary source matrix is used to fit a latent model, choose $k{=}100$ items, and fit stacking weights on source pseudo-targets; a new model answers only the selected items, and a stacked estimator predicts its full-benchmark accuracy. Targets are either random held-out models or models stronger than every source.}}{2}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{Overview of the few-item prediction protocol and the evaluated configuration. A binary source matrix is used to fit a latent model, choose $k{=}100$ items, and fit stacking weights on source pseudo-targets; a new model answers only the selected items, and a stacked estimator predicts its full-benchmark accuracy. Targets are either random held-out models or models stronger than every source}{figure.caption.4}{}}
