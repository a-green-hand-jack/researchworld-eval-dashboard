{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re,statistics,math\np=json.load(open('paper_data.json')); eps=p['final_evaluation']['evaluation_evidence']['episodes']; a=json.load(open('analysis/summary.json')); cs=json.load(open('claims_grounding.json'))['claims'];tex=open('paper.tex').read()\nerr=[]\nassert len(eps)==8\nassert [x['seed'] for x in eps]==a['seeds']\nu=eps[0]['solution']['seed_block_uncertainty'];assert all(x['solution']['seed_block_uncertainty']==u for x in eps);assert u==a['retained_uncertainty']\nfor m,v in a['methods'].items():\n rec=[(case['case'],r) for ep in eps for case in ep['solution']['cases'] for r in case['methods'][m]]\n for key,field,filt in [('utility','utility',lambda x:True),('mass','volume',lambda x:True),('iid_error','coverage_error',lambda x:'SHIFT' not in x),('shift_error','coverage_error',lambda x:'SHIFT' in x)]:\n  mean=statistics.mean(r[field] for name,r in rec if filt(name))\n  if abs(mean-v[key])>1e-12:err.append((m,key,mean,v[key]))\nfor ep in eps:\n assert ep['correct']\n for case in ep['solution']['cases']:\n  assert case['complete']; assert all(case['control_checks'].values())\n  for m,rs in case['methods'].items():\n   for r in rs:\n    assert abs(r['coverage_error']-abs(r['coverage']-(1-r['alpha'])))<1e-12\n    assert abs(r['utility']-(1-r['volume'])*max(0,1-r['coverage_error']/(1-r['alpha'])))<1e-12\nlabel={'LN K3':'LN_IID_K3','LN K8':'LN_IID_K8','Dir K3':'DIR_IID_K3','Dir K8':'DIR_IID_K8','Shift K3':'DIR_SHIFT_K3','Shift K8':'DIR_SHIFT_K8'}\nchecked=0\nfor name,base in [('Unscaled ILR','unscaled_ilr'),('Simplex max','simplex_linf'),('Bonferroni','bonferroni')]:\n block=tex.split('\\\\\\\\caption{Scaled ILR minus '+name+'.')[1].split('\\\\\\\\end{tabular}')[0]\n for row in block.splitlines():\n  if not any(row.startswith(k+' &') for k in label):continue\n  vals=[v.strip().rstrip(' \\\\\\\\') for v in row.split('&')];case=label[vals[0]];alpha=float(vals[1]);r=next(z for z in u[case]['paired_baselines'][base] if z['alpha']==alpha)\n  expected=[r['utility_difference'],*r['paired_seed_bootstrap95'],*r['bonferroni54_bootstrap_interval'],r['volume_difference'],*r['paired_volume_bootstrap95']]\n  actual=[float(x) for x in re.findall(r'[+-]?\\\\d+\\\\.\\\\d+', ' '.join(vals[2:]))]\n  if len(actual)\"'!=len(expected) or any(abs(v-w)>.0005000001 for v,w in zip(actual,expected)):err.append((name,case,alpha,actual,expected))\n  checked+=1\nprint('\"'All qualification:',{k:p['grounding_sources']['final.qualification.'+k]['value'] for k in ['status','outcome','correct']})\nprint('Checked comparison rows:',checked,'; all eight seed blocks and controls complete; retained uncertainty deduplicates exactly.')\nprint('Numeric mismatches:',err)\nfor i in range(64,77): print(i,cs[i]['claim'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re,statistics,math\np=json.load(open('paper_data.json')); eps=p['final_evaluation']['evaluation_evidence']['episodes']; a=json.load(open('analysis/summary.json')); cs=json.load(open('claims_grounding.json'))['claims'];tex=open('paper.tex').read()\nerr=[]\nassert len(eps)==8\nassert [x['seed'] for x in eps]==a['seeds']\nu=eps[0]['solution']['seed_block_uncertainty'];assert all(x['solution']['seed_block_uncertainty']==u for x in eps);assert u==a['retained_uncertainty']\nfor m,v in a['methods'].items():\n rec=[(case['case'],r) for ep in eps for case in ep['solution']['cases'] for r in case['methods'][m]]\n for key,field,filt in [('utility','utility',lambda x:True),('mass','volume',lambda x:True),('iid_error','coverage_error',lambda x:'SHIFT' not in x),('shift_error','coverage_error',lambda x:'SHIFT' in x)]:\n  mean=statistics.mean(r[field] for name,r in rec if filt(name))\n  if abs(mean-v[key])>1e-12:err.append((m,key,mean,v[key]))\nfor ep in eps:\n assert ep['correct']\n for case in ep['solution']['cases']:\n  assert case['complete']; assert all(case['control_checks'].values())\n  for m,rs in case['methods'].items():\n   for r in rs:\n    assert abs(r['coverage_error']-abs(r['coverage']-(1-r['alpha'])))<1e-12\n    assert abs(r['utility']-(1-r['volume'])*max(0,1-r['coverage_error']/(1-r['alpha'])))<1e-12\nlabel={'LN K3':'LN_IID_K3','LN K8':'LN_IID_K8','Dir K3':'DIR_IID_K3','Dir K8':'DIR_IID_K8','Shift K3':'DIR_SHIFT_K3','Shift K8':'DIR_SHIFT_K8'}\nchecked=0\nfor name,base in [('Unscaled ILR','unscaled_ilr'),('Simplex max','simplex_linf'),('Bonferroni','bonferroni')]:\n block=tex.split('\\\\\\\\caption{Scaled ILR minus '+name+'.')[1].split('\\\\\\\\end{tabular}')[0]\n for row in block.splitlines():\n  if not any(row.startswith(k+' &') for k in label):continue\n  vals=[v.strip().rstrip(' \\\\\\\\') for v in row.split('&')];case=label[vals[0]];alpha=float(vals[1]);r=next(z for z in u[case]['paired_baselines'][base] if z['alpha']==alpha)\n  expected=[r['utility_difference'],*r['paired_seed_bootstrap95'],*r['bonferroni54_bootstrap_interval'],r['volume_difference'],*r['paired_volume_bootstrap95']]\n  actual=[float(x) for x in re.findall(r'[+-]?\\\\d+\\\\.\\\\d+', ' '.join(vals[2:]))]\n  if len(actual)\"'!=len(expected) or any(abs(v-w)>.0005000001 for v,w in zip(actual,expected)):err.append((name,case,alpha,actual,expected))\n  checked+=1\nprint('\"'All qualification:',{k:p['grounding_sources']['final.qualification.'+k]['value'] for k in ['status','outcome','correct']})\nprint('Checked comparison rows:',checked,'; all eight seed blocks and controls complete; retained uncertainty deduplicates exactly.')\nprint('Numeric mismatches:',err)\nfor i in range(64,77): print(i,cs[i]['claim'])\nPY\"","aggregated_output":"All qualification: {'status': 'completed', 'outcome': 'qualified', 'correct': True}\nChecked comparison rows: 54 ; all eight seed blocks and controls complete; retained uncertainty deduplicates exactly.\nNumeric mismatches: []\n64 Descriptive sign-of-x0 group mean coverage at alpha .10, DIR_SHIFT_K3_group0: {\"mean\": 0.7994892539136438, \"ci95\": [0.7772400664722139, 0.8237544482315644]}\n65 Descriptive sign-of-x0 group mean coverage at alpha .10, LN_IID_K3_group1: {\"mean\": 0.8994998710984843, \"ci95\": [0.8922465752293173, 0.9063820451542381]}\n66 Descriptive sign-of-x0 group mean coverage at alpha .10, DIR_IID_K3_group1: {\"mean\": 0.8999867034363749, \"ci95\": [0.8718466102028681, 0.9212794717051725]}\n67 Descriptive sign-of-x0 group mean coverage at alpha .10, DIR_SHIFT_K3_group1: {\"mean\": 0.7344504458578511, \"ci95\": [0.6986750252972476, 0.7758026972031671]}\n68 Descriptive sign-of-x0 group mean coverage at alpha .10, LN_IID_K8_group0: {\"mean\": 0.9036951628880008, \"ci95\": [0.8910264864772866, 0.9172771912646333]}\n69 Descriptive sign-of-x0 group mean coverage at alpha .10, DIR_IID_K8_group0: {\"mean\": 0.8735546137893258, \"ci95\": [0.864758382448503, 0.8832737131527921]}\n70 Descriptive sign-of-x0 group mean coverage at alpha .10, DIR_SHIFT_K8_group0: {\"mean\": 0.7641630997531321, \"ci95\": [0.7321113901240717, 0.7979671751097654]}\n71 Descriptive sign-of-x0 group mean coverage at alpha .10, LN_IID_K8_group1: {\"mean\": 0.8937751892359389, \"ci95\": [0.8830528087004836, 0.9053082871026966]}\n72 Descriptive sign-of-x0 group mean coverage at alpha .10, DIR_IID_K8_group1: {\"mean\": 0.9167340896793246, \"ci95\": [0.902334472198813, 0.9315265755154079]}\n73 Descriptive sign-of-x0 group mean coverage at alpha .10, DIR_SHIFT_K8_group1: {\"mean\": 0.6528223408658897, \"ci95\": [0.6119784930024768, 0.694219771768854]}\n74 Additional coverage, overall utility and group intervals resample all seed blocks jointly 20000 times at bootstrap seed 20261117, retaining condition and level dependence.\n75 Favorable simplex-baseline contrasts concentrate in IID Dirichlet K8; all shifted utility differences are negative and all shifted mass differences positive. This is not uniform dominance.\n76 Joint unscaled maximum-residual and coordinatewise Bonferroni rectangles are described by Fan and Sesia, Algorithms S2 and S1 respectively; simplex intersection is imposed by this evaluation, not attributed to that source.\n","exit_code":0,"status":"completed"}}
