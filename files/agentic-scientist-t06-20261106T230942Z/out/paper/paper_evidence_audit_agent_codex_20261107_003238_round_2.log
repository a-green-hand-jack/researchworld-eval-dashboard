{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"jq '.method.description|fromjson|{objective, estimator, selection, bootstrap, uncertainty, data, metrics}' source_evidence/task_contract.json; jq '.claims[45:60]' claims_grounding.json\"","aggregated_output":"{\n  \"objective\": null,\n  \"estimator\": null,\n  \"selection\": null,\n  \"bootstrap\": null,\n  \"uncertainty\": \"Arena raw-document connected components and NBA unique games are grouped bootstrap units within each fixed panel, 10 search and30 final replicates per case/seed (1 smoke). Bootstrap original and fixed candidate/baseline nested interventions paired under identical group multiplicity weights; all random streams participate. Report 2.5/97.5 percentile rank intervals and paired candidate-minus-baseline effects. Failed required refits/resamples preserve entire episode worst-case evidence rather than intervals over survivors. Three seeds are algorithmic variation, not independent datasets. Sports conclusions are descriptive of fixed seasons, not causal effects of design.\",\n  \"data\": null,\n  \"metrics\": null\n}\n[\n  {\n    \"claim\": \"Final margin_heuristic_score: 0.007573891625615763; rounded manuscript values are summaries of this final scalar, not search results.\",\n    \"source_ids\": [\n      \"final.metric.margin_heuristic_score\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/final_evaluation/metrics/margin_heuristic_score\"\n    ]\n  },\n  {\n    \"claim\": \"Final mean_rank_displacement: 0.04409140667761357; rounded manuscript values are summaries of this final scalar, not search results.\",\n    \"source_ids\": [\n      \"final.metric.mean_rank_displacement\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/final_evaluation/metrics/mean_rank_displacement\"\n    ]\n  },\n  {\n    \"claim\": \"Final influence_error: 0.14315313656317594; rounded manuscript values are summaries of this final scalar, not search results.\",\n    \"source_ids\": [\n      \"final.metric.influence_error\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/final_evaluation/metrics/influence_error\"\n    ]\n  },\n  {\n    \"claim\": \"The final evaluation completed, qualified, and passed the recorded operational/scientific checks. Qualification is not a superiority or publication decision.\",\n    \"source_ids\": [\n      \"final.qualification.status\",\n      \"final.qualification.outcome\",\n      \"final.qualification.correct\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/grounding_sources/final.qualification.status\",\n      \"paper_data.json#/grounding_sources/final.qualification.outcome\",\n      \"paper_data.json#/grounding_sources/final.qualification.correct\"\n    ],\n    \"implementation_evidence\": [\n      \"source_evidence/task_contract.json:method.final_correct\"\n    ],\n    \"support_scope\": \"Registered final evidence identifies the evaluated condition; readable documentation, not hashes or metric values, supports implementation specifics.\"\n  },\n  {\n    \"claim\": \"Guided original-sample curves coincide across all three seeds on every panel; seed means are descriptive, not independent data replications.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n    ]\n  },\n  {\n    \"claim\": \"Guided budget-averaged disruption exceeds each comparator on every panel. At the smallest NBA 2014 budget, guidance ties the small-margin control; the other plotted seed-averaged cells favor guidance. This does not imply universally positive paired uncertainty.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n    ]\n  },\n  {\n    \"claim\": \"All Arena paired intervals are strictly positive; all degree-stratified NBA intervals include zero. NBA 2012 small-margin comparisons are positive for all seeds; NBA 2011 small-margin and NBA 2012 uniform each have one wholly positive interval. NBA 2013–2015 intervals all include zero.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n    ]\n  },\n  {\n    \"claim\": \"Arena finite-shift discrepancy spans 0.2235–0.3350; NBA spans about 0.00036–0.02274. This is a normalized coefficient-shift diagnostic, not rank error, superiority, or an accuracy threshold.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\",\n      \"final.metric.influence_error\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n    ],\n    \"implementation_evidence\": [\n      \"source_evidence/task_contract.json:method.audits\"\n    ],\n    \"support_scope\": \"Registered final evidence identifies the evaluated condition; readable documentation, not hashes or metric values, supports implementation specifics.\"\n  },\n  {\n    \"claim\": \"Recorded CPU evaluation durations span approximately 29.6–30.5 seconds per seed evaluation, not method-only timings or speedup measurements.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"evidence_refs\": [\n      \"paper_data.json#/final_evaluation/evaluation_evidence/episodes/0/duration_seconds\",\n      \"paper_data.json#/final_evaluation/evaluation_evidence/episodes/1/duration_seconds\",\n      \"paper_data.json#/final_evaluation/evaluation_evidence/episodes/2/duration_seconds\"\n    ]\n  },\n  {\n    \"claim\": \"The fixed estimator uses sum logistic loss with unit quadratic ridge, centered participant scores, fractional uneditable ties, and a regularized optional NBA home effect. Nominal fractions .001, .005, .01 use all rows and floor-rounded nested binary flips.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"implementation_evidence\": [\n      \"source_evidence/flip_search.py:22-44\",\n      \"source_evidence/flip_search.py:61-172\",\n      \"source_evidence/task_contract.json:method.scientific_workload\"\n    ],\n    \"support_scope\": \"Registered final evidence identifies the evaluated condition; readable documentation, not hashes or metric values, supports implementation specifics.\"\n  },\n  {\n    \"claim\": \"Influence screening uses genuine Hessian derivatives, a frozen top-min(10,p) adjacent contrast, width-two exact-refitted path selection, and up to six nearby contrast proposals. The lexicographic internal objective leads with summed displacement, not the reported inversion fraction.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"implementation_evidence\": [\n      \"source_evidence/flip_search.py:194-266\",\n      \"source_evidence/flip_search.py:510-549\"\n    ],\n    \"support_scope\": \"Registered final evidence identifies the evaluated condition; readable documentation, not hashes or metric values, supports implementation specifics.\"\n  },\n  {\n    \"claim\": \"The available source implements strict complete-path swaps/replacements with sorted original-row prefix caching and incumbent fallback. It uses up to 24 sampled positions, additional refit caps 72 or 24 by dimension, a two-second optional deadline, and 128 proposals; no execution trace establishes accepted exchange counts or isolated exchange benefit.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"implementation_evidence\": [\n      \"source_evidence/flip_search.py:309-475\"\n    ],\n    \"support_scope\": \"Registered final evidence identifies the evaluated condition; readable documentation, not hashes or metric values, supports implementation specifics.\"\n  },\n  {\n    \"claim\": \"The available solver uses damped Newton/Cholesky with at most 50 Newton steps, L-BFGS fallback and final stationarity rejection at gradient infinity norm above 1e-6; these are code settings, not measured operation counts.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"implementation_evidence\": [\n      \"source_evidence/flip_search.py:119-172\"\n    ],\n    \"support_scope\": \"Registered final evidence identifies the evaluated condition; readable documentation, not hashes or metric values, supports implementation specifics.\"\n  },\n  {\n    \"claim\": \"Uniform, approximate degree-quartile-stratified and small-margin controls share integer budgets. The three-budget average, equal seeds, half Arena/half equal-season NBA weighting and thirty-resample fixed-plan grouped bootstrap define the reporting protocol.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"implementation_evidence\": [\n      \"source_evidence/task_contract.json:method.baselines\",\n      \"source_evidence/task_contract.json:method.aggregation\",\n      \"source_evidence/task_contract.json:method.uncertainty\"\n    ],\n    \"support_scope\": \"Registered final evidence identifies the evaluated condition; readable documentation, not hashes or metric values, supports implementation specifics.\"\n  },\n  {\n    \"claim\": \"Public preparation preserves pinned Arena/NBA snapshots, reciprocal-game checks, content-connected groups, lexicographic participant identities, and home rather than Elo inputs. Source hashes identify files but are not substantive source-code evidence.\",\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"citation_keys\": [],\n    \"implementation_evidence\": [\n      \"source_evidence/prepare_data.py:12-147\",\n      \"source_evidence/panel_manifest.json\",\n      \"source_evidence/source_manifest.json\"\n    ],\n    \"support_scope\": \"Registered final evidence identifies the evaluated condition; readable documentation, not hashes or metric values, supports implementation specifics.\"\n  }\n]\n","exit_code":0,"status":"completed"}}
