{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"PYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport json, math, re\nfrom collections import defaultdict\nimport numpy as np\nfrom scipy.stats import spearmanr, kendalltau\nwith open('paper_data.json') as stream:\n    paper=json.load(stream)\nwith open('analysis/paper_statistics.json') as stream:\n    stats=json.load(stream)\nrows=[]\nfor outer in paper['final_evaluation']['evaluation_evidence']['episodes']:\n    assert outer['solution']['paired_mae_uncertainty']==stats['uncertainty']\n    for episode in outer['solution']['episodes']:\n        if episode['condition']\"'!='\"'normal' or episode.get('replay',False):\n            continue\n        for checkpoint in episode['checkpoints']:\n            truth=np.array(checkpoint['references'])\n            groups=np.array(checkpoint['lineage_groups'])\n            unique,inverse,counts=np.unique(groups,return_inverse=True,return_counts=True)\n            weights=1/(len(unique)*counts[inverse])\n            for method in stats['aggregate']:\n                predictions=np.array(checkpoint['predictions'] if method=='selected' else checkpoint['baseline_predictions'][method])\n                error=predictions-truth\n                group_predictions=[predictions[groups==group].mean() for group in unique]\n                group_truth=[truth[groups==group].mean() for group in unique]\n                ranking=(-1.,-1.) if len(set(group_predictions))<2 or len(set(group_truth))<2 else (spearmanr(group_predictions,group_truth).statistic,kendalltau(group_predictions,group_truth).statistic)\n                rows.append({'case':episode['case'],'budget':str(checkpoint['budget']),'seed':str(outer['seed']),'method':method,'mae':float(weights@abs(error)),'rmse':float(np.sqrt(weights@(error**2))),'spearman':ranking[0],'kendall':ranking[1]})\nchecked=0\nfor kind in ('aggregate','by_budget','by_seed','by_case_budget'):\n    if kind=='aggregate':\n        groups_to_check=[({},stats[kind])]\n    elif kind=='by_case_budget':\n        groups_to_check=[({'case':case,'budget':budget},values) for case,budgets in stats[kind].items() for budget,values in budgets.items()]\n    else:\n        field='budget' if kind=='by_budget' else 'seed'\n        groups_to_check=[({field:key},values) for key,values in stats[kind].items()]\n    for filters,methods in groups_to_check:\n        for method,metrics in methods.items():\n            retained=[row for row in rows if row['method']==method and all(row[key]==value for key,value in filters.items())]\n            for metric,value in metrics.items():\n                assert math.isclose(np.mean([row[metric] for row in retained]),value,rel_tol=0,abs_tol=1e-12),(kind,filters,method,metric)\n                checked+=1\nwith open('paper.tex') as stream:\n    tex=stream.read()\nfor name in ('case_budget','seeds'):\n    with open('tables/'+name+'.tex') as stream:\n        expected=stream.read().strip()\n    block=tex.split('% BEGIN GENERATED '+name)[1].split('% END GENERATED '+name)[0].strip()\n    assert block==expected,name\nprint('Verified',len(rows)//5,'normal cells and',checked,'reported summary metrics against retained prediction arrays; both embedded supplementary tables match generated sources.')\nprint('Final qualification:',{key:paper['grounding_sources']['final.qualification.'+key]['value'] for key in ('status','outcome')})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
