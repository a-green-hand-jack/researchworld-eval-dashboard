rce\": \"mteb\",\n              \"split\": \"family\"\n            },\n            {\n              \"baselines\": {\n                \"constant\": 0.907467479309774,\n                \"copy\": 0.915637701714975,\n                \"medoid_ridge\": 0.9336172486345626,\n                \"random_lowrank\": 0.9375734306890144,\n                \"selected_ridge\": 0.9540299448696474\n              },\n              \"completed\": true,\n              \"control\": false,\n              \"curve\": [\n                0.9353115848208151,\n                0.9651631505503377,\n                0.9785120748692102\n              ],\n              \"replay\": false,\n              \"score\": 0.9596622700801211,\n              \"source\": \"open_llm\",\n              \"split\": \"model\"\n            },\n            {\n              \"baselines\": {\n                \"constant\": 0.907467479309774,\n                \"copy\": 0.915637701714975,\n                \"medoid_ridge\": 0.9191061977947402,\n                \"random_lowrank\": 0.9070240000910486,\n                \"selected_ridge\": 0.9348575630026608\n              },\n              \"completed\": true,\n              \"control\": true,\n              \"curve\": [\n                0.9238719104542373,\n                0.9344946367616501,\n                0.9469991721966472\n              ],\n              \"replay\": false,\n              \"score\": 0.9351219064708449,\n              \"source\": \"open_llm\",\n              \"split\": \"model\"\n            },\n            {\n              \"baselines\": {\n                \"constant\": 0.9026863827212452,\n                \"copy\": 0.9110516346067556,\n                \"medoid_ridge\": 0.9333900382911073,\n                \"random_lowrank\": 0.935847953923648,\n                \"selected_ridge\": 0.9533160599665489\n              },\n              \"completed\": true,\n              \"control\": false,\n              \"curve\": [\n                0.9404844426959704,\n                0.953008136758043,\n                0.9658199380677858\n              ],\n              \"replay\": false,\n              \"score\": 0.9531041725072664,\n              \"source\": \"open_llm\",\n              \"split\": \"family\"\n            },\n            {\n              \"baselines\": {\n                \"constant\": 0.9026863827212452,\n                \"copy\": 0.9110516346067554,\n                \"medoid_ridge\": 0.8950022471789486,\n                \"random_lowrank\": 0.9034217593860938,\n                \"selected_ridge\": 0.9307968305781353\n              },\n              \"completed\": true,\n              \"control\": true,\n              \"curve\": [\n                0.9186929379101055,\n                0.9287358250649469,\n                0.9446621938911118\n              ],\n              \"replay\": false,\n              \"score\": 0.9306969856220547,\n              \"source\": \"open_llm\",\n              \"split\": \"family\"\n            }\n          ]\n        }\n      }\n    ],\n    \"path\": \"work/results/r03/codex/20261107_045228/final_evaluation/results/evaluation_evidence.json\",\n    \"sha256\": \"sha256:84d387ce650a305d217330e6e144534e97b30b1b1b48cee88ddcc2d005771568\",\n    \"status\": \"available\"\n  }\n}\nschema_version = 1\ncode_root = \"src\"\n\n[entrypoint]\npath = \"program.py\"\nlanguage = \"python\"\ntype = \"script\"\n\n[copy]\nexclude = [\n  \"**/__pycache__/**\",\n  \"**/*.pyc\",\n  \".venv/**\",\n  \"node_modules/**\",\n  \".git/**\",\n  \".mypy_cache/**\",\n  \".pytest_cache/**\",\n  \".ruff_cache/**\",\n  \".tox/**\",\n  \".nox/**\",\n  \"dist/**\",\n  \"build/**\",\n]\ninclude = [\n]\n\n[integration]\nkind = \"generic\"\nnotes = \"\"\n\"\"\"Deterministic CPU masked-factor starter; single-file finite-JSON handle API.\n\nAll requests and responses are objects. No additional response keys are allowed.\nEvery independent episode begins with reset; reset erases uploads, fits, contexts,\nand RNG. Seeds are arbitrary nonnegative integers, never workload selectors.\n\nreset: {op:'reset', seed:int} -> {ok:true}.\ntrain_start: {op:'train_start', rows:int<=8192, columns:int<=1024,\n column_names:list[str] of length columns, training_steps:int in [1,100],\n max_queries:int<=8} -> {ok:true}. Allocates candidate-owned RAM only.\ntrain_chunk: {op:'train_chunk', offset:int, shape:[r,columns], dtype:'<f8',\n encoding:'base64', data:str, mask_dtype:'|u1', mask:str} -> {ok:true}.\nChunks are sequential, r<=256, at most 32 chunks. data contains row-major\nlittle-endian float64 normalized scores in [0,1]; mask is row-major uint8 0/1.\nUnobserved cells contain zero, not NaN. Decode both; masked cells are unknown.\ntrain_commit: {op:'train_commit'} -> {ok:true}; requires all rows uploaded.\nfit: {op:'fit'} -> {ok:true}; learn only from the committed historical matrix.\nstart: {op:'start', availability:list[list[bool]], max_queries:int} -> {ok:true}.\nCreates/replaces a batch of 1..128 independent new-model contexts; each mask has\ncolumns entries. A true entry may be purchased once; no scores are provided.\nselect: {op:'select'} -> {indices:list[int]}, exactly one unqueried available\ncolumn per active row. Rows have enough available columns for max_queries+1.\nobserve: {op:'observe', indices:list[int], values:list[float]} -> {ok:true}.\nExactly the last selections and their purchased normalized scores are supplied.\nOnly completed observations can affect subsequent decisions. Never pool contexts.\npredict: {op:'predict'} -> {predictions:list[list[float]]}, shape [batch,columns],\nall entries finite numeric (not bool); evaluator clips to [0,1] and scores only\navailable unpurchased entries. No diagnostics, state flags, or artifact paths.\n\nCalls follow reset, train_start, chunks, train_commit, fit, then repeated start /\n(select,observe,[predict])* trajectories. Prediction checkpoints and workload are\noperation-driven, not seed-driven. Fit allowance is advisory sweeps, not telemetry.\nThe starter fits a regularized masked latent model, selects rank using held-out\nhistorical cells, and uses covariance-trace information selection with conditional\nridge reconstruction. It is a reproducible starting point, not a claimed win.\nNo filesystem or network transport is part of this interface. Full messages,\nincluding JSON framing, must be strictly below 64 MiB. Dependencies are preinstalled.\n\"\"\"\nimport base64\nimport numpy as np\n\n_STATE = {}\n\n\ndef factor_fit(values, mask, rank, steps, seed):\n    mean = np.sum(values * mask, axis=0) / np.maximum(mask.sum(axis=0), 1)\n    centered = values - mean\n    filled = np.where(mask, centered, 0.0)\n    _, singular, right = np.linalg.svd(filled, full_matrices=False)\n    factors = right[:rank].T * np.sqrt(np.maximum(singular[:rank], 1e-8))\n    latent = np.zeros((len(values), rank))\n    regularizer = np.eye(rank) * 0.1\n    for sweep in range(steps):\n        for row in range(len(values)):\n            selected = factors[mask[row]]\n            latent[row] = np.linalg.solve(selected.T @ selected + regularizer,\n                                          selected.T @ centered[row, mask[row]])\n        for column in range(values.shape[1]):\n            selected = latent[mask[:, column]]\n            factors[column] = np.linalg.solve(selected.T @ selected + regularizer,\n                                              selected.T @ centered[mask[:, column], column])\n    return mean, factors\n\n\ndef learn(values, mask, steps, seed):\n    random = np.random.default_rng(seed)\n    validation = (random.random(mask.shape) < 0.1) & mask\n    fitting = mask & ~validation\n    best = None\n    for rank in (1, 2, 4, 8):\n        if rank > min(values.shape) - 1:\n            continue\n        mean, factors = factor_fit(values, fitting, rank, min(steps, 4), seed)\n        losses = []\n        for row in range(len(values)):\n            selected = factors[fitting[row]]\n            latent = np.linalg.solve(selected.T @ selected + np.eye(rank) * 0.1,\n                                     selected.T @ (values[row, fitting[row]] - mean[fitting[row]]))\n            losses.extend(np.abs((mean + factors @ latent - values[row])[validation[row]]))\n        loss = float(np.mean(losses)) if losses else 1.0\n        if best is None or loss < best[0]:\n            best = (loss, rank)\n    return factor_fit(values, mask, best[1], min(steps, 8), seed)\n\n\ndef handle(request):\n    operation = request['op']\n    if operation == 'reset':\n        _STATE.clear()\n        _STATE['seed'] = request['seed']\n        return {'ok': True}\n    if operation == 'train_start':\n        _STATE.update(values=np.zeros((request['rows'], request['columns'])),\n                      mask=np.zeros((request['rows'], request['columns']), dtype=bool),\n                      offset=0, steps=request['training_steps'])\n    elif operation == 'train_chunk':\n        shape = tuple(request['shape'])\n        values = np.frombuffer(base64.b64decode(request['data']), dtype='<f8').reshape(shape)\n        mask = np.frombuffer(base64.b64decode(request['mask']), dtype='u1').reshape(shape).astype(bool)\n        offset = request['offset']\n        _STATE['values'][offset:offset + shape[0]] = values\n        _STATE['mask'][offset:offset + shape[0]] = mask\n        _STATE['offset'] += shape[0]\n    elif operation == 'train_commit':\n        if _STATE['offset'] != len(_STATE['values']):\n            raise ValueError('incomplete training upload')\n    elif operation == 'fit':\n        mean, factors = learn(_STATE['values'], _STATE['mask'], _STATE['steps'], _STATE['seed'])\n        _STATE.update(mean=mean, factors=factors)\n    elif operation == 'start':\n        _STATE['available'] = np.array(request['availability'], dtype=bool)\n        _STATE['queried'] = np.zeros_like(_STATE['available'])\n        _STATE['observed'] = np.zeros(_STATE['available'].shape)\n    elif operation == 'select':\n        factors = _STATE['factors']\n        indices = []\n        for row in range(len(_STATE['available'])):\n            selected = factors[_STATE['queried'][row]]\n            covariance = np.linalg.inv(selected.T @ selected + np.eye(factors.shape[1]) * 0.1)\n            targets = factors[_STATE['available'][row] & ~_STATE['queried'][row]]\n            reduction = np.sum((targets @ covariance @ factors.T) ** 2, axis=0)\n            reduction /= 1.0 + np.sum((factors @ covariance) * factors, axis=1)\n            legal = _STATE['available'][row] & ~_STATE['queried'][row]\n            reduction[~legal] = -np.inf\n            indices.append(int(np.argmax(reduction)))\n        _STATE['pending'] = indices\n        return {'indices': indices}\n    elif operation == 'observe':\n        if request['indices'] != _STATE['pending']:\n            raise ValueError('unexpected observation')\n        for row, (column, value) in enumerate(zip(request['indices'], request['values'])):\n            _STATE['queried'][row, column] = True\n            _STATE['observed'][row, column] = value\n    elif operation == 'predict':\n        mean, factors = _STATE['mean'], _STATE['factors']\n        predictions = []\n        for row in range(len(_STATE['available'])):\n            selected = factors[_STATE['queried'][row]]\n            latent = np.linalg.solve(selected.T @ selected + np.eye(factors.shape[1]) * 0.1,\n                                     selected.T @ (_STATE['observed'][row, _STATE['queried'][row]]\n                                                   - mean[_STATE['queried'][row]]))\n            predictions.append(np.clip(mean + factors @ latent, 0, 1).tolist())\n        return {'predictions': predictions}\n    else:\n        raise ValueError('unknown operation')\n    return {'ok': True}\n{\n  \"global_memory_dir\": \"work/results/r03/codex/20261107_045228/investigation\",\n  \"output_dir\": \"work/results/r03/codex/20261107_045228/paper\",\n  \"results_dir\": \"work/results/r03/codex/20261107_045228/investigation\",\n  \"schema_version\": 1,\n  \"task_dir\": \"work/results/r03/codex/20261107_045228/task\"\n}\ntotal 212\ndrwxrwxr-x 5 agent agent  4096 Nov  7 05:50 .\ndrwx------ 9 agent agent  4096 Nov  7 06:26 ..\n-rw------- 1 agent agent   668 Nov  7 05:50 .agentic_runtime.json\n-rw------- 1 agent agent   172 Nov  7 05:50 .agentic_task_ignore\n-rw------- 1 agent agent  1084 Nov  7 05:50 .agentic_task_publication.json\n-rw------- 1 agent agent   820 Nov  7 05:50 .agentic_task_qualification.json\n-rw------- 2 agent agent   138 Nov  7 05:50 .agentic_task_snapshot.json\n-rw------- 1 agent agent 16059 Nov  7 05:50 .agentic_task_validation.json\ndrwxr-xr-x 5 agent agent  4096 Nov  7 05:32 .venv\n-rw-r--r-- 1 agent agent   670 Nov  7 05:50 capture.py\n-rw-r--r-- 1 agent agent 54455 Nov  7 05:50 evaluate.py\n-rw-r--r-- 1 agent agent 54460 Nov  7 05:50 evaluate_final.py\ndrwx------ 3 agent agent  4096 Nov  7 05:50 program_0\n-rw-r--r-- 1 agent agent    44 Nov  7 05:50 requirements.txt\ndrwxr-xr-x 4 agent agent  4096 Nov  7 05:50 resources\n-rw-rw-r-- 1 agent agent 12583 Nov  7 04:52 task.md\n-rw------- 1 agent agent 18341 Nov  7 05:50 task_contract.json\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n\ndef _markdown_entry(event: dict[str, Any]) -> str:\n    \"\"\"Handle markdown entry logic for this module.\"\"\"\n    lines = [\n        f\"### {event['timestamp']} | step={event['step']} | scope={event['scope']}\",\n        f\"- summary: {event['summary']}\",\n        f\"- evidence: {event['evidence']}\",\n        f\"- next_action: {event['next_action']}\",\n    ]\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = event.get(key)\n        if isinstance(value, str) and value.strip():\n            lines.append(f\"- {key}: {value.strip()}\")\n\n    metrics = event.get(\"metrics\")\n    if isinstance(metrics, dict) and metrics:\n        lines.append(f\"- metrics: {json.dumps(metrics, sort_keys=True)}\")\n    rubrics = event.get(\"rubrics\")\n    if isinstance(rubrics, list) and rubrics:\n        lines.append(f\"- rubrics: {json.dumps(rubrics, sort_keys=True)}\")\n    tags = event.get(\"tags\")\n    if isinstance(tags, list) and tags:\n        lines.append(f\"- tags: {', '.join(str(item) for item in tags)}\")\n\n    return \"\\n\".join(lines) + \"\\n\\n\"\n\n\ndef _append_text(path: Path, text: str, *, header: str) -> None:\n    \"\"\"Safely initialize and append text to a regular file.\"\"\"\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if not size:\n","exit_code":0,"status":"completed"}}
