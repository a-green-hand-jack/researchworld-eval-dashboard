] == 1.0\n assert figure['layout_rationale'] and figure['export_requirements']\nfor method in strategy['method_groups']:\n assert method['role'] in ['baseline','proposed','ablation','supporting']\nassert data['grounding_sources']['final.qualification.outcome']['value'] == 'qualified'\nassert 'downstream_study' not in data and not any(key.startswith('study.') for key in data['grounding_sources'])\noriginal_cases = [case for episode in data['final_evaluation']['evaluation_evidence']['episodes'] for case in episode['solution']['cases'] if case['arm']=='original' and not case['replay']]\nfor index, name in enumerate(['candidate_mae','historical_mean_mae','observed_copy_mae','random_lowrank_mae','greedy_ridge_mae']):\n assert math.isclose(sum(case['losses'][index] for case in original_cases)/len(original_cases),data['final_evaluation']['metrics'][name],abs_tol=1e-12),name\nfor marker in ['ADVERSE_PRIMARY','ADVERSE_RIDGE','ADVERSE_AUDIT','{{PAPER_EDIT']:\n assert marker not in memo, marker\nassert not Path('paper.tex').exists() and not Path('claims_grounding.json').exists()\nprint(f'Strategy contract checks passed: {len(strategy[\\\"method_groups\\\"])} method groups, {len(strategy[\\\"figure_specs\\\"])} readable figures, {len(strategy[\\\"supplementary_plan\\\"][\\\"planned_subsections\\\"])} supplementary sections, {source_count} valid source references.')\nprint('Recorded primary metric aggregation reconstructed successfully; no evaluator or final-paper validation was run.')\nprint('Output sizes:',Path('paper_strategy.md').stat().st_size,'Markdown bytes;',Path('paper_strategy.json').stat().st_size,'JSON bytes.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
