\@writefile{toc}{\contentsline {section}{\numberline {E}Fixed-target estimator ablations}{13}{appendix.E}\protected@file@percent }
\newlabel{app:ablations}{{E}{13}{Fixed-target estimator ablations}{appendix.E}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Supplementary strict pair-reversal dose responses. Nominal fractions are $f\in \{0.005,0.01,0.02,0.05,0.1,0.2\}$ and actual integer budgets are $k=\max (1,\lceil fE_{ab}\rceil )$. The figure places points on the nominal grid, so plotted positions are not exact realized percentages after rounding. Random orderings are nested within a repeat, with 100 repeats; shaded bands are pointwise 95\% Wilson Monte Carlo intervals. Frozen influence has one deterministic ordering, not 100 replicates. Budgets exceeding an eligible ordering's length are omitted. Global controls can spend edits off-target, so the horizontal scale is exposure-referenced total cost, not always an incident-corruption fraction. Source: \texttt  {artifacts/random\_curves.csv}; generated figure: \texttt  {paper/figures/dose\_response.pdf}.}}{14}{figure.2}\protected@file@percent }
\newlabel{fig:dose}{{2}{14}{Supplementary strict pair-reversal dose responses. Nominal fractions are $f\in \{0.005,0.01,0.02,0.05,0.1,0.2\}$ and actual integer budgets are $k=\max (1,\lceil fE_{ab}\rceil )$. The figure places points on the nominal grid, so plotted positions are not exact realized percentages after rounding. Random orderings are nested within a repeat, with 100 repeats; shaded bands are pointwise 95\% Wilson Monte Carlo intervals. Frozen influence has one deterministic ordering, not 100 replicates. Budgets exceeding an eligible ordering's length are omitted. Global controls can spend edits off-target, so the horizontal scale is exposure-referenced total cost, not always an incident-corruption fraction. Source: \texttt {artifacts/random\_curves.csv}; generated figure: \texttt {paper/figures/dose\_response.pdf}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Secondary adjacent-pair audit: baseline gap versus exposure-scaled witness budget, both on logarithmic axes. The procedure audits 160{} adjacent pairs across the six baseline rankings. Points are selected-data descriptors; neither an association p-value nor a causal relationship is claimed. The same search incompleteness and denominator qualifications apply as for the primary audit. Source: \texttt  {artifacts/adjacent.csv}; summaries: \texttt  {artifacts/adjacent\_summary.csv}; generated figure: \texttt  {paper/figures/adjacent\_pairs.pdf}.}}{14}{figure.3}\protected@file@percent }
\newlabel{fig:adjacent}{{3}{14}{Secondary adjacent-pair audit: baseline gap versus exposure-scaled witness budget, both on logarithmic axes. The procedure audits \AdjacentCount {} adjacent pairs across the six baseline rankings. Points are selected-data descriptors; neither an association p-value nor a causal relationship is claimed. The same search incompleteness and denominator qualifications apply as for the primary audit. Source: \texttt {artifacts/adjacent.csv}; summaries: \texttt {artifacts/adjacent\_summary.csv}; generated figure: \texttt {paper/figures/adjacent\_pairs.pdf}}{figure.3}{}}
