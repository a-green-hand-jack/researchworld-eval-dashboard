enue\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"citation_count\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ]\n          },\n          \"query\": {\n            \"type\": \"string\"\n          },\n          \"source_url\": {\n            \"type\": \"string\"\n          },\n          \"retrieved_at\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
