OME>/.herdr/worktre\nresult.improvement_002: {'attempt_id': 'c02_cross_fitted_tail_adaptive_residual_scaling_attempt_01', 'id': 'result.improvement_002', 'idea_id': 'c02_cross_fitted_tail_adaptive_residual_scaling', 'program_dir': '<HOME>/.h\nresult.top_program_01: {'attempt_id': 'c02_cross_fitted_tail_adaptive_residual_scaling_attempt_01', 'id': 'result.top_program_01', 'idea_id': 'c02_cross_fitted_tail_adaptive_residual_scaling', 'program_dir': '<HOME>/.he\nresult.top_program_02: {'attempt_id': 'c01_noise_aware_latent_composition_bridge_attempt_01', 'id': 'result.top_program_02', 'idea_id': 'c01_noise_aware_latent_composition_bridge', 'program_dir': '<HOME>/.herdr/worktree\nresult.total_attempts: {'id': 'result.total_attempts', 'type': 'count', 'value': 3}\nresult.total_correct_programs: {'id': 'result.total_correct_programs', 'type': 'count', 'value': 2}\nresult.total_evaluated_programs: {'id': 'result.total_evaluated_programs', 'type': 'count', 'value': 2}\nresult.total_ideas: {'id': 'result.total_ideas', 'type': 'count', 'value': 3}\nstrategy keys dict_keys(['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason'])\nfigs [\n  {\n    \"figure_id\": \"conceptual_overview\",\n    \"required\": true,\n    \"purpose\": \"Make the target, training/calibration separation, learned scale, and limited meaning of the evidence legible before quantitative results.\",\n    \"figure_type\": \"diagram\",\n    \"preferred_generator\": \"generate-concept-figure\",\n    \"group_by\": \"scientific_object_and_information_split\",\n    \"metric\": \"not_applicable_conceptual_only\",\n    \"split_by\": \"training_calibration_and_evaluation_roles\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"The inspected ICLR paper.sty gives one 5.5-inch text column and a 9-inch text height; full width is also column width here. Target a 5.5-by-1.9-inch overview on page 1 or 2, about 0.25 page including caption. One left-to-right schematic with at most six short labeled blocks and a shift caveat is readable at 9-point text; avoid mini-panels, data-shaped decorative regions and invented observations.\",\n    \"allow_progression\": false,\n    \"max_panels\": 1,\n    \"max_panels_per_row\": 1,\n    \"max_categories_per_panel\": 6,\n    \"max_series_per_panel\": 4\n  },\n  {\n    \"figure_id\": \"coverage_by_condition\",\n    \"required\": true,\n    \"purpose\": \"Expose condition-dependent empirical reliability, both nominal levels, and the absence of a uniform advantage.\",\n    \"figure_type\": \"faceted_seed_dot_plot\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"H_B_S_condition\",\n    \"metric\": \"empirical_joint_composition_coverage\",\n    \"split_by\": \"dimension_3_or_10_and_nominal_coverage_0.95_or_0.90\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Use the full 5.5-inch single-column width, approximately 4.2 inches high, about 0.55 page including caption. Four panels in two rows leave each plotting area roughly 2.5 inches wide; restrict to three condition labels, four method colors, six small offset seed dots per method and one shared legend. Labels at least 9 points, ticks at least 8 points; use the same coverage axis across panels and avoid connecting H/B/S as a trajectory. Show seed variability rather than inventing condition-specific bootstrap intervals.\",\n    \"allow_progression\": false,\n    \"max_panels\": 4,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 3,\n    \"max_series_per_panel\": 4\n  },\n  {\n    \"figure_id\": \"reference_mass_by_condition\",\n    \"required\": true,\n    \"purpose\": \"Compare the specific measured size proxy without hiding coverage failures or the shifted dimension-3 mass increase.\",\n    \"figure_type\": \"faceted_seed_dot_plot\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"H_B_S_condition\",\n    \"metric\": \"reference_mass_averaged_over_nominal_levels_within_seed\",\n    \"split_by\": \"dimension_3_or_10\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Target 5.5 by 2.5 inches across two side-by-side panels, about 0.35 page including caption. Three categories and four shared method series fit without shrinking labels; use seed dots, mean markers, a shared legend and a common mass axis. State the alpha averaging and mixed reference measure explicitly. Do not combine with the four-panel coverage figure into an unreadable six-panel figure.\",\n    \"allow_progression\": false,\n    \"max_panels\": 2,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 3,\n    \"max_series_per_panel\": 4\n  }\n]\nprogram keys [dict_keys(['attempt_dir_name', 'attempt_id', 'combined_score', 'correct', 'eligible', 'eval_index', 'evaluation_evidence', 'idea_dir_name', 'idea_id', 'program_dir', 'program_id', 'program_idx']), dict_keys(['attempt_dir_name', 'attempt_id', 'combined_score', 'correct', 'eligible', 'eval_index', 'evaluation_evidence', 'idea_dir_name', 'idea_id', 'program_dir', 'program_id', 'program_idx'])]\nfirst ref {'campaign_results_dir': 'work/results/r02/codex/20261112_215054/investigation', 'count': 25, 'generated_at': '2026-11-12T23:12:45.910331+00:00', 'queries': ['\"Distribution-Free Predictive Inference For Regression\"', 'quantile regression boosting decision stumps pinball loss', '\"Conformalized Quantile Regression\"', '\"Isometric logratio transformations for compositional data analysis\"', 'logistic normal distribution compositional data simplex', 'multivariate conformal prediction Bonferroni hyperrectangles', '\"Conformal Prediction Under Covariate Shift\"', 'limits distribution free conditional predictive inference conditional coverage'], 'reference_query_plan': {'architectural_shifts': ['Scale-model comparison: quadratic-feature log-norm ridge versus a training-selected family that adds quantile stumps and log-space blends; aggregate results do not identify which component caused the difference', 'Region-representation comparison: raw-simplex L-infinity and coordinatewise regions versus global and locally scaled Euclidean residual-norm regions in ILR coordinates; the center remains shared and fixed', 'No neural architecture, pretrained model, or cross-dataset transfer is evidenced; the interaction-tree extension has no successful evaluation'], 'benchmarks': ['Task-owned logistic-normal-v1 synthetic continuous compositions with six covariates and dimensions 3 and 10; no real dataset was evaluated', 'H3 and H10: interior homoscedastic responses', 'B3 and B10: boundary-concentrated heteroscedastic responses, still strictly positive rather than exact-zero compositions', 'S3 and S10: boundary-concentrated heteroscedastic responses with a test-covariate mean shift', 'Final evaluation: six independent seed episodes, nominal coverage levels 0.95 and 0.90, fixed groups defined by the sign of the first covariate, Wilson intervals, and paired seed-bootstrap utility intervals'], 'central_topic': 'Reliability and reference-measure efficiency of training-only locally scaled split-conformal regions for continuous logistic-normal compositions in isometric log-ratio coordinates, evaluated across homoscedastic, boundary-concentrated heteroscedastic, and covariate-shift settings.', 'comparators': ['Unscaled global ILR split-conformal residual-norm regions', 'Raw-simplex L-infinity split-conformal regions and coordinatewise Bonferroni regions', 'Uncalibrated training-re\n","exit_code":0,"status":"completed"}}
