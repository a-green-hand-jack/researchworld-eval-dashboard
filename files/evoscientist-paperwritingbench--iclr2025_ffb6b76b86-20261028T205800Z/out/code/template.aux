\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Tokenization bias on a 1st-order Markov chain over $\{\texttt  {A},\texttt  {B}\}$ with vocabulary $\{\texttt  {A},\texttt  {B},\texttt  {AA}\}$. Given the context token ``\texttt  {A}'', the tokenized model never samples ``\texttt  {A}'' as the next byte, whereas the true probability is $1-\alpha $. In practice, the same bias occurs when prompts end with tokens that are prefixes of other tokens, which is common in FIM tasks.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:markov1}{{2}{4}{Tokenization bias on a 1st-order Markov chain over $\{\tok {A},\tok {B}\}$ with vocabulary $\{\tok {A},\tok {B},\tok {AA}\}$. Given the context token ``\tok {A}'', the tokenized model never samples ``\tok {A}'' as the next byte, whereas the true probability is $1-\alpha $. In practice, the same bias occurs when prompts end with tokens that are prefixes of other tokens, which is common in FIM tasks}{figure.2}{}}
