d\\\":\\\"/bin/sh -lc \\\\\\\"codex --codex-run-as-apply-patch '*** Begin Patch\\\\n*** End Patch'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n39:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_23\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/sh -lc \\\\\\\"codex --codex-run-as-apply-patch '*** Begin Patch\\\\n*** End Patch'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"No files were modified.\\\\n\\\",\\\"exit_code\\\":1,\\\"status\\\":\\\"failed\\\"}}\\n41:{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_25\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/sh -lc 'set -e\\\\napply_patch() { codex --codex-run-as-apply-patch \\\\\\\"$(cat)\\\\\\\"; }\\\\napply_patch <<'\\\\\\\"'PATCH'\\\\n*** Begin Patch\\\\n*** Add File: reference_query_plan.json\\\\n+{\\\\n+  \\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\",\\\\n+  \\\\\\\\\\\\\\\"central_topic\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"How the minimum number of task-specific, bounded score increases needed to make a fixed target co-first depends on mean, ordinary median, or Borda aggregation on public multi-task language-model score tables.\\\\\\\\\\\\\\\",\\\\n+  \\\\\\\\\\\\\\\"core_methods\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"Counterfactual minimum-support allocation: selecting task j replaces only the target score x_j with round(x_j + f(1-x_j), 10); investment is selected-task count, optionally normalized by task count; rivals remain fixed in score space and success permits the supplied co-first tolerance.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Exact scalar allocation by sorted achievable gains for the mean, threshold-deficit counting for odd ordinary medians, and middle-endpoint enumeration with shared promotions for even ordinary medians.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Borda as average pairwise win credit with half credit for ties; integer half-win representation and rival-aware covering constraints include changes to opponents' aggregate credits.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Bounded Borda branch-and-bound with per-rival optimistic bounds, greedy feasible incumbents, deletion pruning, and witness validation; no blanket claim of optimality after timeout.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"No-update, random allocation, and greedy allocation baselines; task-permutation, constant-score, and zero-response controls appear in the evaluated cases.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"comparators\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"Social-choice approaches to multi-task agent evaluation and positional rank aggregation.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Computational social choice, Borda manipulation, and minimum-cost bribery as related but nonidentical intervention models.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Benchmark-dependent model comparisons and the benchmark lottery.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Benchmark contamination and evaluation cheating, distinguished from hypothetical score-space responses.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Strategic post-training incentives and game-theoretic developer interactions, distinguished from one fixed target with nonreacting rivals.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"benchmarks\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"HELM MMLU: 57 subject-score columns; local search/final partitions contain 37/42 model rows.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Open LLM Leaderboard: six aggregate task columns, IFEval, BBH, MATH Lvl 5, GPQA, MUSR, and MMLU-PRO; local search/final partitions contain 2393/2129 model rows.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"architectural_shifts\\\\\\\\\\\\\\\": [],\\\\n+  \\\\\\\\\\\\\\\"result_driven_themes\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"Observed mean-versus-median support ordering is target- and response-dependent: both directions occur in original final-evaluation score tables, so these observations do not justify a universal robustness ordering.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Partial response f=0.5 can require more affected tasks or make co-first unattainable, whereas all sampled original-case targets have feasible witnesses at f=1.0; this concerns hypothetical score headroom, not training cost.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Cardinal aggregation and pairwise rank aggregation impose different allocation constraints; Borda requires updating rival credits rather than treating rival aggregates as fixed.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"No measured improvement separates the three equally scoring search configurations; no ablations establish benefits from prospective gain-window or rival-mixture-cut refinements, and search and final evaluation metrics must not be conflated.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"queries\\\\\\\\\\\\\\\": [\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Evaluating Agents using Social Choice Theory\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"core_method\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2312.03121. Positions the actually evaluated Borda/pairwise-credit rule against social-choice evaluation of agents; do not assume this source proves the run's allocation certificates.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Handbook of Computational Social Choice\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"core_method\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, DOI 10.1017/CBO9781107446984. Locate foundational Borda, manipulation, and bribery definitions for comparison with the selected source's integer covering formulation; changing one model's task scores is not automatically equivalent to standard vote manipulation or bribery.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"The Benchmark Lottery\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"result_driven_theme\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2107.07002. Provides context for contingent model comparisons: final original-case observations contain both mean-smaller and median-smaller task budgets. Benchmark selection in that work and aggregation/response changes here must remain distinct.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Don't Make Your LLM an Evaluation Benchmark Cheater\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"baseline_comparator\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2311.01964. Motivates targeted data exposure while marking the evidential boundary: the run changes scores counterfactually and neither trains models nor estimates a causal contamination-to-score response.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Leaderboard Incentives: Model Rankings under Strategic Post-Training\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"baseline_comparator\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2603.08371. Compare strategic developer/post-training models with this run's fixed-rival, single-target, bounded-response allocation; equilibrium behavior and real investment prices were not evaluated.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Measuring Massive Multitask Language Understanding\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"benchmark_context\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2009.03300. Establishes the 57-subject MMLU context visible in local HELM resource tables, relevant to the odd-median case; it is not provenance for the particular model-score snapshot.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Holistic Evaluation of Language Models\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"benchmark_context\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2211.09110. Supplies HELM evaluation context for the actual subject-score family. Snapshot version, row filtering, acquisition date, and score-file checksums must be grounded separately in acquisition records, not inferred from this citation.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"A framework for few-shot language model evaluation\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"benchmark_context\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, DOI 10.5281/zenodo.10256836. Provides evaluation-tooling context for the six-column Open LLM Leaderboard family, whose even task count matters for the ordinary-median solver. Do not infer exact harness versions or a new evaluation of underlying models from this reference.\\\\\\\\\\\\\\\"\\\\n+    }\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"forbidden_query_patterns\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"Any title, author, result, mirror, abstract, discussion, citation, reproduction, repository, or guessed identifier for the task-prohibited prior paper; do not attempt to identify it.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Any query outside the eight exact-title allowed-seed queries above without a separately safety-reviewed plan; do not broaden them into discovery searches about targeted multi-task leaderboard investment or aggregation attacks.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Citation/references graph expansion, related-paper recommendations, citing-paper searches, survey chaining, aggregation-site exploration, or automatic related-content previews, including those attached to otherwise allowed seeds.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Broad web or full-text searches that can return pages citing or discussing the unidentified prohibited work; later retrieval must be direct exact-identifier metadata resolution with exact-title agreement and no related-content expansion, and fail closed if this cannot be enforced.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Generic optimization, benchmarking, scientific method, paper writing, or campaign chronology queries without a specific connection to evaluated allocation methods.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Architecture migration, representation learning, fine-tuning efficacy, actual training cost, causal contamination gains, or cross-model transfer queries presented as findings of this score-only run.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Queries claiming universal median robustness, validated rival-mixture-cut superiority, a measured gain-window speedup, or an ablation result absent from grounded artifacts.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Queries treating task permutations, constant columns, zero-response copies, or repeated seeds on the same tables as independent public benchmarks or independent training replications.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"failure_reason\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\n+}\\\\n*** Add File: reference_query_plan.md\\\\n+# Grounded reference query plan\\\\n+\\\\n+**Status: ready.** Eight queries; planning only. No references were retrieved or read in this stage. The named works below are task-supplied allowed candidates, not newly verified citations.\\\\n+\\\\n+## Central topic and grounding\\\\n+\\\\n+Study the minimum number of task-specific, bounded score increases needed to make a fixed target co-first under mean, ordinary median, and Borda aggregation. Selecting task \\\\\\\"'`j` sets only the target score to `round(x_j + f(1-x_j), 10)`. Investment is support size, optionally normalized by task count. This is a hypothetical score-space intervention, not measured training expenditure, contamination efficacy, or an equilibrium among reacting developers.\\\\n+\\\\n+Evidence inspected:\\\\n+\\\\n+- `paper_data.json`: three evaluated search configurations, the selected downstream configuration, and separate final-evaluation allocations, reference bounds, and baselines. All three search configurations have equal recorded scores; no refinement superiority is established. The final evaluation is completed and qualified but has a different scope.\\\\n+- `source_evidence/downstream/program/src/program.py`: exact mean and odd/even ordinary-median allocation, integer half-win Borda covering constraints, bounded branch-and-bound, and a greedy feasible fallback. The accompanying `METHOD.md` supplies assumptions, not empirical proof of later proposed refinements.\\\\n+- `source_evidence/downstream/baseline/src/program.py`: greedy comparator. Final observations also contain random and no-update baselines.\\\\n+- `task/resources/{search,final}/{helm,openllm}.json`: task lists, partition sizes, scaling, acquisition date, and licensing caveats. The final evaluator checks resource hashes and runs original, task-permutation, constant-score, and zero-response-copy cases.\\\\n+- `figures/` contains no figure evidence. Neither `references.bib` nor `references_provenance.json` exists, so no prior queries need repair. Recent memory is private planning context only; prospective mixture cuts are not established findings of the selected executable.\\\\n+\\\\n+## Methods and comparator literatures\\\\n+\\\\n+Core methods are sorted headroom gains for the mean; threshold counts and middle-order-statistic endpoint enumeration for ordinary medians; rival-aware integer covering for Borda; and deadline-limited branch-and-bound with checked witnesses. Borda requires updating opponents'\\\\\\\"' aggregate credits even though their underlying scores remain fixed. A feasible witness alone does not establish Borda optimality. Greedy, random, and no-update allocations are experimental comparators, not invented external algorithm families.\\\\n+\\\\n+Reviewer-facing literature should cover social-choice evaluation, Borda manipulation/bribery with explicit non-equivalence caveats, benchmark-dependent comparisons, contamination, and strategic post-training. Generic optimization and unrelated model-architecture research are not needed.\\\\n+\\\\n+## Benchmark context and architecture boundary\\\\n+\\\\n+- **HELM/MMLU:** 57 subject columns; 37 search-partition and 42 final-partition model rows. The odd task count matters for the median formulation.\\\\n+- **Open LLM Leaderboard:** six aggregate columns: IFEval, BBH, MATH Lvl 5, GPQA, MUSR, and MMLU-PRO; 2393 search-partition and 2129 final-partition model rows. Scores are divided by 100. The even task count matters; these are not six separately rerun model evaluations.\\\\n+- Local resources record acquisition on \\\\\\\"'`2026-11-07` and uncertain score-data redistribution permission. Dataset citations cannot establish the exact score snapshot or its license. The task-requested HELM release and Hugging Face revisions must be checked against acquisition records before the paper asserts them.\\\\n+- **Architectural shifts: none.** Moving from cardinal scores to pairwise rank credits is an aggregation representation choice, not a neural-architecture or learned-representation transition. The JSON architectural-shifts list is deliberately empty.\\\\n+\\\\n+## Result-driven priorities\\\\n+\\\\n+Original final-evaluation observations support contingent rather than universal rule ordering. In the first recorded final episode, HELM target row `40` at `f=1` needs one task under the mean and zero under the median, while row `10` needs nine and twelve respectively. Open LLM row `1609` needs two mean versus three median tasks at `f=1`, but four versus three at `f=0.5`. These examples come directly from validated allocation records with exact reference budgets. They motivate contingent-comparison literature, not a claim that the median is always harder to influence.\\\\n+\\\\n+At `f=0.5`, original cases include unattainable targets; at `f=1`, all sampled original-case targets have feasible witnesses. These are bounded-response phenomena, not evidence that training can realize either cap. Repeated final seeds operate on the same tables and are not independent population samples. Permutation and constant-score checks are controls, not composition-resampling experiments. No ablations establish benefits from gain-window or mixture-cut proposals. Search and final evaluation metrics must not be conflated.\\\\n+\\\\n+## Query set\\\\n+\\\\n+Only the exact titles below are proposed. Identifiers are copied from the task'\\\\\\\"'s permitted starter list, not retrieval results.\\\\n+\\\\n+| # | Exact query | Category | Run-specific purpose |\\\\n+|---|---|---|---|\\\\n+| 1 | \\\\\\\"'`\\\\\\\"Evaluating Agents using Social Choice Theory\\\\\\\"` | core_method | Borda/pairwise-credit evaluation context; allowed seed `arXiv:2312.03121`, not an allocation-certificate claim. |\\\\n+| 2 | `\\\\\\\"Handbook of Computational Social Choice\\\\\\\"` | core_method | Borda, manipulation, and minimum-cost bribery foundations; DOI `10.1017/CBO9781107446984`. Do not equate ballot interventions with target-score updates. |\\\\n+| 3 | `\\\\\\\"The Benchmark Lottery\\\\\\\"` | result_driven_theme | Context for contingent comparisons suggested by observed budget-order reversals; `arXiv:2107.07002`. Task selection is distinct from this run'\\\\\\\"'s rule/response changes. |\\\\n+| 4 | \\\\\\\"'`\\\\\\\"Don'\\\\\\\"'t Make Your LLM an Evaluation Benchmark Cheater\\\\\\\\\\\\\\\"\\\\\\\"'` | baseline_comparator | Contamination motivation and the boundary between data exposure and hypothetical score caps; `arXiv:2311.01964`. |\\\\n+| 5 | `\\\\\\\"Leaderboard Incentives: Model Rankings under Strategic Post-Training\\\\\\\"` | baseline_comparator | Strategic-interaction comparator to fixed rivals and one target; `arXiv:2603.08371`. No equilibria were evaluated here. |\\\\n+| 6 | `\\\\\\\"Measuring Massive Multitask Language Understanding\\\\\\\"` | benchmark_context | The actual 57-subject benchmark and odd-median setting; `arXiv:2009.03300`. Not score-snapshot provenance. |\\\\n+| 7 | `\\\\\\\"Holistic Evaluation of Language Models\\\\\\\"` | benchmark_context | HELM evaluation and score-table context; `arXiv:2211.09110`. Not proof of snapshot version or filtering. |\\\\n+| 8 | `\\\\\\\"A framework for few-shot language model evaluation\\\\\\\"` | benchmark_context | Open LLM task-evaluation tooling context; DOI `10.5281/zenodo.10256836`. Not proof of exact harness version. |\\\\n+\\\\n+These eight queries beat broad leaderboard-attack, optimization, benchmarking, and paper-writing searches: each has a specific methodological, comparator, or dataset role and a task-approved identity. Individual task papers are not exhaustively queried because the run allocates over six aggregate columns rather than studying each benchmark'\\\\\\\"'s internal methodology. Chatbot Arena/private-testing literature and contamination-detection algorithms are lower priority because neither human-preference data nor detection experiments appear in the run.\\\\n+\\\\n+## Safety and retrieval handoff\\\\n+\\\\n+No network retrieval, Semantic Scholar search, or \\\\\\\"'`scholarly` call was made. Do not identify, guess, search for, access, or use the prohibited prior paper or anything citing/discussing it.\\\\n+\\\\n+The unidentified exclusion makes unrestricted discovery unsafe. Later retrieval must be direct metadata resolution of the eight supplied allowed identifiers with exact-title agreement. Do not broaden the queries, expand citation/reference graphs, read related-paper recommendations, browse aggregation pages, or follow citing papers. Disable related-content previews; fail closed if the retrieval system cannot maintain this boundary. If excluded material is encountered accidentally, stop reading immediately and record its location and extent of exposure in reproduction documentation, without pursuing it further.\\\\n+\\\\n+Also reject queries asserting architecture changes, causal training effects, universal rule robustness, new benchmarks from controls, or unmeasured solver improvements. Do not translate equal search scores or a separate final score into method superiority. Citation verification and reading are downstream work; this stage creates no bibliography, provenance file, paper source, or claims-grounding file.\\\\n*** End Patch\\\\nPATCH\\\\npython - <<'\\\\\\\"'PY'\\\\nimport json\\\\nfrom pathlib import Path\\\\nplan=json.loads(Path('reference_query_plan.json').read_text())\\\\nrequired={'status','central_topic','core_methods','comparators','benchmarks','architectural_shifts','result_driven_themes','queries','forbidden_query_patterns','failure_reason'}\\\\nassert set(plan)==required\\\\nassert plan['status']=='ready' and plan['failure_reason']==''\\\\nassert 6<=len(plan['queries'])<=10\\\\nassert len({entry['query'] for entry in plan['queries']})==len(plan['queries'])\\\\nallowed={'core_method','baseline_comparator','benchmark_context','architectural_shift','result_driven_theme'}\\\\nmemo=Path('reference_query_plan.md').read_text()\\\\nfor entry in plan['queries']:\\\\n assert set(entry)=={'query','category','rationale'}\\\\n assert entry['category'] in allowed and entry['rationale'] and entry['query'] in memo\\\\nassert plan['architectural_shifts']==[]\\\\nfor filename in ['references.bib','references_provenance.json','paper.tex','claims_grounding.json']:\\\\n assert not Path(filename).exists(), filename\\\\nprint('Validated schema, eight unique mirrored queries, and absence of prohibited stage outputs.')\\\\nPY\\\\npython .codex/skills/memory-log/scripts/append_memory.py --global-memory-md /workspace/investigation/memory.md --global-memory-jsonl /workspace/investigation/memory.jsonl --event-json '{\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"final\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"scope\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"paper\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"summary\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"reference_query_plan_ready confirmed: both files now exist and schema/mirroring validation passed. Used the installed Codex internal apply_patch dispatcher after the PATH utility was unavailable. gate=kept; trigger=none; reason=Reference planning scopes observations without revising scientific recommendations.\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"evidence\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Eight exact-title task-allowed queries cover social choice, Borda/manipulation, benchmark lottery, contamination, strategic post-training, MMLU, HELM, and evaluation tooling. JSON schema and unique-query checks passed, all queries occur in the Markdown memo, and prohibited stage outputs remain absent. Original final allocations show both mean/median orderings and a cap-conditioned reversal for OpenLLM row 1609. No architecture shift or refinement superiority is claimed.\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"next_action\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Planning complete; hand off to safety-constrained exact-identifier verification only, with no related-content or citation-graph expansion. Generic optimization and broad leaderboard-attack searches were rejected as lower signal and unsafe. No reference retrieval or paper generation occurred.\\\\\\\\\\\\\\\"}'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n42:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_25\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/sh -lc 'set -e\\\\napply_patch() { codex --codex-run-as-apply-patch \\\\\\\"$(cat)\\\\\\\"; }\\\\napply_patch <<'\\\\\\\"'PATCH'\\\\n*** Begin Patch\\\\n*** Add File: reference_query_plan.json\\\\n+{\\\\n+  \\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\",\\\\n+  \\\\\\\\\\\\\\\"central_topic\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"How the minimum number of task-specific, bounded score increases needed to make a fixed target co-first depends on mean, ordinary median, or Borda aggregation on public multi-task language-model score tables.\\\\\\\\\\\\\\\",\\\\n+  \\\\\\\\\\\\\\\"core_methods\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"Counterfactual minimum-support allocation: selecting task j replaces only the target score x_j with round(x_j + f(1-x_j), 10); investment is selected-task count, optionally normalized by task count; rivals remain fixed in score space and success permits the supplied co-first tolerance.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Exact scalar allocation by sorted achievable gains for the mean, threshold-deficit counting for odd ordinary medians, and middle-endpoint enumeration with shared promotions for even ordinary medians.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Borda as average pairwise win credit with half credit for ties; integer half-win representation and rival-aware covering constraints include changes to opponents' aggregate credits.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Bounded Borda branch-and-bound with per-rival optimistic bounds, greedy feasible incumbents, deletion pruning, and witness validation; no blanket claim of optimality after timeout.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"No-update, random allocation, and greedy allocation baselines; task-permutation, constant-score, and zero-response controls appear in the evaluated cases.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"comparators\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"Social-choice approaches to multi-task agent evaluation and positional rank aggregation.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Computational social choice, Borda manipulation, and minimum-cost bribery as related but nonidentical intervention models.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Benchmark-dependent model comparisons and the benchmark lottery.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Benchmark contamination and evaluation cheating, distinguished from hypothetical score-space responses.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Strategic post-training incentives and game-theoretic developer interactions, distinguished from one fixed target with nonreacting rivals.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"benchmarks\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"HELM MMLU: 57 subject-score columns; local search/final partitions contain 37/42 model rows.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Open LLM Leaderboard: six aggregate task columns, IFEval, BBH, MATH Lvl 5, GPQA, MUSR, and MMLU-PRO; local search/final partitions contain 2393/2129 model rows.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"architectural_shifts\\\\\\\\\\\\\\\": [],\\\\n+  \\\\\\\\\\\\\\\"result_driven_themes\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"Observed mean-versus-median support ordering is target- and response-dependent: both directions occur in original final-evaluation score tables, so these observations do not justify a universal robustness ordering.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Partial response f=0.5 can require more affected tasks or make co-first unattainable, whereas all sampled original-case targets have feasible witnesses at f=1.0; this concerns hypothetical score headroom, not training cost.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Cardinal aggregation and pairwise rank aggregation impose different allocation constraints; Borda requires updating rival credits rather than treating rival aggregates as fixed.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"No measured improvement separates the three equally scoring search configurations; no ablations establish benefits from prospective gain-window or rival-mixture-cut refinements, and search and final evaluation metrics must not be conflated.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"queries\\\\\\\\\\\\\\\": [\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Evaluating Agents using Social Choice Theory\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"core_method\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2312.03121. Positions the actually evaluated Borda/pairwise-credit rule against social-choice evaluation of agents; do not assume this source proves the run's allocation certificates.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Handbook of Computational Social Choice\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"core_method\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, DOI 10.1017/CBO9781107446984. Locate foundational Borda, manipulation, and bribery definitions for comparison with the selected source's integer covering formulation; changing one model's task scores is not automatically equivalent to standard vote manipulation or bribery.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"The Benchmark Lottery\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"result_driven_theme\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2107.07002. Provides context for contingent model comparisons: final original-case observations contain both mean-smaller and median-smaller task budgets. Benchmark selection in that work and aggregation/response changes here must remain distinct.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Don't Make Your LLM an Evaluation Benchmark Cheater\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"baseline_comparator\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2311.01964. Motivates targeted data exposure while marking the evidential boundary: the run changes scores counterfactually and neither trains models nor estimates a causal contamination-to-score response.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Leaderboard Incentives: Model Rankings under Strategic Post-Training\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"baseline_comparator\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2603.08371. Compare strategic developer/post-training models with this run's fixed-rival, single-target, bounded-response allocation; equilibrium behavior and real investment prices were not evaluated.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Measuring Massive Multitask Language Understanding\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"benchmark_context\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2009.03300. Establishes the 57-subject MMLU context visible in local HELM resource tables, relevant to the odd-median case; it is not provenance for the particular model-score snapshot.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Holistic Evaluation of Language Models\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"benchmark_context\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, arXiv:2211.09110. Supplies HELM evaluation context for the actual subject-score family. Snapshot version, row filtering, acquisition date, and score-file checksums must be grounded separately in acquisition records, not inferred from this citation.\\\\\\\\\\\\\\\"\\\\n+    },\\\\n+    {\\\\n+      \\\\\\\\\\\\\\\"query\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"A framework for few-shot language model evaluation\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"category\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"benchmark_context\\\\\\\\\\\\\\\",\\\\n+      \\\\\\\\\\\\\\\"rationale\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Task-supplied allowed seed, DOI 10.5281/zenodo.10256836. Provides evaluation-tooling context for the six-column Open LLM Leaderboard family, whose even task count matters for the ordinary-median solver. Do not infer exact harness versions or a new evaluation of underlying models from this reference.\\\\\\\\\\\\\\\"\\\\n+    }\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"forbidden_query_patterns\\\\\\\\\\\\\\\": [\\\\n+    \\\\\\\\\\\\\\\"Any title, author, result, mirror, abstract, discussion, citation, reproduction, repository, or guessed identifier for the task-prohibited prior paper; do not attempt to identify it.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Any query outside the eight exact-title allowed-seed queries above without a separately safety-reviewed plan; do not broaden them into discovery searches about targeted multi-task leaderboard investment or aggregation attacks.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Citation/references graph expansion, related-paper recommendations, citing-paper searches, survey chaining, aggregation-site exploration, or automatic related-content previews, including those attached to otherwise allowed seeds.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Broad web or full-text searches that can return pages citing or discussing the unidentified prohibited work; later retrieval must be direct exact-identifier metadata resolution with exact-title agreement and no related-content expansion, and fail closed if this cannot be enforced.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Generic optimization, benchmarking, scientific method, paper writing, or campaign chronology queries without a specific connection to evaluated allocation methods.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Architecture migration, representation learning, fine-tuning efficacy, actual training cost, causal contamination gains, or cross-model transfer queries presented as findings of this score-only run.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Queries claiming universal median robustness, validated rival-mixture-cut superiority, a measured gain-window speedup, or an ablation result absent from grounded artifacts.\\\\\\\\\\\\\\\",\\\\n+    \\\\\\\\\\\\\\\"Queries treating task permutations, constant columns, zero-response copies, or repeated seeds on the same tables as independent public benchmarks or independent training replications.\\\\\\\\\\\\\\\"\\\\n+  ],\\\\n+  \\\\\\\\\\\\\\\"failure_reason\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\n+}\\\\n*** Add File: reference_query_plan.md\\\\n+# Grounded reference query plan\\\\n+\\\\n+**Status: ready.** Eight queries; planning only. No references were retrieved or read in this stage. The named works below are task-supplied allowed candidates, not newly verified citations.\\\\n+\\\\n+## Central topic and grounding\\\\n+\\\\n+Study the minimum number of task-specific, bounded score increases needed to make a fixed target co-first under mean, ordinary median, and Borda aggregation. Selecting task \\\\\\\"'`j` sets only the target score to `round(x_j + f(1-x_j), 10)`. Investment is support size, optionally normalized by task count. This is a hypothetical score-space intervention, not measured training expenditure, contamination efficacy, or an equilibrium among reacting developers.\\\\n+\\\\n+Evidence inspected:\\\\n+\\\\n+- `paper_data.json`: three evaluated search configurations, the selected downstream configuration, and separate final-evaluation allocations, reference bounds, and baselines. All three search configurations have equal recorded scores; no refinement superiority is established. The final evaluation is completed and qualified but has a different scope.\\\\n+- `source_evidence/downstream/program/src/program.py`: exact mean and odd/even ordinary-median allocation, integer half-win Borda covering constraints, bounded branch-and-bound, and a greedy feasible fallback. The accompanying `METHOD.md` supplies assumptions, not empirical proof of later proposed refinements.\\\\n+- `source_evidence/downstream/baseline/src/program.py`: greedy comparator. Final observations also contain random and no-update baselines.\\\\n+- `task/resources/{search,final}/{helm,openllm}.json`: task lists, partition sizes, scaling, acquisition date, and licensing caveats. The final evaluator checks resource hashes and runs original, task-permutation, constant-score, and zero-response-copy cases.\\\\n+- `figures/` contains no figure evidence. Neither `references.bib` nor `references_provenance.json` exists, so no prior queries need repair. Recent memory is private planning context only; prospective mixture cuts are not established findings of the selected executable.\\\\n+\\\\n+## Methods and comparator literatures\\\\n+\\\\n+Core methods are sorted headroom gains for the mean; threshold counts and middle-order-statistic endpoint enumeration for ordinary medians; rival-aware integer covering for Borda; and deadline-limited branch-and-bound with checked witnesses. Borda requires updating opponents'\\\\\\\"' aggregate credits even though their underlying scores remain fixed. A feasible witness alone does not establish Borda optimality. Greedy, random, and no-update allocations are experimental comparators, not invented external algorithm families.\\\\n+\\\\n+Reviewer-facing literature should cover social-choice evaluation, Borda manipulation/bribery with explicit non-equivalence caveats, benchmark-dependent comparisons, contamination, and strategic post-training. Generic optimization and unrelated model-architecture research are not needed.\\\\n+\\\\n+## Benchmark context and architecture boundary\\\\n+\\\\n+- **HELM/MMLU:** 57 subject columns; 37 search-partition and 42 final-partition model rows. The odd task count matters for the median formulation.\\\\n+- **Open LLM Leaderboard:** six aggregate columns: IFEval, BBH, MATH Lvl 5, GPQA, MUSR, and MMLU-PRO; 2393 search-partition and 2129 final-partition model rows. Scores are divided by 100. The even task count matters; these are not six separately rerun model evaluations.\\\\n+- Local resources record acquisition on \\\\\\\"'`2026-11-07` and uncertain score-data redistribution permission. Dataset citations cannot establish the exact score snapshot or its license. The task-requested HELM release and Hugging Face revisions must be checked against acquisition records before the paper asserts them.\\\\n+- **Architectural shifts: none.** Moving from cardinal scores to pairwise rank credits is an aggregation representation choice, not a neural-architecture or learned-representation transition. The JSON architectural-shifts list is deliberately empty.\\\\n+\\\\n+## Result-driven priorities\\\\n+\\\\n+Original final-evaluation observations support contingent rather than universal rule ordering. In the first recorded final episode, HELM target row `40` at `f=1` needs one task under the mean and zero under the median, while row `10` needs nine and twelve respectively. Open LLM row `1609` needs two mean versus three median tasks at `f=1`, but four versus three at `f=0.5`. These examples come directly from validated allocation records with exact reference budgets. They motivate contingent-comparison literature, not a claim that the median is always harder to influence.\\\\n+\\\\n+At `f=0.5`, original cases include unattainable targets; at `f=1`, all sampled original-case targets have feasible witnesses. These are bounded-response phenomena, not evidence that training can realize either cap. Repeated final seeds operate on the same tables and are not independent population samples. Permutation and constant-score checks are controls, not composition-resampling experiments. No ablations establish benefits from gain-window or mixture-cut proposals. Search and final evaluation metrics must not be conflated.\\\\n+\\\\n+## Query set\\\\n+\\\\n+Only the exact titles below are proposed. Identifiers are copied from the task'\\\\\\\"'s permitted starter list, not retrieval results.\\\\n+\\\\n+| # | Exact query | Category | Run-specific purpose |\\\\n+|---|---|---|---|\\\\n+| 1 | \\\\\\\"'`\\\\\\\"Evaluating Agents using Social Choice Theory\\\\\\\"` | core_method | Borda/pairwise-credit evaluation context; allowed seed `arXiv:2312.03121`, not an allocation-certificate claim. |\\\\n+| 2 | `\\\\\\\"Handbook of Computational Social Choice\\\\\\\"` | core_method | Borda, manipulation, and minimum-cost bribery foundations; DOI `10.1017/CBO9781107446984`. Do not equate ballot interventions with target-score updates. |\\\\n+| 3 | `\\\\\\\"The Benchmark Lottery\\\\\\\"` | result_driven_theme | Context for contingent comparisons suggested by observed budget-order reversals; `arXiv:2107.07002`. Task selection is distinct from this run'\\\\\\\"'s rule/response changes. |\\\\n+| 4 | \\\\\\\"'`\\\\\\\"Don'\\\\\\\"'t Make Your LLM an Evaluation Benchmark Cheater\\\\\\\\\\\\\\\"\\\\\\\"'` | baseline_comparator | Contamination motivation and the boundary between data exposure and hypothetical score caps; `arXiv:2311.01964`. |\\\\n+| 5 | `\\\\\\\"Leaderboard Incentives: Model Rankings under Strategic Post-Training\\\\\\\"` | baseline_comparator | Strategic-interaction comparator to fixed rivals and one target; `arXiv:2603.08371`. No equilibria were evaluated here. |\\\\n+| 6 | `\\\\\\\"Measuring Massive Multitask Language Understanding\\\\\\\"` | benchmark_context | The actual 57-subject benchmark and odd-median setting; `arXiv:2009.03300`. Not score-snapshot provenance. |\\\\n+| 7 | `\\\\\\\"Holistic Evaluation of Language Models\\\\\\\"` | benchmark_context | HELM evaluation and score-table context; `arXiv:2211.09110`. Not proof of snapshot version or filtering. |\\\\n+| 8 | `\\\\\\\"A framework for few-shot language model evaluation\\\\\\\"` | benchmark_context | Open LLM task-evaluation tooling context; DOI `10.5281/zenodo.10256836`. Not proof of exact harness version. |\\\\n+\\\\n+These eight queries beat broad leaderboard-attack, optimization, benchmarking, and paper-writing searches: each has a specific methodological, comparator, or dataset role and a task-approved identity. Individual task papers are not exhaustively queried because the run allocates over six aggregate columns rather than studying each benchmark'\\\\\\\"'s internal methodology. Chatbot Arena/private-testing literature and contamination-detection algorithms are lower priority because neither human-preference data nor detection experiments appear in the run.\\\\n+\\\\n+## Safety and retrieval handoff\\\\n+\\\\n+No network retrieval, Semantic Scholar search, or \\\\\\\"'`scholarly` call was made. Do not identify, guess, search for, access, or use the prohibited prior paper or anything citing/discussing it.\\\\n+\\\\n+The unidentified exclusion makes unrestricted discovery unsafe. Later retrieval must be direct metadata resolution of the eight supplied allowed identifiers with exact-title agreement. Do not broaden the queries, expand citation/reference graphs, read related-paper recommendations, browse aggregation pages, or follow citing papers. Disable related-content previews; fail closed if the retrieval system cannot maintain this boundary. If excluded material is encountered accidentally, stop reading immediately and record its location and extent of exposure in reproduction documentation, without pursuing it further.\\\\n+\\\\n+Also reject queries asserting architecture changes, causal training effects, universal rule robustness, new benchmarks from controls, or unmeasured solver improvements. Do not translate equal search scores or a separate final score into method superiority. Citation verification and reading are downstream work; this stage creates no bibliography, provenance file, paper source, or claims-grounding file.\\\\n*** End Patch\\\\nPATCH\\\\npython - <<'\\\\\\\"'PY'\\\\nimport json\\\\nfrom pathlib import Path\\\\nplan=json.loads(Path('reference_query_plan.json').read_text())\\\\nrequired={'status','central_topic','core_methods','comparators','benchmarks','architectural_shifts','result_driven_themes','queries','forbidden_query_patterns','failure_reason'}\\\\nassert set(plan)==required\\\\nassert plan['status']=='ready' and plan['failure_reason']==''\\\\nassert 6<=len(plan['queries'])<=10\\\\nassert len({entry['query'] for entry in plan['queries']})==len(plan['queries'])\\\\nallowed={'core_method','baseline_comparator','benchmark_context','architectural_shift','result_driven_theme'}\\\\nmemo=Path('reference_query_plan.md').read_text()\\\\nfor entry in plan['queries']:\\\\n assert set(entry)=={'query','category','rationale'}\\\\n assert entry['category'] in allowed and entry['rationale'] and entry['query'] in memo\\\\nassert plan['architectural_shifts']==[]\\\\nfor filename in ['references.bib','references_provenance.json','paper.tex','claims_grounding.json']:\\\\n assert not Path(filename).exists(), filename\\\\nprint('Validated schema, eight unique mirrored queries, and absence of prohibited stage outputs.')\\\\nPY\\\\npython .codex/skills/memory-log/scripts/append_memory.py --global-memory-md /workspace/investigation/memory.md --global-memory-jsonl /workspace/investigation/memory.jsonl --event-json '{\\\\\\\\\\\\\\\"step\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"final\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"scope\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"paper\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"summary\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"reference_query_plan_ready confirmed: both files now exist and schema/mirroring validation passed. Used the installed Codex internal apply_patch dispatcher after the PATH utility was unavailable. gate=kept; trigger=none; reason=Reference planning scopes observations without revising scientific recommendations.\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"evidence\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Eight exact-title task-allowed queries cover social choice, Borda/manipulation, benchmark lottery, contamination, strategic post-training, MMLU, HELM, and evaluation tooling. JSON schema and unique-query checks passed, all queries occur in the Markdown memo, and prohibited stage outputs remain absent. Original final allocations show both mean/median orderings and a cap-conditioned reversal for OpenLLM row 1609. No architecture shift or refinement superiority is claimed.\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"next_action\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Planning complete; hand off to safety-constrained exact-identifier verification only, with no related-content or citation-graph expansion. Generic optimization and broad leaderboard-attack searches were rejected as lower signal and unsafe. No reference retrieval or paper generation occurred.\\\\\\\\\\\\\\\"}'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\nimport datetime\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\n\\ndef log_event(step, summary, evidence, next_action):\\n    event = {\\n        \\\"timestamp\\\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\\n        \\\"scope\\\": \\\"paper\\\",\\n        \\\"step\\\": step,\\n        \\\"summary\\\": summary,\\n        \\\"evidence\\\": evidence,\\n        \\\"next_action\\\": next_action,\\n    }\\n    text = \\\"\\\\n### {timestamp} — {step}\\\\n{summary}\\\\nEvidence: {evidence}\\\\nNext: {next_action}\\\\n\\\".format(**event)\\n    for path in [Path(\\\"memory.md\\\"), Path(\\\"global_memory/memory.md\\\").resolve()]:\\n        with path.open(\\\"a\\\") as stream:\\n            stream.write(text)\\n    with Path(\\\"global_memory/memory.jsonl\\\").resolve().open(\\\"a\\\") as stream:\\n        stream.write(json.dumps(event) + \\\"\\\\n\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    log_event(*sys.argv[1:])\\ntasks: None\\nfinal top keys: ['correct', 'evaluation_evidence', 'evaluator_sha256', 'manifest_path', 'metrics', 'outcome', 'program_tree_sha256', 'results_tree_sha256', 'status', 'task