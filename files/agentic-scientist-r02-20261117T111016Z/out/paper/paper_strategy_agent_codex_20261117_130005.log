Luo},\n booktitle = {Conference on Uncertainty in Artificial Intelligence},\n journal = {ArXiv},\n title = {Residual Reweighted Conformal Prediction for Graph Neural Networks},\n volume = {abs/2506.07854},\n year = {2025}\n}\n\n@Article{Tailor2025ApproximatingFC,\n author = {Dharmesh Tailor and Alvaro H. C. Correia and Eric T. Nalisnick and Christos Louizos},\n booktitle = {International Conference on Learning Representations},\n journal = {ArXiv},\n title = {Approximating Full Conformal Prediction for Neural Network Regression with Gauss-Newton Influence},\n volume = {abs/2507.20272},\n year = {2025}\n}\n\n@Article{Shahbazi2026GeometryAwareUQ,\n author = {Marzieh Amiri Shahbazi and A. Baheri},\n booktitle = {arXiv.org},\n journal = {ArXiv},\n title = {Geometry-Aware Uncertainty Quantification via Conformal Prediction on Manifolds},\n volume = {abs/2602.16015},\n year = {2026}\n}\n\n@Inproceedings{Santos2026LoBoostML,\n author = {Vagner S. Santos and Victor Coscrato and Luben M. C. Cabezas and R. Izbicki and Thiago Ramos},\n title = {LoBoost: Model-Native Local Conformal Prediction for Gradient-Boosted Trees},\n year = {2026}\n}\n\n@Article{Wu2025ConformalizedRF,\n author = {Zhan Wu and Fabrizio Leisen and F. Rubio},\n booktitle = {arXiv.org},\n journal = {ArXiv},\n title = {Conformalized Regression for Continuous Bounded Outcomes},\n volume = {abs/2507.14023},\n year = {2025}\n}\n\n@Article{Astola2019ComparisonOS,\n author = {H. Astola and T. Häme and Laura Sirro and M. Molinier and Jorma Kilpi},\n booktitle = {Remote Sensing of Environment},\n journal = {Remote Sensing of Environment},\n title = {Comparison of Sentinel-2 and Landsat 8 imagery for forest variable prediction in boreal region},\n year = {2019}\n}\n\n@Article{Yang2021SelectionAA,\n author = {Yachong Yang and A. Kuchibhotla},\n booktitle = {Journal of the American Statistical Association},\n journal = {Journal of the American Statistical Association},\n pages = {435 - 447},\n title = {Selection and Aggregation of Conformal Prediction Sets},\n volume = {120},\n year = {2021}\n}\n\n            alpha_results = []\n            for alpha_index in range(3):\n                differences, volume_differences = [], []\n                for outcome in case_outcomes:\n                    methods = outcome['solution']['methods']\n                    if methods is None:\n                        differences.append(-1.0)\n                        volume_differences.append(1.0)\n                    else:\n                        differences.append(methods['scaled_ilr'][alpha_index]['utility'] - methods[baseline][alpha_index]['utility'])\n                        volume_differences.append(methods['scaled_ilr'][alpha_index]['volume'] - methods[baseline][alpha_index]['volume'])\n                bootstrap_difference = np.array(differences)[indices].mean(1)\n                bootstrap_volume = np.array(volume_differences)[indices].mean(1)\n                adjusted_tail = .05 / (2 * 54)\n                alpha_results.append({'alpha': ALPHAS[alpha_index], 'utility_difference': fixed_mean(differences),\n                    'volume_difference': fixed_mean(volume_differences),\n                    'paired_seed_bootstrap95': np.quantile(bootstrap_difference, [.025, .975]).tolist(),\n                    'paired_volume_bootstrap95': np.quantile(bootstrap_volume, [.025, .975]).tolist(),\n                    'bonferroni54_bootstrap_interval': np.quantile(bootstrap_difference, [adjusted_tail, 1 - adjusted_tail]).tolist()})\n            comparisons[baseline] = alpha_results\n        feature_controls = {}\n        for control in ('constant_input', 'permuted_input'):\n1:schema_version = 1\n6:language = \"python\"\ntotal 0\n","exit_code":0,"status":"completed"}}
