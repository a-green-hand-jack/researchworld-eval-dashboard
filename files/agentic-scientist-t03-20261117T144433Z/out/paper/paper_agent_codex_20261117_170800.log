{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nr=json.load(open('references_provenance.json'))\nfor x in r['references']: print(x['citation_key'], x['year'],x['title'])\nPY\nrg -n '2026|textheight|textwidth|author|Anonymous' paper.sty | head -25; sed -n '836,856p' source_evidence/evaluation/evaluate_final.py; cat source_evidence/downstream/baseline/src/program.py | tail -55\"","aggregated_output":"Lundberg2017 2017 A Unified Approach to Interpreting Model Predictions\nKrishna2022 2022 The Disagreement Problem in Explainable Machine Learning: A Practitioner's Perspective\nYuan2022 2022 An empirical study of the effect of background data size on the stability of SHapley Additive exPlanations (SHAP) for deep learning models\nMusco2024 2024 Provably Accurate Shapley Value Estimation via Leverage Score Sampling\nChen2020 2020 True to the Model or True to the Data?\nMarx2020 2019 Predictive Multiplicity in Classification\nDing2021 2021 Retiring Adult: New Datasets for Fair Machine Learning\nGorishniy2021 2021 Revisiting Deep Learning Models for Tabular Data\nMaleki2013 2013 Bounding the Estimation Error of Sampling-based Shapley Value Approximation\nBreiman2001 2001 Random Forests\nFriedman2001 2001 Greedy function approximation: A gradient boosting machine.\nHarris2020 2020 Array programming with NumPy\nVirtanen2020 2020 SciPy 1.0: fundamental algorithms for scientific computing in Python\nMcKinney2010 2010 Data Structures for Statistical Computing in Python\nEfron1979 1979 Bootstrap Methods: Another Look at the Jackknife\nDiCiccio1996 1996 Bootstrap confidence intervals\nDiaconis1977 1977 Spearman's Footrule as a Measure of Disarray\nWebber2010 2010 A similarity measure for indefinite rankings\nCastro2009 2009 Polynomial calculation of the Shapley value based on sampling\nShapley1953 1953 17. A Value for n-Person Games\nGermanCredit 1994 Statlog (German Credit Data)\nNogueira2018 2018 On the Stability of Feature Selection Algorithms\nPedregosa2011 2011 Scikit-learn: Machine Learning in Python\nMitchell2022 2022 Sampling Permutations for Shapley Value Estimation\nCovert2021 2021  Improving KernelSHAP: Practical Shapley Value Estimation Using Linear Regression \n23:\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n48:\\textheight 9.0 true in       % Height of text (including footnotes & figures)\n49:\\textwidth 5.5 true in        % Width of text line.\n64:   \\def\\@makefnmark{\\hbox to 0pt{$^{\\@thefnmark}$\\hss}} % for perfect author\n74:\\gdef\\@thanks{}\\gdef\\@author{}\\gdef\\@title{}\\let\\thanks\\relax}\n83:\\def\\@maketitle{\\vbox{\\hsize\\textwidth\n88:    \\lhead{Published as a conference paper at ICLR 2026}\n93:    \\begin{tabular}[t]{l}\\bf\\rule{\\z@}{24pt}\\@author\\end{tabular}%\n95:       \\lhead{Under review as a conference paper at ICLR 2026}\n100:    \\begin{tabular}[t]{l}\\bf\\rule{\\z@}{24pt}Anonymous authors\\\\Paper under double-blind review\\end{tabular}%\n188:%Reduced second vskip to compensate for adding the strut in \\@author\n215:\\textheight=#5\\vbadness=10000\\vfuzz=120ex\\overfullrule=0pt%\n216:\\global\\setbox\\iclrrulerbox=\\vbox to \\textheight{%\n217:{\\parskip=0pt\\hfuzz=150em\\cv@boxheight=\\textheight\n229:\\def\\iclrruler#1{\\makevruler[12pt][#1][1][3][0.993\\textheight]\\usebox{\\iclrrulerbox}}\n232:\\iclrruleroffset=\\textheight\n245:% \\colorbox[rgb]{0.7,0.7,0.7}{\\small \\parbox[b][\\textheight]{0.1cm}{}}}\n                                  else .5 * (similarity(attribution, refs[0]) + similarity(attribution, refs[1])))\n            pairs = [agreements(repeats[first], repeats[second]) for first in range(len(repeats)) for second in range(first)]\n            agreement_values.extend(value[\"top_k\"] for value in pairs)\n            rungs.append({\"budget\": budget, \"phi\": [value.tolist() for value in repeats], \"pair_agreement\": pairs,\n                          \"duration_seconds\": durations, \"local_residual\": residuals})\n        averaged = []\n        average_durations = []\n        for _ in range(4):\n            attribution, _, duration, digest = explain(bounded_call, bundle[\"model\"], explained, background, config[\"budgets\"][0], stream, totals)\n            stream += 1\n            trace.append(digest)\n            averaged.append(attribution)\n            average_durations.append(duration)\n        paired_gain = similarity(np.mean(averaged, axis=0), reference) - similarity(np.array(rungs[1][\"phi\"][0]), reference)\n        metrics = {\"repeat_agreement\": float(np.mean(agreement_values)), \"reference_fidelity\": float(np.mean(fidelities)),\n                   \"local_accuracy_quality\": float(np.mean(local_values)), \"matched_budget_gain\": paired_gain,\n                   \"reference_resolution_quality\": similarity(refs[0], refs[1])}\n        cells.append({\"input_index\": source[\"input_index\"], \"background_size\": len(background),\n                      \"references\": [value.tolist() for value in refs],\n                      \"reference_counts\": source[\"reference_counts\"], \"exact_counts\": source[\"exact_counts\"],\n                      \"baseline_counts\": source[\"deployment_counts\"],\nBudgets include endpoints, duplicates and all model evaluations. No optimization\nor metric feedback is delivered. Independent repetitions have distinct stream\nIDs; same reset/stream/settings must replay deterministically. No training,\nstate export, file exchange, or large-value transport is needed: all bounded\nmessages fit below 64 MiB including JSON/envelope/framing. Larger shapes are\ninvalid, not requests to load files. Each run has exactly start + observe RPCs.\nSearch ranks evidence completion, not a favorable reliability conclusion. The\npaper still needs real results, uncertainty, references, official conference\ntemplate/checklist and all reproduction code; this starter is not a paper.\n\"\"\"\n\nimport numpy as np\n\n_seed = 0\n_active = None\n\n\ndef handle(request):\n    global _seed, _active\n    operation = request[\"op\"]\n    if operation == \"reset\":\n        if type(request[\"seed\"]) is not int or request[\"seed\"] < 0:\n            raise ValueError(\"invalid seed\")\n        _seed = request[\"seed\"]\n        _active = None\n        return {\"ok\": True}\n    if operation == \"start\":\n        features = request[\"features\"]\n        budget = request[\"budget\"]\n        if not 2 <= features <= 20 or not 32 <= budget <= 256:\n            raise ValueError(\"unsupported shape\")\n        generator = np.random.default_rng(np.random.SeedSequence([_seed, request[\"stream\"]]))\n        sizes = np.arange(1, features)\n        probabilities = 1.0 / (sizes * (features - sizes))\n        probabilities /= probabilities.sum()\n        masks = np.zeros((budget, features), dtype=np.int64)\n        masks[1] = 1\n        for index in range(2, budget):\n            size = int(generator.choice(sizes, p=probabilities))\n            masks[index, generator.choice(features, size=size, replace=False)] = 1\n        _active = masks\n        return {\"masks\": masks.tolist()}\n    if operation == \"observe\":\n        if _active is None:\n            raise ValueError(\"no active explanation\")\n        masks = _active\n        values = np.asarray(request[\"values\"], dtype=np.float64)\n        total = values[1] - values[0]\n        design = masks[2:, :-1] - masks[2:, -1:]\n        target = values[2:] - values[0] - masks[2:, -1] * total\n        partial = np.linalg.lstsq(design, target, rcond=1e-10)[0]\n        attribution = np.append(partial, total - partial.sum())\n        _active = None\n        return {\"phi\": attribution.tolist()}\n    raise ValueError(\"unknown operation\")\n","exit_code":0,"status":"completed"}}
