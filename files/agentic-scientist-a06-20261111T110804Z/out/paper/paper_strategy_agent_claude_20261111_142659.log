{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WEuFp7iJS5yD1VFxJX6KfL","type":"tool_result","content":"#!/usr/bin/env python3\n\"\"\"Sealed final-plane evaluator: selection-aware score reporting after prompt/pipeline search.\n\nThe evaluator owns every world (synthetic latent-difficulty worlds and cached real\nMMLU-Pro x 24-prompt-config outcome tensors), both searchers, the truth, and the\nbaselines.  The candidate only receives the search-time evaluation log of one\nreplication and reports (estimate, lower, upper) for the fresh-question accuracy of\nthe selected configuration.  Score = negative mean interval score at level 0.90.\n\"\"\"\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nimport re\nimport resource\nimport selectors\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom statistics import NormalDist\n\nimport numpy as np\n\n# ---- PLANE BLOCK BEGIN ----\nPLANE = \"final\"\nSEEDS = (9101, 9102, 9103, 9104, 9105, 9106, 9107, 9108)\nCASE_ORDER = (\"P1\", \"P2\", \"P3\", \"P4\", \"P5\", \"P6\", \"N1\", \"N2\", \"Z1\")\nREAL_PRIMARY = (\"P3\", \"P4\", \"P5\", \"P6\")\nRNG_ENTROPY = 0xF1A2A101\nWALL_CLOCK = 9000.0\nCANDIDATE_CAP = 5400.0\nRPC_CALL_CAP = 2110\nSMOKE_SEED = 9101\n# ---- PLANE BLOCK END ----\n\nSYN_PRIMARY = (\"P1\", \"P2\")\nFAMILY_WEIGHTS = {\"synthetic\": 0.4, \"real\": 0.6}\nLEVEL = 0.90\nALPHA = 1.0 - LEVEL\nWORST_IS = 20.0  # declared worst case: width 1, |bias| 1, truth missed\nZ90 = NormalDist().inv_cdf(0.95)\nWIRE_LIMIT = 64 * 1024 * 1024\nPROXY_PATH = \"/broker-code/candidate_proxy.py\"\nN_CONFIG_REAL = 24\nRESAMPLE_B = 100\nSYN_RHO = 0.5\nSYN_SPREAD_SD = 0.03\n\nSTARTUP_ALLOWANCE = 120.0\nFINISH_RESERVE = 30.0\nRESET_TIMEOUT = 20.0\nRPC_CAP = 10.0\nEPISODE_OVERHEAD = 8.0  # candidate terminate+kill/reap (4) + bookkeeping/transition (4)\n\nMETRIC_NAMES = (\n    \"combined_score\", \"mean_interval_score\", \"coverage\", \"mean_width\", \"signed_bias\", \"rmse\",\n    \"naive_baseline_score\", \"bonferroni_baseline_score\", \"resample_baseline_score\",\n    \"naive_signed_bias\", \"null_control_abs_bias\", \"null_control_coverage\",\n    \"constant_control_error\", \"completed_replication_fraction\",\n)\n\n    \"Z1\": dict(world=\"const\", searcher=\"exhaustive\", K=8, N=100, R=10),\n}\nSMOKE_N = {\"syn\": 40, \"syn_null\": 40, \"real\": 30, \"real_null\": 30, \"const\": 20}\nSMOKE_POOL = 150\nSMOKE_R = 2\n\n\ndef case_params(name, smoke):\n    p = dict(CASES[name])\n    if smoke:\n        p[\"R\"] = SMOKE_R\n        p[\"N\"] = SMOKE_N[p[\"world\"]]\n        if name == \"P5\":\n            p[\"N\"] = 20\n    return p\n\n\ndef declared_reset_sequence(smoke):\n    if smoke:\n        return [SMOKE_SEED for _ in CASE_ORDER]\n    return [seed for seed in SEEDS for _ in CASE_ORDER]\n\n\n# ---------------------------------------------------------------- helpers (required-worker identity)\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\nclass CandidateTransportError(RuntimeError):\n    pass\n\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {\"ok\"} or response[\"ok\"] is not True:\n        raise InvalidResetResponse(\"invalid reset response\")\n\n\nclass RequiredBaselineFailure(RuntimeError):\n    def __init__(self, category):\n        self.category = bounded_failure_name(category, \"invalid_baseline_diagnostic\")\n        super().__init__(\"required baseline failed\")\n\n\ndef bounded_failure_name(value, fallback):\n    return value if isinstance(value, str) and re.fullmatch(r\"[a-z][a-z0-9_]{0,79}\", value) else fallback\n\n\ndef describe_episode_failure(error, operation):\n    context = error\n    for _ in range(8):\n        if isinstance(context, InvalidResetResponse):\n            return {\"component\": \"candidate\", \"category\": \"invalid_reset_response\", \"operation\": \"reset\"}\n        if isinstance(context, RequiredBaselineFailure):\n            return {\"component\": \"baseline\", \"category\": context.category, \"operation\": \"baseline_worker\"}\n        if isinstance(context, CandidateTransportError):\n472:def wilson(p, n, z):\n552:    naive = (p,) + wilson(p, n_sel, Z90)\n554:    bonf = (p,) + wilson(p, n_sel, z_bonf)\n568:    resample = (est,) + wilson(est, n_sel, Z90)\n1:@Article{Jaar2005ComparingTR,\n11:@Article{McHorney1997GenericHM,\n21:@Article{James2008MetaanalysisAF,\n31:@Article{Flodgren2012EffectivenessOO,\n41:@Article{Kouroukis2002ChemotherapyFO,\n51:@Article{Durack2003EvaluatingAO,\n63:@Inproceedings{Eggert2012ProceedingsOT,\n70:@Article{Leopold2019EditorialIO,\n78:@Article{None,\n87:@Inproceedings{Wee2017ResearchAA,\n93:@Inproceedings{Lee2008SampleAB,\n99:@Inproceedings{Sutherland2012RunningH,\n105:@Article{Davoren2013WhatIT,\n113:@Article{Dwork2014PreservingSV,\n121:@Article{Dwork2015TheRH,\n131:@Article{Dwork2015GeneralizationIA,\n140:@Article{Feldman2017CalibratingNT,\n149:@Article{Dwork2017GuiltfreeDR,\n159:@Inproceedings{Yanai2003NewDI,\n165:@Inproceedings{Lindsey2019The6A,\n173:@Article{Zavala2017TowardsAM,\n181:@Article{Marchant2024AdaptiveDA,\n190:@Article{Ullman2017TechnicalPB,\n200:@Inproceedings{Reitter2006MethodsR,\n206:@Inproceedings{Gervasi2007ComputationalSA,\n250 global_memory/ideas/01_empirical_bayes_latent_difficulty_posterior_interval/program_1/src/program.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"5d9f3fff-e236-4c90-ae14-7a47dddbd380","uuid":"53582500-a6c4-4ab3-acc2-8817e9691e33","timestamp":"2026-11-11T14:30:13.113Z","tool_use_result":{"stdout":"#!/usr/bin/env python3\n\"\"\"Sealed final-plane evaluator: selection-aware score reporting after prompt/pipeline search.\n\nThe evaluator owns every world (synthetic latent-difficulty worlds and cached real\nMMLU-Pro x 24-prompt-config outcome tensors), both searchers, the truth, and the\nbaselines.  The candidate only receives the search-time evaluation log of one\nreplication and reports (estimate, lower, upper) for the fresh-question accuracy of\nthe selected configuration.  Score = negative mean interval score at level 0.90.\n\"\"\"\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nimport re\nimport resource\nimport selectors\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom statistics import NormalDist\n\nimport numpy as np\n\n# ---- PLANE BLOCK BEGIN ----\nPLANE = \"final\"\nSEEDS = (9101, 9102, 9103, 9104, 9105, 9106, 9107, 9108)\nCASE_ORDER = (\"P1\", \"P2\", \"P3\", \"P4\", \"P5\", \"P6\", \"N1\", \"N2\", \"Z1\")\nREAL_PRIMARY = (\"P3\", \"P4\", \"P5\", \"P6\")\nRNG_ENTROPY = 0xF1A2A101\nWALL_CLOCK = 9000.0\nCANDIDATE_CAP = 5400.0\nRPC_CALL_CAP = 2110\nSMOKE_SEED = 9101\n# ---- PLANE BLOCK END ----\n\nSYN_PRIMARY = (\"P1\", \"P2\")\nFAMILY_WEIGHTS = {\"synthetic\": 0.4, \"real\": 0.6}\nLEVEL = 0.90\nALPHA = 1.0 - LEVEL\nWORST_IS = 20.0  # declared worst case: width 1, |bias| 1, truth missed\nZ90 = NormalDist().inv_cdf(0.95)\nWIRE_LIMIT = 64 * 1024 * 1024\nPROXY_PATH = \"/broker-code/candidate_proxy.py\"\nN_CONFIG_REAL = 24\nRESAMPLE_B = 100\nSYN_RHO = 0.5\nSYN_SPREAD_SD = 0.03\n\nSTARTUP_ALLOWANCE = 120.0\nFINISH_RESERVE = 30.0\nRESET_TIMEOUT = 20.0\nRPC_CAP = 10.0\nEPISODE_OVERHEAD = 8.0  # candidate terminate+kill/reap (4) + bookkeeping/transition (4)\n\nMETRIC_NAMES = (\n    \"combined_score\", \"mean_interval_score\", \"coverage\", \"mean_width\", \"signed_bias\", \"rmse\",\n    \"naive_baseline_score\", \"bonferroni_baseline_score\", \"resample_baseline_score\",\n    \"naive_signed_bias\", \"null_control_abs_bias\", \"null_control_coverage\",\n    \"constant_control_error\", \"completed_replication_fraction\",\n)\n\n    \"Z1\": dict(world=\"const\", searcher=\"exhaustive\", K=8, N=100, R=10),\n}\nSMOKE_N = {\"syn\": 40, \"syn_null\": 40, \"real\": 30, \"real_null\": 30, \"const\": 20}\nSMOKE_POOL = 150\nSMOKE_R = 2\n\n\ndef case_params(name, smoke):\n    p = dict(CASES[name])\n    if smoke:\n        p[\"R\"] = SMOKE_R\n        p[\"N\"] = SMOKE_N[p[\"world\"]]\n        if name == \"P5\":\n            p[\"N\"] = 20\n    return p\n\n\ndef declared_reset_sequence(smoke):\n    if smoke:\n        return [SMOKE_SEED for _ in CASE_ORDER]\n    return [seed for seed in SEEDS for _ in CASE_ORDER]\n\n\n# ---------------------------------------------------------------- helpers (required-worker identity)\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\nclass CandidateTransportError(RuntimeError):\n    pass\n\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {\"ok\"} or response[\"ok\"] is not True:\n        raise InvalidResetResponse(\"invalid reset response\")\n\n\nclass RequiredBaselineFailure(RuntimeError):\n    def __init__(self, category):\n        self.category = bounded_failure_name(category, \"invalid_baseline_diagnostic\")\n        super().__init__(\"required baseline failed\")\n\n\ndef bounded_failure_name(value, fallback):\n    return value if isinstance(value, str) and re.fullmatch(r\"[a-z][a-z0-9_]{0,79}\", value) else fallback\n\n\ndef describe_episode_failure(error, operation):\n    context = error\n    for _ in range(8):\n        if isinstance(context, InvalidResetResponse):\n            return {\"component\": \"candidate\", \"category\": \"invalid_reset_response\", \"operation\": \"reset\"}\n        if isinstance(context, RequiredBaselineFailure):\n            return {\"component\": \"baseline\", \"category\": context.category, \"operation\": \"baseline_worker\"}\n        if isinstance(context, CandidateTransportError):\n472:def wilson(p, n, z):\n552:    naive = (p,) + wilson(p, n_sel, Z90)\n554:    bonf = (p,) + wilson(p, n_sel, z_bonf)\n568:    resample = (est,) + wilson(est, n_sel, Z90)\n1:@Article{Jaar2005ComparingTR,\n11:@Article{McHorney1997GenericHM,\n21:@Article{James2008MetaanalysisAF,\n31:@Article{Flodgren2012EffectivenessOO,\n41:@A