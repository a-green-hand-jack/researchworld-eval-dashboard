{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019hskSJ22Woj5XHKTxXxYiw","type":"tool_result","content":"#!/usr/bin/env python3\n\"\"\"Trusted search evaluator for the few-item benchmark-prediction task.\n\nThe candidate (python_rpc_v1:handle) sees only the binary correct/incorrect matrix of SOURCE models\n(opaque rows/columns), chooses at most k item columns, then receives each TARGET model's responses on\nthose columns only and predicts its full-benchmark accuracy.  Everything scored here is computed from\nevaluator-held matrices; candidate-reported values are never used.\n\nEpisode plan (seed-major, then benchmark order, then split order, then the two negative controls):\n  primary episode  = (seed, benchmark, split in [random_targets, strong_targets])\n  control episode  = permuted_targets / constant_targets, matched to one real random_targets episode\nAggregation hierarchy (declared before evaluation): episode -> mean over seeds within\n(benchmark, split) -> equal-weight mean over benchmarks within a split -> 0.5*random + 0.5*strong.\nEpisode utility u = 0.5*clip(1-2*MAE,0,1) + 0.5*(Spearman+1)/2; failed/missing episodes contribute\nMAE=RMSE=1, Spearman=Kendall=-1, u=0 and keep their weight.\n\"\"\"\n\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport io\nimport json\nimport math\nimport os\nimport re\nimport resource\nimport selectors\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport warnings\n\n# Candidate threads/environment are derived from the parent environment captured before the\n# evaluator pins its own (<=4) thread pools.\n_PARENT_ENV = dict(os.environ)\nfor _name in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\"):\n    os.environ[_name] = \"4\"\nos.environ[\"PYTHONHASHSEED\"] = \"0\"\n\nimport numpy as np  # noqa: E402\nfrom scipy import stats  # noqa: E402\n\n_T0 = time.monotonic()\n\nPLANE = \"search\"\nRESOURCE_SUBDIR = \"resources/search\"\nBENCH_NAMES = ['ifeval', 'arc_challenge', 'musr', 'gsm', 'bbh']\nBENCHMARK_SHA256 = {\n    \"ifeval\": \"808c4df4f62e9e9cc290249766b30663496c041ae27590e9ffc66e88899e20b2\",\n    \"arc_challenge\": \"e8e01a89f6b1018c0ddbae31650852b74280241af85a7d589dafda5406143856\",\n    \"musr\": \"a4580672ac844b73ded68308a651ee28f5131f925ea9188b939d68a7ac8158d3\",\n    \"gsm\": \"69b63842a235a99581ad867c778a3ee00a3b871bb6a9ca1c52821d117b6d5848\",\n    \"bbh\": \"cb08dabb84dbd06c512b8746d168eae59ff20c6137711b324732de0edc7217d7\"\n}\nSEEDS = [11, 12]\nRESET_SEQUENCE = [11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 11, 11]\nSMOKE_RESET_SEQUENCE = [11, 11, 11, 11]\nCONTROL_BENCH = \"arc_challenge\"\nSMOKE_BENCH = \"ifeval\"\nSMOKE_MAX_ITEMS = 300\nWALL_SECONDS = 5400.0\nBASELINE_BUDGET = 300.0\nEPISODE_SECONDS = 120.0\nMAX_CANDIDATE_RPC_CALLS = 110\nBOOT_SEED = 20260101\nMETRIC_NAMES = ['combined_score', 'mae', 'rmse', 'spearman', 'kendall', 'mae_random_targets', 'mae_strong_targets', 'spearman_random_targets', 'spearman_strong_targets', 'delta_mae_vs_random_mean', 'delta_mae_vs_anchor_points', 'delta_mae_vs_irt_style', 'delta_score_vs_best_baseline', 'control_permuted_spearman_drop', 'control_permuted_mae_increase', 'control_constant_mae_delta', 'n_completed_episodes', 'n_failed_episodes', 'n_candidate_rpc_calls_observed']\n\n# ---------------------------------------------------------------------------------------------\n# Fixed, plane-independent protocol constants\n# ---------------------------------------------------------------------------------------------\nSPLITS = (\"random_targets\", \"strong_targets\")\nSPLIT_WEIGHTS = (0.5, 0.5)\nK_PRODUCTION = 100\nK_SMOKE = 20\nTARGET_FRACTION = 0.2\nSTRONG_QUANTILE = 0.7\nMIN_SOURCES = 40\nMIN_TARGETS = 5\nSMOKE_MAX_MODELS = 100\nWIRE_LIMIT = 64 * 1024 * 1024\nCHUNK_MESSAGE_CAP = 8 * 1024 * 1024\nMAX_LOAD_CHUNKS = 2\nDTYPE_TAG = \"uint8 bits\"\nENCODING_TAG = \"np.packbits axis=1 bitorder=big then base64\"\nPROXY_PATH = \"/broker-code/candidate_proxy.py\"\nEVAL_THREADS = 4\nCANDIDATE_THREADS = 8\nCANDIDATE_MEMORY_BYTES = 16 * 1024 ** 3\n\nSTARTUP_ALLOWANCE = 120.0\nFINISH_RESERVE = 60.0\nRESET_TIMEOUT = 45.0\nRPC_CAP = 120.0\nCLEANUP_SECONDS = 8.0\nEPISODE_OVERHEAD = 8.0\nESTIMATED_PRODUCTION_EPISODE_CLEANUP = 8.0\n\nIRT_DIMS = 3\nIRT_ITERS = 200\nBOOT_REPLICATES = 300\n\nWORST = {\"mae\": 1.0, \"rmse\": 1.0, \"spearman\": -1.0, \"kendall\": -1.0, \"u\": 0.0}\n\nSMOKE = os.environ.get(\"AGENTIC_TASK_DRAFT_SMOKE\") == \"1\"\nQUALIFICATION = os.environ.get(\"AGENTIC_TASK_QUALIFICATION\") == \"1\"\nDIAGNOSTICS_VISIBLE = PLANE == \"search\" and (SMOKE or QUALIFICATION)\n\n\n# ---------------------------------------------------------------------------------------------\n# Required-worker failure identity and bounded diagnostics (shared recipes)\n# ---------------------------------------------------------------------------------------------\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {\"ok\"} or response[\"ok\"] is not True:\n        raise InvalidResetResponse(\"invalid reset response\")\n\n\ndef bounded_failure_name(value, fallback):\n    return value if isinstance(value, str) and re.fullmatch(r\"[a-z][a-z0-9_]{0,79}\", value) else fallback\n\n\nclass RequiredBaselineFailure(RuntimeError):\n    def __init__(self, category):\n        self.category = bounded_failure_name(category, \"invalid_baseline_diagnostic\")\n        super().__init__(\"required baseline failed\")\n\n\nclass CandidateProtocolError(RuntimeError):\n    \"\"\"Expected candidate-side fault with a fixed category and operation name.\"\"\"\n\n    def __init__(self, category, operation):\n        self.category = bounded_failure_name(category, \"protocol_error\")\n\"\"\"Starter candidate: few-item benchmark prediction (python_rpc_v1:handle).\n\nTask.  An episode gives you the binary correct/incorrect matrix of SOURCE models on a benchmark\nwhose items are opaque column indices (no text, no names, shuffled rows).  You choose at most ``k``\nitem columns.  The evaluator then reveals each TARGET model's responses on those columns only and you\npredict every target's accuracy on the FULL benchmark.  Targets never appear among the sources.\nScoring (evaluator-owned): MAE / RMSE and Spearman / Kendall of predictions against the targets' true\nfull-benchmark accuracy; a target regime may be \"random_targets\" (targets look like the sources) or\n\"strong_targets\" (targets are stronger than every source model, so predictions must extrapolate).\n\nEvery request and response is a finite JSON dict with an \"op\" field in the request.  Per episode the\nevaluator sends, in this order, exactly one reset, then 1-2 load_source calls, one select, one predict.\nState lives only in this process and is cleared by reset.  Unknown ops, extra response keys, wrong types\nor out-of-range values are protocol failures (the episode then scores as the worst case).\n\nOperations\n----------\nreset        request  {\"op\": \"reset\", \"seed\": int >= 0}\n             response {\"ok\": True}                     (exactly this dict)\n             Clears all state; ``seed`` may only be used to initialise randomness.  Any valid seed\n             must work; the seed does not identify the benchmark or the plane.\n\nload_source  request  {\"op\": \"load_source\", \"task_id\": str (opaque label), \"episode_id\": str,\n                       \"n_source_models\": int, \"n_items\": int, \"k\": int (item budget),\n                       \"split\": \"random_targets\" | \"strong_targets\",\n                       \"n_chunks\": int (1 or 2), \"chunk_index\": int, \"row_start\": int,\n                       \"row_count\": int, \"dtype\": \"uint8 bits\", \"shape\": [row_count, n_items],\n                       \"encoding\": \"np.packbits axis=1 bitorder=big then base64\",\n                       \"data_b64\": str}\n             Decode: np.unpackbits(np.frombuffer(base64.b64decode(data_b64), np.uint8)\n                                   .reshape(row_count, -1), axis=1)[:, :n_items]\n             gives a uint8 0/1 array (1 = the source model answered the item correctly) for rows\n             row_start .. row_start+row_count-1 of the source matrix.  Chunks arrive in order.\n             response {\"ok\": True}                     (exactly this dict)\n\nselect       request  {\"op\": \"select\", \"episode_id\": str, \"k\": int}\n             response {\"indices\": [int, ...]}          (exactly this dict)\n             1 <= len <= k, unique ints in [0, n_items).  The order you return is the column order\n             of the matrix you will receive in predict.  No other item is ever revealed for targets.\n\npredict      request  {\"op\": \"predict\", \"episode_id\": str, \"indices\": [the selected ints, echoed],\n                       \"n_targets\": int, \"dtype\": \"uint8 bits\", \"shape\": [n_targets, len(indices)],\n                       \"encoding\": \"np.packbits axis=1 bitorder=big then base64\", \"data_b64\": str}\n             Decode as for load_source (use ``len(indices)`` columns).  Row order is arbitrary.\n             response {\"predictions\": [float, ...]}    (exactly this dict)\n             n_targets finite numbers in [0, 1]: the predicted full-benchmark accuracy per target.\n\nLimits enforced by the evaluator: item budget ``k`` (hard), a per-episode wall clock, and a fixed total\nRPC budget; every complete message is far below the 64 MiB wire limit.  Stay inside ~8 threads.\nnumpy is available; scipy and scikit-learn may be used if installed.\n\nThis starter stratifies items by source difficulty, picks one item per stratum, and maps the target's\nmean accuracy on those items to a full-benchmark estimate with a linear calibration fitted on the\nsource models (source subset-mean -> source full accuracy).\n\"\"\"\n\nimport base64\nimport math\n\nimport numpy as np\n\n_STATE = {}\n\n\ndef _decode(b64, rows, cols):\n    raw = np.frombuffer(base64.b64decode(b64), dtype=np.uint8).reshape(rows, -1)\n    return np.unpackbits(raw, axis=1)[:, :cols]\n\n\ndef _reset(seed):\n    _STATE.clear()\n    _STATE[\"rng\"] = np.random.default_rng(int(seed))\n    _STATE[\"chunks\"] = {}\n    return {\"ok\": True}\n\n\ndef _load_source(req):\n    chunks = _STATE[\"chunks\"]\n    chunks[int(req[\"chunk_index\"])] = _decode(req[\"data_b64\"], int(req[\"row_count\"]), int(req[\"n_items\"]))\n    _STATE[\"n_chunks\"] = int(req[\"n_chunks\"])\n    _STATE[\"k\"] = int(req[\"k\"])\n    if len(chunks) == _STATE[\"n_chunks\"]:\n        _STATE[\"src\"] = np.concatenate([chunks[i] for i in sorted(chunks)], axis=0)\n    return {\"ok\": True}\n\n\ndef _select(req):\n    src = _STATE[\"src\"]\n    k = min(int(req[\"k\"]), src.shape[1])\n    difficulty = src.mean(axis=0)\n    rng = _STATE[\"rng\"]\n    order = np.argsort(difficulty + 1e-9 * rng.random(src.shape[1]), kind=\"stable\")\n    strata = np.array_split(order, k)\n    picks = [int(rng.choice(group)) for group in strata if len(group)]\n    _STATE[\"indices\"] = picks\n    return {\"indices\": picks}\n\n\ndef _predict(req):\n    src = _STATE[\"src\"]\n    idx = [int(i) for i in req[\"indices\"]]\n    tgt = _decode(req[\"data_b64\"], int(req[\"n_targets\"]), len(idx)).astype(np.float64)\n    target_mean = tgt.mean(axis=1)\n    sub = src[:, idx].astype(np.float64).mean(axis=1)\n    full = src.astype(np.float64).mean(axis=1)\n    if np.ptp(sub) > 1e-9:\n        slope, intercept = np.polyfit(sub, full, 1)\n        pred = slope * target_mean + intercept\n    else:\n        pred = target_mean\n    pred = np.clip(pred, 0.0, 1.0)\n    return {\"predictions\": [float(p) if math.isfinite(float(p)) else 0.5 for p in pred]}\n\n\ndef handle(request):\n    op = request.get(\"op\")\n    if op == \"reset\":\n        return _reset(request[\"seed\"])\n    if op =