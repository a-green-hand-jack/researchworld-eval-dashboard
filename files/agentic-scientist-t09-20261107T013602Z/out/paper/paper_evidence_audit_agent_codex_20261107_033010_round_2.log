\"Recorded sha256 matches file contents.\"\n      ],\n      \"raw_reference\": \"<artifact.sha256>\",\n      \"resolved_path\": \"source_evidence/task_contract.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"source_evidence/task_contract.json.prov.json\",\n      \"target\": \"source_evidence/task_contract.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper_data.json]]\",\n      \"resolved_path\": \"paper_data.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"source_evidence/task_contract.json.prov.json\",\n      \"target\": \"paper_data.json\"\n    },\n    {\n      \"messages\": [\n        \"generated_by.script_path exists.\"\n      ],\n      \"raw_reference\": \"<generated_by.script_path>\",\n      \"resolved_path\": \"build_paper_artifacts.py\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"source_evidence/task_contract.json.prov.json\",\n      \"target\": \"build_paper_artifacts.py\"\n    }\n  ],\n  \"root_dir\": \"work/results/t09/codex/20261107_014043/.paper_evidence_audit_workspaces-1000/agentic-evidence-audit-1000-20261107_033010-paper_evidence_audit_round_2-xu_8zubf/workspace\",\n  \"schema_name\": \"scientific-evidence.verification-report\",\n  \"summary\": {\n    \"anchored_references\": 79,\n    \"dangling_references\": 1,\n    \"manifests_checked\": 22,\n    \"resolved_references\": 113,\n    \"total_references\": 193\n  },\n  \"verified_at\": \"2026-11-07T04:24:58.642149+00:00\"\n}\n","exit_code":2,"status":"failed"}}
