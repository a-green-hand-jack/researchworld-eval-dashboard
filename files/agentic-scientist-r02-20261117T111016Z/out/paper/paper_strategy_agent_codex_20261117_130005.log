{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,statistics,hashlib\nfrom pathlib import Path\npaper=json.loads(Path('paper_data.json').read_text())\nfor key in ['result.top_program_01','result.top_program_02','result.improvement_001','result.improvement_002','result.improvement_003']:\n print(key, {field:value for field,value in paper['grounding_sources'][key].items() if field in ['id','value','idea_id','attempt_id']})\nprint('Final score vs selected standard comparator: utility, mean V')\nfor index, case in enumerate(paper['final_evaluation']['evaluation_evidence']['episodes'][0]['solution']['cases']):\n summary={}\n for name in ['scaled_ilr','unscaled_ilr','simplex_linf','bonferroni']:\n  records=[record for episode in paper['final_evaluation']['evaluation_evidence']['episodes'] for record in episode['solution']['cases'][index]['methods'][name]]\n  summary[name]=[round(statistics.mean(record[metric] for record in records),5) for metric in ['utility','volume']]\n print(case['case'],summary)\nprint('Unique uncertainty objects',len({json.dumps(episode['solution']['seed_block_uncertainty'],sort_keys=True) for episode in paper['final_evaluation']['evaluation_evidence']['episodes']}))\nmanifest=json.loads(Path('task/resources/final/manifest.json').read_text())\nprint('All split counts',sorted({tuple(split['count'] for split in entry['splits'].values()) for entry in manifest['episodes']}))\nprint('Search seed sets',[(variant['idea_id'],[episode['seed'] for episode in variant['evaluation_evidence']['episodes']]) for variant in paper['all_programs']])\nprint('Provenance target references',[(reference['citation_key'],reference['title'],reference['source_url']) for reference in json.loads(Path('references_provenance.json').read_text())['references'] if reference['citation_key'] in ['Lei2016DistributionFreePI','Yang2021SelectionAA']])\nPY\nsed -n '1,80p' references.bib; sed -n '1049,1070p' task/evaluate_final.py; diff -u results/ideas/03_training_only_conformal_rank_scale_selection/program_0/src/program.py results/ideas/02_training_only_shrunk_local_moment_scale_correction/program_1/src/program.py | head -15; rg -n 'numpy|version|python' task/program_0/program_spec.toml; ls -l figures\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
