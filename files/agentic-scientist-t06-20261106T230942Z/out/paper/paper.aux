\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Attainable Disruption on the Observed Panels}{5}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Matched-budget finite-change results. Panels (a)--(c) show nominal costs of 0.1\%, 0.5\%, and 1\%. Markers are descriptive means over the three recorded seeds; the guided values coincide across seeds. Disruption is the percentage of participant-pair orderings changed after refitting. All controls have the same integer costs as the guided intervention. Sampling uncertainty is shown separately in Figure~\ref {fig:intervals}, not inferred from marker spacing.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:disruption}{{2}{6}{Matched-budget finite-change results. Panels (a)--(c) show nominal costs of 0.1\%, 0.5\%, and 1\%. Markers are descriptive means over the three recorded seeds; the guided values coincide across seeds. Disruption is the percentage of participant-pair orderings changed after refitting. All controls have the same integer costs as the guided intervention. Sampling uncertainty is shown separately in Figure~\ref {fig:intervals}, not inferred from marker spacing}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Paired Evidence Is Stronger on Arena Than Across NBA Seasons}{6}{subsection.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Nonlinearity, Repetition, and Missing Ablations}{6}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Stored fixed-plan paired percentile intervals, in percentage points, for budget-averaged disruption differences. Each horizontal segment is a recorded interval; no center is inferred or plotted. Line styles distinguish seeds. Zero is the no-difference reference. All Arena intervals favor guided refitting, while many NBA intervals cross zero. The intervals condition on selected interventions and fixed panels, use coarse grouped resampling, and are not multiplicity-adjusted.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:intervals}{{3}{7}{Stored fixed-plan paired percentile intervals, in percentage points, for budget-averaged disruption differences. Each horizontal segment is a recorded interval; no center is inferred or plotted. Line styles distinguish seeds. Zero is the no-difference reference. All Arena intervals favor guided refitting, while many NBA intervals cross zero. The intervals condition on selected interventions and fixed panels, use coarse grouped resampling, and are not multiplicity-adjusted}{figure.caption.6}{}}
