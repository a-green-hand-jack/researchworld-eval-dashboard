d in [\n        (\"sections_and_citations\", [\"python\", \".codex/skills/validate-paper/scripts/validate_tex_refs.py\", \"--tex\", \"paper.tex\", \"--bib\", \"references.bib\"]),\n        (\"claim_mapping_and_evidence\", [\"python\", \".codex/skills/write-paper-standalone/scripts/validate_claims.py\", \"--paper-data\", \"paper_data.json\", \"--references\", \"references_provenance.json\", \"--bib\", \"references.bib\", \"--claims\", \"claims_grounding.json\", \"--paper-dir\", \".\"]),\n        (\"canonical_figures\", [\"python\", \".codex/skills/validate-paper/scripts/validate_figures.py\", \"--paper-dir\", \".\"]),\n        (\"rendered_supplement\", [\"python\", \".codex/skills/validate-paper/scripts/validate_rendered_si.py\", \"--pdf\", \"paper.pdf\"]),\n        (\"canonical_compile_inputs\", [\"python\", \".codex/skills/validate-paper/scripts/validate_compile_inputs.py\", \"recorder\", \"--paper-dir\", \".\", \"--fls\", \"paper.fls\"]),\n    ]:\n        outcome = subprocess.run(command, cwd=ROOT, text=True, capture_output=True)\n        checks.append({\"name\": name, \"returncode\": outcome.returncode, \"output\": outcome.stdout + outcome.stderr})\n    manifest = json.loads((ROOT / \"figure_manifest.json\").read_text())\n    schema = json.loads((ROOT / \".codex/skills/validate-paper/templates/figure_manifest.schema.json\").read_text())\n    jsonschema.validate(manifest, schema)\n    strategy = json.loads((ROOT / \"paper_strategy.json\").read_text())\n    specs = {item[\"figure_id\"]: item for item in strategy[\"figure_specs\"]}\n    for figure in manifest[\"figures\"]:\n        spec = specs[figure[\"figure_id\"]]\n        assert figure[\"panel_count\"] <= spec[\"max_panels\"]\n        assert figure[\"panels_per_row\"] <= spec[\"max_panels_per_row\"]\n        assert figure[\"estimated_min_rendered_font_pt\"] >= spec[\"minimum_rendered_font_pt\"]\n        for panel in figure[\"panels\"]:\n            assert panel[\"category_count\"] <= spec[\"max_categories_per_panel\"]\n            assert panel[\"series_count\"] <= spec[\"max_series_per_panel\"]\n        for filename in figure[\"files\"].values():\n            assert (ROOT / filename).is_file()\n    checks.append({\"name\": \"local_figure_schema_density_and_files\", \"returncode\": 0,\n                   \"output\": \"Canonical JSON schema and strategy budgets pass; this is not the unavailable host figure validator.\"})\n    data = json.loads((ROOT / \"paper_data.json\").read_text())\n    assert data[\"final_evaluation\"][\"status\"] == \"completed\"\n    assert data[\"final_evaluation\"][\"outcome\"] == \"not_qualified\"\n    assert data[\"grounding_sources\"][\"final.qualification.correct\"][\"value\"] is False\n    evaluator = ROOT / \"source_evidence/task/evaluate_final.py\"\n    assert hashlib.sha256(evaluator.read_bytes()).hexdigest() == data[\"final_evaluation\"][\"evaluator_sha256\"].removeprefix(\"sha256:\")\n    for evidence_root in [data[\"best_correct\"], data[\"final_evaluation\"]]:\n        for episode in evidence_root[\"evaluation_evidence\"][\"episodes\"]:\n            for record in episode[\"solution\"][\"widths\"]:\n                if record is None:\n                    continue\n15:import jsonschema\n34:    schema = json.loads((ROOT / \".codex/skills/validate-paper/templates/figure_manifest.schema.json\").read_text())\n35:    jsonschema.validate(manifest, schema)\n40:        assert figure[\"panel_count\"] <= spec[\"max_panels\"]\n41:        assert figure[\"panels_per_row\"] <= spec[\"max_panels_per_row\"]\n42:        assert figure[\"estimated_min_rendered_font_pt\"] >= spec[\"minimum_rendered_font_pt\"]\n44:            assert panel[\"category_count\"] <= spec[\"max_categories_per_panel\"]\n45:            assert panel[\"series_count\"] <= spec[\"max_series_per_panel\"]\n47:            assert (ROOT / filename).is_file()\n48:    checks.append({\"name\": \"local_figure_schema_density_and_files\", \"returncode\": 0,\n49:                   \"output\": \"Canonical JSON schema and strategy budgets pass; this is not the unavailable host figure validator.\"})\n51:    assert data[\"final_evaluation\"][\"status\"] == \"completed\"\n52:    assert data[\"final_evaluation\"][\"outcome\"] == \"not_qualified\"\n53:    assert data[\"grounding_sources\"][\"final.qualification.correct\"][\"value\"] is False\n55:    assert hashlib.sha256(evaluator.read_bytes()).hexdigest() == data[\"final_evaluation\"][\"evaluator_sha256\"].removeprefix(\"sha256:\")\n61:                assert all(value[\"updates\"] == record[\"horizon\"] for value in record[\"arms\"].values())\n66:                        assert studied[key] == matched[key]\n68:                        assert {key: value for key, value in first.items() if key != \"wall_seconds\"} == {key: value for key, value in second.items() if key != \"wall_seconds\"}\n73:        assert (ROOT / \"derived\" / table_name).read_text().strip() in manuscript\n77:    assert supplement_page > reference_page\n78:    assert 8 <= reference_page <= 9\n88:        assert span_fraction >= .75\n91:        assert not re.search(r\"\\b\" + re.escape(forbidden) + r\"\\b\", body_text, re.IGNORECASE), forbidden\n92:    assert \"??\" not in \"\\n\".join(page.get_text() for page in document)\n96:    concept_pending = not bool(json.loads((ROOT / \"figures/study_overview.prompts.json\").read_text()))\n97:    report = {\n112:        \"orchestrator_pending\": [\"study_overview rendering replaces guarded placeholder\"] if concept_pending else [],\n116:    (ROOT / \"validation_report.json\").write_text(json.dumps(report, indent=2) + \"\\n\")\n117:    provenance = {\"schema_name\": \"scientific-evidence.artifact-manifest\",\n124:                      \"references\": reference_count, \"status\": report[\"status\"]}, indent=2))\n\"\"\"Build an explicit claim map without extending the host evidence registry.\"\"\"\n\nimport json\nfrom pathlib import Path\n\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef main():\n    claims = []\n\n    def add(text, source_ids, refs, keys=None, scope=None):\n        record = {\"claim\": text, \"source_ids\": source_ids, \"citation_keys\": keys or [], \"evidence_refs\": refs}\n        if scope:\n            record[\"source_scope_note\"] = scope\n        claims.append(record)\n\n    final = [\"final.evidence.episodes\"]\n    final_ref = [\"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"]\n    development = [\"result.top_program_01\"]\n    development_ref = [\"paper_data.json#/best_correct/evaluation_evidence/episodes\"]\n    selection_note = \"The registry ID identifies the selected configuration only; it does not substantiate the scientific numbers. The raw evidence_refs, not the selection score, support this claim.\"\n    add(\"The final evaluation completed, did not qualify, and has a false qualification decision; the supplied diagnostics do not identify the cause.\",\n        [\"final.qualification.status\", \"final.qualification.outcome\", \"final.qualification.correct\"],\n        [\"paper_data.json#/final_evaluation\", \"paper_data.json#/grounding_sources/final.qualification.outcome\"])\n    add(\"Five of nine planned final width-seed records are retained, with coverage 3/2/0 at widths 32/128/256; absent records are not measured non-events or accuracy losses.\",\n        final + [\"final.metric.complete_episode_fraction\"], final_ref)\n    add(\"The two retained width-128 studied final records show delayed events; all three width-32 held-out onsets are right-censored at 24000 updates.\", final, final_ref)\n    add(\"Development fitting onsets in seed order 101/211 are 2200/2800 at width32, 300/300 at width128, and 200/200 at width256.\",\n        development, development_ref, scope=selection_note)\n    add(\"Development widest-minus-narrowest paired fit differences are -2000 and -2600 updates; fitting is earlier but endpoint accuracy is nonmonotone in width in both retained seeds.\",\n        development, development_ref + [\"derived/summary.json#/paired/development_256_minus_32\"], scope=selection_note)\n    add(\"Development studied endpoint means plus sample SD are 74.68+/-4.47, 29.33+/-3.68, and 39.35+/-3.49 percent at widths32/128/256, over two seeds each.\",\n        development, development_ref + [\"derived/summary.json#/cells\"], scope=selection_note)\n# Reproducibility and evidence boundaries\n\nThe manuscript reports existing observations only. It does not rerun training or\nthe sealed evaluation. Scientific qualification is **failed**, independently of\nthe manuscript's compilation or production status; its specific cause is unknown.\nThe read-only `paper_data.json` remains the authoritative observation registry.\n\n## Supplied code and data\n\n- `source_evidence/task/evaluate.py`: original development evaluator.\n- `source_evidence/task/evaluate_final.py`: final evaluator, with a SHA-256 that\n  matches `paper_data.json.final_evaluation.evaluator_sha256`.\n- `source_evidence/task/capture.py`: evaluator subprocess capture dependency.\n- `source_evidence/controllers/studied/`: inspected common configuration.\n- `source_evidence/controllers/larger_init/` and `faster_update/`: sensitivity settings.\n- `source_evidence/task/resources/{search,final}/dataset.json`: exact synthetic\n  input/label pools, split indices, seeds, and split digests. No dataset download\n  or third-party data version is involved. The two resources have disjoint inputs.\n- `derived/source_manifest.json`: hashes of inspectable source snapshots.\n\nHashes locate source; readable code supports implementation claims. The controller\nsettings agree with retained evidence, but no independent reconstruction of the\nentire frozen candidate tree is claimed.\n\n## Analysis-only reproduction\n\nUse a private environment outside the paper directory:\n\n23:\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n48:\\textheight 9.0 true in       % Height of text (including footnotes & figures)\n49:\\textwidth 5.5 true in        % Width of text line.\n83:\\def\\@maketitle{\\vbox{\\hsize\\textwidth\n215:\\textheight=#5\\vbadness=10000\\vfuzz=120ex\\overfullrule=0pt%\n216:\\global\\setbox\\iclrrulerbox=\\vbox to \\textheight{%\n217:{\\parskip=0pt\\hfuzz=150em\\cv@boxheight=\\textheight\n229:\\def\\iclrruler#1{\\makevruler[12pt][#1][1][3][0.993\\textheight]\\usebox{\\iclrrulerbox}}\n232:\\iclrruleroffset=\\textheight\n245:% \\colorbox[rgb]{0.7,0.7,0.7}{\\small \\parbox[b][\\textheight]{0.1cm}{}}}\n","exit_code":0,"status":"completed"}}
