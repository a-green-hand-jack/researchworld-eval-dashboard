{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/evaluation/capture.py | sed -n '1,165p'\"","aggregated_output":"     1\t\"\"\"Safe output-capture compatibility and reproducible public-data acquisition.\n     2\t\n     3\tImporting this module performs no capture, I/O or network access. To recapture:\n     4\tpython capture.py --source_dir /tmp/public-source --output_root /tmp/new-resources\n     5\tThe source directory must contain german.zip, ca.zip, ny.zip, acs.py,\n     6\tfolktables-LICENSE, census-site-policy.html, census-terms.html,\n     7\tdictionary2024.pdf and relshipp2024.json obtained from\n     8\texact URLs recorded in each frozen provenance.json. Acquisition is drafting-only.\n     9\t\"\"\"\n    10\timport contextlib\n    11\timport csv\n    12\timport decimal\n    13\timport gzip\n    14\timport hashlib\n    15\timport io\n    16\timport json\n    17\tfrom pathlib import Path\n    18\timport unicodedata\n    19\timport zipfile\n    20\t\n    21\t\n    22\tclass OutputCapture:\n    23\t    def __init__(self):\n    24\t        self.stdout = io.StringIO()\n    25\t        self.stderr = io.StringIO()\n    26\t        self._stack = None\n    27\t\n    28\t    def __enter__(self):\n    29\t        self._stack = contextlib.ExitStack()\n    30\t        self._stack.enter_context(contextlib.redirect_stdout(self.stdout))\n    31\t        self._stack.enter_context(contextlib.redirect_stderr(self.stderr))\n    32\t        return self\n    33\t\n    34\t    def __exit__(self, exc_type, exc_value, traceback):\n    35\t        return self._stack.__exit__(exc_type, exc_value, traceback)\n    36\t\n    37\t    def get_output(self):\n    38\t        return self.stdout.getvalue(), self.stderr.getvalue()\n    39\t\n    40\t\n    41\tdef encode(value):\n    42\t    return json.dumps(value,ensure_ascii=False,allow_nan=False,separators=(',',':'),sort_keys=True).encode('utf-8')\n    43\t\n    44\t\n    45\tdef digest(value):\n    46\t    return hashlib.sha256(encode(value)).hexdigest()\n    47\t\n    48\t\n    49\tdef number(value):\n    50\t    if value is None or not str(value).strip():\n    51\t        return None\n    52\t    numeric = decimal.Decimal(str(value).strip())\n    53\t    if not numeric.is_finite():\n    54\t        return None\n    55\t    return '0' if numeric == 0 else format(numeric.normalize(),'f')\n    56\t\n    57\t\n    58\tdef normalize(row, numeric):\n    59\t    return [None if value is None or not str(value).strip() else\n    60\t            ['number',number(value)] if index in numeric else\n    61\t            ['text',' '.join(unicodedata.normalize('NFKC',str(value)).split())]\n    62\t            for index,value in enumerate(row)]\n    63\t\n    64\t\n    65\tdef partition(groups, salt, limit=None):\n    66\t    ordered = sorted(groups,key=lambda item:hashlib.sha256((salt+item['content_sha256']).encode()).digest())\n    67\t    if limit is not None:\n    68\t        ordered = ordered[:limit]\n    69\t    count = len(ordered)\n    70\t    for index,record in enumerate(ordered):\n    71\t        record['role'] = 'train' if index < int(.6*count) else 'validation' if index < int(.8*count) else 'explanation'\n    72\t    return ordered\n    73\t\n    74\t\n    75\tdef acquire(source, output):\n    76\t    numeric_german = {1,4,7,10,12,15,17}\n    77\t    with zipfile.ZipFile(source/'german.zip') as archive:\n    78\t        rows = archive.read('german.data').decode().splitlines()\n    79\t    grouped = {}\n    80\t    for index,line in enumerate(rows):\n    81\t        tokens = line.split()\n    82\t        normalized = normalize(tokens[:-1],numeric_german)\n    83\t        content = digest(normalized)\n    84\t        provenance = {'row':index+1,'source_id':f'uci144:{index+1}','full_record_sha256':digest(tokens)}\n    85\t        if content not in grouped:\n    86\t            grouped[content] = {'raw':tokens[:-1],'y':int(tokens[-1]) == 2,'content_sha256':content,'provenance':[],'conflicting_labels':False}\n    87\t        record = grouped[content]\n    88\t        record['conflicting_labels'] |= record['y'] != (int(tokens[-1]) == 2)\n    89\t        record['provenance'].append(provenance)\n    90\t    all_german = sorted(grouped.values(),key=lambda item:hashlib.sha256(('german-plane-2026'+item['content_sha256']).encode()).digest())\n    91\t    midpoint = len(all_german)//2\n    92\t    german = {'search':partition(all_german[:midpoint],'german-within-2026'),\n    93\t              'final':partition(all_german[midpoint:],'german-within-2026')}\n    94\t    features = ['AGEP','COW','SCHL','MAR','OCCP','POBP','RELSHIPP','WKHP','SEX','RAC1P']\n    95\t    populations = {}\n    96\t    raw_hashes = {}\n    97\t    stats = {}\n    98\t    for plane,state in [('search','ca'),('final','ny')]:\n    99\t        groups = {}\n   100\t        seen = set()\n   101\t        total = 0\n   102\t        included = 0\n   103\t        with zipfile.ZipFile(source/f'{state}.zip') as archive:\n   104\t            members = sorted(name for name in archive.namelist() if name.lower().endswith('.csv'))\n   105\t            for member in members:\n   106\t                with archive.open(member) as stream:\n   107\t                    reader = csv.DictReader(io.TextIOWrapper(stream,encoding='utf-8-sig',newline=''))\n   108\t                    for index,row in enumerate(reader):\n   109\t                        total += 1\n   110\t                        raw = [row[name] for name in features]\n   111\t                        content = digest(normalize(raw,set(range(10))))\n   112\t                        seen.add(content)\n   113\t                        allowed = all(number(row[key]) is not None for key in ['AGEP','PINCP','WKHP','PWGTP']) and decimal.Decimal(row['AGEP']) > 16 and decimal.Decimal(row['PINCP']) > 100 and decimal.Decimal(row['WKHP']) > 0 and decimal.Decimal(row['PWGTP']) >= 1\n   114\t                        if not allowed:\n   115\t                            continue\n   116\t                        included += 1\n   117\t                        label = decimal.Decimal(row['PINCP']) > 50000\n   118\t                        if content not in groups:\n   119\t                            groups[content] = {'raw':raw,'y':label,'content_sha256':content,'provenance':[],'conflicting_labels':False}\n   120\t                        record = groups[content]\n   121\t                        record['conflicting_labels'] |= record['y'] != label\n   122\t                        record['provenance'].append({'row':index+1,'member':member,'source_id':f'{row[\"SERIALNO\"]}:{row[\"SPORDER\"]}',\n   123\t                                                     'population_filter':True,'full_record_sha256':digest(row)})\n   124\t        populations[plane] = groups\n   125\t        raw_hashes[plane] = seen\n   126\t        stats[plane] = {'raw_records':total,'population_records':included,'unique_population_predictors':len(groups)}\n   127\t    overlap = raw_hashes['search'] & raw_hashes['final']\n   128\t    for plane in ('search','final'):\n   129\t        groups = [record for content,record in populations[plane].items() if content not in overlap]\n   130\t        populations[plane] = partition(groups,'acs-within-2026',33334)\n   131\t    all_search = {record['content_sha256'] for record in german['search']+populations['search']}\n   132\t    all_final = {record['content_sha256'] for record in german['final']+populations['final']}\n   133\t    if all_search & all_final:\n   134\t        raise ValueError('normalized predictor overlap')\n   135\t    metadata = {\n   136\t        'normalization':'Before population filtering, splitting or preprocessing: fixed original predictor order; numeric Decimal canonical finite decimal strings, all zeros canonical 0; categorical Unicode NFKC with split/join whitespace; null sentinel; typed canonical sorted compact UTF-8 JSON. IDs, labels and provenance excluded from content hash. Full records separately hashed.',\n   137\t        'split':'Deterministic SHA256 ordering salts german-plane-2026, german-within-2026, acs-within-2026. German content groups 50:50 planes, then 60:20:20; ACS excludes ALL CA/NY raw predictor overlaps before selection of 33334 content groups/state and 60:20:20. One representative/group, duplicate and conflicting-label provenance retained.',\n   138\t        'excluded_cross_state_raw_content_groups':len(overlap),\n   139\t        'cross_plane_retained_content_intersection':0,\n   140\t        'folktables_revision':'ebace19d8065efc43589f0067bf183398eb156b9',\n   141\t        'explicit_2024_schema_adapter':'The supplied folktables commit names RELP, absent from actual 2024 CA/NY releases. Use native RELSHIPP as the original relationship feature group, without fabricating an old-code crosswalk. Keep the other nine predictors, official adult filter and PINCP>50000 target unchanged. Report this as ACSIncome-2024-RELSHIPP, not bit-identical old ACSIncome.',\n   142\t        'sources':[\n   143\t            {'file':'german.zip','url':'https://archive.ics.uci.edu/static/public/144/statlog+german+credit+data.zip','license':'CC BY 4.0; UCI DOI 10.24432/C5NC77'},\n   144\t            {'file':'ca.zip','url':'https://www2.census.gov/programs-surveys/acs/data/pums/2024/1-Year/csv_pca.zip','last_modified':'2025-12-04T12:00:07Z','license':'US government public data; Census copyright terms archived'},\n   145\t            {'file':'ny.zip','url':'https://www2.census.gov/programs-surveys/acs/data/pums/2024/1-Year/csv_pny.zip','last_modified':'2025-12-04T12:00:09Z','license':'US government public data; no separate SPDX license assigned'},\n   146\t            {'file':'acs.py','url':'https://raw.githubusercontent.com/socialfoundations/folktables/ebace19d8065efc43589f0067bf183398eb156b9/folktables/acs.py','license':'MIT'},\n   147\t            {'file':'folktables-LICENSE','url':'https://raw.githubusercontent.com/socialfoundations/folktables/ebace19d8065efc43589f0067bf183398eb156b9/LICENSE.txt','license':'MIT'},\n   148\t            {'file':'census-site-policy.html','url':'https://www.census.gov/about/policies/privacy.html','license':'Census site policy, no separate SPDX license assigned'},\n   149\t            {'file':'census-terms.html','url':'https://www.census.gov/about/policies/privacy/privacy-policy.html','license':'Census privacy policy, no separate SPDX license assigned'},\n   150\t            {'file':'dictionary2024.pdf','url':'https://www2.census.gov/programs-surveys/acs/tech_docs/pums/data_dict/PUMS_Data_Dictionary_2024.pdf','license':'US government technical documentation'},\n   151\t            {'file':'relshipp2024.json','url':'https://api.census.gov/data/2024/acs/acs1/pums/variables/RELSHIPP.json','license':'US government variable metadata'}],\n   152\t        'limitations':['Raw release archives retained by URL and digest, not duplicated in runtime. Frozen selected raw predictor records suffice for offline evaluation. Official conference template, independent source review, full statistical inference and paper remain downstream obligations. No prohibited literature was queried.']}\n   153\t    for item in metadata['sources']:\n   154\t        item['sha256'] = hashlib.sha256((source/item['file']).read_bytes()).hexdigest()\n   155\t    for plane in ('search','final'):\n   156\t        root = output/plane\n   157\t        root.mkdir(parents=True,exist_ok=True)\n   158\t        for name,records,numeric in [('german',german[plane],numeric_german),('acs',populations[plane],set(range(10)))]:\n   159\t            payload = {'name':name,'features':features if name=='acs' else [f'attribute_{index+1}' for index in range(20)],'numeric':sorted(numeric),'records':records}\n   160\t            with (root/f'{name}.json.gz').open('wb') as stream:\n   161\t                with gzip.GzipFile(fileobj=stream,mode='wb',mtime=0) as compressed:\n   162\t                    compressed.write(encode(payload))\n   163\t        provenance = dict(metadata)\n   164\t        provenance['population_counts'] = stats[plane]\n   165\t        provenance['retained_counts'] = {'german':len(german[plane]),'acs':len(populations[plane])}\n","exit_code":0,"status":"completed"}}
