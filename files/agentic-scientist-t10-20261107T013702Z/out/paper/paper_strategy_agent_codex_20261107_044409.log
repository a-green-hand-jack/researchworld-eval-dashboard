ication.status', 'result.best_any_score', 'result.best_correct_score', 'result.improvement_001', 'result.top_program_01', 'result.total_attempts', 'result.total_correct_programs', 'result.total_evaluated_programs', 'result.total_ideas']\nidea_titles list 3\nimprovement_trace list 1\npaper_profile str standalone\npresentation_contract dict ['forbidden_visible_terms', 'internal_fields', 'preferred_terms', 'run_unit', 'threshold_rate_rule', 'variant_unit']\nresults_dir str <WORKTREES>/experiment/.project/runs/agentic-scientist-t10-202611\ntop_programs list 1\ntotals dict ['attempts', 'correct_programs', 'evaluated_programs', 'ideas']\n\nGROUNDING {\n  \"final.evidence.episodes\": {\n    \"candidate_diagnostics_trust\": \"unverified\",\n    \"episode_count\": 256,\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.evidence.episodes\",\n    \"json_pointer\": \"/episodes\",\n    \"manifest_path\": \"work/results/t10/codex/20261107_014149/final_evaluation/final_manifest.json\",\n    \"path\": \"work/results/t10/codex/20261107_014149/final_evaluation/results/evaluation_evidence.json\",\n    \"program_tree_sha256\": \"sha256:980ddc8e93b7f07cab282a238d5934762740a6ace7b280c34d278de79a94c00b\",\n    \"results_tree_sha256\": \"sha256:3e3e28257a86eea7abe1bb58e9e2b3e125afb7bee8b4a5ae9b11a1bdb234df2c\",\n    \"sha256\": \"sha256:94e3af7d21a2cd42b86ec4ce762827b81355177a2df306b374a76537d58cf943\",\n    \"type\": \"evaluation_evidence\"\n  },\n  \"final.metric.combined_score\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.metric.combined_score\",\n    \"manifest_path\": \"work/results/t10/codex/20261107_014149/final_evaluation/final_manifest.json\",\n    \"results_tree_sha256\": \"sha256:3e3e28257a86eea7abe1bb58e9e2b3e125afb7bee8b4a5ae9b11a1bdb234df2c\",\n    \"type\": \"metric\",\n    \"value\": 0.8701122015120599\n  },\n  \"final.metric.control_pass_rate\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.metric.control_pass_r