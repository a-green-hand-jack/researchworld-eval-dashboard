version', 'canonical_task', 'method', 'candidate', 'evaluators', 'resources', 'data', 'metrics', 'upstream', 'provenance', 'compute', 'protocol', 'feedback', 'publication']\nschema_version 1\ncanonical_task {\"path\": \"task.md\", \"sha256\": \"cc6f216a9f0111535c115fb20d90b3f79d506877fa76cdb3d1d405a50fa01e01\"}\nmethod {\"class\": \"Single-run reliability diagnostic for stochastic Kernel SHAP on tabular classifiers\", \"description\": \"The evaluator owns datasets, model training (logistic regression, random forest, sklearn MLP), an interventional Kernel SHAP sampler with a fixed 32-row background and a coalition budget of 4*d or 16*d per run, and the label: the mean top-3 Jaccard agreement between the assessed run and 8 independent evaluator-run reruns. The candidate receives ONE assessed run per explained instance (bit-packed coalition masks, regression weights, evaluator-computed coalition values, anchors) through handle(diagnose) and returns r_hat in [0,1] predicting that agreement. Scored by squared error against labels, always-reliable (1.0), constant 0.5 and split-half-gap baselines and a label-permuted-pairing control (20 deterministic derangements). Bounded claim only: Kernel SHAP, 3 model families, the declared datasets, budgets, k=3, background 32; no deep tabular models or other explainers.\"}\ncandidate {\"interface\": \"python_rpc_v1:handle\", \"editable_paths\": [\"program_0/src\"]}\nevaluators {\"search\": \"evaluate.py\", \"final\": \"evaluate_final.py\"}\nresources {\"search_root\": \"resources/search\", \"final_root\": \"resources/final\", \"public_artifact_bundle\": null}\ndata {\"search_roles\": [\"search_tabular_datasets\"], \"final_roles\": [\"final_tabular_datasets\"]}\nupstream [{\"repository\": \"https://github.com/socialfoundations/folktables\", \"revision\": \"ebace19d8065efc43589f0067bf183398eb156b9\", \"package_version\": \"0.0.12\", \"license\": \"MIT (code); ACS PUMS data is US Census Bureau public data without a separate license text\", \"entrypoints\": [\"folktables.ACSDataSource(survey_year='2018', horizon='1-Year', survey='person').get_data(states=['CA'], download=True)\", \"folktables.ACSIncome.df_to_pandas\"], \"patches\": []}, {\"repository\": \"https://archive.ics.uci.edu/dataset/144/statlog+german+credit+data\", \"revision\": \"UCI dataset 144 (DOI 10.24432/C5NC77), page last updated 2023-08-10; german.zip sha256 e12d9d5def6845c0622634a1cd2ab87fa470668c4298f1ec52a4e403376a435b\", \"package_version\": null, \"license\": \"CC BY 4.0 (UCI page declaration)\", \"entrypoints\": [\"german.data (1000 rows x 20 attributes + class), fetched once at scaffold time\"], \"patches\": []}, {\"repository\": \"https://www.openml.org/d/37\", \"revision\": \"OpenML data_id 37 (diabetes), version 1, uploaded 2014-04-06; diabetes.arff.gz sha256 fb636382eebd32e0bdff703297be03328a3bd59c4e032b93dd8bfc5a0c92961b\", \"package_version\": null, \"license\": \"OpenML record licence: Public\", \"entrypoints\": [\"sklearn.datasets.fetch_openml(data_id=37) executed at scaffold time only\"], \"patches\": []}, {\"repository\": \"https://www.openml.org/d/46929\", \"revision\": \"OpenML data_id 46929 (Give Me Some Credit, TabArena version), version 1, uploaded 2025-04-30; GiveMeSomeCredit.arff.gz sha256 0afec5ab3401924314ff280913bc3a0dafb\nprovenance {\"dependencies\": [{\"name\": \"numpy\", \"version\": \"2.5.4\"}, {\"name\": \"pandas\", \"version\": \"3.1.1\"}, {\"name\": \"scikit-learn\", \"version\": \"1.9.1\"}, {\"name\": \"scipy\", \"version\": \"1.18.1\"}], \"artifacts\": [{\"role\": \"search_data_pima\", \"path\": \"resources/search/pima_diabetes.csv\", \"sha256\": \"254762120aa282cf82bc8d04a092d2a95a04e89b52f2504354217016b816ae08\", \"source\": \"OpenML data_id 37 version 1 (diabetes.arff.gz sha256 fb636382eebd32e0bdff703297be03328a3bd59c4e032b93dd8bfc5a0c92961b), normalized and de-duplicated at scaffold time 2026-11-11\"}, {\"role\": \"search_data_german_credit_a\", \"path\": \"resources/search/german_credit_partitionA.csv\", \"sha256\": \"a474b4b347642eac84efe7c85667d0dfd3275ff2b993ae5346242abb91506a2c\", \"source\": \"UCI Statlog German Credit (german.zip sha256 e12d9d5def6845c0622634a1cd2ab87fa470668c4298f1ec52a4e403376a435b; german.data sha256 b21f3d81db8071257d5ff1deaeba1fd4303b62712e6fcc9715c7a86202cb5871), partition A = int(record_sha256,16) % 2 == 0\"}, {\"role\": \"search_manifest\", \"path\": \"resources/search/manifest.json\", \"sha256\": \"c608e55c52298c5216cb2aa637aee85b4b05ba54750e0b41ecb36dd07224ec71\", \"source\": \"scaffold-time manifest: per-dataset row counts, normalized record-hash set digests, normalization rule, cross-plane intersection count 0\"}, {\"role\": \"final_data_acs_income\", \"path\": \"resources/final/acs_income_ca2018_sample.csv\", \"sha256\": \"888f45de4a325bd2b3f66e0799defc1c4aeb527ef27d47d52e91ec11549e1b87\", \"source\": \"folktables 0.0.12 ACSIncome, ACS PUMS 2018 1-Year\ncompute {\"search\": {\"accelerator\": \"cpu\", \"accelerator_model\": \"none\", \"gpu_count\": 0, \"evaluator_gpu_count\": 0, \"candidate_gpu_count\": 0, \"cpu_cores\": 8, \"memory_gb\": 16, \"precision\": \"float64\", \"wall_clock_seconds\": 2700, \"max_candidate_rpc_calls\": 50}, \"final\": {\"accelerator\": \"cpu\", \"accelerator_model\": \"none\", \"gpu_count\": 0, \"evaluator_gpu_count\": 0, \"candidate_gpu_count\": 0, \"cpu_cores\": 8, \"memory_gb\": 16, \"precision\": \"float64\", \"wall_clock_seconds\": 4500, \"max_candidate_rpc_calls\": 74}}\nprotocol {\"search_seeds\": [101, 102], \"final_seeds\": [9001, 9002], \"search_reset_sequence\": [101, 101, 101, 101, 101, 101, 101, 101, 101, 101, 101, 101, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102, 102], \"search_smoke_reset_sequence\": [101, 101], \"final_reset_sequence\": [9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9001, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002, 9002], \"final_smoke_r