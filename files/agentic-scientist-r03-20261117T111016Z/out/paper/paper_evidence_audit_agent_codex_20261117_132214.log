{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"sed -n '75,110p' source_evidence/selected/src/program.py; nl -ba source_evidence/selected/src/program.py | sed -n '198,315p'\"","aggregated_output":"def _condition_base(model, selected_indices, observed_scores):\n    factors, means = model['factors'], model['means']\n    design = factors[selected_indices]\n    latent = np.linalg.solve(model['ridge'] * np.eye(factors.shape[1]) + design.T @ design,\n                             design.T @ (np.asarray(observed_scores) - means[selected_indices]))\n    return np.clip(means + factors @ latent, 0, 1)\n\n\ndef _policy_index(model, selected_indices, available):\n    factors = model['factors']\n    covariance = np.linalg.inv(model['ridge'] * np.eye(factors.shape[1])\n                               + factors[selected_indices].T @ factors[selected_indices])\n    cross = factors @ covariance @ factors[available].T\n    denominator = 1 + np.sum((factors[available] @ covariance) * factors[available], axis=1)\n    gains = np.sum(cross * cross, axis=0) / denominator\n    return int(available[int(np.argmax(gains))])\n\n\ndef _donor_predictions(model, donor_scores, selected_indices):\n    predictions = np.broadcast_to(model['means'], donor_scores.shape).copy()\n    anchor_scores = donor_scores[:, selected_indices]\n    anchor_mask = np.isfinite(anchor_scores)\n    patterns, pattern_ids = np.unique(anchor_mask, axis=0, return_inverse=True)\n    for pattern_index, pattern in enumerate(patterns):\n        donor_indices = np.flatnonzero(pattern_ids == pattern_index)\n        if not pattern.any():\n            continue\n        anchors = np.asarray(selected_indices, dtype=int)[pattern]\n        design = model['factors'][anchors]\n        responses = anchor_scores[donor_indices][:, pattern] - model['means'][anchors]\n        latent = np.linalg.solve(model['ridge'] * np.eye(design.shape[1]) + design.T @ design,\n                                 design.T @ responses.T)\n        predictions[donor_indices] += latent.T @ model['factors'].T\n    return np.clip(predictions, 0, 1)\n\n\n   198\tdef _prepare_residual_correction(values, mask, rank, ridge, sweeps, seed):\n   199\t    \"\"\"Bounded nested historical calibration; never receives a new-model score.\n   200\t\n   201\t    Predeclared local grid: bandwidth (.35, .75, 1.5), shrinkage (4, 16),\n   202\t    blend (0, .25, .5, 1). At most 512 rows / approximately 196608 cells,\n   203\t    128 donors, 16 validation rows, two outer folds and two donor folds.\n   204\t    Auxiliary ALS fits use at most 12 sweeps; the incumbent fit is untouched.\n   205\t    Validation compares all methods on the same finite unqueried cells at\n   206\t    budgets 1, 2, 4, 8. Diagnostic results are private, not RPC extensions.\n   207\t    \"\"\"\n   208\t    candidate_blends = (0.0, 0.25, 0.5, 1.0)\n   209\t    candidate_bandwidths = (0.35, 0.75, 1.5)\n   210\t    candidate_shrinkages = (4.0, 16.0)\n   211\t    inactive = dict(bank=None, blend=0.0, bandwidth=0.75, shrinkage=16.0, diagnostics={})\n   212\t    if values.shape[0] < 12 or values.shape[1] < 2:\n   213\t        return inactive\n   214\t    rng = np.random.default_rng(np.random.SeedSequence([seed, 391939]))\n   215\t    row_limit = min(512, max(64, 196608 // values.shape[1]))\n   216\t    pool_rows = rng.permutation(values.shape[0])[:row_limit]\n   217\t    eligible = pool_rows[mask[pool_rows].sum(axis=1) >= 3]\n   218\t    validation_count = min(16, eligible.size, max(2, pool_rows.size // 4))\n   219\t    if validation_count < 4:\n   220\t        return inactive\n   221\t    validation_rows = eligible[:validation_count]\n   222\t    auxiliary_sweeps = min(sweeps, 12)\n   223\t    error_sums = np.zeros((len(candidate_bandwidths), len(candidate_shrinkages), len(candidate_blends)))\n   224\t    unconditional_errors = np.zeros((len(candidate_shrinkages), len(candidate_blends)))\n   225\t    direct_errors = np.zeros(len(candidate_bandwidths))\n   226\t    base_error, target_count = 0.0, 0\n   227\t    coverage_sum, effective_sum = np.zeros(len(candidate_bandwidths)), np.zeros(len(candidate_bandwidths))\n   228\t    for inner_validation_rows in np.array_split(validation_rows, 2):\n   229\t        fit_rows = np.setdiff1d(pool_rows, inner_validation_rows)\n   230\t        assert np.intersect1d(inner_validation_rows, fit_rows).size == 0\n   231\t        model = _fit_residual_base(values[fit_rows], mask[fit_rows], rank, ridge, auxiliary_sweeps, rng)\n   232\t        bank = _build_residual_bank(values, mask, fit_rows, inner_validation_rows,\n   233\t                                    rank, ridge, auxiliary_sweeps, rng)\n   234\t        if bank is None:\n   235\t            return inactive\n   236\t        for validation_row in inner_validation_rows:\n   237\t            available = np.flatnonzero(mask[validation_row]).tolist()\n   238\t            selected_indices, observed_scores = [], []\n   239\t            for query_count in range(1, min(8, len(available) - 1) + 1):\n   240\t                remaining = [index for index in available if index not in selected_indices]\n   241\t                chosen = _policy_index(model, selected_indices, remaining)\n   242\t                selected_indices.append(chosen)\n   243\t                observed_scores.append(float(values[validation_row, chosen]))\n   244\t                if query_count not in (1, 2, 4, 8):\n   245\t                    continue\n   246\t                targets = mask[validation_row].copy()\n   247\t                targets[selected_indices] = False\n   248\t                truth = values[validation_row, targets]\n   249\t                base_prediction = _condition_base(model, selected_indices, observed_scores)\n   250\t                base_error += np.abs(base_prediction[targets] - truth).sum()\n   251\t                target_count += truth.size\n   252\t                donor_residuals = _bank_residuals(bank, selected_indices)\n   253\t                unconditional_median, unconditional_count = _residual_summaries(\n   254\t                    donor_residuals, np.ones(donor_residuals.shape[0]))\n   255\t                for shrinkage_index, shrinkage_strength in enumerate(candidate_shrinkages):\n   256\t                    delta = unconditional_median * unconditional_count / (unconditional_count + shrinkage_strength)\n   257\t                    for blend_index, blend in enumerate(candidate_blends):\n   258\t                        prediction = np.clip(base_prediction + blend * delta, 0, 1)\n   259\t                        unconditional_errors[shrinkage_index, blend_index] += np.abs(prediction[targets] - truth).sum()\n   260\t                for bandwidth_index, bandwidth in enumerate(candidate_bandwidths):\n   261\t                    neighbor_weights = _bank_weights(bank, selected_indices, np.asarray(observed_scores), bandwidth)\n   262\t                    medians, effective_counts = _residual_summaries(donor_residuals, neighbor_weights)\n   263\t                    coverage_sum[bandwidth_index] += np.count_nonzero(effective_counts[targets])\n   264\t                    effective_sum[bandwidth_index] += effective_counts[targets].sum()\n   265\t                    direct_median, direct_count = _residual_summaries(bank['scores'], neighbor_weights)\n   266\t                    direct_prediction = np.where(direct_count > 0, direct_median, base_prediction)\n   267\t                    direct_errors[bandwidth_index] += np.abs(direct_prediction[targets] - truth).sum()\n   268\t                    for shrinkage_index, shrinkage_strength in enumerate(candidate_shrinkages):\n   269\t                        delta = medians * effective_counts / (effective_counts + shrinkage_strength)\n   270\t                        for blend_index, blend in enumerate(candidate_blends):\n   271\t                            prediction = np.clip(base_prediction + blend * delta, 0, 1)\n   272\t                            error_sums[bandwidth_index, shrinkage_index, blend_index] += np.abs(\n   273\t                                prediction[targets] - truth).sum()\n   274\t    if target_count == 0:\n   275\t        return inactive\n   276\t    inner_mae = np.full(len(candidate_blends), np.inf)\n   277\t    best_parameters = [(0.75, 16.0)] * len(candidate_blends)\n   278\t    for bandwidth_index, bandwidth in enumerate(candidate_bandwidths):\n   279\t        for shrinkage_index, shrinkage_strength in enumerate(candidate_shrinkages):\n   280\t            errors = error_sums[bandwidth_index, shrinkage_index] / target_count\n   281\t            for blend_index, error in enumerate(errors):\n   282\t                if error < inner_mae[blend_index]:\n   283\t                    inner_mae[blend_index] = error\n   284\t                    best_parameters[blend_index] = (bandwidth, shrinkage_strength)\n   285\t    inner_mae[0] = base_error / target_count\n   286\t    inner_mae[np.abs(inner_mae - inner_mae[0]) <= 1e-12] = inner_mae[0]\n   287\t    blend_strength = candidate_blends[int(np.argmin(inner_mae))]\n   288\t    bandwidth, shrinkage_strength = best_parameters[int(np.argmin(inner_mae))]\n   289\t    diagnostics = dict(base_mae=base_error / target_count, local_mae=inner_mae.tolist(),\n   290\t                       unconditional_mae=(unconditional_errors / target_count).tolist(),\n   291\t                       direct_mae=(direct_errors / target_count).tolist(), target_count=target_count,\n   292\t                       coverage=(coverage_sum / target_count).tolist(),\n   293\t                       effective_counts=(effective_sum / target_count).tolist(),\n   294\t                       validation_rows=validation_count, auxiliary_rows=pool_rows.size)\n   295\t    bank = None\n   296\t    if blend_strength > 0:\n   297\t        bank = _build_residual_bank(values, mask, pool_rows, np.array([], dtype=int),\n   298\t                                    rank, ridge, auxiliary_sweeps, rng)\n   299\t    return dict(bank=bank, blend=blend_strength, bandwidth=bandwidth,\n   300\t                shrinkage=shrinkage_strength, diagnostics=diagnostics)\n   301\t\n   302\t\n   303\tdef _apply_residual_correction(base_prediction, selected_indices, observed_scores, correction):\n   304\t    if not selected_indices or correction['blend'] == 0.0 or correction['bank'] is None:\n   305\t        return base_prediction\n   306\t    bank = correction['bank']\n   307\t    donor_residuals = _bank_residuals(bank, selected_indices)\n   308\t    neighbor_weights = _bank_weights(bank, selected_indices, np.asarray(observed_scores), correction['bandwidth'])\n   309\t    predictions = base_prediction.copy()\n   310\t    selected = set(selected_indices)\n   311\t    for target in range(predictions.size):\n   312\t        if target in selected:\n   313\t            continue\n   314\t        usable = np.isfinite(donor_residuals[:, target]) & (neighbor_weights > 0)\n   315\t        predictions[target] = _correct_target(base_prediction[target], donor_residuals[usable, target],\n","exit_code":0,"status":"completed"}}
