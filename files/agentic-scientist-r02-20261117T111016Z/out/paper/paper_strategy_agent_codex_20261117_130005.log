{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, math\nfrom pathlib import Path\nstrategy_path=Path('paper_strategy.json')\nstrategy=json.loads(strategy_path.read_text())\npaper=json.loads(Path('paper_data.json').read_text())\nrequired={'status','selected_prompt_family','recommended_title','central_question','central_thesis','narrative_rationale','prior_paper_story_status','edit_framing_decision','staged_input_impact','method_groups','results_focus','figure_plan','figure_specs','supplementary_plan','forbidden_headings','forbidden_phrases','notes_for_writer','failure_reason'}\nassert required <= strategy.keys()\nassert strategy['status']=='ready' and strategy['selected_prompt_family']=='paper_standalone'\nassert strategy['failure_reason']==''\nassert strategy['prior_paper_story_status'] in {'preserved','broadened','recentered','rejected'}\nassert strategy['supplementary_plan']['purpose'] and strategy['supplementary_plan']['planned_subsections']\nassert sum(spec['preferred_generator']=='generate-concept-figure' for spec in strategy['figure_specs'])==1\nsource_ids=set(paper['grounding_sources'])\nfor spec in strategy['figure_specs']:\n assert spec['required'] and spec['purpose'] and spec['layout_rationale']\n assert spec['max_panels']<=4 and spec['max_panels_per_row']<=3\n assert spec['max_categories_per_panel']<=6 and spec['max_series_per_panel']<=4\n assert spec['preferred_span'] in {'column','full_width'}\n assert 0<spec['target_width_fraction']<=1 and not spec['allow_progression']\n assert set(spec['source_ids'])<=source_ids\n for source_path in spec.get('source_paths',[]): assert Path(source_path).exists(),source_path\n assert spec['figure_id'] in Path('paper_strategy.md').read_text()\nfor section in strategy['supplementary_plan']['planned_subsections']:\n assert section['heading'] and section['grounded_content'] and section['source_ids']\n assert set(section['source_ids'])<=source_ids\n for source_path in section.get('source_paths',[]): assert Path(source_path).exists(),source_path\n assert section['heading'] in Path('paper_strategy.md').read_text()\nepisodes=paper['final_evaluation']['evaluation_evidence']['episodes']\nassert len(episodes)==8\nassert all(len(episode['solution']['cases'])==6 for episode in episodes)\nassert all(case['complete'] for episode in episodes for case in episode['solution']['cases'])\nassert paper['grounding_sources']['final.qualification.outcome']['value']=='qualified'\nassert 'downstream_study' not in paper\nassert not any(source_id.startswith('study.') for source_id in source_ids)\nassert len({json.dumps(episode['solution']['seed_block_uncertainty'],sort_keys=True) for episode in episodes})==1\nmeans={name:sum(record['utility'] for episode in episodes for case in episode['solution']['cases'] for record in case['methods'][name])/144 for name in ['scaled_ilr','unscaled_ilr','simplex_linf','bonferroni']}\nassert math.isclose(means['scaled_ilr'],paper['final_evaluation']['metrics']['final_score'])\nassert math.isclose(means['scaled_ilr']-max(value for name,value in means.items() if name\"'!='\"'scaled_ilr'),paper['final_evaluation']['metrics']['baseline_utility_gap'])\nassert math.isclose(sum([1.2,.55,.9,1.35,1.05,2.35,.95,.25]),8.6)\nassert not Path('paper.tex').exists() and not Path('claims_grounding.json').exists()\nprint('PASS: strategy schema, source IDs/paths, figure budgets, memo headings, final qualification, numerical anchors, 8.6-page allocation, and stage boundaries.')\nprint('Validated',len(strategy['figure_specs']),'required figures and',len(strategy['supplementary_plan']['planned_subsections']),'grounded supplemental entries.')\nPY\nsed -n '935,1008p' task/evaluate_final.py; git status --short 2>/dev/null || true\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
