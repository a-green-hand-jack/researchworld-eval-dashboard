\newlabel{sec:results}{{5}{4}{}{section.5}{}}
\newlabel{sec:results@cref}{{[section][5][]5}{[1][4][]4}{}{}{}}
\newlabel{tab:main}{{1}{5}{Group-macro full-suite RMSE in score points (lower is better), at MTEB $k=8$ and secondary OpenLLM $k=2$. Brackets are marginal 95\% test-component bootstrap intervals conditional on fixed fits; five-split summaries are mean $\pm $ overlapping-split SD, not confidence intervals. Queried entries have zero error. No MTEB Holm-corrected rejection is attainable with six test components. OpenLLM entries use the repaired graph and are post-review exploratory results}{table.caption.2}{}}
\newlabel{tab:main@cref}{{[table][1][]1}{[1][4][]5}{}{}{}}
\newlabel{fig:curves}{{2}{5}{Full-suite RMSE versus measured task count, averaged across five overlapping splits. Shading shows one split SD for trace-risk and random Gaussian prediction, not inferential uncertainty. Vertical dotted lines mark the fixed comparison budgets. The zero-error $k=p$ endpoint measures every score; it provides no evidence of prediction quality on unseen tasks. OpenLLM uses the repaired grouping in a post-review exploratory reanalysis of a distinct population}{figure.caption.3}{}}
\newlabel{fig:curves@cref}{{[figure][2][]2}{[1][4][]5}{}{}{}}
\newlabel{sec:stress}{{5.2}{5}{}{subsection.5.2}{}}
\newlabel{sec:stress@cref}{{[subsection][2][5]5.2}{[1][5][]5}{}{}{}}
\newlabel{tab:stress}{{2}{6}{Exploratory MTEB stress/ablation full-suite RMSE at $k=8$, mean $\pm $ overlapping-split SD (lower is better). \textbf {18/33 executable Gaussian fits are nonconverged at the 200-step cap.} MCAR 20\% additionally fails on seeds 23 and 53, leaving only three executable splits. ``Factor'' uses each condition's Gaussian trace-risk queries. Complete-history/masked conditions use only complete training anchors; diagonal and no-shrinkage conditions use natural training histories. These different cohorts preclude attributing a natural-history versus complete-history gap solely to missingness}{table.caption.4}{}}
\newlabel{tab:stress@cref}{{[table][2][]2}{[1][5][]6}{}{}{}}
\newlabel{fig:stresscal}{{3}{6}{Left: controlled-history errors, with split SD bars and only three executable MCAR-20\% splits; capped, nonconverged fits remain included (\cref {sec:stress}). Right: fitted Gaussian predicted full-suite RMSE versus held-out empirical RMSE across nonzero, non-full budgets and splits. The dashed diagonal denotes equality, not a confidence bound. These descriptive diagnostics are not robustness or coverage certificates}{figure.caption.5}{}}
\newlabel{fig:stresscal@cref}{{[figure][3][]3}{[1][5][]6}{}{}{}}
