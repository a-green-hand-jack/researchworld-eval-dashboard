ram_1', 'type': 'metric', 'value': 0.9426474742464885}\nresult.improvement_002 {'attempt_id': 'cycle02_exact_leaf_game_shap_attempt_01', 'id': 'result.improvement_002', 'idea_id': 'cycle02_exact_leaf_game_shap', 'program_dir': 'work/results/t03/codex/20261107_013849/investigation/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/program_1', 'program_id': 'program_1', 'type': 'metric', 'value': 0.9747236091254068}\nresult.improvement_003 {'attempt_id': 'cycle03_logistic_fourier_shap_attempt_01', 'id': 'result.improvement_003', 'idea_id': 'cycle03_logistic_fourier_shap', 'program_dir': 'work/results/t03/codex/20261107_013849/investigation/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1', 'program_id': 'program_1', 'type': 'metric', 'value': 0.9977844815380661}\nresult.top_program_01 {'attempt_id': 'cycle03_logistic_fourier_shap_attempt_01', 'id': 'result.top_program_01', 'idea_id': 'cycle03_logistic_fourier_shap', 'program_dir': 'work/results/t03/codex/20261107_013849/investigation/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1', 'program_id': 'program_1', 'type': 'metric', 'value': 0.9977844815380661}\nresult.top_program_02 {'attempt_id': 'cycle02_exact_leaf_game_shap_attempt_01', 'id': 'result.top_program_02', 'idea_id': 'cycle02_exact_leaf_game_shap', 'program_dir': 'work/results/t03/codex/20261107_013849/investigation/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/program_1', 'program_id': 'program_1', 'type': 'metric', 'value': 0.9747236091254068}\nresult.top_program_03 {'attempt_id': 'cycle01_single_call_shap_certificates_attempt_01', 'id': 'result.top_program_03', 'idea_id': 'cycle01_single_call_shap_certificates', 'program_dir': 'work/results/t03/codex/20261107_013849/investigation/ideas/01_fixed_budget_single_call_shap_certificates/program_1', 'program_id': 'program_1', 'type': 'metric', 'value': 0.9426474742464885}\nresult.total_attempts {'id': 'result.total_attempts', 'type': 'count', 'value': 3}\nresult.total_correct_programs {'id': 'result.total_correct_programs', 'type': 'count', 'value': 3}\nresult.total_evaluated_programs {'id': 'result.total_evaluated_programs', 'type': 'count', 'value': 3}\nresult.total_ideas {'id': 'result.total_ideas', 'type': 'count', 'value': 3}\ngerman keys ['features', 'name', 'numeric', 'records'] features ['attribute_1', 'attribute_2', 'attribute_3', 'attribute_4', 'attribute_5', 'attribute_6', 'attribute_7', 'attribute_8', 'attribute_9', 'attribute_10', 'attribute_11', 'attribute_12', 'attribute_13', 'attribute_14', 'attribute_15', 'attribute_16', 'attribute_17', 'attribute_18', 'attribute_19', 'attribute_20'] split_counts {'train': 300, 'validation': 100, 'explanation': 100}\nacs keys ['features', 'name', 'numeric', 'records'] features ['AGEP', 'COW', 'SCHL', 'MAR', 'OCCP', 'POBP', 'RELSHIPP', 'WKHP', 'SEX', 'RAC1P'] split_counts {'train': 20000, 'validation': 6667, 'explanation': 6667}\nedit env []\n\"\"\"Genuine interventional Kernel SHAP starter; finite JSON handle(request)->response.\n\nAll responses have EXACTLY the documented keys; extra fields are forbidden. All\nnumeric inputs/outputs are finite. No file names, host paths, private targets,\nreference answers, baseline outputs, or scoring feedback are exchanged.\n\nreset: {op:'reset',seed:nonnegative int} -> {ok:true}. Accept arbitrary seeds;\nclear models, RNG and incomplete transfers. Seeds NEVER choose workload identity.\n\nmodel_start: {op,token:ASCII string,nbytes:int,sha256:64 hex chars,\n encoding:'base64',dtype:'uint8',shape:[nbytes],content_type:'application/json'}\n -> {ok:true}. Begin one in-memory JSON document, 1..16777216 bytes.\nmodel_chunk: {op,token,index:int,data:base64 str} -> {ok:true}. Sequential\n0-based chunks, each at most 1048576 decoded bytes, at most 16 chunks.\nmodel_commit: {op,token} -> {ok:true}. Verify length/digest, decode UTF-8 JSON,\nreplace the active model, and discard transfer buffers. Errors clear transfers.\nOnly one outstanding upload is used; no file-based exchange is permitted.\n\nThe uploaded model has EXACTLY kind, dimension, background, parameters.\nbackground: [B,d] float64-compatible rows, 1<=B<=16, d<=20. All columns\nare original feature groups after evaluator-owned scalar ordinal encoding,\ntraining-median imputation and standard scaling; no dummy columns are split.\nkind='logistic': parameters={coef:[d],intercept:float}.\nkind='forest': parameters={trees:[{left:[nodes],right:[nodes],feature:[nodes],\n threshold:[nodes],probability:[nodes]}]}; <=64 trees, depth<=6.\nkind='affine': parameters={coef:[d],intercept:float}; these fixtures remain\nin [0,1] on the permitted background-replacement domain. Probability-scale,\nidentity-link prediction is used for every kind, without output clipping.\n\nexplain: {op:'explain',queries:[[float]*d]*N,budget:int,\n workload:{usable_seconds:positive float,remaining_explanations:positive int}} ->\n{attributions:[[float]*d]*N}, N<=16, 1<=budget<=8192. The budget is a\nrequested number of nontrivial sampled coalitions PER query, not a new seed\nor workload selector. workload supplies the shared method's remaining usable\nwall seconds (including transport and any remaining model uploads) and count of\nexplanation calls still scheduled, INCLUDING this call. It is advisory runtime\ninformation, not scoring feedback: candidates can allocate time across those\ncalls, e.g. usable_seconds/remaining_explanations, allowing transport headroom.\nThe same fields occur in smoke and all episodes, including analytic controls;\nno plane, seed mapping, private answers or outcome measurements are included.\n\"\"\"Fixed empirical-background estimation; diagnostics never extend RPC responses.\"\"\"\n\nimport math\n\nimport numpy as np\n\n\nclass FrozenProbabilityGame:\n    \"\"\"Mask original supplied columns, without refitting or resampling background.\n\n    The transport already applies frozen scalar preprocessing. It supplies no\n    raw dataframe or pipeline; no claim about unobserved preprocessing is made.\n    The cache is query-local, and contains only predictions requested here.\n    \"\"\"\n\n    def __init__(self, model, query, predict):\n        self.model = model\n        self.query = np.array(query, dtype=np.float64, copy=True)\n        self.background = np.array(model['background'], dtype=np.float64, copy=True)\n        self.predict = predict\n        self.dimension = model['dimension']\n        self.cache = {}\n        self.prediction_rows = 0\n        self.unique_coalitions = 0\n\n    def values(self, coalition_masks):\n        coalition_masks = np.asarray(coalition_masks, dtype=np.uint32)\n        missing = sorted(set(map(int, coalition_masks)) - self.cache.keys())\n        for offset in range(0, len(missing), 128):\n            chunk = np.asarray(missing[offset:offset + 128], dtype=np.uint32)\n            included = ((chunk[:, None] >> np.arange(self.dimension)) & 1).astype(bool)\n            hybrid = np.where(included[:, None, :], self.query, self.background[None, :, :])\n            predictions = self.predict(self.model, hybrid.reshape(-1, self.dimension))\n            means = predictions.reshape(len(chunk), len(self.background)).mean(axis=1)\n            for mask, mean in zip(chunk, means):\n---\nname: generate-concept-figure\ndescription: Generate one reader-facing conceptual overview figure for paper generation as an editable draw.io diagram via the pinned Autoillustrate npm release, with a deterministic layout and an optional image-model restyle.\n---\n\n# Who runs this (important)\nDuring **paper generation the orchestrator owns this pipeline**: `src/scripts/paper.sh` and `paper_edit.sh` run the installed `autoillustrate` CLI synchronously as a post-draft step (`run_concept_figure_step`), derive every argument from `paper_strategy.json`, forward the selected outer agent, and promote the result to `./figures/<figure_id>.png`. The phase agents always run in a dedicated one-shot Docker container, even when the outer paper workflow is native; this limits them to the paper directory, selected-agent auth, and selected provider credentials. The paper-writing agent must **not** invoke this pipeline itself. The rest of this document describes the same CLI for standalone/manual use.\n\n# What the skill is about\nGenerate one reader-facing conceptual overview figure for the paper when a high-level glance-value visual will clarify the method, comparison story, or evidence structure. The figure is produced by the Autoillustrate pipeline (the `autoillustrate` npm release pinned in the agent image): each panel is a collision-checked, deterministically laid-out draw.io diagram, the panels are composed into a single editable `.drawio` file, and the composite is optionally restyled into a camera-ready PNG. The deliverable is a real `.drawio` source plus its export — only the final restyle pass touches a generative model.\n\n# When to use the skill\n- Final paper generation.\n- The paper needs an early conceptual figure that is easier to scan than a dense quantitative plot.\n- The grounded artifacts support a clean overview figure without inventing unsupported mechanisms or claims.\n","exit_code":0,"status":"completed"}}
