one\n        if path == \"/broker-code/candidate_proxy.py\":\n            if not os.environ.get(\"AGENTIC_CANDIDATE_SOCKET\"):\n                raise RuntimeError(\"broker socket required\")\n            spec = importlib.util.spec_from_file_location(\"broker_proxy\", path)\n            module = importlib.util.module_from_spec(spec)\n            spec.loader.exec_module(module)\n            self.proxy = module.handle\n\n    def close(self, failure=False, operation=\"unknown\"):\n        process, capture, scratch = self.process, self.capture, self.scratch\n        self.process = self.capture = self.scratch = None\n        try:\n            if process is not None:\n                try:\n                    stop_process(process)\n                finally:\n                    snapshot = capture.close()\n                if failure:\n                    emit_capture(snapshot, \"candidate_worker_failure\", operation)\n        finally:\n            if scratch is not None:\n                scratch.cleanup()\n\n    def call(self, request, timeout):\n        self.calls += 1\n        if self.calls > RPC_BUDGET:\ngerman & logistic & 7301 & 0.8811 & 0.9163 & 0.7680 \\\\\ngerman & forest & 7301 & 0.8276 & 0.8728 & 0.7440 \\\\\ngerman & boosting & 7301 & 0.8113 & 0.8392 & 0.7200 \\\\\nacs & logistic & 7301 & 0.9528 & 0.9803 & 0.8103 \\\\\nacs & forest & 7301 & 0.9795 & 0.9781 & 0.7730 \\\\\nacs & boosting & 7301 & 0.9567 & 0.9571 & 0.7880 \\\\\ngerman & logistic & 9109 & 0.8742 & 0.9117 & 0.7680 \\\\\ngerman & forest & 9109 & 0.8076 & 0.8588 & 0.7600 \\\\\ngerman & boosting & 9109 & 0.7962 & 0.8311 & 0.7200 \\\\\nacs & logistic & 9109 & 0.9511 & 0.9740 & 0.8103 \\\\\nacs & forest & 9109 & 0.9744 & 0.9690 & 0.7670 \\\\\nacs & boosting & 9109 & 0.9666 & 0.9768 & 0.7880 \\\\\n","exit_code":0,"status":"completed"}}
