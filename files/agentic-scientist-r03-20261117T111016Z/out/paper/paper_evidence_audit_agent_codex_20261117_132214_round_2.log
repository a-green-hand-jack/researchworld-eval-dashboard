{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json,re,statistics\nfrom pathlib import Path\npayload=json.loads(Path('paper_data.json').read_text())\nsummary=json.loads(Path('derived_results.json').read_text())\nepisodes=payload['final_evaluation']['evaluation_evidence']['episodes']\narrays={}\nfor case in 'ABCD':\n    arrays[case]=[]\n    for episode in episodes:\n        evidence=episode['solution']['cases'][case]\n        methods=evidence['baseline_mae_by_method_row_checkpoint']+[evidence['mae_by_row_checkpoint']]\n        arrays[case].append([[statistics.mean(column) for column in zip(*rows)] for rows in methods])\n    means=[[statistics.mean(arrays[case][seed][method][budget] for seed in range(3)) for budget in range(4)] for method in range(6)]\n    assert all(abs(actual-expected)<1e-14 for actual_row,expected_row in zip(means,summary['cases'][case]['mean_budget']) for actual,expected in zip(actual_row,expected_row))\n    assert all(abs(statistics.mean(row)-expected)<1e-14 for row,expected in zip(means,summary['cases'][case]['mean']))\n    diagnostic=statistics.mean(statistics.mean(sum(episode['solution']['cases'][case]['all_unqueried_mae_by_row_checkpoint'],[])) for episode in episodes)\n    assert abs(diagnostic-summary['changing_target_mae'][case])<1e-14\nprimary_seed=[[statistics.mean(arrays[case][seed][method][budget] for case in 'AB' for budget in range(4)) for method in range(6)] for seed in range(3)]\nprimary=[statistics.mean(column) for column in zip(*primary_seed)]\ndeviation=[statistics.stdev(column) for column in zip(*primary_seed)]\nassert all(abs(actual-expected)<1e-14 for actual,expected in zip(primary,summary['primary_mean']))\nassert all(abs(actual-expected)<1e-14 for actual,expected in zip(deviation,summary['primary_seed_sd']))\nmain_expected=[[summary['cases'][case]['mean'][method] for case in 'AB']+[primary[method]] for method in range(6)]\nbudget_expected=sum([summary['cases'][case]['mean_budget'] for case in 'AB'],[])\nfor filename,expected in [('tables/main_comparison.tex',main_expected),('tables/budget_details.tex',budget_expected),('tables/seed_details.tex',primary_seed+[deviation])]:\n    actual=[]\n    for line in Path(filename).read_text().splitlines():\n        values=re.findall(r'(?<\"'!['\"\\\\w.])0\\\\.\\\\d{5}(?\"'!'\"\\\\d)',line)\n        if values: actual.append([float(value) for value in values])\n    assert len(actual)==len(expected),filename\n    assert all(abs(value-target)<0.000005 for values,targets in zip(actual,expected) for value,target in zip(values,targets)),filename\n    print(filename+': all values agree with retained arrays at printed precision')\nmetrics=payload['final_evaluation']['metrics']\nassert abs(primary[-1]-metrics['mae'])<1e-14\nassert abs(min(primary[:-1])-metrics['baseline_mae'])<1e-14\nfor budget_index,budget in enumerate([1,2,4,8]):\n    actual=statistics.mean(arrays[case][seed][-1][budget_index] for case in 'AB' for seed in range(3))\n    assert abs(actual-metrics['mae_k'+str(budget)])<1e-14\nfor field,bound in [('gain_ci_low',summary['baseline_gain_bounds'][0]),('gain_ci_high',summary['baseline_gain_bounds'][1])]:\n    assert abs(min(bound)-metrics[field])<1e-14\nprint('Primary, budget, seed, disruption and changing-target summaries agree with retained arrays.')\nprint('Bootstrap endpoint minima agree with final metrics; implementation inspected without rerunning resampling.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json,re,statistics\nfrom pathlib import Path\npayload=json.loads(Path('paper_data.json').read_text())\nsummary=json.loads(Path('derived_results.json').read_text())\nepisodes=payload['final_evaluation']['evaluation_evidence']['episodes']\narrays={}\nfor case in 'ABCD':\n    arrays[case]=[]\n    for episode in episodes:\n        evidence=episode['solution']['cases'][case]\n        methods=evidence['baseline_mae_by_method_row_checkpoint']+[evidence['mae_by_row_checkpoint']]\n        arrays[case].append([[statistics.mean(column) for column in zip(*rows)] for rows in methods])\n    means=[[statistics.mean(arrays[case][seed][method][budget] for seed in range(3)) for budget in range(4)] for method in range(6)]\n    assert all(abs(actual-expected)<1e-14 for actual_row,expected_row in zip(means,summary['cases'][case]['mean_budget']) for actual,expected in zip(actual_row,expected_row))\n    assert all(abs(statistics.mean(row)-expected)<1e-14 for row,expected in zip(means,summary['cases'][case]['mean']))\n    diagnostic=statistics.mean(statistics.mean(sum(episode['solution']['cases'][case]['all_unqueried_mae_by_row_checkpoint'],[])) for episode in episodes)\n    assert abs(diagnostic-summary['changing_target_mae'][case])<1e-14\nprimary_seed=[[statistics.mean(arrays[case][seed][method][budget] for case in 'AB' for budget in range(4)) for method in range(6)] for seed in range(3)]\nprimary=[statistics.mean(column) for column in zip(*primary_seed)]\ndeviation=[statistics.stdev(column) for column in zip(*primary_seed)]\nassert all(abs(actual-expected)<1e-14 for actual,expected in zip(primary,summary['primary_mean']))\nassert all(abs(actual-expected)<1e-14 for actual,expected in zip(deviation,summary['primary_seed_sd']))\nmain_expected=[[summary['cases'][case]['mean'][method] for case in 'AB']+[primary[method]] for method in range(6)]\nbudget_expected=sum([summary['cases'][case]['mean_budget'] for case in 'AB'],[])\nfor filename,expected in [('tables/main_comparison.tex',main_expected),('tables/budget_details.tex',budget_expected),('tables/seed_details.tex',primary_seed+[deviation])]:\n    actual=[]\n    for line in Path(filename).read_text().splitlines():\n        values=re.findall(r'(?<\"'!['\"\\\\w.])0\\\\.\\\\d{5}(?\"'!'\"\\\\d)',line)\n        if values: actual.append([float(value) for value in values])\n    assert len(actual)==len(expected),filename\n    assert all(abs(value-target)<0.000005 for values,targets in zip(actual,expected) for value,target in zip(values,targets)),filename\n    print(filename+': all values agree with retained arrays at printed precision')\nmetrics=payload['final_evaluation']['metrics']\nassert abs(primary[-1]-metrics['mae'])<1e-14\nassert abs(min(primary[:-1])-metrics['baseline_mae'])<1e-14\nfor budget_index,budget in enumerate([1,2,4,8]):\n    actual=statistics.mean(arrays[case][seed][-1][budget_index] for case in 'AB' for seed in range(3))\n    assert abs(actual-metrics['mae_k'+str(budget)])<1e-14\nfor field,bound in [('gain_ci_low',summary['baseline_gain_bounds'][0]),('gain_ci_high',summary['baseline_gain_bounds'][1])]:\n    assert abs(min(bound)-metrics[field])<1e-14\nprint('Primary, budget, seed, disruption and changing-target summaries agree with retained arrays.')\nprint('Bootstrap endpoint minima agree with final metrics; implementation inspected without rerunning resampling.')\nPY\"","aggregated_output":"tables/main_comparison.tex: all values agree with retained arrays at printed precision\ntables/budget_details.tex: all values agree with retained arrays at printed precision\ntables/seed_details.tex: all values agree with retained arrays at printed precision\nPrimary, budget, seed, disruption and changing-target summaries agree with retained arrays.\nBootstrap endpoint minima agree with final metrics; implementation inspected without rerunning resampling.\n","exit_code":0,"status":"completed"}}
