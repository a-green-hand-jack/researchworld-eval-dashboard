wpublished = {arXiv:2501.17858}\n}\n\n@misc{Giordano2019,\n  author = {Giordano, Ryan and Stephenson, Will and Liu, Runjing and Jordan, Michael I. and Broderick, Tamara},\n  title = {{A Swiss Army Infinitesimal Jackknife}},\n  year = {2018},\n  howpublished = {arXiv:1806.00550}\n}\n\n@misc{Shah2017,\n  author = {Shah, Nihar B. and Wainwright, Martin J.},\n  title = {{Simple, Robust and Optimal Ranking from Pairwise Comparisons}},\n  year = {2015},\n  howpublished = {arXiv:1512.08949}\n}\n\n@misc{Negahban2012,\n  author = {Negahban, Sahand and Oh, Sewoong and Shah, Devavrat},\n  title = {{Rank Centrality: Ranking from Pair-wise Comparisons}},\n  year = {2012},\n  howpublished = {arXiv:1209.1688}\n}\n\n@misc{NBAdata,\n  author = {{FiveThirtyEight}},\n  title = {{Historical NBA Elo}},\n  year = {2025},\n  howpublished = {Dataset documentation, pinned repository snapshot},\n  url = {https://raw.githubusercontent.com/fivethirtyeight/data/4c1ff5e3aef1816ae04af63218015066e186c147/nba-elo/README.md}\n}\n","exit_code":0,"status":"completed"}}
