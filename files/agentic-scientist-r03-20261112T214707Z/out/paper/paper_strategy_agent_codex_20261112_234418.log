e.transfer_select(mixture_covariance, available, self.observed)\n170:        target_variance = np.maximum(np.diag(mixture_covariance), 0.0)\n171:        candidate_variance = np.maximum(target_variance[candidate_indices], 1e-12)\n172:        post_variance = np.maximum(target_variance[:, None] - mixture_covariance[:, candidate_indices] ** 2 / candidate_variance[None, :], 0.0)\n173:        absolute_gain = np.sqrt(target_variance[:, None]) - np.sqrt(post_variance)\n188:            conditional_std = np.sqrt(np.maximum(np.diag(self.within_covariance), 1e-14))\n201:def validation_replay(model, scores, observed_mask, validation_model_ids,\n205:    for model_id in validation_model_ids:\n206:        validation_scores = scores[model_id]\n207:        validation_observed_mask = observed_mask[model_id]\n208:        fixed_target_mask = validation_observed_mask & audit_target_mask\n209:        query_candidates = np.flatnonzero(validation_observed_mask & ~audit_target_mask)\n220:            row.reveal(chosen_index, float(validation_scores[chosen_index]), gaussian_module)\n225:                validation_mae = np.mean(np.abs(prediction[fixed_target_mask] - validation_scores[fixed_target_mask]))\n227:                row_errors.append(float(validation_mae))\n228:                mean_errors.append(float(np.mean(np.abs(mean_prediction[fixed_target_mask] - validation_scores[fixed_target_mask]))))\n246:def paired_summary(differences):\n253:def tune_fit(scores, observed_mask, seed, sweeps, gaussian_module):\n256:        result = LatentMixture(gaussian_module.tune_fit(scores, observed_mask, seed, sweeps))\n257:        result.validation_choice_ = {'component_count': 1, 'selector': 'variance', 'fallback': reason}\n265:    validation_count = min(32, max(2, rows // 5))\n266:    validation_model_ids = permutation[:validation_count]\n267:    train_model_ids = permutation[validation_count:]\n268:    assert set(train_model_ids).isdisjoint(validation_model_ids)\n273:    eligible_validation_ids = [mode