{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/sh -lc \"jq '{interpretation_policy,claims: [.claims[]|{claim,scope,source_ids,evidence_refs}]}' claims_grounding.json\"","aggregated_output":"{\n  \"interpretation_policy\": \"Final qualification is independent of selection. No final failure is present. Repeatability, reference agreement and deployment validity remain distinct; code locations support implementation claims.\",\n  \"claims\": [\n    {\n      \"claim\": \"Final qualification independently reports completed/qualified/true. This concerns documented integrity, coverage, execution and controls, not deployment validity.\",\n      \"scope\": \"final fixed-game evaluation\",\n      \"source_ids\": [\n        \"final.qualification.status\",\n        \"final.qualification.outcome\",\n        \"final.qualification.correct\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L1253-L1273\"\n      ]\n    },\n    {\n      \"claim\": \"Aggregate final normalized reference agreement is 0.9975639445869278, rounded to 0.99756 in the abstract.\",\n      \"scope\": \"final fixed-game evaluation\",\n      \"source_ids\": [\n        \"final.metric.reference_fidelity\"\n      ],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"All final structure-aware reference top-three overlaps and repeat-pair top-three/sign agreements equal one; these are separate assessments.\",\n      \"scope\": \"final fixed-game evaluation\",\n      \"source_ids\": [\n        \"final.metric.top3_overlap\",\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"Stored vectors have zero maximum coordinate range across repeats within each fixed cap/model/query.\",\n      \"scope\": \"final fixed-game evaluation\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"analysis_summary.json#/max_repeat_vector_difference\"\n      ]\n    },\n    {\n      \"claim\": \"Pure reference sign agreement is 0.9994791667, not the mixed evaluator sign metric.\",\n      \"scope\": \"final fixed-game evaluation\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"final.metric.signed_agreement\"\n      ],\n      \"evidence_refs\": [\n        \"analysis_summary.json#/reference_sign_mean\",\n        \"source_evidence/evaluation/evaluate_final.py#L1038-L1053\"\n      ]\n    },\n    {\n      \"claim\": \"Mean normalized endpoint residual is 1.27919753412707e-11, control pass rate one, failed-call fraction zero and replay error zero.\",\n      \"scope\": \"final fixed-game evaluation\",\n      \"source_ids\": [\n        \"final.metric.efficiency_error\",\n        \"final.metric.control_pass_rate\",\n        \"final.metric.failed_fraction\",\n        \"final.metric.replay_error\"\n      ],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"The recorded full workload takes 700.3707705293782 wall seconds, rounded to 700.37, including references, comparators, training and overhead; candidate-only latency is unavailable.\",\n      \"scope\": \"final fixed-game evaluation\",\n      \"source_ids\": [\n        \"final.metric.wall_seconds\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L1310-L1343\",\n        \"paper_data.json#/final_evaluation/metrics/wall_seconds\"\n      ]\n    },\n    {\n      \"claim\": \"Four final dataset/model conditions are German logistic, German forest, ACS logistic and ACS forest; no additional task list or downstream study is present.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"Final seeds are 104729, 130363 and 155921; caps 64/256/1024; six repeats per cap; sixteen fixed queries and training-background rows per fitted condition.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L34-L36\",\n        \"source_evidence/evaluation/evaluate_final.py#L1316-L1319\",\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"Final German retained splits are 300/100/100 records and twenty groups; ACS 20000/6667/6667 and ten groups. These are protocol counts, not independent explained-sample counts.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/capture.py#L61-L155\",\n        \"source_evidence/evaluation/data_provenance.json\",\n        \"source_evidence/evaluation/evaluate_final.py#L687-L718\"\n      ]\n    },\n    {\n      \"claim\": \"German uses original class code 2. ACS uses 2024 PUMS, native RELSHIPP without a RELP crosswalk, the retained adult filter and PINCP>50000 target.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/capture.py#L72-L155\",\n        \"source_evidence/evaluation/data_provenance.json\"\n      ]\n    },\n    {\n      \"claim\": \"German development/final content groups are disjoint. ACS uses California development and New York final data after excluding raw predictor-content overlaps.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/capture.py#L72-L155\",\n        \"source_evidence/evaluation/data_provenance.json\"\n      ]\n    },\n    {\n      \"claim\": \"Training-fitted ordinal vocabularies use unseen code -1; numeric medians and standardization are training fitted; queries/background use fixed ordering.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L687-L718\",\n        \"source_evidence/evaluation/evaluate_final.py#L838-L842\"\n      ]\n    },\n    {\n      \"claim\": \"Logistic regression uses lbfgs, max_iter 500 and tolerance 1e-7. Forests use sixty-four trees, depth six and n_jobs one.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L833-L837\"\n      ]\n    },\n    {\n      \"claim\": \"ACS references enumerate ten-feature finite games; German references average two independent cap-4096 library estimates. Their half-difference is a proxy, not a calibrated interval.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L774-L796\",\n        \"source_evidence/evaluation/evaluate_final.py#L849-L858\"\n      ]\n    },\n    {\n      \"claim\": \"Stored 95-percent intervals use 1000 bootstrap resamples of sixteen query-level means after cap/repeat averaging, conditional on one fitted model/reference.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L1154-L1159\"\n      ]\n    },\n    {\n      \"claim\": \"The normalized L1 agreement floor is 0.001; signs at magnitude at most 1e-8 are zero; top-three ties follow coordinate order. Endpoint residual is capped at one.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L1014-L1030\"\n      ]\n    },\n    {\n      \"claim\": \"Library KernelExplainer uses identity link, l1_reg zero and nsamples equal to cap. Two independent split-cap calls each use floor(cap/2).\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/evaluation/evaluate_final.py#L757-L772\",\n        \"source_evidence/evaluation/evaluate_final.py#L860-L868\"\n      ]\n    },\n    {\n      \"claim\": \"Forest attribution uses signed leaf-game beta-integral coefficients over all trees/background rows, intersecting repeated splits and retaining float32 predictor-input semantics.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/selected/forest.py#L11-L81\",\n        \"source_evidence/evaluation/evaluate_final.py#L720-L755\"\n      ]\n    },\n    {\n      \"claim\": \"Probability-scale logistic integration uses ceil(d/2) inclusion nodes, eight-node frequency panels, cutoff eight and at most 2048 frequency nodes; tail tolerance 1e-10 and mesh/efficiency tolerances 1e-8.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/selected/logistic_fourier.py#L12-L140\"\n      ]\n    },\n    {\n      \"claim\": \"Two consecutive mesh agreements are required. Failure for any background row rejects integration; frequency-tail control is not a rigorous discretization bound.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/selected/logistic_fourier.py#L43-L140\"\n      ]\n    },\n    {\n      \"claim\": \"Dispatch uses forest structure directly, then generic enumeration when cap covers 2^d-2 nontrivial coalitions before logistic integration; branch counts are unrecorded.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/selected/reliability.py#L163-L197\"\n      ]\n    },\n    {\n      \"claim\": \"The sampled fallback combines independent complete paths and importance-corrected constrained regression. Alpha 0.05 separation is used only with at least two paths; acceptance coverage is absent.\",\n      \"scope\": \"final protocol and readable implementation evidence, not additional measurements\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"evidence_refs\"