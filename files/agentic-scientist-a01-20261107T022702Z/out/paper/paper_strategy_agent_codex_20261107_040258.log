'allow_progression']\n assert figure['preferred_span']=='full_width' and figure['target_width_fraction']==1.0\n assert figure['layout_rationale']\n assert 1<=figure['max_panels']<=4\n assert 1<=figure['max_categories_per_panel']<=6\n assert 1<=figure['max_series_per_panel']<=4\nassert sum([.50,1.,.50,.90,1.35,.80,2.45,.90,.35])==8.75\nexpected_examples={('helm',10,1.):[9,12,34],('helm',10,.5):[23,12,39],('openllm',1609,1.):[2,3,5],('openllm',1609,.5):[4,3,5]}\nexpected_reach={('helm',1.):[8,8,8],('helm',.5):[5,5,4],('openllm',1.):[8,8,8],('openllm',.5):[7,6,3]}\nprevious={}\nfor episode in data['final_evaluation']['evaluation_evidence']['episodes']:\n for case in episode['solution']['cases']:\n  assert case['failure'] is None\n  assert all(observation['validated'] for observation in case['observations'])\n  if case['case']\"'!='\"'original': continue\n  family=case['family']; observations=case['observations']\n  assert len({observation['target'] for observation in observations})==8\n  signature=[(observation['target'],observation['rule'],observation['fraction'],observation['allocation']) for observation in observations]\n  if family in previous: assert signature==previous[family]\n  previous[family]=signature\n  for observation in observations:\n   assert observation['reference']['exact']\n   if observation['allocation']['status']=='feasible':\n    assert len(observation['allocation']['tasks'])==observation['reference']['lower']==observation['reference']['upper']\n  for (example_family,target,fraction),costs in expected_examples.items():\n   if family\"'!=example_family: continue\n   selected=[next(observation for observation in observations if observation['\"'target']==target and observation['rule']==rule and observation['fraction']==fraction) for rule in ['mean','median','borda']]\n   assert [len(observation['allocation']['tasks']) for observation in selected]==costs\n  for fraction in [1.,.5]:\n   counts=[sum(observation['allocation']['status']=='feasible' for observation in observations if observation['rule']==rule and observation['fraction']==fraction) for rule in ['mean','median','borda']]\n   assert counts==expected_reach[family,fraction]\nassert data['grounding_sources']['final.qualification.outcome']['value']=='qualified'\nassert data['grounding_sources']['final.qualification.status']['value']=='completed'\nassert data['grounding_sources']['study.search_score_delta']['value']==0\nassert data['grounding_sources']['study.attempts.scored']['value']==3\nassert data['grounding_sources']['study.attempts.unscored']['value']==0\nassert not Path('paper.tex').exists() and not Path('claims_grounding.json').exists()\nprint('PASS: strategy schema, mirrored title/sections, source IDs, figure budgets, 8.75-page allocation, and stage boundaries.')\nprint('PASS: every stated reversal and reachability count matches all three final episodes; original reference bounds close and selected allocations repeat.')\nprint('PASS: final qualification is independent of non-winning search selection; no candidate experiment or final-paper validator was run.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
