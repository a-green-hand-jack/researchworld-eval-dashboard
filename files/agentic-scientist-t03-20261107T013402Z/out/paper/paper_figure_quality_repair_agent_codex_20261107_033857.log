             \"type\": \"string\"\n                  },\n                  \"generator\": {\n                    \"type\": \"null\"\n                  },\n                  \"prompt_log_path\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"generator\",\n                  \"attempted_generator\",\n                  \"prompt_log_path\",\n                  \"fallback_reason\"\n                ]\n              }\n            ]\n          }\n        }\n      ],\n      \"description\": \"Richer manifest shape used by newer standalone paper runs.\",\n      \"properties\": {\n        \"attempted_generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Attempted Generator\"\n        },\n        \"caption_short\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Caption Short\"\n        },\n        \"estimated_min_rendered_font_pt\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Estimated Min Rendered Font Pt\"\n        },\n        \"fallback_reason\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n            