d losses.\",\n      \"Search scores and sealed final metrics belong to different evaluation scopes.\",\n      \"An unqualified final outcome may reflect validity or other criteria; do not infer that failure means only an inferior score. Interpret metrics within those limitations.\"\n    ],\n    \"program_dir\": \"work/results/a06/codex/20261105_100448/downstream/program\",\n    \"program_tree_sha256\": \"58a9fb41c00b27356ad9e1ffe72cf2f29f8450bd93594bb69278f2b15acd3199\",\n    \"search_score_delta\": 0.0,\n    \"selection_kind\": \"baseline\",\n    \"source_attempt_id\": \"bootstrap\",\n    \"source_evidence\": {\n      \"baseline\": \"source_evidence/downstream/baseline\",\n      \"program\": \"source_evidence/downstream/program\"\n    },\n    \"source_program_dir\": \"work/results/a06/codex/20261105_100448/investigation/.baseline-seed-mk_moqr7/program_0\",\n    \"source_tree_sha256\": \"58a9fb41c00b27356ad9e1ffe72cf2f29f8450bd93594bb69278f2b15acd3199\"\n  },\n  \"final_evaluation\": {\n    \"correct\": true,\n    \"evaluation_evidence\": {\n      \"candidate_diagnostics_trust\": \"unverified\",\n      \"episode_count\": 5,\n      \"episodes\": [\n        {\n          \"correct\": true,\n          \"duration_seconds\": 3077.382134909276,\n          \"score\": 0.9972120833496253,\n          \"seed\": 1009,\n          \"solution\": {\n            \"cases\": [\n              {\n                \"case\": \"S64K1\",\n                \"completed_controls\": [\n                  \"constant\",\n                  \"copy_arm\",\n                  \"copy_report\",\n                  \"permuted_input\"\n                ],\n                \"details\": [\n                  {\n                    \"copy_report_independence_audit_passed\": false,\n                    \"metrics\": {\n                      \"control_failure_rate\": 0.0,\n                      \"coverage\": 0.9599609375,\n                      \"decision_reversal_rate\": 0.0,\n                      \"failure_rate\": 0.0,\n                      \"fixed_prompt_mse\": 0.0036161518096923828,\n                      \"full_budget_naive_mse\": 0.0036161518096923828,\n                      \"honest_half_mse\": 0.007617149353027344,\n                      \"interval_width\": 0.31730463763488137,\n                      \"random_prompt_mse\": 0.0036161518096923828,\n                      \"report_bias\": -0.002069091796874978,\n                      \"report_mse\": 0.007056388854980469,\n                      \"reuse_mse\": 0.007122955322265625,\n                      \"selected_accuracy\": 0.6,\n                      \"signed_optimism\": 0.005957031250000022\n                    },\n                    \"permutation_report_mean\": 0.5994873046875,\n                    \"regime\": 0,\n                    \"report_mse_standard_error\": 0.0003015001155230818\n                  },\n                  {\n                    \"copy_report_independence_audit_passed\": false,\n                    \"metrics\": {\n                      \"control_failure_rate\": 0.0,\n                      \"coverage\": 0.951171875,\n                      \"decision_reversal_rate\": 0.0,\n                      \"failure_rate\": 0.0,\n                      \"fixed_prompt_mse\": 0.0038239097595214842,\n                      \"full_budget_naive_mse\": 0.0038239097595214842,\n                      \"honest_half_mse\": 0.007863006591796874,\n                      \"interval_width\": 0.31680430714750135,\n                      \"random_prompt_mse\": 0.0038239097595214842,\n                      \"report_bias\": -0.002099609374999978,\n                      \"report_mse\": 0.0077996826171874995,\n                      \"reuse_mse\": 0.007201919555664063,\n                      \"selected_accuracy\": 0.6,\n                      \"signed_optimism\": 0.002233886718750022\n                    },\n[\n  \"correct\",\n  \"evaluation_evidence\",\n  \"evaluator_sha256\",\n  \"manifest_path\",\n  \"metrics\",\n  \"outcome\",\n  \"program_tree_sha256\",\n  \"results_tree_sha256\",\n  \"status\",\n  \"task_tree_sha256\"\n]\n\"object\"\n[\n  \"final.evidence.episodes\",\n  \"final.metric.combined_score\",\n  \"final.metric.control_failure_rate\",\n  \"final.metric.correct\",\n  \"final.metric.coverage\",\n  \"final.metric.decision_reversal_rate\",\n  \"final.metric.failure_rate\",\n  \"final.metric.fixed_prompt_mse\",\n  \"final.metric.full_budget_naive_mse\",\n  \"final.metric.honest_half_mse\",\n  \"final.metric.interval_width\",\n  \"final.metric.random_prompt_mse\",\n  \"final.metric.replay_discrepancy\",\n  \"final.metric.report_bias\",\n  \"final.metric.report_mse\",\n  \"final.metric.reuse_mse\",\n  \"final.metric.selected_accuracy\",\n  \"final.metric.signed_optimism\",\n  \"final.qualification.correct\",\n  \"final.qualification.outcome\",\n  \"final.qualification.status\",\n  \"result.total_attempts\",\n  \"result.total_correct_programs\",\n  \"result.total_evaluated_programs\",\n  \"result.total_ideas\",\n  \"study.attempts.scored\",\n  \"study.attempts.total\",\n  \"study.attempts.unscored\",\n  \"study.baseline_score\",\n  \"study.final.correct\",\n  \"study.final.outcome\",\n  \"study.final.status\",\n  \"study.investigation_outcome\",\n  \"study.search_score\",\n  \"study.search_score_delta\",\n  \"study.selection_kind\"\n]\n[\n  {\n    \"figure_id\": \"reporting_overview\",\n    \"required\": true,\n    \"purpose\": \"Give immediate glance value for the estimand, protected sample, same-winner comparator, and unequal evidential strength of known truth and finite audit.\",\n    \"figure_type\": \"diagram\",\n    \"preferred_generator\": \"generate-concept-figure\",\n    \"group_by\": \"reporting_policy\",\n    \"metric\": \"none; conceptual evidence and data-flow map\",\n    \"split_by\": \"selection/report data roles and synthetic/real targets\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"paper.sty sets a single 5.5-inch text column and 9-inch text height. Use that full 5.5-inch span on page 1 or 2, approximately 1.6 inches high plus caption (about one fifth page), with at least 9-point final labels. A half-width inset would compress branching data roles; there is no two-column figure* assumption.\",\n    \"allow_progression\": false,\n    \"max_panels\": 1,\n    \"max_panels_per_row\": 1,\n    \"max_categories_per_panel\": 6,\n    \"max_series_per_panel\": 3,\n    \"source_ids\": [\n      \"final.evidence.episodes\",\n      \"study.selection_kind\"\n    ],\n    \"implementation_notes\": \"At most six semantic blocks, short node labels, no numerical result decorations, no invented model architecture or adaptive feedback loop. Describe selection/report independence as the intended random-partition design, not an evaluator-certified population property. Require editable draw.io output and regenerate rather than shrink if text exceeds budget.\"\n  },\n  {\n    \"figure_id\": \"reporting_error_comparison\",\n    \"required\": true,\n    \"purpose\": \"Compare error while keeping sample size, prompt count, target type, and the strongest counterexample to uniform superiority visible.\",\n    \"figure_type\": \"grouped_point_plot\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"prompt count K=1 or K=16\",\n    \"metric\": \"synthetic: mean squared error to known selected-prompt accuracy; real: squared discrepancy to audit accuracy\",\n    \"split_by\": \"synthetic versus real and n=64 versus n=256\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Use 5.5 inches by approximately 2.8 inches plus caption, a 2x2 grid with only two x categories and three series per panel. A single legend and at least 8.5-point rendered labels keep it readable at full text width; half-width is unsuitable. Reserve about two fifths page. Use matched scales within each evidence row or explicitly label any row-specific scale; do not imply identical targets across rows.\",\n    \"allow_progression\": false,\n    \"max_panels\": 4,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 2,\n    \"max_series_per_panel\": 3,\n    \"source_ids\": [\n      \"final.evidence.episodes\",\n      \"final.metric.report_mse\",\n      \"final.metric.reuse_mse\",\n      \"final.metric.full_budget_naive_mse\"\n    ],\n    \"implementation_notes\": \"Three series: protected report, selection-score reuse, full-budget reuse. Overlay seed points within those series rather than adding seed legend entries. Means are descriptive across the five retained seeds, with synthetic regimes equally weighted. Do not invent paired-difference standard errors from marginal MSE standard errors; display seed scatter instead. Use a table for the remaining comparators.\"\n  },\n  {\n    \"figure_id\": \"real_audit_accuracy_difference\",\n    \"required\": true,\n    \"purpose\": \"Prevent improved reporting from being mistaken for improved selected-prompt accuracy and expose finite-audit uncertainty.\",\n    \"figure_type\": \"horizontal_interval_plot\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"final evaluation seed\",\n    \"metric\": \"selected minus fixed prompt audit accuracy, with paired subject-bootstrap 95% percentile interval\",\n    \"split_by\": \"n=64 versus n=256 at K=16\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Use a 5.5-inch-wide two-panel plot approximately 1.8 inches high plus caption (roughly one quarter page), five horizontal seed rows per panel and one interval series. Keep at least 8.5-point labels, shared x limits, and a zero line. Full-width avoids squeezing signed accuracy labels into a narrow inset; in this single-column style full-width equals column width.\",\n    \"allow_progression\": false,\n    \"max_panels\": 2,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 5,\n    \"max_series_per_panel\": 1,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"implementation_notes\": \"Point estimates equal detail.target minus detail.fixed[1]; endpoints are detail.paired_subject_bootstrap_interval. All five seeds must appear. The evaluator uses 200 subject-cluster bootstrap draws, and these intervals are not simultaneous or a validation of the bootstrap procedure. K=1 yields the identical prompt and is tabulated rather than using a redundant panel.\"\n  }\n]\n[\n  \"campaign_results_dir\",\n  \"count\",\n  \"generated_at\",\n  \"queries\",\n  \"reference_query_plan\",\n  \"references\",\n  \"results_dir\"\n]\n{\n  \"citation_count\": 223,\n  \"citation_key\": \"Hedges1996EstimatingES\",\n  \"id\": \"ref.s2.3c91bee5b23c8bdcbc1330e7c42781299b1051a6\",\n  \"paper_id\": \"3c91bee5b23c8bdcbc1330e7c42781299b1051a6\",\n  \"query\": \"sample splitting model selection independent test error bias variance\",\n  \"retrieved_at\": \"2026-11-06T05:07:42.226851+00:00\",\n  \"source_url\": \"https://api.semanticscholar.org/graph/v1/paper/3c91bee5b23c8bdcbc1330e7c42781299b1051a6?fields=paperId%2Ctitle%2Cyear%2Cvenue%2CcitationCount%2CcitationStyles%2Curl\",\n  \"title\": \"Estimating Effect Size Under Publication Bias: Small Sample Properties and Robustness of a Random Effects Selection Model\",\n  \"venue\": \"\",\n  \"year\": 1996\n}\n#!/usr/bin/env python3\n\"\"\"Validate generated claim-grounding artifacts before paper finalization.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nEVIDENCE_REF_RE = re.compile(r\"@evidence\\[\\[[^\\]]+\\]\\]\")\nTEX_INPUT_RE = re.compile(\n    r\"\\\\(?:input|include)(?![A-Za-z@])\\s*\"\n    r\"(?:\\{(?P<braced>[^{}]+)\\}|(?P<unbraced>[^\\s%{}]+))\"\n)\nTEX_IMPORT_COMMAND_RE = re.compile(r\"\\\\(?:input|include)(?![A-Za-z@])\")\nTEX_LOCAL_SUPPORT_RE = re.compile(\n    r\"\\\\(?P<command>usepackage|RequirePackage|documentclass|LoadClass)\"\n    r\"(?![A-Za-z@])(?:\\s*\\[[^\\]]*\\])?\\s*\\{(?P<targets>[^{}]+)\\}\"\n)\nTEX_LOCAL_SUPPORT_COMMAND_RE = re.compile(\n    r\"\\\\(?:usepackage|RequirePackage|documentclass|LoadClass)(?![A-Za-z@])\"\n)\nDYNAMIC_TEX_IMPORT_RE = re.compile(r\"\\\\csname\\s*(?:input|include)\\s*\\\\endcsname\")\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\if[a-zA-Z@]+\\b|\\\\else\\b|\\\\fi\\b\")\nVERBATIM_ENV_RE = re.compile(\n    r\"\\\\begin\\s*\\{(?P<env>verbatim\\*?|lstlisting|minted)\\}.*?\"\n    r\"\\\\end\\s*\\{(?P=env)\\}\",\n    re.DOTALL,\n)\nPROMPT_ARTIFACT_RE = re.compile(r\".+_prompt(?:_round_\\d+(?:_contract_retry_\\d+)?)?\\.md$\")\nGENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\n    \"validation_feedback.json\",\n    \"validation_feedback.md\",\n    \"verification-report.json\",\n}\nROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\"validation_report.json\"}\nGENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES = (\n    \"paper_evidence_audit\",\n)\nEVIDENCE_BUNDLE_DIRNAME = \"scientific-evidence\"\nEVIDENCE_SCAN_SUFFIXES = (\n    \".tex\",\n    \".md\",\n    \".json\",\n    \".yaml\",\n    \".yml\",\n    \".py\",\n    \".sh\",\n    \".r\",\n    \".csv\",\n    \".tsv\",\n)\nEVIDENCE_SKIP_DIR_NAMES = {\n    \".git\",\n    \"__pycache__\",\n    EVIDENCE_BUNDLE_DIRNAME,\n}\nAGENT_SKILL_DIR_PREFIXES = (\n    (\".claude\", \"skills\"),\n    (\".codex\", \"skills\"),\n    (\".cursor\", \"skills\"),\n    (\".opencode\", \"skills\"),\n    (\".gemini\", \"skills\"),\n    (\".pi\", \"agent\", \"skills\"),\n)\nVERIFICATION_SUMMARY_KEYS = (\n    \"total_references\",\n    \"resolved_references\",\n    \"anchored_references\",\n    \"dangling_references\",\n    \"manifests_checked\",\n)\nSCIENTIFIC_EVIDENCE_SCRIPT = (\n    Path(__file__).resolve().parent.parent.parent\n    / \"scientific-evidence\"\n    / \"scripts\"\n    / \"scientific_evidence.py\"\n)\n\n\ndef read_json(path: Path) -> dict[str, Any]:\n    \"\"\"Read JSON data from disk when available.\"\"\"\n    try:\n        payload = json.loads(path.read_text(encoding=\"utf-8\"))\n    except json.JSONDecodeError as exc:\n        raise SystemExit(f\"Invalid JSON in {path}: {exc}\") from exc\n    if not isinstance(payload, dict):\n        raise SystemExit(f\"Expected JSON object in {path}\")\n    return payload\n\n\ndef read_bib_keys(path: Path) -> set[str]:\n    \"\"\"Read bib keys.\"\"\"\n    text = path.read_text(encoding=\"utf-8\")\n    return {match.group(1).strip() for match in KEY_RE.finditer(text) if match.group(1).strip()}\n\n\ndef validate_reference_provenance(*, references_payload: dict[str, Any], bib_keys: set[str]) -> tuple[set[str], list[str]]:\n    \"\"\"Validate references_provenance.json against references.bib.\"\"\"\n    errors: list[str] = []\n    refs = references_payload.get(\"references\")\n    if not isinstance(refs, list):\n        return set(), [\"references_provenance.json must contain a `references` list.\"]\n\n    provenance_keys: set[str] = set()\n    provenance_ids: set[str] = set()\n    for idx, row in enumerate(refs):\n        if not isinstance(row, dict):\n            errors.append(f\"references[{idx}] must be object\")\n            continue\n        source_id = row.get(\"id\")\n        if not isinstance(source_id, str) or not source_id.strip():\n            errors.append(f\"references[{idx}].id missing\")\n        else:\n            if source_id in provenance_ids:\n                errors.append(f\"references[{idx}].id duplicates existing id: {source_id!r}\")\n            provenance_ids.add(source_id)\n\n        citation_key = row.get(\"citation_key\")\n        if not isinstance(citation_key, str) or not citation_key.strip():\n            errors.append(f\"references[{idx}].citation_key missing\")\n            continue\n        if citation_key in provenance_keys:\n            errors.append(\n                f\"references[{idx}].citation_key duplicates existing key: {citation_key!r}\"\n            )\n        provenance_keys.add(citation_key)\n\n    missing_in_provenance = sorted(bib_keys - provenance_keys)\n    if missing_in_provenance:\n        errors.append(\n            \"references.bib keys missing from references_provenance.json: \"\n            + \", \".join(repr(key) for key in missing_in_provenance)\n        )\n\n    missing_in_bib = sorted(provenance_keys - bib_keys)\n    if missing_in_bib:\n        errors.append(\n            \"references_provenance.json keys missing from references.bib: \"\n            + \", \".join(repr(key) for key in missing_in_bib)\n        )\n\n    return provenance_ids, errors\n\n\ndef is_excluded_evidence_scan_path(path: Path, *, paper_dir: Path) -> bool:\n    \"\"\"Return True for operational artifacts that should not enter evidence scans.\"\"\"\n    rel_parts = path.relative_to(paper_dir).parts\n    if any(rel_parts[: len(prefix)] == prefix for prefix in AGENT_SKILL_DIR_PREFIXES):\n        return True\n    if any(part in EVIDENCE_SKIP_DIR_NAMES for part in rel_parts):\n        return True\n    if len(rel_parts) == 1 and rel_parts[0] in ROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES:\n        return True\n    if path.name in GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES:\n        return True\n    if any(path.name.startswith(prefix) for prefix in GENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES):\n        return True\n    return bool(PROMPT_ARTIFACT_RE.fullmatch(path.name))\n\n\ndef strip_tex_comments(tex_text: str) -> str:\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n\ndef _markdown_entry(event: dict[str, Any]) -> str:\n    \"\"\"Handle markdown entry logic for this module.\"\"\"\n    lines = [\n        f\"### {event['timestamp']} | step={event['step']} | scope={event['scope']}\",\n        f\"- summary: {event['summary']}\",\n        f\"- evidence: {event['evidence']}\",\n        f\"- next_action: {event['next_action']}\",\n    ]\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = event.get(key)\n        if isinstance(value, str) and value.strip():\n            lines.append(f\"- {key}: {value.strip()}\")\n\n    metrics = event.get(\"metrics\")\n    if isinstance(metrics, dict) and metrics:\n        lines.append(f\"- metrics: {json.dumps(metrics, sort_keys=True)}\")\n    rubrics = event.get(\"rubrics\")\n    if isinstance(rubrics, list) and rubrics:\n        lines.append(f\"- rubrics: {json.dumps(rubrics, sort_keys=True)}\")\n    tags = event.get(\"tags\")\n    if isinstance(tags, list) and tags:\n        lines.append(f\"- tags: {', '.join(str(item) for item in tags)}\")\n\n    return \"\\n\".join(lines) + \"\\n\\n\"\n\n\ndef _append_text(path: Path, text: str, *, header: str) -> None:\n    \"\"\"Safely initialize and append text to a regular file.\"\"\"\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if not size:\n            _write_all(fd, header.encode(\"utf-8\"))\n        elif os.pread(fd, 1, size - 1) != b\"\\n\":\n            _write_all(fd, b\"\\n\")\n        _write_all(fd, text.encode(\"utf-8\"))\n    finally:\n        try:\n            fcntl.flock(fd, fcntl.LOCK_UN)\n        finally:\n            os.close(fd)\n\n\ndef _append_jsonl(path: Path, payload: dict[str, Any]) -> None:\n    \"\"\"Append one JSON object as a JSONL record.\"\"\"\n    line = (json.dumps(payload, sort_keys=True) + \"\\n\").encode(\"utf-8\")\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if size and os.pread(fd, 1, size - 1) != b\"\\n\":\n            _write_all(fd, b\"\\n\")\n        _write_all(fd, line)\n    finally:\n        try:\n            fcntl.flock(fd, fcntl.LOCK_UN)\n        finally:\n            os.close(fd)\n\n\ndef _open_regular_for_append(path: Path) -> int:\n    \"\"\"Open an append target without following its parent or leaf.\"\"\"\n    directory_fd = _walk_directory_no_follow(path.parent)\n    try:\n        fd = os.open(\n            path.name,\n            os.O_APPEND\n            | os.O_CREAT\n            | os.O_RDWR\n            | getattr(os, \"O_NOFOLLOW\", 0)\n            | getattr(os, \"O_NONBLOCK\", 0),\n            0o644,\n            dir_fd=directory_fd,\n        )\n    finally:\n        os.close(directory_fd)\n    if stat.S_ISREG(os.fstat(fd).st_mode):\n        return fd\n    os.close(fd)\n    raise OSError(f\"unsafe non-regular append target: {path}\")\n\n\ndef _walk_directory_no_follow(directory: Path) -> int:\n    \"\"\"Create and walk a directory path without following any component.\"\"\"\n    flags = os.O_RDONLY | getattr(os, \"O_DIRECTORY\", 0) | getattr(os, \"O_NOFOLLOW\", 0)\n    if directory.is_absolute():\n        descriptor = os.open(directory.anchor, flags)\n        components = directory.parts[1:]\n    else:\n        descriptor = os.open(\".\", flags)\n        components = directory.parts\n    try:\n        for component in components:\n            if component in (\"\", \".\"):\n                continue\n            try:\n                os.mkdir(component, mode=0o777, dir_fd=descriptor)\n            except FileExistsError:\n                pass\n            next_descriptor = os.open(component, flags, dir_fd=descriptor)\n            os.close(descriptor)\n            descriptor = next_descriptor\n        return descriptor\n    except BaseException:\n        os.close(descriptor)\n        raise\n\n\ndef _write_all(fd: int, data: bytes) -> None:\n    \"\"\"Write every byte or propagate the write failure.\"\"\"\n    remaining = memoryview(data)\n    while remaining:\n        written = os.write(fd, remaining)\n        if written <= 0:\n            raise OSError(\"write returned no progress\")\n        remaining = remaining[written:]\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Append one memory event, or atomically rewrite conclusions.md.\",\n    )\n    parser.add_argument(\n        \"--write-conclusions\",\n        action=\"store_true\",\n        help=\"Switch into conclusions-write mode (validates and replaces conclusions.md).\",\n    )\n    # Event-append mode (existing behavior).\n    parser.add_argument(\"--event-json\", default=None, help=\"Event payload as JSON object string\")\n    parser.add_argument(\"--event-file\", default=None, help=\"Path to event JSON file\")\n    parser.add_argument(\n        \"--local-memory-md\",\n        default=\"./memory.md\",\n        help=\"Local workspace memory markdown path\",\n    )\n    parser.add_argument(\n        \"--global-memory-md\",\n        default=None,\n        help=\"Global markdown memory path (event mode)\",\n    )\n    parser.add_argument(\n        \"--global-memory-jsonl\",\n        default=None,\n        help=\"Global JSONL memory path (event mode)\",\n    )\n    # Conclusions-write mode.\n    parser.add_argument(\n        \"--conclusions-md\",\n        default=None,\n        help=\"Path of conclusions.md to overwrite (--write-conclusions mode)\",\n    )\n    parser.add_argument(\n        \"--conclusions-history-jsonl\",\n        default=None,\n        help=\"Path of conclusions_history.jsonl to append a record to\",\n    )\n    parser.add_argument(\n        \"--conclusions-text\",\n        default=None,\n        help=\"Conclusion paragraph (omit to read from stdin)\",\n    )\n    parser.add_argument(\n        \"--cycle-index\",\n        type=int,\n        default=None,\n        help=\"Current cycle index for the history record\",\n    )\n    parser.add_argument(\n        \"--worker-index\",\n        type=int,\n        default=None,\n        help=\"Current worker index for the history record\",\n    )\n    parser.add_argument(\n        \"--gate-trigger\",\n        default=None,\n        help=\"Gate trigger letter (a|b|c|d) recorded in history\",\n    )\n    parser.add_argument(\n        \"--gate-reason\",\n        default=None,\n        help=\"One-sentence reason for the update; for trigger d name the dimension\",\n    )\n    return parser.parse_args()\n\n\ndef _read_conclusions_text(args: argparse.Namespace) -> str:\n    \"\"\"Resolve the candidate paragraph from ``--conclusions-text`` or stdin.\"\"\"\n    if isinstance(args.conclusions_text, str):\n        return args.conclusions_text\n    return sys.stdin.read()\n\n\ndef _validate_conclusions_paragraph(text: str) -> str:\n    \"\"\"Return the trimmed paragraph or raise ``ValueError`` describing the failure.\"\"\"\n    stripped = text.strip()\n    if not stripped:\n        raise ValueError(\"conclusion paragraph is empty after trimming\")\n    if \"\\n\\n\" in stripped:\n        raise ValueError(\"single paragraph required: text contains a blank line\")\n    word_count = len(stripped.split())\n    if word_count > CONCLUSIONS_WORD_LIMIT:\n        raise ValueError(\n            f\"word count > {CONCLUSIONS_WORD_LIMIT} (got {word_count}); shorten the paragraph\"\n        )\n    return stripped\n\n\ndef _atomic_overwrite(path: Path, text: str) -> None:\n    \"\"\"Atomically replace ``path`` with ``text`` (write to ``.tmp`` then ``os.replace``).\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    tmp = path.with_suffix(path.suffix + \".tmp\")\n    tmp.write_text(text, encoding=\"utf-8\")\n    os.replace(tmp, path)\n\n\ndef _read_prior_conclusions(path: Path) -> str:\n    \"\"\"Return the prior content of conclusions.md or an empty string if missing.\"\"\"\n    if not path.is_file():\n        return \"\"\n    try:\n        return path.read_text(encoding=\"utf-8\")\n    except OSError:\n        return \"\"\n\n\ndef _validate_conclusions_args(args: argparse.Namespace) -> None:\n    \"\"\"Raise ``ValueError`` if conclusions-mode args are missing or invalid.\"\"\"\n    missing: list[str] = []\n    if not args.conclusions_md:\n        missing.append(\"--conclusions-md\")\n    if not args.conclusions_history_jsonl:\n        missing.append(\"--conclusions-history-jsonl\")\n    if args.cycle_index is None:\n        missing.append(\"--cycle-index\")\n    if args.worker_index is None:\n        missing.append(\"--worker-index\")\n    if not args.gate_trigger:\n        missing.append(\"--gate-trigger\")\n    if not args.gate_reason:\n        missing.append(\"--gate-reason\")\n    if missing:\n        raise ValueError(f\"missing required conclusions-mode flags: {', '.join(missing)}\")\n    trigger = str(args.gate_trigger).strip().lower()\n    if trigger not in GATE_TRIGGER_VALUES:\n        raise ValueError(\n            f\"gate-trigger must be one of {GATE_TRIGGER_VALUES} (got {args.gate_trigger!r})\"\n        )\n\n\ndef _run_write_conclusions(args: argparse.Namespace) -> int:\n    \"\"\"Execute the ``--write-conclusions`` mode.\"\"\"\n    try:\n        _validate_conclusions_args(args)\n    except ValueError as exc:\n        print(f\"append_memory: {exc}\", file=sys.stderr)\n        return 1\n\n    raw_text = _read_conclusions_text(args)\n    try:\n        paragraph = _validate_conclusions_paragraph(raw_text)\n    except ValueError as exc:\n        print(f\"append_memory: rejected conclusions update — {exc}\", file=sys.stderr)\n        return 1\n\n    conclusions_path = Path(args.conclusions_md)\n    history_path = Path(args.conclusions_history_jsonl)\n    prior = _read_prior_conclusions(conclusions_path)\n\n    trigger = str(args.gate_trigger).strip().lower()\n    record = {\n        \"timestamp\": utc_now(),\n        \"cycle_index\": int(args.cycle_index),\n        \"worker_index\": int(args.worker_index),\n        \"gate_trigger\": trigger,\n        \"gate_reason\": str(args.gate_reason).strip(),\n        \"prior\": prior,\n        \"new\": paragraph,\n    }\n    # History append must succeed before the live file changes so a crash\n    # mid-write can never lose the prior version.\n    _append_jsonl(history_path, record)\n    _atomic_overwrite(conclusions_path, paragraph + \"\\n\")\n    return 0\n\n\ndef _run_append_event(args: argparse.Namespace) -> int:\n    \"\"\"Execute the default event-append mode.\"\"\"\n    if not args.global_memory_md or not args.global_memory_jsonl:\n        print(\n            \"append_memory: --global-memory-md and --global-memory-jsonl are required \"\n            \"in event-append mode\",\n            file=sys.stderr,\n        )\n        return 1\n    event_file = Path(args.event_file) if isinstance(args.event_file, str) and args.event_file else None\n    event = _ensure_required_fields(\n        _load_event(event_json=args.event_json, event_file=event_file),\n    )\n\n    local_memory_path = Path(args.local_memory_md)\n    global_memory_md_path = Path(args.global_memory_md)\n    global_memory_jsonl_path = Path(args.global_memory_jsonl)\n\n    _append_text(local_memory_path, _markdown_entry(event), header=LOCAL_MEMORY_HEADERS)\n    _append_text(global_memory_md_path, _markdown_entry(event), header=GLOBAL_MEMORY_HEADER)\n    _append_jsonl(global_memory_jsonl_path, event)\n    return 0\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    if args.write_conclusions:\n        return _run_write_conclusions(args)\n    return _run_append_event(args)\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
