:college_biology.json', 'sha256': '13caae6f05c5ffe3bfc3a3298677e4a19ea39cf7274a3c3cecd660161091c\nnormalization NFKC, whitespace collapse, LF, recursively sorted canonical JSON, integer-valued floats canonicalized to integers; no tokenization. Component hashes strip identifying cells/metadata; score-map hashes include task values and settings. Full raw source rows retained. Null distinct from missing.\nreconciliation {'revision_matched': 87, 'revision_mismatch_excluded': 3}\nsensitivity_limit Selected 90 deterministic lexicographically spaced models, latest available result per model at pinned results commit. Keep only exact model-sha matches and complete 24-BBH panels. Contents and results are distinct runs; no claim of equal evaluation settings or score equality. Sensitivity is separately reported, not scored or merged into primary six-task scores.\nlicense_assessment Public unauthenticated leaderboard score facts are used for noncommercial reproducible research with attribution. No separate score-data license identified; code/model licenses do not transfer. Derived raw-row extracts, not full mirrors; redistribution permission remains uncertain and must be reviewed before public release.\n    sizes = [len(bounded_json_line(value)) for value in (request,response,\n              {\"request\":request,\"rpc_id\":9999999,\"protocol\":\"python_rpc_v1\"},\n              {\"response\":response,\"rpc_id\":9999999,\"protocol\":\"python_rpc_v1\"})]\n    if max(sizes) >= WIRE_LIMIT:\n        raise ValueError(\"wire preflight failed\")\n    maximum_decision = {\"id\":\"9\"*8,\"matrix\":\"m\"*80,\"target\":9999,\"columns\":list(range(100)),\n                        \"rule\":\"trimmed\",\"alpha\":.25,\"node_budget\":20000}\n    maximum_run = {\"op\":\"run\",\"work_seconds\":19.999999999999996,\"matrices\":[{\"key\":\"m\"*80,\"shape\":[10000,100],\"offset\":64000000,\n                    \"task_ids\":[\"学\"*128+str(index) for index in range(100)]} for _ in range(2)],\n                   \"decisions\":[maximum_decision for _ in range(432)]}\n    bounded_json_line({\"request\":maximum_run,\"rpc_id\":9999999,\"protocol\":\"python_rpc_v1\"})\n    maximum_plans = {\"plans\":[{\"id\":\"9\"*8,\"selected\":list(range(100)),\"status\":\"infeasible\",\"lower_bound\":101} for _ in range(432)]}\n    bounded_json_line(maximum_plans)\n    trace = [operation for _ in range(episodes) for operation in\n             ([\"reset\"]+[\"upload\"]*64+[\"run\"]+[\"read\"]*16+[\"release\"])]\n    counts = dict(collections.Counter(trace))\n    if sum(counts.values()) > RPC_BUDGET or not smoke and sum(counts.values()) != RPC_BUDGET:\n        raise ValueError(\"operation-count budget mismatch\")\n    return counts\n\n\ndef paired_intervals(entries):\n    result = []\n    rng = np.random.default_rng(48271)\n    for entry in entries:\n        if entry[\"case\"] != \"ordinary\":\n            continue\n        rows = [row for row in entry[\"decisions\"] if row[\"panel\"] == \"primary\"]\n        if not rows:\n            result.append({\"family\":entry[\"family\"],\"complete\":False})\n            continue\n        for rule in RULES:\n            for alpha in (.25,.5,1.0):\n                selected = [row for row in rows if row[\"rule\"] == rule and row[\"alpha\"] == alpha]\n                clusters = sorted({row[\"cluster\"] for row in selected})\n                for baseline in (\"random\",\"greedy\"):\n                    differences = {cluster:fixed_mean([row[\"effort_fraction\"]-row[\"baseline\"][baseline][\"effort_fraction\"]\n                                   for row in selected if row[\"cluster\"] == cluster]) for cluster in clusters}\n                    values = np.array([differences[cluster] for cluster in clusters])\n                    replicates = np.mean(values[rng.integers(0,len(values),size=(200,len(values)))],axis=1)\n        updated[selected] += alpha * (1-updated[selected])\n        return aggregate(updated, rule) > threshold\n    size = len(columns)\n    result = {\"id\": decision[\"id\"], \"selected\": [], \"status\": \"bounded\", \"lower_bound\": 0}\n    if not wins(list(range(size))):\n        result.update(status=\"infeasible\", lower_bound=size+1)\n        return result\n    ordered = sorted(range(size), key=lambda index: task_ids[columns[index]])\n    if size <= 6:\n        for count in range(size+1):\n            for selected in itertools.combinations(ordered, count):\n                if wins(list(selected)):\n                    result.update(selected=[columns[index] for index in selected], status=\"optimal\", lower_bound=count)\n                    return result\n    if rule == \"mean\":\n        order = sorted(range(size), key=lambda index: (-(1-target_values[index]), task_ids[columns[index]]))\n        selected = []\n        for index in order:\n            if wins(selected):\n                break\n            selected.append(index)\n        result.update(selected=[columns[index] for index in selected], status=\"optimal\", lower_bound=len(selected))\n        return result\n    selected = []\n    current = target_values.copy()\n    while not wins(selected):\n        available = [index for index in ordered if index not in selected]\n        def key(index):\n            trial = current.copy()\n            trial[index] += alpha * (1-trial[index])\n            return (-aggregate(trial, rule), task_ids[columns[index]])\n        index = min(available, key=key)\n        selected.append(index)\n        current[index] += alpha * (1-current[index])\n    result[\"selected\"] = [columns[index] for index in selected]\n    return result\n\n\ndef handle(request):\n    operation = request[\"op\"]\n    if operation == \"reset\":\n        seed = request[\"seed\"]\n        if type(seed) is not int or seed < 0:\n            raise ValueError(\"invalid seed\")\n        _state.clear()\n        _state.update(seed=seed, chunks=[], output=None)\n        random.seed(seed)\n        return {\"ok\": True}\n    if operation == \"upload\":\n        index, total = request[\"index\"], request[\"total\"]\n        if request[\"dtype\"] != \"float64\" or request[\"byte_order\"] != \"little\" or request[\"encoding\"] != \"base64\":\n            raise ValueError(\"invalid encoding\")\n        if not 1 <= total <= 64 or not 1 <= request[\"total_bytes\"] <= 64*CHUNK_BYTES:\n            raise ValueError(\"invalid transfer bound\")\nnumpy==2.2.6\nscipy==1.15.3\npyarrow==19.0.1\nmatplotlib==3.10.3\n","exit_code":0,"status":"completed"}}
