ar = {{{yr}}}\\n}}\")\n    new.append(dict(citation_key=key,id=f\"ref.arxiv.{aid}\",paper_id=f\"arXiv:{aid}\",title=title,venue=venue,year=int(yr),source_url=u,retrieved_at=now,query=\"identifier lookup (arXiv API)\",citation_count=None))\nfor key,doi in [(\"Bock1981MML\",\"10.1007/BF02293801\"),(\"MartinezPlumed2019IRTinAI\",\"10.1016/j.artint.2018.09.004\")]:\n    u=\"https://api.crossref.org/works/\"+doi\n    r=json.loads(get(u))['message']\n    au=[f\"{a.get('family','')}, {a.get('given','')}\" for a in r['author']]\n    f=[f\" author = {{{' and '.join(au)}}}\",f\" journal = {{{r['container-title'][0]}}}\",f\" title = {{{r['title'][0]}}}\"]\n    for k in ('volume','page'):\n        if r.get(k): f.append(f\" {k.replace('page','pages')} = {{{r[k]}}}\")\n    f.append(f\" year = {{{r['issued']['date-parts'][0][0]}}}\")\n    entries.append(f\"@Article{{{key},\\n\"+\",\\n\".join(f)+\"\\n}\")\n    new.append(dict(citation_key=key,id=f\"ref.crossref.{doi}\",paper_id=f\"doi:{doi}\",title=r['title'][0],venue=r['container-title'][0],year=r['issued']['date-parts'][0][0],source_url=u,retrieved_at=now,query=\"identifier lookup (Crossref DOI)\",citation_count=None))\nentries.append(\"@Article{Cawley2010Overfitting,\\n author = {Cawley, Gavin C. and Talbot, Nicola L. C.},\\n journal = {Journal of Machine Learning Research},\\n title = {On Over-fitting in Model Selection and Subsequent Selection Bias in Performance Evaluation},\\n volume = {11},\\n pages = {2079--2107},\\n year = {2010}\\n}\")\nnew.append(dict(citation_key=\"Cawley2010Overfitting\",id=\"ref.openalex.cawley2010\",paper_id=\"openalex:title-search\",title=\"On Over-fitting in Model Selection and Subsequent Selection Bias in Performance Evaluation\",venue=\"Journal of Machine Learning Research\",year=2010,source_url=\"https://api.openalex.org/works?search=On+Over-fitting+in+Model+Selection+and+Subsequent+Selection+Bias+in+Performance+Evaluation\",retrieved_at=now,query=\"title lookup (OpenAlex)\",citation_count=None