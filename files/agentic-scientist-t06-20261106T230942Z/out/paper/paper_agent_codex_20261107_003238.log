date': [0.029885057471264367, 0.029885057471264367, 0.029885057471264367], 'random_flip_score': [0.00660919540229885, 0.0077586206896551714, 0.0072796934865900385], 'degree_matched_score': [0.007662835249042145, 0.009770114942528735, 0.009674329501915708], 'margin_heuristic_score': [0.0053639846743295016, 0.0053639846743295016, 0.0053639846743295016]}}, 'nba-2015': {'candidate': [0.011494252873563218, 0.04367816091954022, 0.06666666666666667], 'random_flip_score': [0.003544061302681992, 0.015996168582375476, 0.02614942528735632], 'degree_matched_score': [0.003927203065134099, 0.015134099616858236, 0.02461685823754789], 'margin_heuristic_score': [0.009195402298850575, 0.022988505747126436, 0.022988505747126436], 'counts': [1, 6, 13], 'seed_budget_means': {'candidate': [0.04061302681992337, 0.04061302681992337, 0.04061302681992337], 'random_flip_score': [0.017624521072796936, 0.014367816091954025, 0.013697318007662834], 'degree_matched_score': [0.014272030651340995, 0.014272030651340995, 0.015134099616858236], 'margin_heuristic_score': [0.01839080459770115, 0.01839080459770115, 0.01839080459770115]}}}}\n","exit_code":0,"status":"completed"}}
