{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"curl -L -s --max-time 25 'https://api.openalex.org/works/https://doi.org/10.48550/arXiv.1705.07874' | head -c 400; printf '\\\\n'; curl -L -s --max-time 25 'https://api.crossref.org/works/10.1038%2Fs41586-020-2649-2' | head -c 250; printf '\\\\n'; sed -n '1,90p' source_evidence/selected/logistic_fourier.py; sed -n '1190,1245p' task/evaluate_final.py; rg -n 'settings|budgets' task/evaluate_final.py | tail -8; sed -n '85,165p' source_evidence/selected/reliability.py\"","aggregated_output":"{\"id\": \"https://openalex.org/W2618851150\", \"doi\": \"https://doi.org/10.48550/arxiv.1705.07874\", \"title\": \"A Unified Approach to Interpreting Model Predictions\", \"display_name\": \"A Unified Approach to Interpreting Model Predictions\", \"publication_year\": 2017, \"publication_date\": \"2017-05-22\", \"ids\": {\"openalex\": \"https://openalex.org/W2618851150\", \"doi\": \"https://doi.org/10.48550/arxiv.1705.07874\", \n{\"status\": \"ok\", \"message-type\": \"work\", \"message-version\": \"1.0.0\", \"message\": {\"indexed\": {\"date-parts\": [[2026, 11, 7]], \"date-time\": \"2026-11-07T03:55:33Z\", \"timestamp\": 1794023733944, \"version\": \"4.8.0\"}, \"reference-count\": 57, \"publisher\": \"Spr\n\"\"\"Bounded probability-game Fourier/Owen integration; failure returns None.\n\nMesh agreement and endpoint efficiency are numerical diagnostics, not rigorous\ncoordinate-error certificates. No coalition predictions or random draws occur.\n\"\"\"\n\nimport math\n\nimport numpy as np\n\n\ndef _frequency_marginals(frequencies, base_logit, increments,\n                         inclusion_nodes, inclusion_weights):\n    phase_steps = np.exp(1j * frequencies[:, None] * increments[None, :])\n    mixture_factors = 1.0 - inclusion_nodes[None, :, None] + inclusion_nodes[None, :, None] * phase_steps[:, None, :]\n    ones = np.ones((*mixture_factors.shape[:2], 1), dtype=np.complex128)\n    prefix = np.concatenate((ones, np.cumprod(mixture_factors, axis=2)), axis=2)\n    suffix = np.concatenate((np.cumprod(mixture_factors[:, :, ::-1], axis=2)[:, :, ::-1], ones), axis=2)\n    excluded_products = prefix[:, :, :-1] * suffix[:, :, 1:]\n    t_integrals = np.einsum('q,fqj->fj', inclusion_weights, excluded_products)\n    complex_marginals = np.exp(1j * frequencies[:, None] * base_logit) * np.expm1(1j * frequencies[:, None] * increments[None, :]) * t_integrals\n    return np.imag(complex_marginals) / np.sinh(np.pi * frequencies[:, None])\n\n\ndef _frequency_mesh(base_logit, increments, inclusion_nodes, inclusion_weights,\n                    cutoff, panel_count, frequency_nodes, frequency_weights):\n    frequency_block_size = 32\n    panels_per_block = frequency_block_size // len(frequency_nodes)\n    panel_width = cutoff / panel_count\n    estimate = np.zeros(len(increments), dtype=np.float64)\n    for panel_start in range(0, panel_count, panels_per_block):\n        panel_indices = np.arange(panel_start, min(panel_count, panel_start + panels_per_block))\n        frequencies = (panel_width * (panel_indices[:, None] + 0.5 * (frequency_nodes + 1.0))).reshape(-1)\n        weights = np.tile(0.5 * panel_width * frequency_weights, len(panel_indices))\n        marginals = _frequency_marginals(frequencies, base_logit, increments,\n                                        inclusion_nodes, inclusion_weights)\n        if not np.all(np.isfinite(marginals)):\n            return None\n        estimate += weights @ marginals\n    return estimate\n\n\ndef _integrate_row(base_logit, increments, endpoint_difference,\n                   inclusion_nodes, inclusion_weights, frequency_nodes,\n                   frequency_weights):\n    cutoff = 8.0\n    tail_tolerance = 1e-10\n    quadrature_tolerance = 1e-8\n    efficiency_tolerance = 1e-8\n    maximum_frequency_nodes = 2048\n    tail_bound = -(2.0 / np.pi) * np.log(np.tanh(np.pi * cutoff / 2.0))\n    minimum_logit = base_logit + np.minimum(increments, 0.0).sum()\n    maximum_logit = base_logit + np.maximum(increments, 0.0).sum()\n    maximum_phase = max(abs(minimum_logit), abs(maximum_logit))\n    if not math.isfinite(maximum_phase):\n        return None\n    initial_panel_limit = maximum_frequency_nodes // (4 * len(frequency_nodes))\n    if maximum_phase > initial_panel_limit * (8.0 / cutoff):\n        return None\n    panel_count = max(1, math.ceil(cutoff * maximum_phase / 8.0))\n    required_frequency_nodes = 4 * panel_count * len(frequency_nodes)\n    if required_frequency_nodes > maximum_frequency_nodes:\n        return None\n    if tail_bound > tail_tolerance or not math.isfinite(endpoint_difference):\n        return None\n    coarse_phi = _frequency_mesh(base_logit, increments, inclusion_nodes,\n                                 inclusion_weights, cutoff, panel_count,\n                                 frequency_nodes, frequency_weights)\n    if coarse_phi is None or not np.all(np.isfinite(coarse_phi)):\n        return None\n    consecutive_agreements = 0\n    while True:\n        panel_count *= 2\n        required_frequency_nodes = panel_count * len(frequency_nodes)\n        if required_frequency_nodes > maximum_frequency_nodes:\n            return None\n        refined_phi = _frequency_mesh(base_logit, increments, inclusion_nodes,\n                                      inclusion_weights, cutoff, panel_count,\n                                      frequency_nodes, frequency_weights)\n        if refined_phi is None:\n            return None\n        if not np.all(np.isfinite(refined_phi)):\n            return None\n        discretization_error = np.max(np.abs(refined_phi - coarse_phi))\n        efficiency_error = abs(refined_phi.sum() - endpoint_difference)\n        if tail_bound <= tail_tolerance and discretization_error <= quadrature_tolerance and efficiency_error <= efficiency_tolerance:\n            consecutive_agreements += 1\n            if consecutive_agreements >= 2:\n                return refined_phi\n        else:\n\n\ndef preflight():\n    for plane,expected in [('search',365),('final',664)]:\n        table,total = production_counts(plane)\n        if total!=expected or total>10000000:\n            raise RuntimeError('RPC preflight mismatch')\n        mock_count = 0\n        for row in table.values():\n            for episode in range(row['episodes']):\n                mock_count += 1\n                for transfer in range(row['model_start']):\n                    mock_count += 1\n                    for chunk in range(MAX_CHUNKS):\n                        mock_count += 1\n                    mock_count += 1\n                mock_count += row['explain']\n        if mock_count!=total:\n            raise RuntimeError('maximum protocol trace mismatch')\n    if production_counts(PLANE)[1]!=RPC_BUDGET:\n        raise RuntimeError('RPC declaration mismatch')\n    chunk = {'op':'model_chunk','token':'a'*64,'index':15,'data':base64.b64encode(b'\\xff'*MAX_CHUNK_BYTES).decode()}\n    messages = [chunk,{'ok':True},{'attributions':[[1000000.0]*20]*16},\n                {'op':'explain','queries':[[-1.7976931348623157e308]*20]*16,'budget':8192,'workload':{'usable_seconds':10800.0,'remaining_explanations':18}},\n                {'op':'model_start','token':'a'*64,'nbytes':MAX_DOCUMENT_BYTES,'sha256':'f'*64,'encoding':'base64','dtype':'uint8','shape':[MAX_DOCUMENT_BYTES],'content_type':'application/json'}]\n    for message in messages:\n        validate_message(message)\n        bounded_json_line({'id':9223372036854775807,'request':message})\n        bounded_json_line({'id':9223372036854775807,'response':message})\n    if len(chunk['data'])!=4*((MAX_CHUNK_BYTES+2)//3):\n        raise RuntimeError('base64 expansion mismatch')\n    tree = {'left':[126]*127,'right':[126]*127,'feature':[19]*127,'threshold':[-1.7976931348623157e308]*127,'probability':[.9999999999999999]*127}\n    representative = {'kind':'forest','dimension':20,'background':[[-1.7976931348623157e308]*20]*16,'parameters':{'trees':[tree]*64}}\n    if len(compact(representative))>MAX_DOCUMENT_BYTES:\n        raise RuntimeError('largest model bound')\n    raw = b'x'*MAX_DOCUMENT_BYTES\n    reconstructed = hashlib.sha256()\n    for index,offset in enumerate(range(0,len(raw),MAX_CHUNK_BYTES)):\n        message = {'op':'model_chunk','token':'a'*64,'index':index,'data':base64.b64encode(raw[offset:offset+MAX_CHUNK_BYTES]).decode()}\n        validate_message(message)\n        reconstructed.update(base64.b64decode(message['data']))\n    if reconstructed.digest()!=hashlib.sha256(raw).digest():\n        raise RuntimeError('maximum upload mock integrity')\n    require_joint_workload_budget(search={'episode_count':11,'method_count':5,'wall_seconds':3600,'startup_seconds':300,'reset_seconds':5,'cleanup_seconds':1.2,'finish_seconds':90,'work_seconds':50},\n                                  final={'episode_count':16,'method_count':5,'wall_seconds':10800,'startup_seconds':600,'reset_seconds':5,'cleanup_seconds':1.2,'finish_seconds':90,'work_seconds':110})\n\n\ndef verify_resources(root):\n    for filename,expected in RESOURCE_HASHES.items():\n        path = root/filename\n        if path.is_symlink() or not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest()!=expected:\n            raise RuntimeError('frozen resource integrity failed')\n    provenance = json.loads((root/'provenance.json').read_text())\n    if provenance['cross_plane_retained_content_intersection']!=0:\n        raise RuntimeError('split content overlap')\n\n1283:        score = .8*float(np.mean([empirical_summary(outcome,settings)[0] for outcome in empirical]))+.2*float(np.mean([outcome['controls'] for outcome in controls]))\n1317:    settings = {'instances':2 if smoke else 8 if PLANE=='search' else 16,'background':4 if smoke else 16,\n1318:                'repetitions':2 if smoke else 4 if PLANE=='search' else 6,'budgets':[16] if smoke else [64,256] if PLANE=='search' else [64,256,1024]}\n1325:    episodes = make_episodes(seeds,settings)\n1337:                    evaluate=lambda episode,call,deadline:evaluate_episode(episode,call,deadline,settings=settings,root=root,work_seconds=work_seconds,smoke=smoke),\n1342:        metrics,correct = aggregate(outcomes,settings,complete,elapsed)\n1344:        write_results(arguments.results_dir,metrics,correct,feasible,evidence_records(outcomes,settings))\n1357:            metrics,_ = aggregate(outcomes,settings,False,float(WALL_SECONDS))\n    if not np.allclose(path_marginals.sum(axis=1), endpoints[1] - endpoints[0], atol=1e-10, rtol=0):\n        raise ValueError('incomplete permutation path')\n    return path_marginals, masks\n\n\ndef simultaneous_certificate(path_marginals, alpha=0.05):\n    \"\"\"At most alpha unconditional wrong-certificate probability per fixed call.\n\n    The bound is on independent complete-path means, never regression estimates.\n    It is not a conditional-on-acceptance guarantee. Strict separation rejects\n    ties, with original column order breaking estimate ties deterministically.\n    \"\"\"\n    path_count, feature_count = path_marginals.shape\n    if path_count < 2 or not 0 < alpha < 1:\n        raise ValueError('certificate requires two paths and valid alpha')\n    estimate = path_marginals.mean(axis=0)\n    sample_variance = path_marginals.var(axis=0, ddof=1)\n    log_term = np.log(4.0 * feature_count / alpha)\n    radius = np.sqrt(2.0 * sample_variance * log_term / path_count) + 14.0 * log_term / (3.0 * (path_count - 1))\n    magnitude_lower = np.maximum(0.0, np.abs(estimate) - radius)\n    magnitude_upper = np.abs(estimate) + radius\n    order = np.argsort(-np.abs(estimate), kind='stable')\n    selected = order[:min(3, feature_count - 1)]\n    excluded = order[min(3, feature_count - 1):]\n    topk_certified = bool(magnitude_lower[selected].min() > magnitude_upper[excluded].max())\n    signs_certified = bool(np.all(np.abs(estimate[selected]) > radius[selected]))\n    certified = topk_certified and signs_certified\n    return estimate, radius, certified\n\n\ndef sampled_kernel_masks(feature_count, count, rng):\n    \"\"\"Kernel-distributed subsets with complement pairing only for regression.\"\"\"\n    sizes = np.arange(1, feature_count)\n    probabilities = 1.0 / (sizes * (feature_count - sizes))\n    probabilities /= probabilities.sum()\n    masks = np.empty(count, dtype=np.uint32)\n    full = (1 << feature_count) - 1\n    for offset in range(0, count, 2):\n        size = int(rng.choice(sizes, p=probabilities))\n        selected = rng.choice(feature_count, size=size, replace=False)\n        mask = sum(1 << int(feature) for feature in selected)\n        masks[offset] = mask\n        if offset + 1 < count:\n            masks[offset + 1] = full ^ mask\n    return masks\n\n\ndef kernel_regression(game, masks, path_mask_count):\n    \"\"\"Importance-weight the path/kernel mixture for the SHAP kernel objective.\n\n    Path prefixes are uniform conditional on size, but not kernel-distributed\n    across sizes. Their dependence is irrelevant to the point regression; no\n    certificate is constructed from these fitted coefficients.\n    \"\"\"\n    feature_count = game.dimension\n    design = ((masks[:, None] >> np.arange(feature_count)) & 1).astype(float)\n    sizes = design.sum(axis=1).astype(int)\n    possible_sizes = np.arange(1, feature_count)\n    size_probabilities = 1.0 / (possible_sizes * (feature_count - possible_sizes))\n    size_probabilities /= size_probabilities.sum()\n    kernel_probability = size_probabilities[sizes - 1]\n    path_fraction = path_mask_count / len(masks)\n    mixture_probability = path_fraction / (feature_count - 1) + (1.0 - path_fraction) * kernel_probability\n    root_weights = np.sqrt(kernel_probability / mixture_probability)\n    empty, full = game.values([0, (1 << feature_count) - 1])\n    delta = full - empty\n    target = game.values(masks) - empty - sizes * delta / feature_count\n    basis = np.zeros((feature_count, feature_count - 1))\n    for column in range(feature_count - 1):\n        scale = math.sqrt((column + 1) * (column + 2))\n        basis[:column + 1, column] = 1.0 / scale\n        basis[column + 1, column] = -(column + 1) / scale\n    coefficients = np.linalg.lstsq((design @ basis) * root_weights[:, None], target * root_weights, rcond=1e-12)[0]\n    estimate = np.full(feature_count, delta / feature_count) + basis @ coefficients\n    estimate += (delta - estimate.sum()) / feature_count\n    return estimate\n\n\ndef explain_fixed_game(model, query, budget, rng, predict):\n    \"\"\"Spend at most the requested nontrivial-coalition sampling budget.\n\n","exit_code":0,"status":"completed"}}
