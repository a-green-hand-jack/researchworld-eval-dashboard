e_probs = make_particles(profile_probs, offset_scale)\n   280\t        particle_log_prior = particle_prior(source_groups)\n   281\t        particles = (particle_probs, particle_log_prior, particle_probs.sum(axis=1))\n   282\t    return query_order, models, mixture_weight, particles\n   283\t\n   284\t\n   285\tdef handle(request):\n   286\t    operation = request['op']\n   287\t    if operation == 'reset':\n   288\t        if type(request['seed']) is not int or request['seed'] < 0:\n   289\t            raise ValueError('invalid seed')\n   290\t        STATE.clear()\n   291\t        STATE['seed'] = request['seed']\n   292\t        STATE['received'] = 0\n   293\t        return {'ok': True}\n   294\t    if operation == 'source_chunk':\n   295\t        shape = request['shape']\n   296\t        total = request['total_bytes']\n   297\t        if len(shape) != 2 or not (1 <= shape[0] <= 512 and 1 <= shape[1] <= 16384):\n   298\t            raise ValueError('invalid source shape')\n   299\t        if request['encoding'] != 'base64' or request['dtype'] != 'uint8':\n   300\t            raise ValueError('invalid source encoding')\n   301\t        if request['offset'] != STATE['received'] or total != int(np.prod(shape)) or total > 8388608:\n   302\t            raise ValueError('invalid source transfer')\n   303\t        if request['offset'] == 0:\n   304\t            STATE['buffer'] = bytearray(total)\n   305\t            STATE['shape'] = shape\n1395:  \"schema_name\": \"scientific-evidence.verification-report\",\n1398:    \"dangling_references\": 0,\n/bin/sh: 80: /usr/bin/time: not found\n","exit_code":0,"status":"completed"}}
