": {\n  \"idea\": \"model variant\",\n  \"ideas\": \"model variants\",\n  \"implementation\": \"configuration\",\n  \"implementations\": \"configurations\",\n  \"program\": \"seeded run\",\n  \"programs\": \"seeded runs\"\n },\n \"run_unit\": \"seeded_run\",\n \"threshold_rate_rule\": \"If a thresholded rate appears in the visible paper, keep one reader-facing meaning per figure, such as target attainment, successful-run fraction, or non-collapse rate. Do not reuse a single label for different task-specific thresholds.\",\n \"variant_unit\": \"model_variant\"\n}\n== totals\n{\n \"attempts\": 3,\n \"correct_programs\": 3,\n \"evaluated_programs\": 3,\n \"ideas\": 3\n}\n{\n \"final.evidence.episodes\": {\n  \"candidate_diagnostics_trust\": \"unverified\",\n  \"episode_count\": 3,\n  \"evaluation_scope\": \"sealed_final\",\n  \"id\": \"final.evidence.episodes\",\n  \"json_pointer\": \"/episodes\",\n  \"manifest_path\": \"work/results/r03/claude/20261111_111139/final_evaluation/final_manifest.json\",\n  \"path\": \"work/results/r03/claude/20261111_111139/final_evaluation/results/evaluation_evidence.json\",\n  \"program_tree_sha256\": \"sha256:3f76de56b20aa4546ca3e259259008c0a78bdbab63f7245bdeba7fde17663b4c\",\n  \"results_tree_sha256\": \"sha256:73f64e315e6913061115ca0ba995eb84a53704272e7af1baa99df4b1d19f304a\",\n  \"sha256\": \"sha256:26966a50c1c4070fdbd871540e0dae6d618ed2e0671e2a90def2f038b4f6aded\",\n  \"type\": \"evaluation_evidence\"\n },\n \"final.metric.final_nrmse\": {\n  \"evaluation_scope\": \"sealed_final\",\n  \"id\": \"final.metric.final_nrmse\",\n  \"manifest_path\": \"work/results/r03/claude/20261111_111139/final_evaluation/final_manifest.json\",\n  \"results_tree_sha256\": \"sha256:73f64e315e6913061115ca0ba995eb84a53704272e7af1baa99df4b1d19f304a\",\n  \"type\": \"metric\",\n  \"value\": 0.5617416662354449\n },\n \"final.metric.final_nrmse_helm\": {\n  \"evaluation_scope\": \"sealed_final\",\n  \"id\": \"final.metric.final_nrmse_helm\",\n  \"manifest_path