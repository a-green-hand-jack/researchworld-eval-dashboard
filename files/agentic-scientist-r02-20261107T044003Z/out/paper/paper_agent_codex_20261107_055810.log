{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/sh -lc \"sed -n '1428,1485p' task/evaluate_final.py; sed -n '1347,1375p' task/evaluate_final.py; cat task/README.md 2>/dev/null | head -50; sed -n '125,170p' source_evidence/interpolated.py; sed -n '85,130p' source_evidence/single_split.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/sh -lc \"sed -n '1428,1485p' task/evaluate_final.py; sed -n '1347,1375p' task/evaluate_final.py; cat task/README.md 2>/dev/null | head -50; sed -n '125,170p' source_evidence/interpolated.py; sed -n '85,130p' source_evidence/single_split.py\"","aggregated_output":"def main():\n    if sys.argv[1:] == ['--baseline-worker']:\n        baseline_worker()\n        return\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--program_path', required=True)\n    parser.add_argument('--results_dir', required=True)\n    args = parser.parse_args()\n    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))\n    resource.setrlimit(resource.RLIMIT_AS, (8 * 1024**3, 8 * 1024**3))\n    existing = resource.getrlimit(resource.RLIMIT_CPU)\n    ceiling = cpu_limit_seconds(WALL_SECONDS, 4)\n    hard = ceiling if existing[1] == resource.RLIM_INFINITY else min(ceiling, existing[1])\n    resource.setrlimit(resource.RLIMIT_CPU, (hard, hard))\n    run(args.program_path, args.results_dir)\n\n\nif __name__ == '__main__':\n    try:\n        main()\n    except Exception as error:\n        if PLANE == 'search':\n            name = bounded_failure_name(type(error).__name__.lower(), 'evaluator_exception')\n            print('evaluator_exception type=' + name + ' message=evaluation failed', file=sys.stderr, flush=True)\n        else:\n            print('evaluator_exception type=sealed_failure message=evaluation failed', file=sys.stderr, flush=True)\n        raise SystemExit(1)\ndef run(program_path, results_dir):\n    smoke = os.environ.get('AGENTIC_TASK_DRAFT_SMOKE') == '1'\n    qualification = os.environ.get('AGENTIC_TASK_QUALIFICATION') == '1'\n    statistical_seeds = SEEDS[:1] if smoke else SEEDS\n    episodes = [{'case': case, 'seed': seed} for case in CASE_IDS for seed in statistical_seeds]\n    episodes.append({'case': 'C1', 'seed': statistical_seeds[0]})\n    work_seconds = 1. if smoke else (10. if PLANE == 'search' else 30.)\n    reset_timeout = 2. if smoke else 5.\n    startup_allowance = 3. if smoke else 60.\n    finish_reserve = 5. if smoke else 20.\n    wall = 120. if smoke else WALL_SECONDS\n    hard_deadline = STARTED + wall - startup_allowance\n    profiles = {}\n    for plane, count, limit, allowance in (('search', 19, 1200, 10), ('final', 31, 3600, 30)):\n        profiles[plane] = {'episode_count': count, 'method_count': 3, 'wall_seconds': limit,\n                          'startup_seconds': 80, 'finish_seconds': 20, 'reset_seconds': 7,\n                          'cleanup_seconds': 3, 'work_seconds': allowance}\n    require_joint_workload_budget(**profiles)\n    theoretical_checks()\n    preflight_wire()\n    results_dir = Path(results_dir)\n    results_dir.mkdir(parents=True, exist_ok=True)\n    outcomes = [worst_case(episode) for episode in episodes]\n    complete = False\n    client = None\n    try:\n        root = Path(os.environ.get('TASK_SOURCE_DIR', str(Path(__file__).absolute().parent))) / 'resources' / PLANE\n        datasets = load_resources(root, hard_deadline - finish_reserve)\n        client = Candidate(program_path, work_seconds, reset_timeout)\n    fold_ids = np.arange(len(covariates)) % fold_count\n    oof_residuals = np.empty_like(transformed)\n    for fold_index in range(fold_count):\n        held_out = fold_ids == fold_index\n        fold_location = ridge(design[~held_out], transformed[~held_out], 0.01)\n        oof_residuals[held_out] = transformed[held_out] - design[held_out] @ fold_location\n    final_location = ridge(design, transformed, 0.01)\n    variance = ridge(design, np.log(oof_residuals ** 2 + 0.02), 5.0)\n    train_boundary_scores = predicted_boundary(design @ final_location, basis)\n    boundary_edges = np.quantile(train_boundary_scores, [1.0 / 3.0, 2.0 / 3.0])\n    residual_groups = boundary_groups(train_boundary_scores, boundary_edges)\n    scales = np.exp(0.5 * np.clip(design @ variance, -6, 5))\n    standardized = np.clip(oof_residuals / scales, -1000.0, 1000.0)\n    identity = np.eye(dimension)\n    pooled_shape = (standardized.T @ standardized + 8.0 * identity) / (len(oof_residuals) + 8.0)\n    group_shapes = np.empty((3, dimension, dimension))\n    for group_index in range(3):\n        group_residuals = standardized[residual_groups == group_index]\n        group_shape = (group_residuals.T @ group_residuals + 32.0 * pooled_shape) / (len(group_residuals) + 32.0)\n        group_shapes[group_index] = group_shape\n    anchor_knots = np.quantile(train_boundary_scores, [1.0 / 6.0, 0.5, 5.0 / 6.0])\n    shape_knots, anchor_inverse = np.unique(anchor_knots, return_inverse=True)\n    shape_matrices = np.stack([group_shapes[anchor_inverse == knot_index].mean(axis=0) for knot_index in range(len(shape_knots))])\n    return final_location, variance, shape_knots, shape_matrices\n\n\ndef handle(request):\n    operation = request['op']\n    if operation == 'reset':\n        if set(request) != {'op', 'seed'} or type(request['seed']) is not int or not 0 <= request['seed'] < 2**63:\n            raise ValueError('invalid reset')\n        STATE.clear()\n        STATE['rng'] = np.random.default_rng(request['seed'])\n        return {'ok': True}\n    if 'rng' not in STATE:\n        raise ValueError('reset required')\n    if operation == 'fit_start':\n        if 'upload' in STATE or 'model' in STATE:\n            raise ValueError('one fit per reset')\n        rows, size = request['n_rows'], request['composition_dim']\n        if type(rows) is not int or not 1 <= rows <= 4096 or size not in (3, 8):\n            raise ValueError('invalid training shape')\n        raw_size = rows * (5 + size) * 8\n        if request['nbytes'] != raw_size or request['chunks'] != math.ceil(raw_size / CHUNK):\n            raise ValueError('invalid transfer')\n        basis = np.asarray(request['ilr_basis'], dtype=float)\n\n\ndef ridge(design, targets, penalty):\n    return np.linalg.solve(design.T @ design + penalty * np.eye(design.shape[1]), design.T @ targets)\n\n\ndef predicted_boundary(means, basis):\n    logits = means @ basis.T\n    weights = np.exp(logits - logits.max(axis=-1, keepdims=True))\n    predictions = weights / weights.sum(axis=-1, keepdims=True)\n    return predictions.min(axis=-1)\n\n\ndef boundary_groups(predicted_boundary_score, boundary_edges):\n    boundary_group = np.searchsorted(boundary_edges, predicted_boundary_score, side='right')\n    return boundary_group\n\n\ndef fit_model(covariates, responses, basis):\n    transformed = np.log(responses) @ basis\n    design = features(covariates)\n    dimension = basis.shape[1]\n    if len(covariates) < 4:\n        location = ridge(design, transformed, 0.01)\n        variance = np.zeros((design.shape[1], dimension))\n        train_boundary_scores = predicted_boundary(design @ location, basis)\n        boundary_edges = np.quantile(train_boundary_scores, [1.0 / 3.0, 2.0 / 3.0])\n        group_factors = np.repeat(np.eye(dimension)[None, :, :], 3, axis=0)\n        return location, variance, boundary_edges, group_factors\n    cut = 3 * len(covariates) // 4\n    location = ridge(design[:cut], transformed[:cut], 0.01)\n    residuals = transformed[cut:] - design[cut:] @ location\n    variance = ridge(design[cut:], np.log(residuals ** 2 + 0.02), 5.0)\n    train_boundary_scores = predicted_boundary(design @ location, basis)\n    boundary_edges = np.quantile(train_boundary_scores, [1.0 / 3.0, 2.0 / 3.0])\n    residual_groups = boundary_groups(train_boundary_scores[cut:], boundary_edges)\n    scales = np.exp(0.5 * np.clip(design[cut:] @ variance, -6, 5))\n    standardized = np.clip(residuals / scales, -1000.0, 1000.0)\n    identity = np.eye(dimension)\n    pooled_shape = (standardized.T @ standardized + 8.0 * identity) / (len(residuals) + 8.0)\n    group_factors = np.empty((3, dimension, dimension))\n    for group_index in range(3):\n        group_residuals = standardized[residual_groups == group_index]\n        group_shape = (group_residuals.T @ group_residuals + 32.0 * pooled_shape) / (len(group_residuals) + 32.0)\n        group_factors[group_index] = np.linalg.cholesky(group_shape)\n    return location, variance, boundary_edges, group_factors\n","exit_code":0,"status":"completed"}}
