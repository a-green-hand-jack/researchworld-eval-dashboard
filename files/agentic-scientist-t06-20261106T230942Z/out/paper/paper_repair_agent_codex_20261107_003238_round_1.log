ore)==1, (path,before)\n  content=content.replace(before,after,1)\n path.write_text(content); print(\\\"Updated\\\",path)\n'\n}\napply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: build_figures.py\n@@\n def save(figure, figure_id):\n     for extension in ['pdf', 'png']:\n         path = FIGURES / f'{figure_id}.{extension}'\n-        figure.savefig(path, dpi=300, facecolor='white')\n+        options = {'dpi': 300, 'facecolor': 'white'}\n+        if extension == 'png':\n+            options['dpi'] = max(300, 2400 / figure.get_figwidth())\n+            options['pil_kwargs'] = {'dpi': (300, 300)}\n+        figure.savefig(path, **options)\n         sidecar(path)\n@@\n specs = json.loads((ROOT / 'paper_strategy.json').read_text())['figure_specs']\n+manifest_path = ROOT / 'figure_manifest.json'\n+existing_figures = {\n+    entry['figure_id']: entry\n+    for entry in json.loads(manifest_path.read_text()).get('figures', [])\n+} if manifest_path.exists() else {}\n manifest = {'figures': []}\n for spec in specs:\n     concept = spec['figure_type'] == 'diagram'\n     figure_id = spec['figure_id']\n+    if concept and figure_id in existing_figures:\n+        manifest['figures'].append(existing_figures[figure_id])\n+        continue\n     panels = 2 if concept else 3\n     entry = {\n-        'figure_id': figure_id, 'figure_type': {'grouped_dot': 'scatter', 'forest': 'composite'}.get(spec['figure_type'], spec['figure_type']),\n+        'figure_id': figure_id, 'figure_type': spec['figure_type'],\n*** End Patch\nPATCH\n\\\"\"'$VENV_PY\" build_figures.py\npython .codex/skills/validate-paper/scripts/validate_tex_refs.py --tex paper.tex --bib references.bib\npython .codex/skills/write-paper-standalone/scripts/validate_claims.py --paper-data paper_data.json --references references_provenance.json --bib references.bib --claims claims_grounding.json --paper-dir .'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
