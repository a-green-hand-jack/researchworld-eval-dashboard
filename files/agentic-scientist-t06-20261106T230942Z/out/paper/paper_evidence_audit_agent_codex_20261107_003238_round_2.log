{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/prepare_data.py | sed -n '1,89p'\"","aggregated_output":"     1\t\"\"\"Pinned, offline-capable preparation: python prepare_data.py --arena data/train.csv --nba data/nbaallelo.csv.\n     2\tRaw downloads stay outside the submission; this deterministic script records all derived provenance.\n     3\t\"\"\"\n     4\timport argparse\n     5\timport csv\n     6\timport hashlib\n     7\timport json\n     8\timport pathlib\n     9\timport unicodedata\n    10\tfrom collections import defaultdict\n    11\t\n    12\tSOURCES = {\n    13\t    \"arena\": (\"18c298340948c0e7f7727399fd459cca6ce0ca6f\", \"0692154aaf20fc6649090c3f49b6b5dd1e693a765ecb5f0856ae0da5946f5be2\"),\n    14\t    \"nba\": (\"4c1ff5e3aef1816ae04af63218015066e186c147\", \"d46ed3540ee8d9eca31b3e94cc8c777e0be5156173d814ebf65b8195e8d616bc\"),\n    15\t}\n    16\t\n    17\t\n    18\tdef canonical(value):\n    19\t    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False)\n    20\t\n    21\t\n    22\tdef digest(value):\n    23\t    return hashlib.sha256(canonical(value).encode()).hexdigest()\n    24\t\n    25\t\n    26\tdef normalize(value, strict=False):\n    27\t    if isinstance(value, str):\n    28\t        value = unicodedata.normalize(\"NFKC\" if strict else \"NFC\", value.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\"))\n    29\t        return \" \".join(value.split()) if strict else value\n    30\t    if isinstance(value, list):\n    31\t        return [normalize(item, strict) for item in value]\n    32\t    return value\n    33\t\n    34\t\n    35\tdef prepare(arena_path, nba_path, root):\n    36\t    for name, path in ((\"arena\", arena_path), (\"nba\", nba_path)):\n    37\t        if hashlib.sha256(path.read_bytes()).hexdigest() != SOURCES[name][1]:\n    38\t            raise ValueError(\"source checksum mismatch: \" + name)\n    39\t    csv.field_size_limit(16 * 1024 * 1024)\n    40\t    arena, parent, owners = [], [], {}\n    41\t\n    42\t    def find(index):\n    43\t        while parent[index] != index:\n    44\t            parent[index] = parent[parent[index]]\n    45\t            index = parent[index]\n    46\t        return index\n    47\t\n    48\t    with arena_path.open(newline=\"\", encoding=\"utf-8\") as stream:\n    49\t        for source_row, row in enumerate(csv.DictReader(stream), 2):\n    50\t            model_a, model_b = row[\"model_a\"], row[\"model_b\"]\n    51\t            flags = [int(row[key]) for key in (\"winner_model_a\", \"winner_model_b\", \"winner_tie\")]\n    52\t            if sum(flags) != 1 or model_a == model_b:\n    53\t                continue\n    54\t            outcome = 1.0 if flags[0] else 0.0 if flags[1] else 0.5\n    55\t            prompt, answer_a, answer_b = [json.loads(row[key]) for key in (\"prompt\", \"response_a\", \"response_b\")]\n    56\t            hashes = set()\n    57\t            for strict in (False, True):\n    58\t                documents = [normalize(doc, strict) for doc in (prompt, answer_a, answer_b)]\n    59\t                hashes.update(digest(doc) for doc in documents if any(str(item).strip() for item in doc))\n    60\t                left = [model_a, documents[1]]\n    61\t                right = [model_b, documents[2]]\n    62\t                if canonical(left) > canonical(right):\n    63\t                    left, right, mapped = right, left, 1 - outcome\n    64\t                else:\n    65\t                    mapped = outcome\n    66\t                hashes.add(digest([documents[0], left, right, mapped]))\n    67\t            index = len(arena)\n    68\t            parent.append(index)\n    69\t            for content_hash in sorted(hashes):\n    70\t                if content_hash in owners:\n    71\t                    parent[find(index)] = find(owners[content_hash])\n    72\t                else:\n    73\t                    owners[content_hash] = index\n    74\t            arena.append({\"source_id\": row[\"id\"], \"source_row\": source_row, \"a\": model_a, \"b\": model_b,\n    75\t                          \"y\": outcome, \"z\": 0.0, \"hashes\": sorted(hashes)})\n    76\t    members = defaultdict(list)\n    77\t    for index in range(len(arena)):\n    78\t        members[find(index)].append(index)\n    79\t    panels = {\"search\": {\"arena\": []}, \"final\": {\"arena\": []}}\n    80\t    for indices in members.values():\n    81\t        group = min(content_hash for index in indices for content_hash in arena[index][\"hashes\"])\n    82\t        plane = \"search\" if int(hashlib.sha256((\"split-v1:\" + group).encode()).hexdigest(), 16) % 4 == 0 else \"final\"\n    83\t        for index in indices:\n    84\t            arena[index][\"group\"] = group\n    85\t            panels[plane][\"arena\"].append(arena[index])\n    86\t    games = defaultdict(list)\n    87\t    with nba_path.open(newline=\"\", encoding=\"utf-8\") as stream:\n    88\t        for source_row, row in enumerate(csv.DictReader(stream), 2):\n    89\t            if int(row[\"year_id\"]) in (2006, 2007, 2008, 2011, 2012, 2013, 2014, 2015):\n","exit_code":0,"status":"completed"}}
