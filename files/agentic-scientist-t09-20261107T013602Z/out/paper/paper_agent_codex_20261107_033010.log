per_id': 'ad8b18c5a4b90f25f2e4680e3f65aca505185511', 'query': '\"Regression adjustments for estimating the global treatment effect in experiments with interference\" Chin', 'retrieved_at': '2026-11-07T03:34:24.557091+00:00', 'source_url': 'https://api.semanticscholar.org/graph/v1/paper/ad8b18c5a4b90f25f2e4680e3f65aca505185511?fields=paperId%2Ctitle%2Cyear%2Cvenue%2CcitationCount%2CcitationStyles%2Curl', 'title': 'Regression Adjustments for Estimating the Global Treatment Effect in Experiments with Interference', 'venue': 'Journal of Causal Inference', 'year': 2018}\n\\documentclass{article}\n% --- watermark (auto-inserted) ---\n\\usepackage{xcolor}\n\\usepackage{xfp}% \\fpeval; in the kernel since 2022, harmless on older LaTeX\n\\usepackage{draftwatermark}\n\\newlength{\\watermarkTextWidth}\n\\AddToHook{begindocument/end}{%\n  \\SetWatermarkText{\\normalfont Generated by The Agentic Scientist}%\n  \\SetWatermarkFontSize{10pt}%\n  \\SetWatermarkLightness{0.85}%\n  \\settowidth{\\watermarkTextWidth}{\\normalfont\\fontsize{10pt}{12pt}\\selectfont Generated by The Agentic Scientist}%\n  \\edef\\watermarkScale{\\fpeval{0.8 * sqrt(\\paperwidth**2 + \\paperheight**2) / \\watermarkTextWidth}}%\n  \\edef\\watermarkAngle{\\fpeval{atand(\\paperheight/\\paperwidth)}}%\n  \\SetWatermarkScale{\\watermarkScale}%\n  \\SetWatermarkAngle{\\watermarkAngle}%\n}\n% --- end watermark ---\n % For LaTeX2e\n\\usepackage{paper,times}\n\n\\usepackage{hyperref}\n\\usepackage{url}\n\n\\title{Grounded Experimental Summary}\n\\iclrfinalcopy\n\\author{The Agentic Scientist}\n\n\\begin{document}\n\\maketitle\n\n\\begin{abstract}\nReplace with a concise grounded abstract summarizing setup, core result, and takeaway.\n\\end{abstract}\n\n\\section{Introduction}\nReplace with grounded motivation, problem framing, and contributions.\n\n\\section{Related Work}\nSummarize relevant prior work using citation keys present in references.bib (for example, \\citep{templateReference2026}).\n\n\\section{Method}\nDescribe data, setup, and method details needed for reproducibility.\n\n\\section{Results}\nReport grounded quantitative and qualitative findings. Include figures and tables when useful.\n\n\\section{Conclusion}\nState key findings, limitations, and next steps supported by evidence.\n\n% IMPORTANT: \\clearpage flushes all pending floats before references so that\n% body-page counting excludes reference-only pages.  Do NOT remove.\n\\clearpage\n\\bibliography{references}\n\\bibliographystyle{paper}\n\n\\clearpage\n\\appendix\n\\section{Supplementary Information}\n% REQUIRED: Replace this scaffold with substantive grounded content.\n\\subsection{Reproducibility Details}\nReplace with grounded extended methods, reproducibility details, additional analyses, or supporting tables and figures.\n\n\\end{document}\ncapture.py\nevaluate.py\nevaluate_final.py\nprogram_0\nrequirements.txt\nresources\ntask.md\ntask_contract.json\n_idea_generation\nattempts_history.jsonl\nbest_program_manifest.json\nconclusions.md\nconclusions_history.jsonl\nconclusions_other_workers.md\nevents.jsonl\nidea_generation_failures.jsonl\nideas\nideas_history.jsonl\nlatest_run_manifest.json\nmemory.jsonl\nmemory.md\nouter_state.json\ntask\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/active_idea.json\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/evaluate.py\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/task.md\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/idea_generation_wrapper_output.log\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/rubric_status.json\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/agent_codex_20261107_031607.log\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/idea_bundle.json\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/memory.md\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/target_rubrics.json\nresults/ideas/03_endpoint_contrast_sure_for_exposure_regression/program_1/correct.json\n\"\"\"Offline, evaluator-owned GATE experiment; candidate outputs are predictions only.\"\"\"\n\nimport time\n\nSTART = time.monotonic()\n\nimport argparse\nimport base64\nimport collections\nimport contextlib\nimport ctypes\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport resource\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport zipfile\n\nfor _thread_name in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):\n    os.environ[_thread_name] = '1'\n\nimport networkx as nx\nimport numpy as np\nfrom scipy import sparse\n\nPLANE = 'final'\nMANIFEST_SHA256 = 'af45e7f31ed7c4628090550af80080d3a4ee609b12424b60d96738b426953eba'\nWALL = 900 if PLANE == 'search' else 7200\nSTARTUP = 30 if PLANE == 'search' else 180\nWORK = .25 if PLANE == 'search' else 1.2\nFINISH = 15 if PLANE == 'search' else 30\nOVERHEAD = 2.7\nRESET_TIMEOUT = 1.0\nCHUNK = 4 * 1024 * 1024\nMAX_CHUNKS = 8\nWIRE = 64 * 1024 * 1024\nMETRICS = ('combined_score', 'mean_capped_normalized_rmse', 'mean_absolute_capped_normalized_bias',\n           'failed_episode_fraction', 'control_success_fraction')\nBASELINES = ('difference_in_means', 'own_treatment_ols', 'one_hop_ols', 'copy_observed', 'constant_prediction')\n\n\ndef bounded_json_line(value, wire_limit=WIRE):\n    encoded = json.dumps(value, allow_nan=False, separators=(',', ':')).encode('utf-8') + b'\\n'\n    if len(encoded) >= wire_limit:\n        raise ProtocolError('message_limit')\n    return encoded\n\n\ndef bounded_failure_name(value, fallback):\n    import re\n    return value if isinstance(value, str) and re.fullmatch(r'[a-z][a-z0-9_]{0,79}', value) else fallback\n\n\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\nclass ProtocolError(RuntimeError):\n    pass\n\n\nclass BrokerTransportFailure(RuntimeError):\n    def __init__(self, operation):\n        self.failure = {'component': 'broker', 'category': 'broker_transport_failure',\n                        'operation': bounded_failure_name(operation, 'unknown')}\n        super().__init__('broker transport failed')\n\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {'ok'} or response['ok'] is not True:\n        raise InvalidResetResponse('invalid reset response')\n\n\nclass RequiredBaselineFailure(RuntimeError):\n    def __init__(self, category):\n        self.category = bounded_failure_name(category, 'invalid_baseline_diagnostic')\n        super().__init__('required baseline failed')\n\n\ndef describe_episode_failure(error, operation):\n    context = error\n    for _ in range(8):\n        if isinstance(context, BrokerTransportFailure):\n            return dict(context.failure)\n        if isinstance(context, InvalidResetResponse):\n            return {'component': 'candidate', 'category': 'invalid_reset_response', 'operation': 'reset'}\n        if isinstance(context, RequiredBaselineFailure):\n            return {'component': 'baseline', 'category': context.category, 'operation': 'baseline_worker'}\n        if isinstance(context, ProtocolError):\n            return {'component': 'candidate', 'category': 'invalid_protocol',\n                    'operation': bounded_failure_name(operation, 'unknown')}\n        context = context.__context__\n        if context is None:\n            break\n    return {'component': 'candidate', 'category': 'timeout',\n            'operation': bounded_failure_name(operation, 'unknown')}\n\n\ndef fail_required_baseline(category, cancel_work, record_failure):\n    failure = RequiredBaselineFailure(category)\n    try:\n        record_failure(failure.category)\n    except Exception:\n        failure.add_note('baseline diagnostic recording failed')\n    try:\n        cancel_work()\n    except Exception:\n        failure.add_note('baseline cleanup failed')\n    raise failure from None\n\n\ndef collect_required_baseline(result, *, deadline, clock, cancel_work, record_failure):\n    try:\n        remaining = deadline - clock()\n        if remaining <= 0:\n            raise TimeoutError()\n        value = result(timeout=remaining)\n        if clock() > deadline:\n            raise TimeoutError()\n        return value\n    except RequiredBaselineFailure:\n        raise\n    except (RuntimeError, TimeoutError) as error:\n        category = 'baseline_timeout' if isinstance(error, TimeoutError) else 'baseline_result_failure'\n        fail_required_baseline(category, cancel_work, record_failure)\n\n\ndef guard_required_baseline(call, failure_category, cancel_work, record_failure):\n    def check():\n        category = failure_category()\n        if category is not None:\n            fail_required_baseline(category, cancel_work, record_failure)\n    def guarded(request):\n        check()\n        result = call(request)\n        check()\n        return result\n    return guarded\n\n\ndef finite_budget_seconds(value):\n    if type(value) not in (int, float) or not math.isfinite(value) or value < 0:\n        raise ValueError('invalid time allowance')\n    return value\n\n\ndef positive_work_seconds(value):\n    if finite_budget_seconds(value) == 0:\n        raise ValueError('work allowance must be positive')\n    return value\n\n\ndef reserved_method_deadline(*, now, episode_deadline, methods_remaining, work_seconds, cleanup_seconds):\n    for value in (now, episode_deadline, cleanup_seconds):\n        finite_budget_seconds(value)\n    work = positive_work_seconds(work_seconds)\n    if type(methods_remaining) is not int or methods_remaining < 0:\n        raise ValueError('invalid remaining method count')\n    if now + (methods_remaining + 1) * (work + cleanup_seconds) > episode_deadline:\n        raise TimeoutError('insufficient matched method reservations')\n    return now + work\n\n\ndef require_joint_workload_budget():\n    for episodes, wall, startup, work, finish in ((161, 900, 30, .25, 15), (625, 7200, 180, 1.2, 30)):\n        needed = startup + finish + episodes * (RESET_TIMEOUT + OVERHEAD + 6 * (work + .01))\n        if needed > wall:\n            raise ValueError('joint workload budget infeasible')\n\n\nclass BoundedWorkerStderr:\n    LIMIT = 4096\n\n    def __init__(self, stream):\n        self.stream = stream\n        self.fd = stream.fileno()\n        os.set_blocking(self.fd, False)\n        self.lines = collections.deque()\n        self.pending = bytearray()\n        self.dropping_line = False\n        self.observed_bytes = 0\n        self.retained_bytes = 0\n        self.truncated = False\n        self.capture_error = None\n        self.stop = threading.Event()\n        self.result = None\n        self.reader = threading.Thread(target=self._drain, name='worker-stderr-reader')\n        self.reader.start()\n\n    def _accept(self, chunk):\n        self.observed_bytes += len(chunk)\n        for segment in chunk.splitlines(keepends=True):\n            complete = segment.endswith(b'\\n')\n            if not self.dropping_line:\n                if len(self.pending) + len(segment) > self.LIMIT:\n                    self.pending.clear()\n                    self.dropping_line = True\n                    self.truncated = True\n                else:\n                    self.pending.extend(segment)\n            if complete:\n                if not self.dropping_line:\n                    line = bytes(self.pending).decode('utf-8', errors='replace')\n                    size = len(line.encode('utf-8'))\n                    if size <= self.LIMIT:\n                        while self.retained_bytes + size > self.LIMIT:\n                            self.retained_bytes -= len(self.lines.popleft().encode('utf-8'))\n                            self.truncated = True\n                        self.lines.append(line)\n                        self.retained_bytes += size\n                    else:\n                        self.truncated = True\n                self.pending.clear()\n                self.dropping_line = False\n\n    def _drain(self):\n        try:\n            with selectors.DefaultSelector() as selector:\n                selector.register(self.fd, selectors.EVENT_READ)\n                while not self.stop.is_set():\n                    if not selector.select(timeout=.05):\n                        continue\n                    try:\n                        chunk = os.read(self.fd, 8192)\n                    except BlockingIOError:\n                        continue\n                    if not chunk:\n                        return\n                    self._accept(chunk)\n                self.capture_error = 'reader_stopped_before_eof'\n                self.truncated = True\n","exit_code":0,"status":"completed"}}
