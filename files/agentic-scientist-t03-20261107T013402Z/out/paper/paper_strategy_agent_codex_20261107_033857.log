{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"sed -n '790,876p' task/evaluate.py; sed -n '1010,1032p' task/evaluate.py; sed -n '1138,1164p' task/evaluate.py; cat task/requirements.txt; head -45 task/evaluate_final.py; sed -n '1,160p' results/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1/src/reliability.py\"","aggregated_output":"        sizes = masks.sum(axis=1)\n        for feature in range(dimension):\n            absent = numbers[~masks[:,feature]]\n            weights = np.array([1/(dimension*math.comb(dimension-1,int(size))) for size in sizes[absent]])\n            reference.append(float(np.dot(weights,values[absent|(1<<feature)]-values[absent])))\n        references.append(reference)\n    return np.asarray(references)\n\n\ndef run_stage(callback,seconds):\n    def alarm_handler(signum,frame):\n        raise TimeoutError('trusted method work timeout')\n    previous = signal.getsignal(signal.SIGALRM)\n    signal.signal(signal.SIGALRM,alarm_handler)\n    signal.setitimer(signal.ITIMER_REAL,seconds)\n    started = time.monotonic()\n    try:\n        result = callback()\n        duration = time.monotonic()-started\n        if duration>seconds:\n            raise TimeoutError('trusted method work timeout')\n        return result,duration\n    finally:\n        signal.setitimer(signal.ITIMER_REAL,0)\n        signal.signal(signal.SIGALRM,previous)\n\n\ndef baseline_work(request):\n    science()\n    os.sched_setaffinity(0,sorted(os.sched_getaffinity(0))[:1])\n    resource.setrlimit(resource.RLIMIT_AS,(8*1024**3,8*1024**3))\n    resource.setrlimit(resource.RLIMIT_CPU,(cpu_limit_seconds(WALL_SECONDS,1),cpu_limit_seconds(WALL_SECONDS,1)+1))\n    smoke = request['smoke']\n    if request['case']=='controls':\n        return control_baseline(request)\n    settings = request['settings']\n    work = request['work_seconds']\n    dataset_name,kind = request['case'].split('_',1)\n    root = Path(request['root'])\n    def train():\n        dataset = load_data(root,dataset_name)\n        train_rows,labels,explanations,validation,targets = encode_dataset(dataset,smoke)\n        if len(np.unique(labels))!=2:\n            raise RuntimeError('training classes absent')\n        if kind=='logistic':\n            estimator = LogisticRegression(max_iter=500,random_state=request['seed'],solver='lbfgs',tol=1e-7)\n        else:\n            estimator = RandomForestClassifier(n_estimators=4 if smoke else 64,max_depth=6,random_state=request['seed'],n_jobs=1)\n        estimator.fit(train_rows,labels)\n        background = train_rows[:settings['background']]\n        queries = explanations[:settings['instances']]\n        model = serialize_model(estimator,kind,background)\n        probe = np.concatenate([queries,background])\n        if not np.allclose(predict(model,probe),estimator.predict_proba(probe)[:,1],rtol=1e-9,atol=1e-10):\n            raise RuntimeError('safe model serialization mismatch')\n        accuracy = float(np.mean(estimator.predict(validation)==targets))\n        diagnostics = {'validation_accuracy':accuracy,'fit_iterations':int(estimator.n_iter_[0]) if kind=='logistic' else 0,'fit_converged':bool(kind!='logistic' or estimator.n_iter_[0]<500)}\n        return model,queries,diagnostics\n    (model,queries,diagnostics),training_seconds = run_stage(train,work)\n    counters = {'reference':[0],'standard':[0],'multistart':[0]}\n    def references():\n        if model['dimension']<=10:\n            values = exact_reference(model,queries,counters['reference'])\n            return values,np.zeros_like(values)\n        budget = 64 if smoke else 4096\n        first = library_kernel(model,queries,budget,request['seed']+100000,counters['reference'])\n        second = library_kernel(model,queries,budget,request['seed']+200000,counters['reference'])\n        return (first+second)/2,abs(first-second)/2\n    (references,uncertainty),reference_seconds = run_stage(references,work)\n    def standard():\n        return [library_kernel(model,queries,budget,request['seed']+300000+index,counters['standard']).tolist() for index,budget in enumerate(settings['budgets'])]\n    standard_values,standard_seconds = run_stage(standard,work)\n    def multistart():\n        outputs = []\n        for index,budget in enumerate(settings['budgets']):\n            first = library_kernel(model,queries,max(1,budget//2),request['seed']+400000+2*index,counters['multistart'])\n            second = library_kernel(model,queries,max(1,budget//2),request['seed']+400001+2*index,counters['multistart'])\n            outputs.append(((first+second)/2).tolist())\n        return outputs\n    multistart_values,multistart_seconds = run_stage(multistart,work)\n    return {'model':model,'queries':queries.tolist(),'reference':references.tolist(),'reference_uncertainty':uncertainty.tolist(),'standard':standard_values,'multistart':multistart_values,'diagnostics':diagnostics,\n            'productive_seconds':{'training':training_seconds,'reference':reference_seconds,'standard':standard_seconds,'multistart':multistart_seconds},'prediction_rows':{key:value[0] for key,value in counters.items()}}\n\n\nclass BaselineWorker:\n    def __init__(self,request,deadline):\n        self.deadline = deadline\n        raise ProtocolFailure('invalid_attribution_shape')\n    if any(type(value) not in (float,int) or abs(value)>1000000 or not math.isfinite(value) for row in values for value in row):\n        raise ProtocolFailure('invalid_attribution_value')\n    return values\n\n\ndef agreement(values,reference,delta):\n    values = np.asarray(values,dtype=float)\n    reference = np.asarray(reference,dtype=float)\n    error = np.abs(values-reference).sum(axis=-1)\n    scale = np.maximum(np.abs(reference).sum(axis=-1),.001)\n    fidelity = 1/(1+error/scale)\n    def top3(row):\n        return set(sorted(range(len(row)),key=lambda index:(-abs(row[index]),index))[:min(3,len(row))])\n    overlap = np.array([len(top3(row)&top3(target))/min(3,len(row)) for row,target in zip(values,reference)])\n    sign = lambda array: np.where(abs(array)<=1e-8,0,np.sign(array))\n    signed = (sign(values)==sign(reference)).mean(axis=-1)\n    efficiency = np.minimum(1,abs(values.sum(axis=-1)-delta)/np.maximum(abs(delta),.001))\n    return np.column_stack([fidelity,overlap,signed,efficiency])\n\n\ndef initial_outcome(episode,settings):\n    cells = [[[None for instance in range(settings['instances'])] for repeat in range(settings['repetitions'])] for budget in settings['budgets']]\n            reference = np.asarray(baseline['reference'])\n            delta = predict(model,queries)-predict(model,model['background']).mean()\n            upload_model(candidate_call,model,'model0')\n            attributions = []\n            for budget_index,budget in enumerate(settings['budgets']):\n                repetitions = []\n                for repeat_index in range(settings['repetitions']):\n                    values = explain(candidate_call,queries,budget,model['dimension'])\n                    repetitions.append(values)\n                    measurements = agreement(values,reference,delta)\n                    for instance_index,value in enumerate(measurements):\n                        outcome['cells'][budget_index][repeat_index][instance_index] = value.tolist()\n                    for previous in range(repeat_index):\n                        pair_index = repeat_index*(repeat_index-1)//2+previous\n                        outcome['repeat_pairs'][budget_index][pair_index] = agreement(values,repetitions[previous],delta)[:,1:3].tolist()\n                attributions.append(repetitions)\n            baseline_metrics = {name:[agreement(values,reference,delta).mean(axis=0).tolist() for values in baseline[name]] for name in ('standard','multistart')}\n            instance_values = np.array(outcome['cells'])[:,:,:,0].mean(axis=(0,1))\n            generator = np.random.default_rng(84017)\n            bootstraps = instance_values[generator.integers(len(instance_values),size=(1000,len(instance_values)))].mean(axis=1)\n            outcome['solution'] = {'attributions':attributions,'reference':baseline['reference'],'reference_uncertainty':baseline['reference_uncertainty'],'standard':baseline['standard'],'multistart':baseline['multistart'],'baseline_metrics':baseline_metrics,\n                                   'fidelity_instance_bootstrap_ci95':np.quantile(bootstraps,[.025,.975]).tolist(),'model_diagnostics':baseline['diagnostics'],'productive_seconds':baseline['productive_seconds'],'prediction_rows':baseline['prediction_rows']}\n            outcome['valid'] = True\n            outcome['operational'] = True\n        if time.monotonic()>candidate_deadline:\n            raise TimeoutError('candidate method allowance exhausted')\n        return outcome\ncertifi==2026.10.23\ncharset-normalizer==3.5.2\ncloudpickle==3.1.2\nfolktables==0.0.12\nidna==3.20\njoblib==1.6.0\nllvmlite==0.50.0\nnumba==0.68.1\nnumpy==2.1.3\npackaging==26.3\npandas==2.2.3\npython-dateutil==4.0.0\npytz==2026.6\nrequests==2.34.2\nscikit-learn==1.6.1\nscipy==1.15.3\nshap==0.48.0\nslicer==0.0.8\nthreadpoolctl==3.8.0\ntqdm==4.70.1\ntyping-extensions==4.16.0\ntzdata==2026.6\nurllib3==2.8.0\n\"\"\"Independent offline evaluator. Candidate API is documented in starter program.py.\n\nScientific validity is integrity + fixed coverage + analytic controls, NOT high\nempirical agreement. Search eligibility has no comparative performance cutoff.\nFinal correctness validates evidence completeness, not a positive reliability\nclaim. Paper/source review and uncertainty interpretation remain human evidence\nobligations; black-box RPC cannot prove a hidden algorithm or a causal mechanism.\n\"\"\"\nimport argparse\nimport base64\nimport collections\nimport ctypes\nimport decimal\nimport gzip\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport re\nimport resource\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unicodedata\n\nPLANE = 'final'\nSEEDS = [104729, 130363, 155921]\nWALL_SECONDS = 10800\nRPC_BUDGET = 664\nRESOURCE_HASHES = {'acs.json.gz': '030403da6ad01340bfa41defecec36b422f6fe82a328a5dbb59e59a4675f5fcf', 'acs.py': '5946ac913930c464e35cbf6288b96746f232cded2966925be79b04e2d082907d', 'census-site-policy.html': '7c30344cf69af8da08b3ce1cc94df1631e73ffd63174aabd35661b979190e2a4', 'census-terms.html': 'ea341a21715ac0f31fe7d4d6f3b822217a2f773a6d4a89f9c49ff7ddcd0c5d74', 'dictionary2024.pdf': '929c2752995b0af1c16d5c64de8cdc43b4aa7d388ee2d45b4b4df90fecce1dff', 'folktables-LICENSE': '8bfa1347f5d0b17916acfc9c04abdfd884b8c730261260b14699a4833f93ed35', 'german.json.gz': 'bd14547741ca5f1769acc2c218909173719e4402b5e9cc822456fb8e1c5f1c96', 'provenance.json': 'abb09b4300538af9e8eec3b1f5805895b382281a0a5a7dc8d32de4de60469e5f', 'relshipp2024.json': '8f0e7392b196399e54e81855affb53f614f7539f0b4b5ccf32fbc4fd8ddfdf33'}\nSTART_TIME = time.monotonic()\nAPPLICATION_LIMIT = 2*1024*1024\nWIRE_LIMIT = 64*1024*1024\nMAX_CHUNKS = 16\nMAX_CHUNK_BYTES = 1048576\nMAX_DOCUMENT_BYTES = 16*1024*1024\nMETRIC_NAMES = ['reference_fidelity','top3_overlap','signed_agreement','efficiency_error','control_pass_rate','failed_fraction','replay_error','wall_seconds']\nif PLANE == 'search':\n\"\"\"Fixed empirical-background estimation; diagnostics never extend RPC responses.\"\"\"\n\nimport math\n\nimport numpy as np\n\nfrom forest import exact_forest_shapley\nfrom logistic_fourier import logistic_fourier_shapley\n\n\nclass FrozenProbabilityGame:\n    \"\"\"Mask original supplied columns, without refitting or resampling background.\n\n    The transport already applies frozen scalar preprocessing. It supplies no\n    raw dataframe or pipeline; no claim about unobserved preprocessing is made.\n    The cache is query-local, and contains only predictions requested here.\n    \"\"\"\n\n    def __init__(self, model, query, predict):\n        self.model = model\n        self.query = np.array(query, dtype=np.float64, copy=True)\n        self.background = np.array(model['background'], dtype=np.float64, copy=True)\n        self.predict = predict\n        self.dimension = model['dimension']\n        self.cache = {}\n        self.prediction_rows = 0\n        self.unique_coalitions = 0\n\n    def values(self, coalition_masks):\n        coalition_masks = np.asarray(coalition_masks, dtype=np.uint32)\n        missing = sorted(set(map(int, coalition_masks)) - self.cache.keys())\n        for offset in range(0, len(missing), 128):\n            chunk = np.asarray(missing[offset:offset + 128], dtype=np.uint32)\n            included = ((chunk[:, None] >> np.arange(self.dimension)) & 1).astype(bool)\n            hybrid = np.where(included[:, None, :], self.query, self.background[None, :, :])\n            predictions = self.predict(self.model, hybrid.reshape(-1, self.dimension))\n            means = predictions.reshape(len(chunk), len(self.background)).mean(axis=1)\n            for mask, mean in zip(chunk, means):\n                self.cache[int(mask)] = float(mean)\n            self.prediction_rows += len(chunk) * len(self.background)\n            self.unique_coalitions += len(chunk)\n        return np.asarray([self.cache[int(mask)] for mask in coalition_masks])\n\n\ndef exact_shapley(game):\n    \"\"\"Exhaustive fixed-game solution, used only when the budget covers it.\n\n    This is not an independent experimental reference for a deployment call.\n    It neither supplies a table to a sampled call nor reuses another call's cache.\n    \"\"\"\n    feature_count = game.dimension\n    coalition_values = game.values(np.arange(1 << feature_count, dtype=np.uint32))\n    reference_phi = np.zeros(feature_count)\n    for coalition_mask in range(1 << feature_count):\n        coalition_size = coalition_mask.bit_count()\n        if coalition_size == feature_count:\n            continue\n        coalition_weight = 1.0 / (feature_count * math.comb(feature_count - 1, coalition_size))\n        for feature_index in range(feature_count):\n            if not coalition_mask & (1 << feature_index):\n                reference_phi[feature_index] += coalition_weight * (coalition_values[coalition_mask | (1 << feature_index)] - coalition_values[coalition_mask])\n    assert np.isclose(reference_phi.sum(), coalition_values[-1] - coalition_values[0], atol=1e-8)\n    return reference_phi\n\n\ndef independent_paths(game, path_count, rng):\n    \"\"\"Complete uniform paths; no antithetic paths or adaptive stopping.\n\n    Reusing a deterministic coalition value does not couple the independently\n    sampled permutations. Each row, not each marginal, is a sampling unit.\n    \"\"\"\n    feature_count = game.dimension\n    permutations = np.asarray([rng.permutation(feature_count) for _ in range(path_count)])\n    prefixes = np.bitwise_or.accumulate(np.left_shift(np.uint32(1), permutations.astype(np.uint32)), axis=1)\n    masks = prefixes[:, :-1].reshape(-1)\n    endpoints = game.values([0, (1 << feature_count) - 1])\n    path_values = np.empty((path_count, feature_count + 1))\n    path_values[:, 0] = endpoints[0]\n    path_values[:, -1] = endpoints[1]\n    path_values[:, 1:-1] = game.values(masks).reshape(path_count, feature_count - 1)\n    path_marginals = np.empty((path_count, feature_count))\n    np.put_along_axis(path_marginals, permutations, np.diff(path_values, axis=1), axis=1)\n    if not np.all(np.abs(path_marginals) <= 1.0 + 1e-12):\n        raise ValueError('probability marginal outside its bounded domain')\n    if not np.allclose(path_marginals.sum(axis=1), endpoints[1] - endpoints[0], atol=1e-10, rtol=0):\n        raise ValueError('incomplete permutation path')\n    return path_marginals, masks\n\n\ndef simultaneous_certificate(path_marginals, alpha=0.05):\n    \"\"\"At most alpha unconditional wrong-certificate probability per fixed call.\n\n    The bound is on independent complete-path means, never regression estimates.\n    It is not a conditional-on-acceptance guarantee. Strict separation rejects\n    ties, with original column order breaking estimate ties deterministically.\n    \"\"\"\n    path_count, feature_count = path_marginals.shape\n    if path_count < 2 or not 0 < alpha < 1:\n        raise ValueError('certificate requires two paths and valid alpha')\n    estimate = path_marginals.mean(axis=0)\n    sample_variance = path_marginals.var(axis=0, ddof=1)\n    log_term = np.log(4.0 * feature_count / alpha)\n    radius = np.sqrt(2.0 * sample_variance * log_term / path_count) + 14.0 * log_term / (3.0 * (path_count - 1))\n    magnitude_lower = np.maximum(0.0, np.abs(estimate) - radius)\n    magnitude_upper = np.abs(estimate) + radius\n    order = np.argsort(-np.abs(estimate), kind='stable')\n    selected = order[:min(3, feature_count - 1)]\n    excluded = order[min(3, feature_count - 1):]\n    topk_certified = bool(magnitude_lower[selected].min() > magnitude_upper[excluded].max())\n    signs_certified = bool(np.all(np.abs(estimate[selected]) > radius[selected]))\n    certified = topk_certified and signs_certified\n    return estimate, radius, certified\n\n\ndef sampled_kernel_masks(feature_count, count, rng):\n    \"\"\"Kernel-distributed subsets with complement pairing only for regression.\"\"\"\n    sizes = np.arange(1, feature_count)\n    probabilities = 1.0 / (sizes * (feature_count - sizes))\n    probabilities /= probabilities.sum()\n    masks = np.empty(count, dtype=np.uint32)\n    full = (1 << feature_count) - 1\n    for offset in range(0, count, 2):\n        size = int(rng.choice(sizes, p=probabilities))\n        selected = rng.choice(feature_count, size=size, replace=False)\n        mask = sum(1 << int(feature) for feature in selected)\n        masks[offset] = mask\n        if offset + 1 < count:\n            masks[offset + 1] = full ^ mask\n    return masks\n\n\ndef kernel_regression(game, masks, path_mask_count):\n    \"\"\"Importance-weight the path/kernel mixture for the SHAP kernel objective.\n\n    Path prefixes are uniform conditional on size, but not kernel-distributed\n    across sizes. Their dependence is irrelevant to the point regression; no\n    certificate is constructed from these fitted coefficients.\n    \"\"\"\n    feature_count = game.dimension\n    design = ((masks[:, None] >> np.arange(feature_count)) & 1).astype(float)\n    sizes = design.sum(axis=1).astype(int)\n    possible_sizes = np.arange(1, feature_count)\n    size_probabilities = 1.0 / (possible_sizes * (feature_count - possible_sizes))\n    size_probabilities /= size_probabilities.sum()\n    kernel_probability = size_probabilities[sizes - 1]\n    path_fraction = path_mask_count / len(masks)\n    mixture_probability = path_fraction / (feature_count - 1) + (1.0 - path_fraction) * kernel_probability\n    root_weights = np.sqrt(kernel_probability / mixture_probability)\n    empty, full = game.values([0, (1 << feature_count) - 1])\n    delta = full - empty\n    target = game.values(masks) - empty - sizes * delta / feature_count\n    basis = np.zeros((feature_count, feature_count - 1))\n    for column in range(feature_count - 1):\n        scale = math.sqrt((column + 1) * (column + 2))\n        basis[:column + 1, column] = 1.0 / scale\n        basis[column + 1, column] = -(column + 1) / scale\n    coefficients = np.linalg.lstsq((design @ basis) * root_weights[:, None], target * root_weights, rcond=1e-12)[0]\n    estimate = np.full(feature_count, delta / feature_count) + basis @ coefficients\n    estimate += (delta - estimate.sum()) / feature_count\n    return estimate\n","exit_code":0,"status":"completed"}}
