established.\\\",\\\"next_action\\\":\\\"Inspect bounded final episode and dataset provenance projections, then choose a small citation-oriented query set.\\\",\\\"tags\\\":[\\\"reference_planning\\\",\\\"no_retrieval\\\",\\\"gate=kept\\\",\\\"trigger=none\\\"]}'\njq '.final_evaluation.evaluation_evidence | {status,episode_count,candidate_diagnostics_trust,episodes_type:(.episodes|type),first_episode:(.episodes[0]|keys)}' paper_data.json; sed -n '602,701p' global_memory/task/evaluate.py; sed -n '1,150p' .codex/skills/memory-log/scripts/append_memory.py\"","aggregated_output":"{\n  \"status\": \"available\",\n  \"episode_count\": 3,\n  \"candidate_diagnostics_trust\": \"unverified\",\n  \"episodes_type\": \"array\",\n  \"first_episode\": [\n    \"correct\",\n    \"duration_seconds\",\n    \"score\",\n    \"seed\",\n    \"solution\"\n  ]\n}\n        raise TimeoutError()\n\n\ndef aggregate_rows(values, rule):\n    if rule == \"mean\":\n        return np.mean(values, axis=-1)\n    if rule == \"median\":\n        return np.median(values, axis=-1)\n    trim = values.shape[-1]//5\n    return np.mean(np.sort(values, axis=-1)[..., trim:values.shape[-1]-trim], axis=-1)\n\n\ndef load_resources(root):\n    manifest = json.loads((root/\"manifest.json\").read_text())\n    encoded = (root/\"records.json\").read_bytes()\n    if hashlib.sha256(encoded).hexdigest() != manifest[\"data_sha256\"]:\n        raise ValueError(\"resource digest mismatch\")\n    if manifest[\"disjoint_content_verified\"] is not True or not re.fullmatch(\"[0-9a-f]{64}\",manifest[\"other_content_hashes_commitment_sha256\"]):\n        raise ValueError(\"normalized raw-content split attestation missing\")\n    data = json.loads(encoded)\n    panels = {\"helm\": [], \"openllm\": [], \"bbh\": []}\n    identifiers = {name: [] for name in panels}\n    cluster_ids = {name: [] for name in panels}\n    seen_hashes = set()\n    bbh_tasks = None\n    for record in data[\"records\"]:\n        hashes = []\n        if record[\"family\"] == \"helm\":\n            for task, raw in record[\"raw\"].items():\n                hashes.append(digest({\"subject\": task, \"settings\": raw[\"settings\"], \"cells\": raw[\"cells\"][1:]}))\n            scores = {task: record[\"raw\"][task][\"cells\"][1][\"value\"] for task in data[\"helm_tasks\"]}\n            hashes.append(digest({\"tasks\": scores, \"settings\": {\"family\": \"helm\", \"release\": \"v1.13.0\"}}))\n            row = [scores[task] for task in data[\"helm_tasks\"]]\n        else:\n            raw = record[\"raw\"]\n            settings = {key: raw[key] for key in (\"Precision\", \"Weight type\", \"Chat Template\", \"Architecture\")}\n            hashes.append(digest({\"tasks\": {task: raw[task] for task in data[\"openllm_tasks\"]}, \"settings\": settings}))\n            row = [raw[task] for task in data[\"openllm_tasks\"]]\n            if record[\"results\"] is not None:\n                result = record[\"results\"][\"raw\"]\n                tasks = record[\"results\"][\"bbh_tasks\"]\n                if bbh_tasks is not None and tasks != bbh_tasks:\n                    raise ValueError(\"BBH task panel mismatch\")\n                bbh_tasks = tasks\n                bbh = {task: result[\"results\"][task][\"acc_norm,none\"] for task in tasks}\n                settings = {key: result[\"config\"].get(key) for key in (\"random_seed\", \"numpy_seed\", \"torch_seed\", \"fewshot_seed\", \"model_dtype\")}\n                hashes.append(digest({\"tasks\": bbh, \"settings\": settings}))\n                hashes.append(digest({\"results\": result[\"results\"], \"configs\": result.get(\"configs\"), \"task_hashes\": result.get(\"task_hashes\")}))\n                if result[\"config\"].get(\"model_sha\") != raw[\"Model sha\"]:\n                    raise ValueError(\"BBH revision mismatch\")\n                panels[\"bbh\"].append([bbh[task] for task in tasks])\n                identifiers[\"bbh\"].append(record[\"id\"])\n                cluster_ids[\"bbh\"].append(record[\"cluster\"])\n        if sorted(hashes) != sorted(record[\"content_hashes\"]):\n            raise ValueError(\"normalized raw content digest mismatch\")\n        seen_hashes.update(hashes)\n        panels[record[\"family\"]].append(row)\n        identifiers[record[\"family\"]].append(record[\"id\"])\n        cluster_ids[record[\"family\"]].append(record[\"cluster\"])\n    if seen_hashes != set(manifest[\"own_content_hashes\"]):\n        raise ValueError(\"raw split manifest mismatch\")\n    tasks = {\"helm\": data[\"helm_tasks\"], \"openllm\": data[\"openllm_tasks\"], \"bbh\": bbh_tasks}\n    for name, rows in panels.items():\n        matrix = np.asarray(rows, dtype=\"<f8\")\n        if matrix.ndim != 2 or matrix.shape[0] < 13 or not 1 <= matrix.shape[1] <= 100 or matrix.shape[0] > 10000 or not np.all(np.isfinite(matrix)) or np.min(matrix) < 0 or np.max(matrix) > 1:\n            raise ValueError(\"required public panel unavailable\")\n        panels[name] = {\"values\": matrix, \"task_ids\": tasks[name], \"identifiers\": identifiers[name], \"clusters\": cluster_ids[name]}\n    return panels\n\n\ndef select_targets(matrix, count, seed):\n    excluded = set()\n    for rule in RULES:\n        scores = aggregate_rows(matrix, rule)\n        excluded.update(np.flatnonzero(scores >= np.max(scores)-TOLERANCE).tolist())\n    order = sorted((index for index in range(len(matrix)) if index not in excluded),\n                   key=lambda index: (float(np.mean(matrix[index])), index))\n    if len(order) < count:\n        raise ValueError(\"insufficient nonleading target strata\")\n    rng = np.random.default_rng(seed)\n    targets = []\n    for band in np.array_split(np.array(order), count):\n        targets.append(int(band[int(rng.integers(len(band)))]))\n    return targets\n\n\ndef prepare_episode(episode, panels, smoke):\n    family, case, seed = episode[\"family\"], episode[\"case\"], episode[\"seed\"]\n    names = [family]+([\"bbh\"] if family == \"openllm\" else [])\n    matrices = {}\n    base = {}\n    target_rows = {}\n    count = 2 if smoke else TARGETS\n    for name in names:\n        source = panels[name]\n        values = source[\"values\"]\n        task_ids = list(source[\"task_ids\"])\n        if smoke:\n            values = values[:min(len(values),40), :6]\n            task_ids = task_ids[:6]\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n\ndef _markdown_entry(event: dict[str, Any]) -> str:\n    \"\"\"Handle markdown entry logic for this module.\"\"\"\n    lines = [\n        f\"### {event['timestamp']} | step={event['step']} | scope={event['scope']}\",\n        f\"- summary: {event['summary']}\",\n        f\"- evidence: {event['evidence']}\",\n        f\"- next_action: {event['next_action']}\",\n    ]\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = event.get(key)\n        if isinstance(value, str) and value.strip():\n            lines.append(f\"- {key}: {value.strip()}\")\n\n    metrics = event.get(\"metrics\")\n    if isinstance(metrics, dict) and metrics:\n        lines.append(f\"- metrics: {json.dumps(metrics, sort_keys=True)}\")\n    rubrics = event.get(\"rubrics\")\n    if isinstance(rubrics, list) and rubrics:\n        lines.append(f\"- rubrics: {json.dumps(rubrics, sort_keys=True)}\")\n    tags = event.get(\"tags\")\n    if isinstance(tags, list) and tags:\n        lines.append(f\"- tags: {', '.join(str(item) for item in tags)}\")\n\n    return \"\\n\".join(lines) + \"\\n\\n\"\n\n\ndef _append_text(path: Path, text: str, *, header: str) -> None:\n    \"\"\"Safely initialize and append text to a regular file.\"\"\"\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if not size:\n            _write_all(fd, header.encode(\"utf-8\"))\n        elif os.pread(fd, 1, size - 1) != b\"\\n\":\n            _write_all(fd, b\"\\n\")\n        _write_all(fd, text.encode(\"utf-8\"))\n    finally:\n        try:\n            fcntl.flock(fd, fcntl.LOCK_UN)\n        finally:\n            os.close(fd)\n\n\ndef _append_jsonl(path: Path, payload: dict[str, Any]) -> None:\n    \"\"\"Append one JSON object as a JSONL record.\"\"\"\n    line = (json.dumps(payload, sort_keys=True) + \"\\n\").encode(\"utf-8\")\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if size and os.pread(fd, 1, size - 1) != b\"\\n\":\n            _write_all(fd, b\"\\n\")\n","exit_code":0,"status":"completed"}}
