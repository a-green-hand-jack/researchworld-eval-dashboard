{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport hashlib\nimport json\nfrom pathlib import Path\n\nroot = Path('.')\nstrategy = json.loads((root / 'paper_strategy.json').read_text())\ndata = json.loads((root / 'paper_data.json').read_text())\nmemo = (root / 'paper_strategy.md').read_text()\nerrors = []\nrequired_fields = ['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason']\nfor field in required_fields:\n    if field not in strategy:\n        errors.append(f'Missing field: {field}')\nfor field in ['recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'edit_framing_decision']:\n    if not isinstance(strategy.get(field), str) or not strategy[field].strip():\n        errors.append(f'Empty or invalid {field}')\nif strategy.get('status') \"'!= '\"'ready' or strategy.get('selected_prompt_family') \"'!= '\"'paper_standalone':\n    errors.append('Unexpected status or prompt family')\nif strategy.get('prior_paper_story_status') not in ['preserved', 'broadened', 'recentered', 'rejected']:\n    errors.append('Invalid prior-paper decision')\nallowed_ids = set(data['grounding_sources'])\nchecked_ids = set()\n\ndef check_sources(value, location='strategy'):\n    if isinstance(value, dict):\n        if 'source_ids' in value:\n            sources = value['source_ids']\n            if not isinstance(sources, list) or not sources:\n                errors.append(f'{location}.source_ids must be a non-empty list')\n            else:\n                for source in sources:\n                    if not isinstance(source, str) or source not in allowed_ids:\n                        errors.append(f'{location}: unknown source {source}')\n                    else:\n                        checked_ids.add(source)\n        for key, child in value.items():\n            check_sources(child, f'{location}.{key}')\n    elif isinstance(value, list):\n        for index, child in enumerate(value):\n            check_sources(child, f'{location}[{index}]')\n\ncheck_sources(strategy)\nsupplement = strategy.get('supplementary_plan', {})\nif not supplement.get('purpose') or not supplement.get('planned_subsections'):\n    errors.append('Supplementary plan is missing or empty')\nfor index, section in enumerate(supplement.get('planned_subsections', [])):\n    for field in ['heading', 'grounded_content', 'source_ids']:\n        if not section.get(field):\n            errors.append(f'Supplement {index}: missing {field}')\n    if section['heading'] not in memo:\n        errors.append(f'Supplement {index}: heading absent from memo')\n    for source_path in section.get('source_paths', []):\n        if not Path(source_path).exists():\n            errors.append(f'Supplement {index}: missing source path {source_path}')\nfor group in strategy['method_groups']:\n    if group.get('role') not in ['baseline', 'proposed', 'ablation', 'supporting']:\n        errors.append(f'Invalid method role: {group}')\nfigures = strategy.get('figure_specs', [])\nif sum(spec.get('preferred_generator') == 'generate-concept-figure' for spec in figures) > 1:\n    errors.append('More than one concept-generator figure')\nfor spec in figures:\n    figure_id = spec.get('figure_id', '<missing>')\n    for field in ['purpose', 'figure_type', 'preferred_generator', 'group_by', 'metric', 'split_by', 'preferred_span', 'target_width_fraction', 'layout_rationale', 'max_panels', 'max_categories_per_panel', 'max_series_per_panel']:\n        if not spec.get(field):\n            errors.append(f'{figure_id}: missing {field}')\n    for field, maximum in [('max_panels', 4), ('max_panels_per_row', 3), ('max_categories_per