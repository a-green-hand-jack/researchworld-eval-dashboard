\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Observed-composition coverage for scaled ILR. Left: $K=3$; right: $K=8$. Whiskers are descriptive 95\% seed-block bootstrap intervals derived from retained observations. The truncated vertical axis highlights departures from the dashed nominal-coverage reference. IID behavior is close to target; the shifted Dirichlet deficit is substantial at every level. Lines connect nominal levels, not time.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:coverage}{{2}{7}{Observed-composition coverage for scaled ILR. Left: $K=3$; right: $K=8$. Whiskers are descriptive 95\% seed-block bootstrap intervals derived from retained observations. The truncated vertical axis highlights departures from the dashed nominal-coverage reference. IID behavior is close to target; the shifted Dirichlet deficit is substantial at every level. Lines connect nominal levels, not time}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Held-out mean errors, normalized simplex mass, and utility. Errors are absolute deviations computed before averaging. Utility intervals are descriptive joint seed-block bootstrap intervals from our retained-data analysis. Smaller error and mass are favorable; larger utility is favorable.}}{7}{table.caption.6}\protected@file@percent }
\newlabel{tab:main}{{1}{7}{Held-out mean errors, normalized simplex mass, and utility. Errors are absolute deviations computed before averaging. Utility intervals are descriptive joint seed-block bootstrap intervals from our retained-data analysis. Smaller error and mass are favorable; larger utility is favorable}{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Condition-specific comparisons rule out uniform dominance}{7}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Scaled ILR minus simplex max, with evaluator-supplied paired descriptive 95\% seed-bootstrap intervals. Rows distinguish $K$; columns distinguish utility (positive favors scaled ILR) and uniform-simplex mass (negative means smaller). All nominal levels are shown. LN denotes logistic-normal; Dir denotes Dirichlet. Shifted conditions reverse the favorable IID Dirichlet pattern.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:paired}{{3}{8}{Scaled ILR minus simplex max, with evaluator-supplied paired descriptive 95\% seed-bootstrap intervals. Rows distinguish $K$; columns distinguish utility (positive favors scaled ILR) and uniform-simplex mass (negative means smaller). All nominal levels are shown. LN denotes logistic-normal; Dir denotes Dirichlet. Shifted conditions reverse the favorable IID Dirichlet pattern}{figure.caption.7}{}}
