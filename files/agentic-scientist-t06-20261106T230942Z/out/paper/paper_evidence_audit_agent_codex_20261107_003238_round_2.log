ion = {\"H\": 1.0, \"A\": -1.0, \"N\": 0.0}[row[\"game_location\"]]\n   107\t        home = row[\"team_id\"] if location == 1 else row[\"opp_id\"] if location == -1 else None\n   108\t        raw = [row[\"date_game\"], year, teams, [scores[team] for team in teams], home, row[\"is_playoffs\"]]\n   109\t        content_hash = digest(raw)\n   110\t        example_hash = digest([teams, [scores[team] for team in teams], row[\"date_game\"], home])\n   111\t        record = {\"source_id\": identity, \"source_row\": source_row, \"reciprocal_rows\": [item[0] for item in rows],\n   112\t                  \"a\": row[\"team_id\"], \"b\": row[\"opp_id\"], \"y\": float(int(row[\"pts\"]) > int(row[\"opp_pts\"])),\n   113\t                  \"z\": location, \"hashes\": [content_hash, example_hash], \"group\": content_hash}\n   114\t        panels[plane].setdefault(\"nba-\" + str(year), []).append(record)\n   115\t    sets = {plane: {content_hash for records in cases.values() for row in records for content_hash in row[\"hashes\"]}\n   116\t            for plane, cases in panels.items()}\n   117\t    if sets[\"search\"] & sets[\"final\"]:\n   118\t        raise ValueError(\"normalized raw document/example overlap\")\n   119\t    ids = {plane: {row[\"source_id\"] for cases in panels[plane].values() for row in cases} for plane in panels}\n   120\t    if ids[\"search\"] & ids[\"final\"]:\n   121\t        raise ValueError(\"source ID overlap\")\n   122\t    for plane, cases in panels.items():\n   123\t        destination = root / \"resources\" / plane\n   124\t        destination.mkdir(parents=True, exist_ok=True)\n   125\t        manifest = {\"normalization\": \"v1 NFC line endings preserve case/whitespace; additional NFKC whitespace-collapsed audit; JSON parsed before hashing; swapped example canonicalization; transitive document groups\",\n   126\t                    \"sources\": SOURCES, \"content_disjoint\": True, \"source_disjoint\": True,\n   127\t                    \"hash_count\": len(sets[plane]), \"group_rule\": \"sha256(split-v1:minimum-content-hash) modulo 4 equals 0 for search\",\n   128\t                    \"nba_exclusions\": [item for item in exclusions if (item[2] < 2010) == (plane == \"search\")], \"cases\": {}}\n   129\t        for case, records in cases.items():\n   130\t            records.sort(key=lambda row: row[\"source_row\"])\n   131\t            if len(records) < 1000:\n   132\t                raise ValueError(\"insufficient panel: \" + case)\n   133\t            names = sorted({row[side] for row in records for side in (\"a\", \"b\")})\n   134\t            index = {name: ordinal for ordinal, name in enumerate(names)}\n   135\t            data = {\"case\": case, \"participants\": names, \"rows\": [[index[row[\"a\"]], index[row[\"b\"]], row[\"y\"], row[\"z\"]] for row in records],\n   136\t                    \"provenance\": [{key: value for key, value in row.items() if key not in (\"a\", \"b\", \"y\", \"z\")} for row in records]}\n   137\t            (destination / (case + \".json\")).write_text(canonical(data) + \"\\n\")\n   138\t            manifest[\"cases\"][case] = {\"rows\": len(records), \"participants\": len(names), \"groups\": len({row[\"group\"] for row in records})}\n   139\t        (destination / \"manifest.json\").write_text(canonical(manifest) + \"\\n\")\n   140\t    print(canonical({plane: {case: len(rows) for case, rows in cases.items()} for plane, cases in panels.items()}))\n   141\t\n   142\t\n   143\tif __name__ == \"__main__\":\n   144\t    parser = argparse.ArgumentParser()\n   145\t    parser.add_argument(\"--arena\", type=pathlib.Path, required=True)\n   146\t    parser.add_argument(\"--nba\", type=pathlib.Path, required=True)\n   147\t    options = parser.parse_args()\n   148\t    prepare(options.arena, options.nba, pathlib.Path(__file__).resolve().parent)\n[\n  \"cases\",\n  \"content_disjoint\",\n  \"group_rule\",\n  \"hash_count\",\n  \"nba_exclusions\",\n  \"normalization\",\n  \"source_disjoin