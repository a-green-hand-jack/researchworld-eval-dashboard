{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/evaluation/capture.py | sed -n '105,134p'; nl -ba source_evidence/evaluation/evaluate_final.py | sed -n '687,796p'\"","aggregated_output":"   105\t            for member in members:\n   106\t                with archive.open(member) as stream:\n   107\t                    reader = csv.DictReader(io.TextIOWrapper(stream,encoding='utf-8-sig',newline=''))\n   108\t                    for index,row in enumerate(reader):\n   109\t                        total += 1\n   110\t                        raw = [row[name] for name in features]\n   111\t                        content = digest(normalize(raw,set(range(10))))\n   112\t                        seen.add(content)\n   113\t                        allowed = all(number(row[key]) is not None for key in ['AGEP','PINCP','WKHP','PWGTP']) and decimal.Decimal(row['AGEP']) > 16 and decimal.Decimal(row['PINCP']) > 100 and decimal.Decimal(row['WKHP']) > 0 and decimal.Decimal(row['PWGTP']) >= 1\n   114\t                        if not allowed:\n   115\t                            continue\n   116\t                        included += 1\n   117\t                        label = decimal.Decimal(row['PINCP']) > 50000\n   118\t                        if content not in groups:\n   119\t                            groups[content] = {'raw':raw,'y':label,'content_sha256':content,'provenance':[],'conflicting_labels':False}\n   120\t                        record = groups[content]\n   121\t                        record['conflicting_labels'] |= record['y'] != label\n   122\t                        record['provenance'].append({'row':index+1,'member':member,'source_id':f'{row[\"SERIALNO\"]}:{row[\"SPORDER\"]}',\n   123\t                                                     'population_filter':True,'full_record_sha256':digest(row)})\n   124\t        populations[plane] = groups\n   125\t        raw_hashes[plane] = seen\n   126\t        stats[plane] = {'raw_records':total,'population_records':included,'unique_population_predictors':len(groups)}\n   127\t    overlap = raw_hashes['search'] & raw_hashes['final']\n   128\t    for plane in ('search','final'):\n   129\t        groups = [record for content,record in populations[plane].items() if content not in overlap]\n   130\t        populations[plane] = partition(groups,'acs-within-2026',33334)\n   131\t    all_search = {record['content_sha256'] for record in german['search']+populations['search']}\n   132\t    all_final = {record['content_sha256'] for record in german['final']+populations['final']}\n   133\t    if all_search & all_final:\n   134\t        raise ValueError('normalized predictor overlap')\n   687\tdef encode_dataset(dataset,smoke):\n   688\t    training = [record for record in dataset['records'] if record['role']=='train']\n   689\t    if smoke:\n   690\t        training = training[:64]\n   691\t    else:\n   692\t        training = training[:20000]\n   693\t    explanations = [record for record in dataset['records'] if record['role']=='explanation']\n   694\t    validation = [record for record in dataset['records'] if record['role']=='validation']\n   695\t    dimension = len(dataset['features'])\n   696\t    numeric = set(dataset['numeric'])\n   697\t    vocabularies = {}\n   698\t    for column in range(dimension):\n   699\t        if column not in numeric:\n   700\t            vocabularies[column] = {value:index for index,value in enumerate(sorted({record['raw'][column] for record in training if record['raw'][column] is not None}))}\n   701\t    def transform(records):\n   702\t        matrix = np.zeros((len(records),dimension))\n   703\t        for row_index,record in enumerate(records):\n   704\t            for column,value in enumerate(record['raw']):\n   705\t                matrix[row_index,column] = float(value) if column in numeric and value not in (None,'') else vocabularies.get(column,{}).get(value,-1) if column not in numeric else np.nan\n   706\t        return matrix\n   707\t    train = transform(training)\n   708\t    medians = np.nanmedian(train,axis=0)\n   709\t    medians = np.nan_to_num(medians)\n   710\t    train = np.where(np.isfinite(train),train,medians)\n   711\t    mean = train.mean(axis=0)\n   712\t    scale = train.std(axis=0)\n   713\t    scale[scale<1e-12] = 1\n   714\t    def standardized(records):\n   715\t        values = transform(records)\n   716\t        return (np.where(np.isfinite(values),values,medians)-mean)/scale\n   717\t    return (train-mean)/scale, np.array([record['y'] for record in training],dtype=int), standardized(explanations), standardized(validation), np.array([record['y'] for record in validation],dtype=int)\n   718\t\n   719\t\n   720\tdef predict(model,rows):\n   721\t    rows = np.asarray(rows,dtype=np.float64)\n   722\t    parameters = model['parameters']\n   723\t    if model['kind'] in ('logistic','affine'):\n   724\t        linear = rows@np.asarray(parameters['coef'])+parameters['intercept']\n   725\t        return linear if model['kind']=='affine' else 1/(1+np.exp(-np.clip(linear,-700,700)))\n   726\t    output = np.zeros(len(rows))\n   727\t    converted = rows.astype(np.float32)\n   728\t    for tree in parameters['trees']:\n   729\t        left,right,features,thresholds,probabilities = (np.asarray(tree[key]) for key in ('left','right','feature','threshold','probability'))\n   730\t        nodes = np.zeros(len(rows),dtype=np.int64)\n   731\t        for depth in range(7):\n   732\t            active = left[nodes]>=0\n   733\t            if not active.any():\n   734\t                break\n   735\t            selected = nodes[active]\n   736\t            nodes[active] = np.where(converted[active][np.arange(len(selected)),features[selected]] <= thresholds[selected],left[selected],right[selected])\n   737\t        output += probabilities[nodes]\n   738\t    return output/len(parameters['trees'])\n   739\t\n   740\t\n   741\tdef serialize_model(estimator,kind,background):\n   742\t    if kind == 'logistic':\n   743\t        parameters = {'coef':estimator.coef_[0].tolist(),'intercept':float(estimator.intercept_[0])}\n   744\t    else:\n   745\t        trees = []\n   746\t        for member in estimator.estimators_:\n   747\t            tree = member.tree_\n   748\t            distribution = tree.value[:,0,:]\n   749\t            trees.append({'left':tree.children_left.tolist(),'right':tree.children_right.tolist(),'feature':tree.feature.tolist(),'threshold':tree.threshold.tolist(),'probability':(distribution[:,1]/distribution.sum(axis=1)).tolist()})\n   750\t        parameters = {'trees':trees}\n   751\t    model = {'kind':kind,'dimension':background.shape[1],'background':background.tolist(),'parameters':parameters}\n   752\t    if len(compact(model))>MAX_DOCUMENT_BYTES:\n   753\t        raise RuntimeError('model serialization bound')\n   754\t    return model\n   755\t\n   756\t\n   757\tdef library_kernel(model,queries,budget,seed,counter):\n   758\t    def oracle(rows):\n   759\t        counter[0] += len(rows)\n   760\t        return predict(model,rows)\n   761\t    state = np.random.get_state()\n   762\t    try:\n   763\t        np.random.seed(seed%(2**32))\n   764\t        explainer = shap.KernelExplainer(oracle,np.asarray(model['background']),link='identity')\n   765\t        values = explainer.shap_values(np.asarray(queries),nsamples=budget,l1_reg=0.0,silent=True)\n   766\t        output = np.asarray(values,dtype=float)\n   767\t        if output.shape != np.asarray(queries).shape or not np.isfinite(output).all():\n   768\t            raise RuntimeError('invalid library reference')\n   769\t        return output\n   770\t    finally:\n   771\t        np.random.set_state(state)\n   772\t\n   773\t\n   774\tdef exact_reference(model,queries,counter):\n   775\t    dimension = model['dimension']\n   776\t    background = np.asarray(model['background'])\n   777\t    numbers = np.arange(1<<dimension,dtype=np.uint32)\n   778\t    masks = ((numbers[:,None]>>np.arange(dimension))&1).astype(bool)\n   779\t    references = []\n   780\t    for query in queries:\n   781\t        values = []\n   782\t        for offset in range(0,len(masks),128):\n   783\t            chunk = masks[offset:offset+128]\n   784\t            hybrids = np.where(chunk[:,None,:],query,background[None,:,:])\n   785\t            flattened = hybrids.reshape(-1,dimension)\n   786\t            counter[0] += len(flattened)\n   787\t            values.extend(predict(model,flattened).reshape(len(chunk),len(background)).mean(axis=1))\n   788\t        values = np.asarray(values)\n   789\t        reference = []\n   790\t        sizes = masks.sum(axis=1)\n   791\t        for feature in range(dimension):\n   792\t            absent = numbers[~masks[:,feature]]\n   793\t            weights = np.array([1/(dimension*math.comb(dimension-1,int(size))) for size in sizes[absent]])\n   794\t            reference.append(float(np.dot(weights,values[absent|(1<<feature)]-values[absent])))\n   795\t        references.append(reference)\n   796\t    return np.asarray(references)\n","exit_code":0,"status":"completed"}}
