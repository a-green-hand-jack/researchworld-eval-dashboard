{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, pathlib, math, hashlib\np=json.load(open('paper_data.json')); s=json.load(open('paper_strategy.json'))\nrequired={'status','selected_prompt_family','recommended_title','central_question','central_thesis','narrative_rationale','prior_paper_story_status','edit_framing_decision','staged_input_impact','method_groups','results_focus','figure_plan','figure_specs','supplementary_plan','forbidden_headings','forbidden_phrases','notes_for_writer','failure_reason'}\nassert required <= s.keys()\nassert s['status']=='ready' and s['selected_prompt_family']=='paper_standalone' and not s['failure_reason']\nassert s['supplementary_plan']['purpose'] and s['supplementary_plan']['planned_subsections']\nfor item in s['figure_specs']+s['supplementary_plan']['planned_subsections']:\n for source in item.get('source_ids',[]): assert source in p['grounding_sources'],source\nfor f in s['figure_specs']:\n assert f['required'] and f['layout_rationale']\n assert f['max_panels']<=4 and f['max_panels_per_row']<=3\n assert f['max_categories_per_panel']<=6 and f['max_series_per_panel']<=4\n assert f['target_width_fraction']==1.0\nassert sum(f['preferred_generator']=='generate-concept-figure' for f in s['figure_specs'])==1\nrows=[(x['case'],x['observations']) for ep in p['final_evaluation']['evaluation_evidence']['episodes'] for x in ep['solution']]\nassert len(rows)==36 and all(o['complete'] for c,o in rows)\nassert sum(o['memorization'] is not None for c,o in rows)==30\nassert all(o['generalization'] is None for c,o in rows)\nassert all(o['memorization']==500 for c,o in rows if c['width'] in (64,256))\nassert all(o['memorization'] is None for c,o in rows if c['width']==16 and c['decay']==1)\nassert all(o['memorization'] in (1000,1500) for c,o in rows if c['width']==16 and c['decay']==0)\nfor c,o in rows:\n expected=20000 if o['memorization'] is None else max(0,(20000 if o['generalization'] is None else o['generalization'])-o['memorization'])\n assert expected==o['lag']\nfor path,key in [('task/evaluate_final.py','evaluator_sha256'),('../final_evaluation/results/evaluation_evidence.json',None)]:\n h='sha256:'+hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()\n expected=p['final_evaluation'][key] if key else p['final_evaluation']['evaluation_evidence']['sha256']\n assert h==expected\nassert not pathlib.Path('paper.tex').exists() and not pathlib.Path('claims_grounding.json').exists()\nprint('PASS: strategy schema, all source IDs, three required figure budgets, event counts, capped-lag identities, and final evaluator/evidence hashes.')\nprint('Final qualification:',{k:p['grounding_sources']['final.qualification.'+k]['value'] for k in ('status','outcome','correct')})\nprint('No final-paper validation or new experiment executed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
