{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0144EDpjuYJeJKefJ45zqNx9","type":"tool_result","content":"numpy==2.2.6\nscipy==1.15.3\nscikit-learn==1.6.1\nnetworkx==3.4.2\ndef evidence_records(episodes):\n    by_seed = collections.OrderedDict()\n    for ep in episodes:\n        r = ep[\"record\"]\n        by_seed.setdefault(r[\"seed\"], []).append(r)\n    out = []\n    for seed, recs in by_seed.items():\n        prim = [r for r in recs if r[\"kind\"] == \"primary\"]\n        errs = [rel_error(None if r[\"primary\"] is None else r[\"primary\"][0], r[\"gate\"]) for r in prim]\n        out.append({\n            \"seed\": int(seed),\n            \"score\": float(-sum(errs) / len(errs)),\n            \"correct\": bool(all(r[\"ok_ops\"] >= len(OPS) for r in recs)),\n            \"duration_seconds\": float(sum(r[\"duration\"] for r in recs)),\n        })\n    return out\n\n\ndef run(args):\n70:GATE_FLOOR = 0.5\n1168:            if not (math.isfinite(inst.gate) and abs(inst.gate) >= GATE_FLOOR):\n\"\"\"Extrapolation-aware regression GATE estimator under network interference.\n\nInterface: ``python_rpc_v1:handle``.  ``handle(request) -> response`` takes and returns\nfinite JSON-compatible values only.  All state lives in memory; nothing is read from or\nwritten to the filesystem.\n\nOperations\n----------\n``{\"op\": \"reset\", \"seed\": <int >= 0>}``  -> ``{\"ok\": True}`` (clears state, seeds RNG).\n``{\"op\": \"estimate\", n, edges, covariates, treatment, outcomes, design, workload}``\n    -> ``{\"estimate\", \"ci_low\", \"ci_high\"}`` (finite, ci_low <= estimate <= ci_high).\n    ``design`` is ``{\"kind\": \"bernoulli\" | \"cluster\", \"probability\", \"cluster_labels\"}``.\n\nMethod\n------\nThe GATE is estimated by fitting ridge regressions of the outcome on own treatment plus\nneighbour-exposure features and predicting at the all-treated and all-control assignments\n(the counterfactual points sit at the corners of the exposure space, neighbour fraction 1\nand 0).  Because the corners are rarely covered by the training exposures, the fitted\nmodels are chosen with an extrapolation-aware validation: besides K-fold CV we hold out the\nunits with the highest / lowest neighbour fraction and the highest degrees and score each\ncandidate on how well it extrapolates to them.  All candidates that are within one standard\nerror of the best on both criteria are averaged (the linear-in-neighbour-fraction model is\nalways a candidate).  The interval comes from a design-resampling wild (block) bootstrap\n(re-draw the assignment from the design, perturb residuals by block), widened by the spread\nof the candidate estimates.  Difference-in-means and a Hajek full-neighbourhood exposure\nestimator are implemented as fallbacks / internal sanity diagnostics.\n\"\"\"\n\nimport base64\nimport time\nimport zlib\n\nimport numpy as np\nimport scipy.sparse as sp\nfrom scipy.special import ndtri\n\n_STATE = {\"rng\": None, \"seed\": None, \"last_diag\": None}\n\n_DTYPES = {\"int32\": \"<i4\", \"float64\": \"<f8\", \"uint8\": \"u1\"}\n\n_RIDGE = 1e-3  # ridge strength relative to n on standardised columns\n_TWO_HOP_MAX_WORK = 3.0e6  # max sum(deg^2) for exact two-hop matrix\n_SOFT_DEADLINE = 1.5  # seconds after request start at which we stop bootstrapping\n_N_REPS = 150  # max bootstrap replications (n_reps)\n\n\ndef decode_array(obj):\n    \"\"\"Decode an array object (see module docstring) into a numpy array.\"\"\"\n    if obj is None:\n        return None\n    if obj[\"encoding\"] != \"base64-le\" or obj[\"dtype\"] not in _DTYPES:\n        raise ValueError(\"unsupported array encoding\")\n    buf = base64.b64decode(obj[\"data\"])\n    return np.frombuffer(buf, dtype=np.dtype(_DTYPES[obj[\"dtype\"]])).reshape(obj[\"shape\"]).copy()\n\n\n# --------------------------------------------------------------------------- graph helpers\ndef _adjacency(n, edges):\n    if len(edges) == 0:\n======\n\"\"\"Regression-based GATE estimator under network interference (starter candidate).\n\nInterface: ``python_rpc_v1:handle``.  ``handle(request) -> response`` takes and returns\nfinite JSON-compatible values only.  The candidate owns all of its state in memory; it\nshares no filesystem with the evaluator and must not read or write evaluator paths.\n\nOperations\n----------\n``{\"op\": \"reset\", \"seed\": <int >= 0>}``\n    Clears ALL candidate state and seeds the candidate RNG.  The seed only initializes\n    randomness; it never identifies a plane, case or workload.  Any non-negative integer\n    is valid.  Response: exactly ``{\"ok\": true}`` (no other keys).\n\n``{\"op\": \"estimate\", ...}``\n    One full dataset from one randomized experiment on a network.  The evaluator sends\n    exactly one ``reset`` per episode and then four ``estimate`` requests in an\n    evaluator-private order.  All four have the identical format and size and the same\n    budget; the candidate must treat every request as an ordinary dataset and must not\n    try to detect which one is which.  Each ``estimate`` is independent: return the best\n    estimate for the request in hand.\n\n    Request fields (all present, no others):\n      op         \"estimate\"\n      n          int, number of nodes (nodes are 0..n-1)\n      edges      array object, undirected unique edges (u < v), dtype int32, shape [E, 2]\n      covariates array object, node covariates, dtype float64, shape [n, 2]\n      treatment  array object, realized treatment assignment, dtype uint8 (0/1), shape [n]\n      outcomes   array object, observed outcomes, dtype float64, shape [n]\n      design     {\"kind\": \"bernoulli\" | \"cluster\",\n                  \"probability\": float,   # marginal treatment probability of the design\n                  \"cluster_labels\": array object (int32, shape [n]) or null}\n                 \"bernoulli\": each node treated independently with ``probability``.\n                 \"cluster\":   whole clusters (``cluster_labels``) are treated together;\n                              exactly round(K*probability) of the K clusters are treated,\n                              chosen uniformly at random.\n      workload   {\"max_op_seconds\": float,  # soft per-request time budget (hard cap is a\n                                            # little larger; exceeding it fails the episode)\n                  \"ci_level\": float}        # nominal level of the requested interval\n\n    Array objects are ``{\"dtype\": \"<name>\", \"shape\": [...], \"encoding\": \"base64-le\",\n    \"data\": \"<base64 of the C-order little-endian buffer>\"}``; see ``decode_array``.\n\n    Target: the global average treatment effect (GATE), i.e. the mean over nodes of\n    Y_i(all nodes treated) - Y_i(all nodes control) for the (hidden) potential outcomes.\n    The interference mechanism, its parameters and the true GATE are never revealed.\n\n    Response (JSON object): required keys ``estimate``, ``ci_low``, ``ci_high``\n    (finite numbers with ci_low <= estimate <= ci_high); optional key ``diagnostics``\n    (a JSON object, at most 4096 bytes serialized; ignored for scoring).  Any other key,\n    a non-finite number, a malformed type or an interval that does not contain the\n    estimate makes that request invalid (the episode keeps its worst-case contribution).\n\nLimits (enforced by the evaluator; a violation is a failed request, never retried):\n  * ``reset`` must answer within 4 s (it includes process/import start-up);\n  * each ``estimate`` must answer within 3 s wall clock (``workload.max_op_seconds`` = 2.5 s\n    is the soft budget to aim for); at most 4 threads of CPU are available;\n  * a complete request is below 0.5 MiB and a complete response must stay far below the\n    64 MiB wire limit (a valid response is < 5 KiB);\n  * no filesystem or network is shared with the evaluator; do not read or write evaluator paths.\nDeterminism: all candidate randomness must derive from the ``reset`` seed, because the evaluator\n24:seed_err = np.array([-e[\"score\"] for e in eps])  # per-seed mean relative error over 8 cases\n25:seeds = np.array([e[\"seed\"] for e in eps])\n27:boot = np.array([rng.choice(seed_err, len(seed_err)).mean() for _ in range(10000)])\n29:    \"n_seeds\": int(len(seed_err)),\n30:    \"seed_mean\": float(seed_err.mean()),\n31:    \"seed_median\": float(np.median(seed_err)),\n32:    \"seed_min\": float(seed_err.min()), \"seed_max\": float(seed_err.max()),\n33:    \"seed_std\": float(seed_err.std(ddof=1)),\n34:    \"boot_ci_low\": float(np.percentile(boot, 2.5)), \"boot_ci_high\": float(np.percentile(boot, 97.5)),\n35:    \"n_seeds_above_0p15\": int((seed_err > 0.15).sum()),\n36:    \"outlier_seeds\": [int(s) for s in seeds[seed_err > 0.15]],\n37:    \"mean_excluding_outliers\": float(seed_err[seed_err <= 0.15].mean()),\n91:b.set_ylim(0, 0.52); b.set_ylabel(\"Rel. RMSE (24 seeds)\")\n98:a.scatter(seeds, seed_err, s=22, color=C[\"frozen\"], zorder=3)\n99:for s, v in zip(seeds, seed_err):\n102:a.axhline(stats[\"seed_mean\"], color=\"k\", lw=1.2, label=f\"mean {stats['seed_mean']:.3f}\")\n103:a.axhspan(stats[\"boot_ci_low\"], stats[\"boot_ci_high\"], color=\"k\", alpha=0.15,\n104:          label=f\"95% bootstrap [{stats['boot_ci_low']:.3f}, {stats['boot_ci_high']:.3f}]\")\n105:a.set_xlabel(\"Evaluation seed\"); a.set_ylabel(\"Mean rel. error (8 cases)\")\n107:a.set_title(\"(a) Per-seed error\", loc=\"left\")","is_error":false}]},"parent_tool_use_id":null,"session_id":"c5763a6a-5113-409b-b2f9-b2a46f5c58bf","uuid":"7f8c763f-57d0-4b58-b0aa-68a7b3134687","timestamp":"2026-11-11T09:01:19.638Z","tool_use_result":{"stdout":"numpy==2.2.6\nscipy==1.15.3\nscikit-learn==1.6.1\nnetworkx==3.4.2\ndef evidence_records(episodes):\n    by_seed = collections.OrderedDict()\n    for ep in episodes:\n        r = ep[\"record\"]\n        by_seed.setdefault(r[\"seed\"], []).append(r)\n    out = []\n    for seed, recs in by_seed.items():\n        prim = [r for r in recs if r[\"kind\"] == \"