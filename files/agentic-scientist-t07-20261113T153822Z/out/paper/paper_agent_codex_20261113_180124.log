{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/apply_patch <<'PY'\n#\"'!/usr/bin/env python3\nimport sys,pathlib,subprocess\ntext=sys.stdin.read(); lines=text.splitlines(keepends=True); index=1\nwhile index < len(lines):\n line=lines[index].rstrip('\"'\\\\n')\n if line=='*** End Patch': break\n if line.startswith('*** Add File: '):\n  path=pathlib.Path(line[14:]); index+=1; content=[]\n  while index<len(lines) and not lines[index].startswith('*** '):\n   assert lines[index].startswith('+'); content.append(lines[index][1:]); index+=1\n  path.parent.mkdir(parents=True,exist_ok=True); path.write_text(''.join(content)); print('Added',path)\n elif line.startswith('*** Update File: '):\n  path=line[17:]; index+=1; hunks=[]\n  while index<len(lines) and not lines[index].startswith('*** '): hunks.append(lines[index]); index+=1\n  old=pathlib.Path(path).read_text(); blocks=''.join(hunks).split('@@\\\\n')\n  for block in blocks:\n   if not block.strip(): continue\n   before=''.join(x[1:] for x in block.splitlines(keepends=True) if x.startswith((' ','-')))\n   after=''.join(x[1:] for x in block.splitlines(keepends=True) if x.startswith((' ','+')))\n   assert before in old, repr(before[:100]); old=old.replace(before,after,1)\n  pathlib.Path(path).write_text(old); print('Updated',path)\n else: raise ValueError(line)\nPY\nchmod +x /tmp/apply_patch\nmkdir -p source_evidence\ncp results/ideas/03_rasch_residual_profile_mixtures_on_fixed_score_targeted_prefixes/program_1/src/program.py source_evidence/selected_method.py\ncp results/ideas/03_rasch_residual_profile_mixtures_on_fixed_score_targeted_prefixes/program_1/src/METHOD.md source_evidence/METHOD.md\ncp results/ideas/03_rasch_residual_profile_mixtures_on_fixed_score_targeted_prefixes/program_1/program_spec.toml source_evidence/program_spec.toml\ncp task/evaluate_final.py source_evidence/evaluate_final.py\ncp task/resources/final/manifest.json source_evidence/final_data