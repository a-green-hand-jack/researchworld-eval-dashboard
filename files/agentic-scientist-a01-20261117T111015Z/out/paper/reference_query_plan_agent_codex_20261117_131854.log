01\",\n      \"worker_02\",\n      \"combined_score\",\n      \"rubric\"\n    ],\n    \"internal_fields\": [\n      \"correct\",\n      \"eligible\"\n    ],\n    \"preferred_terms\": {\n      \"idea\": \"model variant\",\n      \"ideas\": \"model variants\",\n      \"implementation\": \"configuration\",\n      \"implementations\": \"configurations\",\n      \"program\": \"seeded run\",\n      \"programs\": \"seeded runs\"\n    },\n    \"run_unit\": \"seeded_run\",\n    \"threshold_rate_rule\": \"If a thresholded rate appears in the visible paper, keep one reader-facing meaning per figure, such as target attainment, successful-run fraction, or non-collapse rate. Do not reuse a single label for different task-specific thresholds.\",\n    \"variant_unit\": \"model_variant\"\n  },\n  \"results_dir\": \"work/results/a01/codex/20261117_111437/investigation\",\n  \"top_programs\": [],\n  \"totals\": {\n    \"attempts\": 3,\n    \"correct_programs\": 0,\n    \"evaluated_programs\": 3,\n    \"ideas\": 3\n  }\n}{\n  \"global_memory_dir\": \"work/results/a01/codex/20261117_111437/investigation\",\n  \"output_dir\": \"work/results/a01/codex/20261117_111437/paper\",\n  \"results_dir\": \"work/results/a01/codex/20261117_111437/investigation\",\n  \"schema_version\": 1,\n  \"task_dir\": \"work/results/a01/codex/20261117_111437/task\"\n}\nlrwxrwxrwx 1 agent agent   16 Nov 17 13:18 global_memory -> ../investigation\n\nfigures:\ntotal 8\ndrwx------ 2 agent agent 4096 Nov 17 13:18 .\ndrwx------ 5 agent agent 4096 Nov 17 13:19 ..\n{\n  \"effective_results_dir\": \"work/results/a01/codex/20261117_111437/investigation\",\n  \"mode\": \"direct\",\n  \"paper_results_dir\": \"work/results/a01/codex/20261117_111437/investigation\",\n  \"requested_results_dir\": \"work/results/a01/codex/20261117_111437/investigation\",\n  \"source_results_dir\": \"work/results/a01/codex/20261117_111437/investigation\"\n}","exit_code":0,"status":"completed"}}
