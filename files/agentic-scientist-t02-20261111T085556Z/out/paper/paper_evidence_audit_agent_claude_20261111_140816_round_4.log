   ],\n463\t    \"queries\": [\n464\t      {\n465\t        \"category\": \"core_method\",\n466\t        \"query\": \"grokking generalization beyond overfitting small algorithmic datasets modular arithmetic\",\n467\t        \"rationale\": \"Anchors the delayed-generalization phenomenon and the modular-arithmetic task family used in every run.\"\n468\t      },\n469\t      {\n470\t        \"category\": \"benchmark_context\",\n471\t        \"query\": \"progress measures for grokking mechanistic interpretability modular addition transformer\",\n472\t        \"rationale\": \"Defines the small one-block transformer / modular-addition setting and Fourier-circuit view that the width sweeps build on.\"\n473\t      },\n474\t      {\n475\t        \"category\": \"baseline_comparator\",\n476\t        \"query\": \"grokking circuit efficiency memorization versus generalization circuits\",\n477\t        \"rationale\": \"Circuit-efficiency explanation is the main competing account to the memorization-capacity crossover hypothesis (idea 1).\"\n478\t      },\n479\t      {\n480\t        \"category\": \"baseline_comparator\",\n481\t        \"query\": \"grokking transition from lazy to rich training dynamics\",\n482\t        \"rationale\": \"Lazy-to-rich account is the comparator behind the width-aware output-scaling variant (idea 2).\"\n483\t      },\n484\t      {\n485\t        \"category\": \"baseline_comparator\",\n486\t        \"query\": \"Omnigrok loss landscape weight norm grokking\",\n487\t        \"rationale\": \"Weight-norm / loss-landscape explanation and initialization-scale dependence relevant to init-scale and weight-decay choices.\"\n488\t      },\n489\t      {\n490\t        \"category\": \"baseline_comparator\",\n491\t        \"query\": \"unifying grokking and double descent model size\",\n492\t        \"rationale\": \"Connects grokking to double descent in model size and data fraction; relevant to the width-by-train-fraction sweep.\"\n493\t      },\n494\t      {\n495\t    