{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"/tmp/apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: retrieve_paper_references.py\n+import datetime\n+import json\n+from pathlib import Path\n+import time\n+import urllib.parse\n+import urllib.request\n+\n+\n+SPECS = [\n+    ('MTEB', 'ARXIV:2210.07316'),\n+    ('TinyBenchmarks', 'ARXIV:2402.14992'),\n+    ('MetaBench', 'ARXIV:2407.12844'),\n+    ('ObservationalScaling', 'ARXIV:2405.10938'),\n+    ('Sloth', 'ARXIV:2412.06540'),\n+    ('Koren2009', 'DOI:10.1109/MC.2009.263'),\n+    ('Hu2008', 'DOI:10.1109/ICDM.2008.22'),\n+    ('Candes2009', 'DOI:10.1007/s10208-009-9045-5'),\n+    ('Jain2013', 'ARXIV:1212.0467'),\n+    ('Rennie2005', 'DOI:10.1145/1102351.1102441'),\n+    ('Koenker1978', 'DOI:10.2307/1913643'),\n+    ('Stone1977', 'DOI:10.1214/aos/1176343886'),\n+    ('Sherman1950', 'DOI:10.1214/aoms/1177730034'),\n+    ('Hoerl1970', 'DOI:10.1080/00401706.1970.10488634'),\n+    ('Chaloner1995', 'DOI:10.1214/ss/1177009939'),\n+    ('Cohn1996', 'DOI:10.1613/jair.295'),\n+    ('Rubin1976', 'DOI:10.1093/biomet/63.3.581'),\n+    ('Efron1979', 'DOI:10.1214/aos/1176344552'),\n+    ('Cameron2008', 'DOI:10.1162/rest.90.3.414'),\n+    ('Takacs2008', '32fb6a88307d80ec5c932de843624d398e04ab28'),\n+    ('Mnih2007', 'Probabilistic Matrix Factorization'),\n+    ('Salakhutdinov2008', 'Bayesian Probabilistic Matrix Factorization using Markov Chain Monte Carlo'),\n+    ('Mazumder2010', 'Spectral Regularization Algorithms for Learning Large Incomplete Matrices'),\n+    ('Boutilier2003', 'Active Collaborative Filtering'),\n+    ('Ledoit2004', 'A Well-Conditioned Estimator for Large-Dimensional Covariance Matrices'),\n+]\n+\n+\n+def fetch(url):\n+    for retry in range(4):\n+        try:\n+            with urllib.request.urlopen(url, timeout=40) as response:\n+                return json.load(response)\n+        except Exception:\n+            if retry == 3:\n+                raise\n+            time.sleep(2 + retry * 3)\n+\n+\n+def main():\n+    directory = Path('literature_evidence')\n+    directory.mkdir(exist_ok=True)\n+    references = []\n+    entries = []\n+    for key, identity in SPECS:\n+        cache = directory / (key + '.json')\n+        if cache.exists():\n+            result = json.loads(cache.read_text())\n+        else:\n+            if ':' not in identity and len(identity) \"'!= 40:\n+                search = fetch('\"'https://api.semanticscholar.org/graph/v1/paper/search?' + urllib.parse.urlencode({'query': identity, 'limit': 1, 'fields': 'title'}))\n+                result_title = search['data'][0]['title']\n+                canonical = lambda value: ''.join(character.lower() for character in value if character.isalnum())\n+                assert canonical(result_title) == canonical(identity), (identity, result_title)\n+                identity = search['data'][0]['paperId']\n+            url = 'https://api.semanticscholar.org/graph/v1/paper/' + urllib.parse.quote(identity, safe=':/.') + '?fields=paperId,title,year,authors,abstract,citationStyles,venue'\n+            result = fetch(url)\n+            result['retrieval_url'] = url\n+            cache.write_text(json.dumps(result, indent=2))\n+        entry = result['citationStyles']['bibtex']\n+        entry = entry[:entry.index('{') + 1] + key + entry[entry.index(','):]\n+        entries.append(entry)\n+        references.append(dict(id='ref.s2.' + result['paperId'], paper_id=result['paperId'], citation_key=key, title=result['title'], year=result['year'], venue=result['venue'], query=identity, source_url=result['retrieval_url'], retrieved_at=datetime.datetime.now(datetime.timezone.utc).isoformat(), consulted_content='abstract' if result.get('abstract') else 'metadata only', evidence_path=str(cache)))\n+        print(key, result['title'], '\\\\n', result.get('abstract'), flush=True)\n+    assert len({reference['paper_id'] for reference in references}) == len(SPECS)\n+    Path('references.bib').write_text('\\\\n\\\\n'.join(entries) + '\\\\n')\n+    Path('references_provenance.json').write_text(json.dumps(dict(generated_at=datetime.datetime.now(datetime.timezone.utc).isoformat(), count=len(references), queries=[identity for key, identity in SPECS], references=references), indent=2))\n+\n+\n+if __name__ == '__main__':\n+    main()\n*** End Patch\nPATCH\npython retrieve_paper_references.py > /tmp/reference_consultation.txt 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
