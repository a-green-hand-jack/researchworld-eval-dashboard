{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,60p' build_paper_artifacts.py; sed -n '110,210p' build_paper_artifacts.py; sed -n '1,45p' build_claims.py; cat scientific-evidence/schemas/artifact-manifest.schema.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,60p' build_paper_artifacts.py; sed -n '110,210p' build_paper_artifacts.py; sed -n '1,45p' build_claims.py; cat scientific-evidence/schemas/artifact-manifest.schema.json\"","aggregated_output":"import hashlib\nimport json\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n\nROOT = Path(__file__).resolve().parent\nMETHODS = ['Column mean', 'Query mean', 'Random low-rank', 'Variance low-rank', 'Linear ridge', 'Residual transfer']\nCOLORS = ['#888888', '#bb9944', '#8064a2', '#d48232', '#408c87', '#2464a6']\n\n\ndef provenance(path, kind='figure'):\n    payload = dict(schema_name='scientific-evidence.artifact-manifest',\n                   artifact=dict(path=str(path), kind=kind, sha256=hashlib.sha256(path.read_bytes()).hexdigest()),\n                   derived_from=['@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]', '@evidence[[build_paper_artifacts.py]]'],\n                   generated_by=dict(script_path='build_paper_artifacts.py', command=['python', 'build_paper_artifacts.py']))\n    Path(str(path) + '.prov.json').write_text(json.dumps(payload, indent=2))\n\n\ndef save_plot(figure, stem):\n    for extension in ['pdf', 'png']:\n        path = ROOT / 'figures' / (stem + '.' + extension)\n        figure.savefig(path, dpi=300, facecolor='white')\n        provenance(path.relative_to(ROOT))\n    plt.close(figure)\n\n\ndef main():\n    \"\"\"@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    @evidence[[source_evidence/evaluate_final.py#L970-L1045]]\n    \"\"\"\n    payload = json.loads((ROOT / 'paper_data.json').read_text())\n    final = payload['final_evaluation']\n    episodes = final['evaluation_evidence']['episodes']\n    seeds = [episode['seed'] for episode in episodes]\n    arrays = {}\n    for case in ['A', 'B', 'C', 'D']:\n        arrays[case] = []\n        for episode in episodes:\n            condition = episode['solution']['cases'][case]\n            baselines = np.asarray(condition['baseline_mae_by_method_row_checkpoint'])\n            studied = np.asarray(condition['mae_by_row_checkpoint'])[None, :, :]\n            arrays[case].append(np.concatenate([baselines, studied], axis=0).mean(axis=1))\n        arrays[case] = np.asarray(arrays[case])\n    primary_seed = (arrays['A'].mean(axis=2) + arrays['B'].mean(axis=2)) / 2\n    primary = primary_seed.mean(axis=0)\n    assert np.isclose(primary[-1], final['metrics']['mae'], atol=1e-14)\n    assert np.isclose(primary[:-1].min(), final['metrics']['baseline_mae'], atol=1e-14)\n    budget = (arrays['A'][:, -1].mean(axis=0) + arrays['B'][:, -1].mean(axis=0)) / 2\n    for index, count in enumerate([1, 2, 4, 8]):\n        assert np.isclose(budget[index], final['metrics']['mae_k' + str(count)], atol=1e-14)\n    summary = dict(seeds=seeds, methods=METHODS, primary_mean=primary.tolist(),\n                   primary_seed=primary_seed.tolist(), primary_seed_sd=primary_seed.std(axis=0, ddof=1).tolist(),\n                   cases={case:dict(seed_budget=values.tolist(), mean_budget=values.mean(axis=0).tolist(), mean=values.mean(axis=(0, 2)).tolist(), seed_sd=values.mean(axis=2).std(axis=0, ddof=1).tolist()) for case, values in arrays.items()},\n                   relative_reduction=float((primary[:-1].min() - primary[-1]) / primary[:-1].min()),\n                   changing_target_mae={case:float(np.mean([np.asarray(episode['solution']['cases'][case]['all_unqueried_mae_by_row_checkpoint']).mean() for episode in episodes])) for case in arrays})\n                    samples[resample] -= np.ones(5) / (2 * len(episodes))\n                else:\n                    gains = np.asarray(condition['baseline_mae_by_method_row_checkpoint']).mean(axis=2) - np.asarray(condition['mae_by_row_checkpoint']).mean(axis=1)\n                    samples[resample] += gains @ weights / weights.sum() / (2 * len(episodes))\n    return np.quantile(samples, [.005, .995], axis=0)\n\n\ndef create_tables(summary):\n    evidence = '% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\\n'\n    lines = [evidence, r'\\begin{tabular}{lrrr}', r'\\toprule', r'Estimator & Model holdout & Family holdout & Overall \\\\', r'\\midrule']\n    for index, method in enumerate(METHODS):\n        means = [summary['cases'][case]['mean'][index] for case in ['A', 'B']] + [summary['primary_mean'][index]]\n        lines.append(method + ' & ' + ' & '.join(f'{value:.5f}' for value in means) + r' \\\\')\n    lines.extend([r'\\bottomrule', r'\\end{tabular}'])\n    Path('tables/main_comparison.tex').write_text('\\n'.join(lines) + '\\n')\n    lines = [evidence, r'\\begin{tabular}{llrrrr}', r'\\toprule', r'Holdout & Estimator & $k=1$ & $k=2$ & $k=4$ & $k=8$ \\\\', r'\\midrule']\n    for case, label in [('A', 'Model'), ('B', 'Family')]:\n        for index, method in enumerate(METHODS):\n            values = summary['cases'][case]['mean_budget'][index]\n            lines.append(label + ' & ' + method + ' & ' + ' & '.join(f'{value:.5f}' for value in values) + r' \\\\')\n        if case == 'A':\n            lines.append(r'\\midrule')\n    lines.extend([r'\\bottomrule', r'\\end{tabular}'])\n    Path('tables/budget_details.tex').write_text('\\n'.join(lines) + '\\n')\n    lines = [evidence, r'\\begin{tabular}{lrrrrrr}', r'\\toprule', r'Seed & Col. mean & Query mean & Random LR & Var. LR & Ridge & Studied \\\\', r'\\midrule']\n    for seed, values in zip(summary['seeds'], summary['primary_seed']):\n        lines.append(str(seed) + ' & ' + ' & '.join(f'{value:.5f}' for value in values) + r' \\\\')\n    lines.append(r'\\midrule')\n    lines.append('Seed SD & ' + ' & '.join(f'{value:.5f}' for value in summary['primary_seed_sd']) + r' \\\\')\n    lines.extend([r'\\bottomrule', r'\\end{tabular}'])\n    Path('tables/seed_details.tex').write_text('\\n'.join(lines) + '\\n')\n    for path in Path('tables').glob('*.tex'):\n        provenance(path, 'table')\n\n\ndef create_overview_placeholder():\n    if Path('.concept_figure_complete').exists():\n        return\n    prompt_path = Path('figures/method_overview.prompts.json')\n    if prompt_path.exists() and json.loads(prompt_path.read_text()):\n        return\n    image_path = Path('figures/method_overview.png')\n    if not image_path.exists():\n        from PIL import Image, ImageDraw\n        image = Image.new('RGB', (2400, 950), 'white')\n        draw = ImageDraw.Draw(image)\n        draw.text((70, 70), 'Overview reserved for synchronous concept-figure rendering', fill='#555555', font_size=42)\n        image.save(image_path)\n    if not prompt_path.exists():\n        prompt_path.write_text('{}\\n')\n\n\ndef create_manifest():\n    common = dict(placement='full_width', intended_latex_width_fraction=1.0, estimated_min_rendered_font_pt=8.8, font_sizes=dict(title=10, axis=9, ticks=9, legend=9), source_ids=['final.evidence.episodes'], max_label_chars=36, uses_abbrev_labels=True, uses_progression=False)\n    figures = [dict(common, figure_id='method_overview', figure_type='diagram', path_png='figures/method_overview.png', generator='generate-concept-figure', prompt_log_path='figures/method_overview.prompts.json', n_panels=2, panels_per_row=1, categories_per_panel=[5, 5], series_per_panel=[2, 2], source_ids=[]),\n               dict(common, figure_id='budget_comparison', figure_type='line', path_pdf='figures/budget_comparison.pdf', path_png='figures/budget_comparison.png', generator='matplotlib', n_panels=2, panels_per_row=2, categories_per_panel=[4, 4], series_per_panel=[4, 4]),\n               dict(common, figure_id='history_structure_controls', figure_type='scatter', path_pdf='figures/history_structure_controls.pdf', path_png='figures/history_structure_controls.png', generator='matplotlib', n_panels=1, panels_per_row=1, categories_per_panel=[3], series_per_panel=[3], intended_latex_width_fraction=.9)]\n    Path('figure_manifest.json').write_text(json.dumps(dict(figures=figures), indent=2))\n\n\nif __name__ == '__main__':\n    main()\nimport json\nfrom pathlib import Path\n\n\ndef main():\n    \"\"\"@evidence[[paper_data.json#/final_evaluation]]\n    @evidence[[references_provenance.json#/references]]\n    \"\"\"\n    claims = []\n\n    def add(text, sources, locations=None):\n        claim = dict(claim=text, source_ids=sources, citation_keys=[])\n        if locations:\n            claim['source_locations'] = locations\n        claims.append(claim)\n\n    episodes = ['final.evidence.episodes']\n    implementation = ['result.best_correct_score']\n    add('Final evaluation completed and qualified; qualification is not evidence of universal validity or superiority.', ['final.qualification.status', 'final.qualification.outcome', 'final.qualification.correct'])\n    add('The final frozen MTEB plane has 126 rows and 135 task/subset columns, not independent benchmark suites; results revision is 6dabbcc68c28ea5f180ce7df79347b3ca9cc6383.', episodes, ['source_evidence/resources/final/manifest.json:1', 'source_evidence/evaluate_final.py:715'])\n    add('English text-only main-score extraction preserves bounded noncorrelations and maps correlations by (x+1)/2; task-definition revision 5a83aafe4e7140d0606b96f59448c704f31dbf76, global support 32 and row support 12 are manifest rules.', episodes, ['source_evidence/evaluate_final.py:685', 'source_evidence/resources/final/manifest.json:1'])\n    add('History/test alias and normalized content separation are checked; family holdout additionally separates heuristic family labels. This does not certify true ancestry or pretraining independence.', episodes, ['source_evidence/evaluate_final.py:715'])\n    add('A shuffled approximately two-thirds reservoir, cut at least eight, is disjoint from a sealed target set fixed across budgets and methods; only observed cells are retrospectively evaluated.', episodes, ['source_evidence/evaluate_final.py:851'])\n    add('Rank-four ridge ALS with ridge 0.1, fifty sweeps and Gaussian factor initialization SD 0.1 fits observed entries only; historical means remain fixed.', implementation + episodes, ['source_evidence/selected/src/program.py:363', 'source_evidence/evaluate_final.py:920'])\n    add('Ridge conditioning and the all-column integrated-variance acquisition formula describe the evaluated source. The rank-one algebra is a surrogate reduction, not an MAE or calibrated posterior guarantee; selection is independent of revealed values.', implementation, ['source_evidence/selected/src/program.py:395'])\n    add('Donor-excluded auxiliary predictions yield residuals only for observed donor targets; shared-anchor kernel weights are multiplied by overlap fraction, use a 0.025 scale floor, and vanish at zero overlap.', implementation, ['source_evidence/selected/src/program.py:51', 'source_evidence/selected/src/program.py:97', 'source_evidence/selected/src/program.py:145'])\n    add('Weighted median residual correction uses effective-count shrinkage, excludes queried columns, clips to [0,1], and leaves the base unchanged below total-weight threshold 1e-12 or at zero blend.', implementation, ['source_evidence/selected/src/program.py:164', 'source_evidence/selected/src/program.py:300'])\n    add('History-only nested calibration uses two validation folds and two donor folds, at most 16 validation rows, 128 donors, 12 auxiliary sweeps, and pool cap min(512,max(64,floor(196608/N))).', implementation, ['source_evidence/selected/src/program.py:200'])\n    add('Calibration grid h={0.35,0.75,1.5}, tau={4,16}, alpha={0,0.25,0.5,1} includes exact zero fallback; historical finite-cell pooling differs from fixed-target outer row averaging.', implementation, ['source_evidence/selected/src/program.py:200'])\n    add('ALS arithmetic cost O(E r^2+(M+N)r^3) per sweep and donor-by-column residual storage are direct algebraic consequences of the inspected dense-solve loops, not measured runtime or novel theory.', implementation, ['source_evidence/selected/src/program.py:51', 'source_evidence/selected/src/program.py:363'])\n    add('Five final references are column mean, query mean, random-query low-rank, variance-query low-rank, and linear ridge; query policies differ and centered missing entries in linear ridge are zero-filled.', episodes, ['source_evidence/evaluate_final.py:870'])\n    add('Constant history preserves masks and replaces observed values by column means. Column shifting rolls each value/mask pair by an independent nonzero offset, preserving per-column observed multisets; controls match model holdout.', episodes, ['source_evidence/evaluate_final.py:808', 'source_evidence/resources/final/plan.json:1'])\n    add('Budgets 1,2,4,8 use nested prefixes; seeds 6841,8089,9011; history/test sizes 94/32 except final family split 93/33; six primary condition/seed averages have equal weight.', episodes, ['source_evidence/resources/final/plan.json:1', 'source_evidence/evaluate_final.py:970'])\n    add('Aggregate MAE 0.040807843083862115, RMSE 0.06432104648676243, strongest aggregate baseline 0.045249969215420516, gain 0.004442126131558401, relative reduction 9.816860008%.', ['final.metric.mae','final.metric.rmse','final.metric.baseline_mae','final.metric.delta_best_baseline'], ['derived_results.json:1'])\n    add('All six estimators and both holdouts in Table 1, the complete budget table, and seed table reproduce retained episode arrays; the studied configuration has lower aggregate MAE in each holdout than every reference.', episodes, ['derived_results.json:1','tables/main_comparison.tex:1','tables/budget_details.tex:1','tables/seed_details.tex:1'])\n    add('Studied MAE model/family=0.038312665669/0.043303020499 versus linear ridge 0.045116500008/0.045383438423; partitions differ, so no causal effect of family membership is inferred.', episodes, ['derived_results.json:1'])\n    add('Studied seed MAEs 0.038496586319,0.041126033629,0.042800909303 (sample SD 0.002169731091); linear-ridge seed MAEs 0.041657905965,0.045940218194,0.048151783488. Seeds share source data.', episodes, ['derived_results.json:1'])\n    add('Primary budget MAEs 0.045233341978,0.042208509062,0.039639061083,0.036150460213 decrease over k=1,2,4,8. Each holdout seed-mean curve decreases, without per-model monotonicity or sufficient-budget claims.', ['final.metric.mae_k1','final.metric.mae_k2','final.metric.mae_k4','final.metric.mae_k8'] + episodes, ['derived_results.json:1'])\n    add('At eight queries studied model/family errors are 0.034476748972/0.037824171454, versus ridge 0.039273276354/0.039840694780.', episodes, ['derived_results.json:1'])\n    add('Paired component resampling uses 400 draws and RNG 424242; quantiles .005/.995 for each of five baselines precede separate minima of lower and upper bounds. These are not a conventional single-comparator interval.', episodes + ['final.metric.gain_ci_low','final.metric.gain_ci_high'], ['source_evidence/evaluate_final.py:999','derived_results.json:1'])\n    add('Reported bound minima [0.0021032442082077377,0.009199712663056218] are reconstructed exactly; all baseline-specific intervals in the supplement come from the same retained paired arrays.', ['final.metric.gain_ci_low','final.metric.gain_ci_high'] + episodes, ['derived_results.json:1'])\n    add('Matched model-holdout intact MAE 0.038312665669 rises to 0.064367113099 under constant history and 0.068569520893 under column shifts; shifted column mean is 0.064367113099 and variance low-rank 0.070913935972. The method loses to column mean under shifts.', ['final.metric.constant_control_mae','final.metric.permuted_control_mae'] + episodes, ['derived_results.json:1'])\n    add('Constant-history column means and all centered historical linear references equal the studied sealed-target MAE; controls do not isolate any component.', episodes, ['derived_results.json:1'])\n    add('All-unqueried changing-target diagnostic MAEs A/B/C/D=0.036645358811/0.042420107742/0.065275510462/0.063523296739; not a common-target comparison.', episodes, ['derived_results.json:1'])\n    add('Reset replay query sequences matched and maximum absolute prediction difference was zero; diagnostics do not certify all possible leakage checks.', ['final.metric.reset_max_abs_delta','final.qualification.outcome'], ['source_evidence/evaluate_final.py:976'])\n{\n  \"$id\": \"https://schemas.agentic-scientist.local/scientific-evidence/artifact-manifest.schema.json\",\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"artifact\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"source\",\n            \"derived\",\n            \"manuscript\",\n            \"figure\",\n            \"table\",\n            \"script\",\n            \"log\",\n            \"other\"\n          ],\n          \"type\": \"string\"\n        },\n        \"media_type\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Path to the artifact relative to the scientific-evidence root when possible.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"sha256\": {\n          \"description\": \"Optional hash recorded when the producing workflow computes one.\",\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"kind\"\n      ],\n      \"type\": \"object\"\n    },\n    \"derived_from\": {\n      \"description\": \"Inline @evidence refs or stable ids describing the artifact inputs.\",\n      \"items\": {\n        \"minLength\": 1,\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"type\": \"array\"\n    },\n    \"generated_by\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"command\": {\n          \"items\": {\n            \"minLength\": 1,\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"type\": \"array\"\n        },\n        \"cwd\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"finished_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        },\n        \"script_path\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"script_sha256\": {\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        },\n        \"started_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"script_path\"\n      ],\n      \"type\": \"object\"\n    },\n    \"named_outputs\": {\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"number\",\n          \"integer\",\n          \"boolean\",\n          \"array\",\n          \"object\",\n          \"null\"\n        ]\n      },\n      \"description\": \"Optional machine-readable outputs emitted by the derivation.\",\n      \"type\": \"object\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"schema_name\": {\n      \"const\": \"scientific-evidence.artifact-manifest\"\n    }\n  },\n  \"required\": [\n    \"schema_name\",\n    \"artifact\",\n    \"derived_from\"\n  ],\n  \"title\": \"Scientific Evidence Artifact Manifest\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
