ification.correct\": {\n  \"evaluation_scope\": \"sealed_final\",\n  \"id\": \"final.qualification.correct\",\n  \"manifest_path\": \"work/results/t06/claude/20261111_064241/final_evaluation/final_manifest.json\",\n  \"program_tree_sha256\": \"sha256:b1d0f4bf356d7bdf8765a826400d379335e249148f16ee9f5e9b90af0efeb1bd\",\n  \"results_tree_sha256\": \"sha256:32828b3c0d9616822a9010bff4488ba25441ec886ee3e88d7153d19de691cf1d\",\n  \"type\": \"final_qualification\",\n  \"value\": true\n },\n \"final.qualification.outcome\": {\n  \"evaluation_scope\": \"sealed_final\",\n  \"id\": \"final.qualification.outcome\",\n  \"manifest_path\": \"work/results/t06/claude/20261111_064241/final_evaluation/final_manifest.json\",\n  \"program_tree_sha256\": \"sha256:b1d0f4bf356d7bdf8765a826400d379335e249148f16ee9f5e9b90af0efeb1bd\",\n  \"results_tree_sha256\": \"sha256:32828b3c0d9616822a9010bff4488ba25441ec886ee3e88d7153d19de691cf1d\",\n  \"type\": \"final_qualification\",\n  \"value\": \"qualified\"\n },\n \"final.qualification.status\": {\n  \"evalu\nderived:\nfinal_stats.json\nfinal_stats.json.prov.json\ntask_meta\n\nderived/task_meta:\nfinal_meta.json\nsearch_meta.json\n\nscripts:\nbuild_figures.py\nderive_final_stats.py\n\nsource_evidence:\ndownstream\n\nsource_evidence/downstream:\nbaseline\nprogram\n\nsource_evidence/downstream/baseline:\nprogram_spec.toml\nsrc\n\nsource_evidence/downstream/baseline/src:\nprogram.py\n\nsource_evidence/downstream/program:\nprogram_spec.toml\nsrc\n\nsource_evidence/downstream/program/src:\ndatasets_offline.py\nprogram.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
