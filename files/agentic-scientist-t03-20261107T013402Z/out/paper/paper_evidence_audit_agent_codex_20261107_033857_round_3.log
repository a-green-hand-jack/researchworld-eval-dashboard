{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"jq '{count:.final_evaluation.evaluation_evidence.episode_count,status:.final_evaluation.evaluation_evidence.status,episodes:(.final_evaluation.evaluation_evidence.episodes|map({keys:keys,seed,mode,solution_keys:(.solution|keys)}))}' paper_data.json; nl -ba source_evidence/evaluation/evaluate_final.py | sed -n '817,880p;1014,1058p;1140,1164p;1253,1278p;1305,1346p'\"","aggregated_output":"{\n  \"count\": 3,\n  \"status\": \"available\",\n  \"episodes\": [\n    {\n      \"keys\": [\n        \"correct\",\n        \"duration_seconds\",\n        \"score\",\n        \"seed\",\n        \"solution\"\n      ],\n      \"seed\": 104729,\n      \"mode\": null,\n      \"solution_keys\": [\n        \"cases\"\n      ]\n    },\n    {\n      \"keys\": [\n        \"correct\",\n        \"duration_seconds\",\n        \"score\",\n        \"seed\",\n        \"solution\"\n      ],\n      \"seed\": 130363,\n      \"mode\": null,\n      \"solution_keys\": [\n        \"cases\"\n      ]\n    },\n    {\n      \"keys\": [\n        \"correct\",\n        \"duration_seconds\",\n        \"score\",\n        \"seed\",\n        \"solution\"\n      ],\n      \"seed\": 155921,\n      \"mode\": null,\n      \"solution_keys\": [\n        \"cases\"\n      ]\n    }\n  ]\n}\n   817\tdef baseline_work(request):\n   818\t    science()\n   819\t    os.sched_setaffinity(0,sorted(os.sched_getaffinity(0))[:1])\n   820\t    resource.setrlimit(resource.RLIMIT_AS,(8*1024**3,8*1024**3))\n   821\t    resource.setrlimit(resource.RLIMIT_CPU,(cpu_limit_seconds(WALL_SECONDS,1),cpu_limit_seconds(WALL_SECONDS,1)+1))\n   822\t    smoke = request['smoke']\n   823\t    if request['case']=='controls':\n   824\t        return control_baseline(request)\n   825\t    settings = request['settings']\n   826\t    work = request['work_seconds']\n   827\t    dataset_name,kind = request['case'].split('_',1)\n   828\t    root = Path(request['root'])\n   829\t    def train():\n   830\t        dataset = load_data(root,dataset_name)\n   831\t        train_rows,labels,explanations,validation,targets = encode_dataset(dataset,smoke)\n   832\t        if len(np.unique(labels))!=2:\n   833\t            raise RuntimeError('training classes absent')\n   834\t        if kind=='logistic':\n   835\t            estimator = LogisticRegression(max_iter=500,random_state=request['seed'],solver='lbfgs',tol=1e-7)\n   836\t        else:\n   837\t            estimator = RandomForestClassifier(n_estimators=4 if smoke else 64,max_depth=6,random_state=request['seed'],n_jobs=1)\n   838\t        estimator.fit(train_rows,labels)\n   839\t        background = train_rows[:settings['background']]\n   840\t        queries = explanations[:settings['instances']]\n   841\t        model = serialize_model(estimator,kind,background)\n   842\t        probe = np.concatenate([queries,background])\n   843\t        if not np.allclose(predict(model,probe),estimator.predict_proba(probe)[:,1],rtol=1e-9,atol=1e-10):\n   844\t            raise RuntimeError('safe model serialization mismatch')\n   845\t        accuracy = float(np.mean(estimator.predict(validation)==targets))\n   846\t        diagnostics = {'validation_accuracy':accuracy,'fit_iterations':int(estimator.n_iter_[0]) if kind=='logistic' else 0,'fit_converged':bool(kind!='logistic' or estimator.n_iter_[0]<500)}\n   847\t        return model,queries,diagnostics\n   848\t    (model,queries,diagnostics),training_seconds = run_stage(train,work)\n   849\t    counters = {'reference':[0],'standard':[0],'multistart':[0]}\n   850\t    def references():\n   851\t        if model['dimension']<=10:\n   852\t            values = exact_reference(model,queries,counters['reference'])\n   853\t            return values,np.zeros_like(values)\n   854\t        budget = 64 if smoke else 4096\n   855\t        first = library_kernel(model,queries,budget,request['seed']+100000,counters['reference'])\n   856\t        second = library_kernel(model,queries,budget,request['seed']+200000,counters['reference'])\n   857\t        return (first+second)/2,abs(first-second)/2\n   858\t    (references,uncertainty),reference_seconds = run_stage(references,work)\n   859\t    def standard():\n   860\t        return [library_kernel(model,queries,budget,request['seed']+300000+index,counters['standard']).tolist() for index,budget in enumerate(settings['budgets'])]\n   861\t    standard_values,standard_seconds = run_stage(standard,work)\n   862\t    def multistart():\n   863\t        outputs = []\n   864\t        for index,budget in enumerate(settings['budgets']):\n   865\t            first = library_kernel(model,queries,max(1,budget//2),request['seed']+400000+2*index,counters['multistart'])\n   866\t            second = library_kernel(model,queries,max(1,budget//2),request['seed']+400001+2*index,counters['multistart'])\n   867\t            outputs.append(((first+second)/2).tolist())\n   868\t        return outputs\n   869\t    multistart_values,multistart_seconds = run_stage(multistart,work)\n   870\t    return {'model':model,'queries':queries.tolist(),'reference':references.tolist(),'reference_uncertainty':uncertainty.tolist(),'standard':standard_values,'multistart':multistart_values,'diagnostics':diagnostics,\n   871\t            'productive_seconds':{'training':training_seconds,'reference':reference_seconds,'standard':standard_seconds,'multistart':multistart_seconds},'prediction_rows':{key:value[0] for key,value in counters.items()}}\n   872\t\n   873\t\n   874\tclass BaselineWorker:\n   875\t    def __init__(self,request,deadline):\n   876\t        self.deadline = deadline\n   877\t        environment = {name:os.environ[name] for name in ('PATH','LD_LIBRARY_PATH','LANG','LC_ALL','TZ') if name in os.environ}\n   878\t        environment.update(HOME='/nonexistent',PYTHONNOUSERSITE='1',PYTHONDONTWRITEBYTECODE='1',PYTHONUNBUFFERED='1',WORKER_REPAIR_MODE='1' if repair_mode() else '0')\n   879\t        for name in ('OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS'):\n   880\t            environment[name] = '1'\n  1014\t\n  1015\t\n  1016\tdef agreement(values,reference,delta):\n  1017\t    values = np.asarray(values,dtype=float)\n  1018\t    reference = np.asarray(reference,dtype=float)\n  1019\t    error = np.abs(values-reference).sum(axis=-1)\n  1020\t    scale = np.maximum(np.abs(reference).sum(axis=-1),.001)\n  1021\t    fidelity = 1/(1+error/scale)\n  1022\t    def top3(row):\n  1023\t        return set(sorted(range(len(row)),key=lambda index:(-abs(row[index]),index))[:min(3,len(row))])\n  1024\t    overlap = np.array([len(top3(row)&top3(target))/min(3,len(row)) for row,target in zip(values,reference)])\n  1025\t    sign = lambda array: np.where(abs(array)<=1e-8,0,np.sign(array))\n  1026\t    signed = (sign(values)==sign(reference)).mean(axis=-1)\n  1027\t    efficiency = np.minimum(1,abs(values.sum(axis=-1)-delta)/np.maximum(abs(delta),.001))\n  1028\t    return np.column_stack([fidelity,overlap,signed,efficiency])\n  1029\t\n  1030\t\n  1031\tdef initial_outcome(episode,settings):\n  1032\t    cells = [[[None for instance in range(settings['instances'])] for repeat in range(settings['repetitions'])] for budget in settings['budgets']]\n  1033\t    repeat_pairs = [[[None for instance in range(settings['instances'])] for pair in range(math.comb(settings['repetitions'],2))] for budget in settings['budgets']]\n  1034\t    return {'case':episode['case'],'seed':episode['seed'],'replay':episode['replay'],'cells':cells,'repeat_pairs':repeat_pairs,'controls':[0.,0.,0.,0.],\n  1035\t            'completed_controls':[],'valid':False,'operational':False,'duration':0.,'solution':None}\n  1036\t\n  1037\t\n  1038\tdef empirical_summary(outcome,settings):\n  1039\t    metrics = np.zeros((len(settings['budgets']),settings['repetitions'],settings['instances'],4))\n  1040\t    metrics[:,:,:,3] = 1\n  1041\t    for budget_index,repetitions in enumerate(outcome['cells']):\n  1042\t        for repeat_index,instances in enumerate(repetitions):\n  1043\t            for instance_index,value in enumerate(instances):\n  1044\t                if value is not None:\n  1045\t                    metrics[budget_index,repeat_index,instance_index] = value\n  1046\t    pair_metrics = np.zeros((len(settings['budgets']),math.comb(settings['repetitions'],2),settings['instances'],2))\n  1047\t    for budget_index,pairs in enumerate(outcome['repeat_pairs']):\n  1048\t        for pair_index,instances in enumerate(pairs):\n  1049\t            for instance_index,value in enumerate(instances):\n  1050\t                if value is not None:\n  1051\t                    pair_metrics[budget_index,pair_index,instance_index] = value\n  1052\t    summary = metrics.mean(axis=(0,1,2))\n  1053\t    summary[1:3] = .5*summary[1:3]+.5*pair_metrics.mean(axis=(0,1,2))\n  1054\t    return summary\n  1055\t\n  1056\t\n  1057\tdef check_interrupted_agreement():\n  1058\t    for repetitions in (2,4,6):\n  1140\t            upload_model(candidate_call,model,'model0')\n  1141\t            attributions = []\n  1142\t            for budget_index,budget in enumerate(settings['budgets']):\n  1143\t                repetitions = []\n  1144\t                for repeat_index in range(settings['repetitions']):\n  1145\t                    values = explain(candidate_call,queries,budget,model['dimension'])\n  1146\t                    repetitions.append(values)\n  1147\t                    measurements = agreement(values,reference,delta)\n  1148\t                    for instance_index,value in enumerate(measurements):\n  1149\t                        outcome['cells'][budget_index][repeat_index][instance_index] = value.tolist()\n  1150\t                    for previous in range(repeat_index):\n  1151\t                        pair_index = repeat_index*(repeat_index-1)//2+previous\n  1152\t                        outcome['repeat_pairs'][budget_index][pair_index] = agreement(values,repetitions[previous],delta)[:,1:3].tolist()\n  1153\t                attributions.append(repetitions)\n  1154\t            baseline_metrics = {name:[agreement(values,reference,delta).mean(axis=0).tolist() for values in baseline[name]] for name in ('standard','multistart')}\n  1155\t            instance_values = np.array(outcome['cells'])[:,:,:,0].mean(axis=(0,1))\n  1156\t            generator = np.random.default_rng(84017)\n  1157\t            bootstraps = instance_values[generator.integers(len(instance_values),size=(1000,len(instance_values)))].mean(axis=1)\n  1158\t            outcome['solution'] = {'attributions':attributions,'reference':baseline['reference'],'reference_uncertainty':baseline['reference_uncertainty'],'standard':baseline['standard'],'multistart':baseline['multistart'],'baseline_metrics':baseline_metrics,\n  1159\t                                   'fidelity_instance_bootstrap_ci95':np.quantile(bootstraps,[.025,.975]).tolist(),'model_diagnostics':baseline['diagnostics'],'productive_seconds':baseline['productive_seconds'],'prediction_rows':baseline['prediction_rows']}\n  1160\t            outcome['valid'] = True\n  1161\t            outcome['operational'] = True\n  1162\t        if time.monotonic()>candidate_deadline:\n  1163\t            raise TimeoutError('candidate method allowance exhausted')\n  1164\t        return outcome\n  1253\t\n  1254\t\n  1255\tdef aggregate(outcomes,settings,complete,elapsed):\n  1256\t    primary = [outcome for outcome in outcomes if not outcome['replay']]\n  1257\t    empirical = [outcome for outcome in primary if outcome['case']!='controls']\n  1258\t    controls = [outcome for outcome in primary if outcome['case']=='controls']\n  1259\t    empirical_metrics = np.mean([empirical_summary(outcome,settings) for outcome in empirical],axis=0)\n  1260\t    control_pass = float(np.mean([outcome['controls'] for outcome in controls]))\n  1261\t    first = outcomes[0]\n  1262\t    replay = outcomes[-1]\n  1263\t    replay_error = 1.\n  1264\t    if first['valid'] and replay['valid'] and first['solution'] is not None and replay['solution'] is not None:\n  1265\t        replay_error = float(min(1,np.max(abs(np.asarray(first['solution']['attributions'])-np.asarray(replay['solution']['attributions'])))))\n  1266\t    metrics = dict(zip(('reference_fidelity','top3_overlap','signed_agreement','efficiency_error'),map(float,empirical_metrics)))\n  1267\t    metrics.update(control_pass_rate=control_pass,failed_fraction=float(sum(not outcome['valid'] for outcome in primary)/len(primary)),replay_error=replay_error,wall_seconds=float(elapsed))\n  1268\t    if PLANE=='search':\n  1269\t        metrics['combined_score'] = .8*metrics['reference_fidelity']+.2*control_pass\n  1270\t    if not complete or not all(outcome['operational'] for outcome in outcomes):\n  1271\t        metrics['wall_seconds'] = float(WALL_SECONDS)\n  1272\t    correct = bool(complete and all(outcome['valid'] for outcome in outcomes) and control_pass==1 and replay_error<=1e-10)\n  1273\t    return metrics,correct\n  1274\t\n  1275\t\n  1276\tdef evidence_records(outcomes,settings):\n  1277\t    records = []\n  1278\t    for seed in dict.fromkeys(outcome['seed'] for outcome in outcomes):\n  1305\t        encoded = compact({'schema_version':1,'episodes':evidence})\n  1306\t        if len(encoded)>16*1024*1024:\n  1307\t            raise RuntimeError('evidence size bound')\n  1308\t        (directory/'evaluation_evidence.json').write_bytes(encoded+b'\\n')\n  1309\t\n  1310\t\n  1311\tdef main():\n  1312\t    parser = argparse.ArgumentParser()\n  1313\t    parser.add_argument('--program_path',required=True,type=Path)\n  1314\t    parser.add_argument('--results_dir',required=True,type=Path)\n  1315\t    arguments = parser.parse_args()\n  1316\t    smoke = os.environ.get('AGENTIC_TASK_DRAFT_SMOKE')=='1'\n  1317\t    settings = {'instances':2 if smoke else 8 if PLANE=='search' else 16,'background':4 if smoke else 16,\n  1318\t                'repetitions':2 if smoke else 4 if PLANE=='search' else 6,'budgets':[16] if smoke else [64,256] if PLANE=='search' else [64,256,1024]}\n  1319\t    seeds = SEEDS[:1] if smoke else SEEDS\n  1320\t    plane_wall = 120 if smoke else WALL_SECONDS\n  1321\t    startup_allowance = 5 if smoke else 300 if PLANE=='search' else 600\n  1322\t    hard_deadline = START_TIME+plane_wall-startup_allowance\n  1323\t    finish_reserve = 5 if smoke else 90\n  1324\t    work_seconds = 2.5 if smoke else 50 if PLANE=='search' else 110\n  1325\t    episodes = make_episodes(seeds,settings)\n  1326\t    outcomes = [episode['outcome'] for episode in episodes]\n  1327\t    client = None\n  1328\t    try:\n  1329\t        preflight()\n  1330\t        root = Path(os.environ.get('TASK_SOURCE_DIR',str(Path(__file__).resolve().parent)))/'resources'/PLANE\n  1331\t        verify_resources(root)\n  1332\t        science()\n  1333\t        check_interrupted_agreement()\n  1334\t        client = CandidateClient(arguments.program_path)\n  1335\t        outcomes,complete = run_declared_episodes(episodes,hard_deadline=hard_deadline,finish_reserve=finish_reserve,reset_timeout=5,episode_overhead=6,\n  1336\t                    rpc_cap=work_seconds,clock=time.monotonic,rpc=client.rpc,\n  1337\t                    evaluate=lambda episode,call,deadline:evaluate_episode(episode,call,deadline,settings=settings,root=root,work_seconds=work_seconds,smoke=smoke),\n  1338\t                    worst_case=lambda episode:episode['outcome'],record_failure=record_failure)\n  1339\t        client.close()\n  1340\t        client = None\n  1341\t        elapsed = time.monotonic()-START_TIME\n  1342\t        metrics,correct = aggregate(outcomes,settings,complete,elapsed)\n  1343\t        feasible = not smoke and complete and all(outcome['operational'] for outcome in outcomes) and metrics['replay_error']<=1e-10 and elapsed<=WALL_SECONDS-startup_allowance\n  1344\t        write_results(arguments.results_dir,metrics,correct,feasible,evidence_records(outcomes,settings))\n  1345\t    except Exception as error:\n  1346\t        if client is not None:\n","exit_code":0,"status":"completed"}}
