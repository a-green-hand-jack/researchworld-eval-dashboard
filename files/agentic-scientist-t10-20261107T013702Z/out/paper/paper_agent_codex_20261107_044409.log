e\\\": \\\"scientific-evidence.artifact-manifest\\\",\n+            \\\"artifact\\\": {\\\"path\\\": relative, \\\"kind\\\": \\\"source\\\", \\\"sha256\\\": sha},\n+            \\\"derived_from\\\": [\\\"@evidence[[\\\" + original_path + \\\"]]\\\"],\n+            \\\"notes\\\": \\\"Inspectable archived source; byte identity to the sealed final executable has not been independently established.\\\"}, indent=2) + \\\"\\\\n\\\")\n+    (ROOT / \\\"source_evidence/manifest.json\\\").write_text(json.dumps({\\\"sources\\\": source_entries,\n+        \\\"final_source_identity\\\": \\\"unverified\\\", \\\"final_tree_hash\\\": paper_data[\\\"final_evaluation\\\"][\\\"program_tree_sha256\\\"]}, indent=2) + \\\"\\\\n\\\")\n+    print(\\\"Wrote\\\", len(claims), \\\"grounded claims and\\\", len(source_entries), \\\"source-file records.\\\")\n+\n+\n+if __name__ == \\\"__main__\\\":\n+    main()\n*** End Patch\nPATCH\npython scripts/map_claims.py\npython .codex/skills/validate-paper/scripts/validate_tex_refs.py --tex paper.tex --bib references.bib\npython .codex/skills/write-paper-standalone/scripts/validate_claims.py --paper-data paper_data.json --references references_provenance.json --bib references.bib --claims claims_grounding.json --paper-dir .\"","aggregated_output":"Supplementary Information validation failed: Supplementary Information must not import unchecked TeX files\nClaims validation failed: scientific-evidence verifier found 5 dangling `@evidence[[...]]` link(s). scripts/map_claims.py @evidence[[\" + original_path + \"]] -> Target did not resolve to a file path, URI, or known ledger id. source_evidence/calibration/METHOD.md.prov.json @evidence[[results/ideas/02_honest_nonlinear_score_controls_with_a_finite_sample_safety_track/program_1/src/METHOD.md]] -> Target did not resolve to a file path, URI, or known ledger id. source_evidence/calibration/program.py.prov.json @evidence[[results/ideas/02_honest_nonlinear_score_controls_with_a_finite_sample_safety_track/program