      \"citation_keys\": []\n    },\n    {\n      \"claim\": \"The row-permutation control returns 62, identical to the Arena drop top-1 size (score 0).\",\n      \"source_ids\": [\n        \"final.metric.permutation_control_score\",\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": []\n    },\n    {\n      \"claim\": \"All 15 real-case sizes are identical across seeds 101, 102 and 103; replay match 1.0; failed-episode fraction 0.0.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"final.metric.replay_match\",\n        \"final.metric.failed_episode_fraction\"\n      ],\n      \"citation_keys\": []\n    },\n    {\n      \"claim\": \"The sealed evaluation completed, qualified, and passed all validity gates.\",\n      \"source_ids\": [\n        \"final.qualification.status\",\n        \"final.qualification.outcome\",\n        \"final.qualification.correct\",\n        \"final.metric.final_correct\"\n      ],\n      \"citation_keys\": []\n    },\n    {\n      \"claim\": \"Drop-to-flip ratios for top-1 are 1.35, 2.0, 2.34, 1.75 and 2.0; flipping is always cheaper.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": []\n    },\n    {\n      \"claim\": \"For MT-Bench the GPT-4 leader needs more drops for top-1 (143 vs 92; 5.96% vs 2.74%) but fewer for top-3 (150 vs 229; 6.25% vs 6.83%).\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"final.metric.mtbench_gpt4_top1_drop_frac\",\n        \"final.metric.mtbench_human_top1_drop_frac\"\n      ],\n      \"citation_keys\": [\n        \"Zheng2023JudgingLW\"\n      ]\n    },\n    {\n      \"claim\": \"Fragility ordering of drop top-1 cases reverses between count (NBA 7, 16 before Arena 62) and fraction (Arena 0.0457% first).\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"final.metric.arena140k_top1_drop_frac\",\n        \"final.metric.nba_top1_drop_frac\",\n        \"final.metric.nba_top1_flip_frac\"\n      ],\n      \"citation_keys\": []\n    },\n    {\n      \"claim\": \"Recorded episode time per seed over all 17 cases was 15.99 s, 15.55 s and 16.33 s.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": []\n    },\n    {\n      \"claim\": \"The evaluated configuration is the baseline influence ordering; the three refined search configurations were all unscored (3 of 3), so their effect is unknown.\",\n      \"source_ids\": [\n        \"study.selection_kind\",\n        \"study.attempts.total\",\n        \"study.attempts.unscored\",\n        \"study.attempts.scored\",\n        \"study.investigation_outcome\",\n        \"study.search_score_delta\"\n      ],\n      \"citation_keys\": []\n    },\n    {\n      \"claim\": \"Exact search and lower-bound certificates for minimal drop sets are computationally demanding beyond a few dimensions even for least squares, so heuristic sets are upper bounds.\",\n      \"source_ids\": [\n        \"ref.s2.e0a2d58bae2e9586ef61541960c0cb9eab3cd213\",\n        \"ref.s2.b2434a9a214c4b1eea48961c1afb0ced8faefcc5\"\n      ],\n      \"citation_keys\": [\n        \"Freund2023TowardsPR\",\n        \"Moitra2022ProvablyAO\"\n      ]\n    },\n    {\n      \"claim\": \"Ranking recovery under BTL-type models with a fraction of adversarially corrupted comparisons is the setting the flip perturbation instantiates.\",\n      \"source_ids\": [\n        \"ref.s2.fcb8fca2cc4de6fe4345a751595b9831eeff2b65\"\n      ],\n      \"citation_keys\": [\n        \"Patil2020RankAF\"\n      ]\n    },\n    {\n      \"claim\": \"BT models are used for sports tournaments; we fit a static BT per NBA season.\",\n      \"source_ids\": [\n        \"ref.s2.692e25e72324616232affbadc403d9d7e4499faa\"\n      ],\n      \"citation_keys\": [\n        \"Cattelan2013DynamicBM\"\n      ]\n    }\n  ]\n}\"\"\"Build the quantitative figures of the paper from analysis/derived_stats.json.\n\nNo result number is hardcoded; all values come from derived_stats.json, which is itself\nderived from paper_data.json (sealed final evaluation).\nAlso writes a placeholder for the orchestrator-owned concept figure, but only if the\norchestrator has not already rendered it (guarded by .concept_figure_complete).\n\"\"\"\nimport json\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport numpy as np\n\nROOT = Path(__file__).resolve().parent.parent\nFIG = ROOT / \"figures\"\nFIG.mkdir(exist_ok=True)\n# @evidence[[analysis/derived_stats.json#cases]]\nstats = json.loads((ROOT / \"analysis\" / \"derived_stats.json\").read_text(encoding=\"utf-8\"))\n\nplt.rcParams.update({\"font.family\": \"serif\", \"font.size\": 9, \"axes.titlesize\": 9.5,\n                     \"axes.labelsize\": 9, \"xtick.labelsize\": 8.5, \"ytick.labelsize\": 8.5,\n                     \"legend.fontsize\": 8.5, \"axes.spines.top\": False, \"axes.spines.right\": False,\n                     \"pdf.fonttype\": 42})\nINK, MUTED, GRID = \"#0b0b0b\", \"#52514e\", \"#e4e3df\"\nTARGET_COLORS = {\"drop_top1\": \"#2a78d6\", \"flip_top1\": \"#eb6834\", \"drop_topk\": \"#1baf7a\"}\nTARGET_LABELS = {\"drop_top1\": \"drop, top-1\", \"flip_top1\": \"flip, top-1\", \"drop_topk\": \"drop, top-$k$ set\"}\nSOURCES = [\"arena140k\", \"mtbench_human\", \"mtbench_gpt4\", \"nba2014\", \"nba2015\"]\nSRC_LABEL = {\"arena140k\": \"Arena\\ncrowd\", \"mtbench_human\": \"MTB\\nexpert\",\n             \"mtbench_gpt4\": \"MTB\\nGPT-4\", \"nba2014\": \"NBA\\n2014\", \"nba2015\": \"NBA\\n2015\"}\nSRC_SHORT = {\"arena140k\": \"Arena crowd\", \"mtbench_human\": \"MTB expert\",\n             \"mtbench_gpt4\": \"MTB GPT-4\", \"nba2014\": \"NBA 2014\", \"nba2015\": \"NBA 2015\"}\n\n\ndef slot(case):\n    return \"drop_topk\" if case[\"perturbation\"] == \"drop\" and case[\"target\"] != \"top1\" else \\\n        f\"{case['perturbation']}_top1\"\n\n\ncases = {(c[\"source\"], slot(c)): c for c in stats[\"cases\"]}\n\n\n# Sidecar token built from parts so this source file carries no unresolved template ref.\nEVIDENCE_TOKEN = \"@\" + \"evidence[[{}]]\"\n\n\ndef save(fig, name, sources):\n    fig.savefig(FIG / f\"{name}.pdf\", bbox_inches=\"tight\")\n    fig.savefig(FIG / f\"{name}.png\", dpi=300, bbox_inches=\"tight\")\n    for ext in (\"pdf\", \"png\"):\n        (FIG / f\"{name}.{ext}.prov.json\").write_text(json.dumps({\n            \"schema_name\": \"scientific-evidence.artifact-manifest\",\n            \"artifact\": {\"path\": f\"figures/{name}.{ext}\", \"kind\": \"figure\"},\n            \"derived_from\": [EVIDENCE_TOKEN.format(s) for s in sources + [\"analysis/build_figures.py\"]]}, indent=2), encoding=\"utf-8\")\n    plt.close(fig)\n\n\n# ---------------------------------------------------------------- Figure: two scales\nfig, axes = plt.subplots(1, 2, figsize=(6.4, 2.8))\nx = np.arange(len(SOURCES))\nw = 0.26\nfor panel, (ax, key, ylabel) in enumerate(zip(\n        axes, (\"k\", \"frac_pct\"),\n        (\"verified size $k$ (comparisons)\", \"verified size $k/n$ (% of comparisons)\"))):\n    for j, tg in enumerate((\"drop_top1\", \"flip_top1\", \"drop_topk\")):\n        vals = [cases[(s, tg)][key] for s in SOURCES]\n        xs = x + (j - 1) * w\n        ax.bar(xs, vals, width=w - 0.03, color=TARGET_COLORS[tg], label=TARGET_LABELS[tg],\n               edgecolor=\"white\", linewidth=0.6, zorder=3)\n        if key == \"k\":\n            for xi, v in zip(xs, vals):\n                ax.text(xi, v * 1.12, f\"{v:d}\", ha=\"center\", va=\"bottom\", fontsize=7.6, color=MUTED)\n    ax.set_yscale(\"log\")\n    ax.set_xticks(x)\n    ax.set_xticklabels([SRC_LABEL[s] for s in SOURCES], fontsize=8)\n    ax.set_ylabel(ylabel)\n    ax.grid(axis=\"y\", color=GRID, linewidth=0.6, zorder=0)\n    ax.tick_params(axis=\"x\", length=0)\n    ax.set_title(\"(a) absolute count\" if panel == 0 else \"(b) fraction of the data\", loc=\"left\")\nsource_evidence/downstream/baseline/program_s