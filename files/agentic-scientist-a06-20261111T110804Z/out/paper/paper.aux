\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Sealed final evaluation, primary cases P1--P6 (0.4 synthetic / 0.6 real), mean $\pm $ standard deviation over eight seeds. The interval score is at level 0.90 (lower is better); coverage should be near 0.90. Bonferroni-Wilson shares the naive point estimate. Baseline coverage, width and the resampling bias are replay-derived from the evaluator's code, not evaluator-recorded (Section~\ref {sec:protocol}).}}{5}{table.1}\protected@file@percent }
\newlabel{tab:aggregate}{{1}{5}{Sealed final evaluation, primary cases P1--P6 (0.4 synthetic / 0.6 real), mean $\pm $ standard deviation over eight seeds. The interval score is at level 0.90 (lower is better); coverage should be near 0.90. Bonferroni-Wilson shares the naive point estimate. Baseline coverage, width and the resampling bias are replay-derived from the evaluator's code, not evaluator-recorded (Section~\ref {sec:protocol})}{table.1}{}}
