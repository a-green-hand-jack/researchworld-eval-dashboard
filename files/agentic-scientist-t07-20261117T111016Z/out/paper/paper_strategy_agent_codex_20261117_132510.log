n    },\n    {\n      \"key\": \"final.qualification.status\",\n      \"value\": {\n        \"evaluation_scope\": \"sealed_final\",\n        \"id\": \"final.qualification.status\",\n        \"manifest_path\": \"work/results/t07/codex/20261117_111440/final_evaluation/final_manifest.json\",\n        \"program_tree_sha256\": \"sha256:05534c4a911701610bf083186d50202f8c1ef63ff138de657f0e7591893de339\",\n        \"results_tree_sha256\": \"sha256:60986f6a9f1411efe6d79cdb7ee31153d701f4d2b4222ef0ee7423b54bb42757\",\n        \"type\": \"final_qualification\",\n        \"value\": \"completed\"\n      }\n    }\n  ],\n  \"source_examples\": {\n    \"episodes\": {\n      \"candidate_diagnostics_trust\": \"unverified\",\n      \"episode_count\": 3,\n      \"evaluation_scope\": \"sealed_final\",\n      \"id\": \"final.evidence.episodes\",\n      \"json_pointer\": \"/episodes\",\n      \"manifest_path\": \"work/results/t07/codex/20261117_111440/final_evaluation/final_manifest.json\",\n      \"path\": \"work/results/t07/codex/20261117_111440/final_evaluation/results/evaluation_evidence.json\",\n      \"program_tree_sha256\": \"sha256:05534c4a911701610bf083186d50202f8c1ef63ff138de657f0e7591893de339\",\n      \"results_tree_sha256\": \"sha256:60986f6a9f1411efe6d79cdb7ee31153d701f4d2b4222ef0ee7423b54bb42757\",\n      \"sha256\": \"sha256:246dd20697c224c6cc2eceeee442f5edb678f469a70f7402f4c1cd00c3b2a473\",\n      \"type\": \"evaluation_evidence\"\n    },\n    \"mae\": {\n      \"evaluation_scope\": \"sealed_final\",\n      \"id\": \"final.metric.mae\",\n      \"manifest_path\": \"work/results/t07/codex/20261117_111440/final_evaluation/final_manifest.json\",\n      \"results_tree_sha256\": \"sha256:60986f6a9f1411efe6d79cdb7ee31153d701f4d2b4222ef0ee7423b54bb42757\",\n      \"type\": \"metric\",\n      \"value\": 0.038991605535293065\n    },\n    \"top\": {\n      \"attempt_id\": \"cycle_03_log_odds_shift_residual_decoder_attempt_01\",\n      \"id\": \"result.top_program_01\",\n      \"idea_id\": \"cycle_03_log_odds_shift_residual_decoder\",\n      \"program_dir\": \"work/results/t07/codex/20261117_111440/investigation/ideas/03_log_odds_shift_residual_decoder/program_1\",\n      \"program_id\": \"program_1\",\n      \"type\": \"metric\",\n      \"value\": 0.9453539826294075\n    }\n  },\n  \"evidence_sources\": {\n    \"ablations\": {\n      \"path\": \"work/results/t07/codex/20261117_111440/ablations\",\n      \"status\": \"missing\"\n    },\n    \"investigation\": {\n      \"path\": \"work/results/t07/codex/20261117_111440/investigation\",\n      \"status\": \"included\"\n    }\n  }\n}\ntotal 8\ndrwx------ 2 agent agent 4096 Nov 17 13:25 .\ndrwx------ 5 agent agent 4096 Nov 17 13:34 ..\n_idea_generation\nattempts_history.jsonl\nbest_program_manifest.json\nconclusions.md\nconclusions_history.jsonl\nconclusions_other_workers.md\nevents.jsonl\nidea_generation_failures.jsonl\nideas\nideas_history.jsonl\nlatest_run_manifest.json\nmemory.jsonl\nmemory.md\nouter_state.json\ntask\ncapture.py\nevaluate.py\nevaluate_final.py\nprogram_0\nrequirements.txt\nresources\ntask.md\ntask_contract.json\n---\nname: write-paper-standalone\ndescription: Write a grounded LaTeX paper as one coherent standalone scientific study centered on a single defensible thesis rather than the run chronology.\n---\n\n# What the skill is about\nGenerate `paper.tex` and `claims_grounding.json` from grounded artifacts only, with a clean standalone-paper narrative.\n\n# When to use the skill\n- Final paper step when the default paper-writing skill keeps drifting into a search diary.\n- Need a standalone scientific paper built around one central method, hypothesis, or comparison story.\n- Need to hide run order and expose only the subset of baselines and ablations that support a coherent grounded manuscript.\n\n# What to do\n1. Read:\n- `results_readme.md` — campaign-level overview of all tasks, variants, and where to find results. Use this to understand the full scope of the campaign beyond the primary task passed via `--task-dir`.\n- `paper_data.json`\n- `references.bib`\n- `references_provenance.json`\n- `contributions.md` (if provided) — optional base for framing the claimed contributions; not a grounding source\n- `global_memory_summary.md` (if provided)\n- Aggregated CSVs in `/` for fine-grained analysis (install and use pandas) — when available\n- generated figures in `figures/`\n- when `paper_data.json.paper_profile == \"standalone\"`, also follow `presentation_contract` as a visible-language contract\n2. Use `templates/iclr/paper.tex` to keep section order stable. The paper format is **iclr**.\nInspect the selected template and any venue guidance before drafting so the author block, section structure, and framing expectations match the chosen format.\n3. Before drafting, choose one central thesis that is strongly supported by grounded evidence. Do not choose the paper story by recency alone.\n4. Group related implementations into a small number of named method families. Keep only the baseline, proposed method, and ablations needed to support the central thesis.\n5. If the artifacts do not support one coherent paper story, fail clearly instead of narrating the full search process.\n6. Write required sections:\n- abstract\n- introduction\n- related work\n- method\n- results\n- conclusion\n- references\nThe Supplementary Information section is mandatory.\nEmbed it in the same `paper.tex`, after the references, in this order: `\\clearpage`, bibliography, `\\clearpage`, `\\appendix`, and `\\section{Supplementary Information}`.\nReplace the template scaffold with substantive grounded content, including at least one meaningful subsection, table, or figure supported by the available artifacts. Suitable material includes extended methods, reproducibility details, additional ablations, robustness or failure analyses, and extra grounded tables or figures. Never move evidence essential to the central claim out of the main paper.\nRoute `appendix`-ranked posthoc analyses to Supplementary Information by default. Do not promote or drop them merely because of the main-body page budget.\n7. Generate comparative figures with Python + matplotlib by constructing analysis code yourself during the run:\n- inline `python - <<'PY' ... PY`, or\n- ad-hoc scripts in the paper workspace (for reproducibility).\n8. Prefer comparison figures over chronology figures. Use progression-style plots only when they directly support the main scientific claim.\n9. When multiple benchmarks, datasets, or settings are included, organize the visible paper around a shared hypothesis and condition-specific adaptations or limits, not around campaign chronology.\n10. If `paper_strategy.json` includes `figure_specs`, implement those figures first and keep every generated figure within the declared readability budgets.\n11. Use a logically consistent color scheme across all figures in the paper. Reuse the same colors for the same methods, baselines, conditions, or semantic roles whenever they recur, and avoid remapping meanings between figures without a clear reason.\n12. When a `figure_specs[*]` entry sets `preferred_generator` to `generate-concept-figure`, your job is to wire it in, not to render it. Do not invoke `autoillustrate` or the `generate-concept-figure` pipeline. Reference `./figures/<figure_id>.png` in the manuscript, create a lightweight placeholder PNG and `{}` prompt-log stub so the draft compiles, and register `generator: generate-concept-figure` plus `prompt_log_path: figures/<figure_id>.prompts.json` in `figure_manifest.json`. The orchestrator replaces those placeholders synchronously after the draft stage. Any reusable placeholder script must skip generation when `.concept_figure_complete` exists so repair rounds cannot overwrite the rendered asset.\n13. Do not satisfy a required overview-style `diagram` figure with a hand-built matplotlib/TikZ schematic unless the concept-figure workflow failed or was impossible; if that fallback happens, record the reason in `./memory.md`, `./global_memory/memory.md`, and the matching `figure_manifest.json` entry.\n14. Write `figure_manifest.json` for every figure referenced in `paper.tex`. Use `../validate-paper/templates/figure_manifest.schema.json` as the canonical contract. Legacy flat rows and richer nested rows are both acceptable if they validate against that schema.\n15. Record generator provenance in `figure_manifest.json` when possible: `generator`, `prompt_log_path`, and `fallback_reason` when a preferred generator was skipped.\nWhen evidence-audit feedback requires changing an orchestrator-owned concept figure, turn the correction into a complete documented fallback: export both `./figures/<figure_id>.png` and `./figures/<figure_id>.pdf`, set `generator` to the actual fallback generator (`matplotlib`, `tikz`, `native_latex`, or `manual`), set `attempted_generator: generate-concept-figure`, retain the original `prompt_log_path`, and set a non-empty `fallback_reason` describing why the orchestrator render was replaced. Use exactly those canonical artifact paths, and do not create or modify `./figures/<figure_id>.png.prov.json`; the orchestrator issues request-bound provenance after accepting the repair. Do not patch only the PNG while leaving `generator: generate-concept-figure`; that falsely claims ownership and allows figure preparation to restore the old render. Do not alter `paper_strategy.json` solely to bypass concept-figure orchestration, and do not create, delete, or modify `.concept_figure_complete`; the orchestrator owns that marker.\n16. Before choosing figure widths, inspect the selected paper template or style files to understand the practical column width, full-width span, and text footprint for the current paper format.\n17. Record final-layout hints in `figure_manifest.json` when possible: `placement`, `intended_latex_width_fraction`, and `estimated_min_rendered_font_pt`.\n18. Keep figures readable by default: max 4 total panels, max 3 panels per row, max 6 categories per panel, max 4 series per panel, readable fonts, and abbreviated labels instead of tiny text unless the strategy explicitly allows a denser layout.\n19. Choose each LaTeX figure width from the actual generated figure dimensions, aspect ratio, the inspected template geometry, and intended paper footprint. If a figure becomes unreadable at column width, regenerate/simplify it or place it full-width instead of shrinking the same dense figure further.\n20. If `validation_feedback.json` or `validation_feedback.md` is present, treat it as a repair pass: fix every listed hard error first, rerun validation, and keep iterating until the hard errors are gone or the grounded inputs are insufficient.\n21. Do not create visible section or subsection titles centered on `milestones`, `progression`, `timeline`, `phase`, `stage`, `round`, `Experiment A`, `Experiment B`, `first success`, or similar chronology-shaped labels unless the central claim is explicitly about dynamics.\n22. Do not use phrases like `first valid result`, `subsequent improvements`, `next-best`, `later variants`, or `we then tried` in the visible paper unless that wording is strictly necessary inside a brief protocol description.\n23. Keep visible paper text free of internal pipeline terms such as `eligible`, `correct and eligible`, `correctness rate`, `worker_01`, `worker_02`, `combined_score`, or `rubric`.\n24. If you need a thresholded rate, name it with one reader-facing meaning per figure, such as target attainment rate, successful-run fraction, or non-collapse rate. Do not reuse one label for different task-specific thresholds.\n25. When `paper_data.json.ablation_studies` is non-empty, prefer its variant summaries, replicate statistics, and explicit comparisons over inferring ablations from `all_programs` alone.\n26. Use only numbers present in `paper_data.json`.\n27. Use only citation keys present in `references.bib`.\n28. Use `global_memory_summary.md` only as private qualitative framing; do not use it for quantitative claims or `source_ids`.\n29. If `paper_strategy.md` and `paper_strategy.json` are present, treat them as the framing contract for the final draft; fail clearly if they contradict grounded evidence.\n30. Keep visible paper text free of run-diary wording such as discovery order, iteration order, or agent-loop narration.\n31. Write claim mapping JSON:\n```json\n{\n  \"claims\": [\n    {\n      \"claim\": \"text\",\n      \"source_ids\": [\"result.best_correct_score\"],\n      \"citation_keys\": [\"SomeKey2024\"]\n    }\n  ]\n}\n```\n32. Run validator:\n```bash\npython scripts/validate_claims.py \\\n  --paper-data paper_data.json \\\n  --references references_provenance.json \\\n  --bib references.bib \\\n  --claims claims_grounding.json \\\n  --paper-dir .\n```\nThis validator also checks that `references.bib` and `references_provenance.json` stay in sync, and traces every `@evidence[[...]]` link under `--paper-dir` against the `scientific-evidence/` bundle via the `scientific-evidence` skill verifier. Every link must classify as `resolved` or `anchored`; any `dangling` link is a hard error you must fix before finalization. If paper text carries `@evidence[[...]]` tokens but the bundle is missing, generate it first with `bash ../scientific-evidence/scripts/scientific_evidence.sh emit-bundle --root-dir .`.\n33. During repair passes, also rerun the full `validate-paper` workflow after each fix round so the next round starts from fresh feedback, not stale assumptions.\n34. When venue guidance is present, make the title, abstract, introduction, and conclusion explicitly reader-facing for that venue's scientific questions whenever the grounded evidence supports that framing.\n35. If `./paper_authors.tex` exists, treat it as the canonical author source. Keep `\\input{paper_authors.tex}` inside `\\author{...}` when possible; otherwise copy the exact file contents without edits.\n36. Keep the template's watermark block (`% --- watermark (auto-inserted) ---` … `% --- end watermark ---`) in `paper.tex` unchanged; the orchestrator regenerates it before every host compile.\n\n# Outputs\n- `paper.tex`\n- `claims_grounding.json`\n- `figure_manifest.json` when figures are generated or required by strategy\n- Optional extra figures in `figures/` (grounded only, no cross-agent aggregate plots).\n{\n  \"campaign_results_dir\": \"work/results/t07/codex/20261117_111440/investigation\",\n  \"count\": 25,\n  \"generated_at\": \"2026-11-17T13:31:01.920987+00:00\",\n  \"queries\": [\n    \"c-optimal experimental design regularized regression linear functional prediction\",\n    \"Rasch model fixed item difficulty penalized ability estimation\",\n    \"model assisted survey sampling generalized difference estimator residual correction\",\n    \"\\\"Anchor Points: Benchmarking Models with Much Fewer Examples\\\"\",\n    \"\\\"tinyBenchmarks: evaluating LLMs with fewer examples\\\"\",\n    \"\\\"100 instances is all you need\\\" \\\"predicting the success of a new LLM\\\"\",\n    \"\\\"Active Evaluation Acquisition for Efficient LLM Benchmarking\\\"\",\n    \"\\\"MMLU-Pro: A More Robust and Challenging Multi-Task Language Understanding Benchmark\\\"\",\n    \"\\\"Holistic Evaluation of Language Models\\\"\",\n    \"\\\"Open LLM Leaderboard v2\\\" Fourrier Habib Lozovskaya Szafer Wolf\"\n  ],\n  \"reference_query_plan\": {\n    \"architectural_shifts\": [\n      \"Estimator architecture: frozen item-response reconstruction plus random-audit correction versus direct all-observation score ridge; acquisition also changes between these packages\",\n      \"Implemented optional extension from linear score decoding to a scalar log-odds curve plus prefix-matched residual ridge, with score-directed acquisition unchanged\",\n      \"No neural architecture transition or architecture-specific transfer result is established; groups are anonymous and nonlinear decoder activation is unverified\"\n    ],\n    \"benchmarks\": [\n      \"Development: arc_challenge, ifeval, commonsense, gsm\",\n      \"Final evaluation: bbh, gpqa, mmlu_pro, musr, openllm_math, legalbench, math, med_qa, mmlu\",\n      \"Open LLM Leaderboard and HELM binary matrices in benchmark-prediction snapshot 55faff496947789f94e6b5908c77cbc3e84f81ad\"\n    ],\n    \"central_topic\": \"Predicting full-benchmark binary accuracy and model rankings from a small shared item subset using historical source-model responses, score-directed acquisition, and source-trained score decoding.\",\n    \"comparators\": [\n      \"Uniform item subsampling and source-prior prediction\",\n      \"Response-vector clustering and weighted anchor estimates, as in Anchor Points\",\n      \"Item response theory and compact benchmark estimation, as in tinyBenchmarks\",\n      \"Supervised reference-instance prediction, as in 100 instances is all you need\",\n      \"Adaptive item acquisition, as in Active Evaluation Acquisition; conceptual rather than experimentally evaluated here\",\n      \"Model-assisted finite-population estimation and generalized difference estimators\"\n    ],\n    \"core_methods\": [\n      \"Source-weighted conditional full-score covariance acquisition with a fixed, nested, content-group-unique item path\",\n      \"All-query full-score ridge regression with an optional difficulty-centered offset blend\",\n      \"Optional prefix-only penalized log-odds shift, full-population score curve, and residual ridge decoder\",\n      \"Earlier frozen-surrogate pilot plus randomized audit residual correction, including unequal-content-group weighting\",\n      \"Source-lineage-held-out selection and decoder tuning with nested refitting for the nonlinear candidate\"\n    ],\n    \"forbidden_query_patterns\": [\n      \"Any attempt to identify, infer, search for, retrieve, or use the unspecified prohibited paper, its authors, title, results, mirrors, summaries, or associated materials\",\n      \"Forward-citation expansion, cited-by searches, related-paper feeds, surveys, reviews, discussions, or reproductions that may expose prohibited material; stop and log immediately if encountered\",\n      \"Unrestricted web searches restating the entire research question; use supplied exact-title/identifier targets and narrowly scoped foundational-method searches with pre-access screening instead\",\n      \"Generic optimization, benchmarking, scientific-method, paper-writing, campaign chronology, or internal score-optimization queries\",\n      \"Unsupported neural architecture transitions, named-family transfer, complete ancestry separation, or family-held-out robustness claims\",\n      \"Continuous-score evaluation, LLM-judge metrics, or adaptive stopping represented as experiments in this binary fixed-budget run\",\n      \"Unmeasured ablations, nonlinear-mechanism superiority, or design-unbiasedness of clipped/shrunken scores or rankings\",\n      \"Treating the live leaderboard, gated item details, or newest repository branch as the measured fixed binary snapshot\"\n    ],\n    \"queries\": [\n      {\n        \"category\": \"result_driven_theme\",\n        \"query\": \"c-optimal experimental design regularized regression linear functional prediction\",\n        \"rationale\": \"The strongest packages use squared conditional covariance with full score divided by regularized item variance and decode all responses with ridge. Seek foundational prediction-directed design theory, without asserting exact c-optimal equivalence or an isolated selector gain.\"\n      },\n      {\n        \"category\": \"architectural_shift\",\n        \"query\": \"Rasch model fixed item difficulty penalized ability estimation\",\n        \"rationale\": \"The optional decoder uses logits of source item means as fixed difficulty-like offsets, fits a penalized scalar shift from each queried prefix, and adds residual ridge. Rasch/logistic latent-trait work supplies conceptual positioning, not evidence of full IRT fitting or verified nonlinear activation.\"\n      },\n      {\n        \"category\": \"core_method\",\n        \"query\": \"model assisted survey sampling generalized difference estimator residual correction\",\n        \"rationale\": \"The earlier evaluated variant freezes pilot-only predictions and estimates residual totals through random audits with unequal-group correction. Generalized difference estimation grounds its conditional unshrunk, unclipped score-unbiasedness argument, not empirical superiority or unbiased rankings.\"\n      },\n      {\n        \"category\": \"baseline_comparator\",\n        \"query\": \"\\\"Anchor Points: Benchmarking Models with Much Fewer Examples\\\"\",\n        \"rationale\": \"Weighted clustering anchors are expected related work and a recorded baseline family. Resolve supplied arXiv:2309.08638 directly; do not assume the local baseline exactly reproduces the published method.\"\n      },\n      {\n        \"category\": \"baseline_comparator\",\n        \"query\": \"\\\"tinyBenchmarks: evaluating LLMs with fewer examples\\\"\",\n        \"rationale\": \"IRT is the strongest recorded final baseline, making compact IRT-based estimation essential context. Resolve supplied arXiv:2402.14992 and distinguish its full method from the local IRT implementation.\"\n      },\n      {\n        \"category\": \"baseline_comparator\",\n        \"query\": \"\\\"100 instances is all you need\\\" \\\"predicting the success of a new LLM\\\"\",\n        \"rationale\": \"The supplied arXiv:2409.03563 is the nearest supervised reference-instance prediction literature. Compare its target and protocol with direct score ridge and prefix-matched residual regression; no experimental reproduction is established.\"\n      },\n      {\n        \"category\": \"baseline_comparator\",\n        \"query\": \"\\\"Active Evaluation Acquisition for Efficient LLM Benchmarking\\\"\",\n        \"rationale\": \"Resolve supplied arXiv:2410.05952 to distinguish adaptive acquisition from the run's source-only fixed shared path. This is conceptual coverage: per-target adaptation is unsupported by the interface and was not evaluated.\"\n      },\n      {\n        \"category\": \"benchmark_context\",\n        \"query\": \"\\\"MMLU-Pro: A More Robust and Challenging Multi-Task Language Understanding Benchmark\\\"\",\n        \"rationale\": \"Resolve supplied arXiv:2406.01574 for a final benchmark and leaderboard component. The final set also contains mmlu, but no MMLU-to-MMLU-Pro transfer mechanism is established.\"\n      },\n      {\n        \"category\": \"benchmark_context\",\n        \"query\": \"\\\"Holistic Evaluation of Language Models\\\"\",\n        \"rationale\": \"Resolve supplied arXiv:2211.09110 for the HELM ecosystem behind commonsense/gsm development and legalbench/math/med_qa/mmlu final matrices. Cite the binary snapshot separately; this study does not reproduce HELM's full multi-metric protocol.\"\n      },\n      {\n%%%% ICLR Macros (LaTex)\n%%%% Adapted by Hugo Larochelle from the NIPS stylefile Macros\n%%%% Style File\n%%%% Dec 12, 1990   Rev Aug 14, 1991; Sept, 1995; April, 1997; April, 1999; October 2014\n\n% This file can be used with Latex2e whether running in main mode, or\n% 2.09 compatibility mode.\n%\n% If using main mode, you need to include the commands\n%             \\documentclass{article}\n%             \\usepackage{iclr14submit_e,times}\n%\n\n% Change the overall width of the page.  If these parameters are\n%       changed, they will require corresponding changes in the\n%       maketitle section.\n%\n\\usepackage{eso-pic} % used by \\AddToShipoutPicture\n\\RequirePackage{fancyhdr}\n\\RequirePackage{natbib}\n\n% modification to natbib citations\n\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n\n\\renewcommand{\\topfraction}{0.95}   % let figure take up nearly whole page\n\\renewcommand{\\textfraction}{0.05}  % let figure take up nearly whole page\n\n% Define iclrfinal, set to true if iclrfinalcopy is defined\n\\newif\\ificlrfinal\n\\iclrfinalfalse\n\\def\\iclrfinalcopy{\\iclrfinaltrue}\n\\font\\iclrtenhv  = phvb at 8pt\n\n% Specify the dimensions of each page\n\n\\setlength{\\paperheight}{11in}\n\\setlength{\\paperwidth}{8.5in}\n\n\n\\oddsidemargin .5in    %   Note \\oddsidemargin = \\evensidemargin\n\\evensidemargin .5in\n\\marginparwidth 0.07 true in\n%\\marginparwidth 0.75 true in\n%\\topmargin 0 true pt           % Nominal distance from top of page to top of\n%\\topmargin 0.125in\n\\topmargin -0.625in\n\\addtolength{\\headsep}{0.25in}\n\\textheight 9.0 true in       % Height of text (including footnotes & figures)\n\\textwidth 5.5 true in        % Width of text line.\n\\widowpenalty=10000\n\\clubpenalty=10000\n\n% \\thispagestyle{empty}        \\pagestyle{empty}\n\\flushbottom \\sloppy\n\n% We're never going to need a table of contents, so just flush it to\n% save space --- suggested by drstrip@sandia-2\n\\def\\addcontentsline#1#2#3{}\n\n% Title stuff, taken from deproc.\n\\def\\maketitle{\\par\n\\begingroup\n   \\def\\thefootnote{\\fnsymbol{footnote}}\n   \\def\\@makefnmark{\\hbox to 0pt{$^{\\@thefnmark}$\\hss}} % for perfect author\n                                                        % name centering\n%   The footnote-mark was overlapping the footnote-text,\n%   added the following to fix this problem               (MK)\n   \\long\\def\\@makefntext##1{\\parindent 1em\\noindent\n                            \\hbox to1.8em{\\hss $\\m@th ^{\\@thefnmark}$}##1}\n   \\@maketitle \\@thanks\n","exit_code":0,"status":"completed"}}
