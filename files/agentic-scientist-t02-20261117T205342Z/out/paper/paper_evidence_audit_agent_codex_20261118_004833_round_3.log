",\n    \"id\": \"final.qualification.outcome\",\n    \"manifest_path\": \"work/results/t02/codex/20261117_205843/final_evaluation/final_manifest.json\",\n    \"program_tree_sha256\": \"sha256:28c0407d4c255b8c094419443308bf86ec8da1057bc953ba16080d6ff6cd0da2\",\n    \"results_tree_sha256\": \"sha256:5accdfe6862bbd7ae5e2b40491fa88eda6c445c16c2893fefe058dd0ce0b33c2\",\n    \"type\": \"final_qualification\",\n    \"value\": \"qualified\"\n  },\n  \"final.qualification.status\": {\n    \"evaluation_scope\": \"sealed_final\",\n    \"id\": \"final.qualification.status\",\n    \"manifest_path\": \"work/results/t02/codex/20261117_205843/final_evaluation/final_manifest.json\",\n    \"program_tree_sha256\": \"sha256:28c0407d4c255b8c094419443308bf86ec8da1057bc953ba16080d6ff6cd0da2\",\n    \"results_tree_sha256\": \"sha256:5accdfe6862bbd7ae5e2b40491fa88eda6c445c16c2893fefe058dd0ce0b33c2\",\n    \"type\": \"final_qualification\",\n    \"value\": \"completed\"\n  }\n}\n","exit_code":0,"status":"completed"}}
