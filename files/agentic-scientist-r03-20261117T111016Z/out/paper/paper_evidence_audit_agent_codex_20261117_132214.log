{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json, math, statistics\nfrom pathlib import Path\npayload=json.loads(Path('paper_data.json').read_text())\nderived=json.loads(Path('derived_results.json').read_text())\nepisodes=payload['final_evaluation']['evaluation_evidence']['episodes']\nfor case in 'ABCD':\n    calculated=[]\n    for episode in episodes:\n        values=episode['solution']['cases'][case]\n        methods=values['baseline_mae_by_method_row_checkpoint']+[values['mae_by_row_checkpoint']]\n        calculated.append([[statistics.mean(column) for column in zip(*method)] for method in methods])\n    expected=derived['cases'][case]['seed_budget']\n    delta=max(abs(actual-reference) for seed,seed_expected in zip(calculated,expected) for method,method_expected in zip(seed,seed_expected) for actual,reference in zip(method,method_expected))\n    print('case',case,'max deviation from derived arrays',delta,'method means',[round(statistics.mean(statistics.mean(seed[method]) for seed in calculated),8) for method in range(6)])\n    diagnostic=statistics.mean(statistics.mean(sum(episode['solution']['cases'][case]['all_unqueried_mae_by_row_checkpoint'],[])) for episode in episodes)\n    print('changing targets',diagnostic,'derived',derived['changing_target_mae'][case])\nprint('relative reduction',100*(payload['final_evaluation']['metrics']['baseline_mae']-payload['final_evaluation']['metrics']['mae'])/payload['final_evaluation']['metrics']['baseline_mae'])\nplan=json.loads(Path('source_evidence/resources/final/plan.json').read_text())\nprint('plan',[(episode['case'],episode['seed'],len(episode['history']),len(episode['test']),episode['replay']) for episode in plan['episodes']])\nprint('bootstrap intervals',derived['baseline_gain_bounds'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
