{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"sed -n '1016,1031p' task/evaluate.py; sed -n '1138,1162p' task/evaluate.py; sed -n '160,260p' results/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1/src/reliability.py; cat task/requirements.txt; head -25 task/evaluate_final.py; sed -n '1,45p' results/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1/src/logistic_fourier.py\"","aggregated_output":"def agreement(values,reference,delta):\n    values = np.asarray(values,dtype=float)\n    reference = np.asarray(reference,dtype=float)\n    error = np.abs(values-reference).sum(axis=-1)\n    scale = np.maximum(np.abs(reference).sum(axis=-1),.001)\n    fidelity = 1/(1+error/scale)\n    def top3(row):\n        return set(sorted(range(len(row)),key=lambda index:(-abs(row[index]),index))[:min(3,len(row))])\n    overlap = np.array([len(top3(row)&top3(target))/min(3,len(row)) for row,target in zip(values,reference)])\n    sign = lambda array: np.where(abs(array)<=1e-8,0,np.sign(array))\n    signed = (sign(values)==sign(reference)).mean(axis=-1)\n    efficiency = np.minimum(1,abs(values.sum(axis=-1)-delta)/np.maximum(abs(delta),.001))\n    return np.column_stack([fidelity,overlap,signed,efficiency])\n\n\ndef initial_outcome(episode,settings):\n            reference = np.asarray(baseline['reference'])\n            delta = predict(model,queries)-predict(model,model['background']).mean()\n            upload_model(candidate_call,model,'model0')\n            attributions = []\n            for budget_index,budget in enumerate(settings['budgets']):\n                repetitions = []\n                for repeat_index in range(settings['repetitions']):\n                    values = explain(candidate_call,queries,budget,model['dimension'])\n                    repetitions.append(values)\n                    measurements = agreement(values,reference,delta)\n                    for instance_index,value in enumerate(measurements):\n                        outcome['cells'][budget_index][repeat_index][instance_index] = value.tolist()\n                    for previous in range(repeat_index):\n                        pair_index = repeat_index*(repeat_index-1)//2+previous\n                        outcome['repeat_pairs'][budget_index][pair_index] = agreement(values,repetitions[previous],delta)[:,1:3].tolist()\n                attributions.append(repetitions)\n            baseline_metrics = {name:[agreement(values,reference,delta).mean(axis=0).tolist() for values in baseline[name]] for name in ('standard','multistart')}\n            instance_values = np.array(outcome['cells'])[:,:,:,0].mean(axis=(0,1))\n            generator = np.random.default_rng(84017)\n            bootstraps = instance_values[generator.integers(len(instance_values),size=(1000,len(instance_values)))].mean(axis=1)\n            outcome['solution'] = {'attributions':attributions,'reference':baseline['reference'],'reference_uncertainty':baseline['reference_uncertainty'],'standard':baseline['standard'],'multistart':baseline['multistart'],'baseline_metrics':baseline_metrics,\n                                   'fidelity_instance_bootstrap_ci95':np.quantile(bootstraps,[.025,.975]).tolist(),'model_diagnostics':baseline['diagnostics'],'productive_seconds':baseline['productive_seconds'],'prediction_rows':baseline['prediction_rows']}\n            outcome['valid'] = True\n            outcome['operational'] = True\n        if time.monotonic()>candidate_deadline:\n    return estimate\n\n\ndef explain_fixed_game(model, query, budget, rng, predict):\n    \"\"\"Spend at most the requested nontrivial-coalition sampling budget.\n\n    Resolved logistic games use bounded deterministic quadrature. Otherwise\n    one quarter of a nonexhaustive budget is reserved for a fixed number of\n    independent paths when two paths fit. All sampled masks also enter the\n    probability-scale Kernel SHAP point estimate. Return the path mean only\n    when its signed top-k certificate passes; otherwise retain regression.\n    Certificate decisions and costs are internal, not extra RPC fields.\n    \"\"\"\n    if model['kind'] == 'forest':\n        return exact_forest_shapley(model, query)\n    game = FrozenProbabilityGame(model, query, predict)\n    feature_count = game.dimension\n    if model['kind'] == 'affine':\n        return np.asarray(model['parameters']['coef']) * (game.query - game.background.mean(axis=0))\n    if budget >= (1 << feature_count) - 2:\n        return exact_shapley(game)\n    if model['kind'] == 'logistic':\n        integrated_phi = logistic_fourier_shapley(model, query)\n        if integrated_phi is not None:\n            return integrated_phi\n    path_count = budget // (4 * (feature_count - 1))\n    path_masks = np.empty(0, dtype=np.uint32)\n    path_estimate = None\n    certified = False\n    if path_count >= 2:\n        path_marginals, path_masks = independent_paths(game, path_count, rng)\n        path_estimate, radius, certified = simultaneous_certificate(path_marginals)\n    remaining = budget - len(path_masks)\n    kernel_masks = sampled_kernel_masks(feature_count, remaining, rng)\n    masks = np.concatenate((path_masks, kernel_masks))\n    if certified:\n        return path_estimate\n    return kernel_regression(game, masks, len(path_masks))\ncertifi==2026.10.23\ncharset-normalizer==3.5.2\ncloudpickle==3.1.2\nfolktables==0.0.12\nidna==3.20\njoblib==1.6.0\nllvmlite==0.50.0\nnumba==0.68.1\nnumpy==2.1.3\npackaging==26.3\npandas==2.2.3\npython-dateutil==4.0.0\npytz==2026.6\nrequests==2.34.2\nscikit-learn==1.6.1\nscipy==1.15.3\nshap==0.48.0\nslicer==0.0.8\nthreadpoolctl==3.8.0\ntqdm==4.70.1\ntyping-extensions==4.16.0\ntzdata==2026.6\nurllib3==2.8.0\n\"\"\"Independent offline evaluator. Candidate API is documented in starter program.py.\n\nScientific validity is integrity + fixed coverage + analytic controls, NOT high\nempirical agreement. Search eligibility has no comparative performance cutoff.\nFinal correctness validates evidence completeness, not a positive reliability\nclaim. Paper/source review and uncertainty interpretation remain human evidence\nobligations; black-box RPC cannot prove a hidden algorithm or a causal mechanism.\n\"\"\"\nimport argparse\nimport base64\nimport collections\nimport ctypes\nimport decimal\nimport gzip\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport re\nimport resource\nimport selectors\nimport shutil\nimport signal\n\"\"\"Bounded probability-game Fourier/Owen integration; failure returns None.\n\nMesh agreement and endpoint efficiency are numerical diagnostics, not rigorous\ncoordinate-error certificates. No coalition predictions or random draws occur.\n\"\"\"\n\nimport math\n\nimport numpy as np\n\n\ndef _frequency_marginals(frequencies, base_logit, increments,\n                         inclusion_nodes, inclusion_weights):\n    phase_steps = np.exp(1j * frequencies[:, None] * increments[None, :])\n    mixture_factors = 1.0 - inclusion_nodes[None, :, None] + inclusion_nodes[None, :, None] * phase_steps[:, None, :]\n    ones = np.ones((*mixture_factors.shape[:2], 1), dtype=np.complex128)\n    prefix = np.concatenate((ones, np.cumprod(mixture_factors, axis=2)), axis=2)\n    suffix = np.concatenate((np.cumprod(mixture_factors[:, :, ::-1], axis=2)[:, :, ::-1], ones), axis=2)\n    excluded_products = prefix[:, :, :-1] * suffix[:, :, 1:]\n    t_integrals = np.einsum('q,fqj->fj', inclusion_weights, excluded_products)\n    complex_marginals = np.exp(1j * frequencies[:, None] * base_logit) * np.expm1(1j * frequencies[:, None] * increments[None, :]) * t_integrals\n    return np.imag(complex_marginals) / np.sinh(np.pi * frequencies[:, None])\n\n\ndef _frequency_mesh(base_logit, increments, inclusion_nodes, inclusion_weights,\n                    cutoff, panel_count, frequency_nodes, frequency_weights):\n    frequency_block_size = 32\n    panels_per_block = frequency_block_size // len(frequency_nodes)\n    panel_width = cutoff / panel_count\n    estimate = np.zeros(len(increments), dtype=np.float64)\n    for panel_start in range(0, panel_count, panels_per_block):\n        panel_indices = np.arange(panel_start, min(panel_count, panel_start + panels_per_block))\n        frequencies = (panel_width * (panel_indices[:, None] + 0.5 * (frequency_nodes + 1.0))).reshape(-1)\n        weights = np.tile(0.5 * panel_width * frequency_weights, len(panel_indices))\n        marginals = _frequency_marginals(frequencies, base_logit, increments,\n                                        inclusion_nodes, inclusion_weights)\n        if not np.all(np.isfinite(marginals)):\n            return None\n        estimate += weights @ marginals\n    return estimate\n\n\ndef _integrate_row(base_logit, increments, endpoint_difference,\n                   inclusion_nodes, inclusion_weights, frequency_nodes,\n                   frequency_weights):\n","exit_code":0,"status":"completed"}}
