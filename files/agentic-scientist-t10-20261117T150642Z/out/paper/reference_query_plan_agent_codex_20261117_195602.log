{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"rg --files task global_memory/task -g '*.md' -g '*.txt' -g '*.csv' -g '*.npz' | head -45; rg --files global_memory/ideas/02_offset_invariant_risk_adaptive_control_variates -g '*.md'; sed -n '215,246p' .codex/skills/memory-log/scripts/append_memory.py; python - <<'PY'\nimport json,statistics\nfrom collections import defaultdict\nfrom pathlib import Path\ncontent=json.loads(Path('paper_data.json').read_text())\ncases=defaultdict(list)\nfor episode in content['final_evaluation']['evaluation_evidence']['episodes']:\n for name,case in episode['solution']['cases'].items(): cases[name].append(case)\nfor name,items in sorted(cases.items()):\n values=[]\n for baseline in ['label_only','ppi','ppi_plus_plus']:\n  ratios=[]\n  baseline_coverage=[]\n  for item in items:\n   obs=item['observations']\n   ratios.append((obs['candidate'][1]-obs['candidate'][0])/(obs[baseline][1]-obs[baseline][0]))\n   baseline_coverage.append(obs['baseline_coverage'][baseline])\n  values.append((baseline,round(statistics.mean(ratios),6),round(statistics.mean(baseline_coverage),6)))\n print(name,values)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
