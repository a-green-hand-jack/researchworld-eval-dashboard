itation_key': 'HELM', 'title': 'Holistic Evaluation of Language Models', 'read_scope': 'abstract', 'content_path': 'literature/HELM.txt'}\n{'citation_key': 'Tiny', 'title': 'tinyBenchmarks: evaluating LLMs with fewer examples', 'read_scope': 'abstract', 'content_path': 'literature/Tiny.txt'}\n{'citation_key': 'Metabench', 'title': 'metabench -- A Sparse Benchmark of Reasoning and Knowledge in Large Language Models', 'read_scope': 'abstract', 'content_path': 'literature/Metabench.txt'}\n{'citation_key': 'BenchBench', 'title': 'Do These LLM Benchmarks Agree? Fixing Benchmark Evaluation with BenchBench', 'read_scope': 'abstract', 'content_path': 'literature/BenchBench.txt'}\n{'citation_key': 'Observational', 'title': 'Observational Scaling Laws and the Predictability of Language Model Performance', 'read_scope': 'abstract', 'content_path': 'literature/Observational.txt'}\n{'citation_key': 'Sloth', 'title': 'Sloth: scaling laws for LLM skills to predict multi-benchmark performance across families', 'read_scope': 'abstract', 'content_path': 'literature/Sloth.txt'}\n{'citation_key': 'Koren', 'title': 'Matrix Factorization Techniques for Recommender Systems', 'read_scope': 'abstract', 'content_path': 'literature/Koren.txt'}\n{'citation_key': 'Hu', 'title': 'Collaborative Filtering for Implicit Feedback Datasets', 'read_scope': 'abstract', 'content_path': 'literature/Hu.txt'}\n{'citation_key': 'CandesRecht', 'title': 'Exact Matrix Completion via Convex Optimization', 'read_scope': 'abstract', 'content_path': 'literature/CandesRecht.txt'}\n{'citation_key': 'CandesTao', 'title': 'The Power of Convex Relaxation: Near-Optimal Matrix Completion', 'read_scope': 'abstract', 'content_path': 'literature/CandesTao.txt'}\n{'citation_key': 'Keshavan', 'title': 'Matrix Completion From a Few Entries', 'read_scope': 'abstract', 'content_path': 'literature/Keshavan.txt'}\n{'citation_key': 'Mazumder', 'title': 'Spectral Regularization Algorithms for Learning Large Incomplete Matrices', 'rea