nt(\n236:        \"--global-memory-md\",\n240:    parser.add_argument(\n246:    parser.add_argument(\n251:    parser.add_argument(\n256:    parser.add_argument(\n261:    parser.add_argument(\n267:    parser.add_argument(\n273:    parser.add_argument(\n278:    parser.add_argument(\n390:            \"append_memory: --global-memory-md and --global-memory-jsonl are required \"\n400:    local_memory_path = Path(args.local_memory_md)\n404:    _append_text(local_memory_path, _markdown_entry(event), header=LOCAL_MEMORY_HEADERS)\n","exit_code":0,"status":"completed"}}
