{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re\nfrom pathlib import Path\nfor name in ['references_provenance.json','claims_grounding.json','paper_strategy.json','paper_data.json']:\n data=json.loads(Path(name).read_text())\n print('\\\\nFILE',name,'ROOT',type(data).__name__)\n if isinstance(data,dict):\n  for key,value in data.items():\n   print(key,':', ('keys='+str(list(value)[:22])) if isinstance(value,dict) else ('length='+str(len(value))) if isinstance(value,list) else str(value)[:700])\nprint('\\\\nCITATIONS')\ntext=Path('paper.tex').read_text()\nkeys=set(key.strip() for group in re.findall(r'\\\\\\\\cite\\\\w*\\\\{([\"'^}]+)'\"\\\\}',text) for key in group.split(','))\nbibkeys=set(re.findall(r'@\\\\w+\\\\{([\"'^,]+),'\"',Path('references.bib').read_text()))\nprint('cited',len(keys),'bibliography',len(bibkeys),'unresolved',sorted(keys-bibkeys),'uncited',sorted(bibkeys-keys))\nPY\nrg -n 'restrict|prohibit|allow|citation|literatur|family|benchmark|starter' paper_strategy.json | head -65; rg -n '\"'^'\"\\\\\\\\(section|subsection|paragraph)' paper.tex\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
