{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re,hashlib\nfrom pathlib import Path\npaper=Path('paper.tex').read_text()\nkeys=sorted({key.strip() for group in re.findall(r'\\\\\\\\cite\\\\w*\\\\{([\"'^}]+)'\"\\\\}',paper) for key in group.split(',')})\nbibkeys=re.findall(r'@\\\\w+\\\\{([\"'^,]+),'\"',Path('references.bib').read_text())\nprovenance=json.loads(Path('references_provenance.json').read_text())\nclaims=json.loads(Path('claims_grounding.json').read_text())['claims']\nprint('Sections:',re.findall(r'\\\\\\\\section\\\\{([\"'^}]+)'\"\\\\}',paper))\nprint('Cited keys:',keys)\nprint('Unresolved citation keys:',sorted(set(keys)-set(bibkeys)))\nprint('Bibliography keys without provenance:',sorted(set(bibkeys)-{item['citation_key'] for item in provenance['references']}))\nprint('Literature-grounded claims:',sum(bool(item.get('citation_keys')) for item in claims))\nprint('Citation-linked evidence files missing:',[ref for item in claims if item.get('citation_keys') for ref in item.get('evidence_refs',[]) if not Path(ref.split('#')[0]).exists()])\nstrategy=json.loads(Path('paper_strategy.json').read_text())\nfor key in ['notes_for_writer','staged_input_impact']:\n    value=strategy[key]\n    if isinstance(value,list):\n        for entry in value:\n            if any(word in str(entry).lower() for word in ['literature','reference','citation','eight','authorized']): print(key+':',entry)\n    elif isinstance(value,dict):\n        for subkey,entry in value.items():\n            if any(word in (subkey+str(entry)).lower() for word in ['literature','reference','citation','eight','authorized']): print(key+'.'+subkey+':',entry)\n    else: print(key+':',value)\ndata=json.loads(Path('paper_data.json').read_text())\nprint('Final outcome:', data['final_evaluation']['status'],data['final_evaluation']['outcome'],data['final_evaluation']['correct'])\nprint('Final limitations:',data['final_evaluation']['limitations'])\nprint('Protected hashes:',{path:hashlib.sha256(Path(path).read_bytes()).hexdigest() for path in ['paper.tex','references.bib','references_provenance.json']})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
