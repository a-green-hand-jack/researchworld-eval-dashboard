{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"ls ..; cat results/best_program_manifest.json; sed -n '1,140p' task/prepare_data.py; python - <<'PY'\nimport json\ns=json.load(open('paper_strategy.json')); print('key',list(s));\nfor k,v in s.items():\n if k not in ['figure_specs','writing_instructions']:print(k,str(v)[:7500])\nPY\"","aggregated_output":"final_evaluation\ninvestigation\nmetrics\npaper\npipeline_events.jsonl\ntask\ntask_drafting\n{\n  \"combined_score\": 0.056434729064039416,\n  \"correct\": true,\n  \"entrypoint_path\": \"src/program.py\",\n  \"program_dir\": \"work/results/t06/codex/20261106_231454/investigation/ideas/03_checkpoint_weighted_flip_path_exchange/program_1\",\n  \"source_attempt_id\": \"cycle_03_checkpoint_flip_path_exchange_attempt_01\",\n  \"updated_at\": \"2026-11-07T00:31:01.189886+00:00\"\n}\"\"\"Pinned, offline-capable preparation: python prepare_data.py --arena data/train.csv --nba data/nbaallelo.csv.\nRaw downloads stay outside the submission; this deterministic script records all derived provenance.\n\"\"\"\nimport argparse\nimport csv\nimport hashlib\nimport json\nimport pathlib\nimport unicodedata\nfrom collections import defaultdict\n\nSOURCES = {\n    \"arena\": (\"18c298340948c0e7f7727399fd459cca6ce0ca6f\", \"0692154aaf20fc6649090c3f49b6b5dd1e693a765ecb5f0856ae0da5946f5be2\"),\n    \"nba\": (\"4c1ff5e3aef1816ae04af63218015066e186c147\", \"d46ed3540ee8d9eca31b3e94cc8c777e0be5156173d814ebf65b8195e8d616bc\"),\n}\n\n\ndef canonical(value):\n    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False)\n\n\ndef digest(value):\n    return hashlib.sha256(canonical(value).encode()).hexdigest()\n\n\ndef normalize(value, strict=False):\n    if isinstance(value, str):\n        value = unicodedata.normalize(\"NFKC\" if strict else \"NFC\", value.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\"))\n        return \" \".join(value.split()) if strict else value\n    if isinstance(value, list):\n        return [normalize(item, strict) for item in value]\n    return value\n\n\ndef prepare(arena_path, nba_path, root):\n    for name, path in ((\"arena\", arena_path), (\"nba\", nba_path)):\n        if hashlib.sha256(path.read_bytes()).hexdigest() != SOURCES[name][1]:\n            raise ValueError(\"source checksum mismatch: \" + name)\n    csv.field_size_limit(16 * 1024 * 1024)\n    arena, parent, owners = [], [], {}\n\n    def find(index):\n        while parent[index] != index:\n            parent[index] = parent[parent[index]]\n            index = parent[index]\n        return index\n\n    with arena_path.open(newline=\"\", encoding=\"utf-8\") as stream:\n        for source_row, row in enumerate(csv.DictReader(stream), 2):\n            model_a, model_b = row[\"model_a\"], row[\"model_b\"]\n            flags = [int(row[key]) for key in (\"winner_model_a\", \"winner_model_b\", \"winner_tie\")]\n            if sum(flags) != 1 or model_a == model_b:\n                continue\n            outcome = 1.0 if flags[0] else 0.0 if flags[1] else 0.5\n            prompt, answer_a, answer_b = [json.loads(row[key]) for key in (\"prompt\", \"response_a\", \"response_b\")]\n            hashes = set()\n            for strict in (False, True):\n                documents = [normalize(doc, strict) for doc in (prompt, answer_a, answer_b)]\n                hashes.update(digest(doc) for doc in documents if any(str(item).strip() for item in doc))\n                left = [model_a, documents[1]]\n                right = [model_b, documents[2]]\n                if canonical(left) > canonical(right):\n                    left, right, mapped = right, left, 1 - outcome\n                else:\n                    mapped = outcome\n                hashes.add(digest([documents[0], left, right, mapped]))\n            index = len(arena)\n            parent.append(index)\n            for content_hash in sorted(hashes):\n                if content_hash in owners:\n                    parent[find(index)] = find(owners[content_hash])\n                else:\n                    owners[content_hash] = index\n            arena.append({\"source_id\": row[\"id\"], \"source_row\": source_row, \"a\": model_a, \"b\": model_b,\n                          \"y\": outcome, \"z\": 0.0, \"hashes\": sorted(hashes)})\n    members = defaultdict(list)\n    for index in range(len(arena)):\n        members[find(index)].append(index)\n    panels = {\"search\": {\"arena\": []}, \"final\": {\"arena\": []}}\n    for indices in members.values():\n        group = min(content_hash for index in indices for content_hash in arena[index][\"hashes\"])\n        plane = \"search\" if int(hashlib.sha256((\"split-v1:\" + group).encode()).hexdigest(), 16) % 4 == 0 else \"final\"\n        for index in indices:\n            arena[index][\"group\"] = group\n            panels[plane][\"arena\"].append(arena[index])\n    games = defaultdict(list)\n    with nba_path.open(newline=\"\", encoding=\"utf-8\") as stream:\n        for source_row, row in enumerate(csv.DictReader(stream), 2):\n            if int(row[\"year_id\"]) in (2006, 2007, 2008, 2011, 2012, 2013, 2014, 2015):\n                games[row[\"game_id\"]].append((source_row, row))\n    exclusions = []\n    for identity, rows in sorted(games.items()):\n        primary = [item for item in rows if item[1][\"_iscopy\"] == \"0\"]\n        if len(primary) != 1 or len(rows) != 2:\n            exclusions.append([identity, \"incomplete_reciprocal\", int(rows[0][1][\"year_id\"])])\n            continue\n        source_row, row = primary[0]\n        other = next(item[1] for item in rows if item[1][\"_iscopy\"] == \"1\")\n        if not (row[\"team_id\"] == other[\"opp_id\"] and row[\"opp_id\"] == other[\"team_id\"]\n                and row[\"pts\"] == other[\"opp_pts\"] and row[\"opp_pts\"] == other[\"pts\"]):\n            raise ValueError(\"inconsistent reciprocal game\")\n        year = int(row[\"year_id\"])\n        plane = \"search\" if year < 2010 else \"final\"\n        teams = sorted([row[\"team_id\"], row[\"opp_id\"]])\n        scores = {row[\"team_id\"]: int(row[\"pts\"]), row[\"opp_id\"]: int(row[\"opp_pts\"])}\n        location = {\"H\": 1.0, \"A\": -1.0, \"N\": 0.0}[row[\"game_location\"]]\n        home = row[\"team_id\"] if location == 1 else row[\"opp_id\"] if location == -1 else None\n        raw = [row[\"date_game\"], year, teams, [scores[team] for team in teams], home, row[\"is_playoffs\"]]\n        content_hash = digest(raw)\n        example_hash = digest([teams, [scores[team] for team in teams], row[\"date_game\"], home])\n        record = {\"source_id\": identity, \"source_row\": source_row, \"reciprocal_rows\": [item[0] for item in rows],\n                  \"a\": row[\"team_id\"], \"b\": row[\"opp_id\"], \"y\": float(int(row[\"pts\"]) > int(row[\"opp_pts\"])),\n                  \"z\": location, \"hashes\": [content_hash, example_hash], \"group\": content_hash}\n        panels[plane].setdefault(\"nba-\" + str(year), []).append(record)\n    sets = {plane: {content_hash for records in cases.values() for row in records for content_hash in row[\"hashes\"]}\n            for plane, cases in panels.items()}\n    if sets[\"search\"] & sets[\"final\"]:\n        raise ValueError(\"normalized raw document/example overlap\")\n    ids = {plane: {row[\"source_id\"] for cases in panels[plane].values() for row in cases} for plane in panels}\n    if ids[\"search\"] & ids[\"final\"]:\n        raise ValueError(\"source ID overlap\")\n    for plane, cases in panels.items():\n        destination = root / \"resources\" / plane\n        destination.mkdir(parents=True, exist_ok=True)\n        manifest = {\"normalization\": \"v1 NFC line endings preserve case/whitespace; additional NFKC whitespace-collapsed audit; JSON parsed before hashing; swapped example canonicalization; transitive document groups\",\n                    \"sources\": SOURCES, \"content_disjoint\": True, \"source_disjoint\": True,\n                    \"hash_count\": len(sets[plane]), \"group_rule\": \"sha256(split-v1:minimum-content-hash) modulo 4 equals 0 for search\",\n                    \"nba_exclusions\": [item for item in exclusions if (item[2] < 2010) == (plane == \"search\")], \"cases\": {}}\n        for case, records in cases.items():\n            records.sort(key=lambda row: row[\"source_row\"])\n            if len(records) < 1000:\n                raise ValueError(\"insufficient panel: \" + case)\n            names = sorted({row[side] for row in records for side in (\"a\", \"b\")})\n            index = {name: ordinal for ordinal, name in enumerate(names)}\n            data = {\"case\": case, \"participants\": names, \"rows\": [[index[row[\"a\"]], index[row[\"b\"]], row[\"y\"], row[\"z\"]] for row in records],\n                    \"provenance\": [{key: value for key, value in row.items() if key not in (\"a\", \"b\", \"y\", \"z\")} for row in records]}\n            (destination / (case + \".json\")).write_text(canonical(data) + \"\\n\")\n            manifest[\"cases\"][case] = {\"rows\": len(records), \"participants\": len(names), \"groups\": len({row[\"group\"] for row in records})}\n        (destination / \"manifest.json\").write_text(canonical(manifest) + \"\\n\")\n    print(canonical({plane: {case: len(rows) for case, rows in cases.items()} for plane, cases in panels.items()}))\nkey ['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason']\nstatus ready\nselected_prompt_family paper_standalone\nrecommended_title Exact-Refit Stress Tests for Bradley–Terry Rankings\ncentral_question How much can small, matched-budget binary-outcome changes disrupt fitted Bradley–Terry orderings on the observed Arena and NBA panels, and how consistently do exact-refitted guided interventions exceed simple controls?\ncentral_thesis On the fixed Arena and NBA panels, influence-guided flip-path exchange yields larger budget-averaged pairwise-order disruption point estimates than three matched-budget baselines, but fixed-plan bootstrap evidence supports a clearer advantage on Arena than across NBA seasons.\nnarrative_rationale The strongest evidence is the completed final evaluation of one selected outcome-flip method on two real evaluation designs, with independently refitted endpoints, three baselines, graph summaries and paired uncertainty. The paper should study attainable finite-perturbation sensitivity, not tell an improvement story or claim a certified robustness radius. The positive Arena contrasts and inconclusive sports contrasts jointly support a useful, bounded empirical-methodology study. The aggregate difference is not proof of a particular component's contribution or of a causal evaluation-design effect. Readiness here means a coherent framing is supported, not that publication, novelty or manuscript validation has been established.\nprior_paper_story_status rejected\nedit_framing_decision This is not edit mode: no resolved edit-context files, previous_paper manuscript, aggregated directory or extra_tasks directory is present. There is no prior manuscript story to preserve. The rejected alternative is the prospective exposure-matched MT-Bench block-deletion story recorded in planning, not an existing paper. Reject it as the main story because the implemented and evaluated intervention is anonymous binary-outcome flipping on Arena and NBA. Compare alternatives explicitly: local preservation of the prospective story lacks evaluated deletions and matching; broadening to a shared deletion/flip method would exceed the evidence; recentering on the evaluated finite-flip sensitivity question is supported. No previous title or figure plan is inherited.\nstaged_input_impact ['paper_data.json.final_evaluation was read independently: final.qualification.status is completed, final.qualification.outcome is qualified, and final.qualification.correct is true. These describe the reported evaluation outcome, not universal scientific validity or publication acceptance.', 'No downstream_study or study.* grounding sources exist. Do not invent a campaign designation, frozen-selection rationale, search-score difference or scored/unscored attempt accounting under that namespace. The selected-method identity is corroborated by result.top_program_01, results/best_program_manifest.json and the available selected source; the final artifact separately records its program-tree digest. Do not claim an independently recomputed tree-hash match.', 'Directly inspected results/ideas/03_checkpoint_weighted_flip_path_exchange/program_1/src/program.py and IMPLEMENTATION.md: the method aggregates sufficient statistics, retains a width-two exact-refitted path generator, and refines a complete nested flip path using screened swaps and replacements. It does not implement provenance-matched deletions or a width-four crossing beam as its defining contribution.', 'The final evidence has Arena and NBA 2011–2015, not evaluated MT-Bench human/judge matching. Treat these as separate condition-specific evidence blocks under one sensitivity question, with a shared estimator/intervention and an NBA home-effect adaptation, not matched datasets or a causal contrast of evaluation designs.', 'The final case-level paired intervals materially constrain the thesis: all Arena baseline contrasts have positive lower endpoints across the recorded seeds, while several NBA contrasts include zero. There is no component ablation bundle, so attribution to exchange alone is unsupported.', 'The current bibliography and provenance contain retrieved metadata, including many irrelevant entries, without full-text reading attestations. This does not block a scientific framing, but it blocks treating those records as an already verified related-work base. Do not cite a record merely because retrieval populated it. No figure assets currently exist.']\nmethod_groups [{'name': 'Influence-guided exact-refit flip-path exchange', 'role': 'proposed', 'include_reason': 'The selected method studied in final evidence: frozen-contrast influence calculations, adaptive exact-refitted path construction, bounded complete-path swaps/replacements and a complete incumbent fallback. Explain these as the evaluated bundle, not separately proven sources of gain.'}, {'name': 'Uniform random outcome flips', 'role': 'baseline', 'include_reason': 'Provides a same-budget unstructured perturbation reference, averaged over the recorded random streams rather than selected after observing performance.'}, {'name': 'Degree-quartile-matched random flips', 'role': 'baseline', 'include_reason': 'Controls approximately for the degree-sum exposure profile of the actual selected prefixes. Explicitly distinguish coarse quartile matching from exact endpoint, content, question-block or cross-design matching.'}, {'name': 'Smallest absolute matchup-margin flips', 'role': 'baseline', 'include_reason': 'Tests whether a simple fitted-closeness rule explains the observed disruption without guided complete-path selection.'}, {'name': 'Independent refit and integrity diagnostics', 'role': 'supporting', 'include_reason': 'Explain no-op, rotated-priority, reset-state and explicitly synthetic constant-zero controls as integrity checks, not competitive algorithms, architecture ablations or evidence of real historical manipulation.'}]\nresults_focus ['Primary comparison: show all four methods for all six final cases at each of the three nominal fractions, 0.1%, 0.5% and 1% of all usable observations. Plot categorical budgets without connecting them as an optimization trajectory. Report floor-rounded integer costs, and make clear that only binary outcomes can be flipped while ties remain in fitting and in the denominator.', 'Reader-facing primary metric: pairwise-order disruption, the number of participant-pair order reversals divided by the number of participant pairs, using the fixed participant-index tie order. Its reconstruction from stored original_scores and edited_scores matches every stored candidate_curves value exactly. Larger values mean a more disruptive stress test, not better predictive accuracy or a more accurate leaderboard.', 'Keep the final overall statistic as a compact supporting table: proposed 0.055641534391534395, uniform random 0.00935242200328407, degree-quartile matched 0.011150133225384662, and close-margin 0.007573891625615763. Ground these in their respective final.metric.* sources. Explain equal weights over budgets, seeds and design families, with equal seasons within NBA; do not silently pool observations or let the five seasons outweigh Arena.', 'Essential uncertainty: show recorded paired candidate-minus-baseline intervals by case and seed in the main paper. They summarize budget-averaged disruption under fixed intervention plans, not separately each plotted budget. Arena intervals are positive for all three baselines in all seeds. Several NBA intervals include zero; NBA 2013–2015 include zero for all three baselines in all recorded seeds. Do not replace these with a universal significant-superiority claim.', 'Main limitations must accompany the main results: only 30 grouped bootstrap replicates per final case/seed, no reselection of interventions inside bootstrap, three algorithmic seeds rather than independent datasets, a single crowd panel, unequal graphs and data volumes, a fixed ridge, and omitted temporal/dynamic effects. No new population-level, cross-design causal, temporal-transfer or optimality claim follows.', 'Use graph descriptors and actual flip counts to explain the estimand and comparison regime, not as fitted causal explanations of performance. Final Arena has 64 participants; each final NBA panel has 30. Finite-change influence approximation discrepancy is nonzero and is not a failure of the audited derivative arithmetic by itself.', 'No main-body search chronology, no search-to-final delta, no winner progression, no measured loss assigned to an unscored attempt, and no original-incumbent superiority comparison: a matched final evaluation of the original candidate is absent. Retain the three original final-evidence comparator families above. Search artifacts may document configuration provenance only, clearly labeled as development evidence rather than final replication.']\nfigure_plan ['Early overview: two compact conceptual panels show the fixed comparison graph and legal nested outcome flips, then influence screening, complete-path exchange, exact refits and matched-budget comparison with conditional uncertainty. No invented graph measurements or illustrative empirical ranks.', 'Direct final comparison: three vertically stacked grouped-dot panels, one per nominal edit fraction, each with the six observed cases and four method series. Keep unconnected markers, common metric semantics and a common vertical scale.', 'Paired uncertainty: three vertically stacked forest panels, one per baseline, each with six case categories and three offset seed-specific intervals; include zero explicitly. Label the estimand as budget-averaged fixed-plan paired disruption difference.']\nsupplementary_plan {'purpose': 'Add substantive implementation, complete recorded evidence and reproducibility detail after the references, while keeping all six-case comparisons, essential uncertainty and scope restrictions in the main paper. Include only analyses already supported by the current evidence; later authoritative appendix-ranked analyses may be added without changing this strategy.', 'planned_subsections': [{'heading': 'Complete Case, Budget and Seed Results', 'grounded_content': 'Tables of candidate_curves, all baseline_curves, counts, paired_intervals and graph descriptors for every final case/seed. Preserve intervals that include zero and the repeated nature of algorithmic seeds. Include recorded original/edited rank intervals where useful, without inventing per-budget intervals absent from the evidence.', 'source_ids': ['final.evidence.episodes']}, {'heading': 'Influence Arithmetic and Finite-Change Diagnostics', 'grounded_content': 'Explain unit-outcome derivatives versus binary-flip signed shifts, the frozen original Hessian and independent exact refits, using the selected program and public contract as method documentation. Tabulate recorded influence_errors by case/budget and method_audit and control outcomes. The overall finite-change discrepancy is 0.14315313656317594; do not interpret it as a rate of invalid results or prove hidden implementation internals from a passing audit.', 'source_ids': ['final.evidence.episodes', 'final.metric.influence_error', 'final.metric.control_error']}, {'heading': 'Nested Flip-Path Construction and Reproducibility', 'grounded_content': 'Document the centered sum-loss ridge-1 objective, sufficient-statistic representation, width-two generator, selected-position swaps, unused-row replacements, affected-prefix caching, strict complete-path acceptance and incumbent fallback from the available selected source. Report source-declared bounds as settings, not measured usage: 128 optional proposals, 72 additional converged fits at dimension at most 64 and 24 otherwise, and a two-second soft optional-search deadline. An ongoing fit is not interrupted; load-dependent truncation limits bitwise reproducibility. Include the recorded final seeds, observable durations, program-tree digest and exact existing dependency/data-acquisition files. Do not invent per-method runtimes or claim reproduction has been rerun. Final evidence anchors the evaluated bundle; implementation details are corroborated by the named program and public contract, not inferred from metric values.', 'source_ids': ['final.evidence.episodes', 'final.qualification.status']}, {'heading': 'Data Provenance and Scope of Comparability', 'grounded_content': 'Use task/resources/final/manifest.json and task/prepare_data.py as existing provenance documentation alongside the final graph/count evidence: Arena normalized document-connected groups, unique NBA games, reciprocal-row handling, content-disjoint partition policy, source snapshots/checksums and license records where actually available. Distinguish a manifest assertion from an independently rerun verification. Explain fractional ties, NBA home effects, season-specific fitting and unequal graph coverage. No MT-Bench, expert/judge or block-deletion results can be added.', 'source_ids': ['final.evidence.episodes']}, {'heading': 'Evaluation Outcome and Claim Boundaries', 'grounded_content': 'Record the completed and qualified final evaluation using final.qualification.*, separately from point estimates and publication judgment. Explain that numerical audits and four controls have limited scope, that candidate diagnostics are marked unverified, and that no comparative-superiority gate is implied. Do not invent absent gate diagnostics. If later authoritative evidence reports failed qualification, update the main claims, review, audit and revisions together; do not silently retain a qualified characterization.', 'source_ids': ['final.qualification.status', 'final.qualification.outcome', 'final.qualification.correct', 'final.evidence.episodes']}, {'heading': 'LLM Usage', 'grounded_content': 'Disclose the documented assistance with ideation, candidate-source preparation, reference-query planning and paper framing/writing. Separate static preparation statements from actual recorded evaluator execution. Use source paths and assistant logs as provenance, without claiming any undocumented model-generated judgments of the empirical data, prohibited-source access, or literature reading. Redact identifying paths and keep the submission anonymous.', 'source_ids': ['result.top_program_01', 'final.evidence.episodes']}]}\nforbidden_headings ['Search Progression', 'Campaign Timeline', 'Milestones', 'First Valid Result', 'Experiment A / Experiment B', 'Phase 1 / Phase 2', 'Round-by-Round Improvements', 'From Failure to Winner', 'Architecture Ablations', 'Matched MT-Bench Deletion Results']\nforbidden_phrases ['first valid result', 'we then tried', 'subsequent improvements', 'next-best', 'later variants', 'winning iteration', 'correctness rate', 'correct and eligible', 'eligible', 'worker_01', 'worker_02', 'combined_score', 'rubric', 'state-of-the-art leaderboard attack', 'certified minimum manipulation budget', 'exactly exposure-matched', 'all NBA comparisons are significant', 'sports evaluation is causally more robust', 'the exchange component explains the gain']\nnotes_for_writer ['Organize thesis-first: Introduction; Related Work; Ranking Sensitivity and Perturbation Model; Influence-Guided Exact-Refit Stress Testing; Evaluation Design; Results and Conditional Uncertainty; Discussion and Limitations; Conclusion. Arena and NBA are evidence blocks for one question, not two chronologically ordered experiments.', 'Plan approximately 8.5 body pages including figures and captions: abstract/introduction 1.2, related work 0.6, estimand/model 1.0, method 1.4, evaluation design 1.1, results 2.1, discussion/limitations 0.9, conclusion 0.2. These are layout targets, not measured results. The venue permits 8–9 pages excluding references, with an 8-page body valid only if its final page is at least 75% full. Spend space on equations, clear comparison design, graph/count context, complete uncertainty and limitations, not a search log, speculative theory or decorative material. Rebalance within the cap rather than padding.', 'Inspected .codex/skills/write-paper-standalone/templates/iclr/paper.tex and paper.sty: article is single-column, textwidth 5.5 inches and textheight 9 inches on letter paper. There is no separate half-page conference column; column width equals full text width. All three required figures therefore use ordinary full-text-width figures. Keep practical final-size font targets rather than shrinking dense assets.', 'The supplied scaffold enables final-copy mode and contains an author string: remove that mode and author identity for the anonymous ICLR 2026 submission, omit affiliations, acknowledgements and funding, and retain any orchestrator-owned watermark block unchanged. Do not claim official latest-template provenance has been independently verified merely because the supplied style is available; document that provenance at the writing/compilation stage. The task contract mentions a different venue, but the current explicit ICLR 2026 venue brief governs this strategy.', 'State the model explicitly: sum of logistic losses plus one-half the squared parameter norm, participant scores centered, optional NBA home covariate regularized with the same fixed coefficient. Ties contribute fractional outcomes but are uneditable. Nominal costs use all usable rows; report exact floor-rounded costs alongside the nominal fractions. Distinguish method internal displacement-first lexicographic selection from the reader-facing inversion-fraction endpoint; they are not identical objectives.', 'Use final.metric.* and final.evidence.episodes for final quantitative claims, and final.qualification.* only for qualification facts. The actual outcome here is qualified, not not_qualified. Absence of downstream_study does not invalidate the independent completed final evaluation. Preserve this separation in later drafting, review, audit and revision. Unknown gate causes remain unknown; neither positive metrics nor publication eligibility override an adverse outcome in other runs.', 'Private-only provenance context: selection corroboration comes from result.top_program_01 and the best-program manifest, while the final program-tree digest is recorded independently. No study.* namespace is supplied; omit unsupported selection differences and attempt-count claims rather than synthesizing aliases. Do not compare the earlier candidate as a final baseline or label differing search submissions as controlled ablations.', 'The main paper must say that these are feasible observed-outcome counterfactual changes, not evidence of historical vote rigging, population preference change or attacker access in deployed systems. Finding a disruptive path gives an attainable sensitivity witness, not an optimal attack, a lower bound on necessary changes, or a certificate of robustness.', 'Uncertainty is conditional on fixed selected interventions and fixed panels. Thirty resamples give coarse percentile endpoints; three seeds are not three independent datasets; no multiple-comparison correction or adaptive-reselection uncertainty is established. Keep the inconclusive NBA evidence in the main text and figure, not only in the supplement.', 'Do not invent component ablations, alternative ridge sweeps, deletion studies, matched human/judge data, successful target reversals, runtime speedups, unseen-model or temporal generalization, or architectures. A mechanistic description of exchange is supported by code, but attributing the observed advantage specifically to exchange is not supported by a controlled final ablation.', 'Quantitative plots must be regenerated from recorded arrays by saved scripts and exported as vector PDF plus PNG at 300 DPI; LaTeX must reference the PDF whenever it exists. Use the same four method colors throughout, colorblind-safe markers, abbreviated case labels and shared legends. Derived seed means must be explicitly labeled summaries of the recorded values, never new experimental observations.', 'Plan exactly one generate-concept-figure overview. The orchestrator owns rendering; the writer only wires the figure and its manifest/prompt-log entries according to the skill. If an editable vector export yields a PDF, use that PDF in LaTeX; otherwise require the