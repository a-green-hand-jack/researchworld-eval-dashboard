\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Paired minimum task fractions for identical targets. Top: HELM; bottom: Open LLM. Left: full headroom; right: half headroom. NA rails indicate certified unattainability, not missing values or an additional numeric range. Annotated row indices identify targets that reverse their mean--median ordering. Labels $\times k$ denote coincident target points. All finite points have matching independent lower and upper cardinality bounds.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:paired}{{2}{7}{Paired minimum task fractions for identical targets. Top: HELM; bottom: Open LLM. Left: full headroom; right: half headroom. NA rails indicate certified unattainability, not missing values or an additional numeric range. Annotated row indices identify targets that reverse their mean--median ordering. Labels $\times k$ denote coincident target points. All finite points have matching independent lower and upper cardinality bounds}{figure.caption.9}{}}
