hed_work_seconds_per_method\": 1.2,\n    \"methods\": 6,\n    \"method_bookkeeping_seconds\": 0.01,\n    \"productive_time_floor\": null,\n    \"calibration\": \"No canonical productive-work minimum or threshold delegation exists. Work allowances bound actual fixed dimensions; do not sleep, inflate runtime or tune scientific thresholds.\",\n    \"platform\": \"Linux x86_64, CPython 3.11 or 3.12; native smoke needs Landlock ABI>=3 and libseccomp.so.2; no namespace privilege required. All numerical-library threads one, at most two cores per role; 8 GiB per role; no GPUs. Harness enforces production role CPU/memory isolation.\"\n  },\n  \"preflight\": {\n    \"rpc_operation_counts\": {\n      \"reset\": 625,\n      \"ingest\": 5000,\n      \"fit\": 625,\n      \"predict\": 625\n    },\n    \"rpc_total\": 6875,\n    \"max_request_utf8_json_envelope_and_framing_bytes\": 5592859,\n    \"max_prediction_utf8_json_envelope_and_framing_bytes\": 384099,\n    \"chunk_decoded_bytes\": 4194304,\n    \"max_logical_input_decoded_bytes\": 33554432,\n    \"largest_shape_actual_input_decoded_bytes\": 5676000,\n    \"max_prediction_decoded_bytes\": 288000,\n    \"wire_limit_bytes_exclusive\": 67108864,\n    \"framing_model\": \"full JSON line including base64 metadata inside request/response id envelope plus eight framing bytes; runtime messages additionally bounded\",\n    \"mock_max_chunk_trace_verified\": true,\n    \"scheduler_scenarios\": [\n      \"near_limit\",\n      \"mid_timeout\",\n      \"reset_timeout\",\n      \"slow_cleanup\"\n    ],\n    \"largest_shape_native_validation\": {\n      \"n\": 12000,\n      \"m\": 600000,\n      \"p\": 8,\n      \"rpc_calls\": 11,\n      \"decoded_input_bytes\": 5676000,\n      \"decoded_response_bytes\": 288000,\n      \"candidate_fit_roundtrip_seconds_not_productive_measure\": 0.025690695736557245,\n      \"baseline_productive_ols_seconds\": 0.0015765507705509663,\n      \"baseline_minimum_required\": null,\n      \"baseline_failure_identity_tests\": true\n    },\n    \"largest_baseline_worker_json_line_bytes\": 7568070\n  },\n  \"aggregation\": {\n    \"scientific\": \"equal seeds within each case, equal six mechanisms within each family, equal families; all original slots retained\",\n    \"weights\": {\n      \"scientific\": 0.8,\n      \"constant\": 0.1,\n      \"permutation\": 0.05,\n      \"replay\": 0.05\n    },\n    \"smoke_weights\": {\n      \"M0\": 0.4,\n      \"M2\": 0.4,\n      \"constant\": 0.1,\n      \"permutation\": 0.05,\n      \"replay\": 0.05\n    },\n    \"utility\": \"1-min(10,max(-10,estimate-true_gate))**2/100; noise scale=1\",\n    \"rmse\": \"sqrt(mean(clipped_error**2 over seeds)) then equal cases/families\",\n    \"bias\": \"abs(mean(signed clipped_error over seeds)) then equal cases/families; incomplete case contributes 10\",\n    \"failure\": {\n      \"utility\": 0,\n      \"signed_error\": 10,\n      \"squared_error\": 100,\n      \"control_success\": 0\n    },\n    \"control_metric_weights\": {\n      \"constant\": 0.5,\n      \"permutation\": 0.25,\n      \"replay\": 0.25\n    },\n    \"evidence_seed_score\": \"same hierarchy within seed, common sole replay contribution .05 shared across seed records; mean seed scores equals combined_score\",\n    \"failure_denominator\": \"161 search, 625 final, 5 smoke; unsuccessful matched controls count as failed episodes\"\n  },\n  \"split_audit\": {\n    \"normalized_graph_intersections\": 0,\n    \"normalized_raw_example_intersections\": 0,\n    \"checked_before_fitting\": true,\n    \"source_seed_sets_disjoint\": true,\n    \"different_id_duplicate_test\": \"rejected\",\n    \"node_relabel_duplicate_test\": \"rejected\",\n    \"audit_scope\": \"complete production graphs and all six raw experimental mechanisms; matched within-plane controls intentionally reuse input\"\n  }\n}\n    np.add.at(exposure, edges[:, 1], assignment[edges[:, 0]])\n    exposure /= np.maximum(degree, 1)\n    curvature = exposure * (1.0 - exposure)\n    return np.column_stack((np.ones(_state['n']), _state['x'], assignment, exposure, assignment * exposure, curvature, assignment * curvature))\n\n\ndef _fit_endpoint_sure(assignment, outcome):\n    observed_design = _reference_features(assignment)\n    treated_design = _reference_features(np.ones(_state['n']))\n    control_design = _reference_features(np.zeros(_state['n']))\n    feature_mean = observed_design[:, 1:].mean(axis=0)\n    feature_scale = observed_design[:, 1:].std(axis=0)\n    feature_scale = np.where(feature_scale > 0.0, feature_scale, 1.0)\n    standardized_design = (observed_design[:, 1:] - feature_mean) / feature_scale\n    endpoint_contrast = (treated_design[:, 1:].mean(axis=0) - control_design[:, 1:].mean(axis=0)) / feature_scale\n    outcome_mean = float(outcome.mean())\n    centered_outcome = outcome - outcome_mean\n    if not (np.all(np.isfinite(feature_mean))\n            and np.all(np.isfinite(feature_scale))\n            and np.all(np.isfinite(standardized_design))\n            and np.all(np.isfinite(endpoint_contrast))\n            and np.all(np.isfinite(centered_outcome))):\n        return _fit_incumbent(assignment, outcome)\ndef normalize_edges(edges):\n    edges = np.sort(np.asarray(edges, dtype='<i4').reshape(-1, 2), axis=1)\n    return np.unique(edges[edges[:, 0] != edges[:, 1]], axis=0).astype('<i4')\n\n\ndef matrix_for(edges, count):\n    return sparse.csr_matrix((np.ones(2 * len(edges)),\n                              (edges.T.ravel(), edges[:, ::-1].T.ravel())), shape=(count, count))\n\n\ndef potential_outcome(assignment, covariates, noise, edges, mechanism):\n    graph = matrix_for(edges, len(assignment))\n    degree = np.asarray(graph.sum(axis=1)).ravel()\n    exposure = (graph @ assignment) / np.maximum(degree, 1)\n    two_hop = (graph @ exposure) / np.maximum(degree, 1)\n    spill = [np.zeros(len(assignment)), .25 * exposure, 2 * exposure,\n             2 * (exposure >= .75) + assignment * exposure, 2 * two_hop, 2 * exposure][mechanism]\n    return .5 * covariates[:, 0] + assignment + spill + noise\n\n\ndef encode_input(edges, covariates, assignment, observed):\n    packed = (edges.astype('<i4').tobytes() + covariates.astype('<f8').tobytes()\n              + assignment.astype('u1').tobytes() + observed.astype('<f8').tobytes())\n    if len(packed) > 32 * 1024**2:\n        raise ValueError('logical input limit')\n    return packed\n\n\ndef input_layout(count, width, edge_count):\n    return [{'name': 'edges', 'dtype': '<i4', 'shape': [edge_count, 2], 'offset_bytes': 0},\n            {'name': 'covariates', 'dtype': '<f8', 'shape': [count, width], 'offset_bytes': 8 * edge_count},\n            {'name': 'treatment', 'dtype': 'uint8', 'shape': [count], 'offset_bytes': 8 * edge_count + 8 * count * width},\n            {'name': 'observed', 'dtype': '<f8', 'shape': [count], 'offset_bytes': 8 * edge_count + 8 * count * width + count}]\n\n\ndef prediction(response, count):\n    if (type(response) is not dict or set(response) != {'encoding', 'dtype', 'shape', 'data'}\n            or response['encoding'] != 'base64' or response['dtype'] != '<f8'\n            or response['shape'] != [3, count] or type(response['shape']) is not list\n            or any(type(value) is not int for value in response['shape']) or type(response['data']) is not str):\n        raise ProtocolError('prediction_schema')\n    try:\n        packed = base64.b64decode(response['data'], validate=True)\n    except (ValueError, TypeError):\n        raise ProtocolError('prediction_encoding') from None\n    if len(packed) != 24 * count or len(packed) > CHUNK:\n        raise ProtocolError('prediction_shape')\n    values = np.frombuffer(packed, '<f8').reshape(3, count).copy()\n    if not np.isfinite(values).all() or np.max(np.abs(values)) > 1e100:\n        raise ProtocolError('prediction_nonfinite')\n    return values\n\n\n    return {'ok': False, 'control': 0., 'error': 10., 'squared': 100., 'utility': 0.,\n            'duration': 0., 'solution': None}\n\n\ndef aggregate(episodes, outcomes):\n    cases = {}\n    controls = {'constant': [], 'permutation': [], 'replay': []}\n    for episode, outcome in zip(episodes, outcomes):\n        if episode['kind'] == 'scientific':\n            cases.setdefault((episode['family'], episode['mechanism']), []).append(outcome)\n        else:\n            controls[episode['kind']].append(outcome['control'] if outcome['ok'] else 0.)\n    utilities, rmses, biases = [], [], []\n    for rows in cases.values():\n        utilities.append(float(np.mean([row['utility'] for row in rows])))\n        rmses.append(math.sqrt(float(np.mean([row['squared'] for row in rows]))))\n        biases.append(abs(float(np.mean([row['error'] for row in rows]))) if all(row['ok'] for row in rows) else 10.)\n    constant, permutation, replay = (float(np.mean(controls[name])) for name in ('constant', 'permutation', 'replay'))\n    metrics = dict(zip(METRICS, [.8 * float(np.mean(utilities)) + .1 * constant + .05 * permutation + .05 * replay,\n                               float(np.mean(rmses)), float(np.mean(biases)),\n                               float(np.mean([not row['ok'] for row in outcomes])),\n                               .5 * constant + .25 * permutation + .25 * replay]))\n    if not all(math.isfinite(value) for value in metrics.values()):\n        raise ValueError('nonfinite aggregation')\n    correct = all(row['ok'] for row in outcomes) and constant == permutation == replay == 1.\n    return metrics, correct\n\n\ndef evidence(episodes, outcomes):\n    records = []\n    replay_result = next(row['control'] for episode, row in zip(episodes, outcomes) if episode['kind'] == 'replay')\n    for seed in dict.fromkeys(episode['seed'] for episode in episodes):\n        selected = [(episode, row) for episode, row in zip(episodes, outcomes) if episode['seed'] == seed]\n        scientific = [row['utility'] for episode, row in selected if episode['kind'] == 'scientific']\n        constant = next(row['control'] for episode, row in selected if episode['kind'] == 'constant')\n        permuted = next(row['control'] for episode, row in selected if episode['kind'] == 'permutation')\n        score = .8 * float(np.mean(scientific)) + .1 * constant + .05 * permuted + .05 * replay_result\n            raise ProtocolError('fit_ack')\n        values = prediction(candidate_call({'op': 'predict'}), len(covariates))\n        if time.monotonic() > method_deadline:\n            raise TimeoutError()\n        contrast = float(np.mean(values[1] - values[2]))\n        key = (episode['family'], episode['mechanism'], episode['seed'])\n        control_success = 1.\n        if episode['kind'] == 'scientific':\n            truth = float(np.mean(potential_outcome(np.ones(len(covariates)), covariates, noise, edges, episode['mechanism'])\n                                  - potential_outcome(np.zeros(len(covariates)), covariates, noise, edges, episode['mechanism'])))\n            uncapped_error = contrast - truth\n            reference[key] = values\n        elif episode['kind'] == 'constant':\n            truth, uncapped_error = 0., contrast\n            control_success = float(abs(contrast) <= 1e-6)\n        else:\n            expected = reference.get(key)\n            aligned = values[:, permutation] if episode['kind'] == 'permutation' else values\n            control_success = float(expected is not None and np.allclose(aligned, expected, atol=1e-6, rtol=1e-6))\n            truth, uncapped_error = None, 0.\n        clipped = float(np.clip(uncapped_error, -10., 10.))\n        solution = {'contrast': contrast, 'true_gate': truth, 'uncapped_error': uncapped_error,\n                    'clipped': abs(uncapped_error) > 10., 'baseline_estimates': baseline_estimates,\n                    'observed_fit_rmse': float(np.sqrt(np.mean((values[0] - observed)**2))),\n                    'prediction_sha256': hashlib.sha256(values.astype('<f8').tobytes()).hexdigest(),\n                    'control_success': bool(control_success)}\n        graph = matrix_for(edges, len(covariates))\n        degree = np.asarray(graph.sum(axis=1)).ravel()\n        exposure = (graph @ assignment) / np.maximum(degree, 1)\n        condition = float(np.linalg.cond(np.column_stack((np.ones(len(covariates)), covariates, assignment, exposure))))\n        solution['exposure_support'] = {'minimum': float(exposure.min()), 'maximum': float(exposure.max()),\n                                        'fraction_zero': float(np.mean(exposure == 0)),\n                                        'fraction_one': float(np.mean(exposure == 1)),\n                                        'linear_design_condition': condition if math.isfinite(condition) else None}\n        return {'ok': bool(control_success), 'control': control_success, 'error': clipped, 'squared': clipped**2,\n                'utility': 1. - clipped**2 / 100., 'duration': 0., 'solution': solution}\n\n    try:\n        outcomes, complete = run_declared_episodes(episodes, hard_deadline=hard_deadline,\n                              finish_reserve=FINISH, reset_timeout=RESET_TIMEOUT, episode_overhead=OVERHEAD,\n                              rpc_cap=WORK + RESET_TIMEOUT, clock=time.monotonic, rpc=episode_rpc,\n                              evaluate=evaluate_episode, worst_case=worst_case, record_failure=record_failure)\n        category = baseline.check()\n        if category is not None and not baseline_failed:\n            baseline_failed = category\n            complete = False\n            duration = outcomes[-1]['duration']\n            was_complete = outcomes[-1]['ok']\n# Global Memory Summary\n\nUse as qualitative context only; do not use as quantitative grounding source.\n\n## Recent Entries\n\n- 2026-11-07 | step=idea | scope=idea\n  - summary: Selected Endpoint Contrast Audit with Hidden Spillover Twins; gate=kept; trigger=none; reason=An untested proposal supplies no evaluated basis for changing distilled conclusions.\n  - evidence: Bootstrap manifest combined_score=0.9909514004064053 and correct=true; histories empty; supplied incumbent source path unavailable. No research computation or external search performed. Alternatives were a broad architecture sweep, cluster-design optimization, and a neural replacement; none has a demonstrated bottleneck advantage. Authored idea_bundle.json and identical target_rubrics.json rubric array. Canonical local memory is ideas/01_endpoint_contrast_audit_with_hidden_spillover_twins/memory.md, the only cycle-local memory target used.\n- unknown_ts | step=unknown_step | scope=internal endpoint contrast audit; preserve baseline predictions and RPC\n  - summary: (missing summary)\n  - evidence: (missing evidence)\n- unknown_ts | step=unknown_step | scope=unknown_scope\n  - summary: (missing summary)\n  - evidence: (missing evidence)\n- unknown_ts | step=unknown_step | scope=unknown_scope\n  - summary: (missing summary)\n  - evidence: (missing evidence)\n- 2026-11-07T03:03:03.148305+00:00 | step=evaluate | scope=attempt\n  - summary: harness evaluated program_1 exactly once\n  - evidence: combined_score=0.9909514004064053, correct=True; scientific acceptance passed; search metrics (data): {\"combined_score\": 0.9909514004064053, \"control_success_fraction\": 1.0, \"correct\": true, \"failed_episode_fraction\": 0.0, \"mean_absolute_capped_normalized_bias\": 0.6191122046076132, \"mean_capped_normalized_rmse\": 0.8400433426068793}\n- 2026-11-07 | step=idea | scope=idea\n  - summary: Selected Nonbacktracking Two-Hop Regression with Invariant GCV; hypothesis: sparse nonbacktracking two-hop features with deterministic observed-outcome GCV can improve endpoint regression under low-order spillovers. gate=kept; trigger=none; reason=The diagnostic-only attempt and source contract clarify available actions but provide no comparative scientific evidence for promoting or rejecting the proposed estimator family.\n  - evidence: Prior candidate correct=true and combined_score=0.990951400