{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"sed -n '1005,1076p' task/evaluate_final.py; cat scientific-evidence/schemas/artifact-manifest.schema.json; sed -n '1,100p' .codex/skills/write-paper-standalone/scripts/validate_claims.py\"","aggregated_output":"def aggregate(episodes, outcomes, investigation):\n    import numpy as np\n    cases = list(investigation.cases)\n    seeds = SEEDS[:1] if investigation.smoke else SEEDS\n    families = sorted({investigation.cases[name]['family'] for name in cases})\n    weights = {name: 1 / len(families) / sum(investigation.cases[other]['family'] == investigation.cases[name]['family'] for other in cases) for name in cases}\n    records = {(episode['case'], episode['seed'], episode['condition']): outcome for episode, outcome in zip(episodes[:-1], outcomes[:-1])}\n\n    def mean_condition(condition, metric):\n        return sum(weights[name] / len(seeds) * records[name, seed, condition][metric] for name in cases for seed in seeds)\n\n    metrics = {name: 1.0 for name in METRICS}\n    for metric in ('mae', 'rmse', 'spearman', 'kendall_tau_b'):\n        metrics[metric] = mean_condition('primary', metric)\n    metrics['combined_score'] = 1 - metrics['mae']\n    for condition in CONDITIONS[1:]:\n        metrics[condition + '_mae'] = mean_condition(condition, 'mae')\n    deltas = {}\n    paired = True\n    for method in ('uniform', 'source_mean', 'anchor', 'irt'):\n        value = 0.0\n        for name in cases:\n            for seed in seeds:\n                baseline = investigation.baselines.get((name, seed))\n                truth = investigation.pairs[name, seed][1].mean(axis=1)\n                error = 1.0 if baseline is None else float(np.abs(baseline[method] - truth).mean())\n                value += weights[name] / len(seeds) * error\n                if method == 'anchor':\n                    primary = records[name, seed, 'primary']\n                    if baseline is None or primary['predictions'] is None:\n                        paired = False\n                        deltas[name, seed] = None\n                    else:\n                        deltas[name, seed] = (np.abs(primary['predictions'] - truth) - np.abs(baseline[method] - truth)).mean(axis=0)\n        metrics[method + '_mae'] = value\n    metrics['delta_anchor_mae'] = float(sum(weights[name] / len(seeds) * (1.0 if deltas[name, seed] is None else deltas[name, seed].mean()) for name in cases for seed in seeds))\n    metrics['delta_anchor_ci_low'], metrics['delta_anchor_ci_high'] = -1.0, 1.0\n    if paired:\n        random = np.random.default_rng(1729)\n        lineages = sorted({group for pair in investigation.pairs.values() for group in pair[3]})\n        draws = []\n        for repeat in range(1000):\n            seed_indices = random.integers(0, len(seeds), len(seeds))\n            counts = np.bincount(random.integers(0, len(lineages), len(lineages)), minlength=len(lineages))\n            value = 0.0\n            supported = True\n            for name in cases:\n                for seed_index in seed_indices:\n                    seed = seeds[int(seed_index)]\n                    multipliers = np.asarray([counts[lineages.index(group)] for group in investigation.pairs[name, seed][3]])\n                    if multipliers.sum() == 0:\n                        supported = False\n                        break\n                    value += weights[name] / len(seeds) * float(np.average(deltas[name, seed], weights=multipliers))\n            if not supported:\n                draws = []\n                break\n            draws.append(value)\n        if draws:\n            metrics['delta_anchor_ci_low'], metrics['delta_anchor_ci_high'] = map(float, np.quantile(draws, [.025, .975]))\n    replay = outcomes[-1]\n    first = outcomes[0]\n    reset_error = 1.0\n    if replay['success'] and first['success'] and replay['anchors'] == first['anchors']:\n        reset_error = float(np.max(np.abs(replay['predictions'] - first['predictions'])))\n    metrics['reset_mae'] = replay['mae']\n    metrics['reset_max_abs_error'] = reset_error\n    metrics['control_failure_rate'] = (sum(mean_condition(condition, 'control_failure') for condition in ('constant', 'copy', 'permuted')) + float(reset_error > 1e-10)) / 4\n    metrics['missing_episode_rate'] = sum(not outcome['success'] for outcome in outcomes) / len(episodes)\n    correct = all(outcome['success'] and outcome['control_failure'] == 0 for outcome in outcomes) and reset_error <= 1e-10 and investigation.baseline_complete and all(investigation.baselines.get((name, seed)) is not None for name in cases for seed in seeds)\n    metrics['correct'] = int(correct)\n    if set(metrics) != set(METRICS) or not all(type(value) in (int, float) and math.isfinite(value) for value in metrics.values()):\n{\n  \"$id\": \"https://schemas.agentic-scientist.local/scientific-evidence/artifact-manifest.schema.json\",\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"artifact\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"source\",\n            \"derived\",\n            \"manuscript\",\n            \"figure\",\n            \"table\",\n            \"script\",\n            \"log\",\n            \"other\"\n          ],\n          \"type\": \"string\"\n        },\n        \"media_type\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Path to the artifact relative to the scientific-evidence root when possible.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"sha256\": {\n          \"description\": \"Optional hash recorded when the producing workflow computes one.\",\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"kind\"\n      ],\n      \"type\": \"object\"\n    },\n    \"derived_from\": {\n      \"description\": \"Inline @evidence refs or stable ids describing the artifact inputs.\",\n      \"items\": {\n        \"minLength\": 1,\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"type\": \"array\"\n    },\n    \"generated_by\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"command\": {\n          \"items\": {\n            \"minLength\": 1,\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"type\": \"array\"\n        },\n        \"cwd\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"finished_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        },\n        \"script_path\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"script_sha256\": {\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        },\n        \"started_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"script_path\"\n      ],\n      \"type\": \"object\"\n    },\n    \"named_outputs\": {\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"number\",\n          \"integer\",\n          \"boolean\",\n          \"array\",\n          \"object\",\n          \"null\"\n        ]\n      },\n      \"description\": \"Optional machine-readable outputs emitted by the derivation.\",\n      \"type\": \"object\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"schema_name\": {\n      \"const\": \"scientific-evidence.artifact-manifest\"\n    }\n  },\n  \"required\": [\n    \"schema_name\",\n    \"artifact\",\n    \"derived_from\"\n  ],\n  \"title\": \"Scientific Evidence Artifact Manifest\",\n  \"type\": \"object\"\n}\n#!/usr/bin/env python3\n\"\"\"Validate generated claim-grounding artifacts before paper finalization.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nEVIDENCE_REF_RE = re.compile(r\"@evidence\\[\\[[^\\]]+\\]\\]\")\nTEX_INPUT_RE = re.compile(\n    r\"\\\\(?:input|include)(?![A-Za-z@])\\s*\"\n    r\"(?:\\{(?P<braced>[^{}]+)\\}|(?P<unbraced>[^\\s%{}]+))\"\n)\nTEX_IMPORT_COMMAND_RE = re.compile(r\"\\\\(?:input|include)(?![A-Za-z@])\")\nTEX_LOCAL_SUPPORT_RE = re.compile(\n    r\"\\\\(?P<command>usepackage|RequirePackage|documentclass|LoadClass)\"\n    r\"(?![A-Za-z@])(?:\\s*\\[[^\\]]*\\])?\\s*\\{(?P<targets>[^{}]+)\\}\"\n)\nTEX_LOCAL_SUPPORT_COMMAND_RE = re.compile(\n    r\"\\\\(?:usepackage|RequirePackage|documentclass|LoadClass)(?![A-Za-z@])\"\n)\nDYNAMIC_TEX_IMPORT_RE = re.compile(r\"\\\\csname\\s*(?:input|include)\\s*\\\\endcsname\")\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\if[a-zA-Z@]+\\b|\\\\else\\b|\\\\fi\\b\")\nVERBATIM_ENV_RE = re.compile(\n    r\"\\\\begin\\s*\\{(?P<env>verbatim\\*?|lstlisting|minted)\\}.*?\"\n    r\"\\\\end\\s*\\{(?P=env)\\}\",\n    re.DOTALL,\n)\nPROMPT_ARTIFACT_RE = re.compile(r\".+_prompt(?:_round_\\d+(?:_contract_retry_\\d+)?)?\\.md$\")\nGENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\n    \"validation_feedback.json\",\n    \"validation_feedback.md\",\n    \"verification-report.json\",\n}\nROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\"validation_report.json\"}\nGENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES = (\n    \"paper_evidence_audit\",\n)\nEVIDENCE_BUNDLE_DIRNAME = \"scientific-evidence\"\nEVIDENCE_SCAN_SUFFIXES = (\n    \".tex\",\n    \".md\",\n    \".json\",\n    \".yaml\",\n    \".yml\",\n    \".py\",\n    \".sh\",\n    \".r\",\n    \".csv\",\n    \".tsv\",\n)\nEVIDENCE_SKIP_DIR_NAMES = {\n    \".git\",\n    \"__pycache__\",\n    EVIDENCE_BUNDLE_DIRNAME,\n}\nAGENT_SKILL_DIR_PREFIXES = (\n    (\".claude\", \"skills\"),\n    (\".codex\", \"skills\"),\n    (\".cursor\", \"skills\"),\n    (\".opencode\", \"skills\"),\n    (\".gemini\", \"skills\"),\n    (\".pi\", \"agent\", \"skills\"),\n)\nVERIFICATION_SUMMARY_KEYS = (\n    \"total_references\",\n    \"resolved_references\",\n    \"anchored_references\",\n    \"dangling_references\",\n    \"manifests_checked\",\n)\nSCIENTIFIC_EVIDENCE_SCRIPT = (\n    Path(__file__).resolve().parent.parent.parent\n    / \"scientific-evidence\"\n    / \"scripts\"\n    / \"scientific_evidence.py\"\n)\n\n\ndef read_json(path: Path) -> dict[str, Any]:\n    \"\"\"Read JSON data from disk when available.\"\"\"\n    try:\n        payload = json.loads(path.read_text(encoding=\"utf-8\"))\n    except json.JSONDecodeError as exc:\n        raise SystemExit(f\"Invalid JSON in {path}: {exc}\") from exc\n    if not isinstance(payload, dict):\n        raise SystemExit(f\"Expected JSON object in {path}\")\n    return payload\n\n\ndef read_bib_keys(path: Path) -> set[str]:\n","exit_code":0,"status":"completed"}}
