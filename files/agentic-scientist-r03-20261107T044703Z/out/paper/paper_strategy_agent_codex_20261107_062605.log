offset\",\n    \"permuted\": \"actual candidate runs independently deranged historical columns with marginals and missingness preserved; >=2 altered nonconstant columns and disrupted row correspondence; no guaranteed score loss, lack of positive gap prohibits structure attribution, not eligibility\",\n    \"reset\": \"single final replay of first actual episode; legal queries identical and clipped predictions atol1e-10 rtol0\"\n  },\n  \"limits\": {\n    \"max_rows\": 8192,\n    \"max_columns\": 1024,\n    \"chunk_rows\": 256,\n    \"max_chunks\": 32,\n    \"batch_rows\": 128,\n    \"wire_limit\": 67108864,\n    \"state_transfers\": \"train_start + up to32 train_chunk + train_commit; fit separately. No state exports or shared files.\"\n  },\n  \"normalization\": \"Natural [0,1] original main_score / OLL Raw; clip predictions only. No normalization fitted on test.\",\n  \"fit\": \"Masked alternating ridge lambda0.1; ranks1,2,4,8 selected with deterministic 10% historical-cell validation; max4 validation sweeps and8 refit sweeps, capped by requested steps. Ridge lambda from0.01,0.1,1 on historical every5th-row validation. Medoid order descending sum absolute historical imputed correlations. Equal per-method wall allowance; no task.md productive-time floor exists.\",\n  \"runtime\": \"CPython 3.12.15 Linux x86_64 validated; Python>=3.11 supported. NumPy1.26.4 SciPy1.12.0 PyArrow16.1.0. Baselines evaluator-local, one BLAS thread. Candidate<=3 threads; native Landlock ABI>=1 and seccomp x86_64 mandatory; broker isolation mandatory production. Candidate scratch filesystem read-only; all protocol state RAM.\",\n  \"limitations\": [\n    \"Task paper, official latest conference template/checklist, independently read literature and publication claim review remain downstream research deliverables, not generated paper claims.\",\n    \"Conservative naming families may miss cross-namespace lineages; no claim of biological family ground truth.\",\n    \"MTEB comparable columns distinguish dataset revision and default/English subset. Historical validation uses held-out cells rather than nested full model-group CV; this is an initial best-shot operational scaffold.\",\n    \"OpenLLM dataset license is undeclared: public access is not a redistribution license; private research cache only.\",\n    \"Full raw score documents are hashed during acquisition; runtime verifies frozen extracted model-example hashes and acquisition audit, not a live reread of upstream documents. Reproduction must reacquire pinned source.\",\n    \"No interface supplies internals: candidate mechanism attribution requires independent code review, not a state report. No candidate state flags are requested or trusted.\"\n  ],\n  \"production\": {\n    \"cases\": {\n      \"mteb/model/1009\": {\n        \"roster_hash\": \"5317f3b16b1788ea0f535ce1849e06983153a34a779b284ce4fb5a5af37ab6a2\",\n        \"historical_rows\": 177,\n        \"test_rows\": 52,\n        \"columns\": 172,\n        \"checkpoints\": [\n          1,\n          2,\n          4,\n          8\n        ]\n      },\n      \"mteb/model/1013\": {\n        \"roster_hash\": \"4703042bd53d996fe6ac2d94de9e578f895be8afd6eadb163a35ee8be0b2e861\",\n        \"historical_rows\": 177,\n        \"test_rows\": 51,\n        \"columns\": 172,\n        \"checkpoints\": [\n          1,\n          2,\n          4,\n          8\n        ]\n      },\n      \"mteb/model/1019\": {\n        \"roster_hash\": \"f6c64480540046b02f4c90b283c39296c7feba259bd06dd9c5623066e2a5c1f7\",\n        \"historical_rows\": 177,\n        \"test_rows\": 47,\n        \"columns\": 167,\n        \"checkpoints\": [\n          1,\n          2,\n          4,\n          8\n        ]\n      },\n      \"mteb/family/1009\": {\n        \"roster_hash\": \"001c0861aa46332a53208ee0cceaa79d558af8a735270652c5bc28ae98dfa4a3\",\n        \"historical_rows\": 164,\n        \"test_rows\": 58,\n        \"columns\": 156,\n        \"checkpoints\": [\n          1,\n          2