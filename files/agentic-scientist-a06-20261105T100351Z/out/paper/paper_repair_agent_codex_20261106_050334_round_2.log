\": {\"evaluation_scope\": \"sealed_final\", \"id\": \"final.qualification.status\", \"manifest_path\": \"work/results/a06/codex/20261105_100448/final_evaluation/final_manifest.json\", \"program_tree_sha256\": \"sha256:b981d216ace51ed08086b6511ffa25cccddcfdf1093b4751f73b5536a876215c\", \"results_tree_sha256\": \"sha256:1e4fd7ffd26e9fccb45de06f1becbad0bd7d05864f6ca39345415bb18c1cf775\", \"type\": \"final_qualification\", \"value\": \"completed\"}}\n{\"figure_id\": \"reporting_overview\", \"required\": true, \"purpose\": \"Give immediate glance value for the estimand, protected sample, same-winner comparator, and unequal evidential strength of known truth and finite audit.\", \"figure_type\": \"diagram\", \"preferred_generator\": \"generate-concept-figure\", \"group_by\": \"reporting_policy\", \"metric\": \"none; conceptual evidence and data-flow map\", \"split_by\": \"selection/report data roles and synthetic/real targets\", \"preferred_span\": \"full_width\", \"target_width_fraction\": 1.0, \"layout_rationale\": \"paper.sty sets a single 5.5-inch text column and 9-inch text height. Use that full 5.5-inch span on page 1 or 2, approximately 1.6 inches high plus caption (about one fifth page), with at least 9-point final labels. A half-width inset would compress branching data roles; there is no two-column figure* assumption.\", \"allow_progression\": false, \"max_panels\": 1, \"max_panels_per_row\": 1, \"max_categories_per_panel\": 6, \"max_series_per_panel\": 3, \"source_ids\": [\"final.evidence.episodes\", \"study.selection_kind\"], \"implementation_notes\": \"At most six semantic blocks, short node labels, no numerical result decorations, no invented model architecture or adaptive feedback loop. Describe selection/report independence as the intended random-partition design, not an evaluator-certified population property. Require editable draw.io output and regenerate rather than shrink if text exceeds budget.\"}\n{\"figure_id\": \"reporting_error_comparison\", \"required\": true, \"purpose\": \"Compare error while keeping sample size, prompt count, target type, and the strongest counterexample to uniform superiority visible.\", \"figure_type\": \"grouped_point_plot\", \"preferred_generator\": \"matplotlib\", \"group_by\": \"prompt count K=1 or K=16\", \"metric\": \"synthetic: mean squared error to known selected-prompt accuracy; real: squared discrepancy to audit accuracy\", \"split_by\": \"synthetic versus real and n=64 versus n=256\", \"preferred_span\": \"full_width\", \"target_width_fraction\": 1.0, \"layout_rationale\": \"Use 5.5 inches by approximately 2.8 inches plus caption, a 2x2 grid with only two x categories and three series per panel. A single legend and at least 8.5-point rendered labels keep it readable at full text width; half-width is unsuitable. Reserve about two fifths page. Use matched scales within each evidence row or explicitly label any row-specific scale; do not imply identical targets across rows.\", \"allow_progression\": false, \"max_panels\": 4, \"max_panels_per_row\": 2, \"max_categories_per_panel\": 2, \"max_series_per_panel\": 3, \"source_ids\": [\"final.evidence.episodes\", \"final.metric.report_mse\", \"final.metric.reuse_mse\", \"final.metric.full_budget_naive_mse\"], \"implementation_notes\": \"Three series: protected report, selection-score reuse, full-budget reuse. Overlay seed points within those series rather than adding seed legend entries. Means are descriptive across the five retained seeds, with synthetic regimes equally weighted. Do not invent paired-difference standard errors from marginal MSE standard errors; display seed scatter instead. Use a table for the remaining comparators.\"}\n{\"figure_id\": \"real_audit_accuracy_difference\", \"required\": true, \"purpose\": \"Prevent improved reporting from being mistaken for improved selected-prompt accuracy and expose finite-audit uncertainty.\", \"figure_type\": \"horizontal_interval_plot\", \"preferred_generator\": \"matplotlib\", \"group_by\": \"final evaluation seed\", \"metric\": \"selected minus fixed prompt audit accuracy, with paired subject-bootstrap 95% percentile interval\", \"split_by\": \"n=64 versus n=256 at K=16\", \"preferred_span\": \"full_width\", \"target_width_fraction\": 1.0, \"layout_rationale\": \"Use a 5.5-inch-wide two-panel plot approximately 1.8 inches high plus caption (roughly one quarter page), five horizontal seed rows per panel and one interval series. Keep at least 8.5-point labels, shared x limits, and a zero line. Full-width avoids squeezing signed accuracy labels into a narrow inset; in this single-column style full-width equals column width.\", \"allow_progression\": false, \"max_panels\": 2, \"max_panels_per_row\": 2, \"max_categories_per_panel\": 5, \"max_series_per_panel\": 1, \"source_ids\": [\"final.evidence.episodes\"], \"implementation_notes\": \"Point estimates equal detail.target minus detail.fixed[1]; endpoints are detail.paired_subject_bootstrap_interval. All five seeds must appear. The evaluator uses 200 subject-cluster bootstrap draws, and these intervals are not simultaneous or a validation of the bootstrap procedure. K=1 yields the identical prompt and is tabulated rather than using a redundant panel.\"}\nimport argparse\nimport hashlib\nimport json\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport jsonschema\nimport pymupdf\n\n\nROOT = Path(__file__).resolve().parent\nCHECKER = '.codex/skills/validate-paper/scripts/validate_compile_inputs.py'\n\n\ndef run(command):\n    result = subprocess.run(command, cwd=ROOT, text=True, capture_output=True)\n    if result.returncode:\n        raise RuntimeError(' '.join(command) + '\\n' + result.stdout[-2000:] + result.stderr[-2000:])\n    return result.stdout\n\n\ndef compile_paper():\n    commands = [['pdflatex', '-recorder', '-no-shell-escape', '-interaction=nonstopmode', '-halt-on-error', 'paper.tex'],\n                ['bibtex', 'paper'],\n                ['pdflatex', '-recorder', '-no-shell-escape', '-interaction=nonstopmode', '-halt-on-error', 'paper.tex'],\n                ['pdflatex', '-recorder', '-no-shell-escape', '-interaction=nonstopmode', '-halt-on-error', 'paper.tex']]\n    for command in commands:\n        if command[0] == 'bibtex':\n            run([sys.executable, CHECKER, 'bibtex', '--paper-dir', '.', '--aux', 'paper.aux'])\n        run([sys.executable, CHECKER, 'run', '--'] + command)\n    raw = subprocess.run([sys.executable, CHECKER, 'recorder', '--paper-dir', '.', '--fls', 'paper.fls'],\n                         cwd=ROOT, text=True, capture_output=True)\n    recorder = Path('paper.fls').read_text()\n    mappings = []\n    lines = []\n    for line in recorder.splitlines():\n        if line.startswith('INPUT /'):\n            original = Path(line[6:])\n            if original.is_symlink():\n                resolved = original.resolve(strict=True)\n                if not original.samefile(resolved):\n                    raise RuntimeError('Symlink normalization changed the actual file')\n                mappings.append({'original': str(original), 'canonical': str(resolved),\n                                 'sha256': hashlib.sha256(original.read_bytes()).hexdigest()})\n                line = 'INPUT ' + str(resolved)\n        lines.append(line)\n    Path('analysis/canonical_compile_inputs.fls').write_text('\\n'.join(lines) + '\\n')\n    run([sys.executable, CHECKER, 'recorder', '--paper-dir', '.', '--fls', 'analysis/canonical_compile_inputs.fls'])\n    report = {'raw_recorder_returncode': raw.returncode,\n              'raw_recorder_message': (raw.stdout + raw.stderr).strip(),\n              'canonical_recorder_validated': True, 'system_symlink_mappings': mappings,\n              'note': 'The untouched original recorder is paper.fls. Canonical paths identify exactly the same input files.'}\n    Path('analysis/compile_path_resolution.json').write_text(json.dumps(report, indent=2) + '\\n')\n    return report\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--compile', action='store_true')\n    args = parser.parse_args()\n    report = {}\n    if args.compile:\n        report['compile'] = compile_paper()\n    report['sections_citations'] = run([sys.executable, '.codex/skills/validate-paper/scripts/validate_tex_refs.py',\n                                       '--tex', 'paper.tex', '--bib', 'references.bib']).strip()\n    report['claims_evidence'] = run([sys.executable, '.codex/skills/write-paper-standalone/scripts/validate_claims.py',\n                                    '--paper-data', 'paper_data.json', '--references', 'references_provenance.json',\n                                    '--bib', 'references.bib', '--claims', 'claims_grounding.json', '--paper-dir', '.']).strip()\n    manifest = json.loads(Path('figure_manifest.json').read_text())\n    schema = json.loads(Path('.codex/skills/validate-paper/templates/figure_manifest.schema.json').read_text())\n    jsonschema.validate(manifest, schema)\n    strategy = json.loads(Path('paper_strategy.json').read_text())\n    by_id = {figure['figure_id']: figure for figure in manifest['figures']}\n    for spec in strategy['figure_specs']:\n        figure = by_id[spec['figure_id']]\n        for actual, limit in [('n_panels', 'max_panels'), ('panels_per_row', 'max_panels_per_row')]:\n            if figure[actual] > spec[limit]:\n                raise RuntimeError(f'Figure density exceeds {limit}')\n        for actual, limit in [('categories_per_panel', 'max_categories_per_panel'), ('series_per_panel', 'max_series_per_panel')]:\n            if max(figure[actual]) > spec[limit]:\n                raise RuntimeError(f'Figure density exceeds {limit}')\n        for field in ['path_png', 'path_pdf', 'prompt_log_path']:\n            if field in figure and not Path(figure[field]).is_file():\n                raise RuntimeError('Missing figure artifact: ' + figure[field])\n    tex = Path('paper.tex').read_text()\n    included = set(re.findall(r'\\\\includegraphics(?:\\[[^\\]]*\\])?\\{([^}]+)\\}', tex))\n    declared = {figure[field] for figure in manifest['figures'] for field in ['path_png', 'path_pdf'] if field in figure}\n    if not included.issubset(declared):\n        raise RuntimeError('Unregistered figure references')\n    report['figure_schema_and_strategy_budgets'] = 'passed'\n    evidence = json.loads(Path('paper_data.json').read_text())\n    actual_hash = hashlib.sha256(Path('source_evidence/evaluate_final.py').read_bytes()).hexdigest()\n    if actual_hash != evidence['final_evaluation']['evaluator_sha256'].removeprefix('sha256:'):\n        raise RuntimeError('Evaluator source digest mismatch')\n    if Path('source_evidence/downstream/program/src/program.py').read_bytes() != Path('source_evidence/downstream/baseline/src/program.py').read_bytes():\n        raise RuntimeError('Retained policy differs from preserved baseline')\n    report['source_identity_checks'] = 'passed for evaluator file and preserved policy bytes only'\n    reference_keys = set(re.findall(r'@\\w+\\{([^,]+),', Path('references.bib').read_text()))\n    if not 25 <= len(reference_keys) <= 30:\n        raise RuntimeError('Reference budget not satisfied')\n    report['reference_count'] = len(reference_keys)\n    document = pymupdf.open('paper.pdf')\n    body_pages = None\n    for index, page in enumerate(document):\n        text = page.get_text()\n        if re.search(r'\\bREFERENCES\\b', text):\n            body_pages = index\n            break\n    if body_pages is None or not 8 <= body_pages <= 9:\n        raise RuntimeError(f'Body-page budget failed: {body_pages}')\n    page = document[body_pages - 1]\n    spans = [span for block in page.get_text('dict')['blocks'] if 'lines' in block\n             for line in block['lines'] for span in line['spans']\n             if span['bbox'][0] >= 106 and 75 <= span['bbox'][1] < 728 and span['bbox'][3] < 733]\n    bounds = [min(span['bbox'][1] for span in spans), max(span['bbox'][3] for span in spans)]\n    occupancy = (bounds[1] - bounds[0]) / (9 * 72)\n    if body_pages == 8 and occupancy < 0.75:\n        raise RuntimeError(f'Final-body-page geometric occupancy too low: {occupancy}')\n    report['body_pages'] = body_pages\n    report['last_body_page_text_bounds_pt'] = bounds\n    report['last_body_page_geometric_vertical_occupancy'] = occupancy\n    report['page_measurement_note'] = 'Local rendered geometric check, not the unavailable parent orchestrator verdict.'\n    text = '\\n'.join(page.get_text() for page in document)\n    text = re.sub(r'source[ _]evidence/downstream/\\s*program/src/program.py', '', text)\n    forbidden = ['idea', 'ideas', 'program', 'programs', 'attempt', 'attempts', 'eligible',\n                 'worker_01', 'worker_02', 'combined_score', 'rubric']\n    leaks = [word for word in forbidden if re.search(r'\\b' + re.escape(word) + r'\\b', text, re.I)]\n    if leaks:\n        raise RuntimeError('Visible pipeline language: ' + ', '.join(leaks))\n    if 'undefined' in Path('paper.log').read_text():\n        raise RuntimeError('Undefined LaTeX references remain')\n    report['visible_language_and_resolved_citations'] = 'passed'\n    report['rendered_supplement'] = run([sys.executable, '.codex/skills/validate-paper/scripts/validate_rendered_si.py', '--pdf', 'paper.pdf']).strip()\n    report['overview_status'] = 'orchestrator-owned placeholder' if not Path('.concept_figure_complete').exists() else 'rendered by orchestrator'\n    Path('analysis/local_validation.json').write_text(json.dumps(report, indent=2) + '\\n')\n    print(json.dumps(report, indent=2))\n\n\nif __name__ == '__main__':\n    main()\nimport csv\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n\nROOT = Path(__file__).resolve().parent\nplt.rcParams.update({'font.size': 9, 'axes.labelsize': 9, 'axes.titlesize': 9,\n                     'xtick.labelsize': 8.5, 'ytick.labelsize': 8.5,\n                     'legend.fontsize': 8.5, 'font.family': 'DejaVu Sans',\n                     'axes.spines.top': False, 'axes.spines.right': False,\n                     'pdf.fonttype': 42})\nCOLORS = ['#147D92', '#C45B26', '#635A9B']\nMETHODS = ['report_mse', 'reuse_mse', 'full_budget_naive_mse',\n           'honest_half_mse', 'fixed_prompt_mse', 'random_prompt_mse']\n\n\ndef write_json(path, data):\n    Path(path).write_text(json.dumps(data, indent=2) + '\\n')\n\n\ndef provenance(path, kind='derived'):\n    write_json(str(path) + '.prov.json', {\n        'schema_name': 'scientific-evidence.artifact-manifest',\n        'artifact': {'path': str(path), 'kind': kind,\n                     'sha256': hashlib.sha256(Path(path).read_bytes()).hexdigest()},\n        'derived_from': ['@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]',\n                         '@evidence[[source_evidence/evaluate_final.py#L746]]'],\n        'generated_by': {'script_path': 'build_artifacts.py',\n                         'command': ['python', 'build_artifacts.py']}})\n\n\ndef save_figure(figure, figure_id):\n    for extension in ['pdf', 'png']:\n        path = Path('figures') / (figure_id + '.' + extension)\n        figure.savefig(path, dpi=300, bbox_inches='tight', pad_inches=0.025)\n        provenance(path, 'figure')\n    plt.close(figure)\n\n\ndef manifest_entry(figure_id, figure_type, panels, rows, categories, series):\n    return {'figure_id': figure_id, 'figure_type': figure_type,\n            'path_pdf': f'figures/{figure_id}.pdf', 'path_png': f'figures/{figure_id}.png',\n            'generator': 'matplotlib', 'n_panels': panels, 'panels_per_row': rows,\n            'categories_per_panel': categories, 'series_per_panel': series,\n            'max_label_chars': 35, 'font_sizes': {'title': 9, 'axis': 9, 'ticks': 8.5, 'legend': 8.5},\n            'uses_abbrev_labels': True, 'uses_progression': False,\n            'placement': 'full_width', 'intended_latex_width_fraction': 1.0,\n            'estimated_min_rendered_font_pt': 8.5,\n            'source_ids': ['final.evidence.episodes']}\n\n\ndef main():\n    Path('figures').mkdir(exist_ok=True)\n    Path('tables').mkdir(exist_ok=True)\n    Path('analysis').mkdir(exist_ok=True)\n    # @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    paper_data = json.loads(Path('paper_data.json').read_text())\n    episodes = paper_data['final_evaluation']['evaluation_evidence']['episodes']\n    cases = [{**case, 'seed': episode['seed']} for episode in episodes for case in episode['solution']['cases']]\n    labels = [case['case'] for case in episodes[0]['solution']['cases']]\n    means = {label: {metric: float(np.mean([case['metrics'][metric] for case in cases if case['case'] == label]))\n                     for metric in cases[0]['metrics']} for label in labels}\n    regimes = {}\n    for regime in range(len(cases[0]['details'])):\n        regimes[str(regime)] = {}\n        for label in [label for label in labels if label.startswith('S')]:\n            regimes[str(regime)][label] = {metric: float(np.mean([case['details'][regime]['metrics'][metric]\n                                                                for case in cases if case['case'] == label]))\n                                          for metric in cases[0]['metrics']}\n    audit = [{ 'seed': case['seed'], 'case': case['case'],\n               'difference': case['details'][0]['target'] - case['details'][0]['fixed'][1],\n               'interval': case['details'][0]['paired_subject_bootstrap_interval'],\n               'target': case['details'][0]['target'], 'fixed': case['details'][0]['fixed'][1]}\n             for case in cases if case['case'].startswith('R')]\n    summary = {'condition_means': means, 'regime_means': regimes, 'audit_differences': audit,\n               'episode_durations_seconds': [episode['duration_seconds'] for episode in episodes],\n               'duration_sum_seconds': sum(episode['duration_seconds'] for episode in episodes),\n               'reductions_percent': {label: 100 * (1 - means[label]['report_mse'] / means[label]['reuse_mse'])\n                                      for label in labels},\n    figure.legend(handles, legend_labels, loc='upper center', ncol=3, frameon=False, bbox_to_anchor=(0.52, 1.03))\n    figure.tight_layout(pad=0.6, rect=(0, 0, 1, 0.94))\n    save_figure(figure, 'reporting_error_comparison')\n    figure, axes = plt.subplots(1, 2, figsize=(5.5, 1.95), sharex=True, sharey=True)\n    for axis, size in zip(axes, [64, 256]):\n        observations = [value for value in audit if value['case'] == f'R{size}K16']\n        for row, value in enumerate(observations):\n            axis.plot(np.array(value['interval']) * 100, [row, row], color=COLORS[0], linewidth=1.5)\n            axis.scatter(value['difference'] * 100, row, color=COLORS[0], s=20, zorder=3)\n        axis.axvline(0, color='0.5', linestyle='--', linewidth=0.8)\n        axis.set_title(f'n={size}, K=16')\n        axis.set_yticks(range(len(observations)), [str(value['seed']) for value in observations])\n        axis.set_xlabel('Selected − fixed (pp)')\n        axis.set_xlim(-4.5, 9.5)\n        axis.set_xticks([-4, 0, 4, 8])\n        axis.grid(axis='x', alpha=0.2)\n    axes[0].set_ylabel('Seed')\n    axes[0].invert_yaxis()\n    figure.tight_layout(pad=0.5)\n    save_figure(figure, 'real_audit_accuracy_difference')\n    concept = Path('figures/reporting_overview.png')\n    prompt_log = Path('figures/reporting_overview.prompts.json')\n    if not Path('.concept_figure_complete').exists() and not concept.exists():\n        figure = plt.figure(figsize=(8, 2.3))\n        figure.text(0.5, 0.5, 'Selection and reporting overview', ha='center', va='center', fontsize=14)\n        figure.savefig(concept, dpi=300, facecolor='white')\n        plt.close(figure)\n    if not prompt_log.exists():\n        write_json(prompt_log, {})\n    entries = [manifest_entry('reporting_error_comparison', 'composite', 4, 2, [2]*4, [3]*4),\n               manifest_entry('real_audit_accuracy_difference', 'composite', 2, 2, [5]*2, [1]*2)]\n    overview = manifest_entry('reporting_overview', 'diagram', 1, 1, [6], [3])\n    overview.pop('path_pdf')\n    overview.update(generator='generate-concept-figure', prompt_log_path=str(prompt_log),\n                    max_label_chars=38, estimated_min_rendered_font_pt=9)\n    write_json('figure_manifest.json', {'figures': [overview] + entries})\n    content = ['% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]',\n               r'\\begin{tabular}{llrrrrrr}\\toprule',\n               r'Setting & $(n,K)$ & Protected & Reuse & Full & Half & Fixed & Random\\\\\\midrule']\n    for label in labels:\n        family, numbers = ('Synthetic' if label.startswith('S') else 'Real audit'), label[1:].split('K')\n        content.append(f'{family} & ({numbers[0]},{numbers[1]}) & ' + ' & '.join(f'{means[label][metric]*1000:.3f}' for metric in METHODS) + r'\\\\')\n    content.append(r'\\bottomrule\\end{tabular}')\n    Path('tables/main_results.tex').write_text('\\n'.join(content) + '\\n')\n    provenance('tables/main_results.tex', 'table')\n    content = ['% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]',\n               r'\\begin{tabular}{llrrrr}\\toprule',\n               r'Truth & Coupling & Bias (pp) & Optimism (pp) & Coverage & Width\\\\\\midrule']\n    for regime in range(4):\n        values = [regimes[str(regime)][label] for label in ['S64K16', 'S256K16']]\n        content.append(f'{\"Equal\" if regime < 2 else \"Graded\"} & {\"Low\" if regime % 2 == 0 else \"High\"} & ' +\n                       ' & '.join(f'{np.mean([value[metric] for value in values])*scale:.3f}' for metric, scale in\n                                  [('report_bias', 100), ('signed_optimism', 100), ('coverage', 1), ('interval_width', 1)]) + r'\\\\')\n    content.append(r'\\bottomrule\\end{tabular}')\n    Path('tables/synthetic_regimes.tex').write_text('\\n'.join(content) + '\\n')\n    provenance('tables/synthetic_regimes.tex', 'table')\n    content = ['% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]',\n               r'\\begin{longtable}{rrlrrrrrr}\\toprule',\n               r'Seed & $n$ & Setting & $K$ & Report & Reuse & Target & Cov. & Width\\\\\\midrule\\endhead']\n    for case in cases:\n        label, metrics = case['case'], case['metrics']\n        size, arms = label[1:].split('K')\n        content.append(f'{case[\"seed\"]} & {size} & {\"Synth.\" if label.startswith(\"S\") else \"Real\"} & {arms} & ' +\n                       ' & '.join(f'{metrics[metric]*scale:.4f}' for metric, scale in [('report_mse', 1000), ('reuse_mse', 1000), ('selected_accuracy', 1), ('coverage', 1), ('interval_width', 1)]) + r'\\\\')\n    content.append(r'\\bottomrule\\end{longtable}')\n    Path('tables/seed_results.tex').write_text('\\n'.join(content) + '\\n')\n    provenance('tables/seed_results.tex', 'table')\n    print(json.dumps(summary['condition_means'], indent=2))\n\n\nif __name__ == '__main__':\n    main()\n{\n  \"$defs\": {\n    \"FigureFontSizes\": {\n      \"additionalProperties\": false,\n      \"description\": \"Explicit font sizes for the legacy manifest contract.\",\n      \"properties\": {\n        \"axis\": {\n          \"title\": \"Axis\",\n          \"type\": \"number\"\n        },\n        \"legend\": {\n          \"title\": \"Legend\",\n          \"type\": \"number\"\n        },\n        \"ticks\": {\n          \"title\": \"Ticks\",\n          \"type\": \"number\"\n        },\n        \"title\": {\n          \"title\": \"Title\",\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"title\",\n        \"axis\",\n        \"ticks\",\n        \"legend\"\n      ],\n      \"title\": \"FigureFontSizes\",\n      \"type\": \"object\"\n    },\n    \"LegacyFigureManifestFigure\": {\n      \"additionalProperties\": false,\n      \"allOf\": [\n        {\n          \"else\": {\n            \"properties\": {\n              \"path_pdf\": {\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"path_pdf\"\n            ]\n          },\n          \"if\": {\n            \"anyOf\": [\n              {\n                \"properties\": {\n                  \"generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  }\n                },\n                \"required\": [\n                  \"generator\"\n                ]\n              },\n              {\n                \"properties\": {\n                  \"attempted_generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  },\n                  \"fallback_reason\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  },\n                  \"generator\": {\n                    \"type\": \"null\"\n                  },\n                  \"prompt_log_path\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"generator\",\n                  \"attempted_generator\",\n                  \"prompt_log_path\",\n                  \"fallback_reason\"\n                ]\n              }\n            ]\n          }\n        }\n/usr/bin/pdflatex\n/opt/autoillustrate-venv\n/opt/drawio\n/opt/headless\n","exit_code":1,"status":"failed"}}
