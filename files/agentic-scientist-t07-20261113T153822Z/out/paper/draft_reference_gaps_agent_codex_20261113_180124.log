70,\n title = {Asymptotic Properties of Conditional Maximum-Likelihood Estimators},\n author = {Erling Bernhard Andersen},\n year = {1970},\n howpublished = {Journal of the Royal Statistical Society Series B (Statistical Methodology)},\n doi = {10.1111/j.2517-6161.1970.tb00842.x}\n}\n\n@misc{Dempster1977,\n title = {Maximum Likelihood from Incomplete Data Via the EM Algorithm},\n author = {A. P. Dempster and Nan M. Laird and Donald B. Rubin},\n year = {1977},\n howpublished = {Journal of the Royal Statistical Society Series B (Statistical Methodology)},\n doi = {10.1111/j.2517-6161.1977.tb01600.x}\n}\n\n@misc{Hastie2009,\n title = {The Elements of Statistical Learning},\n author = {Trevor J. Hastie and Robert John Tibshirani and Jerome H. Friedman},\n year = {2009},\n howpublished = {Springer series in statistics},\n doi = {10.1007/978-0-387-84858-7}\n}\n\n@misc{Bishop2006,\n title = {Pattern Recognition and Machine Learning},\n author = {Chris Bishop},\n year = {2006},\n howpublished = {Springer eBooks},\n doi = {10.1007/978-0-387-45528-0}\n}\n\n@misc{Efron1979,\n title = {Bootstrap Methods: Another Look at the Jackknife},\n author = {Bradley Efron},\n year = {1979},\n howpublished = {The Annals of Statistics},\n doi = {10.1214/aos/1176344552}\n}\n\n@misc{Rubin1976,\n title = {Inference and Missing Data},\n author = {Donald B. Rubin},\n year = {1976},\n howpublished = {Biometrika},\n doi = {10.1093/biomet/63.3.581}\n}\n\n@misc{Little2019,\n title = {Statistical Analysis with Missing Data},\n author = {Roderick J. A. Little and Donald B. Rubin},\n year = {2002},\n howpublished = {Wiley series in probability and statistics},\n doi = {10.1002/9781119013563}\n}\n\n@misc{Roberts2017,\n title = {Cross‐validation strategies for data with temporal, spatial, hierarchical, or phylogenetic structure},\n author = {David R. Roberts and Volker Bahn and Simone Ciuti and Mark S. Boyce and Jane Elith and Gurutzeta Guillera‐Arroita and Severin Hauenstein and José Joaquín Lahoz‐Monfort and Boris Schröder and Wilfried Thuiller and David I. Warton and Brendan Anthony Wintle and Florian Hartig and Carsten F. Dormann},\n year = {2016},\n howpublished = {Ecography},\n doi = {10.1111/ecog.02881}\n}\n\n@misc{Varma2006,\n title = {Bias in error estimation when using cross-validation for model selection},\n author = {Sudhir Varma and Richard M Simon},\n year = {2006},\n howpublished = {BMC Bioinformatics},\n doi = {10.1186/1471-2105-7-91}\n}\n\n@misc{Arlot2010,\n title = {A survey of cross-validation procedures for model selection},\n author = {Sylvain Arlot and Alain Célisse},\n year = {2010},\n howpublished = {Statistics Surveys},\n doi = {10.1214/09-SS054}\n}\n\n@misc{Stone1974,\n title = {Cross-Validatory Choice and Assessment of Statistical Predictions},\n author = {M. Stone},\n year = {1974},\n howpublished = {Journal of the Royal Statistical Society Series B (Statistical Methodology)},\n doi = {10.1111/j.2517-6161.1974.tb00994.x}\n}\n\n@misc{Kendall1938,\n title = {A NEW MEASURE OF RANK CORRELATION},\n author = {Maurice G. Kendall},\n year = {1938},\n howpublished = {Biometrika},\n doi = {10.1093/biomet/30.1-2.81}\n}\n\n@misc{Spearman1904,\n title = {The Proof and Measurement of Association between Two Things},\n author = {C. Spearman},\n year = {1904},\n howpublished = {The American Journal of Psychology},\n doi = {10.2307/1412159}\n}\n\n@misc{BenDavid2010,\n title = {A theory of learning from different domains},\n author = {Shai Ben-David and John C. Blitzer and Koby Crammer and Alex Kulesza and Fernando M. B. Pereira and Jennifer Wortman Vaughan},\n year = {2009},\n howpublished = {Machine Learning},\n doi = {10.1007/s10994-009-5152-4}\n}\n\n@misc{Brier1950,\n title = {VERIFICATION OF FORECASTS EXPRESSED IN TERMS OF PROBABILITY},\n author = {Glenn W. Brier},\n year = {1950},\n howpublished = {Monthly Weather Review},\n doi = {10.1175/1520-0493(1950)078<0001:VOFEIT>2.0.CO;2}\n}\n","exit_code":0,"status":"completed"}}
