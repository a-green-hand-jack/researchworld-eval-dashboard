iginal).sum()/(count*(count-1)))\n        ds.append(np.mean(d))\n    means=np.array(means); aggregates.append(.5*means[0]+.5*np.mean(means[1:],axis=0)); displacements.append(.5*ds[0]+.5*np.mean(ds[1:]))\nprint('\"'All 18 supplementary table rows, 54 disruption values, 54 percentile intervals, and controls match evidence.')\nprint('Aggregates:',dict(zip(['combined_score']+ms,np.mean(aggregates,axis=0)))); print('Displacement:',np.mean(displacements))\nfor key,value in intervals_positive.items(): print('Positive interval:',key,value)\nfor index,c in enumerate(es[0]['solution']['cases']):\n    for m in ms:\n        base=np.mean([e['solution']['cases'][index]['baseline_curves'][m] for e in es],axis=0)\n        for budget,(guided,control) in enumerate(zip(c['candidate_curves'],base)):\n            if guided<=control: ties.append((c['case'],m,budget,guided,control))\nprint('Non-strictly-favored plotted cells:',ties)\nprint('No downstream_study present:', 'downstream_study' not in p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
