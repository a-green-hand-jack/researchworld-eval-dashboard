"max_label_chars\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Max Label Chars\"\n        },\n        \"min_font_size_pt\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Min Font Size Pt\"\n        },\n        \"note\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Note\"\n        },\n        \"panel_count\": {\n          \"exclusiveMinimum\": 0,\n          \"title\": \"Panel Count\",\n          \"type\": \"integer\"\n        },\n        \"panels\": {\n          \"items\": {\n            \"$ref\": \"#/$defs/RichFigurePanel\"\n          },\n          \"title\": \"Panels\",\n          \"type\": \"array\"\n        },\n        \"panels_per_row\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Panels Per Row\"\n        },\n        \"placement\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"column\",\n                \"full_width\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Placement\"\n        },\n        \"prompt_log_path\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Prompt Log Path\"\n        },\n        \"required\": {\n          \"anyOf\": [\n            {\n              \"type\": \"boolean\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Required\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"uses_abbrev_labels\": {\n          \"anyOf\": [\n            {\n              \"type\": \"boolean\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Uses Abbrev Labels\"\n        },\n        \"uses_progression\": {\n          \"title\": \"Uses Progression\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"figure_id\",\n        \"figure_type\",\n        \"files\",\n        \"panel_count\",\n        \"panels\",\n        \"uses_progression\"\n      ],\n      \"title\": \"RichFigureManifestFigure\",\n      \"type\": \"object\"\n    },\n    \"RichFigurePanel\": {\n      \"additionalProperties\": false,\n      \"description\": \"Panel-level metadata for the richer manifest shape.\",\n      \"properties\": {\n        \"categories\": {\n          \"anyOf\": [\n            {\n              \"items\": {\n                \"type\": \"string\"\n              },\n              \"type\": \"array\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Categories\"\n        },\n        \"category_count\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Category Count\"\n        },\n        \"content\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Content\"\n        },\n        \"label\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Label\"\n        },\n        \"metric\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Metric\"\n        },\n        \"panel_id\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Panel Id\"\n        },\n        \"series_count\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Series Count\"\n        },\n        \"task\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Task\"\n        },\n        \"threshold\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Threshold\"\n        },\n        \"y_range\": {\n          \"anyOf\": [\n            {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"type\": \"array\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Y Range\"\n        }\n      },\n      \"title\": \"RichFigurePanel\",\n      \"type\": \"object\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"description\": \"Top-level figure-manifest document.\",\n  \"properties\": {\n    \"figures\": {\n      \"items\": {\n        \"anyOf\": [\n          {\n            \"$ref\": \"#/$defs/LegacyFigureManifestFigure\"\n          },\n          {\n            \"$ref\": \"#/$defs/RichFigureManifestFigure\"\n          }\n        ]\n      },\n      \"minItems\": 1,\n      \"title\": \"Figures\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"figures\"\n  ],\n  \"title\": \"FigureManifestDocument\",\n  \"type\": \"object\"\n}\n","exit_code":0,"status":"completed"}}
