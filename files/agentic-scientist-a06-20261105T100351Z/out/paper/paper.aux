\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Error depends on selection multiplicity, question budget, and reference. Large markers show means over evaluation seeds; small dots show each seed, horizontally offset for visibility. Synthetic values average regimes and replicates; real values are discrepancies to finite audits. Vertical scales are shared within each row, not across evidence families. Protected versus selection reuse holds the prompt fixed; full reuse may select a different prompt. Values are multiplied by $10^3$.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:errors}{{2}{5}{Error depends on selection multiplicity, question budget, and reference. Large markers show means over evaluation seeds; small dots show each seed, horizontally offset for visibility. Synthetic values average regimes and replicates; real values are discrepancies to finite audits. Vertical scales are shared within each row, not across evidence families. Protected versus selection reuse holds the prompt fixed; full reuse may select a different prompt. Values are multiplied by $10^3$}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Results}{5}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Reporting Error Depends on the Comparator}{5}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Mean error $\times 10^3$ across seeds. Synthetic entries use known truth; real entries use finite audit accuracy. Reuse means same-winner selection-score reuse; Full selects and reports on all questions; Half is the alternative protected split. Fixed and Random also use all questions. Different selectors can have different targets, so this is not a ranking of answer accuracy.}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:main}{{1}{6}{Mean error $\times 10^3$ across seeds. Synthetic entries use known truth; real entries use finite audit accuracy. Reuse means same-winner selection-score reuse; Full selects and reports on all questions; Half is the alternative protected split. Fixed and Random also use all questions. Different selectors can have different targets, so this is not a ranking of answer accuracy}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Known-truth diagnostic means for $K=16$, equally weighting seeds and $n=64,256$. Bias is protected-report minus truth; optimism is selection reuse minus truth. Coupling is the shared-branch probability in Equation~\ref {eq:synthetic}. Coverage and interval width refer to the protected Wilson interval. Percentage points (pp) are used only for the two signed errors.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:regimes}{{2}{6}{Known-truth diagnostic means for $K=16$, equally weighting seeds and $n=64,256$. Bias is protected-report minus truth; optimism is selection reuse minus truth. Coupling is the shared-branch probability in Equation~\ref {eq:synthetic}. Coverage and interval width refer to the protected Wilson interval. Percentage points (pp) are used only for the two signed errors}{table.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Dependence Modulates Optimism, Not the Meaning of Protection}{6}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Finite-Audit Evidence Does Not Establish an Accuracy Gain}{6}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Selected-minus-fixed audit accuracy for each seed at $K=16$. Points use paired outcomes on the same audit; lines are the recorded subject-bootstrap percentile intervals. Zero is included in eight of the ten intervals. Both positive exclusions occur for seed $5059$, not independent benchmark replications. Intervals are descriptive, not simultaneous, and do not quantify population coverage of the reporting rule.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:audit}{{3}{7}{Selected-minus-fixed audit accuracy for each seed at $K=16$. Points use paired outcomes on the same audit; lines are the recorded subject-bootstrap percentile intervals. Zero is included in eight of the ten intervals. Both positive exclusions occur for seed $5059$, not independent benchmark replications. Intervals are descriptive, not simultaneous, and do not quantify population coverage of the reporting rule}{figure.caption.9}{}}
