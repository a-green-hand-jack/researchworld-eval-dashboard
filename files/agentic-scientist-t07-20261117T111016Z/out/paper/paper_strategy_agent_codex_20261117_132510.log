eline = Worker([interpreter, '-I', str(Path(__file__).resolve()), '--baseline_worker',\n973:                           source_weights=data['source_weights'].tolist(), target_groups=data['target_groups'].tolist(),\n975:            baseline_end = min(work_deadline, time.monotonic()+4*work_seconds+2)\n978:                    value = baseline.exchange(payload, timeout=timeout)\n981:                        status = baseline.process.wait(timeout=.2)\n984:                    category = 'baseline_timeout' if status == 124 else 'baseline_signal' if status is not None and status < 0 else 'baseline_exit' if status else 'baseline_result_failure'\n985:                    fail_required_baseline(category, lambda: baseline.close(failed=True), baseline_failure)\n987:                        or set(value['metrics']) != set(baseline_metrics)):\n988:                    raise RuntimeError('invalid baseline result')\n991:                        raise RuntimeError('invalid baseline metric')\n993:                    status = baseline.process.wait(timeout=min(.5, max(.001, timeout)))\n995:                    raise RuntimeError('baseline did not terminate') from error\n997:                    fail_required_baseline('baseline_signal' if status < 0 else 'baseline_exit',\n998:                                           lambda: baseline.close(failed=True), baseline_failure)\n1000:                    if name not in baseline_metrics or len(predictions) != len(budgets):\n1001:                        raise RuntimeError('invalid baseline predictions')\n1004:                            raise RuntimeError('invalid baseline predictions')\n1007:                            raise RuntimeError('baseline metric mismatch')\n1009:            computed = collect_required_baseline(result, deadline=baseline_end, clock=time.monotonic,\n1010:                cancel_work=lambda: baseline.close(failed=True), record_failure=baseline_failure)\n1011:            baseline_metrics = computed['metrics']\n1013:                solution['baseline_predictions'] = {name: values[index] for name, values in computed['predictions'].items()}\n1017:        aggregate.update({name: sum(values)/len(values) for name, values in baseline_metrics.items()})\n1032:        if baseline:\n1034:                baseline.close(failed=primary is not None)\n1040:def aggregate_results(episodes, outcomes, complete):\n1041:    normal = [value for episode, value in zip(episodes, outcomes) if episode['condition'] == 'normal' and not episode['replay']]\n1043:              for name in ('mae', 'rmse', 'spearman', 'kendall', 'uniform_mae', 'prior_mae', 'anchor_mae', 'irt_mae')}\n1045:    first, replay = outcomes[0]['solution'], outcomes[-1]['solution']\n1046:    replay_matches = first is not None and replay is not None and len(first) == len(replay)\n1047:    if replay_matches:\n1048:        replay_matches = all(reference['items'] == repeated['items']\n1052:            for reference, repeated in zip(first, replay))\n1053:    controls &= replay_matches\n\"\"\"Source-only score-targeted design and all-query score regression.\"\"\"\n\nimport numpy as np\n\n\ndef fit_score_model(source_matrix, source_weights):\n    source_matrix = np.asarray(source_matrix, dtype=np.float64)\n    source_weights = np.asarray(source_weights, dtype=np.float64)\n    if (source_matrix.ndim != 2 or source_weights.shape != (source_matrix.shape[0],)\n            or not np.all(np.isfinite(source_weights))\n            or np.any(source_weights < 0) or source_weights.sum() <= 0):\n        raise ValueError('invalid source weights or matrix')\n    row_order = sorted(range(source_matrix.shape[0]),\n                       key=lambda index: (source_matrix[index].tobytes(),\n                                          float(source_weights[index])))\n    source_matrix = source_matrix[row_order]\n    source_weights = source_weights[row_order]\n    source_weights = source_weights / source_weights.sum()\n    source_item_means = source_weights @ source_matrix\n    source_full_scores = source_matrix.mean(axis=1)\n    source_score_mean = float(source_weights @ source_full_scores)\n    weighted_responses = np.sqrt(source_weights)[:, None] * (source_matrix - source_item_means)\n    weighted_scores = np.sqrt(source_weights) * (source_full_scores - source_score_mean)\n    score_covariance = weighted_responses.T @ weighted_scores\n    item_variance = np.einsum('ij,ij->j', weighted_responses, weighted_responses)\n    return dict(source_item_means=source_item_means,\n                source_score_mean=source_score_mean,\n                weighted_responses=weighted_responses,\n                score_covariance=score_covariance, item_variance=item_variance,\n                cross_covariance_cache={})\n\n\ndef select_score_path(model, item_groups, max_budget, ridge):\n    item_groups = np.asarray(item_groups)\n    weighted_responses = model['weighted_responses']\n    score_covariance = model['score_covariance']\n    item_variance = model['item_variance']\n    if not np.isfinite(ridge) or ridge <= 0:\n        raise ValueError('ridge must be positive')\n    if not 0 <= max_budget <= np.unique(item_groups).size:\n        raise ValueError('invalid design size')\n    selection_order = []\n    used_content_mask = np.zeros(item_groups.size, dtype=bool)\n    cross_columns = np.empty((item_groups.size, max_budget), dtype=np.float64)\n    for prefix_size in range(max_budget):\n        if not selection_order:\n            conditional_score_covariance = score_covariance.copy()\n            conditional_item_variance = item_variance + ridge\n        else:\n            selected_cross_covariance = cross_columns[:, :prefix_size]\n            selected_covariance = selected_cross_covariance[selection_order].copy()\n            selected_covariance = (selected_covariance + selected_covariance.T) * 0.5\n            selected_covariance += ridge * np.eye(prefix_size)\n            selected_score_covariance = score_covariance[selection_order]\n            conditional_score_covariance = score_covariance - selected_cross_covariance @ np.linalg.solve(selected_covariance, selected_score_covariance)\n            conditional_item_variance = item_variance + ridge - np.einsum('ij,ji->i', selected_cross_covariance, np.linalg.solve(selected_covariance, selected_cross_covariance.T))\n        selection_gain = conditional_score_covariance ** 2 / np.maximum(conditional_item_variance, 1e-12)\n        selection_gain[used_content_mask] = -np.inf\n        selected_item = int(np.argmax(selection_gain))\n        if not np.isfinite(selection_gain[selected_item]):\n            raise ValueError('no legal finite acquisition')\n        selection_order.append(selected_item)\n        used_content_mask |= item_groups == item_groups[selected_item]\n        if prefix_size + 1 < max_budget:\n            cache = model['cross_covariance_cache']\n            if selected_item not in cache:\n                cache[selected_item] = weighted_responses.T @ weighted_responses[:, selected_item]\n            cross_columns[:, prefix_size] = cache[selected_item]\n    selection_order = np.asarray(selection_order, dtype=int)\n    for budget in range(max_budget + 1):\n        query_items = selection_order[:budget]\n        assert np.unique(item_groups[query_items]).size == budget\n    return selection_order\n\n\ndef predict_score(model, query_items, target_answers, ridge, blend_weight):\n    query_items = np.asarray(query_items, dtype=int)\n    target_answers = np.asarray(target_answers, dtype=np.float64)\n    if target_answers.ndim != 2 or target_answers.shape[1] != query_items.size:\n        raise ValueError('invalid answer shape')\n    source_item_means = model['source_item_means']\n    source_score_mean = model['source_score_mean']\n    if query_items.size == 0:\n        return np.full(target_answers.shape[0], source_score_mean, dtype=np.float64)\n    target_answers, history_inverse = np.unique(target_answers, axis=0, return_inverse=True)\n    weighted_responses = model['weighted_responses'][:, query_items]\n    selected_covariance = weighted_responses.T @ weighted_responses + ridge * np.eye(query_items.size)\n    score_covariance = model['score_covariance']\n    observed_residuals = target_answers - source_item_means[query_items]\n    score_coefficients = np.linalg.solve(selected_covariance, score_covariance[query_items])\n    ridge_prediction = source_score_mean + observed_residuals @ score_coefficients\n    offset_prediction = source_score_mean + observed_residuals.mean(axis=1)\n    predictions = np.clip(blend_weight * ridge_prediction + (1.0 - blend_weight) * offset_prediction, 0.0, 1.0)\n    if not np.all(np.isfinite(predictions)):\n        raise ValueError('nonfinite prediction')\n    return predictions[history_inverse]\n\n\ndef validation_prefixes(max_budget):\n    if max_budget == 0:\nimport functools\n\nimport numpy as np\n\nfrom surrogate import (\n    fit_score_model,\n    predict_score,\n    select_score_path,\n    tune_configuration,\n    validation_prefixes,\n)\n\n\ndef sigmoid(values):\n    return 1.0 / (1.0 + np.exp(-np.clip(values, -50.0, 50.0)))\n\n\ndef infer_shifts(query_logits, observed_values, shift_penalty):\n    observed_values = np.asarray(observed_values, dtype=np.float64)\n    if not np.isfinite(shift_penalty) or shift_penalty <= 0:\n        raise ValueError('shift penalty must be positive')\n    if observed_values.ndim != 2 or observed_values.shape[1] != query_logits.size:\n        raise ValueError('invalid shift observations')\n    shifts = np.zeros(observed_values.shape[0], dtype=np.float64)\n    if shifts.size == 0 or query_logits.size == 0:\n        return shifts\n    lower_bounds = np.full(shifts.size, -20.0)\n    upper_bounds = np.full(shifts.size, 20.0)\n    for iteration in range(64):\n        query_probabilities = sigmoid(query_logits[None, :] + shifts[:, None])\n        shift_gradient = (query_probabilities - observed_values).sum(axis=1) + shift_penalty * shifts\n        shift_hessian = (query_probabilities * (1.0 - query_probabilities)).sum(axis=1) + shift_penalty\n        converged = np.abs(shift_gradient) < 1e-10\n        if np.all(converged):\n            break\n        previous_shifts = shifts.copy()\n        lower_bounds = np.where(shift_gradient < 0.0, shifts, lower_bounds)\n        upper_bounds = np.where(shift_gradient > 0.0, shifts, upper_bounds)\n        shifts = np.clip(shifts - shift_gradient / np.maximum(shift_hessian, 1e-12), -20.0, 20.0)\n        outside_bracket = (shifts < lower_bounds) | (shifts > upper_bounds)\n        shifts = np.where(outside_bracket, (lower_bounds + upper_bounds) * 0.5, shifts)\n        shifts = np.where(converged, previous_shifts, shifts)\n    if not np.all(np.isfinite(shifts)):\n        raise ValueError('nonfinite ability shift')\n    return shifts\n\n\ndef score_curve(item_logits, shifts):\n    full_score_curve = np.zeros(shifts.size, dtype=np.float64)\n    for start in range(0, item_logits.size, 1024):\n        item_probabilities = sigmoid(shifts[:, None] + item_logits[None, start:start + 1024])\n        full_score_curve += item_probabilities.sum(axis=1)\n    full_score_curve /= item_logits.size\n    return full_score_curve\n\n\ndef make_item_logits(source_item_means):\n    clipped_item_means = np.clip(source_item_means, 1e-4, 1.0 - 1e-4)\n    item_logits = np.log(clipped_item_means) - np.log1p(-clipped_item_means)\n    return item_logits\n\n\ndef fit_residual_basis(item_logits, source_matrix, source_weights, query_items,\n                       shift_penalty):\n    source_shifts = infer_shifts(item_logits[query_items], source_matrix[:, query_items], shift_penalty)\n    source_curve_scores = score_curve(item_logits, source_shifts)\n    source_query_probabilities = sigmoid(item_logits[query_items][None, :] + source_shifts[:, None])\n    source_score_residuals = source_matrix.mean(axis=1) - source_curve_scores\n    source_query_residuals = source_matrix[:, query_items] - source_query_probabilities\n    residual_feature_mean = source_weights @ source_query_residuals\n    residual_score_mean = float(source_weights @ source_score_residuals)\n    centered_query_residuals = source_query_residuals - residual_feature_mean\n    weighted_query_residuals = np.sqrt(source_weights)[:, None] * centered_query_residuals\n    weighted_score_residuals = np.sqrt(source_weights) * (source_score_residuals - residual_score_mean)\n    residual_covariance = weighted_query_residuals.T @ weighted_query_residuals\n    residual_cross_covariance = weighted_query_residuals.T @ weighted_score_residuals\n    return dict(feature_mean=residual_feature_mean, score_mean=residual_score_mean,\n                covariance=residual_covariance, cross_covariance=residual_cross_covariance)\n\n\ndef fit_residual_coefficients(basis, query_items, residual_ridge):\n    if residual_ridge is None:\n        return 0.0, np.zeros(query_items.size, dtype=np.float64)\n    if not np.isfinite(residual_ridge) or residual_ridge <= 0:\n        raise ValueError('residual ridge must be positive')\n    residual_covariance = basis['covariance']\n    residual_cross_covariance = basis['cross_covariance']\n    residual_coefficients = np.linalg.solve(residual_covariance + residual_ridge * np.eye(query_items.size), residual_cross_covariance)\n    residual_intercept = basis['score_mean'] - basis['feature_mean'] @ residual_coefficients\n    return float(residual_intercept), residual_coefficients\n\n\ndef target_curve_features(item_logits, query_items, target_answers, shift_penalty):\n    target_shifts = infer_shifts(item_logits[query_items], target_answers, shift_penalty)\n    target_curve_scores = score_curve(item_logits, target_shifts)\n    target_query_probabilities = sigmoid(item_logits[query_items][None, :] + target_shifts[:, None])\n    target_query_residuals = target_answers - target_query_probabilities\n    return target_curve_scores, target_query_residuals\n\n\ndef nonlinear_prediction(target_features, residual_intercept, residual_coefficients):\n    target_curve_scores, target_query_residuals = target_features\n    nonlinear_predictions = target_curve_scores + residual_intercept + target_query_residuals @ residual_coefficients\n    return nonlinear_predictions\n\n\ndef fit_incumbent(source_matrix, source_weights, source_groups, item_groups,\n                  max_budget, seed, training_steps=7, cv_settings=9):\n    ridge, blend_weight = tune_configuration(\n        source_matrix, source_weights, source_groups, item_groups, max_budget,\n        seed, training_steps, cv_settings)\n    score_model = fit_score_model(source_matrix, source_weights)\n    selection_order = select_score_path(score_model, item_groups, max_budget, ridge)\n    score_model['cross_covariance_cache'].clear()\n    return dict(model=score_model, ridge=ridge, blend_weight=blend_weight,\n                selection_order=selection_order)\n\n\ndef incumbent_path_cost(source_groups, max_budget, training_steps, cv_settings):\n    if np.unique(source_groups).size < 3 or max_budget == 0:\n{\n  \"entries_type\": \"null\",\n  \"keys\": [\n    \"campaign_results_dir\",\n    \"count\",\n    \"generated_at\",\n    \"queries\",\n    \"reference_query_plan\",\n    \"references\",\n    \"results_dir\"\n  ]\n}\n@Article{Gaylor1965DesignFO,\n title = {Design for Optimal Prediction in Simple Linear Regression},\n@Article{Mahmoud2025SynergizingML,\n title = {Synergizing machine learning and experimental analysis to predict post‐heating compressive strength in waste concrete},\n@Article{Derezinski2019BayesianED,\n title = {Bayesian experimental design using regularized determinantal point processes},\n@Article{Jakhar2023MachineLP,\n title = {Machine learning predictive models for optimal design of photovoltaic/thermal collector with nanofluids based geothermal cooling},\n@Article{Chen2022FatigueFA,\n title = {Fatigue Factor Assessment and Life Prediction of Concrete Based on Bayesian Regularized BP Neural Network},\n@Article{Amor2021PredictionOF,\n title = {Prediction of functional properties of nano TiO2\\documentclass[12pt]{minimal} \\usepackage{amsmath} \\usepackage{wasysym} \\usepackage{amsfonts} \\usepackage{amssymb} \\usepackage{amsbsy} \\usepackage{mathrsfs} \\usepackage{upgreek} \\setlength{\\oddsidemargin}{-69pt} \\begin{document}$$\\hbox {TiO}_2$$\\end{do},\n@Article{Ravi2016ExperimentalDO,\n title = {Experimental Design on a Budget for Sparse Linear Models and Applications},\n@Article{Zhang2012PredictionOX,\n title = {Prediction of xylanase optimal temperature by support vector regression},\n@Article{Gültekin2026PredictionOT,\n title = {Prediction of tensile strength of PLA parts produced with FDM using Taguchi L27, ANOVA, and large-scale machine learning models and optimal parameter design},\n@Article{Jackson2018OnTG,\n title = {On the generalizability of linear and non-linear region of interest-based multivariate regression models for fMRI data},\n@Article{Neuberger2024GoalOO,\n title = {Goal Oriented Optimal Design of Infinite-Dimensional Bayesian Inverse Problems using Quadratic Approximations},\n@Article{Yakut2025OptimizingWT,\n title = {Optimizing wastewater treatment: artificial intelligence-based prediction and green synthesis of iron nanoparticles for efficient dye removal},\n@Article{Yan2025PredictionOC,\n title = {Prediction of Compressive Strength of Carbon Nanotube Reinforced Concrete Based on Multi-Dimensional Database},\n@Article{Qu2025AnES,\n title = {An Efficient Sparse Twin Parametric Insensitive Support Vector Regression Model},\n@Inproceedings{Fisher2012OptimalAE,\n title = {Optimal and efficient experimental design for nonparametric regression with application to functional data},\n@Article{Gladys2026OptimizationAP,\n title = {Optimization and predictive modelling of mechanical characteristics of 3D printed olefin block copolymer polyethylene: RSM and machine learning methods},\n@Article{Sagnol2023FastSR,\n title = {Fast Screening Rules for Optimal Design via Quadratic Lasso Reformul