p': 0.001751727007933468, 'connected': True, 'edges': 435, 'minimum_degree': 82, 'participants': 30}, 'influence_errors': [0.0006218251324586531, 0.003691780916387418, 0.02273957819413045], 'method_audit': True, 'original_scores': [0.8461130570789566, -0.17318512227123595, -0.16900578248080728, 0.415162697894579, -0.46353003311131674, 0.8059669641991407, 0.504464415439211, -0.5404673739707778, -0.5213670771359977, 1.623033371284559, 0.9076699676216372, -0.21347760218130385, 0.8655684576769362, -1.045675233424315, 0.8638167306690028, -0.25055296577498093, -0.072084345433635, -1.370974798845079, 0.21905960389567575, -1.4205713347537947, 0.256058639358303, -0.8918228610790137, -1.3277104308446361, -0.03751747760333649, 0.5122306001024954, -0.5666702943294551, 0.7838248373164157, 0.25148533057804856, -0.08213234997991599, 0.29229041010464046, 0.3745098918871619], 'paired_intervals': {'degree_matched_score': [-0.00864463601532567, 0.017097701149425285], 'margin_heuristic_score': [-0.010670498084291187, 0.020555555555555553], 'random_flip_score': [-0.0121455938697318, 0.01981082375478927]}, 'permutation_curves': [0.004597701149425287, 0.02528735632183908, 0.034482758620689655], 'productive_reference_seconds': 0.06028048088774085, 'rank_intervals': [[1.0, 13.725, 12.175, 4.9, 15.725, 0.7250000000000001, 4.45, 18.175, 17.725, 0.0, 1.0, 12.45, 1.0, 23.45, 1.0, 12.45, 9.725, 25.0, 8.0, 25.725, 5.725, 22.725, 25.725, 10.725, 3.1750000000000003, 16.175, 1.0, 6.0, 11.725, 5.45], [9.549999999999997, 22.549999999999997, 21.549999999999997, 14.274999999999999, 24.549999999999997, 8.0, 11.274999999999999, 25.0, 26.275, 0.2749999999999986, 8.274999999999999, 22.0, 7.274999999999999, 28.0, 9.549999999999997, 23.0, 20.824999999999996, 29.0, 18.0, 29.0, 16.0, 27.0, 29.0, 21.0, 13.0, 25.275, 8.274999999999999, 17.275, 19.549999999999997, 14.274999999999999]], 'selected_indices': [214, 68, 441, 569, 1017, 1188, 545, 1193, 326, 306, 1112, 881, 620]}\nPROGRAM DIRS\n{'program_dir': 'work/results/t06/codex/20261106_231454/investigation/ideas/01_exposure_matched_block_deletion_stability/program_1', 'program_id': 'program_1'}\n{'program_dir': 'work/results/t06/codex/20261106_231454/investigation/ideas/02_budget_aware_rank_crossing_flip_search/program_1', 'program_id': 'program_1'}\n{'program_dir': 'work/results/t06/codex/20261106_231454/investigation/ideas/03_checkpoint_weighted_flip_path_exchange/program_1', 'program_id': 'program_1'}\nSTRATEGY KEYS dict_keys(['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason'])\nFIGS [\n  {\n    \"figure_id\": \"sensitivity_overview\",\n    \"required\": true,\n    \"purpose\": \"Give immediate glance value for the intervention, the evaluated method bundle and the separation between measured sensitivity and unsupported causal or robustness claims.\",\n    \"figure_type\": \"diagram\",\n    \"preferred_generator\": \"generate-concept-figure\",\n    \"group_by\": \"intervention_and_evidence\",\n    \"metric\": \"none; structural explanation only\",\n    \"split_by\": \"legal_perturbation_and_evaluation\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Inspected ICLR article template and paper.sty: one 5.5-inch text column and 9-inch text height, not two conference columns. Two side-by-side sparse panels fit at full text width; target 1.6\\u20131.9 inches high excluding caption, with final labels at least 9 pt. Place on page 1 or 2. A half-width placement would make the mechanism labels unnecessarily small.\",\n    \"allow_progression\": false,\n    \"max_panels\": 2,\n    \"max_categories_per_panel\": 6,\n    \"max_series_per_panel\": 4,\n    \"max_panels_per_row\": 2,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_spec\": \"Panel 1: fixed observed pairwise-comparison graph, tied observations retained/uneditable, distinct nested binary flips at fixed costs, and unchanged estimator. Panel 2: influence screening plus exact-refitted path selection/exchange, three matched-budget baseline families, paired grouped resampling conditional on fixed plans. Show Arena and NBA as unequal evidence blocks; no causal arrow between them. The diagram depicts methodological structure, not a measured attack example. Corroborate mechanism labels against the selected program and public task contract.\"\n  },\n  {\n    \"figure_id\": \"final_disruption_comparison\",\n    \"required\": true,\n    \"purpose\": \"Show all final method comparisons without hiding case heterogeneity behind an overall mean or presenting budget responses as search dynamics.\",\n    \"figure_type\": \"grouped_dot\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"case\",\n    \"metric\": \"pairwise-order disruption\",\n    \"split_by\": \"nominal_edit_fraction\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Use the inspected single-column 5.5-inch text width, with three vertical panels rather than three narrow horizontal plots. Six abbreviated case labels and four offset method markers remain readable at 8\\u20139 pt; target 3.7\\u20134.2 inches total height excluding caption. One shared legend and common axis semantics avoid repetition. This is full text width, not a two-column figure* assumption.\",\n    \"allow_progression\": false,\n    \"max_panels\": 3,\n    \"max_categories_per_panel\": 6,\n    \"max_series_per_panel\": 4,\n    \"max_panels_per_row\": 1,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_spec\": \"Read candidate_curves, baseline_curves and counts for arena and nba-2011 through nba-2015. Show the mean of the three recorded algorithmic seeds as a descriptive summary computed only from those recorded values; preserve individual seed values in the supplement, do not invent error bars, and do not call seeds independent datasets. State explicitly that uncertainty is in the separate paired-interval figure. Use a main-text cost table to report actual integer counts instead of squeezing them into every marker label.\"\n  },\n  {\n    \"figure_id\": \"paired_effect_uncertainty\",\n    \"required\": true,\n    \"purpose\": \"Keep the strongest positive and inconclusive evidence together and prevent aggregate disruption from being mistaken for universal superiority.\",\n    \"figure_type\": \"forest\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"case\",\n    \"metric\": \"budget-averaged fixed-plan paired disruption difference\",\n    \"split_by\": \"baseline_family\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"At the inspected 5.5-inch single-column width, three vertically stacked baseline panels allow six case rows and three modestly offset seed intervals per row without shrinking labels. Target 4.6\\u20135.2 inches high excluding caption, 8\\u20139 pt case labels and a clear zero reference. Do not shrink this to half width or pack three forest panels horizontally.\",\n    \"allow_progression\": false,\n    \"max_panels\": 3,\n    \"max_categories_per_panel\": 6,\n    \"max_series_per_panel\": 3,\n    \"max_panels_per_row\": 1,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_spec\": \"Use paired_intervals for each seed and case exactly as recorded. Display endpoints as interval segments, not fabricated centers or inferred confidence intervals for the original-sample point estimate. If adding point markers, derive the bootstrap mean paired effect from the corresponding bootstrap[].paired entries and label that statistic explicitly; do not silently substitute the unresampled effect. Prefer intervals alone to avoid this ambiguity. Use comparator color consistently across panels and seed-specific line styles/offsets. Do not pool seeds, construct a design-family confidence interval, or imply simultaneous/multiplicity-adjusted coverage.\"\n  }\n]\n","exit_code":0,"status":"completed"}}
