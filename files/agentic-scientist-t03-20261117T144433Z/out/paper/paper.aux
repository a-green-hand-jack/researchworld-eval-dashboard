\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Repeat agreement (left) and reference fidelity (right), by dataset (rows). Points show fitted seeds separately; horizontal bars are stored descriptive 95\% explained-input-cluster bootstrap intervals. Means and intervals pool the same background sizes and budgets within each fit. German Credit uses two approximate anchors; ACSIncome uses exact empirical-game attribution. The axes share a numerical range for readability, not a common probabilistic interpretation.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:agreement}{{2}{6}{Repeat agreement (left) and reference fidelity (right), by dataset (rows). Points show fitted seeds separately; horizontal bars are stored descriptive 95\% explained-input-cluster bootstrap intervals. Means and intervals pool the same background sizes and budgets within each fit. German Credit uses two approximate anchors; ACSIncome uses exact empirical-game attribution. The axes share a numerical range for readability, not a common probabilistic interpretation}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Averaging short calls does not improve the measured allocation contrast}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Equal-coalition allocation contrast: quality of the mean of four additional 64-coalition calls minus quality of the first 256-coalition call. Negative values favor the longer call for this comparison. Colors and markers follow Figure~\ref {fig:agreement}. Bars are stored descriptive within-fit input-cluster intervals. German Credit uses the mean approximate reference vector here, not the mean of two fidelity qualities. No causal mechanism or universal loss is identified.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:allocation}{{3}{7}{Equal-coalition allocation contrast: quality of the mean of four additional 64-coalition calls minus quality of the first 256-coalition call. Negative values favor the longer call for this comparison. Colors and markers follow Figure~\ref {fig:agreement}. Bars are stored descriptive within-fit input-cluster intervals. German Credit uses the mean approximate reference vector here, not the mean of two fidelity qualities. No causal mechanism or universal loss is identified}{figure.caption.7}{}}
