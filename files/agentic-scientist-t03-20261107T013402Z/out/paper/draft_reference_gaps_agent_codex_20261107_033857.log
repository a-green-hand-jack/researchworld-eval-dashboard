{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re\nwith open('references_provenance.json') as source: provenance=json.load(source)\nfor record in provenance['references']:\n print(record['citation_key']+': '+record['title'])\nwith open('claims_grounding.json') as source: claims=json.load(source)['claims']\nprint('\\\\nLiterature-grounded claims:')\nfor claim in claims:\n if claim.get('citation_keys'):\n  print(json.dumps({key:claim[key] for key in ['claim','citation_keys']},ensure_ascii=False))\nwith open('paper_strategy.json') as source: strategy=json.load(source)\nprint('\\\\nWriter notes:')\nprint(json.dumps(strategy['notes_for_writer'],ensure_ascii=False,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
