{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/evaluate_final.py | sed -n '808,902p'; jq '{episode_count:.final_evaluation.evaluation_evidence.episode_count,first_episode_keys:(.final_evaluation.evaluation_evidence.episodes[0]|keys)}' paper_data.json\"","aggregated_output":"   808\tdef transformed_history(values, mask, case, seed):\n   809\t    means = np.divide((values*mask).sum(axis=0), mask.sum(axis=0),\n   810\t                      out=np.full(values.shape[1], .5), where=mask.sum(axis=0) > 0)\n   811\t    if case == 'C':\n   812\t        result = np.where(mask, means, 0)\n   813\t        informative = any(np.ptp(values[mask[:, column], column]) > 1e-12\n   814\t                          for column in range(values.shape[1]) if mask[:, column].sum() > 1)\n   815\t        if not informative or np.allclose(result, values, rtol=0, atol=1e-12):\n   816\t            raise ProtocolFailure('vacuous_control', 'fit')\n   817\t        return result, mask.copy()\n   818\t    if case == 'D':\n   819\t        result, result_mask = values.copy(), mask.copy()\n   820\t        rng = np.random.default_rng(seed + 13)\n   821\t        for column in range(values.shape[1]):\n   822\t            shift = int(rng.integers(1, len(values)))\n   823\t            result[:, column] = np.roll(values[:, column], shift)\n   824\t            result_mask[:, column] = np.roll(mask[:, column], shift)\n   825\t        if np.array_equal(result, values) and np.array_equal(result_mask, mask):\n   826\t            raise ProtocolFailure('vacuous_control', 'fit')\n   827\t        if np.allclose(np.cov(result.T), np.cov(values.T), atol=1e-12, rtol=0):\n   828\t            raise ProtocolFailure('vacuous_control', 'fit')\n   829\t        return result, result_mask\n   830\t    return values, mask\n   831\t\n   832\t\n   833\tdef fit_low_rank(values, mask, seed, sweeps):\n   834\t    means = np.divide((values*mask).sum(axis=0), mask.sum(axis=0),\n   835\t                      out=np.full(values.shape[1], .5), where=mask.sum(axis=0) > 0)\n   836\t    centered = values - means\n   837\t    rank = min(4, *values.shape)\n   838\t    factors = np.random.default_rng(seed).normal(0, .1, (values.shape[1], rank))\n   839\t    latent = np.zeros((values.shape[0], rank))\n   840\t    regularizer = .1 * np.eye(rank)\n   841\t    for sweep in range(sweeps):\n   842\t        for row in range(len(values)):\n   843\t            design = factors[mask[row]]\n   844\t            latent[row] = np.linalg.solve(regularizer + design.T @ design, design.T @ centered[row, mask[row]])\n   845\t        for column in range(values.shape[1]):\n   846\t            design = latent[mask[:, column]]\n   847\t            factors[column] = np.linalg.solve(regularizer + design.T @ design, design.T @ centered[mask[:, column], column])\n   848\t    return means, factors\n   849\t\n   850\t\n   851\tdef partitions(rows, test_indices, seed):\n   852\t    output = []\n   853\t    for index in test_indices:\n   854\t        available = np.flatnonzero([value is not None for value in rows[index]['values']])\n   855\t        rng = np.random.default_rng(seed + index * 1009)\n   856\t        shuffled = rng.permutation(available)\n   857\t        cut = max(8, (2 * len(shuffled)) // 3)\n   858\t        reservoir, targets = sorted(shuffled[:cut].tolist()), sorted(shuffled[cut:].tolist())\n   859\t        if not targets or len(reservoir) < 8:\n   860\t            raise RuntimeError('invalid frozen reservoir')\n   861\t        output.append((reservoir, targets))\n   862\t    return output\n   863\t\n   864\t\n   865\tdef error_pair(predicted, truth, indices):\n   866\t    residual = predicted[indices] - truth[indices]\n   867\t    return float(np.mean(np.abs(residual))), float(np.mean(residual**2))\n   868\t\n   869\t\n   870\tdef run_baseline(name, values, mask, tests, partitions_for_rows, seed, sweeps):\n   871\t    means = np.divide((values*mask).sum(axis=0), mask.sum(axis=0),\n   872\t                      out=np.full(values.shape[1], .5), where=mask.sum(axis=0) > 0)\n   873\t    factors = None\n   874\t    if name in ['random_low_rank', 'variance_low_rank']:\n   875\t        means, factors = fit_low_rank(values, mask, seed, sweeps)\n   876\t    variance = np.divide(((values-means)**2 * mask).sum(axis=0), mask.sum(axis=0),\n   877\t                         out=np.zeros(values.shape[1]), where=mask.sum(axis=0)>0)\n   878\t    losses = np.ones((len(tests), 4))\n   879\t    for row, (reservoir, target) in enumerate(partitions_for_rows):\n   880\t        if name == 'random_low_rank':\n   881\t            selection = np.random.default_rng(seed + row * 37).permutation(reservoir).tolist()[:8]\n   882\t        else:\n   883\t            selection = sorted(reservoir, key=lambda index: (-variance[index], index))[:8]\n   884\t        for checkpoint_index, budget in enumerate(CHECKPOINTS):\n   885\t            observed = selection[:budget]\n   886\t            if name == 'column_mean':\n   887\t                predicted = means\n   888\t            elif name == 'copy_skill':\n   889\t                predicted = np.full(len(means), tests[row, observed].mean())\n   890\t            elif name == 'linear_ridge':\n   891\t                design = np.where(mask[:, observed], values[:, observed]-means[observed], 0)\n   892\t                coefficients = np.linalg.solve(.1*np.eye(budget) + design.T@design,\n   893\t                                               design.T @ np.where(mask, values-means, 0))\n   894\t                predicted = np.clip(means + (tests[row, observed]-means[observed]) @ coefficients, 0, 1)\n   895\t            else:\n   896\t                design = factors[observed]\n   897\t                latent = np.linalg.solve(.1*np.eye(factors.shape[1]) + design.T@design,\n   898\t                                         design.T @ (tests[row, observed]-means[observed]))\n   899\t                predicted = np.clip(means + factors @ latent, 0, 1)\n   900\t            losses[row, checkpoint_index] = error_pair(predicted, tests[row], target)[0]\n   901\t    return losses\n   902\t\n{\n  \"episode_count\": 3,\n  \"first_episode_keys\": [\n    \"correct\",\n    \"duration_seconds\",\n    \"score\",\n    \"seed\",\n    \"solution\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/evaluate_final.py | sed -n '904,998p'; jq '[.final_evaluation.evaluation_evidence.episodes[]|{seed,correct,score,solution_keys:(.solution|keys)}]' paper_data.json; jq '{error,feedback}' validation_report.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/evaluate_final.py | sed -n '904,998p'; jq '[.final_evaluation.evaluation_evidence.episodes[]|{seed,correct,score,solution_keys:(.solution|keys)}]' paper_data.json; jq '{error,feedback}' validation_report.json\"","aggregated_output":"   904\tdef worst_case(episode):\n   905\t    count = len(episode['test'])\n   906\t    return {'mae': np.ones((count, 4)), 'mse': np.ones((count, 4)),\n   907\t            'baselines': np.ones((5, count, 4)), 'predictions': None, 'queries': None,\n   908\t            'all_unqueried_mae': np.ones((count, 4)), 'duration': 0.0, 'complete': False}\n   909\t\n   910\t\n   911\tdef evaluate_episode(episode, call, work_deadline, *, rows, smoke):\n   912\t    started = time.monotonic()\n   913\t    work = 1.5 if smoke else (20.0 if PLANE == 'search' else 60.0)\n   914\t    method_cleanup = .25\n   915\t    local_deadline = min(work_deadline, started + 6 * (work + method_cleanup) + .1)\n   916\t    values, mask = arrays(rows, episode['history'])\n   917\t    values, mask = transformed_history(values, mask, episode['case'], episode['seed'])\n   918\t    tests, test_mask = arrays(rows, episode['test'])\n   919\t    partition = partitions(rows, episode['test'], episode['seed'])\n   920\t    sweeps = 2 if smoke else 50\n   921\t    baseline_losses = []\n   922\t    for method_index, name in enumerate(BASELINES):\n   923\t        method_deadline = reserved_method_deadline(now=time.monotonic(), episode_deadline=local_deadline,\n   924\t                                                   methods_remaining=5-method_index, work_seconds=work,\n   925\t                                                   cleanup_seconds=method_cleanup)\n   926\t        try:\n   927\t            with until(method_deadline):\n   928\t                baseline_losses.append(run_baseline(name, values, mask, tests, partition, episode['seed'], sweeps))\n   929\t        except (TimeoutError, np.linalg.LinAlgError) as error:\n   930\t            category = 'baseline_timeout' if isinstance(error, TimeoutError) else 'baseline_result_failure'\n   931\t            def record_baseline_failure(category):\n   932\t                record_failure({'component': 'baseline', 'category': category, 'operation': 'baseline_worker'})\n   933\t                episode['failure_recorded'] = True\n   934\t            fail_required_baseline(category, lambda: None, record_baseline_failure)\n   935\t    method_deadline = reserved_method_deadline(now=time.monotonic(), episode_deadline=local_deadline,\n   936\t                                               methods_remaining=0, work_seconds=work,\n   937\t                                               cleanup_seconds=method_cleanup)\n   938\t    result = worst_case(episode)\n   939\t    result['baselines'] = np.asarray(baseline_losses)\n   940\t    outputs, selections = [], []\n   941\t    with until(method_deadline):\n   942\t        upload(call, values, mask)\n   943\t        ack(call({'op': 'fit', 'rank': 4, 'sweeps': sweeps, 'ridge': .1}), 'fit')\n   944\t        for trajectory, (reservoir, targets) in enumerate(partition):\n   945\t            ack(call({'op': 'begin', 'trajectory': trajectory, 'queryable': reservoir, 'budget': 8}), 'begin')\n   946\t            observed = []\n   947\t            checkpoints = []\n   948\t            for step in range(1, 9):\n   949\t                response = call({'op': 'select'})\n   950\t                if type(response) is not dict or set(response) != {'index'} or type(response['index']) is not int:\n   951\t                    raise ProtocolFailure('malformed_response', 'select')\n   952\t                index = response['index']\n   953\t                if index not in reservoir or index in observed:\n   954\t                    raise ProtocolFailure('illegal_query', 'select')\n   955\t                observed.append(index)\n   956\t                ack(call({'op': 'observe', 'index': index, 'value': float(tests[trajectory, index])}), 'observe')\n   957\t                if step in CHECKPOINTS:\n   958\t                    predicted = prediction(call({'op': 'predict'}), tests.shape[1])\n   959\t                    checkpoint = CHECKPOINTS.index(step)\n   960\t                    result['mae'][trajectory, checkpoint], result['mse'][trajectory, checkpoint] = error_pair(predicted, tests[trajectory], targets)\n   961\t                    unqueried = sorted(set(np.flatnonzero(test_mask[trajectory]).tolist()) - set(observed))\n   962\t                    result['all_unqueried_mae'][trajectory, checkpoint] = error_pair(predicted, tests[trajectory], unqueried)[0]\n   963\t                    checkpoints.append(predicted.tolist())\n   964\t            outputs.append(checkpoints)\n   965\t            selections.append(observed)\n   966\t    result.update(predictions=outputs, queries=selections, duration=time.monotonic()-started, complete=True)\n   967\t    return result\n   968\t\n   969\t\n   970\tdef fixed_average(values):\n   971\t    if not values or any(not math.isfinite(value) for value in values):\n   972\t        raise ValueError('nonfinite fixed contribution')\n   973\t    return sum(values) / len(values)\n   974\t\n   975\t\n   976\tdef aggregate(episodes, outcomes, complete):\n   977\t    primary = [index for index, episode in enumerate(episodes) if episode['case'] in ['A', 'B'] and not episode['replay']]\n   978\t    mae = fixed_average([float(outcomes[index]['mae'].mean()) for index in primary])\n   979\t    mse = fixed_average([float(outcomes[index]['mse'].mean()) for index in primary])\n   980\t    baseline_maes = [fixed_average([float(outcomes[index]['baselines'][method].mean()) for index in primary]) for method in range(5)]\n   981\t    baseline_mae = min(baseline_maes)\n   982\t    original, replay = outcomes[0], outcomes[-1]\n   983\t    delta = 1.0\n   984\t    if original['complete'] and replay['complete'] and original['queries'] == replay['queries']:\n   985\t        delta = float(np.max(np.abs(np.asarray(original['predictions']) - np.asarray(replay['predictions']))))\n   986\t    correct = bool(complete and all(outcome['complete'] for outcome in outcomes) and delta <= 1e-10)\n   987\t    metrics = {'combined_score': 1-mae, 'mae': mae, 'rmse': math.sqrt(mse),\n   988\t               'baseline_mae': baseline_mae, 'delta_best_baseline': baseline_mae-mae if complete else -1.0,\n   989\t               'constant_control_mae': fixed_average([float(outcomes[index]['mae'].mean()) for index, episode in enumerate(episodes) if episode['case']=='C']),\n   990\t               'permuted_control_mae': fixed_average([float(outcomes[index]['mae'].mean()) for index, episode in enumerate(episodes) if episode['case']=='D']),\n   991\t               'reset_max_abs_delta': delta, 'correct': int(correct)}\n   992\t    if PLANE == 'final':\n   993\t        for checkpoint, budget in enumerate(CHECKPOINTS):\n   994\t            metrics['mae_k'+str(budget)] = fixed_average([float(outcomes[index]['mae'][:, checkpoint].mean()) for index in primary])\n   995\t        metrics['gain_ci_low'], metrics['gain_ci_high'] = -1.0, -1.0\n   996\t    return metrics, correct\n   997\t\n   998\t\n[\n  {\n    \"seed\": 6841,\n    \"correct\": true,\n    \"score\": 0.9615034136810696,\n    \"solution_keys\": [\n      \"cases\"\n    ]\n  },\n  {\n    \"seed\": 8089,\n    \"correct\": true,\n    \"score\": 0.958873966370573,\n    \"solution_keys\": [\n      \"cases\"\n    ]\n  },\n  {\n    \"seed\": 9011,\n    \"correct\": true,\n    \"score\": 0.9571990906967711,\n    \"solution_keys\": [\n      \"cases\"\n    ]\n  }\n]\n{\n  \"error\": \"rendered Supplementary Information validation failed: compiled Supplementary Information must start on a separate page after References\",\n  \"feedback\": {\n    \"figure_validation_errors\": [],\n    \"figure_validation_warnings\": [],\n    \"language_validation_warnings\": []\n  }\n}\n","exit_code":0,"status":"completed"}}
