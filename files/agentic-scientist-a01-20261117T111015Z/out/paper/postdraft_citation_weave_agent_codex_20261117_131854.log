rated_by\\\": {\\\"script_path\\\": \\\"scripts/enrich_panel_reference.py\\\"},\n+    }\n+    Path(str(record_path) + \\\".prov.json\\\").write_text(json.dumps(sidecar, indent=2) + \\\"\\\\n\\\")\n+    print(f\\\"Verified {KEY}: {len(FIELDS)} raw fields; {provenance['count']} references total.\\\")\n+\n+\n+if __name__ == \\\"__main__\\\":\n+    main()\n*** Update File: scripts/map_claims.py\n@@\n     (\\\"The public score inputs are the pinned HELM release, contents revision, and distinct results revision acquired on the recorded date, with the reported extracted-record checksum.\\\", EPISODES, [\\\"source_evidence/data/manifest.json\\\"], []),\n+    (\\\"The pinned official Open LLM contents dataset card lists six Raw fields (IFEval, BBH, MATH level 5, GPQA, MUSR, MMLU-PRO), separately from parallel display-score fields; the analyzed inputs use the raw fields.\\\", EPISODES + [\\\"OpenLLMContents\\\"], [\\\"literature/OpenLLMContents.json#inspected_fields\\\", \\\"literature/OpenLLMContents.README.md\\\", \\\"source_evidence/data/manifest.json\\\"], [\\\"OpenLLMContents\\\"]),\n@@\n     for reference in references:\n         key = reference[\\\"citation_key\\\"]\n+        if key == \\\"OpenLLMContents\\\":\n+            continue\n*** Update File: scripts/write_provenance.py\n@@\n-        (\\\"references.bib\\\", \\\"derived\\\", \\\"scripts/curate_references.py\\\", [str(path) for path in sorted(Path(\\\"literature\\\").glob(\\\"*.json\\\"))]),\n-        (\\\"references_provenance.json\\\", \\\"derived\\\", \\\"scripts/curate_references.py\\\", [str(path) for path in sorted(Path(\\\"literature\\\").glob(\\\"*.json\\\"))]),\n+        (\\\"references.bib\\\", \\\"derived\\\", \\\"scripts/enrich_panel_reference.py\\\", [str(path) for path in sorted(Path(\\\"literature\\\").glob(\\\"*.json\\\"))]),\n+        (\\\"references_provenance.json\\\", \\\"derived\\\", \\\"scripts/enrich_panel_reference.py\\\", [str(path) for path in sorted(Path(\\\"literature\\\").glob(\\\"*.