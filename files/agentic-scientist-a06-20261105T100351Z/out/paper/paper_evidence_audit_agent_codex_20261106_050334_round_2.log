ce/evaluate_final.py#L987\"]}\n78 {\"claim\": \"Paired selected-minus-fixed audit comparison: {\\\"case\\\": \\\"R256K1\\\", \\\"difference\\\": 0.0, \\\"fixed\\\": 0.091796875, \\\"interval\\\": [0.0, 0.0], \\\"seed\\\": 5059, \\\"target\\\": 0.091796875}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"analysis/summary.json#/audit_differences\", \"source_evidence/evaluate_final.py#L987\"]}\n79 {\"claim\": \"Paired selected-minus-fixed audit comparison: {\\\"case\\\": \\\"R256K16\\\", \\\"difference\\\": 0.037109375, \\\"fixed\\\": 0.091796875, \\\"interval\\\": [0.0020318075174739726, 0.07281453567220258], \\\"seed\\\": 5059, \\\"target\\\": 0.12890625}\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"analysis/summary.json#/audit_differences\", \"source_evidence/evaluate_final.py#L987\"]}\n80 {\"claim\": \"Equal-weight supplied aggregate report_mse = 0.0033498776393466522.\", \"source_ids\": [\"final.metric.report_mse\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation/metrics/report_mse\"]}\n81 {\"claim\": \"Equal-weight supplied aggregate reuse_mse = 0.005354862639043066.\", \"source_ids\": [\"final.metric.reuse_mse\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation/metrics/reuse_mse\"]}\n82 {\"claim\": \"Equal-weight supplied aggregate full_budget_naive_mse = 0.002705803510381116.\", \"source_ids\": [\"final.metric.full_budget_naive_mse\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation/metrics/full_budget_naive_mse\"]}\n83 {\"claim\": \"Equal-weight supplied aggregate honest_half_mse = 0.003172102647821109.\", \"source_ids\": [\"final.metric.honest_half_mse\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation/metrics/honest_half_mse\"]}\n84 {\"claim\": \"Equal-weight supplied aggregate fixed_prompt_mse = 0.0021956944465637207.\", \"source_ids\": [\"final.metric.fixed_prompt_mse\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation/metrics/fixed_prompt_mse\"]}\n85 {\"claim\": \"Equal-weight supplied aggregate random_prompt_mse = 0.0023303411401642696.\", \"source_ids\": [\"final.metric.random_prompt_mse\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation/metrics/random_prompt_mse\"]}\n86 {\"claim\": \"Equal-weight supplied aggregate control_failure_rate = 0.0.\", \"source_ids\": [\"final.metric.control_failure_rate\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation/metrics/control_failure_rate\"]}\n87 {\"claim\": \"Equal-weight supplied aggregate replay_discrepancy = 0.0.\", \"source_ids\": [\"final.metric.replay_discrepancy\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation/metrics/replay_discrepancy\"]}\n88 {\"claim\": \"Protected mean error is lower than same-winner reuse in both sixteen-prompt conditions in each evidence family, but full reuse has lower mean error in every synthetic condition. Fixed/random and alternative-half comparisons use their own prompt targets and do not isolate a reporting component.\", \"source_ids\": [\"final.evidence.episodes\", \"final.metric.report_mse\", \"final.metric.reuse_mse\", \"final.metric.full_budget_naive_mse\"], \"citation_keys\": [], \"evidence_refs\": [\"analysis/summary.json#/condition_means\", \"source_evidence/evaluate_final.py#L760\"]}\n89 {\"claim\": \"Eight of ten K=16 selected-minus-fixed audit intervals include zero; both positive exclusions are seed 5059. All K=1 paired differences are identically zero. All ten K=16 report intervals contain the finite audit reference; one K=1 real interval does not.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"analysis/summary.json#/audit_differences\", \"analysis/condition_results.csv\"]}\n90 {\"claim\": \"The strict sign-disagreement diagnostic compares protected selected-prompt report minus all-question fixed score with the reference selected-minus-fixed accuracy. Four of five real K16 seeds at n64 and one of five at n256 disagree. Ties contribute zero while remaining in the denominator; this is not a naive-claim reversal probability.\", \"source_ids\": [\"final.evidence.episodes\", \"final.metric.decision_reversal_rate\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/evaluate_final.py#L779\", \"analysis/summary.json#/condition_means\"]}\n91 {\"claim\": \"5 evaluation seeds, eight conditions per seed, n in {64,256}, K in {1,16}; synthetic regimes each use 1024 matrices; real audits have 512 questions and one realized comparison per condition/seed.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/evaluate_final.py#L899\", \"analysis/condition_results.csv\"]}\n92 {\"claim\": \"Synthetic construction crosses marginal truths 0.6 or linspace(0.4,0.8,K), with the K=1 graded truth 0.4, and coupling probabilities 0.1/0.9; the coupling parameter is not uniformly an exact Pearson correlation.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/evaluate_final.py#L938\"]}\n93 {\"claim\": \"Frozen sixteen-prompt bank, seeded half partition, uniform report weights, fixed tie order, and a 95 percent Wilson interval; all comparators and per-method targets follow the inspected evaluator.\", \"source_ids\": [\"study.selection_kind\", \"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/downstream/program/src/program.py#L55\", \"source_evidence/downstream/program/src/program.py#L78\", \"source_evidence/evaluate_final.py#L746\"]}\n94 {\"claim\": \"CPU float32 SmolLM2-135M-Instruct at fixed model revision and pinned MMLU-Pro; deterministic one-legal-letter generation, batch limit eight, input limit 2044 tokens, invalid/overflow counted as errors, with question/prompt caching.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/resources/runtime_manifest.json\", \"source_evidence/resources/split_manifest.json\", \"source_evidence/evaluate_final.py#L574\"]}\n95 {\"claim\": \"Dataset preparation records 4096 retained final examples, 11711 normalized groups, allocation seed 732091 and NFKC/whitespace/option-content overlap checks; shared-pool and pretraining limitations remain.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/resources/examples.json\", \"source_evidence/resources/split_manifest.json\", \"source_evidence/evaluate_final.py#L694\"]}\n96 {\"claim\": \"The supplied dependency versions and runtime specification are documented, but no separate actual-loaded package inventory is asserted; answer worker uses two tensor and one interoperation thread, with float64 statistics.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/requirements.txt\", \"source_evidence/resources/runtime_manifest.json\", \"source_evidence/evaluate_final.py#L574\"]}\n97 {\"claim\": \"Audit uncertainty is a non-simultaneous 95 percent subject-bootstrap percentile interval using 200 draws, fixed selected prompt, seed plus 76531; it is not a validated population coverage guarantee.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/evaluate_final.py#L987\"]}\n98 {\"claim\": \"Recorded wall durations are [3077.382134909276, 2906.7420726325363, 2406.824948966969, 1974.3900767848827, 1871.1392217157409] seconds, sum 12236.478455009405 seconds, or 3.399021793058168 hours; not CPU-hours or inference-only accounting.\", \"source_ids\": [\"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"analysis/summary.json#/episode_durations_seconds\"]}\n99 {\"claim\": \"No scored search replacement was found: retained baseline, zero scored alternatives and three unscored alternatives; these do not establish measured losses or successful allocation ablations.\", \"source_ids\": [\"study.selection_kind\", \"study.investigation_outcome\", \"study.attempts.scored\", \"study.attempts.unscored\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/downstream_study\"]}\n100 {\"claim\": \"Independent final qualification is completed/qualified/True; no failed final qualification is present. Qualification does not establish superiority or general validity. Candidate-origin diagnostics remain unverified and absent gate details unknown.\", \"source_ids\": [\"final.qualification.status\", \"final.qualification.outcome\", \"final.qualification.correct\", \"final.evidence.episodes\"], \"citation_keys\": [], \"evidence_refs\": [\"paper_data.json#/final_evaluation\"]}\n101 {\"claim\": \"Constant, copied-column, deliberately contaminated-report, effective permutation and replay checks are implementation diagnostics, not generalization proof; deliberate contamination correctly records false independence.\", \"source_ids\": [\"final.evidence.episodes\", \"final.metric.control_failure_rate\", \"final.metric.replay_discrepancy\"], \"citation_keys\": [], \"evidence_refs\": [\"source_evidence/evaluate_final.py#L785\", \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"]}\n102 {\"claim\": \"Literature positioning limited to the consulted original abstract or original page: MMLU-Pro: A More Robust and Challenging Multi-Task Language Understanding Benchmark\", \"source_ids\": [\"ref.original.Wang2024MMLUPro\"], \"citation_keys\": [\"Wang2024MMLUPro\"], \"evidence_refs\": [\"literature/Wang2024MMLUPro.json\"]}\n103 {\"claim\": \"Literature positioning limited to the consulted original abstract or original page: Statistical Comparisons of Classifiers over Multiple Data Sets\", \"source_ids\": [\"ref.original.Demsar2006Comparisons\"], \"citation_keys\": [\"Demsar2006C