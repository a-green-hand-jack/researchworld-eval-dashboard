h_interval\": [0.06972440432994169, 0.07390180737635962], \"candidate_width_interval\": [0.06968320652848992, 0.07377525772667498], \"difference_interval\": [-0.0001956786256751415, 0.0], \"mean_baseline_width\": 0.0716296103422894, \"mean_candidate_width\": 0.07155572701151816, \"ratio_interval\": [0.9973063320817054, 1.0]}, \"ppi\": {\"baseline_width_interval\": [0.111265307939642, 0.11347433705632125], \"candidate_width_interval\": [0.06968320652848992, 0.07377525772667498], \"difference_interval\": [-0.0421960667658224, -0.03938498664988037], \"mean_baseline_width\": 0.11245208031364477, \"mean_candidate_width\": 0.07155572701151816, \"ratio_interval\": [0.6235028183078282, 0.6515473715426284]}, \"ppi_plus_plus\": {\"baseline_width_interval\": [0.05936566973079134, 0.06396799412242658], \"candidate_width_interval\": [0.06968320652848992, 0.07377525772667498], \"difference_interval\": [0.009753456653125056, 0.010364783281835866], \"mean_baseline_width\": 0.061506830718039585, \"mean_candidate_width\": 0.07155572701151816, \"ratio_interval\": [1.1533886992346738, 1.17349032178663]}}}\n","exit_code":0,"status":"completed"}}
