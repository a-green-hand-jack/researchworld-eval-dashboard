eys dict_keys(['candidate_diagnostics_trust', 'episode_count', 'evaluation_scope', 'id', 'json_pointer', 'manifest_path', 'path', 'program_tree_sha256', 'results_tree_sha256', 'sha256', 'type'])\nStudy present False\n","exit_code":0,"status":"completed"}}
