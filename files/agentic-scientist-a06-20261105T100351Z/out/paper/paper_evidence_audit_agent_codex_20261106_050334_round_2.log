{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re,csv,math,statistics\np=json.load(open('paper_data.json')); ep=p['final_evaluation']['evaluation_evidence']['episodes']; cases={(e['seed'],c['case']):c for e in ep for c in e['solution']['cases']}; summary=json.load(open('analysis/summary.json')); errors=[]\nfor label,metrics in summary['condition_means'].items():\n for metric,value in metrics.items():\n  actual=statistics.mean(c['metrics'][metric] for (seed,l),c in cases.items() if l==label)\n  if not math.isclose(value,actual,abs_tol=1e-14):errors.append(('condition',label,metric,value,actual))\nfor line in open('paper.tex'):\n if re.match(r'\"'^'\"\\\\d+ & ',line):\n  v=line.strip().rstrip('\\\\\\\\').split(' & ');seed,n,setting,arms= v[:4];label=('S' if setting=='Synth.' else 'R')+n+'K'+arms\n  for text,metric,scale in zip(v[4:],['report_mse','reuse_mse','selected_accuracy','coverage','interval_width'],[1000,1000,1,1,1]):\n   expected=f\\\"{cases[int(seed),label]['metrics'][metric]*scale:.4f}\\\"\n   if text\"'!=expected:errors.append(('\"'seed table',seed,label,metric,text,expected))\nfor line in open('tables/main_results.tex'):\n if line.startswith(('Synthetic &','Real audit &')):\n  v=line.strip().rstrip('\\\\\\\\').split(' & ');n,k=re.findall(r'\\\\d+',v[1]);label=('S' if v[0]=='Synthetic' else 'R')+n+'K'+k\n  for text,metric in zip(v[2:],['report_mse','reuse_mse','full_budget_naive_mse','honest_half_mse','fixed_prompt_mse','random_prompt_mse']):\n   expected=f\\\"{summary['condition_means'][label][metric]*1000:.3f}\\\"\n   if text\"'!=expected:errors.append(('\"'main table',label,metric,text,expected))\nclaims=json.load(open('claims_grounding.json'))['claims']\nfor i,c in enumerate(claims[:40]):\n raw=c['claim'];m=re.search(r'seed (\\\\d+), condition ([SR]\\\\d+K\\\\d+): (\\\\{.*\\\\})',raw)\n if not m:errors.append(('claim parse',i));continue\n if json.loads(m[3])\"'!=cases[int(m[1]),m[2]]['\"'metrics']:errors.append(('claim metrics',i))\nfor key,val in p['final_evaluation']['metrics'].items():\n if key in next(iter(cases.values()))['metrics']:\n  actual=statistics.mean(c['metrics'][key] for c in cases.values())\n  if not math.isclose(val,actual,abs_tol=1e-14):errors.append(('aggregate',key,val,actual))\nprint('Numeric mismatches:',errors);print('Durations:',[e['duration_seconds'] for e in ep]);print('reductions',summary['reductions_percent']);print('mean keys',list(summary))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re,csv,math,statistics\np=json.load(open('paper_data.json')); ep=p['final_evaluation']['evaluation_evidence']['episodes']; cases={(e['seed'],c['case']):c for e in ep for c in e['solution']['cases']}; summary=json.load(open('analysis/summary.json')); errors=[]\nfor label,metrics in summary['condition_means'].items():\n for metric,value in metrics.items():\n  actual=statistics.mean(c['metrics'][metric] for (seed,l),c in cases.items() if l==label)\n  if not math.isclose(value,actual,abs_tol=1e-14):errors.append(('condition',label,metric,value,actual))\nfor line in open('paper.tex'):\n if re.match(r'\"'^'\"\\\\d+ & ',line):\n  v=line.strip().rstrip('\\\\\\\\').split(' & ');seed,n,setting,arms= v[:4];label=('S' if setting=='Synth.' else 'R')+n+'K'+arms\n  for text,metric,scale in zip(v[4:],['report_mse','reuse_mse','selected_accuracy','coverage','interval_width'],[1000,1000,1,1,1]):\n   expected=f\\\"{cases[int(seed),label]['metrics'][metric]*scale:.4f}\\\"\n   if text\"'!=expected:errors.append(('\"'seed table',seed,label,metric,text,expected))\nfor line in open('tables/main_results.tex'):\n if line.startswith(('Synthetic &','Real audit &')):\n  v=line.strip().rstrip('\\\\\\\\').split(' & ');n,k=re.findall(r'\\\\d+',v[1]);label=('S' if v[0]=='Synthetic' else 'R')+n+'K'+k\n  for text,metric in zip(v[2:],['report_mse','reuse_mse','full_budget_naive_mse','honest_half_mse','fixed_prompt_mse','random_prompt_mse']):\n   expected=f\\\"{summary['condition_means'][label][metric]*1000:.3f}\\\"\n   if text\"'!=expected:errors.append(('\"'main table',label,metric,text,expected))\nclaims=json.load(open('claims_grounding.json'))['claims']\nfor i,c in enumerate(claims[:40]):\n raw=c['claim'];m=re.search(r'seed (\\\\d+), condition ([SR]\\\\d+K\\\\d+): (\\\\{.*\\\\})',raw)\n if not m:errors.append(('claim parse',i));continue\n if json.loads(m[3])\"'!=cases[int(m[1]),m[2]]['\"'metrics']:errors.append(('claim metrics',i))\nfor key,val in p['final_evaluation']['metrics'].items():\n if key in next(iter(cases.values()))['metrics']:\n  actual=statistics.mean(c['metrics'][key] for c in cases.values())\n  if not math.isclose(val,actual,abs_tol=1e-14):errors.append(('aggregate',key,val,actual))\nprint('Numeric mismatches:',errors);print('Durations:',[e['duration_seconds'] for e in ep]);print('reductions',summary['reductions_percent']);print('mean keys',list(summary))\nPY\"","aggregated_output":"Numeric mismatches: []\nDurations: [3077.382134909276, 2906.7420726325363, 2406.824948966969, 1974.3900767848827, 1871.1392217157409]\nreductions {'S64K1': -0.7350233714162879, 'S64K16': 45.694735143784456, 'S256K1': 2.074330873221808, 'S256K16': 42.726024023432394, 'R64K1': -6.335379132844987, 'R64K16': 75.57262768530374, 'R256K1': 16.792079207920796, 'R256K16': 53.8163001293661}\nmean keys ['condition_means', 'regime_means', 'audit_differences', 'episode_durations_seconds', 'duration_sum_seconds', 'reductions_percent', 'seed_count']\n","exit_code":0,"status":"completed"}}
