\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Selected-target descriptive resampling summaries. Gap bands are empirical 2.5th and 97.5th percentiles over 200 draws, not selection-adjusted population intervals. Positive margin means the original leader exceeds the original runner-up by more than $10^{-7}$. ``Slot witnesses'' counts successful auxiliary searches among the first 30 draws; these are attempted only for positive original-pair margins and edit resampled slots, possibly duplicated original IDs. Source: \texttt  {artifacts/uncertainty.csv}; generated input: \texttt  {paper/tables/bootstrap.tex}.}}{13}{table.5}\protected@file@percent }
\newlabel{tab:bootstrap}{{5}{13}{Selected-target descriptive resampling summaries. Gap bands are empirical 2.5th and 97.5th percentiles over 200 draws, not selection-adjusted population intervals. Positive margin means the original leader exceeds the original runner-up by more than $10^{-7}$. ``Slot witnesses'' counts successful auxiliary searches among the first 30 draws; these are attempted only for positive original-pair margins and edit resampled slots, possibly duplicated original IDs. Source: \texttt {artifacts/uncertainty.csv}; generated input: \texttt {paper/tables/bootstrap.tex}}{table.5}{}}
