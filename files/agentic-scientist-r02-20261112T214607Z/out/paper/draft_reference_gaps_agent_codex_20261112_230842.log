{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re\nfrom pathlib import Path\nfor name in ['references_provenance.json','claims_grounding.json','paper_data.json','paper_strategy.json']:\n data=json.loads(Path(name).read_text())\n print(name, 'top-level:', list(data) if isinstance(data,dict) else f'list[{len(data)}]')\nprint('\\\\nBibliography entries:')\ntext=Path('references.bib').read_text()\nfor entry in re.split(r'(?=@\\\\w+\\\\{)',text):\n if not entry.strip(): continue\n key=re.search(r'@\\\\w+\\\\{([\"'^,]+)'\"',entry).group(1)\n title=re.search(r'title\\\\s*=\\\\s*\\\\{([\"'^'\"\\\\n]+)',entry,re.I)\n print(key, title.group(1) if title else '')\nPY\"","aggregated_output":"references_provenance.json top-level: ['generated_at', 'count', 'queries', 'references']\nclaims_grounding.json top-level: ['claims']\npaper_data.json top-level: ['ablation_studies', 'all_programs', 'best_any', 'best_correct', 'evidence_sources', 'final_evaluation', 'generated_at', 'grounding_sources', 'idea_titles', 'improvement_trace', 'paper_profile', 'presentation_contract', 'results_dir', 'top_programs', 'totals']\npaper_strategy.json top-level: ['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason']\n\nBibliography entries:\nVovk2005 Algorithmic Learning in a Random World},\nPapadopoulos2002 Inductive Confidence Machines for Regression},\nLei2018 Distribution-Free Predictive Inference for Regression},\nLeiWasserman2014 Distribution-free Prediction Bands for Non-parametric Regression},\nAitchison1982 The Statistical Analysis of Compositional Data},\nEgozcue2003 Isometric Logratio Transformations for Compositional Data Analysis},\nAitchisonShen1980 Logistic-normal distributions:Some properties and uses},\nKoenkerBassett1978 Regression Quantiles},\nKoenkerHallock2001 Quantile Regression},\nFriedman2001 Greedy function approximation: A gradient boosting machine.},\nFriedman2002 Stochastic gradient boosting},\nEfron1979 Bootstrap Methods: Another Look at the Jackknife},\nWilson1927 Probable Inference, the Law of Succession, and Statistical Inference},\nHoerlKennard1970 Ridge Regression: Biased Estimation for Nonorthogonal Problems},\nStone1974 Cross-Validatory Choice and Assessment of Statistical Predictions},\nHastie2009 The Elements of Statistical Learning},\nAngelopoulosBates2021 A Gentle Introduction to Conformal Prediction and Distribution-Free Uncertainty Quantification},\nRomano2019 Conformalized Quantile Regression},\nTibshirani2019 Conformal Prediction Under Covariate Shift},\nBarber2021 Predictive inference with the jackknife+},\nBarberLimits2021 The limits of distribution-free conditional predictive inference},\nGuan2023 Conformal prediction with localization},\nVovk2012 Conditional validity of inductive conformal predictors},\nBarberBeyond2023 Conformal prediction beyond exchangeability},\nMeinshausen2006 Quantile Regression Forests},\n","exit_code":0,"status":"completed"}}
