{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re,statistics,math\nfrom pathlib import Path\np=json.loads(Path('paper_data.json').read_text()); es=p['final_evaluation']['evaluation_evidence']['episodes']; ms=['random_flip_score','degree_matched_score','margin_heuristic_score']; mean=statistics.mean\nrows=re.findall(r'(Arena|NBA \\\\d+) & (401|503|607) & ([\\\\d.]+) & ([\\\\d.]+) & ([\\\\d.]+) & ([\\\\d.]+)',Path('paper.tex').read_text()); aggregates=[]; displacements=[]; positives={}; ties=[]\ndef percentile(values,q):\n    values=sorted(values); index=(len(values)-1)*q; left=math.floor(index); right=math.ceil(index); return values[left]+(values[right]-values[left])*(index-left)\ndef positions(scores,count):\n    order=sorted(range(count),key=lambda index:(-scores[index],index)); return [order.index(index) for index in range(count)]\nfor e in es:\n    means=[]; ds=[]\n    for c in e['solution']['cases']:\n        curves=[c['candidate_curves']]+[c['baseline_curves'][m] for m in ms]; means.append([mean(cv) for cv in curves]); label='Arena' if c['case']=='arena' else 'NBA '+c['case'][-2:]\n        row=next(row for row in rows if row[0]==label and int(row[1])==e['seed']); assert [f'{100*mean(cv):.3f}' for cv in curves]==list(row[2:]),row\n        assert len(c['bootstrap'])==30 and c['method_audit'] and all(c['controls'].values())\n        for method in ms:\n            endpoints=[percentile([b['paired'][method] for b in c['bootstrap']],q) for q in [.025,.975]]; assert all(abs(first-second)<1e-12 for first,second in zip(endpoints,c['paired_intervals'][method]))\n            if endpoints[0]>0: positives.setdefault((c['case'],method),[]).append(e['seed'])\n            assert mean(c['candidate_curves'])>mean(c['baseline_curves'][method])\n        count=c['graph']['participants']; original=positions(c['original_scores'],count); distances=[]\n        for scores,curve in zip(c['edited_scores'],c['candidate_curves']):\n            edited=positions(scores,count); inversions=sum((original[first]<original[second]) \"'!= (edited[first]<edited[second]) for first in range(count) for second in range(first+1,count))/math.comb(count,2); assert abs(inversions-curve)<1e-12\n            distances.append(sum(abs(first-second) for first,second in zip(edited,original))/(count*(count-1)))\n        ds.append(mean(distances))\n    aggregates.append([.5*means[0][index]+.5*mean(row[index] for row in means[1:]) for index in range(4)]); displacements.append(.5*ds[0]+.5*mean(ds[1:]))\nprint('\"'All 18 supplementary table rows, 54 disruption values, 54 percentile intervals, and controls match evidence.')\nprint('Aggregates:',dict(zip(['combined_score']+ms,[mean(row[index] for row in aggregates) for index in range(4)]))); print('Displacement:',mean(displacements))\nfor key,value in positives.items(): print('Positive interval:',key,value)\nfor index,case in enumerate(es[0]['solution']['cases']):\n    for method in ms:\n        base=[mean(e['solution']['cases'][index]['baseline_curves'][method][budget] for e in es) for budget in range(3)]\n        for budget,(guided,control) in enumerate(zip(case['candidate_curves'],base)):\n            if guided<=control: ties.append((case['case'],method,budget,guided,control))\nprint('Non-strictly-favored plotted cells:',ties)\nprint('No downstream_study present:', 'downstream_study' not in p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
