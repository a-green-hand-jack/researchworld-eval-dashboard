{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U62tmhyx9jn1tMjYg2SMfd","type":"tool_result","content":"import base64\n\nimport numpy as np\n\n_STATE = {\"rng\": np.random.default_rng(0), \"ready\": False, \"seed\": 0}\n_FOLDS = 8\n_N_DRAWS = 1000  # even: antithetic pairs\n_FALLBACK = 0.9  # only used if B/d is unavailable; otherwise the budget prior is the fallback\n_N_PARTITIONS = 4  # independent random fold partitions averaged per instance\n\n# Budget-specific prior means keyed on log2(B/d): 2 -> B=4d, 4 -> B=16d.  Hand-set from the\n# aggregate low/high-budget label means reported in earlier evaluation metrics (~0.84, ~0.96);\n# NOT fitted on instance data.  Interpolated linearly in log2(B/d) and clipped outside [2, 4].\n_PRIOR_BY_RATIO = {2.0: 0.84, 4.0: 0.96}\n_W_SIM = 0.6  # empirical-Bayes weight on the simulated-rerun reliability (1 - _W_SIM on the prior)\n_MARGIN_BOOST = 0.02  # coefficient of the soft margin gate\n_MARGIN_SCALE = 3.0\n\n# Calibration map: logit-free linear map on simulated Jaccards, clipped to [0, 1].\n# Features: s_d10 (diag, mult 1.0), s_d07 (diag, mult 0.7), s_f10 (full cov, mult 1.0),\n# s_f141 (full cov, mult sqrt(2)), lbd = log2(B/d) - 3 (0 at B=8d midpoint), mz = tanh(margin z / 3),\n# and family indicators.  The constants are conservative PRIORS (see NOTES.md): they were NOT\n# fitted on a local replica because no code could be executed while writing this candidate.\n# Cycle-1 evidence (spread inflation > 1 lowered the score; labels skew high) motivates putting\n# weight on the un-inflated / deflated simulators and none on the inflated one.\n_CALIB_COEF = {\n    \"intercept\": 0.0,\n    \"s_d10\": 0.50,\n    \"s_d07\": 0.20,\n    \"s_f10\": 0.30,\n    \"s_f141\": 0.0,\n    \"lbd\": 0.0,\n    \"mz\": 0.0,\n    \"fam_logreg\": 0.0,\n    \"fam_random_forest\": 0.0,\n    \"fam_mlp\": 0.0,\n}\n\n\ndef _decode(obj, dtype):\n    raw = base64.b64decode(obj[\"data\"].encode(\"ascii\"))\n1:\"\"\"Baseline candidate: single-run reliability diagnostic for stochastic Kernel SHAP.\n23:{\"op\": \"diagnose\", \"workload\": {...}, \"instances\": [...]}\n24:    Exactly one diagnose call follows each reset.\n63:_DRAWS = 400\n64:_INFL = float(np.sqrt(2.0))  # predictive spread: observed-run noise + rerun noise\n76:    sw = np.sqrt(w)\n85:def _diagnose_one(inst, d, B, k, rng):\n106:    # e = sqrt((n-1)/n) * z^T dev with z ~ N(0, I_n) has exactly this covariance, keeps the\n108:    z = rng.standard_normal((_DRAWS, n))\n109:    noise = np.sqrt((n - 1) / n) * (z @ dev)\n112:    sel = np.zeros((_DRAWS, d), dtype=bool)\n127:    if op == \"diagnose\":\n131:        out = [_diagnose_one(inst, d, B, k, rng) for inst in request[\"instances\"]]\n10:{\"op\": \"diagnose\", \"workload\": {...}, \"instances\": [...]}\n14:    anchors {\"empty\", \"full\"}.\n23:  2. A full-covariance simulator (``_jackknife_cov``; draws are phi + L z with L built from the\n25:     baseline diagonal simulator; spread multiplier ``mult`` is a parameter of ``_sim_jaccard``.\n28:     baseline-equivalent diagonal simulator.  See NOTES.md for how the constants were chosen.\n36:_N_DRAWS = 1000  # even: antithetic pairs\n37:_FALLBACK = 0.9\n38:_SHRINK = 0.7  # weight of the calibrated map vs the baseline-equivalent simulator\n41:# Features: s_d10 (diag, mult 1.0), s_d07 (diag, mult 0.7), s_f10 (full cov, mult 1.0),\n42:# s_f141 (full cov, mult sqrt(2)), lbd = log2(B/d) - 3 (0 at B=8d midpoint), mz = tanh(margin z / 3),\n48:    \"intercept\": 0.0,\n49:    \"s_d10\": 0.50,\n50:    \"s_d07\": 0.20,\n51:    \"s_f10\": 0.30,\n52:    \"s_f141\": 0.0,\n53:    \"lbd\": 0.0,\n54:    \"mz\": 0.0,\n55:    \"fam_logreg\": 0.0,\n56:    \"fam_random_forest\": 0.0,\n57:    \"fam_mlp\": 0.0,\n82:    Returns (phi, loo, dev, n): the full-data solution, the stacked leave-group-out solutions,\n107:def _sim_jaccard(phi, dev, mult, k, z_full, z_diag, full_cov):\n110:    z_full: (N, n) common random numbers for the full-covariance draw; z_diag: (N,