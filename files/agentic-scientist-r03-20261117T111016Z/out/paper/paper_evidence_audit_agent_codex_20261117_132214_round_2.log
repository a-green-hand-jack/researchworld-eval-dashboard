{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json,re\nimport numpy as np\nfrom pathlib import Path\npayload=json.loads(Path('paper_data.json').read_text())\nsummary=json.loads(Path('derived_results.json').read_text())\nepisodes=payload['final_evaluation']['evaluation_evidence']['episodes']\narrays={}\nfor case in 'ABCD':\n    arrays[case]=np.array([np.concatenate((np.array(episode['solution']['cases'][case]['baseline_mae_by_method_row_checkpoint']),np.array(episode['solution']['cases'][case]['mae_by_row_checkpoint'])[None]),axis=0).mean(axis=1) for episode in episodes])\n    for name,actual in [('seed_budget',arrays[case]),('mean_budget',arrays[case].mean(axis=0)),('mean',arrays[case].mean(axis=(0,2))),('seed_sd',arrays[case].mean(axis=2).std(axis=0,ddof=1))]:\n        assert np.allclose(actual,summary['cases'][case][name],rtol=0,atol=1e-14),(case,name)\n    diagnostic=np.mean([np.array(episode['solution']['cases'][case]['all_unqueried_mae_by_row_checkpoint']).mean() for episode in episodes])\n    assert abs(diagnostic-summary['changing_target_mae'][case])<1e-14\nprimary_seed=(arrays['A'].mean(axis=2)+arrays['B'].mean(axis=2))/2\nfor name,actual in [('primary_seed',primary_seed),('primary_mean',primary_seed.mean(axis=0)),('primary_seed_sd',primary_seed.std(axis=0,ddof=1))]:\n    assert np.allclose(actual,summary[name],rtol=0,atol=1e-14),name\nfor filename,expected in [('tables/main_comparison.tex',np.array([arrays['A'].mean(axis=(0,2)),arrays['B'].mean(axis=(0,2)),primary_seed.mean(axis=0)]).T),('tables/budget_details.tex',np.concatenate([arrays[case].mean(axis=0) for case in 'AB'])),('tables/seed_details.tex',np.vstack([primary_seed,primary_seed.std(axis=0,ddof=1)]))]:\n    actual=[]\n    for line in Path(filename).read_text().splitlines():\n        values=re.findall(r'(?<\"'!['\"\\\\w.])0\\\\.\\\\d{5}(?\"'!'\"\\\\d)',line)\n        if values: actual.append([float(value) for value in values])\n    assert np.allclose(actual,expected,rtol=0,atol=0.000005),filename\n    print(filename+': all values agree with retained arrays at printed precision')\ngroups=sorted({group for episode in episodes for case in 'AB' for group in episode['solution']['cases'][case]['resampling_components']})\nindex={group:position for position,group in enumerate(groups)}\nrng=np.random.default_rng(424242)\nbootstrap=np.zeros((400,5))\nfor draw in range(400):\n    multiplicities=np.bincount(rng.integers(len(groups),size=len(groups)),minlength=len(groups))\n    for episode in episodes:\n        for case in 'AB':\n            evidence=episode['solution']['cases'][case]\n            weights=np.array([multiplicities[index[group]] for group in evidence['resampling_components']])\n            if not weights.sum(): bootstrap[draw]-=np.ones(5)/6\n            else:\n                difference=np.array(evidence['baseline_mae_by_method_row_checkpoint']).mean(axis=2)-np.array(evidence['mae_by_row_checkpoint']).mean(axis=1)\n                bootstrap[draw]+=(difference@weights)/weights.sum()/6\nbounds=np.quantile(bootstrap,[.005,.995],axis=0)\nassert np.allclose(bounds,summary['baseline_gain_bounds'],rtol=0,atol=1e-14)\nprint('Bootstrap bounds independently reproduce retained final metrics:',bounds.min(axis=1))\nfor case in 'AB':\n    print('Case',case,'studied budget means:',arrays[case][:,-1].mean(axis=0),'aggregate comparison:',arrays[case].mean(axis=(0,2)))\nprint('All numeric summaries verified; no files written.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
