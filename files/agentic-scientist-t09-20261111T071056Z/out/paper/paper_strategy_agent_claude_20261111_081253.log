ind\": \"bernoulli\",\n    \"p\": 0.5\n   },\n   \"graph\": {\n    \"blocks\": 10,\n    \"deg_in\": 14,\n    \"deg_out\": 6,\n    \"family\": \"sbm\"\n   },\n   \"id\": 5,\n   \"mech\": {\n    \"beta\": [\n     0.8,\n     -0.5\n    ],\n    \"form\": \"fraction\",\n    \"gamma\": 4.5,\n    \"intercept\": 1.0,\n    \"sigma\": 1.0,\n    \"tau0\": 1.0,\n    \"tau1\": 0.5\n   },\n   \"name\": \"sbm_strong_bernoulli\"\n  },\n  {\n   \"design\": {\n    \"kind\": \"bernoulli\",\n    \"p\": 0.5\n   },\n   \"graph\": {\n    \"blocks\": 10,\n    \"deg_in\": 14,\n    \"deg_out\": 6,\n    \"family\": \"sbm\"\n   },\n   \"id\": 6,\n   \"mech\": {\n    \"beta\": [\n     0.8,\n     -0.5\n    ],\n    \"center\": 0.5,\n    \"form\": \"sigmoid\",\n    \"gamma\": 2.5,\n    \"intercept\": 1.0,\n#!/usr/bin/env python3\n\"\"\"final-plane evaluator: regression-based GATE estimation under network interference.\n\nSelf-contained: needs only numpy/scipy, the final resource root (``resources/final``) and\nthe harness broker.  The evaluator generates every instance itself, keeps the interference\nmechanism and the true GATE private, runs four evaluator-owned baselines, and sends the\ncandidate (through ``handle``) only the permitted dataset fields.  Per episode: exactly one\n``reset`` followed by four ``estimate`` requests (primary dataset + three matched negative\ncontrols, evaluator-private order), plus one mandatory trailing replay episode.\n\nAggregation (declared before evaluation): per primary episode e = min(|est-G|/|G|, 2);\na failed/missing episode takes e = 2 (signed +2, not covered, width 4); per-case RMSE over the\nplane's seeds (equal seed weights); plane score = unweighted mean over the 8 cases (weight 1/8);\ncombined_score = -mean.  Controls and the replay never enter combined_score.\n\"\"\"\n\nimport os\n\nfor _name in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\"):\n    os.environ.setdefault(_name, \"2\")\n\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport re\nimport resource\nimport selectors\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nimport scipy.sparse as sp\n\nPLANE = \"final\"\nSEEDS = [9001, 9002, 9003, 9004, 9005, 9006, 9007, 9008, 9009, 9010, 9011, 9012, 9013, 9014, 9015, 9016, 9017, 9018, 9019, 9020, 9021, 9022, 9023, 9024]\nWALL_SECONDS = 4800\nMAX_CANDIDATE_RPC_CALLS = 1100\n\nBROKER_PROXY_PATH = \"/broker-code/candidate_proxy.py\"\nWIRE_LIMIT = 64 * 1024 * 1024\nPAYLOAD_TARGET = 8 * 1024 * 1024\n1:@Article{Aronow2013EstimatingAC,\n8:@Article{Traxer2015DifferencesIR,\n18:@Article{Phillippo2020MultilevelNM,\n28:@Article{Wager2016HighdimensionalRA,\n38:@Article{Andrejko2021AntimicrobialRI,\n48:@Article{Rotnitzky2020EfficientAS,\n58:@Article{Chin2018RegressionAF,\n67:@Article{Ugander2020RandomizedGC,\n76:@Book{Karrer2020NetworkEA,\n84:@Article{Phillippo2021TargetEF,\n94:@Article{Forastiere2022EstimatingCE,\n104:@Article{Pinter2023EffectOD,\n114:@Article{Boyle2024LeftFC,\n124:@Article{Phillippo2022ValidatingTA,\n134:@Article{Xu2022ANM,\n143:@Inproceedings{Kurisu2024GeodesicCI,\n149:@Inproceedings{Eichhorn2024LoworderOA,\n155:@Article{Han2023ModelbasedRA,\n164:@Article{Chen2023OptimizedCD,\n172:@Inproceedings{Offer-Westort2021DesigningME,\n178:@Article{Shankar2024ABTU,\n186:@Article{Amimo2019TrendsIC,\n195:@Inproceedings{Lu2024EstimationAI,\n201:@Article{Guo2023AnalysisOR,\n210:@Inproceedings{Wagh2021StatisticalDO,\n4: title = {Estimating Average Causal Effects Under Interference Between Units},\n10: booktitle = {World journal of urology},\n13: title = {Differences in renal stone treatment and outcomes for patients treated either with or without the support of a ureteral access sheath: The Clinical Research Office of the Endourological Society Ureteroscopy Global Study},\n20: booktitle = {Journal of the Royal Stati