{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"sed -n '780,875p' task/evaluate_final.py; sed -n '713,749p' task/evaluate_final.py; sed -n '1,64p' task/evaluate_final.py; sed -n '1,180p' source_evidence/downstream/baseline/src/program.py; sed -n '55,225p' source_evidence/downstream/program/src/program.py\"","aggregated_output":"    if \"first_trace\" not in counters:\n        counters[\"first_trace\"] = {\"masks\": masks.tolist(), \"values\": values.tolist(), \"phi\": attribution.tolist()}\n    return attribution, float(abs(attribution.sum() - (values[1] - values[0]))), time.monotonic() - started, trace_hash\n\n\ndef similarity(first, second):\n    return float(1 / (1 + np.abs(first - second).sum() / max(1e-8, np.abs(second).sum())))\n\n\ndef agreements(first, second):\n    count = min(3, len(first))\n    first_order = np.argsort(-np.abs(first), kind=\"stable\")\n    second_order = np.argsort(-np.abs(second), kind=\"stable\")\n    top = len(set(first_order[:count]) & set(second_order[:count])) / count\n    first_rank = np.argsort(first_order)\n    second_rank = np.argsort(second_order)\n    rank = 1 - float(np.abs(first_rank - second_rank).sum()) / max(1, len(first)**2 // 2)\n    signs = lambda values: np.where(np.abs(values) <= 1e-8, 0, np.sign(values))\n    sign = float(np.mean(signs(first) == signs(second)))\n    return {\"top_k\": top, \"rank\": rank, \"sign\": sign, \"discrepancy_quality\": similarity(first, second)}\n\n\ndef scientific_case(episode, call, deadline, config):\n    work = config[\"method_seconds\"]\n    baseline_deadline = reserved_method_deadline(now=time.monotonic(), episode_deadline=deadline,\n                                                methods_remaining=1, work_seconds=work, cleanup_seconds=2)\n    bundle = baseline_worker({**config, \"case\": episode[\"case\"], \"seed\": episode[\"seed\"]}, baseline_deadline)\n    candidate_deadline = reserved_method_deadline(now=time.monotonic(), episode_deadline=deadline,\n                                                 methods_remaining=0, work_seconds=work, cleanup_seconds=2)\n    def bounded_call(request):\n        if time.monotonic() >= candidate_deadline:\n            raise TimeoutError(\"candidate method budget\")\n        return call(request, candidate_deadline)\n    cells = []\n    trace = []\n    totals = {\"coalitions\": 0, \"masked_rows\": 0}\n    stream = 0\n    for source in bundle[\"cells\"]:\n        if time.monotonic() >= candidate_deadline:\n            raise TimeoutError(\"candidate method budget\")\n        explained, background = source[\"input\"], source[\"background\"]\n        refs = source[\"references\"]\n        reference = source[\"exact\"] if source[\"exact\"] is not None else (refs[0] + refs[1]) / 2\n        rungs, agreement_values, fidelities, local_values = [], [], [], []\n        for budget in config[\"budgets\"]:\n            repeats = []\n            durations, residuals = [], []\n            for _ in range(config[\"repeats\"]):\n                attribution, residual, duration, digest = explain(bounded_call, bundle[\"model\"], explained, background, budget, stream, totals)\n                stream += 1\n                trace.append(digest)\n                repeats.append(attribution)\n                durations.append(duration)\n                residuals.append(residual)\n                local_values.append(1 / (1 + residual / 1e-6))\n                fidelities.append(similarity(attribution, reference) if source[\"exact\"] is not None\n                                  else .5 * (similarity(attribution, refs[0]) + similarity(attribution, refs[1])))\n            pairs = [agreements(repeats[first], repeats[second]) for first in range(len(repeats)) for second in range(first)]\n            agreement_values.extend(value[\"top_k\"] for value in pairs)\n            rungs.append({\"budget\": budget, \"phi\": [value.tolist() for value in repeats], \"pair_agreement\": pairs,\n                          \"duration_seconds\": durations, \"local_residual\": residuals})\n        averaged = []\n        average_durations = []\n        for _ in range(4):\n            attribution, _, duration, digest = explain(bounded_call, bundle[\"model\"], explained, background, config[\"budgets\"][0], stream, totals)\n            stream += 1\n            trace.append(digest)\n            averaged.append(attribution)\n            average_durations.append(duration)\n        paired_gain = similarity(np.mean(averaged, axis=0), reference) - similarity(np.array(rungs[1][\"phi\"][0]), reference)\n        metrics = {\"repeat_agreement\": float(np.mean(agreement_values)), \"reference_fidelity\": float(np.mean(fidelities)),\n                   \"local_accuracy_quality\": float(np.mean(local_values)), \"matched_budget_gain\": paired_gain,\n                   \"reference_resolution_quality\": similarity(refs[0], refs[1])}\n        cells.append({\"input_index\": source[\"input_index\"], \"background_size\": len(background),\n                      \"references\": [value.tolist() for value in refs],\n                      \"reference_counts\": source[\"reference_counts\"], \"exact_counts\": source[\"exact_counts\"],\n                      \"baseline_counts\": source[\"deployment_counts\"],\n                      \"exact\": None if source[\"exact\"] is None else source[\"exact\"].tolist(),\n                      \"baseline\": [value.tolist() for value in source[\"deployments\"]],\n                      \"rungs\": rungs, \"matched_average\": np.mean(averaged, axis=0).tolist(),\n                      \"matched_average_duration_seconds\": average_durations, \"metrics\": metrics})\n    values = {key: float(np.mean([cell[\"metrics\"][key] for cell in cells])) for key in QUALITY}\n    intervals = {}\n    generator = np.random.default_rng(812)\n    for key in QUALITY:\n        per_input = [np.mean([cell[\"metrics\"][key] for cell in cells if cell[\"input_index\"] == index]) for index in range(config[\"inputs\"])]\n        samples = [float(np.mean(generator.choice(per_input, len(per_input)))) for _ in range(200)]\n        intervals[key] = np.quantile(samples, [.025, .975]).tolist()\n    return {\"metrics\": values, \"valid\": True, \"scientific\": 1.0, \"slots\": case_slots(config, episode[\"case\"][0]),\n            \"trace\": trace, \"solution\": {\"case\": list(episode[\"case\"]), \"cells\": cells, \"input_cluster_intervals\": intervals,\n                                        \"validation_accuracy\": bundle[\"validation_accuracy\"], \"oracle_counts\": totals,\n                                        \"fit_cpu_seconds\": bundle[\"fit_cpu_seconds\"], \"training_rows\": bundle[\"training_rows\"],\n                                        \"validation_rows\": bundle[\"validation_rows\"], \"selection_rows\": bundle[\"selection_rows\"],\n                                        \"fitted_model_sha256\": bundle[\"fitted_model_sha256\"]}}\n\n\n        if category is None:\n            status = process.returncode\n            if status != 0:\n                category = \"baseline_signal\" if status < 0 else \"baseline_exit\"\n            elif type(reply) is not dict or set(reply) != {\"bundle\"}:\n                category = \"baseline_result_failure\"\n        if category is not None:\n            raise RequiredBaselineFailure(category)\n        return pickle.loads(base64.b64decode(reply[\"bundle\"], validate=True))\n    finally:\n        primary = sys.exception()\n        try:\n            try:\n                stop_process(process)\n            finally:\n                snapshot = capture.close()\n        except Exception:\n            if primary is not None:\n                primary.add_note(\"secondary baseline cleanup failure\")\n                raise primary from None\n            raise RequiredBaselineFailure(\"baseline_result_failure\") from None\n        if category is not None:\n            emit_capture(snapshot, category, \"baseline_worker\")\n            if PLANE == \"search\":\n                print(f\"baseline_status exit={status if status is not None and status >= 0 else -1} signal={-status if status is not None and status < 0 else 0}\", file=sys.stderr)\n\n\ndef checked_regression(masks, values):\n    total = values[1] - values[0]\n    design = masks[2:, :-1] - masks[2:, -1:]\n    target = values[2:] - values[0] - masks[2:, -1] * total\n    partial = np.linalg.lstsq(design, target, rcond=1e-10)[0]\n    return np.append(partial, total - partial.sum())\n\n\ndef explain(call, model, explained, background, budget, stream, counters):\n    started = time.monotonic()\n\"\"\"Self-contained evaluator. Search is a completeness proxy, not a reliability target.\n\nScientific validity, search eligibility and publication claims are distinct. Missing\nreal cases retain fixed penalties; controls and required references cannot be waived.\nOnly evaluator-owned oracle traces, recomputed regressions and matched controls\nsupport validity. No candidate internal-state or self-reported metric is trusted.\n\"\"\"\n\nimport argparse\nimport base64\nimport collections\nimport ctypes\nimport decimal\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nimport pathlib\nimport pickle\nimport re\nimport resource\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unicodedata\n\nSTARTED = time.monotonic()\nsys.dont_write_bytecode = True\nPLANE = \"final\"\nWALL = 50400\nSEEDS = [7301, 9109]\nRPC_BUDGET = 10287\nif __name__ == \"__main__\":\n    resource.setrlimit(resource.RLIMIT_AS, (4 * 1024**3, 4 * 1024**3))\n    resource.setrlimit(resource.RLIMIT_CPU, (math.ceil(WALL), math.ceil(WALL) + 1))\n    os.sched_setaffinity(0, {min(os.sched_getaffinity(0))})\nfor thread_name in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\"):\n    os.environ[thread_name] = \"1\"\nos.environ[\"NUMBA_NUM_THREADS\"] = \"1\"\n\nimport numpy as np\nimport pandas as pd\nimport shap\nfrom folktables import ACSIncome\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.ensemble import GradientBoostingClassifier, RandomForestClassifier\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import accuracy_score\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\n\nMETRICS = (\"combined_score\", \"correct\", \"coverage\", \"repeat_agreement\", \"reference_fidelity\",\n           \"local_accuracy_quality\", \"matched_budget_gain\", \"reference_resolution_quality\", \"control_pass_fraction\")\nQUALITY = (\"repeat_agreement\", \"reference_fidelity\", \"local_accuracy_quality\", \"matched_budget_gain\", \"reference_resolution_quality\")\nFEATURES = ['AGEP', 'COW', 'SCHL', 'MAR', 'OCCP', 'POBP', 'RELP', 'WKHP', 'SEX', 'RAC1P']\nCASES = [(dataset, family) for dataset in (\"german\", \"acs\") for family in (\"logistic\", \"forest\", \"boosting\")]\nWIRE = 64 * 1024 * 1024\n\"\"\"Finite-budget interventional Kernel SHAP, CPU/NumPy, handle-only API.\n\nAll requests/responses are finite JSON objects. Extra response keys are forbidden.\nSeeds are arbitrary nonnegative integers and initialize randomness, never workload.\nEvery episode starts with reset; subsequent independent explanations use start.\n\nreset: {\"op\":\"reset\",\"seed\":int} -> {\"ok\":true}. Erases all state.\nstart: {\"op\":\"start\", \"features\":int in [2,20], \"budget\":int in [32,256],\n        \"stream\":nonnegative int, \"input\":list[features],\n        \"background\":list[1..32][features], \"output\":\"positive_probability\",\n        \"value_function\":\"interventional_grouped\"}\n  Original columns are the players; numeric/string category values are opaque.\n  The evaluator masks complete original columns before training-fitted encoding.\n  Returns {\"masks\":list[budget][features]} of integer 0/1 values, first empty,\n  second full. All interior masks must be nonempty/nonfull. One live explanation;\n  start may discard prior state after a failure. No paths or model labels exist.\nobserve: {\"op\":\"observe\",\"values\":list[budget] of finite probabilities}\n  Supplies the background-averaged black-box model values in mask order.\n  Returns {\"phi\":list[features] of finite numbers, abs(value)<=1e6} on the\n  probability scale. Strings and booleans are not attribution numbers.\n  Consumes the live explanation. Solve a Shapley-kernel sampled constrained\n  regression: sampling a size proportional to 1/(size*(d-size)), then a uniform\n  subset, makes the interior least-squares weights equal. Empty/full endpoints\n  impose exact efficiency (lstsq rcond=1e-10). Regression auditing uses\n  rtol=1e-6, atol=1e-7. The evaluator checks masks, budgets, the regression,\n  synthetic exact controls and reset replay, not candidate internal claims.\n\nBudgets include endpoints, duplicates and all model evaluations. No optimization\nor metric feedback is delivered. Independent repetitions have distinct stream\nIDs; same reset/stream/settings must replay deterministically. No training,\nstate export, file exchange, or large-value transport is needed: all bounded\nmessages fit below 64 MiB including JSON/envelope/framing. Larger shapes are\ninvalid, not requests to load files. Each run has exactly start + observe RPCs.\nSearch ranks evidence completion, not a favorable reliability conclusion. The\npaper still needs real results, uncertainty, references, official conference\ntemplate/checklist and all reproduction code; this starter is not a paper.\n\"\"\"\n\nimport numpy as np\n\n_seed = 0\n_active = None\n\n\ndef handle(request):\n    global _seed, _active\n    operation = request[\"op\"]\n    if operation == \"reset\":\n        if type(request[\"seed\"]) is not int or request[\"seed\"] < 0:\n            raise ValueError(\"invalid seed\")\n        _seed = request[\"seed\"]\n        _active = None\n        return {\"ok\": True}\n    if operation == \"start\":\n        features = request[\"features\"]\n        budget = request[\"budget\"]\n        if not 2 <= features <= 20 or not 32 <= budget <= 256:\n            raise ValueError(\"unsupported shape\")\n        generator = np.random.default_rng(np.random.SeedSequence([_seed, request[\"stream\"]]))\n        sizes = np.arange(1, features)\n        probabilities = 1.0 / (sizes * (features - sizes))\n        probabilities /= probabilities.sum()\n        masks = np.zeros((budget, features), dtype=np.int64)\n        masks[1] = 1\n        for index in range(2, budget):\n            size = int(generator.choice(sizes, p=probabilities))\n            masks[index, generator.choice(features, size=size, replace=False)] = 1\n        _active = masks\n        return {\"masks\": masks.tolist()}\n    if operation == \"observe\":\n        if _active is None:\n            raise ValueError(\"no active explanation\")\n        masks = _active\n        values = np.asarray(request[\"values\"], dtype=np.float64)\n        total = values[1] - values[0]\n        design = masks[2:, :-1] - masks[2:, -1:]\n        target = values[2:] - values[0] - masks[2:, -1] * total\n        partial = np.linalg.lstsq(design, target, rcond=1e-10)[0]\n        attribution = np.append(partial, total - partial.sum())\n        _active = None\n        return {\"phi\": attribution.tolist()}\n    raise ValueError(\"unknown operation\")\n    sizes = np.arange(1, feature_count // 2 + 1, dtype=np.int64)\n    weights = 1.0 / (sizes * (feature_count - sizes))\n    weights *= np.where(2 * sizes == feature_count, 1.0, 2.0)\n    cumulative = np.cumsum(weights / weights.sum())\n    cumulative[-1] = 1.0\n    positions = (np.arange(count) + generator.random(count)) / count\n    selected = sizes[np.searchsorted(cumulative, positions, side=\"right\")]\n    generator.shuffle(selected)\n    return selected\n\n\ndef _draw_mask(feature_count, size, generator, visited):\n    \"\"\"Draw a uniformly oriented pair, without replacement within each cycle.\"\"\"\n    full_mask = (1 << feature_count) - 1\n    capacity = comb(feature_count, size)\n    if 2 * size == feature_count:\n        capacity //= 2\n    seen = visited.setdefault(size, set())\n    if len(seen) == capacity:\n        seen.clear()\n    while True:\n        columns = generator.choice(feature_count, size=size, replace=False)\n        encoded = sum(1 << int(column_index) for column_index in columns)\n        if 2 * size == feature_count:\n            encoded = min(encoded, full_mask ^ encoded)\n        if encoded not in seen:\n            seen.add(encoded)\n            break\n    if generator.integers(2):\n        encoded = full_mask ^ encoded\n    return np.asarray(\n        [(encoded >> column_index) & 1 for column_index in range(feature_count)],\n        dtype=np.int64,\n    )\n\n\ndef _coalition_design(feature_count, budget, generator):\n    \"\"\"Spend exactly budget rows, retaining rank headroom before pairing.\"\"\"\n    masks = np.zeros((budget, feature_count), dtype=np.int64)\n    masks[1] = 1\n    interior_count = budget - 2\n    pair_count = min(\n        interior_count // 2,\n        max(0, interior_count - 2 * (feature_count - 1)),\n    )\n    single_count = interior_count - 2 * pair_count\n    pair_sizes = _stratified_sizes(feature_count, pair_count, generator)\n    single_sizes = _stratified_sizes(feature_count, single_count, generator)\n    visited = {}\n    row_index = 2\n    for size in pair_sizes:\n        mask = _draw_mask(feature_count, int(size), generator, visited)\n        masks[row_index] = mask\n        masks[row_index + 1] = 1 - mask\n        row_index += 2\n    for size in single_sizes:\n        masks[row_index] = _draw_mask(feature_count, int(size), generator, visited)\n        row_index += 1\n    generator.shuffle(masks[2:])\n    return masks\n\n\ndef handle(request):\n    global _seed, _active\n    operation = request[\"op\"]\n    if operation == \"reset\":\n        if type(request[\"seed\"]) is not int or request[\"seed\"] < 0:\n            raise ValueError(\"invalid seed\")\n        _seed = request[\"seed\"]\n        _active = None\n        return {\"ok\": True}\n    if operation == \"start\":\n        features = request[\"features\"]\n        budget = request[\"budget\"]\n        if not 2 <= features <= 20 or not 32 <= budget <= 256:\n            raise ValueError(\"unsupported shape\")\n        generator = np.random.default_rng(np.random.SeedSequence([_seed, request[\"stream\"]]))\n        masks = _coalition_design(features, budget, generator)\n        _active = masks\n        return {\"masks\": masks.tolist()}\n    if operation == \"observe\":\n        if _active is None:\n            raise ValueError(\"no active explanation\")\n        masks = _active\n        values = np.asarray(request[\"values\"], dtype=np.float64)\n        total = values[1] - values[0]\n        design = masks[2:, :-1] - masks[2:, -1:]\n        target = values[2:] - values[0] - masks[2:, -1] * total\n        partial = np.linalg.lstsq(design, target, rcond=1e-10)[0]\n        attribution = np.append(partial, total - partial.sum())\n        _active = None\n        return {\"phi\": attribution.tolist()}\n    raise ValueError(\"unknown operation\")\n","exit_code":0,"status":"completed"}}
