\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sealed final comparison. (a) Paired score margin of the studied procedure over the best of four baselines with its 95\% bootstrap interval (seeded runs within cases, equal weight over cases). (b) Per-seed final scores of the procedure; horizontal lines mark the procedure's aggregate score and the best-baseline aggregate score, so per-seed dots are compared with an aggregate.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:final}{{2}{7}{Sealed final comparison. (a) Paired score margin of the studied procedure over the best of four baselines with its 95\% bootstrap interval (seeded runs within cases, equal weight over cases). (b) Per-seed final scores of the procedure; horizontal lines mark the procedure's aggregate score and the best-baseline aggregate score, so per-seed dots are compared with an aggregate}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Decomposition of the sealed final mean loss of the studied procedure into the three terms of Eq.~\eqref  {eq:loss}. The set-size and worst-slice terms are computed from the retained metrics; the marginal term is the remainder. The best baseline's total loss is shown without decomposition because its components are not retained.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:decomp}{{3}{7}{Decomposition of the sealed final mean loss of the studied procedure into the three terms of Eq.~\eqref {eq:loss}. The set-size and worst-slice terms are computed from the retained metrics; the marginal term is the remainder. The best baseline's total loss is shown without decomposition because its components are not retained}{figure.3}{}}
