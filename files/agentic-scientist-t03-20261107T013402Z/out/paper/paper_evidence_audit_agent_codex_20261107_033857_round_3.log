{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/selected/reliability.py | sed -n '111,210p'; diff -u source_evidence/sampled/reliability.py source_evidence/forest/reliability.py; diff -u source_evidence/forest/reliability.py source_evidence/selected/reliability.py; cat source_evidence/MANIFEST.json | head -80\"","aggregated_output":"   111\t    certified = topk_certified and signs_certified\n   112\t    return estimate, radius, certified\n   113\t\n   114\t\n   115\tdef sampled_kernel_masks(feature_count, count, rng):\n   116\t    \"\"\"Kernel-distributed subsets with complement pairing only for regression.\"\"\"\n   117\t    sizes = np.arange(1, feature_count)\n   118\t    probabilities = 1.0 / (sizes * (feature_count - sizes))\n   119\t    probabilities /= probabilities.sum()\n   120\t    masks = np.empty(count, dtype=np.uint32)\n   121\t    full = (1 << feature_count) - 1\n   122\t    for offset in range(0, count, 2):\n   123\t        size = int(rng.choice(sizes, p=probabilities))\n   124\t        selected = rng.choice(feature_count, size=size, replace=False)\n   125\t        mask = sum(1 << int(feature) for feature in selected)\n   126\t        masks[offset] = mask\n   127\t        if offset + 1 < count:\n   128\t            masks[offset + 1] = full ^ mask\n   129\t    return masks\n   130\t\n   131\t\n   132\tdef kernel_regression(game, masks, path_mask_count):\n   133\t    \"\"\"Importance-weight the path/kernel mixture for the SHAP kernel objective.\n   134\t\n   135\t    Path prefixes are uniform conditional on size, but not kernel-distributed\n   136\t    across sizes. Their dependence is irrelevant to the point regression; no\n   137\t    certificate is constructed from these fitted coefficients.\n   138\t    \"\"\"\n   139\t    feature_count = game.dimension\n   140\t    design = ((masks[:, None] >> np.arange(feature_count)) & 1).astype(float)\n   141\t    sizes = design.sum(axis=1).astype(int)\n   142\t    possible_sizes = np.arange(1, feature_count)\n   143\t    size_probabilities = 1.0 / (possible_sizes * (feature_count - possible_sizes))\n   144\t    size_probabilities /= size_probabilities.sum()\n   145\t    kernel_probability = size_probabilities[sizes - 1]\n   146\t    path_fraction = path_mask_count / len(masks)\n   147\t    mixture_probability = path_fraction / (feature_count - 1) + (1.0 - path_fraction) * kernel_probability\n   148\t    root_weights = np.sqrt(kernel_probability / mixture_probability)\n   149\t    empty, full = game.values([0, (1 << feature_count) - 1])\n   150\t    delta = full - empty\n   151\t    target = game.values(masks) - empty - sizes * delta / feature_count\n   152\t    basis = np.zeros((feature_count, feature_count - 1))\n   153\t    for column in range(feature_count - 1):\n   154\t        scale = math.sqrt((column + 1) * (column + 2))\n   155\t        basis[:column + 1, column] = 1.0 / scale\n   156\t        basis[column + 1, column] = -(column + 1) / scale\n   157\t    coefficients = np.linalg.lstsq((design @ basis) * root_weights[:, None], target * root_weights, rcond=1e-12)[0]\n   158\t    estimate = np.full(feature_count, delta / feature_count) + basis @ coefficients\n   159\t    estimate += (delta - estimate.sum()) / feature_count\n   160\t    return estimate\n   161\t\n   162\t\n   163\tdef explain_fixed_game(model, query, budget, rng, predict):\n   164\t    \"\"\"Spend at most the requested nontrivial-coalition sampling budget.\n   165\t\n   166\t    Resolved logistic games use bounded deterministic quadrature. Otherwise\n   167\t    one quarter of a nonexhaustive budget is reserved for a fixed number of\n   168\t    independent paths when two paths fit. All sampled masks also enter the\n   169\t    probability-scale Kernel SHAP point estimate. Return the path mean only\n   170\t    when its signed top-k certificate passes; otherwise retain regression.\n   171\t    Certificate decisions and costs are internal, not extra RPC fields.\n   172\t    \"\"\"\n   173\t    if model['kind'] == 'forest':\n   174\t        return exact_forest_shapley(model, query)\n   175\t    game = FrozenProbabilityGame(model, query, predict)\n   176\t    feature_count = game.dimension\n   177\t    if model['kind'] == 'affine':\n   178\t        return np.asarray(model['parameters']['coef']) * (game.query - game.background.mean(axis=0))\n   179\t    if budget >= (1 << feature_count) - 2:\n   180\t        return exact_shapley(game)\n   181\t    if model['kind'] == 'logistic':\n   182\t        integrated_phi = logistic_fourier_shapley(model, query)\n   183\t        if integrated_phi is not None:\n   184\t            return integrated_phi\n   185\t    path_count = budget // (4 * (feature_count - 1))\n   186\t    path_masks = np.empty(0, dtype=np.uint32)\n   187\t    path_estimate = None\n   188\t    certified = False\n   189\t    if path_count >= 2:\n   190\t        path_marginals, path_masks = independent_paths(game, path_count, rng)\n   191\t        path_estimate, radius, certified = simultaneous_certificate(path_marginals)\n   192\t    remaining = budget - len(path_masks)\n   193\t    kernel_masks = sampled_kernel_masks(feature_count, remaining, rng)\n   194\t    masks = np.concatenate((path_masks, kernel_masks))\n   195\t    if certified:\n   196\t        return path_estimate\n   197\t    return kernel_regression(game, masks, len(path_masks))\n--- source_evidence/sampled/reliability.py\t2026-11-07 03:56:40.873765293 +0000\n+++ source_evidence/forest/reliability.py\t2026-11-07 03:56:40.875519247 +0000\n@@ -4,6 +4,8 @@\n \n import numpy as np\n \n+from forest import exact_forest_shapley\n+\n \n class FrozenProbabilityGame:\n     \"\"\"Mask original supplied columns, without refitting or resampling background.\n@@ -166,6 +168,8 @@\n     when its signed top-k certificate passes; otherwise retain regression.\n     Certificate decisions and costs are internal, not extra RPC fields.\n     \"\"\