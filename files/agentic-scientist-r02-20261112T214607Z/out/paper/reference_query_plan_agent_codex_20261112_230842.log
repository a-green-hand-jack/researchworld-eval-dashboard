ask_contract.json:8:    \"class\": \"train_only_local_scale_split_conformal\",\ntask/task_contract.json:9:    \"description\": \"Continuous logistic-normal compositional responses, dimensions3/10, H interior homoscedastic, B boundary heteroscedastic, S covariate shift. Shared train-only ILR ridge center; candidate fits positive residual-scale regression from designated scale training examples only. Evaluator owns calibration, raw L-infinity, Bonferroni, global ILR, uncalibrated training-quantile, full-simplex and singleton geometries. Reliability/efficiency evidence may be negative or inconclusive. No learning/adaptivity/superiority gate is inferred from state flags or aspirational publication claims.\"\ntask/task_contract.json:53:        \"name\": \"reference_mass\",\ntask/task_contract.json:57:        \"name\": \"global_ilr_score_gap\",\ntask/task_contract.json:87:        \"name\": \"reference_mass\",\ntask/task_contract.json:91:        \"name\": \"global_ilr_score_gap\",\ntask/task_contract.json:153:        \"source\": \"Task-owned original logistic-normal-v1 generator; canonical f64 raw-content manifests\"\ntask/task_contract.json:157:        \"path\": \"resources/final/production-B10-1009.json\",\ntask/task_contract.json:159:        \"source\": \"Task-owned original logistic-normal-v1 generator; canonical f64 raw-content manifests\"\ntask/task_contract.json:163:        \"path\": \"resources/final/production-B10-2003.json\",\ntask/task_contract.json:165:        \"source\": \"Task-owned original logistic-normal-v1 generator; canonical f64 raw-content manifests\"\ntask/task_contract.json:169:        \"path\": \"resources/final/production-B10-3001.json\",\ntask/task_contract.json:171:        \"source\": \"Task-owned original logistic-normal-v1 generator; canonical f64 raw-content manifests\"\ntask/task_contract.json:175:        \"path\": \"resources/final/production-B10-4001.json\",\ntask/task_contract.json:177:        \"source\": \"Task-owned original logistic-nor