{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/downstream/program/src/program.py | sed -n '45,115p'; nl -ba source_evidence/evaluate_final.py | sed -n '694,812p'\"","aggregated_output":"    45\tbias=optimism=width=reversal=failure=1. Search and final correct separately require\n    46\tcomplete valid experiments/controls and deterministic replay, NOT superiority,\n    47\tsignificance or a positive finding. Publication additionally requires a supported\n    48\tpaper and reproducibility code; search eligibility does not certify these claims.\n    49\tMethods may change this policy, not the estimator or hidden evaluation objectives.\n    50\tAll complete JSON messages must stay below 8 MiB operationally and 64 MiB on wire.\n    51\t\"\"\"\n    52\timport random\n    53\t\n    54\tDEFAULT_PROMPT = 'Answer the multiple-choice question. Return only the correct option letter A through J.'\n    55\t_random = None\n    56\t_updated = False\n    57\t\n    58\tdef prompt_bank():\n    59\t    variants = [\n    60\t        'Choose the best answer. Output only its capital letter.',\n    61\t        'Solve the question carefully, then give only the option letter.',\n    62\t        'Identify the correct option. Respond with a single capital letter.',\n    63\t        'Consider each option and select the best one. Print the letter only.',\n    64\t        'Your answer must consist solely of the correct choice letter.',\n    65\t        'Read the question and choices. Return the correct letter, no explanation.',\n    66\t        'Select one answer from the provided options. Give only its letter.',\n    67\t        'Please answer this multiple-choice question using one capital letter.',\n    68\t        'Determine which option is most accurate. Output the letter only.',\n    69\t        'Choose the single best option; omit all text except its capital letter.',\n    70\t        'Evaluate the alternatives. Give the correct answer as its option letter.',\n    71\t        'Respond to this question with the letter of the best available answer.',\n    72\t        'Find the right answer among the listed choices. Return only its letter.',\n    73\t        'Pick the most appropriate answer and output its capital letter alone.',\n    74\t        'Answer accurately. Use only the capital letter identifying your choice.',\n    75\t    ]\n    76\t    return [DEFAULT_PROMPT] + variants\n    77\t\n    78\tdef handle(request):\n    79\t    global _random, _updated\n    80\t    if type(request) is not dict:\n    81\t        raise ValueError('request must be an object')\n    82\t    if request.get('op') == 'reset':\n    83\t        if set(request) != {'op', 'seed'} or type(request['seed']) is not int or not 0 <= request['seed'] < 2**63:\n    84\t            raise ValueError('invalid reset')\n    85\t        _random = random.Random(request['seed'])\n    86\t        _updated = False\n    87\t        return {'ok': True}\n    88\t    if request.get('op') != 'update' or set(request) != {'op', 'arms', 'slots', 'confidence'} or _random is None or _updated:\n    89\t        raise ValueError('expected one update after reset')\n    90\t    arms = request['arms']\n    91\t    slots = request['slots']\n    92\t    if type(arms) is not int or not 1 <= arms <= 16 or request['confidence'] != .95 or type(slots) is not list or len(slots) < 4 or len(slots) % 4:\n    93\t        raise ValueError('invalid workload')\n    94\t    keys = [slot['key'] for slot in slots]\n    95\t    if len(set(keys)) != len(keys):\n    96\t        raise ValueError('duplicate slots')\n    97\t    _random.shuffle(keys)\n    98\t    midpoint = len(keys) // 2\n    99\t    report = keys[midpoint:]\n   100\t    _updated = True\n   101\t    return {'prompts': prompt_bank(), 'selection': keys[:midpoint], 'report': report,\n   102\t            'weights': [1 / len(report)] * len(report), 'tie_order': list(range(arms))}\n   694\tdef load_resources(root,smoke):\n   695\t    runtime=json.loads((root/'runtime_manifest.json').read_text())\n   696\t    for relative,expected in runtime['sha256'].items():\n   697\t        path=root/relative\n   698\t        checksum=hashlib.sha256()\n   699\t        with path.open('rb') as stream:\n   700\t            for block in iter(lambda:stream.read(1024*1024),b''):\n   701\t                checksum.update(block)\n   702\t        if checksum.hexdigest()!=expected:\n   703\t            raise RuntimeError('immutable resource checksum mismatch')\n   704\t    manifest=json.loads((root/'split_manifest.json').read_text())\n   705\t    rows=json.loads((root/('smoke_examples.json' if smoke and PLANE=='final' else 'examples.json')).read_text())\n   706\t    other_stems=set(manifest['other_stem_hashes'])\n   707\t    other_content=set(manifest['other_content_hashes'])\n   708\t    seen=set()\n   709\t    for row in rows:\n   710\t        stem=digest(normalized(row['question']))\n   711\t        content=digest([normalized(row['question']),sorted(map(normalized,row['options']))])\n   712\t        if stem!=row['stem_hash'] or content!=row['content_hash'] or stem in seen or stem in other_stems or content in other_content:\n   713\t            raise RuntimeError('normalized raw-content split audit failed')\n   714\t        seen.add(stem)\n   715\t    return rows,json.loads((root/'synthetic_manifest.json').read_text())\n   716\t\n   717\tdef validate_plan(response,request):\n   718\t    if type(response) is not dict or set(response)!={'prompts','selection','report','weights','tie_order'}:\n   719\t        raise ProtocolFailure('invalid plan keys')\n   720\t    prompts=response['prompts']\n   721\t    if type(prompts) is not list or len(prompts)!=16 or any(type(prompt) is not str for prompt in prompts) or len(set(prompts))!=16 or prompts[0]!=DEFAULT_PROMPT:\n   722\t        raise ProtocolFailure('invalid prompt bank')\n   723\t    for prompt in prompts:\n   724\t        try:\n   725\t            byte_length=len(prompt.encode('utf-8'))\n   726\t        except UnicodeError as error:\n   727\t            raise ProtocolFailure('invalid prompt Unicode') from error\n   728\t        if not 1<=byte_length<=4096 or any(ord(char)<32 and char not in '\\n\\t' for char in prompt):\n   729\t            raise ProtocolFailure('invalid prompt text')\n   730\t        if re.search(r'(?:[0-9a-f]{32,}|https?://|question_id|answer_index)',prompt,re.I):\n   731\t            raise ProtocolFailure('example-specific prompt lookup forbidden')\n   732\t    keys=[slot['key'] for slot in request['slots']]\n   733\t    selection,report=response['selection'],response['report']\n   734\t    if any(type(part) is not list or any(type(key) is not str for key in part) for part in [selection,report]):\n   735\t        raise ProtocolFailure('invalid partition')\n   736\t    if not len(keys)/4<=len(selection)<=3*len(keys)/4 or not report or len(selection)+len(report)!=len(keys) or len(set(selection+report))!=len(keys) or set(selection+report)!=set(keys):\n   737\t        raise ProtocolFailure('partition is not exhaustive and disjoint')\n   738\t    weights=response['weights']\n   739\t    if type(weights) is not list or len(weights)!=len(report) or any(type(weight) not in (int,float) or not math.isfinite(weight) or not math.isclose(weight,1/len(report),rel_tol=0,abs_tol=1e-12) for weight in weights):\n   740\t        raise ProtocolFailure('report weights must be uniform')\n   741\t    order=response['tie_order']\n   742\t    if type(order) is not list or any(type(arm) is not int for arm in order) or sorted(order)!=list(range(request['arms'])):\n   743\t        raise ProtocolFailure('invalid tie order')\n   744\t    return response\n   745\t\n   746\tdef wilson(mean,count):\n   747\t    variance=mean*(1-mean)/count+1.959963984540054**2/(4*count*count)\n   748\t    denominator=1+1.959963984540054**2/count\n   749\t    center=(mean+1.959963984540054**2/(2*count))/denominator\n   750\t    half=1.959963984540054*math.sqrt(max(0,variance))/denominator\n   751\t    return center-half,center+half\n   752\t\n   753\tdef estimate(matrix,selection,report,order,weights=None):\n   754\t    import numpy as np\n   755\t    means=matrix[selection].mean(axis=0)\n   756\t    winner=max(order,key=lambda arm:means[arm])\n   757\t    reported=float(matrix[report,winner].mean()) if weights is None else float(np.dot(matrix[report,winner],weights))\n   758\t    return winner,reported,float(means[winner]),wilson(reported,len(report))\n   759\t\n   760\tdef summarize(matrix,truth,selection,report,order,random_arm):\n   761\t    import numpy as np\n   762\t    size,arms=matrix.shape\n   763\t    indices=list(range(size))\n   764\t    candidate=estimate(matrix,selection,report,order,[1/len(report)]*len(report))\n   765\t    winner,reported,reused,interval=candidate\n   766\t    full=estimate(matrix,indices,indices,list(range(arms)))\n   767\t    half=estimate(matrix,indices[:size//2],indices[size//2:],list(range(arms)))\n   768\t    fixed=float(matrix[:,0].mean())\n   769\t    random=float(matrix[:,random_arm].mean())\n   770\t    target=float(truth[winner])\n   771\t    result={\n   772\t        'report_mse':(reported-target)**2,'reuse_mse':(reused-target)**2,\n   773\t        'full_budget_naive_mse':(full[1]-float(truth[full[0]]))**2,\n   774\t        'honest_half_mse':(half[1]-float(truth[half[0]]))**2,\n   775\t        'fixed_prompt_mse':(fixed-float(truth[0]))**2,\n   776\t        'random_prompt_mse':(random-float(truth[random_arm]))**2,\n   777\t        'selected_accuracy':target,'report_bias':reported-target,'signed_optimism':reused-target,\n   778\t        'coverage':float(interval[0]<=target<=interval[1]),'interval_width':interval[1]-interval[0],\n   779\t        'decision_reversal_rate':float((reported-fixed)*(target-float(truth[0]))<0),\n   780\t        'failure_rate':0.0,'control_failure_rate':0.0}\n   781\t    return result,{'winner':winner,'report':reported,'target':target,'reuse':reused,'interval':list(interval),'full_naive':[full[0],full[1],float(truth[full[0]])],'honest_half':[half[0],half[1],float(truth[half[0]])],'fixed':[fixed,float(truth[0])],'random':[random_arm,random,float(truth[random_arm])]}\n   782\t\n   783\tEXPECTED_CONTROLS={'constant','copy_arm','copy_report','permuted_input'}\n   784\t\n   785\tdef controls(matrix,selection,report,order,permuted,effective_changes):\n   786\t    import numpy as np\n   787\t    completed=set()\n   788\t    observations={}\n   789\t    for name,transformed in [('constant',np.zeros_like(matrix)),('copy_arm',np.repeat(matrix[:,:1],matrix.shape[1],axis=1))]:\n   790\t        winner,value,reused,interval=estimate(transformed,selection,report,order)\n   791\t        if winner!=order[0] or not np.all(transformed==transformed[:,:1]):\n   792\t            raise ProtocolFailure('constant/copy-arm control failed')\n   793\t        completed.add(name)\n   794\t        observations[name]={'winner':winner,'report':value,'reuse':reused}\n   795\t    copied=estimate(matrix,selection,selection,order)\n   796\t    if not set(selection).intersection(selection) or copied[1]!=copied[2]:\n   797\t        raise ProtocolFailure('copy-report independence control failed')\n   798\t    completed.add('copy_report')\n   799\t    observations['copy_report']={'report':copied[1],'independence_audit_passed':False}\n   800\t    if effective_changes<2 or permuted.shape!=matrix.shape:\n   801\t        raise ProtocolFailure('vacuous permutation control')\n   802\t    shuffled=estimate(permuted,selection,report,order)\n   803\t    observations['permuted_input']={'winner':shuffled[0],'report':shuffled[1],'changed_assignments':effective_changes}\n   804\t    completed.add('permuted_input')\n   805\t    if EXPECTED_CONTROLS-completed:\n   806\t        raise ProtocolFailure('missing control')\n   807\t    return observations\n   808\t\n   809\tdef worst_case(episode):\n   810\t    values={name:1.0 for name in ORDINARY}\n   811\t    for name in ['selected_accuracy','coverage']:\n   812\t        values[name]=0.0\n","exit_code":0,"status":"completed"}}
