\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Accounting and separation must be read together. Left: the same verified edits as global and target-exposure percentages (log axis). Right: original gaps with 2.5th--97.5th percentile bands from 200 empirical row resamples for Arena/NBA or question-cluster resamples for MT. These change the comparison schedule and keep originally selected targets fixed; the bands are descriptive, not post-selection-valid or simultaneous confidence intervals and not uncertainty in a minimum flip budget. Source: \texttt  {src/report.py}, \texttt  {artifacts/baseline.csv}, and \texttt  {artifacts/uncertainty.csv}.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:budget}{{1}{5}{Accounting and separation must be read together. Left: the same verified edits as global and target-exposure percentages (log axis). Right: original gaps with 2.5th--97.5th percentile bands from 200 empirical row resamples for Arena/NBA or question-cluster resamples for MT. These change the comparison schedule and keep originally selected targets fixed; the bands are descriptive, not post-selection-valid or simultaneous confidence intervals and not uncertainty in a minimum flip budget. Source: \texttt {src/report.py}, \texttt {artifacts/baseline.csv}, and \texttt {artifacts/uncertainty.csv}}{figure.1}{}}
