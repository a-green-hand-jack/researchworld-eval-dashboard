{
  "schema_version": 1,
  "uncertainty": "200 paired family-clustered bootstrap draws with fixed evaluator RNG24681357, 2.5/97.5 percentile endpoints. Draw family multiplicities per source shared across paired candidate/random-lowrank rows, cases and seeds; preserve equal case, seed and source weights. Zero sampled mass for a case-seed contributes0 rather than dropping its weight; any incomplete required actual episode gives conservative interval[-1,1].",
  "work_reservations": "Search: setup180s + finish30s +25*(reset2s +6*(productive allowance8s + bookkeeping0.05s) + cleanup/dispatch1.5s)=1505s <=1800s. Final: setup300s +finish30s +25*(reset2s +6*(productive allowance16s +bookkeeping0.05s) +cleanup/dispatch1.5s)=2825s <=3600s. No canonical minimum productive baseline duration exists. Native cleanup bound0.4 terminate/reap +0.4 kill/reap +0.4 stderr drain; no baseline subprocess exists. Monotonic scheduler reserves all remaining resets and finish time globally.",
  "aggregation": "target equal; row equal; checkpoint equal (MTEB 1/4, OLL 1/3); seed equal (1/3 production, identity smoke); case equal 1/2 per source; source equal 1/2. Controls parallel with zero weight in combined_score. Replay zero primary weight. Failed episodes score 0, gaps -1, CI [-1,1], original denominator retained.",
  "controls": {
    "constant": "evaluator historical means invariant to observation values",
    "copy": "evaluator mean plus purchased mean offset",
    "permuted": "actual candidate runs independently deranged historical columns with marginals and missingness preserved; >=2 altered nonconstant columns and disrupted row correspondence; no guaranteed score loss, lack of positive gap prohibits structure attribution, not eligibility",
    "reset": "single final replay of first actual episode; legal queries identical and clipped predictions atol1e-10 rtol0"
  },
  "limits": {
    "max_rows": 8192,
    "max_columns": 1024,
    "chunk_rows": 256,
    "max_chunks": 32,
    "batch_rows": 128,
    "wire_limit": 67108864,
    "state_transfers": "train_start + up to32 train_chunk + train_commit; fit separately. No state exports or shared files."
  },
  "normalization": "Natural [0,1] original main_score / OLL Raw; clip predictions only. No normalization fitted on test.",
  "fit": "Masked alternating ridge lambda0.1; ranks1,2,4,8 selected with deterministic 10% historical-cell validation; max4 validation sweeps and8 refit sweeps, capped by requested steps. Ridge lambda from0.01,0.1,1 on historical every5th-row validation. Medoid order descending sum absolute historical imputed correlations. Equal per-method wall allowance; no task.md productive-time floor exists.",
  "runtime": "CPython 3.12.15 Linux x86_64 validated; Python>=3.11 supported. NumPy1.26.4 SciPy1.12.0 PyArrow16.1.0. Baselines evaluator-local, one BLAS thread. Candidate<=3 threads; native Landlock ABI>=1 and seccomp x86_64 mandatory; broker isolation mandatory production. Candidate scratch filesystem read-only; all protocol state RAM.",
  "limitations": [
    "Task paper, official latest conference template/checklist, independently read literature and publication claim review remain downstream research deliverables, not generated paper claims.",
    "Conservative naming families may miss cross-namespace lineages; no claim of biological family ground truth.",
    "MTEB comparable columns distinguish dataset revision and default/English subset. Historical validation uses held-out cells rather than nested full model-group CV; this is an initial best-shot operational scaffold.",
    "OpenLLM dataset license is undeclared: public access is not a redistribution license; private research cache only.",
    "Full raw score documents are hashed during acquisition; runtime verifies frozen extracted model-example hashes and acquisition audit, not a live reread of upstream documents. Reproduction must reacquire pinned source.",
    "No interface supplies internals: candidate mechanism attribution requires independent code review, not a state report. No candidate state flags are requested or trusted."
  ],
