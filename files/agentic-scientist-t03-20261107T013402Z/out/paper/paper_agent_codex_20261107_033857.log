{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,110p' task/capture.py; rg -n 'def tree|tree_sha|sha256.*tree' task/evaluate_final.py ../investigation/outer_state.json | head -12; diff -q paper.sty template_evidence/iclr2026_conference.sty; rg -n 'textwidth|textheight|2026|submitted|iclrfinal' template_evidence/iclr2026_conference.sty; sed -n '1,115p' .codex/skills/validate-paper/scripts/validate_tex_refs.py; sed -n '1,70p' .codex/skills/validate-paper/scripts/validate_figures.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,110p' task/capture.py; rg -n 'def tree|tree_sha|sha256.*tree' task/evaluate_final.py ../investigation/outer_state.json | head -12; diff -q paper.sty template_evidence/iclr2026_conference.sty; rg -n 'textwidth|textheight|2026|submitted|iclrfinal' template_evidence/iclr2026_conference.sty; sed -n '1,115p' .codex/skills/validate-paper/scripts/validate_tex_refs.py; sed -n '1,70p' .codex/skills/validate-paper/scripts/validate_figures.py\"","aggregated_output":"\"\"\"Safe output-capture compatibility and reproducible public-data acquisition.\n\nImporting this module performs no capture, I/O or network access. To recapture:\npython capture.py --source_dir /tmp/public-source --output_root /tmp/new-resources\nThe source directory must contain german.zip, ca.zip, ny.zip, acs.py,\nfolktables-LICENSE, census-site-policy.html, census-terms.html,\ndictionary2024.pdf and relshipp2024.json obtained from\nexact URLs recorded in each frozen provenance.json. Acquisition is drafting-only.\n\"\"\"\nimport contextlib\nimport csv\nimport decimal\nimport gzip\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport unicodedata\nimport zipfile\n\n\nclass OutputCapture:\n    def __init__(self):\n        self.stdout = io.StringIO()\n        self.stderr = io.StringIO()\n        self._stack = None\n\n    def __enter__(self):\n        self._stack = contextlib.ExitStack()\n        self._stack.enter_context(contextlib.redirect_stdout(self.stdout))\n        self._stack.enter_context(contextlib.redirect_stderr(self.stderr))\n        return self\n\n    def __exit__(self, exc_type, exc_value, traceback):\n        return self._stack.__exit__(exc_type, exc_value, traceback)\n\n    def get_output(self):\n        return self.stdout.getvalue(), self.stderr.getvalue()\n\n\ndef encode(value):\n    return json.dumps(value,ensure_ascii=False,allow_nan=False,separators=(',',':'),sort_keys=True).encode('utf-8')\n\n\ndef digest(value):\n    return hashlib.sha256(encode(value)).hexdigest()\n\n\ndef number(value):\n    if value is None or not str(value).strip():\n        return None\n    numeric = decimal.Decimal(str(value).strip())\n    if not numeric.is_finite():\n        return None\n    return '0' if numeric == 0 else format(numeric.normalize(),'f')\n\n\ndef normalize(row, numeric):\n    return [None if value is None or not str(value).strip() else\n            ['number',number(value)] if index in numeric else\n            ['text',' '.join(unicodedata.normalize('NFKC',str(value)).split())]\n            for index,value in enumerate(row)]\n\n\ndef partition(groups, salt, limit=None):\n    ordered = sorted(groups,key=lambda item:hashlib.sha256((salt+item['content_sha256']).encode()).digest())\n    if limit is not None:\n        ordered = ordered[:limit]\n    count = len(ordered)\n    for index,record in enumerate(ordered):\n        record['role'] = 'train' if index < int(.6*count) else 'validation' if index < int(.8*count) else 'explanation'\n    return ordered\n\n\ndef acquire(source, output):\n    numeric_german = {1,4,7,10,12,15,17}\n    with zipfile.ZipFile(source/'german.zip') as archive:\n        rows = archive.read('german.data').decode().splitlines()\n    grouped = {}\n    for index,line in enumerate(rows):\n        tokens = line.split()\n        normalized = normalize(tokens[:-1],numeric_german)\n        content = digest(normalized)\n        provenance = {'row':index+1,'source_id':f'uci144:{index+1}','full_record_sha256':digest(tokens)}\n        if content not in grouped:\n            grouped[content] = {'raw':tokens[:-1],'y':int(tokens[-1]) == 2,'content_sha256':content,'provenance':[],'conflicting_labels':False}\n        record = grouped[content]\n        record['conflicting_labels'] |= record['y'] != (int(tokens[-1]) == 2)\n        record['provenance'].append(provenance)\n    all_german = sorted(grouped.values(),key=lambda item:hashlib.sha256(('german-plane-2026'+item['content_sha256']).encode()).digest())\n    midpoint = len(all_german)//2\n    german = {'search':partition(all_german[:midpoint],'german-within-2026'),\n              'final':partition(all_german[midpoint:],'german-within-2026')}\n    features = ['AGEP','COW','SCHL','MAR','OCCP','POBP','RELSHIPP','WKHP','SEX','RAC1P']\n    populations = {}\n    raw_hashes = {}\n    stats = {}\n    for plane,state in [('search','ca'),('final','ny')]:\n        groups = {}\n        seen = set()\n        total = 0\n        included = 0\n        with zipfile.ZipFile(source/f'{state}.zip') as archive:\n            members = sorted(name for name in archive.namelist() if name.lower().endswith('.csv'))\n            for member in members:\n                with archive.open(member) as stream:\n                    reader = csv.DictReader(io.TextIOWrapper(stream,encoding='utf-8-sig',newline=''))\n                    for index,row in enumerate(reader):\n                        total += 1\n                        raw = [row[name] for name in features]\nFiles paper.sty and template_evidence/iclr2026_conference.sty differ\n28:% Define iclrfinal, set to true if iclrfinalcopy is defined\n29:\\newif\\ificlrfinal\n30:\\iclrfinalfalse\n31:\\def\\iclrfinalcopy{\\iclrfinaltrue}\n48:\\textheight 9.0 true in       % Height of text (including footnotes & figures)\n49:\\textwidth 5.5 true in        % Width of text line.\n83:\\def\\@maketitle{\\vbox{\\hsize\\textwidth\n87:\\ificlrfinal\n88:    \\lhead{Published as a conference paper at ICLR 2026}\n95:       \\lhead{Under review as a conference paper at ICLR 2026}\n215:\\textheight=#5\\vbadness=10000\\vfuzz=120ex\\overfullrule=0pt%\n216:\\global\\setbox\\iclrrulerbox=\\vbox to \\textheight{%\n217:{\\parskip=0pt\\hfuzz=150em\\cv@boxheight=\\textheight\n229:\\def\\iclrruler#1{\\makevruler[12pt][#1][1][3][0.993\\textheight]\\usebox{\\iclrrulerbox}}\n231:\\ificlrfinal\\else\n232:\\iclrruleroffset=\\textheight\n245:% \\colorbox[rgb]{0.7,0.7,0.7}{\\small \\parbox[b][\\textheight]{0.1cm}{}}}\n#!/usr/bin/env python3\n\"\"\"Validate that paper citations align with bibliography entries.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport re\nfrom pathlib import Path\n\nSECTION_PATTERNS = {\n    \"abstract\": re.compile(\n        r\"\\\\begin\\{abstract\\}|\\\\section\\*?\\{[^}]*abstract[^}]*\\}\",\n        re.IGNORECASE,\n    ),\n    \"introduction\": re.compile(r\"\\\\section\\*?\\{[^}]*introduction[^}]*\\}\", re.IGNORECASE),\n    \"related work\": re.compile(r\"\\\\section\\*?\\{[^}]*related work[^}]*\\}\", re.IGNORECASE),\n    \"method\": re.compile(r\"\\\\section\\*?\\{[^}]*method[^}]*\\}\", re.IGNORECASE),\n    \"results\": re.compile(r\"\\\\section\\*?\\{[^}]*results[^}]*\\}\", re.IGNORECASE),\n    \"conclusion\": re.compile(r\"\\\\section\\*?\\{[^}]*conclusion[^}]*\\}\", re.IGNORECASE),\n    \"references\": re.compile(\n        r\"\\\\bibliography\\{|\\\\printbibliography|\\\\begin\\{thebibliography\\}|\\\\section\\*?\\{[^}]*references[^}]*\\}\",\n        re.IGNORECASE,\n    ),\n}\nCITE_RE = re.compile(r\"\\\\cite[a-zA-Z*]*\\{([^}]+)\\}\")\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nSUPPLEMENT_HEADING_RE = re.compile(\n    r\"\\\\section\\s*\\{\\s*supplementary\\s+information\\s*\\}\",\n    re.IGNORECASE,\n)\nBIBLIOGRAPHY_RE = re.compile(\n    r\"\\\\bibliography\\s*\\{[^}]+\\}|\\\\printbibliography\\b(?:\\[[^\\]]*\\])?\"\n    r\"|\\\\begin\\s*\\{thebibliography\\}\",\n    re.IGNORECASE,\n)\nCLEARPAGE_RE = re.compile(r\"\\\\clearpage\\b\", re.IGNORECASE)\nNEXT_SECTION_RE = re.compile(r\"\\\\section\\*?\\s*(?:\\[[^\\[\\]]*\\]\\s*)?\\{\")\nLET_SECTION_ALIAS_RE = re.compile(\n    r\"\\\\let\\s*\\\\[a-zA-Z@]+\\s*=?\\s*\\\\section\\b\", re.IGNORECASE\n)\nNEWCOMMAND_DEFINITION_RE = re.compile(\n    r\"\\\\(?:newcommand|renewcommand)\\*?\\s*\\{\", re.IGNORECASE\n)\nDEF_DEFINITION_RE = re.compile(\n    r\"\\\\(?:def|gdef|edef|xdef)\\s*\\\\[a-zA-Z@]+\", re.IGNORECASE\n)\nTEX_IMPORT_RE = re.compile(r\"\\\\(?:input|include)\\b\", re.IGNORECASE)\nSUBSTANTIVE_SUPPLEMENT_RE = re.compile(\n    r\"\\\\subsection\\*?\\s*\\{|\\\\begin\\s*\\{(?:table|figure)\\*?\\}\",\n    re.IGNORECASE,\n)\nSUPPLEMENT_PLACEHOLDER_TEXTS = (\n    \"add supplementary material only when grounded artifacts support it\",\n    \"replace with grounded extended methods, reproducibility details, additional analyses, or supporting tables and figures\",\n)\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\[a-zA-Z@]+\")\nNEWIF_RE = re.compile(r\"\\\\newif\\s*(?P<name>\\\\if[a-zA-Z@]+)\")\nCONDITIONAL_OPENERS = frozenset(\n    {\n        r\"\\if\",\n        r\"\\ifcase\",\n        r\"\\ifcat\",\n        r\"\\ifcondition\",\n        r\"\\ifcsname\",\n        r\"\\ifdefined\",\n        r\"\\ifdim\",\n        r\"\\ifeof\",\n        r\"\\iffalse\",\n        r\"\\iffontchar\",\n        r\"\\ifhbox\",\n        r\"\\ifhmode\",\n        r\"\\ifincsname\",\n        r\"\\ifinner\",\n        r\"\\ifluatex\",\n        r\"\\ifmmode\",\n        r\"\\ifnum\",\n        r\"\\ifodd\",\n        r\"\\ifpdf\",\n        r\"\\ifpdfabsdim\",\n        r\"\\ifpdfabsnum\",\n        r\"\\ifpdfprimitive\",\n        r\"\\iftrue\",\n        r\"\\ifvbox\",\n        r\"\\ifvmode\",\n        r\"\\ifvoid\",\n        r\"\\ifx\",\n        r\"\\ifxetex\",\n    }\n)\nNON_CONDITIONAL_IF_MACROS = frozenset(\n    {\n        r\"\\ifblank\",\n        r\"\\ifbool\",\n        r\"\\ifboolexpr\",\n        r\"\\ifcsdef\",\n        r\"\\ifcsempty\",\n        r\"\\ifcsequal\",\n        r\"\\ifcsmacro\",\n        r\"\\ifcsparam\",\n        r\"\\ifcsprotected\",\n        r\"\\ifcsstring\",\n        r\"\\ifcsundef\",\n        r\"\\ifcsvoid\",\n        r\"\\ifdimcomp\",\n        r\"\\ifdimequal\",\n        r\"\\ifdimgreater\",\n        r\"\\ifdimless\",\n        r\"\\ifdef\",\n        r\"\\ifdefempty\",\n        r\"\\ifdefequal\",\n        r\"\\ifdefltxprotect\",\n        r\"\\ifdefmacro\",\n        r\"\\ifdefparam\",\n        r\"\\ifdefprotected\",\n        r\"\\ifdefstring\",\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_41","type":"reasoning","text":"**Inspecting source settings**\n**Extracting evaluator caps**\n**Computing seed ranges**"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/sh -lc 'cp template_evidence/iclr2026_conference.sty paper.sty; cp template_evidence/iclr2026_conference.bst paper.bst; cp task/capture.py source_evidence/evaluation/capture.py; apply_patch() { codex --codex-run-as-apply-patch \"$(cat)\"; }\napply_patch <<'\"'PATCH'\n*** Begin Patch\n*** Add File: build_artifacts.py\n+import ast\n+import hashlib\n+import json\n+from pathlib import Path\n+\n+import matplotlib\n+matplotlib.use('Agg')\n+import matplotlib.pyplot as plt\n+import numpy as np\n+from PIL import Image, ImageDraw\n+\n+\n+ROOT = Path(__file__).resolve().parent\n+COLORS = {'standard': '#c17b14', 'multistart': '#956ba5', 'structure': '#176b8c'}\n+CASE_NAMES = {'german_logistic': 'German / logistic', 'german_forest': 'German / forest', 'acs_logistic': 'ACS / logistic', 'acs_forest': 'ACS / forest'}\n+plt.rcParams.update({'font.size': 10, 'axes.labelsize': 10, 'axes.titlesize': 10, 'xtick.labelsize': 9, 'ytick.labelsize': 9, 'legend.fontsize': 9, 'pdf.fonttype': 42, 'ps.fonttype': 42, 'axes.spines.top': False, 'axes.spines.right': False})\n+\n+\n+def provenance(path, inputs):\n+    manifest = {'schema_name': 'scientific-evidence.artifact-manifest', 'artifact': {'path': str(path), 'kind': 'figure' if str(path).endswith(('.png', '.pdf')) else 'derived', 'sha256': hashlib.sha256(Path(path).read_bytes()).hexdigest()}, 'derived_from': inputs, 'generated_by': {'script_path': 'build_artifacts.py', 'command': ['python', 'build_artifacts.py']}}\n+    Path(str(path) + '.prov.json').write_text(json.dumps(manifest, indent=2))\n+\n+\n+def save_plot(figure, figure_id, inputs):\n+    for extension in ('pdf', 'png'):\n+        output = Path('figures') / (figure_id + '.' + extension)\n+        figure.savefig(output, dpi=300)\n+        provenance(output, inputs)\n+    plt.close(figure)\n+\n+\n+def get_caps():\n+    tree = ast.parse(Path('source_evidence/evaluation/evaluate_final.py').read_text())\n+    for node in ast.walk(tree):\n+        if isinstance(node, ast.Dict):\n+            for key, value in zip(node.keys, node.values):\n+                if isinstance(key, ast.Constant) and key.value == 'budgets' and isinstance(value, ast.IfExp):\n+                    return ast.literal_eval(value.orelse.orelse), ast.literal_eval(value.orelse.body)\n+    raise RuntimeError('No grounded budget configuration')\n+\n+\n+def selected_cases(episodes):\n+    return [(episode['seed'], case) for episode in episodes for case in episode['solution']['cases'] if case['case'] \"'!= '\"'controls' and not case['replay']]\n+\n+\n+def main():\n+    Path('figures').mkdir(exist_ok=True)\n+    Path('tables').mkdir(exist_ok=True)\n+    data = json.loads(Path('paper_data.json').read_text())\n+    final_caps, development_caps = get_caps()\n+    final_episodes = data['final_evaluation']['evaluation_evidence']['episodes']\n+    final = selected_cases(final_episodes)\n+    source = ['@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]']\n+    rows = []\n+    for seed, case in final:\n+        observations = case['observations']\n+        cells = np.asarray(case['cells'])\n+        repeat_pairs = np.asarray(case['repeat_pairs'])\n+        for cap_index, cap in enumerate(final_caps):\n+            rows.append({'seed': seed, 'case': case['case'], 'cap': cap, 'structure': cells[cap_index].mean(axis=(0, 1)).tolist(), 'standard': observations['baseline_metrics']['standard'][cap_index], 'multistart': observations['baseline_metrics']['multistart'][cap_index], 'repeat': repeat_pairs[cap_index].mean(axis=(0, 1)).tolist(), 'bootstrap_ci95': observations['fidelity_instance_bootstrap_ci95']})\n+    summary = {'final': rows, 'final_caps': final_caps, 'development_caps': development_caps}\n+    # @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n+    summary['reference_sign_mean'] = float(np.mean([row['structure'][2] for row in rows]))\n+    summary['min_reference_sign'] = float(min(row['structure'][2] for row in rows))\n+    summary['max_repeat_vector_difference'] = float(max(np.ptp(np.asarray(case['observations']['attributions']), axis=1).max() for seed, case in final))\n+    summary['reference_uncertainty'] = {name: float(np.mean([np.mean(case['observations']['reference_uncertainty']) for seed, case in final if case['case'] == name])) for name in CASE_NAMES}\n+    figure, axes = plt.subplots(2, 2, figsize=(5.5, 3.85), sharex=True, sharey=True)\n+    markers = {'standard': 'o', 'multistart': 's', 'structure': 'D'}\n+    labels = {'standard': 'Library one-shot', 'multistart': 'Two-start, split cap', 'structure': 'Structure-aware'}\n+    for axis, name in zip(axes.flat, CASE_NAMES):\n+        for offset, method in enumerate(labels):\n+            means = []\n+            for cap_index, cap in enumerate(final_caps):\n+                values = [row[method][0] for row in rows if row['case'] == name and row['cap'] == cap]\n+                positions = np.full(len(values), cap_index + (offset - 1) * .1)\n+                axis.scatter(positions, values, color=COLORS[method], marker=markers[method], alpha=.5, s=13, zorder=4)\n+                means.append(np.mean(values))\n+            axis.plot(np.arange(len(final_caps)) + (offset - 1) * .1, means, color=COLORS[method], marker=markers[method], markersize=4, label=labels[method], linewidth=1.1)\n+        axis.set_title(CASE_NAMES[name] + '\\\\n' + ('approximate reference' if name.startswith('german') else 'exhaustive reference'), pad=5)\n+        axis.set_xticks(range(len(final_caps)), final_caps)\n+        axis.set_ylim(0, 1.05)\n+        axis.set_yticks([0, .5, 1])\n+        axis.grid(axis='y', alpha=.18)\n+    for axis in axes[1]:\n+        axis.set_xlabel('Coalition cap')\n+    for axis in axes[:, 0]:\n+        axis.set_ylabel('Reference agreement')\n+    handles, legend_labels = axes[0, 0].get_legend_handles_labels()\n+    figure.legend(handles, legend_labels, loc='lower center', ncol=3, frameon=False, handlelength=1.1, columnspacing=.7)\n+    figure.subplots_adjust(left=.12, right=.985, top=.88, bottom=.20, hspace=.72, wspace=.22)\n+    save_plot(figure, 'final_reference_comparison', source)\n+    # @evidence[[paper_data.json#/all_programs]]\n+    development = []\n+    for config_index, config in enumerate(data['all_programs']):\n+        for seed, case in selected_cases(config['evaluation_evidence']['episodes']):\n+            for cap_index, cap in enumerate(development_caps):\n+                development.append({'configuration': config_index, 'seed': seed, 'case': case['case'], 'cap': cap, 'agreement': float(np.asarray(case['cells'])[cap_index, :, :, 0].mean())})\n+    summary['development'] = development\n+    figure, axes = plt.subplots(1, 2, figsize=(5.5, 2.65), sharey=True)\n+    for axis, kind, before, after in zip(axes, ('forest', 'logistic'), (0, 1), (1, 2)):\n+        categories = [(dataset + '_' + kind, cap) for dataset in ('german', 'acs') for cap in development_caps]\n+        for config_index, offset, color, label in ((before, -.09, '#9b9b9b', 'Without component'), (after, .09, '#176b8c', 'With component')):\n+            for category_index, (name, cap) in enumerate(categories):\n+                values = [row['agreement'] for row in development if row['configuration'] == config_index and row['case'] == name and row['cap'] == cap]\n+                axis.scatter(np.full(len(values), category_index + offset), values, color=color, s=19, label=label if category_index == 0 else None, zorder=3)\n+                axis.plot([category_index + offset - .055, category_index + offset + .055], [np.mean(values)] * 2, color=color, linewidth=2)\n+        axis.set_xticks(range(len(categories)), [name.split('_')[0].replace('german', 'Ger').replace('acs', 'ACS') + '\\\\n' + str(cap) for name, cap in categories])\n+        axis.set_title('Exact forest component' if kind == 'forest' else 'Logistic integration component')\n+        axis.set_ylim(.80, 1.01)\n+        axis.set_yticks([.8, .9, 1.])\n+        axis.grid(axis='y', alpha=.18)\n+    axes[0].set_ylabel('Reference agreement')\n+    figure.legend(*axes[0].get_legend_handles_labels(), loc='lower center', ncol=2, frameon=False)\n+    figure.subplots_adjust(left=.12, right=.985, top=.85, bottom=.28, wspace=.25)\n+    save_plot(figure, 'component_comparison', ['@evidence[[paper_data.json#/all_programs]]'])\n+    figure, axes = plt.subplots(1, 2, figsize=(5.5, 2.65))\n+    for axis, name in zip(axes, ('german_logistic', 'german_forest')):\n+        for seed, case in final:\n+            if case['case'] \"'!= name:\n+                continue\n+            reference = np.asarray(case['\"'observations']['reference'])\n+            estimate = np.asarray(case['observations']['attributions'])[0, 0]\n+            half_difference = np.abs(np.asarray(case['observations']['reference_uncertainty'])).sum(axis=-1)\n+            observed_distance = np.abs(estimate - reference).sum(axis=-1)\n+            axis.scatter(half_difference, observed_distance, alpha=.6, s=12)\n+        maximum = max(axis.get_xlim()[1], axis.get_ylim()[1])\n+        axis.plot([0, maximum], [0, maximum], color='#777777', linestyle='--', linewidth=.8)\n+        axis.set_title(CASE_NAMES[name])\n+        axis.set_xlabel('Reference half-difference, L1')\n+        axis.set_xlim(left=0)\n+        axis.set_ylim(bottom=0)\n+        axis.grid(alpha=.15)\n+    axes[0].set_ylabel('Estimate-to-reference L1')\n+    figure.subplots_adjust(left=.13, right=.98, bottom=.25, top=.86, wspace=.40)\n+    save_plot(figure, 'reference_diagnostics', source)\n+    concept = Path('figures/fixed_game_overview.png')\n+    log = Path('figures/fixed_game_overview.prompts.json')\n+    if not Path('.concept_figure_complete').exists() and not (log.exists() and json.loads(log.read_text())) and not concept.exists():\n+        image = Image.new('RGB', (2400, 680), 'white')\n+        drawing = ImageDraw.Draw(image)\n+        drawing.text((80, 300), 'Conceptual overview reserved for synchronous rendering', fill='#555555')\n+        image.save(concept)\n+        log.write_text('{}\\\\n')\n+    Path('analysis_summary.json').write_text(json.dumps(summary, indent=2))\n+    provenance(Path('analysis_summary.json'), source + ['@evidence[[paper_data.json#/all_programs]]'])\n+    table_lines = []\n+    for name in CASE_NAMES:\n+        chosen = [row for row in rows if row['case'] == name and row['cap'] == final_caps[0]]\n+        means = {method: np.mean([row[method][0] for row in chosen]) for method in labels}\n+        signs = np.mean([row['structure'][2] for row in chosen])\n+        table_lines.append(f\\\"{CASE_NAMES[name]} & {means['standard']:.4f} & {means['multistart']:.4f} & {means['structure']:.4f} & {signs:.4f} \\\\\\\\\\\\\\\\\\\")\n+    Path('tables/main_rows.tex').write_text('% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\\\\n' + '\\\\n'.join(table_lines) + '\\\\n')\n+    provenance(Path('tables/main_rows.tex'), source)\n+    extended = []\n+    for row in rows:\n+        extended.append(f\\\"{row['seed']} & {CASE_NAMES[row['case']]} & {row['cap']} & {row['standard'][0]:.4f} & {row['multistart'][0]:.4f} & {row['structure'][0]:.4f} \\\\\\\\\\\\\\\\\\\")\n+    Path('tables/extended_rows.tex').write_text('% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\\\\n' + '\\\\n'.join(extended) + '\\\\n')\n+    provenance(Path('tables/extended_rows.tex'), source)\n+    intervals = []\n+    for seed, case in final:\n+        interval = case['observations']['fidelity_instance_bootstrap_ci95']\n+        intervals.append(f\\\"{seed} & {CASE_NAMES[case['case']]} & [{interval[0]:.10f}, {interval[1]:.10f}] \\\\\\\\\\\\\\\\\\\")\n+    Path('tables/interval_rows.tex').write_text('% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\\\\n' + '\\\\n'.join(intervals) + '\\\\n')\n+    provenance(Path('tables/interval_