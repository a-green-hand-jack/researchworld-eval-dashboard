1_fixed_budget_single_call_shap_certificates/program_1/program_spec.toml\nresults/ideas/01_fixed_budget_single_call_shap_certificates/program_1/evaluation_manifest.json\nresults/ideas/01_fixed_budget_single_call_shap_certificates/program_1/src/IMPLEMENTATION.md\nresults/ideas/01_fixed_budget_single_call_shap_certificates/program_1/metrics.json\nresults/latest_run_manifest.json\nresults/conclusions.md\nresults/task/program_0/program_spec.toml\nresults/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/memory.md\nresults/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/program_0/program_spec.toml\nresults/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/memory.md\nresults/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/program_0/src/IMPLEMENTATION.md\nresults/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_0/program_spec.toml\nresults/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/program_1/program_spec.toml\nresults/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_0/src/IMPLEMENTATION.md\nresults/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/program_1/evaluation_manifest.json\nresults/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/program_1/src/IMPLEMENTATION.md\nresults/ideas/02_exact_leaf_game_shap_under_fixed_coalition_budgets/program_1/metrics.json\nresults/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1/metrics.json\nresults/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1/src/IMPLEMENTATION.md\nresults/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1/program_spec.toml\nresults/ideas/03_probability_scale_logistic_shap_by_bounded_fourier_quadrature/program_1/evaluation_manifest.json\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n\ndef _markdown_entry(event: dict[str, Any]) -> str:\n    \"\"\"Handle markdown entry logic for this module.\"\"\"\n    lines = [\n        f\"### {event['timestamp']} | step={event['step']} | scope={event['scope']}\",\n        f\"- summary: {event['summary']}\",\n        f\"- evidence: {event['evidence']}\",\n        f\"- next_action: {event['next_action']}\",\n    ]\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = event.get(key)\n        if isinstance(value, str) and value.strip():\n            lines.append(f\"- {key}: {value.strip()}\")\n\n    metrics = event.get(\"metrics\")\n    if isinstance(metrics, dict) and metrics:\n        lines.append(f\"- metrics: {json.dumps(metrics, sort_keys=True)}\")\n    rubrics = event.get(\"rubrics\")\n    if isinstance(rubrics, list) and rubrics:\n        lines.append(f\"- rubrics: {json.dumps(rubrics, sort_keys=True)}\")\n    tags = event.get(\"tags\")\n    if isinstance(tags, list) and tags:\n        lines.append(f\"- tags: {', '.join(str(item) for item in tags)}\")\n\n    return \"\\n\".join(lines) + \"\\n\\n\"\n\n\ndef _append_text(path: Path, text: str, *, header: str) -> None:\n    \"\"\"Safely initialize and append text to a regular file.\"\"\"\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if not size:\n            _write_all(fd, header.encode(\"utf-8\"))\n        elif os.pread(fd, 1, size - 1) != b\"\\n\":\n            _write_all(fd, b\"\\n\")\n        _write_all(fd, text.encode(\"utf-8\"))\n    finally:\n        try:\n            fcntl.flock(fd, fcntl.LOCK_UN)\n        finally:\n            os.close(fd)\n\n\ndef _append_jsonl(path: Path, payload: dict[str, Any]) -> None:\n    \"\"\"Append one JSON object as a JSONL record.\"\"\"\n    line = (json.dumps(payload, sort_keys=True) + \"\\n\").encode(\"utf-8\")\n    fd = _open_regular_for_append(path)\n    try:\n        fcntl.flock(fd, fcntl.LOCK_EX)\n        size = os.fstat(fd).st_size\n        if size and os.pread(fd, 1, size - 1) != b\"\\n\":\n            _write_all(fd, b\"\\n\")\n        _write_all(fd, line)\n    finally:\n        try:\n            fcntl.flock(fd, fcntl.LOCK_UN)\n        finally:\n            os.close(fd)\n\n\ndef _open_regular_for_append(path: Path) -> int:\n    \"\"\"Open an append target without following its parent or leaf.\"\"\"\n","exit_code":0,"status":"completed"}}
