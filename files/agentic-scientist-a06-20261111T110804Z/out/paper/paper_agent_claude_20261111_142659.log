config_idx, outcome, selected) for outcome matrix X[N, K].\"\"\"\n    N, K = X.shape\n    if searcher == \"exhaustive\":\n        qi = np.repeat(np.arange(N, dtype=np.uint16), K)\n        ci = np.tile(np.arange(K, dtype=np.uint8), N)\n        out = X.reshape(-1).astype(np.uint8)\n        return qi, ci, out, int(np.argmax(X.sum(axis=0)))\n    rounds = max(1, math.ceil(math.log2(K)))\n    budget = N * K\n...\n</persisted-output>\nShell cwd was reset to /workspace/paper","is_error":false}]},"parent_tool_use_id":null,"session_id":"50ad42a8-2b3f-48e6-bd4a-8d4c069e45a9","uuid":"2dd7f5ec-61ad-4dc1-a8d3-967e19109ea2","timestamp":"2026-11-11T14:32:10.585Z","tool_use_result":{"stdout":"def _reject_constant(name):\n    raise ValueError(\"non-finite constant\")\n\n\n# ---------------------------------------------------------------- statistics\ndef wilson(p, n, z):\n    n = float(n)\n    denom = 1.0 + z * z / n\n    center = (p + z * z / (2.0 * n)) / denom\n    half = z * math.sqrt(max(p * (1.0 - p) / n + z * z / (4.0 * n * n), 0.0)) / denom\n    lo = max(0.0, min(center - half, p))\n    hi = min(1.0, max(center + half, p))\n    return lo, hi\n\n\ndef interval_score(lower, upper, y):\n    return (upper - lower) + (2.0 / ALPHA) * max(lower - y, 0.0) + (2.0 / ALPHA) * max(y - upper, 0.0)\n\n\ndef encode_array(array, dtype):\n    arr = np.ascontiguousarray(np.asarray(array).astype(dtype).astype(np.dtype(dtype).newbyteorder(\"<\")))\n    return {\"dtype\": dtype, \"shape\": list(arr.shape), \"encoding\": \"base64-little-endian-c-order\",\n            \"data\": base64.b64encode(arr.tobytes()).decode(\"ascii\")}\n\n\ndef parse_response(response):\n    if type(response) is not dict or set(response) != {\"estimate\", \"lower\", \"upper\"}:\n        return None\n    values = []\n    for key in (\"estimate\", \"lower\", \"upper\"):\n        v = response[key]\n        if type(v) not in (int, float) or not math.isfinite(v):\n            return None\n        values.append(float(v))\n    est, lo, hi = values\n    if not (0.0 <= lo <= est <= hi <= 1.0):\n        return None\n    try:\n        bounded_json_line(response)\n    except ValueError:\n        return None\n    return est, lo, hi\n\n\n# ---------------------------------------------------------------- searchers\ndef run_search(X, searcher):\n    \"\"\"Return (question_idx, config_idx, outcome, selected) for outcome matrix X[N, K].\"\"\"\n    N, K = X.shape\n    if searcher == \"exhaustive\":\n        qi = np.repeat(np.arange(N, dtype=np.uint16), K)\n        ci = np.tile(np.arange(K, dtype=np.uint8), N)\n        out = X.reshape(-1).astype(np.uint8)\n        return qi, ci, out, int(np.argmax(X.sum(axis=0)))\n    rounds = max(1, math.ceil(math.log2(K)))\n    budget = N * K\n    survivors = np.arange(K)\n    done = 0\n    sums = np.zeros(K, dtype=np.int64)\n    qs, cs, outs = [], [], []\n    for _ in range(rounds):\n        if len(survivors) == 1:\n            break\n        n_new = max(1, budget // (rounds * len(survivors)))\n        upto = min(N, done + n_new)\n        if upto > done:\n            block = X[done:upto][:, survivors]\n            qs.append(np.repeat(np.arange(done, upto, dtype=np.uint16), len(survivors)))\n            cs.append(np.tile(survivors.astype(np.uint8), upto - done))\n            outs.append(block.reshape(-1).astype(np.uint8))\n            sums[survivors] += block.sum(axis=0, dtype=np.int64)\n            done = upto\n        keep = max(1, math.ceil(len(survivors) / 2))\n        order = sorted((int(k) for k in survivors), key=lambda k: (-int(sums[k]), k))\n        survivors = np.array(sorted(order[:keep]))\n    return np.concatenate(qs), np.concatenate(cs), np.concatenate(outs), int(survivors[0])\n\n\ndef baseline_reports(qi, ci, out, selected, N, K, rng):\n    \"\"\"Evaluator-owned reporters computed from the same log the candidate receives.\"\"\"\n    obs = np.zeros((N, K), dtype=bool)\n    vals = np.zeros((N, K), dtype=np.float64)\n    obs[qi, ci] = True\n    vals[qi, ci] = out\n    n_sel = int(obs[:, selected].sum())\n    p = float(vals[:, selected].sum() / n_sel)\n    naive = (p,) + wilson(p, n_sel, Z90)\n    z_bonf = NormalDist().inv_cdf(1.0 - ALPHA / (2.0 * K))\n    bonf = (p,) + wilson(p, n_sel, z_bonf)\n    half = N // 2\n    ranks = rng.random((RESAMPLE_B, N)).argsort(axis=1).argsort(axis=1)\n    A = (ranks < half).astype(np.float64)\n    Bm = 1.0 - A\n    obsf = obs.astype(np.float64)\n    cA, sA, cB, sB = A @ obsf, A @ vals, Bm @ obsf, Bm @ vals\n    meanA = np.where(cA > 0, sA / np.maximum(cA, 1.0), -np.inf)\n    pick = np.argmax(meanA, axis=1)\n    rows = np.arange(RESAMPLE_B)\n    ok = (cA[rows, pick] > 0) & (cB[rows, pick] > 0)\n    gap = (sA[rows, pick] / np.maximum(cA[rows, pick], 1.0) - sB[rows, pick] / np.maximum(cB[rows, pick], 1.0))[ok]\n    g = float(gap.mean()) if gap.size else 0.0\n    est = min(1.0, max(0.0, p - g / math.sqrt(2.0)))  # half-sample gap scaled to full-sample SE\n    resample = (est,) + wilson(est, n_sel, Z90)\n    return naive, bonf, resample\n\n\n# ---------------------------------------------------------------- resources / episodes\ndef resource_root():\n    base = os.environ.get(\"TASK_SOURCE_DIR\") or os.path.dirname(os.path.abspath(__file__))\n    return os.path.join(base, \"resources\", PLANE)\n\n\ndef load_real_pool(smoke):\n    root = resource_root()\n    with open(os.path.join(root, \"manifest.json\"), \"r\", encoding=\"utf-8\") as handle:\n        manifest = json.load(handle)\n    with np.load(os.path.join(root, \"outcomes.npz\"), allow_pickle=False) as data:\n        Y = np.array(data[\"outcomes\"], dtype=np.uint8)\n        subject = np.array(data[\"subject_code\"], dtype=np.uint8)\n    hashes = manifest[\"pool_content_hashes\"]\n    demo_hashes = manifest[\"demo_content_hashes\"]\n    audit = manifest[\"audit\"]\n    if manifest.get(\"plane\") != PLANE:\n        raise ValueError(\"resource plane mismatch\")\n    if Y.ndim != 2 or Y.shape[1] != N_CONFIG_REAL or Y.shape[0] != len(hashes) or subject.shape != (Y.shape[0],):\n        raise ValueError(\"outcome tensor shape mismatch\")\n    if not np.isin(Y, (0, 1)).all():\n        raise ValueError(\"outcome tensor must be binary\")\n    if len(set(hashes)) != len(hashes) or set(hashes) & set(demo_hashes):\n        raise ValueError(\"content hash audit failed\")\n    if audit.get(\"cross_plane_overlap\") != 0 or audit.get(\"demo_overlap\") != 0:\n        raise ValueError(\"recorded hash audit not clean\")\n    if smoke:\n        Y, subject = Y[:SMOKE_POOL], subject[:SMOKE_POOL]\n    return Y, subject\n\n\ndef syn_world(rng, K, null):\n    base = float(rng.uniform(0.25, 0.75))\n    if null:\n        p = np.full(K, base)\n    else:\n        p = np.clip(base + rng.normal(0.0, SYN_SPREAD_SD, K), 0.02, 0.98)\n    return p\n\n\ndef syn_outcomes(rng, p, N):\n    K = len(p)\n    thr = np.array([NormalDist().inv_cdf(float(x)) for x in p])\n    u = rng.standard_normal(N)\n    e = rng.standard_normal((N, K))\n    return (math.sqrt(SYN_RHO) * u[:, None] + math.sqrt(1.0 - SYN_RHO) * e < thr[None, :]).astype(np.uint8)\n\n\ndef random_derangement_rows(rng, n_rows, K):\n    perm = np.argsort(rng.random((n_rows, K)), axis=1)  # random orderings\n    shift = rng.integers(1, K, size=n_rows)\n    pos = np.argsort(perm, axis=1)\n    new_pos = (pos + shift[:, None]) % K\n    out = np.take_along_axis(perm, new_pos, axis=1)  # out[i, c] = config that column c reads (single K-cycle)\n    return out\n\n\ndef build_episode(index, seed, case, smoke, pool):\n    params = case_params(case, smoke)\n    K, N, R, world, searcher = params[\"K\"], params[\"N\"], params[\"R\"], params[\"world\"], params[\"searcher\"]\n    case_idx = CASE_ORDER.index(case)\n    base_seq = [RNG_ENTROPY, int(seed), case_idx, 1 if smoke else 0]\n    valid_control = True\n    Ypool = subj_pool = None\n    if world in (\"real\", \"real_null\"):\n        Ypool, subj_pool = pool\n        if world == \"real_null\":\n            rng_p = np.random.default_rng(np.random.SeedSequence(base_seq + [999]))\n            der = random_derangement_rows(rng_p, Ypool.shape[0], Ypool.shape[1])\n            if (der == np.arange(Ypool.shape[1])[None, :]).any():\n                valid_control = False\n            Y2 = np.take_along_axis(Ypool, der, axis=1)\n            # spread of per-config pool accuracy must collapse to the null sampling noise implied by the\n            # within-question variance over configs (or at least halve the original spread)\n            acc0, acc1 = Ypool.mean(axis=0), Y2.mean(axis=0)\n            noise = math.sqrt(float(Ypool.astype(np.float64).var(axis=1).mean()) / Ypool.shape[0])\n            if float(acc1.std()) > max(0.5 * float(acc0.std()), 1.5 * noise):\n                valid_control = False\n            Ypool = Y2\n    reps = []\n    for r in range(R):\n        rng = np.random.default_rng(np.random.SeedSequence(base_seq + [r]))\n        if world in (\"syn\", \"syn_null\"):\n            p = syn_world(rng, K, null=(world == \"syn_null\"))\n            X = syn_outcomes(rng, p, N)\n            subj = np.zeros(N, dtype=np.uint8)\n            truth_of = lambda sel, p=p: float(p[sel])\n        elif world == \"const\":\n            X = np.zeros((N, K), dtype=np.uint8)\n            subj = np.zeros(N, dtype=np.uint8)\n            truth_of = lambda sel: 0.0\n        else:\n            n_pool = Ypool.shape[0]\n            sample = rng.choice(n_pool, size=N, replace=False)\n            perm = rng.permutation(K)\n            rest = np.ones(n_pool, dtype=bool)\n            rest[sample] = False\n            X = Ypool[sample][:, perm]\n            subj = subj_pool[sample]\n            rest_acc = Ypool[rest].mean(axis=0)[perm]\n            truth_of = lambda sel, rest_acc=rest_acc: float(rest_acc[sel])\n        qi, ci, out, sel = run_search(X, searcher)\n        naive, bonf, resample = baseline_reports(qi, ci, out, sel, N, K, rng)\n        reps.append(dict(qi=qi, ci=ci, out=out, sel=sel, subj=subj, truth=truth_of(sel),\n                         naive=naive, bonf=bonf, resample=resample))\n    return dict(index=index, seed=int(seed), case=case, params=params, reps=reps, valid_control=valid_control)\n\n\ndef build_request(ep, rep):\n    params = ep[\"params\"]\n    return {\n        \"op\": \"report\",\n        \"n_questions\": params[\"N\"],\n        \"n_configs\": params[\"K\"],\n        \"level\": LEVEL,\n        \"searcher\": params[\"searcher\"],\n        \"selected_config\": int(rep[\"sel\"]),\n        \"log\": {\n            \"question_idx\": encode_array(rep[\"qi\"], \"uint16\"),\n            \"config_idx\": encode_array(rep[\"ci\"], \"uint8\"),\n            \"outcome\": encode_array(rep[\"out\"], \"uint8\"),\n        },\n        \"subject_code\": encode_array(rep[\"subj\"], \"uint8\"),\n    }\n\n\ndef score_reporter(report, truth):\n    est, lo, hi = report\n    return dict(IS=interval_score(lo, hi, truth), cov=float(lo <= truth <= hi), width=hi - lo,\n                bias=est - truth, sq=(est - truth) ** 2, abs_est=abs(est))\n\n\nWORST_REP = dict(IS=WORST_IS, cov=0.0, width=1.0, bias=1.0, sq=1.0, abs_est=1.0)\nREP_KEYS = tuple(WORST_REP)\n\n\ndef episode_record(ep, cand_rows, valid_flags):\n    \"\"\"Episode value = equal-weight mean over its declared replications.\"\"\"\n    R = len(ep[\"reps\"])\n    rec = {k: float(np.mean([cand_rows[i][k] for i in range(R)])) for k in REP_KEYS}\n    for name in (\"naive\", \"bonf\", \"resample\"):\n        rows = [score_reporter(rep[name], rep[\"truth\"]) for rep in ep[\"reps\"]]\n        rec[name + \"_IS\"] = float(np.mean([x[\"IS\"] for x in rows]))\n        rec[name + \"_bias\"] = float(np.mean([x[\"bias\"] for x in rows]))\n    rec[\"valid_fraction\"] = float(np.mean(valid_flags))\n    rec[\"valid_count\"] = int(sum(valid_flags))\n    rec[\"reps\"] = R\n    rec[\"naive_bias_list\"] = [score_reporter(rep[\"naive\"], rep[\"truth\"])[\"bias\"] for rep in ep[\"reps\"]]\n    return rec\n\n\ndef worst_case_record(ep):\n    R = len(ep[\"reps\"])\n    return episode_record(ep, [WORST_REP] * R, [False] * R)\n\n\n# ---------------------------------------------------------------- aggregation\ndef case_value(records, case, key):\n    vals = [r[key] for r in records if r[\"case\"] == case]\n    return float(np.mean(vals)) if vals else None\n\n\ndef plane_value(records, key, cases_present):\n    syn = [case_value(records, c, key) for c in SYN_PRIMARY if c in cases_present]\n    real = [case_value(records, c, key) for c in REAL_PRIMARY if c in cases_present]\n    syn_v = float(np.mean(syn))\n    real_v = float(np.mean(real))\n    return FAMILY_WEIGHTS[\"synthetic\"] * syn_v + FAMILY_WEIGHTS[\"real\"] * real_v\n\n\ndef aggregate(records):\n    cases = set(CASE_ORDER)\n    pv = lambda key: plane_value(records, key, cases)\n    mean_is = pv(\"IS\")\n    ctrl_cases = (\"N1\", \"N2\")\n    metrics = {\n        \"combined_score\": -mean_is,\n        \"mean_interval_score\": mean_is,\n        \"coverage\": pv(\"cov\"),\n        \"mean_width\": pv(\"width\"),\n        \"signed_bias\": pv(\"bias\"),\n        \"rmse\": math.sqrt(pv(\"sq\")),\n        \"naive_baseline_score\": -pv(\"naive_IS\"),\n        \"bonferroni_baseline_score\": -pv(\"bonf_IS\"),\n        \"resample_baseline_score\": -pv(\"resample_IS\"),\n        \"naive_signed_bias\": pv(\"naive_bias\"),\n        \"null_control_abs_bias\": float(np.mean([abs(case_value(records, c, \"bias\")) for c in ctrl_cases])),\n        \"null_control_coverage\": float(np.mean([case_value(records, c, \"cov\") for c in ctrl_cases])),\n        \"constant_control_error\": case_value(records, \"Z1\", \"abs_est\"),\n        \"completed_replication_fraction\": float(sum(r[\"valid_count\"] for r in records) / sum(r[\"reps\"] for r in records)),\n    }\n    metrics[\"combined_score\"] = -metrics[\"mean_interval_score\"]\n    return {k: float(v) for k, v in metrics.items()}\n\n\ndef seed_scores(records):\n    out = {}\n    for seed in sorted({r[\"seed\"] for r in records}):\n        sub = [r for r in records if r[\"seed\"] == seed]\n        out[seed] = -plane_value(sub, \"IS\", set(CASE_ORDER))\n    return out\n\n\ndef controls_valid(records, episodes):\n    ok = all(ep[\"valid_control\"] for ep in episodes)\n    for case in (\"N1\", \"N2\"):\n        bias = np.array([b for r in records if r[\"case\"] == case for b in r[\"naive_bias_list\"]], dtype=float)\n        if bias.size < 2:\n            ok = False\n            continue\n        lower = float(bias.mean() - 1.96 * bias.std(ddof=1) / math.sqrt(bias.size))\n        if not lower > 0.0:\n            ok = False\n    return ok\n\n\ndef z1_integrity(records):\n    z = [r for r in records if r[\"case\"] == \"Z1\"]\n    err = float(np.mean([r[\"abs_est\"] for r in z]))\n    cov = float(np.mean([r[\"cov\"] for r in z]))\n    return err <= 0.05 and cov >= 0.9\n\n\ndef payload_preflight():\n    \"\"\"Serialize the largest planned request and the response; all must stay below 64 MiB.\"\"\"\n    big = {\"op\": \"report\", \"n_questions\": 1000, \"n_configs\": 64, \"level\": LEVEL, \"searcher\": \"exhaustive\",\n           \"selected_config\": 63,\n           \"log\": {\"question_idx\": encode_array(np.arange(64000) % 1000, \"uint16\"),\n                   \"config_idx\": encode_array(np.arange(64000) % 64, \"uint8\"),\n{\"audit\": {\"checked\": \"normalized content hashes and source ids across search pool, final pool and demonstration source before tokenization-dependent scoring\", \"cross_plane_overlap\": 0, \"demo_overlap\": 0, \"source_id_overlap\": 0}, \"builder\": {\"script_name\": \"build_outcomes.py\", \"sha256\": \"3ab0b7ddbfe3ea54e825c7a554c5980a4017cdd53065e53efc03fd0464605672\", \"source\": \"\\\"\\\"\\\"Draft-time builder of the real-LLM outcome tensors (MMLU-Pro x 24 prompt configs).\\nUsage: prep <search_n> <final_n> | score <model_dir> <pool> <shard> <nshards> <threads> [limit]\\n\\\"\\\"\\\"\\nimport sys, os, json, hashlib, unicodedata, re\\nimport numpy as np, pandas as pd\\n\\nW = \\\"/tmp/work\\\"\\nREV = \\\"b189ec765aa7ed75c8acfea42df31fdae71f97be\\\"\\nLETTERS = \\\"ABCDEFGHIJ\\\"\\nWORDINGS = [\\n    \\\"Answer the following multiple-choice question by choosing the correct option.\\\",\\n    \\\"You are an expert test taker. Read the question carefully and select the single best answer from options A to J.\\\",\\n    \\\"Choose the correct answer. Respond with the letter of the option only.\\\",\\n    \\\"Think about the question, then pick the option that is most likely correct.\\\",\\n]\\nSUFFIXES = [\\\"The answer is (\\\", \\\"Answer: The answer is (\\\"]\\nMAX_BODY_TOKENS = 400\\n\\ndef norm(t):\\n    return \\\" \\\".join(unicodedata.normalize(\\\"NFKC\\\", t).casefold().split())\\n\\ndef content_hash(q, opts):\\n    return hashlib.sha256((norm(q) + \\\"\\\\n\\\" + \\\"\\\\n\\\".join(norm(o) for o in opts)).encode(\\\"utf-8\\\")).hexdigest()\\n\\ndef body_text(q, opts):\\n    return \\\"Question: \\\" + q.strip() + \\\"\\\\nOptions:\\\\n\\\" + \\\"\\\\n\\\".join(f\\\"{LETTERS[i]}. {o}\\\" for i, o in enumerate(opts)) + \\\"\\\\n\\\"\\n\\ndef demo_text(q, opts, ans):\\n    return body_text(q, opts) + f\\\"Answer: The answer is ({ans}).\\\\n\\\\n\\\"\\n\\ndef prep(search_n, final_n):\\n    from transformers import AutoTokenizer\\n    tok = AutoTokenizer.from_pretrained(f\\\"{W}/model\\\")\\n    te = pd.read_parquet(f\\\"{W}/mmlu_pro/data/test-00000-of-00001.parquet\\\")\\n    va = pd.read_parquet(f\\\"{W}/mmlu_pro/data/validation-00000-of-00001.parquet\\\")\\n    def rows(df, split):\\n        out = []\\n        for r in df.itertuples():\\n            opts = [str(o) for o in r.options]\\n            out.append(dict(split=split, qid=int(r.question_id), q=r.question, opts=opts, ans=r.answer, cat=r.category,\\n                            h=content_hash(r.question, opts)))\\n        return out\\n    T, V = rows(te, \\\"test\\\"), rows(va, \\\"validation\\\")\\n    stats = dict(test_raw=len(T), validation_raw=len(V))\\n    # dedup: validation (demonstration source) wins; within-split first occurrence wins\\n    seen = {}\\n    Vd = []\\n    for r in V:\\n        if r[\\\"h\\\"] not in seen: seen[r[\\\"h\\\"]] = 1; Vd.append(r)\\n    Td = []\\n    for r in T:\\n        if r[\\\"h\\\"] not in seen: seen[r[\\\"h\\\"]] = 1; Td.append(r)\\n    stats.update(validation_dedup=len(Vd), test_dedup=len(Td))\\n    # length filter\\n    keep = []\\n    for r in Td:\\n        n = len(tok(body_text(r[\\\"q\\\"], r[\\\"opts\\\"]))[\\\"input_ids\\\"])\\n        if n <= MAX_BODY_TOKENS and len(r[\\\"opts\\\"]) == 10: keep.append(r)\\n    stats[\\\"test_after_length_filter\\\"] = len(keep)\\n    cats = sorted({r[\\\"cat\\\"] for r in keep})\\n    assert len(cats) == 14, cats\\n    rng = np.random.default_rng(20261027)\\n    bycat = {c: [r for r in keep if r[\\\"cat\\\"] == c] for c in cats}\\n    for c in cats:\\n        idx = rng.permutation(len(bycat[c])); bycat[c] = [bycat[c][i] for i in idx]\\n    total = sum(len(v) for v in bycat.values())\\n    def take(n, offset):\\n        sel = []\\n        for c in cats:\\n            k = int(round(n * len(bycat[c]) / total))\\n            sel.extend(bycat[c][offset[c]:offset[c] + k]); offset[c] += k\\n        return sel\\n    off = {c: 0 for c in cats}\\n    S = take(search_n, off); F = take(final_n, off)\\n    # deterministic order within pool shuffled by seed\\n    for name, P, sd in ((\\\"search\\\", S, 1), (\\\"final\\\", F, 2)):\\n        idx = np.random.default_rng(777 + sd).permutation(len(P)); P[:] = [P[i] for i in idx]\\n    hs, hf, hd = {r[\\\"h\\\"] for r in S}, {r[\\\"h\\\"] for r in F}, {r[\\\"h\\\"] for r in Vd}\\n    ids_s, ids_f = {r[\\\"qid\\\"] for r in S}, {r[\\\"qid\\\"] for r in F}\\n    assert not (hs & hf) and not (hs & hd) and not (hf & hd) and not (ids_s & ids_f)\\n    assert len(hs) == len(S) and len(hf) == len(F)\\n    stats.update(search_pool=len(S), final_pool=len(F), overlap_search_final=0, overlap_search_demo=0, overlap_final_demo=0)\\n    # demonstrations: 3 per set from validation, seeded, distinct categories, sets disjoint\\n    drng = np.random.default_rng(31337)\\n    order = drng.permutation(len(Vd))\\n    picked, used = [], set()\\n    for i in order:\\n        if Vd[i][\\\"cat\\\"] not in used: used.add(Vd[i][\\\"cat\\\"]); picked.append(Vd[i])\\n        if len(picked) == 6: break\\n    demos = [picked[:3], picked[3:]]\\n    json.dump(dict(stats=stats, cats=cats, demos=[[dict(qid=d[\\\"qid\\\"], q=d[\\\"q\\\"], opts=d[\\\"opts\\\"], ans=d[\\\"ans\\\"], cat=d[\\\"cat\\\"], h=d[\\\"h\\\"]) for d in ds] for ds in demos],\\n                   search=[dict(qid=r[\\\"qid\\\"], q=r[\\\"q\\\"], opts=r[\\\"opts\\\"], ans=r[\\\"ans\\\"], cat=r[\\\"cat\\\"], h=r[\\\"h\\\"]) for r in S],\\n                   final=[dict(qid=r[\\\"qid\\\"], q=r[\\\"q\\\"], opts=r[\\\"opts\\\"], ans=r[\\\"ans\\\"], cat=r[\\\"cat\\\"], h=r[\\\"h\\\"]) for r in F]),\\n              open(f\\\"{W}/pools.json\\\", \\\"w\\\"))\\n    print(json.dumps(stats))\\n\\ndef score(model_dir, pool, shard, nshards, threads, limit=None):\\n    import torch\\n    torch.set_num_threads(threads)\\n    from transformers import AutoTokenizer, AutoModelForCausalLM\\n    tok = AutoTokenizer.from_pretrained(model_dir)\\n    model = AutoModelForCausalLM.from_pretrained(model_dir, dtype=torch.bfloat16 if os.environ.get(\\\"BF16\\\") else torch.float32).eval()\\n    P = json.load(open(f\\\"{W}/pools.json\\\"))\\n    qs = P[pool]; demos = P[\\\"demos\\\"]\\n    if limit: qs = qs[:int(limit)]\\n    my = list(range(shard, len(qs), nshards))\\n    enc = lambda s: tok(s, add_special_tokens=False)[\\\"input_ids\\\"]\\n    letter_ids = [tok.convert_tokens_to_ids(c) for c in LETTERS]\\n    assert all(isinstance(i, int) and i >= 0 for i in letter_ids) and len(set(letter_ids)) == 10\\n    suffix_ids = [enc(s) for s in SUFFIXES]\\n    sysmsg = \\\"<|im_start|>system\\\\nYou are a helpful assistant.<|im_end|>\\\\n<|im_start|>user\\\\n\\\"\\n    tail = \\\"<|im_end|>\\\\n<|im_start|>assistant\\\\n\\\"\\n    demo_strs = [\\\"\\\"] + [\\\"\\\".join(demo_text(d[\\\"q\\\"], d[\\\"opts\\\"], d[\\\"ans\\\"]) for d in ds) for ds in demos]\\n    prefixes = []  # (wording, demo) -> cache after prefix\\n    from transformers import DynamicCache\\n    for w in range(4):\\n        for dsi in range(3):\\n            ids = enc(sysmsg + WORDINGS[w] + \\\"\\\\n\\\\n\\\" + demo_strs[dsi])\\n            with torch.no_grad():\\n                c = DynamicCache(); out = model(torch.tensor([ids]), past_key_values=c, use_cache=True)\\n            prefixes.append((len(ids), c))\\n    Y = np.zeros((len(qs), 24), dtype=np.uint8)\\n    done = np.zeros(len(qs), dtype=bool)\\n    import time; t0 = time.time(); ntok = 0\\n    for n, qi in enumerate(my):\\n        r = qs[qi]; body = enc(body_text(r[\\\"q\\\"], r[\\\"opts\\\"]) + \\\"Answer the question above.\\\" * 0)\\n        body = body + enc(tail)\\n        gold = LETTERS.index(r[\\\"ans\\\"])\\n        for w in range(4):\\n            for dsi in range(3):\\n                plen, c = prefixes[w * 3 + dsi]\\n                with torch.no_grad():\\n                    model(torch.tensor([body]), past_key_values=c, use_cache=True)\\n                    blen = plen + len(body)\\n                    for f in range(2):\\n                        o = model(torch.tensor([suffix_ids[f]]), past_key_values=c, use_cache=True)\\n                        lg = o.logits[0, -1].float()[letter_ids]\\n                        Y[qi, (w * 3 + dsi) * 2 + f] = int(int(torch.argmax(lg)) == gold)\\n                        c.crop(-len(suffix_ids[f]))\\n                    c.crop(-len(body))\\n                ntok += len(body) + 2 * len(suffix_ids[0])\\n        done[qi] = True\\n        if n % 10 == 0:\\n            print(f\\\"shard {shard} {n+1}/{len(my)} tok/s={ntok/(time.time()-t0):.0f}\\\", flush=True)\\n            np.savez(f\\\"{W}/Y_{pool}_{shard}of{nshards}.npz\\\", Y=Y, done=done)\\n    np.savez(f\\\"{W}/Y_{pool}_{shard}of{nshards}.npz\\\", Y=Y, done=done)\\n\\nif __name__ == \\\"__main__\\\":\\n    if sys.argv[1] == \\\"prep\\\": prep(int(sys.argv[2]), int(sys.argv[3]))\\n    else:\\n        a = sys.argv[2:]\\n        score(a[0], a[1], int(a[2]), int(a[3]), int(a[4]), a[5] if len(a) > 5 else None)\\n\", \"usage\": \"prep <search_n=600> <final_n=1500> then score <model_dir> <pool> <shard> <nshards> <threads>; outputs merged by assemble\"}, \"dataset\": {\"license\": \"MIT\", \"repository\": \"TIGER-Lab/MMLU-Pro\", \"revision\": \"b189ec765aa7ed75c8acfea42df31fdae71f97be\"}, \"demo_content_hashes\": [\"2313d639cd5e7e7095237cecfbbaaa0c08471b2a3c492c9d3c733d2bd3b2335d\", \"24931956bd2b36e24b39499dd7f9e6ba27e2bda5b01e9072790e0a0aefc30991\", \"78dbf9ce02b533b3da90b1ac8bf8f012f4d63c16061c72460970e0c589890e51\", \"9d83db1e33cbb4ca20076b92beef73198467f7bb632afe5ba7a42dc269698000\", \"a4b310728eb5e03f9a06b28d1936337fcc69f541203a562700de3d6bb9f5e42a\", \"be476d6bed680beeab8ae4932a63f4716c3ae1a3bec3df24f206b175cb6e2f48\"], \"model\": {\"license\": \"apache-2.0\", \"precision\": \"float32 CPU, deterministic single forward pass, argmax over the 10 option-letter logits\", \"repository\": \"Qwen/Qwen2.5-0.5B-Instruct\", \"revision\": \"7ae557604adf67be50417f59c2c2f167def9a775\"}, \"normalization\": \"Unicode NFKC, casefold, whitespace collapse; SHA-256 over question text + newline + newline-joined ordered options\", \"per_config_pool_accuracy\": [0.143333, 0.142667, 0.146667, 0.15, 0.115333, 0.114, 0.166, 0.155333, 0.155333, 0.161333, 0.124667, 0.120667, 0.132667, 0.134, 0.142667, 0.146, 0.118, 0.111333, 0.134667, 0.133333, 0.141333, 0.147333, 0.106667, 0.112667], \"plane\": \"final\", \"pool_content_hashes\": [\"e1d2c5781dff7d60bd2453e37195df5f811584c73be3136924631d1cf14f94d4\", \"6e0a5601a6caf24688075326b4af93a4a13b4baacc8cc495afb18e22e59e1397\", \"04718ef9c20ef12957b769944519a2230d27a591fd045701eb3bd19d7ed3b3da\", \"f46938914a24893a05c852ed6438aebdec4ccb83966d6428dff0e47e8f142bd3\", \"bd8a260bf5f41e024