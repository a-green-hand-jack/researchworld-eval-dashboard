{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, math\nfrom collections import Counter\nfrom pathlib import Path\nstrategy=json.loads(Path('paper_strategy.json').read_text())\npaper=json.loads(Path('paper_data.json').read_text())\nmemo=Path('paper_strategy.md').read_text()\nrequired={'status','selected_prompt_family','recommended_title','central_question','central_thesis','narrative_rationale','prior_paper_story_status','edit_framing_decision','staged_input_impact','method_groups','results_focus','figure_plan','figure_specs','supplementary_plan','forbidden_headings','forbidden_phrases','notes_for_writer','failure_reason'}\nassert set(strategy)==required\nassert strategy['status']=='ready' and strategy['failure_reason']==''\nassert strategy['selected_prompt_family']=='paper_standalone'\nassert strategy['recommended_title'] in memo\nassert strategy['supplementary_plan']['purpose'] and strategy['supplementary_plan']['planned_subsections']\nfor subsection in strategy['supplementary_plan']['planned_subsections']:\n    assert subsection['heading'] in memo\n    assert subsection['grounded_content'] and subsection['source_ids']\n    assert all(source in paper['grounding_sources'] for source in subsection['source_ids'])\nfor group in strategy['method_groups']:\n    assert group['role'] in ('baseline','proposed','ablation','supporting')\nassert len(strategy['figure_specs'])==len(strategy['figure_plan'])\nassert sum(figure['preferred_generator']=='generate-concept-figure' for figure in strategy['figure_specs'])==1\nfor figure in strategy['figure_specs']:\n    assert figure['figure_id'] in memo\n    assert figure['required'] and figure['layout_rationale'] and not figure['allow_progression']\n    assert figure['max_panels']<=4 and figure['max_categories_per_panel']<=6 and figure['max_series_per_panel']<=4\n    assert figure['preferred_span']=='full_width' and figure['target_width_fraction']==1.0\nassert paper['grounding_sources']['final.qualification.outcome']['value']=='qualified'\nassert paper['grounding_sources']['final.qualification.status']['value']=='completed'\nassert 'downstream_study' not in paper\nnames=('uniform_mae','prior_mae','anchor_mae','irt_mae')\ncells=[]\ncases=set()\nseeds=set()\nfor wrapper in paper['final_evaluation']['evaluation_evidence']['episodes']:\n    seeds.add(wrapper['seed'])\n    for episode in wrapper['solution']['episodes']:\n        if episode['condition']\"'!='\"'normal' or episode['replay']:\n            continue\n        cases.add(episode['case'])\n        assert [checkpoint['budget'] for checkpoint in episode['checkpoints']]==[5,10,25]\n        for checkpoint in episode['checkpoints']:\n            counts=Counter(checkpoint['lineage_groups'])\n            weights=[1/(len(counts)*counts[group]) for group in checkpoint['lineage_groups']]\n            truth=checkpoint['references']\n            values={'mae':sum(weight*abs(pred-reference) for weight,pred,reference in zip(weights,checkpoint['predictions'],truth))}\n            for name in names:\n                values[name]=sum(weight*abs(pred-reference) for weight,pred,reference in zip(weights,checkpoint['baseline_predictions'][name],truth))\n            cells.append(values)\nassert len(cases)==9 and seeds=={1009,2003,3001} and len(cells)==81\nfor name in ('mae',)+names:\n    calculated=sum(cell[name] for cell in cells)/len(cells)\n    assert math.isclose(calculated,paper['final_evaluation']['metrics'][name],abs_tol=1e-12), (name,calculated)\nuncertainties=[wrapper['solution']['paired_mae_uncertainty'] for wrapper in paper['final_evaluation']['evaluation_evidence']['episodes']]\nassert all(uncertainty==uncertainties[0] for uncertainty in uncertainties)\nfor name in names:\n    difference=paper['final_evaluation']['metrics']['mae']-paper['final_evaluation']['metrics'][name]\n    assert math.isclose(difference,uncertainties[0]['comparisons'][name]['candidate_minus_baseline_mae'],abs_tol=1e-12)\nfor path in ('paper.tex','claims_grounding.json'):\n    assert not Path(path).exists()\nprint('PASS: strategy schema, mirrored headings/figures, source-ID resolution, figure budgets, independent qualification, raw aggregate reconciliation, interval deduplication, and stage boundaries.')\nprint('Checked 81 non-replay final case/budget/seed cells; no final-paper validation or new experiment executed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
