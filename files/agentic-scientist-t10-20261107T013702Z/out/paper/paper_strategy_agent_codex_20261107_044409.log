ticle}\n%             \\usepackage{iclr14submit_e,times}\n%\n\n% Change the overall width of the page.  If these parameters are\n%       changed, they will require corresponding changes in the\n%       maketitle section.\n%\n\\usepackage{eso-pic} % used by \\AddToShipoutPicture\n\\RequirePackage{fancyhdr}\n\\RequirePackage{natbib}\n\n% modification to natbib citations\n\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n\n\\renewcommand{\\topfraction}{0.95}   % let figure take up nearly whole page\n\\renewcommand{\\textfraction}{0.05}  % let figure take up nearly whole page\n\n% Define iclrfinal, set to true if iclrfinalcopy is defined\n\\newif\\ificlrfinal\n\\iclrfinalfalse\n\\def\\iclrfinalcopy{\\iclrfinaltrue}\n\\font\\iclrtenhv  = phvb at 8pt\n\n% Specify the dimensions of each page\n\n\\setlength{\\paperheight}{11in}\n\\setlength{\\paperwidth}{8.5in}\n\n\n\\oddsidemargin .5in    %   Note \\oddsidemargin = \\evensidemargin\n\\evensidemargin .5in\n\\marginparwidth 0.07 true in\n%\\marginparwidth 0.75 true in\n%\\topmargin 0 true pt           % Nominal distance from top of page to top of\n%\\topmargin 0.125in\n\\topmargin -0.625in\n\\addtolength{\\headsep}{0.25in}\n\\textheight 9.0 true in       % Height of text (including footnotes & figures)\n\\textwidth 5.5 true in        % Width of text line.\n\\widowpenalty=10000\n\\clubpenalty=10000\n\n% \\thispagestyle{empty}        \\pagestyle{empty}\n\\flushbottom \\sloppy\n\n% We're never going to need a table of contents, so just flush it to\n% save space --- suggested by drstrip@sandia-2\n\\def\\addcontentsline#1#2#3{}\n\n% Title stuff, taken from deproc.\ncandidate zero widths per case [0, 0, 0, 0, 0, 0, 0]\nseed range (1001, 1256)\nbaseline coverage bounds rare {'full_range_sanity_interval': {'coverage': 1.0, 'lower95': 0.9856936372709606, 'nominal_not_rejected': True, 'upper95': 1.0}, 'labeled_only_asymptotic_mean': {'coverage': 0.55078125, 'lower95': 0.48760882012874857, 'nominal_not_rejected': False, 'upper95': 0.6127642815626417}, 'labeled_only_exact_binomial': {'coverage': 0.99609375, 'lower95': 0.9784291096474665, 'nominal_not_rejected': True, 'upper95': 0.9999011072027765}, 'ppi_plus_plus_mean': {'coverage': 0.55078125, 'lower95': 0.48760882012874857, 'nominal_not_rejected': False, 'upper95': 0.6127642815626417}, 'prediction_powered_mean': {'coverage': 0.94140625, 'lower95': 0.9051991415444257, 'nominal_not_rejected': True, 'upper95': 0.9668381679733287}}\nnever used to select a narrower interval. Wald coverage is only asymptotic;\nneither cross-fitting nor a small-sample exact branch makes it finite-sample\nvalid at other sizes. No empirical coverage or width improvement is asserted.\n\"\"\"\nimport base64\nimport math\n\nimport numpy as np\n\n_state = None\n\n\nclass ScoreCalibrator:\n    \"\"\"Small ridge linear-spline family, tuned exclusively on its fit sample.\"\"\"\n\n    def __init__(self, nonlinear=True):\n        self.nonlinear = nonlinear\n\n    def fit(self, scores, outcomes):\n        train_scores = np.asarray(scores, dtype=float).reshape(-1)\n        train_outcomes = np.asarray(outcomes, dtype=float).reshape(-1)\n        self.intercept = float(np.mean(train_outcomes))\n        self.knots = np.empty(0)\n        self.coefficients = np.empty(0)\n        self.feature_mean = np.empty(0)\n        self.feature_scale = np.empty(0)\n        sample_count = train_scores.size\n        if sample_count < 4 or np.ptp(train_scores) < 1e-12:\n            return self\n        centered_outcomes = train_outcomes - self.intercept\n        best_gcv = float(np.mean(centered_outcomes**2) / (1.0 - 1.0 / sample_count)**2)\n        knot_families = [np.empty(0)]\n        if self.nonlinear and sample_count >= 16:\n            knot_families.append(np.unique(np.quantile(train_scores, [0.25, 0.5, 0.75])))\n        if self.nonlinear and sample_count >= 64:\n            knot_families.append(np.unique(np.quantile(train_scores, np.linspace(0.125, 0.875, 7))))\n        for knots in knot_families:\n            features = self._basis(train_scores, knots)\n            feature_mean = features.mean(axis=0)\n            feature_scale = features.std(axis=0)\n            feature_scale = np.maximum(feature_scale, 1e-8)\n            centered_features = (features - feature_mean) / feature_scale\n            gram = centered_features.T @ centered_features / sample_count\n            cross = centered_features.T @ centered_outcomes / sample_count\n            identity = np.eye(gram.shape[0])\n            for penalty in (0.001, 0.01, 0.1, 1.0, 10.0):\n                coefficient = np.linalg.solve(gram + penalty * identity, cross)\n                residuals = centered_outcomes - centered_features @ coefficient\n                degrees = 1.0 + float(np.trace(np.linalg.solve(gram + penalty * identity, gram)))\n                denominator = max(1.0 - degrees / sample_count, 1.0 / sample_count)\n                gcv = float(np.mean(residuals**2) / denominator**2)\n                if gcv < best_gcv:\n                    best_gcv = gcv\n                    self.knots = knots.copy()\n                    self.coefficients = coefficient\n                    self.feature_mean = feature_mean\n                    self.feature_scale = feature_scale\n        return self\n\n    @staticmethod\n    def _basis(scores, knots):\n        return np.column_stack((scores, np.maximum(scores[:, None] - knots[None, :], 0.0)))\n\n    def predict(self, scores):\n        scores = np.asarray(scores, dtype=float).reshape(-1)\n        if not self.coefficients.size:\n            return np.full(scores.size, self.intercept)\n        features = (self._basis(scores, self.knots) - self.feature_mean) / self.feature_scale\n        return self.intercept + features @ self.coefficients\n\n\ndef fit_score_calibrator(train_scores, train_outcomes):\n    calibrator = ScoreCalibrator()\n    calibrator.fit(train_scores.reshape(-1, 1), train_outcomes)\n    return calibrator\n\n\ndef bounded_eb_radius(sample, lower_bound, upper_bound, delta):\n    \"\"\"Conservative two-sided empirical Bernstein radius for bounded iid data.\"\"\"\n    sample = np.asarray(sample, dtype=float)\n    if not 0.0 < delta < 1.0 or lower_bound > upper_bound:\n        raise ValueError(\"invalid empirical-Bernstein parameters\")\n    if sample.size < 2:\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n","exit_code":0,"status":"completed"}}
