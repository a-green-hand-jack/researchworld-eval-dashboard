([(0x15, 0, 1, 435), (0x06, 0, 0, 0x00050026), (0x15, 0, 4, 56), (0x20, 0, 0, 16), (0x45, 1, 0, 0x10000), (0x06, 0, 0, 0x00050001), (0x06, 0, 0, 0x7fff0000), (0x06, 0, 0, 0x7fff0000)])\\n    filters = (Filter * len(instructions))(*(Filter(*item) for item in instructions))\\n    program = Program(len(instructions), filters)\\n    if libc.prctl(22, 2, ctypes.byref(program), 0, 0) != 0:\\n        raise RuntimeError('seccomp activation failed')\\n\\n\\ndef main():\\n    path, root, runtime, wall, core_list, repair = sys.argv[1:]\\n    isolate(root, runtime, int(wall), [int(value) for value in core_list.split(',')])\\n    sys.path.insert(0, str(pathlib.Path(path).parent))\\n    output = sys.stdout\\n    with contextlib.redirect_stdout(sys.stderr):\\n        spec = importlib.util.spec_from_file_location('candidate', path)\\n        module = importlib.util.module_from_spec(spec)\\n        spec.loader.exec_module(module)\\n    for line in sys.stdin.buffer:\\n        if len(line) >= 64 * 1024 * 1024:\\n            raise ValueError('oversized request')\\n        request = json.loads(line, parse_constant=lambda value: (_ for _ in ()).throw(ValueError('nonfinite JSON')))\\n        with contextlib.redirect_stdout(sys.stderr):\\n            response = module.handle(request)\\n        encoded = json.dumps(response, allow_nan=False, ensure_ascii=False, separators=(',', ':')) + '\\\\n'\\n        if len(encoded.encode('utf-8')) >= 64 * 1024 * 1024:\\n            raise ValueError('oversized response')\\n        output.write(encoded)\\n        output.flush()\\n\\n\\ndef report_worker_exception(error):\\n    name = type(error).__name__\\n    if not name.isascii() or not name.isidentifier() or len(name) > 80:\\n        name = 'WorkerException'\\n    try:\\n        message = str(error)\\n    except Exception:\\n        message = '<exception message unavailable>'\\n    if len(message) > 2048 or len(message.encode('utf-8', errors='replace')) > 2048:\\n        message = '<exception message omitted: too large>'\\n    print(f'worker_exception type={name}\\\\n{message}', file=sys.stderr, flush=True)\\n\\ntry:\\n    main()\\nexcept Exception as error:\\n    if sys.argv[-1] == 'repair':\\n        report_worker_exception(error)\\n    else:\\n        print('candidate_worker_failure', file=sys.stderr, flush=True)\\n    raise SystemExit(1)\\n\"\ntask/evaluate.py:348:DROP_FIELDS = {'evaluation_time', 'kg_co2_emissions', 'mteb_version', 'model_name', 'model', 'model_id', 'model_revision', 'revision', 'timestamp', 'path', 'evaluation_time_per_sample', 'dataset_revision', 'dataset_id', 'date'}\ntask/evaluate.py:354:        if 'mteb_dataset_name' in normalized:\ntask/evaluate.py:355:            task_name = normalized.pop('mteb_dataset_name')\ntask/evaluate.py:421:                context = [task, 'eng-Latn', split, canonical_metric, document.get('dataset_revision')]\ntask/evaluate.py:437:def factor_fit(matrix, mask, rank, ridge, sweeps, seed, check=lambda: None):\ntask/evaluate.py:440:    rng = np.random.default_rng(seed)\ntask/evaluate.py:444:    identity = np.eye(rank) * ridge\ntask/evaluate.py:459:    rng = np.random.default_rng(seed)\ntask/evaluate.py:460:    validation = (rng.random(mask.shape) < .1) & mask\ntask/evaluate.py:464:        for ridge in (.1, 1.):\ntask/evaluate.py:465:            offset, factors = factor_fit(matrix, train_mask, rank, ridge, min(8, sweeps), seed, check)\ntask/evaluate.py:470:                prediction = condition(offset, factors, ridge, observed, matrix[row, observed])\ntask/evaluate.py:473:            item = (loss, rank, ridge)\ntask/evaluate.py:476:    _, rank, ridge = best\ntask/evaluate.py:477:    offset, factors = factor_fit(matrix, mask, rank, ridge, sweeps, seed, check)\ntask/evaluate.py:478:    return offset, factors, ridge\ntask/evaluate.py:481:def condition(offset, factors, ridge, columns, values):\ntask/evaluate.py:485:    latent = np.linalg.solve(design.T @ design + np.eye(factors.shape[1]) * ridge, design.T @ (np.asarray