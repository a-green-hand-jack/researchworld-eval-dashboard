{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json, statistics, hashlib, re\nfrom pathlib import Path\nfrom collections import defaultdict, Counter\npaper=json.loads(Path('paper_data.json').read_text())\nevidence=paper['final_evaluation']['evaluation_evidence']\nraw=json.loads(Path('source_evidence/evaluation_evidence.json').read_text())\nassert raw['episodes']==evidence['episodes']\nfor filename,expected in [('source_evidence/evaluate_final.py',paper['final_evaluation']['evaluator_sha256']),('source_evidence/evaluation_evidence.json',evidence['sha256'])]:\n    assert 'sha256:'+hashlib.sha256(Path(filename).read_bytes()).hexdigest()==expected\nrecords=[]\ngroups=defaultdict(list)\nfor episode in evidence['episodes']:\n    for item in episode['solution']:\n        case,obs=item['case'],item['observations']\n        trace=obs['trace']\n        assert [point['step'] for point in trace]==list(range(0,20001,500))\n        for field,threshold,event in [('train_accuracy',.99,'memorization'),('heldout_accuracy',.95,'generalization')]:\n            computed=next((trace[index]['step'] for index in range(len(trace)-2) if all(point[field]>=threshold for point in trace[index:index+3])),None)\n            assert computed==obs[event]\n        records.append((case,obs))\n        groups[(case['operation'],case['decay'],case['width'])].append(obs)\nprint('Final raw observations match embedded records; evaluator and observation hashes match.')\nprint('records, memorized, generalized:',len(records),sum(obs['memorization'] is not None for _,obs in records),sum(obs['generalization'] is not None for _,obs in records))\nfor key,rows in groups.items():\n    train=[100*statistics.fmean(row['train_accuracy'] for row in obs['trace'][-5:]) for obs in rows]\n    held=[100*statistics.fmean(row['heldout_accuracy'] for row in obs['trace'][-5:]) for obs in rows]\n    print(key,'T_M',[obs['memorization'] for obs in rows],'train',round(statistics.fmean(train),3),'held',round(statistics.fmean(held),3),'sd',round(statistics.stdev(held),3),'CE',round(statistics.fmean(obs['trace'][-1]['heldout_loss'] for obs in rows),3))\ntext=Path('paper.tex').read_text()\nfor name in ('full_observations','diagnostics'):\n    table=Path('tables/'+name+'.tex').read_text()\n    table=table[table.index('\\\\\\\\begin'):].strip()\n    assert table in text,name\nprint('Both supplementary numeric tables exactly match derived table artifacts.')\nfor width in [16,64,256]:\n    norms=[obs['trace'][0]['weight_norm'] for case,obs in records if case['width']==width]\n    print('Initial norm mean',width,round(statistics.fmean(norms),3))\nprint('Control averages', {key:100*statistics.fmean(point['controls'][key] for _,obs in records for point in obs['trace'][-5:]) for key in records[0][1]['trace'][0]['controls']})\nresource=json.loads(Path('source_evidence/resources/final/benchmark.json').read_text())\nprint('Data splits',{operation:dict(Counter(row['split'] for row in rows)) for operation,rows in resource['examples'].items()})\nprint('Durations', [episode['duration_seconds'] for episode in evidence['episodes']])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
