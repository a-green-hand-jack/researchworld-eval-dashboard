 1,\n  \"started_at\": \"2026-11-07T05:57:26.804994+00:00\",\n  \"status\": \"started\",\n  \"task_tree_sha256\": \"sha256:7a926d279d983569c28cd59e8e47451170af57d53bc2aac3060e52bb85985e1b\"\n}\n    return boundary_group\n\n\ndef fit_model(covariates, responses, basis):\n    transformed = np.log(responses) @ basis\n    design = features(covariates)\n    dimension = basis.shape[1]\n    if len(covariates) < 4:\n        location = ridge(design, transformed, 0.01)\n        variance = np.zeros((design.shape[1], dimension))\n        train_boundary_scores = predicted_boundary(design @ location, basis)\n        boundary_edges = np.quantile(train_boundary_scores, [1.0 / 3.0, 2.0 / 3.0])\n        group_factors = np.repeat(np.eye(dimension)[None, :, :], 3, axis=0)\n        return location, variance, boundary_edges, group_factors\n    cut = 3 * len(covariates) // 4\n    location = ridge(design[:cut], transformed[:cut], 0.01)\n    residuals = transformed[cut:] - design[cut:] @ location\n    variance = ridge(design[cut:], np.log(residuals ** 2 + 0.02), 5.0)\n    train_boundary_scores = predicted_boundary(design @ location, basis)\n    boundary_edges = np.quantile(train_boundary_scores, [1.0 / 3.0, 2.0 / 3.0])\n    residual_groups = boundary_groups(train_boundary_scores[cut:], boundary_edges)\n    scales = np.exp(0.5 * np.clip(design[cut:] @ variance, -6, 5))\n    standardized = np.clip(residuals / scales, -1000.0, 1000.0)\n    identity = np.eye(dimension)\n    pooled_shape = (standardized.T @ standardized + 8.0 * identity) / (len(residuals) + 8.0)\n    group_factors = np.empty((3, dimension, dimension))\n    for group_index in range(3):\n        group_residuals = standardized[residual_groups == group_index]\n        group_shape = (group_residuals.T @ group_residuals + 32.0 * pooled_shape) / (len(group_residuals) + 32.0)\n        group_factors[group_index] = np.linalg.cholesky(group_shape)\n    return location, variance, boundary_edges, group_factors\n\n\ndef handle(request):\n    operation = request['op']\n    if operation == 'reset':\n        if set(request) != {'op', 'seed'} or type(request['seed']) is not int or not 0 <= request['seed'] < 2**63:\n            raise ValueError('invalid reset')\n        STATE.clear()\n        STATE['rng'] = np.random.default_rng(request['seed'])\n        return {'ok': True}\n    if 'rng' not in STATE:\n        raise ValueError('reset required')\n    if operation == 'fit_start':\n        if 'upload' in STATE or 'model' in STATE:\n            raise ValueError('one fit per reset')\n    location = ridge(design[:cut], transformed[:cut], 0.01)\n    residuals = transformed[cut:] - design[cut:] @ location\n    variance = ridge(design[cut:], np.log(residuals ** 2 + 0.02), 5.0)\n    return location, variance\n\n\ndef handle(request):\n    operation = request['op']\n    if operation == 'reset':\n        if set(request) != {'op', 'seed'} or type(request['seed']) is not int or not 0 <= request['seed'] < 2**63:\n            raise ValueError('invalid reset')\n        STATE.clear()\n        STATE['rng'] = np.random.default_rng(request['seed'])\n        return {'ok': True}\n    if 'rng' not in STATE:\n        raise ValueError('reset required')\n    if operation == 'fit_start':\n        if 'upload' in STATE or 'model' in STATE:\n            raise ValueError('one fit per reset')\n        rows, size = request['n_rows'], request['composition_dim']\n        if type(rows) is not int or not 1 <= rows <= 4096 or size not in (3, 8):\n            raise ValueError('invalid training shape')\n        raw_size = rows * (5 + size) * 8\n        if request['nbytes'] != raw_size or request['chunks'] != math.ceil(raw_size / CHUNK):\n            raise ValueError('invalid transfer')\n        basis = np.asarray(request['ilr_basis'], dtype=float)\n        if basis.shape != (size, size - 1) or not np.allclose(basis.T @ basis, np.eye(size - 1)):\n            raise ValueError('invalid basis')\n        STATE.update(upload=bytearray(), metadata=dict(request), basis=basis, upload_index=0)\n        return {'ok': True}\n    if operation == 'fit_chunk':\n        if 'upload' not in STATE or request['index'] != STATE['upload_index']:\n            raise ValueError('invalid upload order')\n        block = decode(request['block'])\n        expected = min(CHUNK, STATE['metadata']['nbytes'] - len(STATE['upload']))\n        if block.ndim != 1 or block.nbytes != expected or expected < 1:\n            raise ValueError('invalid upload length')\n        STATE['upload'].extend(block.tobytes())\n        STATE['upload_index'] += 1\n        return {'ok': True}\n    if operation == 'fit_commit':\n        metadata = STATE['metadata']\n        if len(STATE['upload']) != metadata['nbytes'] or STATE['upload_index'] != metadata['chunks']:\n\ndef predicted_boundary(means, basis):\n    logits = means @ basis.T\n    weights = np.exp(logits - logits.max(axis=-1, keepdims=True))\n    predictions = weights / weights.sum(axis=-1, keepdims=True)\n    return predictions.min(axis=-1)\n\n\ndef boundary_groups(predicted_boundary_score, boundary_edges):\n    boundary_group = np.searchsorted(boundary_edges, predicted_boundary_score, side='right')\n    return boundary_group\n\n\ndef interpolate_shapes(boundary_scores, shape_knots, shape_matrices):\n    if len(shape_knots) == 1:\n        return np.broadcast_to(shape_matrices[0], (len(boundary_scores),) + shape_matrices.shape[1:])\n    right_index = np.clip(np.searchsorted(shape_knots, boundary_scores, side='right'), 1, len(shape_knots) - 1)\n    left_index = right_index - 1\n    blend = np.clip((boundary_scores - shape_knots[left_index]) / (shape_knots[right_index] - shape_knots[left_index]), 0.0, 1.0)\n    query_shapes = (1.0 - blend)[:, None, None] * shape_matrices[left_index] + blend[:, None, None] * shape_matrices[right_index]\n    return query_shapes\n\n\ndef fit_model(covariates, responses, basis):\n    transformed = np.log(responses) @ basis\n    design = features(covariates)\n    dimension = basis.shape[1]\n    if len(covariates) < 4:\n        location = ridge(design, transformed, 0.01)\n        variance = np.zeros((design.shape[1], dimension))\n        train_boundary_scores = predicted_boundary(design @ location, basis)\n        shape_knots = np.array([np.median(train_boundary_scores)])\n        shape_matrices = np.eye(dimension)[None, :, :]\n        return location, variance, shape_knots, shape_matrices\n    fold_count = 4\n    fold_ids = np.arange(len(covariates)) % fold_count\n    oof_residuals = np.empty_like(transformed)\n    for fold_index in range(fold_count):\n        held_out = fold_ids == fold_index\n        fold_location = ridge(design[~held_out], transformed[~held_out], 0.01)\n        oof_residuals[held_out] = transformed[held_out] - design[held_out] @ fold_location\n    final_location = ridge(design, transformed, 0.01)\n    variance = ridge(design, np.log(oof_residuals ** 2 + 0.02), 5.0)\n    train_boundary_scores = predicted_boundary(design @ final_location, basis)\n    boundary_edges = np.quantile(train_boundary_scores, [1.0 / 3.0, 2.0 / 3.0])\n    residual_groups = boundary_groups(train_boundary_scores, boundary_edges)\n    scales = np.exp(0.5 * np.clip(design @ variance, -6, 5))\n    standardized = np.clip(oof_residuals / scales, -1000.0, 1000.0)\n    identity = np.eye(dimension)\n    pooled_shape = (standardized.T @ standardized + 8.0 * identity) / (len(oof_residuals) + 8.0)\n    group_shapes = np.empty((3, dimension, dimension))\n    for group_index in range(3):\n        group_residuals = standardized[residual_groups == group_index]\n        group_shape = (group_residuals.T @ group_residuals + 32.0 * pooled_shape) / (len(group_residuals) + 32.0)\n        group_shapes[group_index] = group_shape\n    anchor_knots = np.quantile(train_boundary_scores, [1.0 / 6.0, 0.5, 5.0 / 6.0])\n    shape_knots, anchor_inverse = np.unique(anchor_knots, return_inverse=True)\n    shape_matrices = np.stack([group_shapes[anchor_inverse == knot_index].mean(axis=0) for knot_index in range(len(shape_knots))])\n---\nname: generate-concept-figure\ndescription: Generate one reader-facing conceptual overview figure for paper generation as an editable draw.io diagram via the pinned Autoillustrate npm release, with a deterministic layout and an optional image-model restyle.\n---\n\n# Who runs this (important)\nDuring **paper generation the orchestrator owns this pipeline**: `src/scripts/paper.sh` and `paper_edit.sh` run the installed `autoillustrate` CLI synchronously as a post-draft step (`run_concept_figure_step`), derive every argument from `paper_strategy.json`, forward the selected outer agent, and promote the result to `./figures/<figure_id>.png`. The phase agents always run in a dedicated one-shot Docker container, even when the outer paper workflow is native; this limits them to the paper directory, selected-agent auth, and selected provider credentials. The paper-writing agent must **not** invoke this pipeline itself. The rest of this document describes the same CLI for standalone/manual use.\n\n# What the skill is about\nGenerate one reader-facing conceptual overview figure for the paper when a high-level glance-value visual will clarify the method, comparison story, or evidence structure. The figure is produced by the Autoillustrate pipeline (the `autoillustrate` npm release pinned in the agent image): each panel is a collision-checked, deterministically laid-out draw.io diagram, the panels are composed into a single editable `.drawio` file, and the composite is optionally restyled into a camera-ready PNG. The deliverable is a real `.drawio` source plus its export — only the final restyle pass touches a generative model.\n\n# When to use the skill\n- Final paper generation.\n- The paper needs an early conceptual figure that is easier to scan than a dense quantitative plot.\n- The grounded artifacts support a clean overview figure without inventing unsupported mechanisms or claims.\n- `paper_strategy.json` requests a required overview-style `diagram` figure or the paper prompt calls for an overview figure on page 1 or 2.\n- The figure is a methods/architecture/training-loop schematic with 1–3 structurally distinct panels. (For pure quantitative plots use matplotlib/seaborn instead.)\n\n# Prerequisites\nThe pipeline shells out to several tools. Confirm them before claiming a hard failure:\n- **`drawio` desktop CLI** on `PATH` (headless export). Without it Phases 2/4 cannot export.\n- **`autoillustrate` and `headless`** on `PATH`, plus the selected agent CLI (`claude`, `codex`, `cursor`, `gemini`, `opencode`, or `pi`).\n- For environment-authenticated OpenCode phase agents, set `PAPER_CONCEPT_FIGURE_AGENT_PROVIDER` to exactly one of `openai`, `gemini`, or `anthropic`; only that provider credential is forwarded.\n- **`OPENAI_API_KEY`** — the default VLM backend (`gpt-5.5`) for the Phase 3 per-panel inspection and the Phase 6 verification, and the image model (`gpt-image-2`) for the Phase 5 restyle. Without it those VLM calls and the restyle cannot run; you can still ship the deterministic Phase 4 export with `--skip-enhance`.\n- **`GEMINI_API_KEY`** — optional fallback. When OpenAI is unavailable, the paper orchestrator selects `nanobanana-pro`, `gemini-3.1-pro`, and `gemini-single` for enhancement and audits.\n- **A Python venv** with the toolkit deps. The container image bakes one and exposes its interpreter as `$VENV_PY`.\n\nBefore deciding a key is missing, check the active environment directly. OpenAI is the default; Gemini is the automatic fallback:\n```bash\npython - <<'PY'\nimport os\nfor k in (\"OPENAI_API_KEY\", \"GEMINI_API_KEY\"):\n    print(f\"{k}: {'available' if os.getenv(k) else 'missing'}\")\nPY\n```\nDo not claim a key is unavailable when the rendered paper prompt says it is expected to be available unless your direct check still shows it missing. Without an enhancement key, `--skip-enhance` still ships the deterministic Phase 4 export.\n\n# What to do\n1. Infer the central mechanism, comparison, or evidence story from grounded artifacts only. Decide whether one cohesive panel suffices or the content naturally splits into 2–3 structurally independent panels (e.g. *architecture · update rule · training loop*). Prefer one overview figure, not a full illustration suite.\n\nTraceback (most recent call last):\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 419, in <module>\n    raise SystemExit(main())\n                     ^^^^^^\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 415, in main\n    return _run_append_event(args)\n           ^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 405, in _run_append_event\n    _append_text(global_memory_md_path, _markdown_entry(event), header=GLOBAL_MEMORY_HEADER)\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 126, in _append_text\n    fd = _open_regular_for_append(path)\n         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 161, in _open_regular_for_append\n    directory_fd = _walk_directory_no_follow(path.parent)\n                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 198, in _walk_directory_no_follow\n    next_descriptor = os.open(component, flags, dir_fd=descriptor)\n                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\nNotADirectoryError: [Errno 20] Not a directory: 'global_memory'\n","exit_code":1,"status":"failed"}}
