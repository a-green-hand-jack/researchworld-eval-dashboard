{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"sed -n '701,763p' task/evaluate_final.py; sed -n '810,1126p' task/evaluate_final.py; cat results/ideas/03_training_only_conformal_rank_scale_selection/program_1/program_spec.toml; cat results/ideas/03_training_only_conformal_rank_scale_selection/program_1/src/program.py\"","aggregated_output":"def basis(dimension):\n    matrix = np.zeros((dimension, dimension - 1))\n    for column in range(1, dimension):\n        denominator = math.sqrt(column * (column + 1))\n        matrix[:column, column - 1] = 1 / denominator\n        matrix[column, column - 1] = -column / denominator\n    return matrix\n\n\ndef inverse_ilr(center, matrix):\n    logits = center @ matrix.T\n    logits -= logits.max(axis=1, keepdims=True)\n    probabilities = np.exp(logits)\n    return probabilities / probabilities.sum(axis=1, keepdims=True)\n\n\ndef numeric_hash(array):\n    array = np.array(array, dtype='<f8', order='C', copy=True)\n    if not np.isfinite(array).all():\n        raise ValueError('nonfinite raw data')\n    array[array == 0] = 0\n    header = json.dumps({'schema': 'raw-f64-v1', 'shape': list(array.shape)},\n                        sort_keys=True, separators=(',', ':')).encode('ascii')\n    return hashlib.sha256(header + b'\\n' + array.tobytes()).hexdigest()\n\n\ndef generate_arrays(seed, case_index, counts):\n    \"\"\"Frozen composition-v1 recipe; independent RNG substreams before any transform.\n\n    Raw numeric normalization is float64 little endian, negative zero to zero.\n    Logistic normal sigma=.25. Dirichlet has concentration 4+35*sigmoid(-2*x0),\n    with a declared 1e-12 positivity floor then closure. Shift changes only test X.\n    Subgroups: x0>0 and x0<=0. Uniform-simplex probes are Dirichlet(1,...,1).\n    \"\"\"\n    case = CASES[case_index]\n    dimension = 3 if case.endswith('K3') else 8\n    matrix = basis(dimension)\n    weights = np.sin(np.arange(6 * (dimension - 1)).reshape(6, dimension - 1) + 1) / 3\n    arrays = {}\n    for split_index, (split, count) in enumerate(zip(('train', 'calibration', 'test'), counts)):\n        generator = np.random.default_rng(np.random.SeedSequence([seed, case_index, split_index, 202611]))\n        if 'SHIFT' in case and split == 'test':\n            features = np.clip(generator.normal(.8, 1.0, (count, 6)), -2.5, 3.0)\n        else:\n            features = generator.uniform(-1.5, 1.5, (count, 6))\n        mean = .7 * np.sin(features @ weights) + .3 * features[:, :1] * np.cos(np.arange(dimension - 1))\n        if case.startswith('LN'):\n            composition = inverse_ilr(mean + generator.normal(0, .25, mean.shape), matrix)\n        else:\n            mean_composition = inverse_ilr(mean, matrix)\n            concentration = 4 + 35 / (1 + np.exp(2 * features[:, 0]))\n            gamma = generator.gamma(mean_composition * concentration[:, None], 1.0)\n            gamma = np.maximum(gamma, 1e-12)\n            composition = gamma / gamma.sum(axis=1, keepdims=True)\n        arrays['x_' + split] = features\n        arrays['y_' + split] = composition\n    reference_rng = np.random.default_rng(np.random.SeedSequence([seed, case_index, 3, 202611]))\n    arrays['contexts'] = reference_rng.choice(counts[2], size=128, replace=False)\n    arrays['probes'] = reference_rng.dirichlet(np.ones(dimension), size=1024)\n    return arrays\n\n\ndef load_resources(root, smoke, deadline):\n                arrays['y_' + split] = arrays['y_' + split][:count]\n            arrays['contexts'] = np.arange(16)\n            arrays['probes'] = arrays['probes'][:64]\n        if (numeric_hash(arrays['probes']) != entry['probe_hash'] and not smoke):\n            raise ValueError('reference probe checksum')\n        dimension = arrays['y_train'].shape[1]\n        matrix = basis(dimension)\n        if not np.allclose(matrix.T @ matrix, np.eye(dimension - 1), atol=1e-12):\n            raise ValueError('ILR orthogonality')\n        if not np.allclose(inverse_ilr(np.log(arrays['y_train'][:5]) @ matrix, matrix),\n                           arrays['y_train'][:5], atol=1e-12):\n            raise ValueError('ILR roundtrip')\n        episodes.append({'seed': entry['seed'], 'case': entry['case'], 'arrays': arrays})\n    return episodes\n\n\ndef check_deadline(deadline):\n    if time.monotonic() >= deadline:\n        raise TimeoutError('evaluator work deadline')\n\n\ndef quantile(scores, alpha):\n    rank = math.ceil((len(scores) + 1) * (1 - alpha))\n    if rank > len(scores):\n        return math.inf\n    return float(np.partition(scores, rank - 1)[rank - 1])\n\n\ndef wilson(successes, count, normal_quantile=1.959963984540054):\n    if count == 0:\n        return None\n    proportion = successes / count\n    quantile_squared = normal_quantile * normal_quantile\n    denominator = 1 + quantile_squared / count\n    center = (proportion + quantile_squared / (2 * count)) / denominator\n    radius = normal_quantile * math.sqrt(proportion * (1 - proportion) / count + quantile_squared / (4 * count * count)) / denominator\n    return [max(0, center - radius), min(1, center + radius)]\n\n\ndef prediction(response, rows, dimension):\n    if type(response) is not dict or set(response) != {'center', 'scale'}:\n        raise ProtocolFailure('prediction schema')\n    center = decode_array(response['center'], (rows, dimension - 1))\n    scale = decode_array(response['scale'], (rows, dimension - 1))\n    if (np.abs(center) > 100).any() or (scale < 1e-4).any() or (scale > 100).any():\n        raise ProtocolFailure('prediction support')\n    return center, scale\n\n\ndef score_method(name, center, scale, arrays, deadline):\n    check_deadline(deadline)\n    calibration_targets, test_targets = arrays['y_calibration'], arrays['y_test']\n    calibration_count = len(calibration_targets)\n    dimension = test_targets.shape[1]\n    matrix = basis(dimension)\n    contexts, probes = arrays['contexts'], arrays['probes']\n    if name == 'constant_center':\n        fixed = (np.log(arrays['y_train']) @ matrix).mean(0)\n        center = np.tile(fixed, (len(center), 1))\n        scale = np.ones_like(center)\n    elif name == 'unscaled_ilr':\n        scale = np.ones_like(scale)\n    calibration_center, test_center = center[:calibration_count], center[calibration_count:]\n    calibration_scale, test_scale = scale[:calibration_count], scale[calibration_count:]\n    center_simplex = inverse_ilr(center, matrix)\n    ilr_family = name in ('scaled_ilr', 'unscaled_ilr', 'constant_center', 'constant_input', 'permuted_input')\n    if ilr_family:\n        calibration_residual = np.abs(np.log(calibration_targets) @ matrix - calibration_center) / calibration_scale\n        test_residual = np.abs(np.log(test_targets) @ matrix - test_center) / test_scale\n        probe_targets = np.log(probes) @ matrix\n    else:\n        calibration_residual = np.abs(calibration_targets - center_simplex[:calibration_count])\n        test_residual = np.abs(test_targets - center_simplex[calibration_count:])\n        probe_targets = probes\n    records = []\n    for alpha in ALPHAS:\n        check_deadline(deadline)\n        if name == 'whole_simplex':\n            threshold = math.inf\n        elif name == 'copy_point':\n            threshold = 0.0\n        elif name == 'bonferroni':\n            threshold = np.array([quantile(calibration_residual[:, coordinate], alpha / dimension)\n                                  for coordinate in range(dimension)])\n        else:\n            threshold = quantile(calibration_residual.max(axis=1), alpha)\n        membership = np.all(test_residual <= threshold, axis=1)\n        hits_per_context = []\n        for offset in range(0, len(contexts), 16):\n            check_deadline(deadline)\n            indices = contexts[offset:offset + 16]\n            if ilr_family:\n                residual = np.abs(probe_targets[None, :, :] - test_center[indices, None, :]) / test_scale[indices, None, :]\n            else:\n                residual = np.abs(probe_targets[None, :, :] - center_simplex[calibration_count + indices, None, :])\n            hits_per_context.extend(np.all(residual <= threshold, axis=2).sum(axis=1).tolist())\n        coverage = float(membership.mean())\n        volume = float(np.mean(hits_per_context) / len(probes))\n        error = abs(coverage - (1 - alpha))\n        utility = (1 - volume) * max(0, 1 - error / (1 - alpha))\n        subgroup = arrays['x_test'][:, 0] > 0\n        subgroup_records = []\n        for mask in (subgroup, ~subgroup):\n            count = int(mask.sum())\n            successes = int(membership[mask].sum())\n            subgroup_records.append({'count': count, 'coverage': successes / count if count else None,\n                                     'conditional_wilson95': wilson(successes, count)})\n        context_probabilities = np.array(hits_per_context) / len(probes)\n        records.append({'alpha': alpha, 'coverage': coverage, 'volume': volume, 'utility': utility,\n                        'coverage_error': error, 'conditional_wilson95': wilson(int(membership.sum()), len(membership)),\n                        'subgroups': subgroup_records,\n                        'quantile': np.where(np.isfinite(threshold), threshold, -1).tolist(),\n                        'infinite_quantile': bool(np.any(np.isinf(threshold))),\n                        'volume_probe_resolution': 1 / len(probes),\n                        'zero_hit_contexts': int((np.array(hits_per_context) == 0).sum()),\n                        'mean_context_mc_se_bound': float(np.mean(np.sqrt(context_probabilities * (1 - context_probabilities) / len(probes)))),\n                        'zero_hit_one_sided95_upper': 1 - .05 ** (1 / len(probes)),\n                        'ilr_center_mse': float(np.mean((np.log(test_targets) @ matrix - test_center) ** 2))})\n    return records\n\n\ndef evaluate_episode(episode, call, work_deadline):\n    arrays = episode['arrays']\n    dimension = arrays['y_train'].shape[1]\n    methods_remaining = 13\n    local_deadline = min(work_deadline, time.monotonic() + 13 * (WORK_SECONDS + METHOD_CLEANUP) + .5)\n    def allowance():\n        nonlocal methods_remaining\n        methods_remaining -= 1\n        return reserved_method_deadline(now=time.monotonic(), episode_deadline=local_deadline,\n            methods_remaining=methods_remaining, work_seconds=WORK_SECONDS, cleanup_seconds=METHOD_CLEANUP)\n    active_deadline = allowance()\n    def bounded_call(request):\n        check_deadline(active_deadline)\n        response = call(request, deadline=active_deadline)\n        check_deadline(active_deadline)\n        return response\n    completed = set()\n    unfitted = bounded_call({'op': 'predict', 'x': encode_array(arrays['x_train'][:2])})\n    if unfitted != {'status': 'unfitted'}:\n        raise ProtocolFailure('reset leakage control')\n    completed.add('reset_unfitted')\n    center_ack = bounded_call({'op': 'fit_center', 'x': encode_array(arrays['x_train']),\n                               'y': encode_array(arrays['y_train']), 'dimension': dimension})\n    if type(center_ack) is not dict or set(center_ack) != {'ok'} or center_ack['ok'] is not True:\n        raise ProtocolFailure('fit center acknowledgment')\n    scale_ack = bounded_call({'op': 'fit_scale'})\n    if type(scale_ack) is not dict or set(scale_ack) != {'ok'} or scale_ack['ok'] is not True:\n        raise ProtocolFailure('fit scale acknowledgment')\n    features = np.concatenate((arrays['x_calibration'], arrays['x_test']))\n    calibration_count = len(arrays['x_calibration'])\n    constant_features = np.tile(arrays['x_train'].mean(0), (len(features), 1))\n    permutation = np.concatenate((np.roll(np.arange(calibration_count), 1),\n                                  calibration_count + np.roll(np.arange(len(arrays['x_test'])), 1)))\n    changed_rows = np.any(features != features[permutation], axis=1)\n    if ((permutation == np.arange(len(features))).any()\n            or np.count_nonzero(changed_rows[:calibration_count]) < 2\n            or np.count_nonzero(changed_rows[calibration_count:]) < 2):\n        raise ProtocolFailure('vacuous permutation control')\n    query_entropy = int.from_bytes(hashlib.sha256(arrays['probes'].tobytes()).digest()[:8], 'little')\n    query_order = np.random.default_rng(query_entropy).permutation(len(features))\n    original_order = np.argsort(query_order)\n    predictions = {}\n    for name, inputs in (('scaled_ilr', features), ('constant_input', constant_features),\n                         ('permuted_input', features[permutation])):\n        active_deadline = allowance()\n        response = bounded_call({'op': 'predict', 'x': encode_array(inputs[query_order])})\n        ordered_center, ordered_scale = prediction(response, len(inputs), dimension)\n        predictions[name] = ordered_center[original_order], ordered_scale[original_order]\n        if name == 'constant_input':\n            center, scale = predictions[name]\n            if not np.allclose(center, center[0], rtol=0, atol=1e-10) or not np.allclose(scale, scale[0], rtol=0, atol=1e-10):\n                raise ProtocolFailure('constant input structural control')\n            completed.add(name)\n        elif name == 'permuted_input':\n            center, scale = predictions[name]\n            main_center, main_scale = predictions['scaled_ilr']\n            if (not np.allclose(center, main_center[permutation], rtol=1e-10, atol=1e-10)\n                    or not np.allclose(scale, main_scale[permutation], rtol=1e-10, atol=1e-10)):\n                raise ProtocolFailure('prediction read-only alignment')\n            completed.add(name)\n    records = {}\n    for name in METHODS:\n        active_deadline = allowance()\n        center, scale = predictions.get(name, predictions['scaled_ilr'])\n        started = time.monotonic()\n        try:\n            records[name] = score_method(name, center, scale, arrays, active_deadline)\n        except TimeoutError as error:\n            if name not in ('scaled_ilr', 'constant_input', 'permuted_input', 'copy_point'):\n                raise RequiredBaselineFailure('baseline_timeout') from error\n            raise\n        if time.monotonic() > active_deadline:\n            raise RequiredBaselineFailure('baseline_timeout')\n        for record in records[name]:\n            record['productive_scoring_seconds'] = max(0, time.monotonic() - started)\n    if any(record['coverage'] >= .5 for record in records['copy_point']):\n        raise ProtocolFailure('zero radius scorer control')\n    completed.add('copy_point')\n    if EXPECTED_CONTROLS - completed:\n        raise ProtocolFailure('required control incomplete')\n    main = records['scaled_ilr']\n    return {'score': float(np.mean([record['utility'] for record in main])),\n            'error': float(np.mean([record['coverage_error'] for record in main])),\n            'volume': float(np.mean([record['volume'] for record in main])),\n            'controls': 1.0, 'correct': True, 'duration_seconds': 0.0,\n            'solution': {'case': episode['case'], 'complete': True, 'controls': sorted(completed),\n                         'control_checks': {name: name in completed for name in sorted(EXPECTED_CONTROLS)},\n                         'methods': records}}\n\n\ndef worst_case(episode):\n    return {'score': 0.0, 'error': 1.0, 'volume': 1.0, 'controls': 0.0,\n            'correct': False, 'duration_seconds': 0.0,\n            'solution': {'case': episode['case'], 'complete': False, 'controls': [],\n                         'control_checks': {name: False for name in sorted(EXPECTED_CONTROLS)},\n                         'methods': None}}\n\n\ndef fixed_mean(values):\n    if not values or not all(type(value) in (int, float) and math.isfinite(value) for value in values):\n        raise ValueError('invalid fixed-denominator contributions')\n    return math.fsum(values) / len(values)\n\n\ndef uncertainty_by_case(episodes, outcomes):\n    intervals = {}\n    generator = np.random.default_rng(62845)\n    selected_cases = list(dict.fromkeys(episode['case'] for episode in episodes))\n    for case in selected_cases:\n        case_outcomes = [outcome for episode, outcome in zip(episodes, outcomes) if episode['case'] == case]\n        data = np.array([outcome['score'] for outcome in case_outcomes])\n        if len(data) < 2:\n            intervals[case] = {'seed_count': len(data), 'bootstrap95': None, 'paired_baselines': None}\n            continue\n        indices = generator.integers(0, len(data), size=(20000, len(data)))\n        boot = data[indices].mean(1)\n        comparisons = {}\n        for baseline in ('unscaled_ilr', 'simplex_linf', 'bonferroni'):\n            alpha_results = []\n            for alpha_index in range(3):\n                differences, volume_differences = [], []\n                for outcome in case_outcomes:\n                    methods = outcome['solution']['methods']\n                    if methods is None:\n                        differences.append(-1.0)\n                        volume_differences.append(1.0)\n                    else:\n                        differences.append(methods['scaled_ilr'][alpha_index]['utility'] - methods[baseline][alpha_index]['utility'])\n                        volume_differences.append(methods['scaled_ilr'][alpha_index]['volume'] - methods[baseline][alpha_index]['volume'])\n                bootstrap_difference = np.array(differences)[indices].mean(1)\n                bootstrap_volume = np.array(volume_differences)[indices].mean(1)\n                adjusted_tail = .05 / (2 * 54)\n                alpha_results.append({'alpha': ALPHAS[alpha_index], 'utility_difference': fixed_mean(differences),\n                    'volume_difference': fixed_mean(volume_differences),\n                    'paired_seed_bootstrap95': np.quantile(bootstrap_difference, [.025, .975]).tolist(),\n                    'paired_volume_bootstrap95': np.quantile(bootstrap_volume, [.025, .975]).tolist(),\n                    'bonferroni54_bootstrap_interval': np.quantile(bootstrap_difference, [adjusted_tail, 1 - adjusted_tail]).tolist()})\n            comparisons[baseline] = alpha_results\n        feature_controls = {}\n        for control in ('constant_input', 'permuted_input'):\n            control_differences = []\n            for alpha_index in range(3):\n                differences = []\n                for outcome in case_outcomes:\n                    methods = outcome['solution']['methods']\n                    differences.append(-1.0 if methods is None else\n                        methods['scaled_ilr'][alpha_index]['utility'] - methods[control][alpha_index]['utility'])\n                distribution = np.array(differences)[indices].mean(1)\n                control_differences.append({'alpha': ALPHAS[alpha_index], 'main_minus_control_utility': fixed_mean(differences),\n                    'paired_seed_bootstrap95': np.quantile(distribution, [.025, .975]).tolist()})\n            feature_controls[control] = control_differences\n        intervals[case] = {'seed_count': len(data), 'bootstrap95': np.quantile(boot, [.025, .975]).tolist(),\n                           'paired_baselines': comparisons, 'feature_controls': feature_controls}\n    seed_scores = []\n    for seed in dict.fromkeys(episode['seed'] for episode in episodes):\n        seed_scores.append(fixed_mean([outcome['score'] for episode, outcome in zip(episodes, outcomes)\n                                       if episode['seed'] == seed]))\n    overall_interval = None\n    if len(seed_scores) > 1:\n        indices = generator.integers(0, len(seed_scores), size=(20000, len(seed_scores)))\n        overall_interval = np.quantile(np.array(seed_scores)[indices].mean(1), [.025, .975]).tolist()\n    intervals['overall_seed_block'] = {'seed_count': len(seed_scores), 'bootstrap95': overall_interval}\n    return intervals\n\n\ndef aggregate(episodes, outcomes, complete):\n    score = fixed_mean([outcome['score'] for outcome in outcomes])\n    iid = [outcome['error'] for episode, outcome in zip(episodes, outcomes) if 'SHIFT' not in episode['case']]\n    shift = [outcome['error'] for episode, outcome in zip(episodes, outcomes) if 'SHIFT' in episode['case']]\n    valid = complete and all(outcome['correct'] for outcome in outcomes)\n    baseline_gap = -1.0\n    if valid:\n        baseline_scores = []\n        for name in ('unscaled_ilr', 'simplex_linf', 'bonferroni'):\n            baseline_scores.append(fixed_mean([fixed_mean([record['utility'] for record in outcome['solution']['methods'][name]]) for outcome in outcomes]))\n        baseline_gap = score - max(baseline_scores)\n    metrics = {SCORE_NAME: score, 'iid_coverage_error': fixed_mean(iid) if iid else 1.0,\n               'mean_volume': fixed_mean([outcome['volume'] for outcome in outcomes]),\n               'shift_coverage_error': fixed_mean(shift) if shift else 1.0,\n               'baseline_utility_gap': baseline_gap,\n               'control_check_pass_rate': fixed_mean([outcome['controls'] for outcome in outcomes]),\n               'correct': int(valid)}\n    if set(metrics) != set(METRIC_NAMES) or not all(math.isfinite(value) for value in metrics.values()):\n        raise ValueError('metric schema')\n    evidence = []\n    uncertainty = uncertainty_by_case(episodes, outcomes)\n    for seed in dict.fromkeys(episode['seed'] for episode in episodes):\n        selected = [outcome for episode, outcome in zip(episodes, outcomes) if episode['seed'] == seed]\n        evidence.append({'seed': seed, 'score': fixed_mean([outcome['score'] for outcome in selected]),\n                         'correct': all(outcome['correct'] for outcome in selected),\n                         'duration_seconds': sum(outcome['duration_seconds'] for outcome in selected),\n                         'solution': {'cases': [outcome['solution'] for outcome in selected],\n                                      'seed_block_uncertainty': uncertainty}})\n    return metrics, valid, {'schema_version': 1, 'episodes': evidence}\n\n\nschema_version = 1\ncode_root = \"src\"\n\n[entrypoint]\npath = \"program.py\"\nlanguage = \"python\"\ntype = \"script\"\n\n[copy]\nexclude = [\n  \"**/__pycache__/**\",\n  \"**/*.pyc\",\n  \".venv/**\",\n  \"node_modules/**\",\n  \".git/**\",\n  \".mypy_cache/**\",\n  \".pytest_cache/**\",\n  \".ruff_cache/**\",\n  \".tox/**\",\n  \".nox/**\",\n  \"dist/**\",\n  \"build/**\",\n]\ninclude = [\n]\n\n[integration]\nkind = \"generic\"\nnotes = \"\"\n\"\"\"Deterministic training-only rank-selected local-moment ILR regression.\n\nThe incumbent centers and base scales are unchanged. Three outer training folds\nselect the existing scalar scale correction using nested residual tables and\nswapped held-out pseudo-calibration/evaluation halves. Selection minimizes a\nrow-weighted, alpha-averaged log arithmetic mean ILR-box volume, not simplex\nvolume. Unavailable finite-sample ranks or invalid radii fall back to the original\nGaussian selector for the entire fit. Fewer than five training rows retain its\nexact neutral correction. Independent evaluator calibration is untouched; no\nconditional or covariate-shift coverage guarantee is added.\n\nInterface: handle(request: dict) -> dict, finite JSON only, no extra response keys.\nKeep the entrypoint self-contained in this file; native validation stages only this\nfile plus installed packages, with a read-only filesystem and memory-only state.\nEvery request has exactly the keys shown below. Seed is any int in [0,2**63);\nit initializes randomness and NEVER chooses a workload. No paths are accepted.\n\nOperations/state transitions:\n  reset: {op:'reset', seed:int} -> {ok:true}; clears ALL state, enters unfitted.\n  predict: {op:'predict', x:array} -> {status:'unfitted'} until fit_scale completes.\n    When fitted: {center:array, scale:array}, both shape [N,K-1], finite float64;\n    center is in the fixed ILR basis, abs(center)<=100; scale in [1e-4,100].\n    Read-only, deterministic for equal inputs; identical rows have equal outputs.\n  fit_center: {op:'fit_center', x:array, y:array, dimension:int} -> {ok:true}.\n    X [N,6], Y [N,K], K in {3,8}, positive rows summing to 1, training only.\n    Fits center; invalidates scale, enters center-fitted but still unfitted.\n  fit_scale: {op:'fit_scale'} -> {ok:true}; requires fit_center, uses retained\n    TRAINING residuals only, enters fitted. No calibration/test labels provided.\n\nArray schema (exact keys): {encoding:'base64', dtype:'float64', byte_order:'little',\n  shape:[rows,columns], data:ASCII base64 of C-order little-endian float64 bytes}.\n1<=N<=4096, columns<=8, each logical array <=1 MiB. Complete request/response\nincluding envelope and newline must be <2 MiB (and strictly <64 MiB harness cap).\nNo state transfer or chunk operations exist: declared maximum shapes all fit inline;\nlarger logical inputs are rejected, never written to disk. Live model state <64 MiB.\nAdditional keys, nonfinite numbers, malformed encodings, and invalid state transitions\nare errors, not diagnostics. Responses contain no optional keys or internal reports.\n\nBasis convention: column j-1 (j=1..K-1) has first j entries 1/sqrt(j*(j+1)),\nentry j equal to -j/sqrt(j*(j+1)), remaining entries zero. z=log(y) @ basis.\nInverse softmax(z @ basis.T). Evaluator owns calibration and region membership:\nmax(abs(z-center)/scale) <= independent split-conformal order statistic, separately\nat alpha=.05,.10,.20. Targets to predict are observed continuous compositions,\nnot labels or latent categorical probabilities. Prediction queries do not identify\ncalibration/test membership, alpha, case, plane, targets, scores, or baselines.\n\nPublic workload: six continuous X features; K=3 or 8; logistic-normal IID,\nheteroscedastic Dirichlet IID and covariate-shift stress. Training-only fitting can\nbe replaced within this exact output family. Evaluator also tests constant-input,\nnonidentity-permuted-input, zero-radius copy-point, and reset/unfitted controls.\nNo superiority or realized-coverage threshold is a search eligibility requirement.\n\"\"\"\n\nimport base64\nimport math\n\nimport numpy as np\n\n\n_state = {}\n\n\ndef _decode(value):\n    if type(value) is not dict or set(value) != {\n        'encoding', 'dtype', 'byte_order', 'shape', 'data'\n    }:\n        raise ValueError('invalid array schema')\n    shape = value['shape']\n    if (value['encoding'] != 'base64' or value['dtype'] != 'float64'\n            or value['byte_order'] != 'little' or type(shape) is not list\n            or len(shape) != 2 or any(type(size) is not int for size in shape)\n            or not 1 <= shape[0] <= 4096 or not 1 <= shape[1] <= 8):\n        raise ValueError('invalid array metadata')\n    raw = base64.b64decode(value['data'], validate=True)\n    if len(raw) != math.prod(shape) * 8 or len(raw) > 1024 * 1024:\n        raise ValueError('invalid array size')\n    result = np.frombuffer(raw, dtype='<f8').reshape(shape).copy()\n    if not np.isfinite(result).all():\n        raise ValueError('nonfinite array')\n    return result\n\n\ndef _encode(array):\n    array = np.ascontiguousarray(array, dtype='<f8')\n    return {'encoding': 'base64', 'dtype': 'float64', 'byte_order': 'little',\n            'shape': list(array.shape), 'data': base64.b64encode(array.tobytes()).decode('ascii')}\n\n\ndef _basis(dimension):\n    basis = np.zeros((dimension, dimension - 1))\n    for column in range(1, dimension):\n        denominator = math.sqrt(column * (column + 1))\n        basis[:column, column - 1] = 1 / denominator\n        basis[column, column - 1] = -column / denominator\n    return basis\n\n\ndef _features(features):\n    return np.column_stack((np.ones(len(features)), features, features ** 2,\n                            np.sin(features), features[:, 0] * features[:, 1]))\n\n\ndef _ridge(features, targets, penalty):\n    regularizer = np.eye(features.shape[1]) * penalty\n    regularizer[0, 0] = 1e-8\n    return np.linalg.solve(features.T @ features + regularizer, features.T @ targets)\n\n\ndef _training_folds(sample_count):\n    indices = np.random.default_rng(0).permutation(sample_count)\n    return np.array_split(indices, 3)\n\n\ndef _fit_incumbent(train_features, train_targets):\n    design = _features(train_features)\n    ilr_targets = np.log(train_targets) @ _basis(train_targets.shape[1])\n    coefficient = _ridge(design, ilr_targets, 1.0)\n    residual = ilr_targets - design @ coefficient\n    log_residual = np.log(np.maximum(abs(residual), .02))\n    scale_coefficient = _ridge(design, log_residual, 10.0)\n    return coefficient, scale_coefficient\n\n\ndef _incumbent_predictions(model, features):\n    coefficient, scale_coefficient = model\n    design = _features(features)\n    base_centers = np.clip(design @ coefficient, -100, 100)\n    base_scales = np.clip(np.exp(np.clip(design @ scale_coefficient,\n                                        math.log(1e-4), math.log(100))), 1e-4, 100)\n    return base_centers, base_scales\n\n\ndef build_oof_residual_table(train_features, train_targets):\n    ilr_targets = np.log(train_targets) @ _basis(train_targets.shape[1])\n    oof_centers = np.empty_like(ilr_targets)\n    oof_scales = np.empty_like(ilr_targets)\n    all_indices = np.arange(len(train_features))\n    for valid_indices in _training_folds(len(train_features)):\n        fit_indices = np.setdiff1d(all_indices, valid_indices)\n        assert np.intersect1d(fit_indices, valid_indices).size == 0\n        model = _fit_incumbent(train_features[fit_indices], train_targets[fit_indices])\n        oof_centers[valid_indices], oof_scales[valid_indices] = _incumbent_predictions(\n            model, train_features[valid_indices])\n    scale_floor = 1e-4\n    standardized_residuals = (ilr_targets - oof_centers) / np.maximum(oof_scales, scale_floor)\n    relative_squared_residuals = np.mean(standardized_residuals ** 2, axis=1)\n    location = np.mean(train_features, axis=0)\n    spread = np.maximum(np.std(train_features, axis=0), 1e-8)\n    return {'features': (train_features - location) / spread,\n            'location': location, 'spread': spread,\n            'relative_squared_residuals': relative_squared_residuals}\n\n\ndef _local_moment_ratio(residual_table, query_features, bandwidth, prior_mass):\n    assert bandwidth > 0.0 and prior_mass > 0.0\n    reference_features = residual_table['features']\n    relative_squared_residuals = residual_table['relative_squared_residuals']\n    reference_norms = np.sum(reference_features ** 2, axis=1)\n    ratios = np.empty(len(query_features), dtype=np.float64)\n    for start in range(0, len(query_features), 128):\n        query = ((query_features[start:start + 128] - residual_table['location'])\n                 / residual_table['spread'])\n        squared_distances = np.maximum(\n            np.sum(query ** 2, axis=1)[:, None] + reference_norms[None, :]\n            - 2.0 * (query @ reference_features.T), 0.0)\n        weights = np.exp(-0.5 * squared_distances / (bandwidth ** 2))\n        moment_ratio = (weights @ relative_squared_residuals + prior_mass) / (weights.sum(axis=1) + prior_mass)\n        ratios[start:start + len(query)] = moment_ratio\n    return ratios\n\n\ndef apply_scale_correction(base_scales, moment_ratio, blend):\n    if blend == 0.0: return base_scales.copy()\n    correction = np.exp(0.5 * blend * np.log(np.clip(moment_ratio, 0.25, 4.0)))\n    lower_factor = np.max(1e-4 / base_scales, axis=1)\n    upper_factor = np.min(100.0 / base_scales, axis=1)\n    correction = np.clip(correction, lower_factor, upper_factor)\n    below_floor = np.any(base_scales * correction[:, None] < 1e-4, axis=1)\n    above_ceiling = np.any(base_scales * correction[:, None] > 100.0, axis=1)\n    correction[below_floor] = np.nextafter(lower_factor[below_floor], np.inf)\n    correction[above_ceiling] = np.nextafter(upper_factor[above_ceiling], 0.0)\n    adjusted_scales = base_scales * correction[:, None]\n    assert np.all(np.isfinite(adjusted_scales)) and np.all(adjusted_scales > 0.0)\n    assert np.all(adjusted_scales >= 1e-4) and np.all(adjusted_scales <= 100.0)\n    return adjusted_scales\n\n\ndef _select_correction_gaussian(train_features, train_targets):\n    candidate_blends = (0.0, 0.5, 1.0)\n    feature_dimension = train_features.shape[1]\n    candidate_bandwidths = (0.5 * math.sqrt(feature_dimension), math.sqrt(feature_dimension))\n    candidate_results = [\n        {'blend': blend, 'bandwidth': bandwidth, 'prior_mass': prior_mass,\n         'validation_loss': 0.0}\n        for blend in candidate_blends for bandwidth in candidate_bandwidths\n        for prior_mass in (10.0, 50.0)]\n    if len(train_features) < 5:\n        return candidate_results[0], None\n    all_indices = np.arange(len(train_features))\n    for outer_valid_indices in _training_folds(len(train_features)):\n        outer_train_indices = np.setdiff1d(all_indices, outer_valid_indices)\n        assert np.intersect1d(outer_train_indices, outer_valid_indices).size == 0\n        outer_residual_table = build_oof_residual_table(train_features[outer_train_indices], train_targets[outer_train_indices])\n        model = _fit_incumbent(train_features[outer_train_indices],\n                               train_targets[outer_train_indices])\n        validation_centers, base_scales = _incumbent_predictions(\n            model, train_features[outer_valid_indices])\n        validation_targets = (np.log(train_targets[outer_valid_indices])\n                              @ _basis(train_targets.shape[1]))\n        ratio_cache = {}\n        for setting in candidate_results:\n            blend = setting['blend']\n            cache_key = (setting['bandwidth'], setting['prior_mass'])\n            if blend == 0.0:\n                moment_ratio = np.ones(len(outer_valid_indices))\n            else:\n                if cache_key not in ratio_cache:\n                    ratio_cache[cache_key] = _local_moment_ratio(\n                        outer_residual_table, train_features[outer_valid_indices],\n                        setting['bandwidth'], setting['prior_mass'])\n                moment_ratio = ratio_cache[cache_key]\n            validation_scales = apply_scale_correction(base_scales, moment_ratio, blend)\n            validation_residuals = (validation_targets - validation_centers) / validation_scales\n            validation_loss = np.mean(np.log(validation_scales) + 0.5 * validation_residuals ** 2)\n            setting['validation_loss'] += (float(validation_loss)\n                                           * len(outer_valid_indices) / len(train_features))\n        assert np.allclose(apply_scale_correction(base_scales, moment_ratio, 0.0), base_scales)\n    selected_setting = min(candidate_results, key=lambda setting: (setting['validation_loss'], setting['blend']))\n    residual_table = build_oof_residual_table(train_features, train_targets)\n    distant_query = residual_table['location'][None, :] + 1e6 * residual_table['spread'][None, :]\n    assert np.allclose(_local_moment_ratio(residual_table, distant_query,\n                                          selected_setting['bandwidth'],\n                                          selected_setting['prior_mass']), 1.0)\n    return selected_setting, residual_table\n\n\ndef _conformal_radius(calibration_scores, alpha):\n    rank = math.ceil((len(calibration_scores) + 1) * (1.0 - alpha))\n    if rank > len(calibration_scores): return None\n    if not np.isfinite(calibration_scores).all(): return None\n    radius = np.partition(calibration_scores, rank - 1)[rank - 1]\n    if not np.isfinite(radius) or radius <= 0.0: return None\n    return float(radius)\n\n\ndef _log_mean_box_volume(validation_scales, radius):\n    coordinate_count = validation_scales.shape[1]\n    log_box_volume = coordinate_count * np.log(2.0 * radius) + np.sum(np.log(validation_scales), axis=1)\n    volume_shift = np.max(log_box_volume)\n    log_mean_volume = volume_shift + np.log(np.mean(np.exp(log_box_volume - volume_shift)))\n    return float(log_mean_volume)\n\n\ndef _assert_rank_selection_controls(calibration_scores, calibration_scales,\n                                    validation_scales, selection_alphas):\n    assert _conformal_radius(np.ones(18), 0.05) is None\n    assert _conformal_radius(np.ones(19), 0.05) == 1.0\n    assert _conformal_radius(np.zeros(19), 0.05) is None\n    assert _conformal_radius(np.full(19, np.inf), 0.05) is None\n    if (np.any(calibration_scales <= 1e-4) or np.any(calibration_scales >= 50.0)\n            or np.any(validation_scales <= 1e-4) or np.any(validation_scales >= 50.0)):\n        return\n    for alpha in selection_alphas:\n        radius = _conformal_radius(calibration_scores, alpha)\n        rescaled_radius = _conformal_radius(calibration_scores / 2.0, alpha)\n        assert radius is not None and rescaled_radius is not None\n        assert np.allclose(radius * validation_scales,\n                           rescaled_radius * (2.0 * validation_scales),\n                           rtol=1e-12, atol=1e-12)\n        assert np.isclose(_log_mean_box_volume(validation_scales, radius),\n                          _log_mean_box_volume(2.0 * validation_scales, rescaled_radius),\n                          rtol=1e-12, atol=1e-12)\n\n\ndef _select_correction(train_features, train_targets):\n    selection_alphas = (0.05, 0.10, 0.20)\n    outer_folds = _training_folds(len(train_features))\n    rank_selection_available = all(\n        math.ceil((len(half) + 1) * (1.0 - alpha)) <= len(half)\n        for fold in outer_folds for half in np.array_split(fold, 2)\n        for alpha in selection_alphas)\n    if not rank_selection_available: return _select_correction_gaussian(train_features, train_targets)\n    candidate_blends = (0.0, 0.5, 1.0)\n    feature_dimension = train_features.shape[1]\n    candidate_bandwidths = (0.5 * math.sqrt(feature_dimension), math.sqrt(feature_dimension))\n    candidate_results = [\n        {'blend': blend, 'bandwidth': bandwidth, 'prior_mass': prior_mass,\n         'selection_loss': 0.0}\n        for blend in candidate_blends for bandwidth in candidate_bandwidths\n        for prior_mass in (10.0, 50.0)]\n    all_indices = np.arange(len(train_features))\n    for outer_valid_indices in outer_folds:\n        outer_train_indices = np.setdiff1d(all_indices, outer_valid_indices)\n        assert np.intersect1d(outer_train_indices, outer_valid_indices).size == 0\n        half_positions = np.array_split(np.arange(len(outer_valid_indices)), 2)\n        pseudo_splits = []\n        for split_index in range(2):\n            calibration_positions = half_positions[split_index]\n            evaluation_positions = half_positions[1 - split_index]\n            pseudo_calibration_indices = outer_valid_indices[calibration_positions]\n            pseudo_evaluation_indices = outer_valid_indices[evaluation_positions]\n            assert np.intersect1d(outer_train_indices, pseudo_calibration_indices).size == 0\n            assert np.intersect1d(outer_train_indices, pseudo_evaluation_indices).size == 0\n            assert np.intersect1d(pseudo_calibration_indices, pseudo_evaluation_indices).size == 0\n            pseudo_splits.append((calibration_positions, evaluation_positions))\n        outer_residual_table = build_oof_residual_table(train_features[outer_train_indices], train_targets[outer_train_indices])\n        model = _fit_incumbent(train_features[outer_train_indices],\n                               train_targets[outer_train_indices])\n        heldout_centers, base_scales = _incumbent_predictions(\n            model, train_features[outer_valid_indices])\n        heldout_targets = (np.log(train_targets[outer_valid_indices])\n                           @ _basis(train_targets.shape[1]))\n        ratio_cache = {}\n        for setting in candidate_results:\n            blend = setting['blend']\n            cache_key = (setting['bandwidth'], setting['prior_mass'])\n            if blend == 0.0:\n                moment_ratio = np.ones(len(outer_valid_indices))\n            else:\n                if cache_key not in ratio_cache:\n                    ratio_cache[cache_key] = _local_moment_ratio(\n                        outer_residual_table, train_features[outer_valid_indices],\n                        setting['bandwidth'], setting['prior_mass'])\n                moment_ratio = ratio_cache[cache_key]\n            heldout_scales = apply_scale_correction(base_scales, moment_ratio, blend)\n            assert np.array_equal(apply_scale_correction(base_scales, moment_ratio, 0.0), base_scales)\n            for calibration_positions, evaluation_positions in pseudo_splits:\n                calibration_targets = heldout_targets[calibration_positions]\n                calibration_centers = heldout_centers[calibration_positions]\n                calibration_scales = heldout_scales[calibration_positions]\n                validation_scales = heldout_scales[evaluation_positions]\n                calibration_scores = np.max(np.abs(calibration_targets - calibration_centers) / calibration_scales, axis=1)\n                alpha_log_mean_volumes = []\n                for alpha in selection_alphas:\n                    radius = _conformal_radius(calibration_scores, alpha)\n                    rank_selection_available = radius is not None\n                    if not rank_selection_available: return _select_correction_gaussian(train_features, train_targets)\n                    log_mean_volume = _log_mean_box_volume(validation_scales, radius)\n                    rank_selection_available = np.isfinite(log_mean_volume)\n                    if not rank_selection_available: return _select_correction_gaussian(train_features, train_targets)\n                    alpha_log_mean_volumes.append(log_mean_volume)\n                if setting is candidate_results[0]:\n                    _assert_rank_selection_controls(calibration_scores, calibration_scales,\n                                                    validation_scales, selection_alphas)\n                fold_weight = len(evaluation_positions) / len(train_features)\n                setting['selection_loss'] += fold_weight * float(np.mean(alpha_log_mean_volumes))\n    selected_setting = min(candidate_results, key=lambda setting: (setting['selection_loss'], setting['blend']))\n    residual_table = build_oof_residual_table(train_features, train_targets)\n    distant_query = residual_table['location'][None, :] + 1e6 * residual_table['spread'][None, :]\n    assert np.allclose(_local_moment_ratio(residual_table, distant_query,\n                                          selected_setting['bandwidth'],\n                                          selected_setting['prior_mass']), 1.0)\n    return selected_setting, residual_table\n\n\ndef _corrected_predictions(features):\n    model = (_state['coefficient'], _state['scale_coefficient'])\n    base_centers, base_scales = _incumbent_predictions(model, features)\n    original_centers = base_centers.copy()\n    setting = _state['correction_setting']\n    if setting['blend'] == 0.0:\n        moment_ratio = np.ones(len(features))\n    else:\n        moment_ratio = _local_moment_ratio(_state['residual_table'], features,\n                                           setting['bandwidth'], setting['prior_mass'])\n    adjusted_scales = apply_scale_correction(base_scales, moment_ratio, setting['blend'])\n    assert np.array_equal(base_centers, original_centers)\n    assert adjusted_scales.shape == base_scales.shape == base_centers.shape\n    assert np.all(np.isfinite(adjusted_scales)) and np.all(adjusted_scales > 0.0)\n    return base_centers, adjusted_scales\n\n\ndef handle(request):\n    if type(request) is not dict:\n        raise ValueError('request must be object')\n    operation = request.get('op')\n    keys = {'reset': {'op', 'seed'}, 'predict': {'op', 'x'},\n            'fit_center': {'op', 'x', 'y', 'dimension'}, 'fit_scale': {'op'}}\n    if operation not in keys or set(request) != keys[operation]:\n        raise ValueError('invalid operation schema')\n    if operation == 'reset':\n        seed = request['seed']\n        if type(seed) is not int or not 0 <= seed < 2 ** 63:\n            raise ValueError('invalid seed')\n        _state.clear()\n        _state['rng'] = np.random.default_rng(seed)\n        return {'ok': True}\n    if 'rng' not in _state:\n        raise ValueError('reset required')\n    if operation == 'fit_center':\n        dimension = request['dimension']\n        features, targets = _decode(request['x']), _decode(request['y'])\n        if (type(dimension) is not int or dimension not in (3, 8)\n                or features.shape[1] != 6 or targets.shape != (len(features), dimension)\n                or not (targets > 0).all()\n                or not np.allclose(targets.sum(axis=1), 1, atol=1e-10, rtol=0)):\n            raise ValueError('invalid training data')\n        design = _features(features)\n        transformed = np.log(targets) @ _basis(dimension)\n        coefficient = _ridge(design, transformed, 1.0)\n        _state.update(coefficient=coefficient, design=design,\n                      residual=transformed - design @ coefficient,\n                      train_features=features, train_targets=targets)\n        _state.pop('scale_coefficient', None)\n        _state.pop('correction_setting', None)\n        _state.pop('residual_table', None)\n        return {'ok': True}\n    if operation == 'fit_scale':\n        if 'coefficient' not in _state:\n            raise ValueError('center required')\n        log_residual = np.log(np.maximum(abs(_state['residual']), .02))\n        scale_coefficient = _ridge(_state['design'], log_residual, 10.0)\n        setting, residual_table = _select_correction(_state['train_features'],\n                                                     _state['train_targets'])\n        _state.update(scale_coefficient=scale_coefficient,\n                      correction_setting=setting, residual_table=residual_table)\n        return {'ok': True}\n    features = _decode(request['x'])\n    if features.shape[1] != 6:\n        raise ValueError('invalid feature shape')\n    if 'scale_coefficient' not in _state:\n        return {'status': 'unfitted'}\n    center, scale = _corrected_predictions(features)\n    response = {'center': _encode(center), 'scale': _encode(scale)}\n    assert set(response) == {'center', 'scale'}\n    assert response['center']['shape'] == response['scale']['shape'] == [len(features), center.shape[1]]\n    return response\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,270p' results/ideas/03_training_only_conformal_rank_scale_selection/program_1/src/program.py; sed -n '910,1126p' task/evaluate_final.py; cat task/requirements.txt; sed -n '1,100p' .codex/skills/write-paper-standalone/scripts/validate_claims.py; sed -n '1,110p' .codex/skills/validate-paper/scripts/compile_latex.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,270p' results/ideas/03_training_only_conformal_rank_scale_selection/program_1/src/program.py; sed -n '910,1126p' task/evaluate_final.py; cat task/requirements.txt; sed -n '1,100p' .codex/skills/write-paper-standalone/scripts/validate_claims.py; sed -n '1,110p' .codex/skills/validate-paper/scripts/compile_latex.sh\"","aggregated_output":"\"\"\"Deterministic training-only rank-selected local-moment ILR regression.\n\nThe incumbent centers and base scales are unchanged. Three outer training folds\nselect the existing scalar scale correction using nested residual tables and\nswapped held-out pseudo-calibration/evaluation halves. Selection minimizes a\nrow-weighted, alpha-averaged log arithmetic mean ILR-box volume, not simplex\nvolume. Unavailable finite-sample ranks or invalid radii fall back to the original\nGaussian selector for the entire fit. Fewer than five training rows retain its\nexact neutral correction. Independent evaluator calibration is untouched; no\nconditional or covariate-shift coverage guarantee is added.\n\nInterface: handle(request: dict) -> dict, finite JSON only, no extra response keys.\nKeep the entrypoint self-contained in this file; native validation stages only this\nfile plus installed packages, with a read-only filesystem and memory-only state.\nEvery request has exactly the keys shown below. Seed is any int in [0,2**63);\nit initializes randomness and NEVER chooses a workload. No paths are accepted.\n\nOperations/state transitions:\n  reset: {op:'reset', seed:int} -> {ok:true}; clears ALL state, enters unfitted.\n  predict: {op:'predict', x:array} -> {status:'unfitted'} until fit_scale completes.\n    When fitted: {center:array, scale:array}, both shape [N,K-1], finite float64;\n    center is in the fixed ILR basis, abs(center)<=100; scale in [1e-4,100].\n    Read-only, deterministic for equal inputs; identical rows have equal outputs.\n  fit_center: {op:'fit_center', x:array, y:array, dimension:int} -> {ok:true}.\n    X [N,6], Y [N,K], K in {3,8}, positive rows summing to 1, training only.\n    Fits center; invalidates scale, enters center-fitted but still unfitted.\n  fit_scale: {op:'fit_scale'} -> {ok:true}; requires fit_center, uses retained\n    TRAINING residuals only, enters fitted. No calibration/test labels provided.\n\nArray schema (exact keys): {encoding:'base64', dtype:'float64', byte_order:'little',\n  shape:[rows,columns], data:ASCII base64 of C-order little-endian float64 bytes}.\n1<=N<=4096, columns<=8, each logical array <=1 MiB. Complete request/response\nincluding envelope and newline must be <2 MiB (and strictly <64 MiB harness cap).\nNo state transfer or chunk operations exist: declared maximum shapes all fit inline;\nlarger logical inputs are rejected, never written to disk. Live model state <64 MiB.\nAdditional keys, nonfinite numbers, malformed encodings, and invalid state transitions\nare errors, not diagnostics. Responses contain no optional keys or internal reports.\n\nBasis convention: column j-1 (j=1..K-1) has first j entries 1/sqrt(j*(j+1)),\nentry j equal to -j/sqrt(j*(j+1)), remaining entries zero. z=log(y) @ basis.\nInverse softmax(z @ basis.T). Evaluator owns calibration and region membership:\nmax(abs(z-center)/scale) <= independent split-conformal order statistic, separately\nat alpha=.05,.10,.20. Targets to predict are observed continuous compositions,\nnot labels or latent categorical probabilities. Prediction queries do not identify\ncalibration/test membership, alpha, case, plane, targets, scores, or baselines.\n\nPublic workload: six continuous X features; K=3 or 8; logistic-normal IID,\nheteroscedastic Dirichlet IID and covariate-shift stress. Training-only fitting can\nbe replaced within this exact output family. Evaluator also tests constant-input,\nnonidentity-permuted-input, zero-radius copy-point, and reset/unfitted controls.\nNo superiority or realized-coverage threshold is a search eligibility requirement.\n\"\"\"\n\nimport base64\nimport math\n\nimport numpy as np\n\n\n_state = {}\n\n\ndef _decode(value):\n    if type(value) is not dict or set(value) != {\n        'encoding', 'dtype', 'byte_order', 'shape', 'data'\n    }:\n        raise ValueError('invalid array schema')\n    shape = value['shape']\n    if (value['encoding'] != 'base64' or value['dtype'] != 'float64'\n            or value['byte_order'] != 'little' or type(shape) is not list\n            or len(shape) != 2 or any(type(size) is not int for size in shape)\n            or not 1 <= shape[0] <= 4096 or not 1 <= shape[1] <= 8):\n        raise ValueError('invalid array metadata')\n    raw = base64.b64decode(value['data'], validate=True)\n    if len(raw) != math.prod(shape) * 8 or len(raw) > 1024 * 1024:\n        raise ValueError('invalid array size')\n    result = np.frombuffer(raw, dtype='<f8').reshape(shape).copy()\n    if not np.isfinite(result).all():\n        raise ValueError('nonfinite array')\n    return result\n\n\ndef _encode(array):\n    array = np.ascontiguousarray(array, dtype='<f8')\n    return {'encoding': 'base64', 'dtype': 'float64', 'byte_order': 'little',\n            'shape': list(array.shape), 'data': base64.b64encode(array.tobytes()).decode('ascii')}\n\n\ndef _basis(dimension):\n    basis = np.zeros((dimension, dimension - 1))\n    for column in range(1, dimension):\n        denominator = math.sqrt(column * (column + 1))\n        basis[:column, column - 1] = 1 / denominator\n        basis[column, column - 1] = -column / denominator\n    return basis\n\n\ndef _features(features):\n    return np.column_stack((np.ones(len(features)), features, features ** 2,\n                            np.sin(features), features[:, 0] * features[:, 1]))\n\n\ndef _ridge(features, targets, penalty):\n    regularizer = np.eye(features.shape[1]) * penalty\n    regularizer[0, 0] = 1e-8\n    return np.linalg.solve(features.T @ features + regularizer, features.T @ targets)\n\n\ndef _training_folds(sample_count):\n    indices = np.random.default_rng(0).permutation(sample_count)\n    return np.array_split(indices, 3)\n\n\ndef _fit_incumbent(train_features, train_targets):\n    design = _features(train_features)\n    ilr_targets = np.log(train_targets) @ _basis(train_targets.shape[1])\n    coefficient = _ridge(design, ilr_targets, 1.0)\n    residual = ilr_targets - design @ coefficient\n    log_residual = np.log(np.maximum(abs(residual), .02))\n    scale_coefficient = _ridge(design, log_residual, 10.0)\n    return coefficient, scale_coefficient\n\n\ndef _incumbent_predictions(model, features):\n    coefficient, scale_coefficient = model\n    design = _features(features)\n    base_centers = np.clip(design @ coefficient, -100, 100)\n    base_scales = np.clip(np.exp(np.clip(design @ scale_coefficient,\n                                        math.log(1e-4), math.log(100))), 1e-4, 100)\n    return base_centers, base_scales\n\n\ndef build_oof_residual_table(train_features, train_targets):\n    ilr_targets = np.log(train_targets) @ _basis(train_targets.shape[1])\n    oof_centers = np.empty_like(ilr_targets)\n    oof_scales = np.empty_like(ilr_targets)\n    all_indices = np.arange(len(train_features))\n    for valid_indices in _training_folds(len(train_features)):\n        fit_indices = np.setdiff1d(all_indices, valid_indices)\n        assert np.intersect1d(fit_indices, valid_indices).size == 0\n        model = _fit_incumbent(train_features[fit_indices], train_targets[fit_indices])\n        oof_centers[valid_indices], oof_scales[valid_indices] = _incumbent_predictions(\n            model, train_features[valid_indices])\n    scale_floor = 1e-4\n    standardized_residuals = (ilr_targets - oof_centers) / np.maximum(oof_scales, scale_floor)\n    relative_squared_residuals = np.mean(standardized_residuals ** 2, axis=1)\n    location = np.mean(train_features, axis=0)\n    spread = np.maximum(np.std(train_features, axis=0), 1e-8)\n    return {'features': (train_features - location) / spread,\n            'location': location, 'spread': spread,\n            'relative_squared_residuals': relative_squared_residuals}\n\n\ndef _local_moment_ratio(residual_table, query_features, bandwidth, prior_mass):\n    assert bandwidth > 0.0 and prior_mass > 0.0\n    reference_features = residual_table['features']\n    relative_squared_residuals = residual_table['relative_squared_residuals']\n    reference_norms = np.sum(reference_features ** 2, axis=1)\n    ratios = np.empty(len(query_features), dtype=np.float64)\n    for start in range(0, len(query_features), 128):\n        query = ((query_features[start:start + 128] - residual_table['location'])\n                 / residual_table['spread'])\n        squared_distances = np.maximum(\n            np.sum(query ** 2, axis=1)[:, None] + reference_norms[None, :]\n            - 2.0 * (query @ reference_features.T), 0.0)\n        weights = np.exp(-0.5 * squared_distances / (bandwidth ** 2))\n        moment_ratio = (weights @ relative_squared_residuals + prior_mass) / (weights.sum(axis=1) + prior_mass)\n        ratios[start:start + len(query)] = moment_ratio\n    return ratios\n\n\ndef apply_scale_correction(base_scales, moment_ratio, blend):\n    if blend == 0.0: return base_scales.copy()\n    correction = np.exp(0.5 * blend * np.log(np.clip(moment_ratio, 0.25, 4.0)))\n    lower_factor = np.max(1e-4 / base_scales, axis=1)\n    upper_factor = np.min(100.0 / base_scales, axis=1)\n    correction = np.clip(correction, lower_factor, upper_factor)\n    below_floor = np.any(base_scales * correction[:, None] < 1e-4, axis=1)\n    above_ceiling = np.any(base_scales * correction[:, None] > 100.0, axis=1)\n    correction[below_floor] = np.nextafter(lower_factor[below_floor], np.inf)\n    correction[above_ceiling] = np.nextafter(upper_factor[above_ceiling], 0.0)\n    adjusted_scales = base_scales * correction[:, None]\n    assert np.all(np.isfinite(adjusted_scales)) and np.all(adjusted_scales > 0.0)\n    assert np.all(adjusted_scales >= 1e-4) and np.all(adjusted_scales <= 100.0)\n    return adjusted_scales\n\n\ndef _select_correction_gaussian(train_features, train_targets):\n    candidate_blends = (0.0, 0.5, 1.0)\n    feature_dimension = train_features.shape[1]\n    candidate_bandwidths = (0.5 * math.sqrt(feature_dimension), math.sqrt(feature_dimension))\n    candidate_results = [\n        {'blend': blend, 'bandwidth': bandwidth, 'prior_mass': prior_mass,\n         'validation_loss': 0.0}\n        for blend in candidate_blends for bandwidth in candidate_bandwidths\n        for prior_mass in (10.0, 50.0)]\n    if len(train_features) < 5:\n        return candidate_results[0], None\n    all_indices = np.arange(len(train_features))\n    for outer_valid_indices in _training_folds(len(train_features)):\n        outer_train_indices = np.setdiff1d(all_indices, outer_valid_indices)\n        assert np.intersect1d(outer_train_indices, outer_valid_indices).size == 0\n        outer_residual_table = build_oof_residual_table(train_features[outer_train_indices], train_targets[outer_train_indices])\n        model = _fit_incumbent(train_features[outer_train_indices],\n                               train_targets[outer_train_indices])\n        validation_centers, base_scales = _incumbent_predictions(\n            model, train_features[outer_valid_indices])\n        validation_targets = (np.log(train_targets[outer_valid_indices])\n                              @ _basis(train_targets.shape[1]))\n        ratio_cache = {}\n        for setting in candidate_results:\n            blend = setting['blend']\n            cache_key = (setting['bandwidth'], setting['prior_mass'])\n            if blend == 0.0:\n                moment_ratio = np.ones(len(outer_valid_indices))\n            else:\n                if cache_key not in ratio_cache:\n                    ratio_cache[cache_key] = _local_moment_ratio(\n                        outer_residual_table, train_features[outer_valid_indices],\n                        setting['bandwidth'], setting['prior_mass'])\n                moment_ratio = ratio_cache[cache_key]\n            validation_scales = apply_scale_correction(base_scales, moment_ratio, blend)\n            validation_residuals = (validation_targets - validation_centers) / validation_scales\n            validation_loss = np.mean(np.log(validation_scales) + 0.5 * validation_residuals ** 2)\n            setting['validation_loss'] += (float(validation_loss)\n                                           * len(outer_valid_indices) / len(train_features))\n        assert np.allclose(apply_scale_correction(base_scales, moment_ratio, 0.0), base_scales)\n    selected_setting = min(candidate_results, key=lambda setting: (setting['validation_loss'], setting['blend']))\n    residual_table = build_oof_residual_table(train_features, train_targets)\n    distant_query = residual_table['location'][None, :] + 1e6 * residual_table['spread'][None, :]\n    assert np.allclose(_local_moment_ratio(residual_table, distant_query,\n                                          selected_setting['bandwidth'],\n                                          selected_setting['prior_mass']), 1.0)\n    return selected_setting, residual_table\n\n\ndef _conformal_radius(calibration_scores, alpha):\n    rank = math.ceil((len(calibration_scores) + 1) * (1.0 - alpha))\n    if rank > len(calibration_scores): return None\n    if not np.isfinite(calibration_scores).all(): return None\n    radius = np.partition(calibration_scores, rank - 1)[rank - 1]\n    if not np.isfinite(radius) or radius <= 0.0: return None\n    return float(radius)\n\n\ndef _log_mean_box_volume(validation_scales, radius):\n    coordinate_count = validation_scales.shape[1]\n    log_box_volume = coordinate_count * np.log(2.0 * radius) + np.sum(np.log(validation_scales), axis=1)\n    volume_shift = np.max(log_box_volume)\n    log_mean_volume = volume_shift + np.log(np.mean(np.exp(log_box_volume - volume_shift)))\n    return float(log_mean_volume)\n\n\ndef _assert_rank_selection_controls(calibration_scores, calibration_scales,\n                                    validation_scales, selection_alphas):\n    assert _conformal_radius(np.ones(18), 0.05) is None\n    assert _conformal_radius(np.ones(19), 0.05) == 1.0\n    assert _conformal_radius(np.zeros(19), 0.05) is None\n    assert _conformal_radius(np.full(19, np.inf), 0.05) is None\n    if (np.any(calibration_scales <= 1e-4) or np.any(calibration_scales >= 50.0)\n            or np.any(validation_scales <= 1e-4) or np.any(validation_scales >= 50.0)):\n        return\n    for alpha in selection_alphas:\n        radius = _conformal_radius(calibration_scores, alpha)\n        rescaled_radius = _conformal_radius(calibration_scores / 2.0, alpha)\n        assert radius is not None and rescaled_radius is not None\n        assert np.allclose(radius * validation_scales,\n                           rescaled_radius * (2.0 * validation_scales),\n                           rtol=1e-12, atol=1e-12)\n        assert np.isclose(_log_mean_box_volume(validation_scales, radius),\n        subgroup = arrays['x_test'][:, 0] > 0\n        subgroup_records = []\n        for mask in (subgroup, ~subgroup):\n            count = int(mask.sum())\n            successes = int(membership[mask].sum())\n            subgroup_records.append({'count': count, 'coverage': successes / count if count else None,\n                                     'conditional_wilson95': wilson(successes, count)})\n        context_probabilities = np.array(hits_per_context) / len(probes)\n        records.append({'alpha': alpha, 'coverage': coverage, 'volume': volume, 'utility': utility,\n                        'coverage_error': error, 'conditional_wilson95': wilson(int(membership.sum()), len(membership)),\n                        'subgroups': subgroup_records,\n                        'quantile': np.where(np.isfinite(threshold), threshold, -1).tolist(),\n                        'infinite_quantile': bool(np.any(np.isinf(threshold))),\n                        'volume_probe_resolution': 1 / len(probes),\n                        'zero_hit_contexts': int((np.array(hits_per_context) == 0).sum()),\n                        'mean_context_mc_se_bound': float(np.mean(np.sqrt(context_probabilities * (1 - context_probabilities) / len(probes)))),\n                        'zero_hit_one_sided95_upper': 1 - .05 ** (1 / len(probes)),\n                        'ilr_center_mse': float(np.mean((np.log(test_targets) @ matrix - test_center) ** 2))})\n    return records\n\n\ndef evaluate_episode(episode, call, work_deadline):\n    arrays = episode['arrays']\n    dimension = arrays['y_train'].shape[1]\n    methods_remaining = 13\n    local_deadline = min(work_deadline, time.monotonic() + 13 * (WORK_SECONDS + METHOD_CLEANUP) + .5)\n    def allowance():\n        nonlocal methods_remaining\n        methods_remaining -= 1\n        return reserved_method_deadline(now=time.monotonic(), episode_deadline=local_deadline,\n            methods_remaining=methods_remaining, work_seconds=WORK_SECONDS, cleanup_seconds=METHOD_CLEANUP)\n    active_deadline = allowance()\n    def bounded_call(request):\n        check_deadline(active_deadline)\n        response = call(request, deadline=active_deadline)\n        check_deadline(active_deadline)\n        return response\n    completed = set()\n    unfitted = bounded_call({'op': 'predict', 'x': encode_array(arrays['x_train'][:2])})\n    if unfitted != {'status': 'unfitted'}:\n        raise ProtocolFailure('reset leakage control')\n    completed.add('reset_unfitted')\n    center_ack = bounded_call({'op': 'fit_center', 'x': encode_array(arrays['x_train']),\n                               'y': encode_array(arrays['y_train']), 'dimension': dimension})\n    if type(center_ack) is not dict or set(center_ack) != {'ok'} or center_ack['ok'] is not True:\n        raise ProtocolFailure('fit center acknowledgment')\n    scale_ack = bounded_call({'op': 'fit_scale'})\n    if type(scale_ack) is not dict or set(scale_ack) != {'ok'} or scale_ack['ok'] is not True:\n        raise ProtocolFailure('fit scale acknowledgment')\n    features = np.concatenate((arrays['x_calibration'], arrays['x_test']))\n    calibration_count = len(arrays['x_calibration'])\n    constant_features = np.tile(arrays['x_train'].mean(0), (len(features), 1))\n    permutation = np.concatenate((np.roll(np.arange(calibration_count), 1),\n                                  calibration_count + np.roll(np.arange(len(arrays['x_test'])), 1)))\n    changed_rows = np.any(features != features[permutation], axis=1)\n    if ((permutation == np.arange(len(features))).any()\n            or np.count_nonzero(changed_rows[:calibration_count]) < 2\n            or np.count_nonzero(changed_rows[calibration_count:]) < 2):\n        raise ProtocolFailure('vacuous permutation control')\n    query_entropy = int.from_bytes(hashlib.sha256(arrays['probes'].tobytes()).digest()[:8], 'little')\n    query_order = np.random.default_rng(query_entropy).permutation(len(features))\n    original_order = np.argsort(query_order)\n    predictions = {}\n    for name, inputs in (('scaled_ilr', features), ('constant_input', constant_features),\n                         ('permuted_input', features[permutation])):\n        active_deadline = allowance()\n        response = bounded_call({'op': 'predict', 'x': encode_array(inputs[query_order])})\n        ordered_center, ordered_scale = prediction(response, len(inputs), dimension)\n        predictions[name] = ordered_center[original_order], ordered_scale[original_order]\n        if name == 'constant_input':\n            center, scale = predictions[name]\n            if not np.allclose(center, center[0], rtol=0, atol=1e-10) or not np.allclose(scale, scale[0], rtol=0, atol=1e-10):\n                raise ProtocolFailure('constant input structural control')\n            completed.add(name)\n        elif name == 'permuted_input':\n            center, scale = predictions[name]\n            main_center, main_scale = predictions['scaled_ilr']\n            if (not np.allclose(center, main_center[permutation], rtol=1e-10, atol=1e-10)\n                    or not np.allclose(scale, main_scale[permutation], rtol=1e-10, atol=1e-10)):\n                raise ProtocolFailure('prediction read-only alignment')\n            completed.add(name)\n    records = {}\n    for name in METHODS:\n        active_deadline = allowance()\n        center, scale = predictions.get(name, predictions['scaled_ilr'])\n        started = time.monotonic()\n        try:\n            records[name] = score_method(name, center, scale, arrays, active_deadline)\n        except TimeoutError as error:\n            if name not in ('scaled_ilr', 'constant_input', 'permuted_input', 'copy_point'):\n                raise RequiredBaselineFailure('baseline_timeout') from error\n            raise\n        if time.monotonic() > active_deadline:\n            raise RequiredBaselineFailure('baseline_timeout')\n        for record in records[name]:\n            record['productive_scoring_seconds'] = max(0, time.monotonic() - started)\n    if any(record['coverage'] >= .5 for record in records['copy_point']):\n        raise ProtocolFailure('zero radius scorer control')\n    completed.add('copy_point')\n    if EXPECTED_CONTROLS - completed:\n        raise ProtocolFailure('required control incomplete')\n    main = records['scaled_ilr']\n    return {'score': float(np.mean([record['utility'] for record in main])),\n            'error': float(np.mean([record['coverage_error'] for record in main])),\n            'volume': float(np.mean([record['volume'] for record in main])),\n            'controls': 1.0, 'correct': True, 'duration_seconds': 0.0,\n            'solution': {'case': episode['case'], 'complete': True, 'controls': sorted(completed),\n                         'control_checks': {name: name in completed for name in sorted(EXPECTED_CONTROLS)},\n                         'methods': records}}\n\n\ndef worst_case(episode):\n    return {'score': 0.0, 'error': 1.0, 'volume': 1.0, 'controls': 0.0,\n            'correct': False, 'duration_seconds': 0.0,\n            'solution': {'case': episode['case'], 'complete': False, 'controls': [],\n                         'control_checks': {name: False for name in sorted(EXPECTED_CONTROLS)},\n                         'methods': None}}\n\n\ndef fixed_mean(values):\n    if not values or not all(type(value) in (int, float) and math.isfinite(value) for value in values):\n        raise ValueError('invalid fixed-denominator contributions')\n    return math.fsum(values) / len(values)\n\n\ndef uncertainty_by_case(episodes, outcomes):\n    intervals = {}\n    generator = np.random.default_rng(62845)\n    selected_cases = list(dict.fromkeys(episode['case'] for episode in episodes))\n    for case in selected_cases:\n        case_outcomes = [outcome for episode, outcome in zip(episodes, outcomes) if episode['case'] == case]\n        data = np.array([outcome['score'] for outcome in case_outcomes])\n        if len(data) < 2:\n            intervals[case] = {'seed_count': len(data), 'bootstrap95': None, 'paired_baselines': None}\n            continue\n        indices = generator.integers(0, len(data), size=(20000, len(data)))\n        boot = data[indices].mean(1)\n        comparisons = {}\n        for baseline in ('unscaled_ilr', 'simplex_linf', 'bonferroni'):\n            alpha_results = []\n            for alpha_index in range(3):\n                differences, volume_differences = [], []\n                for outcome in case_outcomes:\n                    methods = outcome['solution']['methods']\n                    if methods is None:\n                        differences.append(-1.0)\n                        volume_differences.append(1.0)\n                    else:\n                        differences.append(methods['scaled_ilr'][alpha_index]['utility'] - methods[baseline][alpha_index]['utility'])\n                        volume_differences.append(methods['scaled_ilr'][alpha_index]['volume'] - methods[baseline][alpha_index]['volume'])\n                bootstrap_difference = np.array(differences)[indices].mean(1)\n                bootstrap_volume = np.array(volume_differences)[indices].mean(1)\n                adjusted_tail = .05 / (2 * 54)\n                alpha_results.append({'alpha': ALPHAS[alpha_index], 'utility_difference': fixed_mean(differences),\n                    'volume_difference': fixed_mean(volume_differences),\n                    'paired_seed_bootstrap95': np.quantile(bootstrap_difference, [.025, .975]).tolist(),\n                    'paired_volume_bootstrap95': np.quantile(bootstrap_volume, [.025, .975]).tolist(),\n                    'bonferroni54_bootstrap_interval': np.quantile(bootstrap_difference, [adjusted_tail, 1 - adjusted_tail]).tolist()})\n            comparisons[baseline] = alpha_results\n        feature_controls = {}\n        for control in ('constant_input', 'permuted_input'):\n            control_differences = []\n            for alpha_index in range(3):\n                differences = []\n                for outcome in case_outcomes:\n                    methods = outcome['solution']['methods']\n                    differences.append(-1.0 if methods is None else\n                        methods['scaled_ilr'][alpha_index]['utility'] - methods[control][alpha_index]['utility'])\n                distribution = np.array(differences)[indices].mean(1)\n                control_differences.append({'alpha': ALPHAS[alpha_index], 'main_minus_control_utility': fixed_mean(differences),\n                    'paired_seed_bootstrap95': np.quantile(distribution, [.025, .975]).tolist()})\n            feature_controls[control] = control_differences\n        intervals[case] = {'seed_count': len(data), 'bootstrap95': np.quantile(boot, [.025, .975]).tolist(),\n                           'paired_baselines': comparisons, 'feature_controls': feature_controls}\n    seed_scores = []\n    for seed in dict.fromkeys(episode['seed'] for episode in episodes):\n        seed_scores.append(fixed_mean([outcome['score'] for episode, outcome in zip(episodes, outcomes)\n                                       if episode['seed'] == seed]))\n    overall_interval = None\n    if len(seed_scores) > 1:\n        indices = generator.integers(0, len(seed_scores), size=(20000, len(seed_scores)))\n        overall_interval = np.quantile(np.array(seed_scores)[indices].mean(1), [.025, .975]).tolist()\n    intervals['overall_seed_block'] = {'seed_count': len(seed_scores), 'bootstrap95': overall_interval}\n    return intervals\n\n\ndef aggregate(episodes, outcomes, complete):\n    score = fixed_mean([outcome['score'] for outcome in outcomes])\n    iid = [outcome['error'] for episode, outcome in zip(episodes, outcomes) if 'SHIFT' not in episode['case']]\n    shift = [outcome['error'] for episode, outcome in zip(episodes, outcomes) if 'SHIFT' in episode['case']]\n    valid = complete and all(outcome['correct'] for outcome in outcomes)\n    baseline_gap = -1.0\n    if valid:\n        baseline_scores = []\n        for name in ('unscaled_ilr', 'simplex_linf', 'bonferroni'):\n            baseline_scores.append(fixed_mean([fixed_mean([record['utility'] for record in outcome['solution']['methods'][name]]) for outcome in outcomes]))\n        baseline_gap = score - max(baseline_scores)\n    metrics = {SCORE_NAME: score, 'iid_coverage_error': fixed_mean(iid) if iid else 1.0,\n               'mean_volume': fixed_mean([outcome['volume'] for outcome in outcomes]),\n               'shift_coverage_error': fixed_mean(shift) if shift else 1.0,\n               'baseline_utility_gap': baseline_gap,\n               'control_check_pass_rate': fixed_mean([outcome['controls'] for outcome in outcomes]),\n               'correct': int(valid)}\n    if set(metrics) != set(METRIC_NAMES) or not all(math.isfinite(value) for value in metrics.values()):\n        raise ValueError('metric schema')\n    evidence = []\n    uncertainty = uncertainty_by_case(episodes, outcomes)\n    for seed in dict.fromkeys(episode['seed'] for episode in episodes):\n        selected = [outcome for episode, outcome in zip(episodes, outcomes) if episode['seed'] == seed]\n        evidence.append({'seed': seed, 'score': fixed_mean([outcome['score'] for outcome in selected]),\n                         'correct': all(outcome['correct'] for outcome in selected),\n                         'duration_seconds': sum(outcome['duration_seconds'] for outcome in selected),\n                         'solution': {'cases': [outcome['solution'] for outcome in selected],\n                                      'seed_block_uncertainty': uncertainty}})\n    return metrics, valid, {'schema_version': 1, 'episodes': evidence}\n\n\nnumpy==1.26.4\n#!/usr/bin/env python3\n\"\"\"Validate generated claim-grounding artifacts before paper finalization.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nEVIDENCE_REF_RE = re.compile(r\"@evidence\\[\\[[^\\]]+\\]\\]\")\nTEX_INPUT_RE = re.compile(\n    r\"\\\\(?:input|include)(?![A-Za-z@])\\s*\"\n    r\"(?:\\{(?P<braced>[^{}]+)\\}|(?P<unbraced>[^\\s%{}]+))\"\n)\nTEX_IMPORT_COMMAND_RE = re.compile(r\"\\\\(?:input|include)(?![A-Za-z@])\")\nTEX_LOCAL_SUPPORT_RE = re.compile(\n    r\"\\\\(?P<command>usepackage|RequirePackage|documentclass|LoadClass)\"\n    r\"(?![A-Za-z@])(?:\\s*\\[[^\\]]*\\])?\\s*\\{(?P<targets>[^{}]+)\\}\"\n)\nTEX_LOCAL_SUPPORT_COMMAND_RE = re.compile(\n    r\"\\\\(?:usepackage|RequirePackage|documentclass|LoadClass)(?![A-Za-z@])\"\n)\nDYNAMIC_TEX_IMPORT_RE = re.compile(r\"\\\\csname\\s*(?:input|include)\\s*\\\\endcsname\")\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\if[a-zA-Z@]+\\b|\\\\else\\b|\\\\fi\\b\")\nVERBATIM_ENV_RE = re.compile(\n    r\"\\\\begin\\s*\\{(?P<env>verbatim\\*?|lstlisting|minted)\\}.*?\"\n    r\"\\\\end\\s*\\{(?P=env)\\}\",\n    re.DOTALL,\n)\nPROMPT_ARTIFACT_RE = re.compile(r\".+_prompt(?:_round_\\d+(?:_contract_retry_\\d+)?)?\\.md$\")\nGENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\n    \"validation_feedback.json\",\n    \"validation_feedback.md\",\n    \"verification-report.json\",\n}\nROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\"validation_report.json\"}\nGENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES = (\n    \"paper_evidence_audit\",\n)\nEVIDENCE_BUNDLE_DIRNAME = \"scientific-evidence\"\nEVIDENCE_SCAN_SUFFIXES = (\n    \".tex\",\n    \".md\",\n    \".json\",\n    \".yaml\",\n    \".yml\",\n    \".py\",\n    \".sh\",\n    \".r\",\n    \".csv\",\n    \".tsv\",\n)\nEVIDENCE_SKIP_DIR_NAMES = {\n    \".git\",\n    \"__pycache__\",\n    EVIDENCE_BUNDLE_DIRNAME,\n}\nAGENT_SKILL_DIR_PREFIXES = (\n    (\".claude\", \"skills\"),\n    (\".codex\", \"skills\"),\n    (\".cursor\", \"skills\"),\n    (\".opencode\", \"skills\"),\n    (\".gemini\", \"skills\"),\n    (\".pi\", \"agent\", \"skills\"),\n)\nVERIFICATION_SUMMARY_KEYS = (\n    \"total_references\",\n    \"resolved_references\",\n    \"anchored_references\",\n    \"dangling_references\",\n    \"manifests_checked\",\n)\nSCIENTIFIC_EVIDENCE_SCRIPT = (\n    Path(__file__).resolve().parent.parent.parent\n    / \"scientific-evidence\"\n    / \"scripts\"\n    / \"scientific_evidence.py\"\n)\n\n\ndef read_json(path: Path) -> dict[str, Any]:\n    \"\"\"Read JSON data from disk when available.\"\"\"\n    try:\n        payload = json.loads(path.read_text(encoding=\"utf-8\"))\n    except json.JSONDecodeError as exc:\n        raise SystemExit(f\"Invalid JSON in {path}: {exc}\") from exc\n    if not isinstance(payload, dict):\n        raise SystemExit(f\"Expected JSON object in {path}\")\n    return payload\n\n\ndef read_bib_keys(path: Path) -> set[str]:\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n","exit_code":0,"status":"completed"}}
