\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:audit}{{1}{4}{Complete ten-method source-mixture audit, equally averaging $K=3,5,10$ within each of 50 seeds. Left: observed-composition coverage overall, in the difficult observable group, and among realized boundary responses; dashed line is $0.9$. Right: normalized ambient, supported-face, and frozen mixed reference masses, not response probabilities. Bars are pointwise descriptive 95\% seed-bootstrap intervals. CLR $10^{-6}$ has near-saturated, \emph {not exactly unit}, estimated ambient mass. Source: \texttt {artifacts/analysis/summary\_by\_law.csv}}{figure.caption.1}{}}
\newlabel{tab:source-coverage}{{1}{5}{Source structural-zero mixture: all ten nonoracle methods, with equal dimension weights. Entries are mean simultaneous observed-composition coverage [pointwise descriptive 95\% CI]. Boundary is a realized-response diagnostic, not a calibrated observable group. Nominal level is $0.9$; larger is not automatically better if overconservative}{table.caption.2}{}}
\newlabel{tab:source-size}{{2}{5}{The same fitted source-mixture regions as Table~\ref {tab:source-coverage}: normalized reference masses [descriptive 95\% CI]. $V$ is ambient, $A_K$ is supported-face, and $E_Q$ uses \eqref {eq:Q}. Smaller denotes less reference mass, not improved reliability or utility. The CLR $10^{-6}$ ambient estimate is $0.999845$ [$0.999732,0.999931$], not exactly one; numerical saturation and zero hits remain MC-limited}{table.caption.3}{}}
\newlabel{sec:limitations}{{6}{6}{}{section.6}{}}
\newlabel{sec:conclusion}{{7}{6}{}{section.7}{}}
\newlabel{main-end}{{7}{6}{}{section.7}{}}
\newlabel{tab:contrasts}{{3}{7}{All ten frozen aggregate effects, first minus second. Both interval columns use paired seed-cluster percentile bootstraps: 95\% is descriptive; 99.5\% is approximately family-adjusted across these ten effects. P1--P10 definitions and averaging cells are specified in Appendix~\ref {app:contrasts}; S denotes source, T shifted, Z the zero-mixture law, and Both both laws. All effects average the three dimensions. Effects are absolute coverage or normalized-mass differences, not relative percentages}{table.caption.4}{}}
\newlabel{tab:shift}{{4}{7}{Shifted L2 comparisons, equally averaging all six dimension/law cells within seed. Mean [descriptive 95\% CI]; $E_Q$ integrates target covariate weights. Weighted L2 uses the exact oracle density ratio and targets marginal, not groupwise, coverage. Easy-group entries rounded near one are empirical estimates, not exact guarantees}{table.caption.5}{}}
\newlabel{fig:shift}{{2}{7}{Dimension-resolved shifted marginal coverage for five diagnostic comparators, with pointwise descriptive 95\% seed-bootstrap intervals. The difficult-group frequency changes from $0.2$ to $0.8$ with within-group laws preserved. CLR $10^{-6}$ in the mixture fails at $K=10$ despite near-nominal low-dimensional results; scaling also has small $K=10$ shortfalls. Complete all-method source and shift results are in Appendices~\ref {app:source}--\ref {app:shift}}{figure.caption.6}{}}
