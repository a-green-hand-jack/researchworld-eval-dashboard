ef close(self):\n        if self.process is not None:\n            process = self.process\n            try:\n                os.killpg(process.pid, signal.SIGTERM)\n            except ProcessLookupError:\n                pass\n            try:\n                process.wait(timeout=.4)\n            except subprocess.TimeoutExpired:\n                try:\n                    os.killpg(process.pid, signal.SIGKILL)\n                except ProcessLookupError:\n                    pass\n                process.wait(timeout=.4)\n            try:\n                os.killpg(process.pid, signal.SIGKILL)\n            except ProcessLookupError:\n                pass\n\"\"\"Self-contained evaluator; real-source episode plan and scalar validity, not claim endorsement.\"\"\"\nimport argparse\nimport base64\nimport collections\nimport contextlib\nimport gzip\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport re\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unicodedata\n\nSTARTED = time.monotonic()\nPLANE = 'final'\nSEEDS = [1009, 1013, 1019]\nWALL_SECONDS = 3600\nRPC_BUDGET = 2033\nWIRE_LIMIT = 64 * 1024 * 1024\nMAX_CHUNKS = 32\nCHUNK_ROWS = 256\nBATCH_ROWS = 128\nBASELINES = ['constant', 'copy', 'random_lowrank', 'medoid_ridge', 'selected_ridge']\nMETRIC_NAMES = ['combined_score', 'mteb_score', 'open_llm_score', 'permuted_score',\n                'corruption_gap', 'constant_score', 'copy_score', 'random_lowrank_score',\n                'medoid_ridge_score', 'selected_ridge_score', 'reset_replay_ok',\n                'failed_episode_fraction', 'control_failure_fraction',\n                'paired_gain_ci_low', 'paired_gain_ci_high', 'correct']\nfor thread_name in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):\n    os.environ[thread_name] = '1'\nimport numpy as np\n\n\ndef bounded_json_line(value, wire_limit=WIRE_LIMIT):\n    encoded = json.dumps(value, allow_nan=False, separators=(',', ':')).encode('utf-8') + b'\\n'\n    if len(encoded) >= wire_limit:\n        raise ProtocolFailure('wire_limit')\n    return encoded\n\n\ndef finite_budget_seconds(value):\n    if type(value) not in (int, float) or not math.isfinite(value) or value < 0:\n        raise ValueError('invalid time allowance')\n    return value\n\n\ndef reserved_method_deadline(*, now, episode_deadline, methods_remaining, work_seconds, cleanup_seconds):\n    for value in (now, episode_deadline, cleanup_seconds):\n        finite_budget_seconds(value)\n    if finite_budget_seconds(work_seconds) == 0 or type(methods_remaining) is not int or methods_remaining < 0:\n        raise ValueError('invalid method budget')\n    if now + (methods_remaining + 1) * (work_seconds + cleanup_seconds) > episode_deadline:\n        raise TimeoutError('insufficient matched method reservations')\n    return now + work_seconds\n\n\ndef require_joint_workload_budget():\n    for wall, startup, work in ((1800, 180, 8), (3600, 300, 16)):\n        required = startup + 30 + 25 * (2 + 6 * (work + 0.05) + 1.5)\n        if required > wall:\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\nProbabilistic Matrix Factorization\nRuslan Salakhutdinov and Andriy Mnih\nDepartment of Computer Science, University of Toronto\n6 King’s College Rd, M5S 3G4, Canada\n{rsalakhu,amnih}@cs.toronto.edu\nAbstract\nMany existing approaches to collaborative ﬁltering can neither handle very large\ndatasets nor easily deal with users who have very few ratings. In this paper we\npresent the Probabilistic Matrix Factorization (PMF) model which scales linearly\nwith the number of observations and, more importantly, performs well on the\nlarge, sparse, and very imbalanced Netﬂix dataset. We further extend the PMF\nmodel to include an adaptive prior on the model parameters and show how the\nmodel capacity can be controlled automatically. Finally, we introduce a con-\nstrained version of the PMF model that is based on the assumption that users who\nhave rated similar sets of movies are likely to have similar preferences. The result-\ning model is able to generalize considerably better for users with very few ratings.\nWhen the predictions of multiple PMF models are linearly combined with the\npredictions of Restricted Boltzmann Machines models, we achieve an error rate\nof 0.8861, that is nearly 7% better than the score of Netﬂix’s own system.\n1\nIntroduction\nOne of the most popular approaches to collaborative ﬁltering is based on low-dimensional factor\nmodels. The idea behind such models is that attitudes or preferences of a user are determined by\na small number of unobserved factors. In a linear factor model, a user’s preferences are modeled\nWe use convex relaxation techniques to provide a sequence of regularized low-rank solutions for large-scale matrix completion problems. Using the nuclear norm as a regularizer, we provide a simple and very efficient convex algorithm for minimizing the reconstruction error subject to a bound on the nuclear norm. Our algorithm Soft-Impute iteratively replaces the missing elements with those obtained from a soft-thresholded SVD. With warm starts this allows us to efficiently compute an entire regularization path of solutions on a grid of values of the regularization parameter. The computationally intensive part of our algorithm is in computing a low-rank SVD of a dense matrix. Exploiting the problem structure, we show that the task can be performed with a complexity linear in the matrix dimensions. Our semidefinite-programming algorithm is readily scalable to large matrices: for example it can obtain a rank-80 approximation of a 106 × 106 incomplete matrix with 105 observed entries in 2.5 hours, and can fit a rank 40 approximation to the full Netflix training set in 6.6 hours. Our methods show very good performance both in training and test error when compared to other competitive state-of-the art techniques.Summary A broadly applicable algorithm for computing maximum likelihood estimates from incomplete data is presented at various levels of generality. Theory showing the monotone behaviour of the likelihood and convergence of the algorithm is derived. Many examples are sketched, including missing value situations, applications to grouped, censored or truncated data, finite mixture models, variance component estimation, hyperparameter estimation, iteratively reweighted least squares and factor analysis.","exit_code":0,"status":"completed"}}
