 \"unknown\")\n        print(f\"episode_failure component={component} category={category} operation={operation}\",\n              file=sys.stderr, flush=True)\n\n\ndef worker_diagnostic(snapshot, category, component, returncode):\n    if PLANE != \"search\":\n        return\n    if repair_mode() and snapshot[\"stderr\"]:\n        sys.stderr.write(snapshot[\"stderr\"])\n    if repair_mode():\n        status = returncode if type(returncode) is int else 0\n        print(f\"worker_failure component={component} category={category} operation=worker \"\n              f\"status_known={int(type(returncode) is int)} status={status} observed_bytes={snapshot['observed_bytes']} \"\n              f\"retained_bytes={snapshot['retained_bytes']} truncated={int(snapshot['truncated'])} \"\n              f\"capture_error={bounded_failure_name(snapshot['capture_error'], 'none')}\",\n              file=sys.stderr, flush=True)\n\n\ndef cpu_limit_seconds(wall_seconds, allowed_threads):\n    if (type(wall_seconds) not in (int, float) or not math.isfinite(wall_seconds)\n            or wall_seconds <= 0 or type(allowed_threads) is not int or allowed_threads <= 0):\n        raise ValueError(\"invalid CPU budget\")\n    return math.ceil(wall_seconds * allowed_threads)\n\n\ndef finite_budget_seconds(value):\n    if type(value) not in (int, float) or not math.isfinite(value) or value < 0:\n        raise ValueError(\"invalid time allowance\")\n    return value\n\n\ndef positive_work_seconds(value):\n    if finite_budget_seconds(value) == 0:\n        raise ValueError(\"work allowance must be positive\")\n      \"group_by\": \"hidden_width_with_seed_offsets\",\n      \"metric\": \"sustained training-fit onset and sustained held-out generalization onset in optimizer updates\",\n      \"split_by\": \"short-horizon selection observations versus final observations\",\n      \"preferred_span\": \"full_width\",\n      \"target_width_fraction\": 1.0,\n      \"layout_rationale\": \"Use the single-column full text width of 5.5in, two panels with three width categories and two marker meanings, about 2.3in high and 0.32 body page with caption. Explicitly label differing x ranges, 6000 and 24000 updates. Width/seed offsets and a shared two-marker legend remain legible at 8.5pt; do not add all four arm trajectories to this figure.\",\n      \"allow_progression\": false,\n      \"max_panels\": 2,\n      \"max_panels_per_row\": 2,\n      \"max_categories_per_panel\": 3,\n      \"max_series_per_panel\": 2,\n      \"minimum_rendered_font_pt\": 8.5,\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"implementation_notes\": \"This is a direct event-time comparison, not a search trajectory. Read event records and check them against curves and the evaluator definition. Training threshold is 0.99, held-out threshold 0.95, each sustained for three 100-update checkpoints; delayed-event criterion is at least 1000 updates between onsets. At the horizon use an arrow only for a recorded censored trajectory, never for a missing run. Do not draw a finite endpoint for unobserved generalization. Export PDF and 300-DPI PNG and include PDF in LaTeX.\"\n    }\n  ],\n  \"supplementary_plan\": {\n    \"purpose\": \"Add reproducible definitions, complete retained controls, individual seed records, and evidence limitations after the references without relocating qualification failure or missingness essential to the thesis.\",\n    \"planned_subsections\": [\n      {\n        \"heading\": \"Exact model, data partition, and intervention definitions\",\n        \"grounded_content\": \"Document the two learned 97-by-width embeddings, their sum plus bias, GELU and linear 97-class readout; parameter count 292w+97; initialization coupling across widths; norm rescaling target; full-batch float32 AdamW with all parameters including biases decayed. Detail disjoint 4704/4705-example selection/final pools and within-pool seeded splits (2822/1882 and 2823/1882 train/evaluation). Use local task/evaluate.py, task/evaluate_final.py and the resource policies as method provenance, not as measured-result source IDs.\",\n        \"source_ids\": [\n          \"final.evidence.episodes\"\n          \"final.metric.control_validity_rate\"\n        ]\n      },\n      {\n        \"heading\": \"Reproducibility and LLM Usage\",\n        \"grounded_content\": \"List the actual supplied code, environment/version records in task/requirements.txt, recorded seeds, source hashes, CPU setup, and downstream figure/table scripts and commands once implemented. Only give measured runtimes from the supplied records, not fabricated throughput projections or guaranteed full-run timings. Include a separate LLM Usage section with the documented ideation, bounded controller edits, framing, and writing roles; do not claim that an LLM independently executed unrecorded experiments. Preserve anonymity and disclose the literature restriction; never state that a prohibited work was encountered unless an actual encounter is documented.\",\n        \"source_ids\": [\n          \"final.evidence.episodes\"\n        ]\n      }\n    ]\n  },\n  \"forbidden_headings\": [\n    \"Search Progression\",\n    \"Campaign Phases\",\n    \"Milestones\",\n    \"First Successful Run\",\n    \"Experiment A / Experiment B\",\n    \"Cycle 1 / Cycle 2 / Cycle 3\",\n    \"From Baseline to Winner\",\n    \"A Universal Width Scaling Law\",\n    \"Proof of the Decay Clock\",\n    \"Validated Superiority\"\n  ],\n  \"forbidden_phrases\": [\n    \"we then tried\",\n```sh\npython3 -m venv /tmp/paper-analysis\n/tmp/paper-analysis/bin/pip install -r scripts/requirements-analysis.txt\n/tmp/paper-analysis/bin/python scripts/build_artifacts.py\n/tmp/paper-analysis/bin/python scripts/build_claims.py\n```\n\nAnalysis generates `derived/observations.json`, `derived/summary.json`,\n`derived/final_records.tex`, `derived/norm_loss_records.tex`,\n`derived/coverage_table.tex`, `derived/development_table.tex`, source hashes,\n`figure_manifest.json`, and PDF/300-DPI PNG quantitative plots. It reads all\nnumbers from recorded curves and checks recomputed onset fields. It uses sample\nSD with denominator n-1 and exact beta-quantile event-count intervals, conditional\non retained records; no missing outcomes are imputed for descriptive comparisons.\n\nThe concept overview is owned by the synchronous downstream orchestrator. The\nanalysis script creates a clearly marked placeholder only if no figure exists,\nand never overwrites a rendered concept figure or its completion marker.\n\n## Table and figure mapping\nnumpy==2.5.4\nscipy==1.18.1\nmatplotlib==3.11.2\npymupdf==2.1\njsonschema==4.26.0\nTraceback (most recent call last):\n  File \"<string>\", line 1, in <module>\nModuleNotFoundError: No module named 'matplotlib'\n","exit_code":1,"status":"failed"}}
