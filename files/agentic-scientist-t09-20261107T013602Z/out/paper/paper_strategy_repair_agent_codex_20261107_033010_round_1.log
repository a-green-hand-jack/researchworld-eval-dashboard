{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nfrom pathlib import Path\nstrategy=json.loads(Path('paper_strategy.json').read_text())\ndata=json.loads(Path('paper_data.json').read_text())\nmemo=Path('paper_strategy.md').read_text()\nerrors=[]\ndef check(condition,message):\n if not condition: errors.append(message)\nkeys='status selected_prompt_family recommended_title central_question central_thesis narrative_rationale prior_paper_story_status edit_framing_decision staged_input_impact method_groups results_focus figure_plan figure_specs supplementary_plan forbidden_headings forbidden_phrases notes_for_writer failure_reason'.split()\ncheck(set(strategy)==set(keys),'Top-level keys differ from ready-strategy contract')\ncheck(strategy['status']=='ready','Strategy is not ready')\ncheck(strategy['selected_prompt_family']=='paper_standalone','Wrong prompt family')\nfor key in ('recommended_title','central_question','central_thesis','narrative_rationale','edit_framing_decision'):\n check(isinstance(strategy[key],str) and bool(strategy[key].strip()),f'Empty {key}')\ncheck(strategy['prior_paper_story_status'] in ('preserved','broadened','recentered','rejected'),'Invalid framing decision')\nfor key in ('staged_input_impact','results_focus','figure_plan','forbidden_headings','forbidden_phrases','notes_for_writer'):\n check(isinstance(strategy[key],list) and bool(strategy[key]) and all(isinstance(item,str) and item.strip() for item in strategy[key]),f'Invalid {key}')\ncheck(bool(strategy['method_groups']),'No method groups')\nfor group in strategy['method_groups']:\n check(set(group)=={'name','role','include_reason'},'Invalid method group fields')\n check(group['role'] in ('baseline','proposed','ablation','supporting'),'Invalid method role')\n check(all(isinstance(value,str) and value.strip() for value in group.values()),'Empty method description')\nsupp=strategy['supplementary_plan']\ncheck(isinstance(supp.get('purpose'),str) and bool(supp['purpose'].strip()),'Missing supplementary purpose')\ncheck(bool(supp.get('planned_subsections')),'No grounded supplementary subsections')\nfor index,section in enumerate(supp['planned_subsections']):\n check(set(section)=={'heading','grounded_content','source_ids'},f'Invalid supplement fields at {index}')\n for field in ('heading','grounded_content'):\n  check(isinstance(section[field],str) and bool(section[field].strip()),f'Empty supplement {field} at {index}')\n sources=section['source_ids']\n check(isinstance(sources,list) and bool(sources),f'Empty supplementary source list at {index}')\n for source in sources:\n  check(isinstance(source,str) and source in data['grounding_sources'],f'Unknown grounding source {source}')\n check(section['heading'] in memo,f'Supplement heading missing in memo: {section[\\\"heading\\\"]}')\nrequired='figure_id required purpose figure_type preferred_generator group_by metric split_by preferred_span target_width_fraction layout_rationale allow_progression max_panels max_categories_per_panel max_series_per_panel'.split()\nfor figure in strategy['figure_specs']:\n check(set(required)<=set(figure),f'Missing fields for {figure.get(\\\"figure_id\\\")}')\n check(figure['preferred_generator'] in ('matplotlib','tikz','generate-concept-figure','native_latex','manual'),'Invalid generator')\n check(figure['preferred_span'] in ('column','full_width'),'Invalid figure span')\n check(0<figure['target_width_fraction']<=1,'Invalid figure width')\n check(not figure['allow_progression'],'Unsupported progression figure')\n check(figure['max_panels']<=4 and figure['max_categories_per_panel']<=6 and figure['max_series_per_panel']<=4,'Readability budget exceeded')\n check(bool(figure['layout_rationale']),'Missing layout rationale')\ncheck(sum(figure['preferred_generator']=='generate-concept-figure' for figure in strategy['figure_specs'])==1,'Expected one conceptual overview')\nfor field in ('recommended_title','central_question','central_thesis'):\n check(strategy[field] in memo,f'Memo differs on {field}')\ncheck(any('separate LLM Usage section' in note for note in strategy['notes_for_writer']),'Missing required LLM disclosure')\ncheck('Separate required process disclosure: LLM Usage' in memo,'Memo missing separate LLM disclosure')\ncheck(strategy['failure_reason']=='','Ready strategy has failure reason')\ncheck(not Path('paper.tex').exists() and not Path('claims_grounding.json').exists(),'Unexpected final-paper artifact')\nqualification={field:data['grounding_sources'][f'final.qualification.{field}']['value'] for field in ('status','outcome','correct')}\nprint(json.dumps({'validation':'strategy-only local contract recheck; no final-paper validation','ok':not errors,'hard_errors':errors,'grounded_supplement_subsections':len(supp['planned_subsections']),'method_groups':len(strategy['method_groups']),'required_figures':sum(figure['required'] for figure in strategy['figure_specs']),'independently_checked_final_qualification':qualification},indent=2))\nraise SystemExit(bool(errors))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
