\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Main comparison at $n{=}50$ items. For each regime: geometric-mean MAE ratio to random sampling over benchmarks with 95\% bootstrap interval (lower is better; 13 benchmarks for random split and top-30\% held out, 7 for held-out developers) and mean Spearman $\rho $ between predicted and true scores of target models. Bold: best in column among listed rows. $^\dagger $: defined after seeing stage-1 results (post hoc, Sec.~\ref {sec:posthoc}). Other budgets, RMSE and Kendall $\tau $: Appendix~\ref {app:tables}.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{4}{Main comparison at $n{=}50$ items. For each regime: geometric-mean MAE ratio to random sampling over benchmarks with 95\% bootstrap interval (lower is better; 13 benchmarks for random split and top-30\% held out, 7 for held-out developers) and mean Spearman $\rho $ between predicted and true scores of target models. Bold: best in column among listed rows. $^\dagger $: defined after seeing stage-1 results (post hoc, Sec.~\ref {sec:posthoc}). Other budgets, RMSE and Kendall $\tau $: Appendix~\ref {app:tables}}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces MAE ratio to random sampling (top, log scale, shaded 95\% bootstrap interval) and Spearman $\rho $ (bottom) versus number of items. Random sampling's absolute geometric-mean MAE is 0.10, 0.064, 0.045, 0.031 at $n=10,25,50,100$ (similar in all regimes).}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:budget}{{1}{4}{MAE ratio to random sampling (top, log scale, shaded 95\% bootstrap interval) and Spearman $\rho $ (bottom) versus number of items. Random sampling's absolute geometric-mean MAE is 0.10, 0.064, 0.045, 0.031 at $n=10,25,50,100$ (similar in all regimes)}{figure.1}{}}
