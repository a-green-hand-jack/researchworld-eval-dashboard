n            return curve[index][\"step\"]\n    return None\n\n\ndef curve_events(curve, horizon):\n    fit = sustained_time(curve, \"train_accuracy\", .99)\n    generalize = sustained_time(curve, \"evaluation_accuracy\", .95)\n    uncensored = fit is not None and generalize is not None\n    delay = max(0, generalize - fit) if uncensored else horizon\n    return {\"memorization_step\": fit, \"generalization_step\": generalize,\n            \"right_censored\": not uncensored, \"restricted_delay\": delay / horizon,\n            \"grokking\": uncensored and delay >= 1000}\n\n\ndef execute_episode(episode, call, deadline, *, pool, common_configuration, smoke):\n    started = time.monotonic()\n    horizon = 4 if smoke else HORIZON\n    checkpoints = list(range(5)) if smoke else list(range(0, horizon + 1, 100))\n    configuration = validate_plan(call(plan_request(episode[\"width\"], horizon, checkpoints)))\n    if common_configuration and configuration != common_configuration[0]:\n        raise CandidateProtocolError(\"configuration_not_common\")\n    if not common_configuration:\n        common_configuration.append(configuration)\n    split = pool[\"splits\"][str(episode[\"seed\"]) ]\n    train_indices = split[\"train\"][:64] if smoke else split[\"train\"]\n    test_indices = split[\"evaluation\"][:64] if smoke else split[\"evaluation\"]\n    train = [pool[\"rows\"][index] for index in train_indices]\n    evaluation = [pool[\"rows\"][index] for index in test_indices]\n    arms = {}\n    work = 12 if smoke else WORK_SECONDS\n    episode_deadline = min(deadline, time.monotonic() + 4 * (work + 3) + 1)\n    for index, arm in enumerate(ARMS):\n        if trusted_cpu_seconds() >= CPU_SECONDS - 10:\n            raise RequiredBaselineFailure(\"baseline_cpu_budget\")\n        method_deadline = reserved_method_deadline(now=time.monotonic(), episode_deadline=episode_deadline,\n                                                   methods_remaining=len(ARMS) - index - 1,\n                                                   work_seconds=work, cleanup_seconds=3)\n        job = {\"width\": episode[\"width\"], \"seed\": episode[\"seed\"], \"configuration\": configuration,\n               \"arm\": arm, \"updates\": horizon, \"checkpoints\": checkpoints, \"train\": train,\n               \"evaluation\": evaluation, \"work_seconds\": work}\n        arms[arm] = run_training(\n            job, deadline=method_deadline,\n            category_sink=lambda category: record_failure({\"component\": \"baseline\", \"category\": category,\n                                                          \"operation\": \"baseline_worker\"}))\n    candidate = arms[\"candidate\"]\n    completed = {name for name in CONTROLS if len(candidate[\"controls\"]) == len(checkpoints)\n                 and all(point[\"valid\"].get(name) is True for point in candidate[\"controls\"])}\n    if set(CONTROLS) - completed:\n        raise RequiredBaselineFailure(\"baseline_result_failure\")\n    trajectory_coverage = sum(len(arms[arm][\"curves\"]) / len(checkpoints) for arm in ARMS) / 4\n    control_coverage = sum(sum(point[\"valid\"][name] for point in candidate[\"controls\"])\n                           / len(checkpoints) for name in CONTROLS) / 4\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n{\n  \"$id\": \"https://schemas.agentic-scientist.local/scientific-evidence/artifact-manifest.schema.json\",\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"artifact\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"kind\": {\n          \"enum\": [\n            \"source\",\n            \"derived\",\n            \"manuscript\",\n            \"figure\",\n            \"table\",\n            \"script\",\n            \"log\",\n            \"other\"\n          ],\n          \"type\": \"string\"\n        },\n        \"media_type\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"path\": {\n          \"description\": \"Path to the artifact relative to the scientific-evidence root when possible.\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"sha256\": {\n          \"description\": \"Optional hash recorded when the producing workflow computes one.\",\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"path\",\n        \"kind\"\n      ],\n      \"type\": \"object\"\n    },\n    \"derived_from\": {\n      \"description\": \"Inline @evidence refs or stable ids describing the artifact inputs.\",\n      \"items\": {\n        \"minLength\": 1,\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"type\": \"array\"\n    },\n    \"generated_by\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"command\": {\n          \"items\": {\n            \"minLength\": 1,\n            \"type\": \"string\"\n          },\n          \"minItems\": 1,\n          \"type\": \"array\"\n        },\n        \"cwd\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"finished_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        },\n        \"script_path\": {\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"script_sha256\": {\n          \"pattern\": \"^[0-9a-f]{64}$\",\n          \"type\": \"string\"\n        },\n        \"started_at\": {\n          \"format\": \"date-time\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"script_path\"\n      ],\n      \"type\": \"object\"\n    },\n    \"named_outputs\": {\n      \"additionalProperties\": {\n        \"type\": [\n          \"string\",\n          \"number\",\n          \"integer\",\n          \"boolean\",\n          \"array\",\n          \"object\",\n          \"null\"\n        ]\n      },\n      \"description\": \"Optional machine-readable outputs emitted by the derivation.\",\n      \"type\": \"o