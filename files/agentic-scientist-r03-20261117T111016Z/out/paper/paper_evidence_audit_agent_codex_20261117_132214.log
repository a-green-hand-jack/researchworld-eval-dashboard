{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"sed -n '303,440p' source_evidence/selected/src/program.py; sed -n '808,902p' source_evidence/evaluate_final.py\"","aggregated_output":"def _apply_residual_correction(base_prediction, selected_indices, observed_scores, correction):\n    if not selected_indices or correction['blend'] == 0.0 or correction['bank'] is None:\n        return base_prediction\n    bank = correction['bank']\n    donor_residuals = _bank_residuals(bank, selected_indices)\n    neighbor_weights = _bank_weights(bank, selected_indices, np.asarray(observed_scores), correction['bandwidth'])\n    predictions = base_prediction.copy()\n    selected = set(selected_indices)\n    for target in range(predictions.size):\n        if target in selected:\n            continue\n        usable = np.isfinite(donor_residuals[:, target]) & (neighbor_weights > 0)\n        predictions[target] = _correct_target(base_prediction[target], donor_residuals[usable, target],\n                                               neighbor_weights[usable], correction['blend'], correction['shrinkage'])\n    return np.clip(predictions, 0, 1)\n\n\ndef handle(request):\n    operation = request['op']\n    if operation == 'reset':\n        seed = request['seed']\n        if type(seed) is not int or seed < 0:\n            raise ValueError('invalid seed')\n        _state.clear()\n        _state['rng'] = np.random.default_rng(seed)\n        _state['residual_seed'] = seed\n        return {'ok': True}\n    if operation == 'upload_start':\n        rows, columns = request['shape']\n        if (any(type(count) is not int or not 1 <= count <= 4096 for count in [rows, columns])\n                or request['nbytes'] != 9 * rows * columns or request['nbytes'] > 256 * 1024**2\n                or not 1 <= request['chunks'] <= 64\n                or [request[key] for key in ['dtype', 'byteorder', 'mask_dtype', 'encoding', 'layout']]\n                != ['float64', 'little', 'uint8', 'base64', 'values_then_mask']):\n            raise ValueError('invalid upload')\n        _state['upload'] = bytearray()\n        _state['metadata'] = dict(request)\n        _state['next_chunk'] = 0\n        return {'ok': True}\n    if operation == 'upload_chunk':\n        metadata = _state['metadata']\n        if request['index'] != _state['next_chunk'] or request['index'] >= metadata['chunks']:\n            raise ValueError('invalid chunk order')\n        decoded = base64.b64decode(request['data'], validate=True)\n        if len(decoded) > 4 * 1024**2 or len(_state['upload']) + len(decoded) > metadata['nbytes']:\n            raise ValueError('invalid chunk size')\n        _state['upload'].extend(decoded)\n        _state['next_chunk'] += 1\n        return {'ok': True}\n    if operation == 'upload_commit':\n        metadata = _state['metadata']\n        if len(_state['upload']) != metadata['nbytes'] or _state['next_chunk'] != metadata['chunks']:\n            raise ValueError('incomplete upload')\n        rows, columns = metadata['shape']\n        count = rows * columns\n        _state['values'] = np.frombuffer(_state['upload'], dtype='<f8', count=count).reshape(rows, columns).copy()\n        _state['mask'] = np.frombuffer(_state['upload'], dtype='u1', offset=8*count).reshape(rows, columns).copy()\n        if (not np.isfinite(_state['values']).all() or not np.isin(_state['mask'], [0, 1]).all()\n                or np.any((_state['values'] < 0) | (_state['values'] > 1))):\n            raise ValueError('invalid history')\n        del _state['upload']\n        return {'ok': True}\n    if operation == 'fit':\n        values, mask = _state['values'], _state['mask'].astype(bool)\n        rank = min(int(request['rank']), *values.shape)\n        ridge = float(request['ridge'])\n        sweeps = int(request['sweeps'])\n        if not 1 <= rank <= 16 or not 1 <= sweeps <= 50 or not math.isfinite(ridge) or ridge <= 0:\n            raise ValueError('invalid fitting settings')\n        counts = mask.sum(axis=0)\n        means = np.divide((values * mask).sum(axis=0), counts,\n                          out=np.full(values.shape[1], 0.5), where=counts > 0)\n        centered = values - means\n        factors = _state['rng'].normal(0, .1, size=(values.shape[1], rank))\n        latent = np.zeros((values.shape[0], rank))\n        identity = ridge * np.eye(rank)\n        for sweep in range(sweeps):\n            for row in range(values.shape[0]):\n                design = factors[mask[row]]\n                latent[row] = np.linalg.solve(identity + design.T @ design, design.T @ centered[row, mask[row]])\n            for column in range(values.shape[1]):\n                design = latent[mask[:, column]]\n                factors[column] = np.linalg.solve(identity + design.T @ design, design.T @ centered[mask[:, column], column])\n        _state.update(means=means, factors=factors, ridge=ridge)\n        _state['correction'] = _prepare_residual_correction(\n            values, mask, rank, ridge, sweeps, _state['residual_seed'])\n        return {'ok': True}\n    if operation == 'begin':\n        _state['available'] = sorted(request['queryable'])\n        _state['observed'] = []\n        _state['scores'] = []\n        _state['pending'] = None\n        return {'ok': True}\n    if operation == 'select':\n        factors = _state['factors']\n        observed = _state['observed']\n        available = [index for index in _state['available'] if index not in observed]\n        covariance = np.linalg.inv(_state['ridge'] * np.eye(factors.shape[1]) + factors[observed].T @ factors[observed])\n        cross = factors @ covariance @ factors[available].T\n        denominator = 1 + np.sum((factors[available] @ covariance) * factors[available], axis=1)\n        gains = np.sum(cross * cross, axis=0) / denominator\n        chosen = int(available[int(np.argmax(gains))])\n        _state['pending'] = chosen\n        return {'index': chosen}\n    if operation == 'observe':\n        if request['index'] != _state['pending']:\n            raise ValueError('observation without selection')\n        _state['observed'].append(request['index'])\n        _state['scores'].append(float(request['value']))\n        _state['pending'] = None\n        return {'ok': True}\n    if operation == 'predict':\n        factors, means = _state['factors'], _state['means']\n        observed = _state['observed']\n        design = factors[observed]\n        latent = np.linalg.solve(_state['ridge'] * np.eye(factors.shape[1]) + design.T @ design,\n                                 design.T @ (np.asarray(_state['scores']) - means[observed]))\n        base_prediction = np.clip(means + factors @ latent, 0, 1)\n        predictions = _apply_residual_correction(base_prediction, observed, _state['scores'], _state['correction'])\n        return {'predictions': predictions.tolist()}\n    raise ValueError('unsupported operation')\ndef transformed_history(values, mask, case, seed):\n    means = np.divide((values*mask).sum(axis=0), mask.sum(axis=0),\n                      out=np.full(values.shape[1], .5), where=mask.sum(axis=0) > 0)\n    if case == 'C':\n        result = np.where(mask, means, 0)\n        informative = any(np.ptp(values[mask[:, column], column]) > 1e-12\n                          for column in range(values.shape[1]) if mask[:, column].sum() > 1)\n        if not informative or np.allclose(result, values, rtol=0, atol=1e-12):\n            raise ProtocolFailure('vacuous_control', 'fit')\n        return result, mask.copy()\n    if case == 'D':\n        result, result_mask = values.copy(), mask.copy()\n        rng = np.random.default_rng(seed + 13)\n        for column in range(values.shape[1]):\n            shift = int(rng.integers(1, len(values)))\n            result[:, column] = np.roll(values[:, column], shift)\n            result_mask[:, column] = np.roll(mask[:, column], shift)\n        if np.array_equal(result, values) and np.array_equal(result_mask, mask):\n            raise ProtocolFailure('vacuous_control', 'fit')\n        if np.allclose(np.cov(result.T), np.cov(values.T), atol=1e-12, rtol=0):\n            raise ProtocolFailure('vacuous_control', 'fit')\n        return result, result_mask\n    return values, mask\n\n\ndef fit_low_rank(values, mask, seed, sweeps):\n    means = np.divide((values*mask).sum(axis=0), mask.sum(axis=0),\n                      out=np.full(values.shape[1], .5), where=mask.sum(axis=0) > 0)\n    centered = values - means\n    rank = min(4, *values.shape)\n    factors = np.random.default_rng(seed).normal(0, .1, (values.shape[1], rank))\n    latent = np.zeros((values.shape[0], rank))\n    regularizer = .1 * np.eye(rank)\n    for sweep in range(sweeps):\n        for row in range(len(values)):\n            design = factors[mask[row]]\n            latent[row] = np.linalg.solve(regularizer + design.T @ design, design.T @ centered[row, mask[row]])\n        for column in range(values.shape[1]):\n            design = latent[mask[:, column]]\n            factors[column] = np.linalg.solve(regularizer + design.T @ design, design.T @ centered[mask[:, column], column])\n    return means, factors\n\n\ndef partitions(rows, test_indices, seed):\n    output = []\n    for index in test_indices:\n        available = np.flatnonzero([value is not None for value in rows[index]['values']])\n        rng = np.random.default_rng(seed + index * 1009)\n        shuffled = rng.permutation(available)\n        cut = max(8, (2 * len(shuffled)) // 3)\n        reservoir, targets = sorted(shuffled[:cut].tolist()), sorted(shuffled[cut:].tolist())\n        if not targets or len(reservoir) < 8:\n            raise RuntimeError('invalid frozen reservoir')\n        output.append((reservoir, targets))\n    return output\n\n\ndef error_pair(predicted, truth, indices):\n    residual = predicted[indices] - truth[indices]\n    return float(np.mean(np.abs(residual))), float(np.mean(residual**2))\n\n\ndef run_baseline(name, values, mask, tests, partitions_for_rows, seed, sweeps):\n    means = np.divide((values*mask).sum(axis=0), mask.sum(axis=0),\n                      out=np.full(values.shape[1], .5), where=mask.sum(axis=0) > 0)\n    factors = None\n    if name in ['random_low_rank', 'variance_low_rank']:\n        means, factors = fit_low_rank(values, mask, seed, sweeps)\n    variance = np.divide(((values-means)**2 * mask).sum(axis=0), mask.sum(axis=0),\n                         out=np.zeros(values.shape[1]), where=mask.sum(axis=0)>0)\n    losses = np.ones((len(tests), 4))\n    for row, (reservoir, target) in enumerate(partitions_for_rows):\n        if name == 'random_low_rank':\n            selection = np.random.default_rng(seed + row * 37).permutation(reservoir).tolist()[:8]\n        else:\n            selection = sorted(reservoir, key=lambda index: (-variance[index], index))[:8]\n        for checkpoint_index, budget in enumerate(CHECKPOINTS):\n            observed = selection[:budget]\n            if name == 'column_mean':\n                predicted = means\n            elif name == 'copy_skill':\n                predicted = np.full(len(means), tests[row, observed].mean())\n            elif name == 'linear_ridge':\n                design = np.where(mask[:, observed], values[:, observed]-means[observed], 0)\n                coefficients = np.linalg.solve(.1*np.eye(budget) + design.T@design,\n                                               design.T @ np.where(mask, values-means, 0))\n                predicted = np.clip(means + (tests[row, observed]-means[observed]) @ coefficients, 0, 1)\n            else:\n                design = factors[observed]\n                latent = np.linalg.solve(.1*np.eye(factors.shape[1]) + design.T@design,\n                                         design.T @ (tests[row, observed]-means[observed]))\n                predicted = np.clip(means + factors @ latent, 0, 1)\n            losses[row, checkpoint_index] = error_pair(predicted, tests[row], target)[0]\n    return losses\n\n","exit_code":0,"status":"completed"}}
