r'}\n        if isinstance(context, ProtocolFailure):\n            return {'component': 'candidate', 'category': context.category, 'operation': context.operation}\n        context = context.__context__\n        if context is None:\n            break\n    return {'component': 'candidate', 'category': 'timeout',\n            'operation': bounded_failure_name(operation, 'unknown')}\n\n\ndef fail_required_baseline(category, cancel_work, record_failure):\n    failure = RequiredBaselineFailure(category)\n    try:\n        record_failure(failure.category)\n    except Exception:\n        failure.add_note('baseline diagnostic recording failed')\n    try:\n        cancel_work()\n    except Exception:\n        failure.add_note('baseline cleanup failed')\n    raise failure from None\n\n\ndef collect_required_baseline(result, *, deadline, clock, cancel_work, record_failure):\n    try:\n        remaining = deadline - clock()\n        if remaining <= 0:\n            raise TimeoutError()\n        value = result(timeout=remaining)\n        if clock() > deadline:\n            raise TimeoutError()\n        return value\n    except RequiredBaselineFailure:\n        raise\n    except (RuntimeError, TimeoutError) as error:\n        category = 'baseline_timeout' if isinstance(error, TimeoutError) else 'baseline_result_failure'\n        fail_required_baseline(category, cancel_work, record_failure)\n\n\ndef guard_required_baseline(call, failure_category, cancel_work, record_failure):\n    def check():\n        category = failure_category()\n        if category is not None:\n            fail_required_baseline(category, cancel_work, record_failure)\n    def guarded(request):\n        check()\n        value = call(request)\n        check()\n        return value\n    return guarded\n\n\nclass BoundedWorkerStderr:\n    LIMIT = 4096\n\n    def __init__(self, stream):\n        self.stream = stream\n        self.fd = stream.fileno()\n        os.set_blocking(self.fd, False)\n        self.lines = collections.deque()\n34:METRIC_NAMES = ['combined_score', 'mae', 'rmse', 'baseline_mae', 'delta_best_baseline', 'constant_control_mae', 'permuted_control_mae', 'reset_max_abs_delta', 'correct']\n44:    def __init__(self, category, operation):\n51:    def __init__(self, operation):\n60:def require_reset_ack(response):\n66:    def __init__(self, category):\n71:def bounded_failure_name(value, fallback):\n75:def describe_episode_failure(error, operation):\n91:def fail_required_baseline(category, cancel_work, record_failure):\n104:def collect_required_baseline(result, *, deadline, clock, cancel_work, record_failure):\n120:def guard_required_baseline(call, failure_category, cancel_work, record_failure):\n121:    def check():\n125:    def guarded(request):\n136:    def __init__(self, stream):\n152:    def _accept(self, chunk):\n178:    def _drain(self):\n203:    def close(self):\n218:def report_worker_exception(error):\n231:def cpu_limit_seconds(wall_seconds, allowed_threads):\n238:def finite_budget_seconds(value):\n244:def positive_work_seconds(value):\n250:def require_joint_workload_budget(*, search, final):\n267:def reserved_method_deadline(*, now, episode_deadline, methods_remaining, work_seconds, cleanup_seconds):\n279:def until(deadline):\n286:    def expired(signum, frame):\n299:def bounded_json_line(value, wire_limit=WIRE_LIMIT):\n306:def preflight_wire(columns):\n319:def candidate_subprocess_settings(parent_environment):\n340:def isolate():\n431:    def __init__(self, program, wall_seconds):\n470:    def start(self):\n487:    def shutdown(self):\n519:    def close(self):\n526:    def call(self, request, *, timeout):\n589:def record_failure(failure):\n602:def run_declared_episodes(episodes, *, hard_deadline, finish_reserve, reset_timeout, episode_overhead,\n617:        def call(request):\n666:def canonical(value):\n680:def digest(value):\n685:def extract(document):\n715:def load_resources():\n773:def ack(response, operation):\n778:def prediction(response, columns):\n788:def upload(call, values, mask):\n802:def arrays(rows, indices):\n808:def transformed_history(values, mask, case, seed):\n833:def fit_low_rank(values, mask, seed, sweeps):\n851:def partitions(rows, test_indices, seed):\n865:def error_pair(predicted, truth, indices):\n870:def run_baseline(name, values, mask, tests, partitions_for_rows, seed, sweeps):\n904:def worst_case(episode):\n911:def evaluate_episode(episode, call, work_deadline, *, rows, smoke):\n931:            def record_baseline_failure(category):\n970:def fixed_average(values):\n976:def aggregate(episodes, outcomes, complete):\n988:               'baseline_mae': baseline_mae, 'delta_best_baseline': baseline_mae-mae if complete else -1.0,\n995:        metrics['gain_ci_low'], metrics['gain_ci_high'] = -1.0, -1.0\n999:def bootstrap_gain(episodes, outcomes, rows):\n1020:def make_evaluation_evidence(episodes, outcomes, rows, seeds):\n1048:def write_outputs(directory, metrics, correct, feasible, evidence=None):\n1068:def main():\n1078:    metrics = {name: (-1.0 if name in ['delta_best_baseline', 'gain_ci_low', 'gain_ci_high'] else 1.0) for name in METRIC_NAMES}\n1112:                metrics['gain_ci_low'], metrics['gain_ci_high'] = bootstrap_gain(episodes, outcomes, rows)\n# Cross-fitted local residual medians\n\n## Scope and interface\n\n`program.py:handle` remains the only public entrypoint. No operation, response\nkey, score unit, bound, or budget is added. The full-history ALS fit and its\nrandom-number stream are unchanged. The covariance-gain selection code is\nunchanged. Only predictions on unqueried columns may receive corrections;\nqueried-column predictions retain the incumbent's behavior. A zero blend returns\nthe incumbent prediction exactly. Reset clears all fitted and trajectory state;\nbegin clears the current observations. Caches contain historical quantities,\nnever new-model scores.\n\n## Historical calibration\n\nAll calibration is inside `fit`, before any new-model observation. An independent\nseeded RNG samples at most 512 historical rows, with a column-dependent cap\ntargeting roughly 196608 cells (and a 64-row floor). Up to 16 rows having at least\nthree observed scores are allocated to two validation folds. Each validation\nfold is excluded from both its fitted predictor and every donor fit/pool.\n\nWithin each outer training pool, up to 128 historical donors are split into two\nfolds. Each donor fold is predicted by an ALS fit on the pool minus that entire\nfold. Non-donor training rows may be used by both fits. Auxiliary fits use the\nsame ALS/ridge estimator but at most 12 sweeps; this resource approximation does\nnot change the incumbent fit. Small histories without enough validation support\nreturn the unchanged incumbent.\n\nFor a queried column set, each donor's own available anchor scores condition its\ncross-fitted predictor. A residual is its actual observed target score minus\nthat clipped conditional prediction. Missing target cells remain missing;\nneither imputed targets nor the new model's predicted scores are donor labels.\nResidual matrices are cached for up to eight queried sets per bank.\n\nDistances are mean squared standardized differences on shared observed anchors.\nScales come only from each donor model's fitting rows, with a fixed 0.025 floor\nin normalized score units. Gaussian-kernel weights are multiplied by the shared\nanchor fraction; zero-overlap donors receive zero weight. Per target, only\nfinite observed residuals with positive weights enter the weighted median.\nEffective count is squared total weight divided by squared-weight sum, using a\n1e-12 numerical floor. The correction is median times\n`blend * effective_count / (effective_count + shrinkage)`. Negligible total\nweight leaves the base prediction unchanged. Final bounds remain [0, 1].\n\n## Predeclared selection and comparisons\n\nThe grid is bandwidth `(0.35, 0.75, 1.5)`, shrinkage `(4, 16)`, and blend\n`(0, 0.25, 0.5, 1)`. The incumbent selection policy is replayed on each held-out\nhistorical row, with only its revealed scores available to prediction. Only\nhistorically observed cells can be replayed as queries. Loss is pooled absolute\nerror on finite, unqueried targets at budgets 1, 2, 4, 8 where available; rows\nwith fewer observed cells cannot contribute every budget. All configurations\nshare fits, donor pools, query trajectories, and scored cells. Zero blend wins\nties, including differences within 1e-12. The chosen local configuration is then\nused with a freshly cross-fitted donor bank from the entire sampled history.\n\nPrivate diagnostic arrays also compare the unchanged base, unconditional\nresidual medians across the shrinkage/blend grid, and direct kernel-weighted\nhistorical score medians across bandwidths. They record correction coverage and\neffective counts on the same targets. These are training diagnostics, not an\nunbiased outer evaluation, and are never included in RPC responses.\n\n## Cost, limitations, and run status\n\nThere are at most eight auxiliary ALS fits beyond the unchanged full-history\nfit: two outer predictors, four inner donor fits, and two final donor fits.\nFinal donor fits are skipped when zero blend wins. A bank has at most 128 rows;\nconditional donor prediction is batched by anchor-observation pattern. Per-target\nweighted medians sort the usable donors. All operations use NumPy on CPU.\n\nApproximate auxiliary fits and history subsampling can mismatch the incumbent.\nSparse overlap, few held-out targets, nonrepresentative donors, extrapolation,\nand multiple-configuration selection can all hurt transfer. No improvement or\nconditional-median optimality for this residual-transfer estimator is guaranteed.\nOnly supplied history, opaque column indices, and actually revealed scores are\nused; no identities, target masks, families, or evaluator metadata are assumed.\n\nThis implementation stage permits filesystem editing and static inspection only.\nNo candidate execution, tests, experiments, evaluation, literature search, or\npaper compilation has been performed. No numerical research findings are\nreported. Outer uncertainty estimates, budget/missingness experiments, crossover\nablations, a conference-format paper, and full scientific reproduction artifacts\nremain incomplete; they are not fabricated or represented as completed work.\n18:fit fields rank (positive integer <=16), sweeps (positive integer <=50), ridge\n51:def _fit_residual_base(values, mask, rank, ridge, sweeps, rng):\n52:    rank = min(rank, *values.shape)\n57:    factors = rng.normal(0, .1, size=(values.shape[1], rank))\n58:    latent = np.zeros((values.shape[0], rank))\n59:    identity = ridge * np.eye(rank)\n60:    for sweep in range(sweeps):\n71:    return dict(means=means, factors=factors, ridge=ridge,\n78:    latent = np.linalg.solve(model['ridge'] * np.eye(factors.shape[1]) + design.T @ design,\n85:    covariance = np.linalg.inv(model['ridge'] * np.eye(factors.shape[1])\n105:        latent = np.linalg.solve(model['ridge'] * np.eye(design.shape[1]) + design.T @ design,\n112:                         rank, ridge, sweeps, rng):\n123:        model = _fit_residual_base(values[fit_rows], mask[fit_rows], rank, ridge, sweeps, rng)\n148:                      selected_indices, bandwidth):\n154:    neighbor_weights = np.exp(-0.5 * squared_distance / bandwidth ** 2)\n160:def _bank_weights(bank, selected_indices, observed_anchor_scores, bandwidth):\n163:                         fold['model']['scales'][selected_indices], selected_indices, bandwidth)\n174:def _correct_target(base_prediction, residuals, target_weights, blend_strength, shrinkage_strength):\n179:    correction_weight = blend_strength * effective_neighbors / (effective_neighbors + shrinkage_strength)\n198:def _prepare_residual_correction(values, mask, rank, ridge, sweeps, seed):\n201:    Predeclared local grid: bandwidth (.35, .75, 1.5), shrinkage (4, 16),\n202:    blend (0, .25, .5, 1). At most 512 rows / approximately 196608 cells,\n204:    Auxiliary ALS fits use at most 12 sweeps; the incumbent fit is untouched.\n208:    candidate_blends = (0.0, 0.25, 0.5, 1.0)\n209:    candidate_bandwidths = (0.35, 0.75, 1.5)\n210:    candidate_shrinkages = (4.0, 16.0)\n211:    inactive = dict(bank=None, blend=0.0, bandwidth=0.75, shrinkage=16.0, diagnostics={})\n222:    auxiliary_sweeps = min(sweeps, 12)\n223:    error_sums = np.zeros((len(candidate_bandwidths), len(candidate_shrinkages), len(candidate_blends)))\n224:    unconditional_errors = np.zeros((len(candidate_shrinkages), len(candidate_blends)))\n225:    direct_errors = np.zeros(len(candidate_bandwidths))\n227:    coverage_sum, effective_sum = np.zeros(len(candidate_bandwidths)), np.zeros(len(candidate_bandwidths))\n231:        model = _fit_residual_base(values[fit_rows], mask[fit_rows], rank, ridge, auxiliary_sweeps, rng)\n233:                                    rank, ridge, auxiliary_sweeps, rng)\n255:                for shrinkage_index, shrinkage_strength in enumerate(candidate_shrinkages):\n256:                    delta = unconditional_median * unconditional_count / (unconditional_count + shrinkage_strength)\n257:                    for blend_index, blend in enumerate(candidate_blends):\n258:                        prediction = np.clip(base_prediction + blend * delta, 0, 1)\n259:                        unconditional_errors[shrinkage_index, blend_index] += np.abs(prediction[targets] - truth).sum()\n260:                for bandwidth_index, bandwidth in enumerate(candidate_bandwidths):\n261:                    neighbor_weights = _bank_weights(bank, selected_indices, np.asarray(observed_scores), bandwidth)\n263:                    coverage_sum[bandwidth_index] += np.count_nonzero(effective_counts[targets])\n264:                    effective_sum[bandwidth_index] += effective_counts[targets].sum()\n267:                    direct_errors[bandwidth_index] += np.abs(direct_prediction[targets] - truth).sum()\n268:                    for shrinkage_index, shrinkage_strength in enumerate(candidate_shrinkages):\n269:                        delta = medians * effective_counts / (effective_counts + shrinkage_strength)\n270:                        for blend_index, blend in enumerate(candidate_blends):\n271:                            prediction = np.clip(base_prediction + blend * delta, 0, 1)\n272:                            error_sums[bandwidth_index, shrinkage_index, blend_index] += np.abs(\n276:    inner_mae = np.full(len(candidate_blends), np.inf)\n277:    best_parameters = [(0.75, 16.0)] * len(candidate_blends)\n278:    for bandwidth_index, bandwidth in enumerate(candidate_bandwidths):\n279:        for shrinkage_index, shrinkage_strength in enumerate(candidate_shrinkages):\n280:            errors = error_sums[bandwidth_index, shrinkage_index] / target_count\n281:            for blend_index, error in enumerate(errors):\n282:                if error < inner_mae[blend_index]:\n283:                    inner_mae[blend_index] = error\n284:                    best_parameters[blend_index] = (bandwidth, shrinkage_strength)\n287:    blend_strength = candidate_blends[int(np.argmin(inner_mae))]\n288:    bandwidth, shrinkage_strength = best_parameters[int(np.argmin(inner_mae))]\n289:    diagnostics = dict(base_mae=base_error / target_count, local_mae=inner_mae.tolist(),\n296:    if blend_strength > 0:\n298:                                    rank, ridge, auxiliary_sweeps, rng)\n299:    return dict(bank=bank, blend=blend_strength, bandwidth=bandwidth,\n300:                shrinkage=shrinkage_strength, diagnostics=diagnostics)\n304:    if not selected_indices or correction['blend'] == 0.0 or correction['bank'] is None:\n308:    neighbor_weights = _bank_weights(bank, selected_indices, np.asarray(observed_scores), correction['bandwidth'])\n316:                                               neighbor_weights[usable], correction['blend'], correction['shrinkage'])\n367:        rank = min(int(request['rank']), *values.shape)\n368:        ridge = float(request['ridge'])\n369:        sweeps = int(request['sweeps'])\n370:        if not 1 <= rank <= 16 or not 1 <= sweeps <= 50 or not math.isfinite(ridge) or ridge <= 0:\n376:        factors = _state['rng'].normal(0, .1, size=(values.shape[1], rank))\n377:        latent = np.zeros((values.shape[0], rank))\n378:        identity = ridge * np.eye(rank)\n379:        for sweep in range(sweeps):\n386:        _state.update(means=means, factors=factors, ridge=ridge)\n388:            values, mask, rank, ridge, sweeps, _state['residual_seed'])\n400:        covariance = np.linalg.inv(_state['ridge'] * np.eye(factors.shape[1]) + factors[observed].T @ factors[observed])\n418:        latent = np.linalg.solve(_state['ridge'] * np.eye(factors.shape[1]) + design.T @ design,\ntotal 8\ndrwx------ 2 agent agent 4096 Nov 17 13:22 .\ndrwx------ 5 agent agent 4096 Nov 17 13:29 ..\n@Article{Takács2008MatrixFA,\n author = {G. Takács and István Pilászy and B. Németh and D. Tikk},\n booktitle = {ACM Conference on Recommender Systems},\n pages = {267-274},\n title = {Matrix factorization and neighbor based algorithms for the netflix prize problem},\n year = {2008}\n}\n\n@Article{Ranjbar2015AnIM,\n author = {Manizheh Ranjbar and P. Moradi and Mostafa Azami and M. Jalili},\n booktitle = {Engineering applications of artificial intelligence},\n journal = {Eng. Appl. Artif. Intell.},\n pages = {58-66},\n title = {An imputation-based matrix factorization method for improving accuracy of collaborative filtering systems},\n volume = {46},\n year = {2015}\n}\n\n@Article{Awan2021ARE,\n author = {Mazhar Javed Awan and R. Khan and Haitham Nobanee and Awais Yasin and S. Anwar and Usman Naseem and Vishwa Pratap Singh},\n booktitle = {Electronics},\n journal = {Electronics},\n pages = {1215},\n title = {A Recommendation Engine for Predicting Movie Ratings Using a Big Data Approach},\n volume = {10},\n year = {2021}\n}\n\n@Article{Kannan2014BoundedMF,\n author = {Ramakrishnan Kannan a