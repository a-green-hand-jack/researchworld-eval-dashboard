{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re,collections\np=json.load(open('paper_data.json')); raw=collections.defaultdict(list)\nfor e in p['final_evaluation']['evaluation_evidence']['episodes']:\n for c in e['solution']['cases']:\n  if c['case']=='original':\n   for o in c['observations']:raw[(c['family'],o['target'],o['rule'],o['fraction'])].append(o)\nerrors=[]\ntext=open('paper.tex').read();family=None;rows=0\nfor line in text.splitlines():\n if 'Complete original decisions for HELM' in line:family='helm'\n if 'Complete original decisions for Open' in line:family='openllm'\n if re.match(r'\"'^'\"\\\\d+ & (Mean|Median|Borda) & ',line):\n  cells=[v.strip() for v in line.removesuffix(' \\\\\\\\\\\\\\\\').split('&')];target,rule,cap=int(cells[0]),cells[1].lower(),float(cells[2]); obs=raw[(family,target,rule,cap)];rows+=1\n  finite=obs[0]['allocation']['status']=='feasible'\n  if finite:\n   count=len(obs[0]['allocation']['tasks']); dim=57 if family=='helm' else 6\n   expected=[str(count),f'{count/dim:.3f}',str(obs[0]['reference']['lower']),str(obs[0]['reference']['upper']),str(len(obs[0]['baselines']['greedy']['tasks'])),str(min(len(o['baselines']['random']['tasks']) for o in obs)),str(max(len(o['baselines']['random']['tasks']) for o in obs))]\n  else:expected=['\"'$'\"\\\\\\\\infty\"'$'\"']*7\n  if cells[3:]\"'!=expected:errors.append((line,expected))\n  if not all(o['\"'validated'] and o['reference']['exact'] for o in obs):errors.append(('uncertified',family,target,rule,cap))\nprint('Supplement numerical rows',rows,'errors',errors)\nprint('Distinct original instances',len(raw))\nprint('Finite',sum(v[0]['allocation']['status']=='feasible' for v in raw.values()))\nprint('Reference closure',all(o['reference']['lower']==o['reference']['upper'] for v in raw.values() for o in v))\nprint('Allocation repeats',all(all(o['allocation']==v[0]['allocation'] for o in v) for v in raw.values()))\nprint('Meta source',json.load(open('derived/upstream_provenance.json')).keys())\nfor path in ['derived/local_audit.json','derived/witness_verification.json']:\n x=json.load(open(path));print(path,str(x)[:1800])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
