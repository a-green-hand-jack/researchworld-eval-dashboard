{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/sh -lc \"ls /usr/local/bin | rg 'patch|apply'; find / -name apply_patch -type f 2>/dev/null | head; sed -n '90,175p' scripts/build_artifacts.py; sed -n '233,276p' scripts/build_artifacts.py; head -45 .codex/skills/validate-paper/scripts/validate_figures.py; cat draft_reference_gaps.md; cat paper_strategy.json | head -65; cat claims_grounding.json | head -38\"","aggregated_output":"    plt.close(figure)\n\n\ndef main():\n    FIGURES.mkdir(exist_ok=True)\n    DERIVED.mkdir(exist_ok=True)\n    data = json.loads((ROOT / \"paper_data.json\").read_text())\n    evidence_refs = [\"paper_data.json#/best_correct/evaluation_evidence/episodes\",\n                     \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"]\n    rows = rows_for(data[\"best_correct\"], \"development\") + rows_for(data[\"final_evaluation\"], \"final\")\n    save_json(DERIVED / \"observations.json\", {\"rows\": rows})\n    provenance(DERIVED / \"observations.json\", evidence_refs)\n    summary = {\"cells\": {}, \"paired\": {}, \"scope\": \"descriptive; conditional on retained records\"}\n    for scope in [\"development\", \"final\"]:\n        for width in WIDTHS:\n            group = [row for row in rows if row[\"scope\"] == scope and row[\"width\"] == width and row[\"arm\"] == \"candidate\"]\n            if not group:\n                continue\n            values = np.array([row[\"accuracy\"] for row in group])\n            successes = sum(row[\"delayed_event\"] for row in group)\n            count = len(group)\n            interval = [0.0 if not successes else float(beta.ppf(.025, successes, count - successes + 1)),\n                        1.0 if successes == count else float(beta.ppf(.975, successes + 1, count - successes))]\n            summary[\"cells\"][scope + \"_\" + str(width)] = {\n                \"n\": count, \"seeds\": [row[\"seed\"] for row in group],\n                \"accuracy_mean\": float(values.mean()), \"accuracy_sd\": float(values.std(ddof=1)) if count > 1 else None,\n                \"accuracy_values\": values.tolist(), \"fit_values\": [row[\"fit\"] for row in group],\n                \"generalize_values\": [row[\"generalize\"] for row in group],\n                \"event_count\": successes, \"conditional_exact_95_interval\": interval,\n            }\n    for scope in [\"development\", \"final\"]:\n        for low, high in [(32, 128), (32, 256)]:\n            indexed = {(row[\"seed\"], row[\"width\"]): row for row in rows if row[\"scope\"] == scope and row[\"arm\"] == \"candidate\"}\n            seeds = sorted({seed for seed, width in indexed if width == low and (seed, high) in indexed})\n            if seeds:\n                summary[\"paired\"][f\"{scope}_{high}_minus_{low}\"] = {\n                    \"seeds\": seeds, \"accuracy_differences\": [indexed[seed, high][\"accuracy\"] - indexed[seed, low][\"accuracy\"] for seed in seeds],\n                    \"fit_differences\": [indexed[seed, high][\"fit\"] - indexed[seed, low][\"fit\"] for seed in seeds],\n                }\n    final_rows = [row for row in rows if row[\"scope\"] == \"final\" and row[\"arm\"] == \"candidate\"]\n    assert len(final_rows) == len({(row[\"seed\"], row[\"width\"]) for row in final_rows})\n    summary[\"final_available_cells\"] = len(final_rows)\n    summary[\"final_planned_cells\"] = len(data[\"final_evaluation\"][\"evaluation_evidence\"][\"episodes\"]) * len(WIDTHS)\n    summary[\"final_event_count\"] = sum(row[\"delayed_event\"] for row in final_rows)\n    summary[\"final_observed_endpoint_mean\"] = float(np.mean([row[\"accuracy\"] for row in final_rows]))\n    summary[\"qualification\"] = {key: data[\"final_evaluation\"][key] for key in [\"status\", \"outcome\", \"correct\"]}\n    summary[\"runtime_by_scope_seconds\"] = {scope: [episode[\"duration_seconds\"] for episode in data[key][\"evaluation_evidence\"][\"episodes\"]]\n                                                  for scope, key in [(\"development\", \"best_correct\"), (\"final\", \"final_evaluation\")]}\n    save_json(DERIVED / \"summary.json\", summary)\n    provenance(DERIVED / \"summary.json\", evidence_refs)\n    plt.rcParams.update({\"font.size\": 9, \"axes.labelsize\": 9, \"axes.titlesize\": 9,\n                         \"xtick.labelsize\": 8.5, \"ytick.labelsize\": 8.5,\n                         \"legend.fontsize\": 8.5, \"axes.spines.top\": False, \"axes.spines.right\": False,\n                         \"pdf.fonttype\": 42, \"ps.fonttype\": 42})\n    figure, axes = plt.subplots(1, 2, figsize=(5.5, 2.55), sharey=True)\n    for axis, scope, title in zip(axes, [\"development\", \"final\"], [\"(a) Development: 6,000 updates\", \"(b) Final: 24,000 updates\"]):\n        for position, width in enumerate(WIDTHS):\n            for arm_index, arm in enumerate(ARMS):\n                group = [row for row in rows if row[\"scope\"] == scope and row[\"width\"] == width and row[\"arm\"] == arm]\n                for seed_index, row in enumerate(group):\n                    offset = (arm_index - 1.5) * .17 + (seed_index - (len(group) - 1) / 2) * .035\n                    axis.scatter(position + offset, 100 * row[\"accuracy\"], s=23, marker=[\"o\", \"s\", \"v\", \"D\"][arm_index],\n                                 color=COLORS[arm_index], edgecolor=\"white\", linewidth=.35, zorder=3)\n            if scope == \"final\" and width == 256:\n                axis.text(position, 50, \"missing\\n3/3\", ha=\"center\", va=\"center\", fontsize=8.5, color=\"#555555\")\n            if scope == \"final\" and width == 128:\n                axis.text(position, 64, \"missing 1/3\", ha=\"center\", fontsize=8.5, color=\"#555555\")\n        axis.set(xlim=(-.5, 2.5), ylim=(-3, 104), xticks=range(3), xticklabels=WIDTHS, xlabel=\"Hidden width\", title=title)\n        axis.grid(axis=\"y\", color=\"#e7e7e7\", linewidth=.6, zorder=0)\n    axes[0].set_ylabel(\"Held-out accuracy (%)\")\n    legend = [plt.Line2D([], [], linestyle=\"none\", marker=marker, color=color, markersize=4.5, label=label)\n              for marker, color, label in zip([\"o\", \"s\", \"v\", \"D\"], COLORS, LABELS)]\n    figure.legend(handles=legend, loc=\"lower center\", ncol=4, frameon=False, handletextpad=.3, columnspacing=.7)\n    figure.subplots_adjust(left=.12, right=.99, bottom=.29, top=.87, wspace=.13)\n    export(figure, \"width_endpoint_comparison\", evidence_refs)\n    figure, axes = plt.subplots(1, 2, figsize=(5.5, 2.55), sharey=True)\n    for axis, scope, title in zip(axes, [\"development\", \"final\"], [\"(a) Development: H = 6,000\", \"(b) Final: H = 24,000\"]):\n        group = [row for row in rows if row[\"scope\"] == scope and row[\"arm\"] == \"candidate\"]\n        horizon = max(row[\"horizon\"] for row in group)\n        seeds = sorted({row[\"seed\"] for row in group})\n        for row in group:\n            vertical = WIDTHS.index(row[\"width\"]) + (seeds.index(row[\"seed\"]) - (len(seeds) - 1) / 2) * .16\n            axis.scatter(row[\"fit\"], vertical, color=COLORS[0], s=24, marker=\"o\", zorder=3)\n            if row[\"generalize\"] is not None:\n                axis.plot([row[\"fit\"], row[\"generalize\"]], [vertical, vertical], color=\"#aaaaaa\", linewidth=.8)\n                axis.scatter(row[\"generalize\"], vertical, color=COLORS[2], s=32, marker=\"*\", zorder=3)\n    target = DERIVED / \"final_records.tex\"\n    target.write_text(header + \"\\n\".join(table) + \"\\n\\\\bottomrule\\n\\\\end{tabular}\\n\")\n    provenance(target, [\"derived/observations.json\"], \"table\")\n    norm_table = [\"\\\\begin{tabular}{rrrrrr}\", \"\\\\toprule\", \"Seed & Width & Initial norm & Final norm & Train loss & Held-out loss \\\\\\\\\", \"\\\\midrule\"]\n    for row in final_rows:\n        norm_table.append(f'{row[\"seed\"]} & {row[\"width\"]} & {row[\"initial_norm\"]:.2f} & {row[\"final_norm\"]:.2f} & {row[\"train_loss\"]:.3g} & {row[\"evaluation_loss\"]:.3f} \\\\\\\\')\n    norm_table.extend([\"\\\\bottomrule\", \"\\\\end{tabular}\"])\n    target = DERIVED / \"norm_loss_records.tex\"\n    target.write_text(\"\\n\".join(norm_table) + \"\\n\")\n    provenance(target, [\"derived/observations.json\"], \"table\")\n    coverage_table = [r\"\\begin{tabular}{lccc}\", r\"\\toprule\", r\"Seed & Width 32 & Width 128 & Width 256 \\\\\", r\"\\midrule\"]\n    for episode in data[\"final_evaluation\"][\"evaluation_evidence\"][\"episodes\"]:\n        available = {record[\"width\"]: record for record in episode[\"solution\"][\"widths\"] if record is not None}\n        states = [\"M\" if width not in available else \"D\" if available[width][\"events\"][\"candidate\"][\"grokking\"] else \"C\" for width in WIDTHS]\n        coverage_table.append(str(episode[\"seed\"]) + \" & \" + \" & \".join(states) + r\" \\\\\")\n    coverage_table.extend([r\"\\bottomrule\", r\"\\end{tabular}\"])\n    target = DERIVED / \"coverage_table.tex\"\n    target.write_text(\"\\n\".join(coverage_table) + \"\\n\")\n    provenance(target, evidence_refs, \"table\")\n    development_table = [r\"\\begin{tabular}{lrrr}\", r\"\\toprule\", r\"Width & Parameters & Training-fit onsets & Held-out accuracy (\\%) \\\\\", r\"\\midrule\"]\n    for width in WIDTHS:\n        cell = summary[\"cells\"][\"development_\" + str(width)]\n        parameter_count = next(row[\"parameter_count\"] for row in rows if row[\"scope\"] == \"development\" and row[\"width\"] == width)\n        onsets = \"; \".join(f\"{value:,}\" for value in cell[\"fit_values\"])\n        accuracy = f'{100 * cell[\"accuracy_mean\"]:.2f}'\n        deviation = f'{100 * cell[\"accuracy_sd\"]:.2f}'\n        development_table.append(f'{width} & {parameter_count:,} & {onsets} & $' + accuracy + r\"\\pm\" + deviation + r\"$ \\\\\")\n    development_table.extend([r\"\\bottomrule\", r\"\\end{tabular}\"])\n    target = DERIVED / \"development_table.tex\"\n    target.write_text(\"\\n\".join(development_table) + \"\\n\")\n    provenance(target, evidence_refs + [\"derived/summary.json\"], \"table\")\n    source_manifest = {}\n    for source in sorted((ROOT / \"source_evidence\").rglob(\"*\")):\n        if source.is_file():\n            source_manifest[str(source.relative_to(ROOT))] = hashlib.sha256(source.read_bytes()).hexdigest()\n    save_json(DERIVED / \"source_manifest.json\", source_manifest)\n    assert source_manifest[\"source_evidence/task/evaluate_final.py\"] == data[\"final_evaluation\"][\"evaluator_sha256\"].removeprefix(\"sha256:\")\n    provenance(DERIVED / \"source_manifest.json\", [\"source_evidence/task/evaluate_final.py\", \"paper_data.json#/final_evaluation/evaluator_sha256\"])\n    print(json.dumps(summary, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n# Draft Reference Gap Analysis\n\n**Status:** `no_gaps`\n\nThe draft directly cites its relevant comparator families and optimizer background, while empirical claims are grounded in supplied artifacts, so no targeted post-draft reference retrieval is justified.\n\n## Coverage Assessment\n\n- **Introduction** (`paper.tex:21`): The definition and motivation of grokking directly cite Power. The width question and separated-timescale explanation are framed as this study's hypotheses, not established benchmark advantages. Related Work supplies the supporting capacity and dynamics context.\n- **Related Work — Algorithmic generalization and internal progress** (`paper.tex:40`): Power and Nanda are directly cited. The paragraph explicitly distinguishes the present embedding network from the cited Transformer analysis instead of transferring its mechanistic conclusions.\n- **Related Work — Norm, efficiency, and feature learning** (`paper.tex:43`): Liu, Varma, and Kumar directly cover the named comparator explanations. The draft states which diagnostics were not measured; additional mechanism references would not fill those experimental gaps.\n- **Related Work — Capacity and duration** (`paper.tex:46`): Davies and Nakkiran directly support the grokking/double-descent and nonmonotone-generalization context. Loshchilov and Hutter support AdamW's decoupled decay. No named comparator family in these paragraphs is left uncited.\n- **Method, Results, and Discussion and Limitations**: Architecture, controls, thresholds, observed outcomes, missingness, and qualification status are linked to supplied data or implementation evidence. These are not missing external benchmark citations. The conditional interpretation does not assert an established width law or validated causal mechanism.\n\n## Grounding and Scope\n\nReviewed `paper.tex`, `references.bib`, `references_provenance.json`, `claims_grounding.json`, `paper_data.json`, `paper_strategy.json`, and `global_memory_summary.md`. Global memory was treated as qualitative context, not quantitative evidence.\n\nAll eight cited keys resolve in the bibliography and have provenance entries. The eight literature-grounded claims have local evidence paths that exist. Provenance limits consultation to abstracts and opening text; this audit does not claim independent full-paper verification.\n\nThe strategy restricts literature consultation to eight authorized originals. A bibliography-size quota is not a substantive citation gap, and this assessment does not request broadening that scope. The decision also rests on the draft's actual paragraph-level coverage, not merely that restriction.\n\n## Retrieval Decision\n\n- **Missing literatures:** None warranting targeted retrieval.\n- **Rewrite targets:** None.\n- **Failure reason:** None; the draft is analyzable.\n\nOptional citations for standard statistical definitions would not materially improve the present positioning or comparator narrative. Missing experimental outcomes and qualification diagnostics require evidence, not more references. No references were retrieved, and the manuscript, bibliography, and reference provenance were left unchanged.\n{\n  \"status\": \"ready\",\n  \"selected_prompt_family\": \"paper_standalone\",\n  \"recommended_title\": \"Width and Delayed Generalization in Finite-Horizon Modular Addition\",\n  \"central_question\": \"How does hidden width relate to the separation between training-set fitting and held-out generalization in a fixed modular-addition network under finite training horizons and matched regularization controls?\",\n  \"central_thesis\": \"The retained comparisons show earlier fitting at larger widths without monotone short-horizon generalization, while two longer-horizon width-128 delayed events remain conditional observations rather than qualified evidence of a size law or a decay-clock mechanism.\",\n  \"narrative_rationale\": \"A conditional empirical study is supported by paired width, seed, and arm records, unlike a mechanistic explanation or a search-success story. The studied configuration has no sustained generalization onset in the short-horizon records, but two retained width-128 final records do have delayed onsets. Three final width-32 records remain censored and all final width-256 records are absent. Final evaluation completed but did not qualify. These facts support a coherent account of what this experiment establishes and leaves unidentified, not a universal claim about width, a causal horizon comparison, or superiority. Readiness means a supportable writing plan, not scientific qualification or a prediction of venue acceptance.\",\n  \"prior_paper_story_status\": \"rejected\",\n  \"edit_framing_decision\": \"No edit mode, prior manuscript, staged replacement implementation, or resolved edit-context file is present. The status value denotes rejection of an inherited untested mechanism story, not rejection of an existing paper. Choose a fresh conditional width-and-horizon framing from current records; do not inherit a decay-clock thesis from memory.\",\n  \"staged_input_impact\": [\n    \"No previous_paper, aggregated, extra_tasks, or edit-context inputs are present; there is no manuscript to preserve, broaden, or recenter.\",\n    \"Direct inspection of the local selected controller and evaluator establishes one fixed embedding-sum GELU architecture with common hyperparameters, not a new architecture or adaptive training method.\",\n    \"The final_evaluation block is independently decisive: completed but not_qualified, with five retained width-seed records and four missing records. It changes the framing from an optimization-success narrative to a conditional, incomplete-evidence study.\",\n    \"downstream_study and study.* grounding sources are absent. Do not invent campaign-level selection margins, scored/unscored counts, or a campaign baseline comparison. Use the configuration explicitly present in final records and the measured fixed-reference arms.\"\n  ],\n  \"method_groups\": [\n    {\n      \"name\": \"Common-configuration width sweep\",\n      \"role\": \"proposed\",\n      \"include_reason\": \"The studied condition uses learning rate 0.003, AdamW weight decay 1.0, and initialization multiplier 0.5 across widths 32, 128, and 256. Call it the studied configuration, not a novel optimizer or a proven winner. Final evidence exists only for widths 32 and 128.\"\n    },\n    {\n      \"name\": \"Fixed reference\",\n      \"role\": \"baseline\",\n      \"include_reason\": \"Retain the original measured comparison: learning rate 0.001, weight decay 1.0, initialization multiplier 1.0, same width/seed/split/horizon. It differs in both learning rate and initialization, so it is a reference rather than an isolated-component test. Compare only paired retained records and do not assert global validity after failed final qualification.\"\n    },\n    {\n      \"name\": \"Zero-weight-decay control\",\n      \"role\": \"ablation\",\n      \"include_reason\": \"Matches the studied learning rate, initialization, width, and split while setting decay to zero. Separates observed finite-horizon behavior with and without decay; it cannot establish that decay is universally necessary or that the delay is a decay clock.\"\n    },\n    {\n      \"name\": \"Matched-initial-global-norm control\",\n      \"role\": \"ablation\",\n      \"include_reason\": \"Globally rescales the initial parameters to the same-seed width-128 norm. Tests a limited initial-norm alternative, not complete capacity or functional matching. At width 128 this arm duplicates the studied condition, including retained hashes and scientific metric trajectories, so it is not an independent replication or an extra event.\"\n    }\n  ],\n  \"results_focus\": [\n    \"Lead with a complete final availability table: widths 32/128/256 by seeds 60613/70717/80821; observed records are 3/2/0 respectively. Explicitly disclose failed final qualification in the main text, not just the supplement.\",\n    \"Compare raw held-out endpoint accuracies across widths and the four arms within each evaluation setting. The studied short-horizon width-32 records have higher endpoint accuracy than widths 128 and 256 despite later fitting; do not turn this into a universal inverse-size law.\",\n    \"Compare fitting and sustained held-out onset directly, with censor arrows: short-horizon records at 6000 updates versus separately labeled final records at 24000. Final width-128 fitting/onset pairs are 300/17600 and 200/19200 updates; final width-32 fitting occurs at 2600, 2400, and 3000 with no observed held-out onset by 24000.\",\n    \"Use the fixed reference, zero-decay, and norm-matched arms as within-record controls. Retained final reference and zero-decay arms have no sustained held-out onset; the width-128 norm arm duplicates the studied event, not an additional result.\",\n    \"Treat the two horizons as separate evidence blocks under one question: data pools and seed sets also change. No same-seed, same-pool horizon intervention or causal claim that longer training reverses a width ranking is available.\",\n    \"The intended final width-256-minus-width-32 contrast and corresponding interactions are unidentified because width-256 records are absent; final paired_contrasts are null. Missing records are not zero accuracy observations, right-censored trajectories, or measured losses.\",\n    \"Show every seed value and paired differences where supported. Do not use checkpoints or examples as independent trials. Small-seed descriptive variation is the main uncertainty display; any additional uncertainty calculation must be derived reproducibly from retained data and labeled conditional on availability.\"\n  ],\n  \"figure_plan\": [\n    \"Figure 1: early overview of the modular-addition network, width/arm controls, and distinct observed-event/censored/missing evidence states; no speculative circuit or causal mechanism.\",\n    \"Figure 2: two aligned direct-comparison panels of raw endpoint held-out accuracy by width and four arms, one for short-horizon selection observations and one for final observations; preserve absent cells and separate cohorts.\",\n    \"Figure 3: two aligned onset-comparison panels for the studied configuration, showing training-fit and held-out-onset markers by width and seed, censoring at the relevant horizon, and missing final records without imputed times.\"\n  ],\n  \"figure_specs\": [\n    {\n      \"figure_id\": \"study_overview\",\n      \"required\": true,\n      \"purpose\": \"Make the fixed architecture, intervention scope, and evidence states legible before quantitative results.\",\n      \"figure_type\": \"diagram\",\n      \"preferred_generator\": \"generate-concept-figure\",\n      \"group_by\": \"experimental_condition\",\n      \"metric\": \"none; design and observation-state overview only\",\n      \"split_by\": \"matched design versus evidence interpretation\",\n      \"preferred_span\": \"full_width\",\n      \"target_width_fraction\": 1.0,\n      \"layout_rationale\": \"The inspected paper.sty is single-column, 5.5in text width and 9in text height. Use a 5.5 by about 1.5in two-block overview at full text width on page 1 or 2; a half-width rendering would make the four arm labels illegible. Allow about 0.22 body page including caption.\",\n      \"allow_progression\": false,\n{\n  \"claims\": [\n    {\n      \"claim\": \"The final evaluation completed, did not qualify, and has a false qualification decision; the supplied diagnostics do not identify the cause.\",\n      \"source_ids\": [\n        \"final.qualification.status\",\n        \"final.qualification.outcome\",\n        \"final.qualification.correct\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation\",\n        \"paper_data.json#/grounding_sources/final.qualification.outcome\"\n      ]\n    },\n    {\n      \"claim\": \"Five of nine planned final width-seed records are retained, with coverage 3/2/0 at widths 32/128/256; absent records are not measured non-events or accuracy losses.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"final.metric.complete_episode_fraction\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"The two retained width-128 studied final records show delayed events; all three width-32 held-out onsets are right-censored at 24000 updates.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"Development fitting onsets in seed order 101/211 are 2200/2800 at width32, 300/300 at width128, and 200/200 at width256.\",\n","exit_code":0,"status":"completed"}}
