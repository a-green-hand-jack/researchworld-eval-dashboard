{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,statistics\nfrom pathlib import Path\npaper=json.loads(Path('paper_data.json').read_text())\nepisodes=paper['final_evaluation']['evaluation_evidence']['episodes']\nprint('Final seeds:',[episode['seed'] for episode in episodes])\nprint('Complete cases:',sum(case['complete'] for episode in episodes for case in episode['solution']['cases']))\nfor method in episodes[0]['solution']['cases'][0]['methods']:\n    records=[record for episode in episodes for case in episode['solution']['cases'] for record in case['methods'][method]]\n    print(method, 'utility %.8f volume %.8f abs-error %.8f'%(statistics.mean(record['utility'] for record in records),statistics.mean(record['volume'] for record in records),statistics.mean(record['coverage_error'] for record in records)))\nprint('Case alpha=.10 means: method coverage / volume / utility')\nfor case_index,case in enumerate(episodes[0]['solution']['cases']):\n    print(case['case'])\n    for method in ['scaled_ilr','unscaled_ilr','simplex_linf','bonferroni']:\n        records=[episode['solution']['cases'][case_index]['methods'][method][1] for episode in episodes]\n        print(' ',method, *(round(statistics.mean(record[field] for record in records),6) for field in ['coverage','volume','utility']))\nprint('Uncertainty schema:')\nuncertainty=episodes[0]['solution']['seed_block_uncertainty']\nprint(json.dumps(uncertainty['DIR_SHIFT_K8'],indent=2)[:4000])\nprint('Search counts:',paper['totals'], 'downstream_study exists:', 'downstream_study' in paper)\nprint('Final trust:',paper['final_evaluation']['evaluation_evidence']['candidate_diagnostics_trust'])\nPY\njq '.episodes[0]|{keys:keys}' task/resources/final/manifest.json; ls /workspace; sed -n '105,190p' results/ideas/03_training_only_conformal_rank_scale_selection/program_1/src/program.py; sed -n '275,305p' results/ideas/03_training_only_conformal_rank_scale_selection/program_1/src/program.py; cat results/best_program_manifest.json; cat results/conclusions.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
