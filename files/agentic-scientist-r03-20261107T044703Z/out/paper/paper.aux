\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Direct comparisons under (a) MTEB model separation, (b) MTEB name-family separation, (c) Open LLM model separation, and (d) Open LLM name-family separation. Small dots show the three final seeds; diamonds show their means. Horizontal positions share the same explicitly restricted score axis. No dots are uncertainty intervals. Variance LF has the highest mean in each panel; the individual-seed reversal against Info ridge remains visible in panel (d).}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:main}{{2}{6}{Direct comparisons under (a) MTEB model separation, (b) MTEB name-family separation, (c) Open LLM model separation, and (d) Open LLM name-family separation. Small dots show the three final seeds; diamonds show their means. Horizontal positions share the same explicitly restricted score axis. No dots are uncertainty intervals. Variance LF has the highest mean in each panel; the individual-seed reversal against Info ridge remains visible in panel (d)}{figure.caption.6}{}}
