 ]\n    },\n    {\n      \"case\": \"nba-2013\",\n      \"counts\": [\n        1,\n        6,\n        13\n      ],\n      \"graph\": {\n        \"adjacent_min_gap\": 0.00892992314229879,\n        \"connected\": true,\n        \"edges\": 435,\n        \"minimum_degree\": 82,\n        \"participants\": 30\n      },\n      \"candidate_curves\": [\n        0.004597701149425287,\n        0.03218390804597701,\n        0.05747126436781609\n      ],\n      \"influence_errors\": [\n        0.0005496097160154941,\n        0.005739511948886358,\n        0.01958340523337434\n      ]\n    },\n    {\n      \"case\": \"nba-2014\",\n      \"counts\": [\n        1,\n        6,\n        13\n      ],\n      \"graph\": {\n        \"adjacent_min_gap\": 0.008863007866084849,\n        \"connected\": true,\n        \"edges\": 435,\n        \"minimum_degree\": 82,\n        \"participants\": 30\n      },\n      \"candidate_curves\": [\n        0.004597701149425287,\n        0.03218390804597701,\n        0.052873563218390804\n      ],\n      \"influence_errors\": [\n        0.0003574757208781135,\n        0.005233899641076284,\n        0.01723382492181961\n      ]\n    },\n    {\n      \"case\": \"nba-2015\",\n      \"counts\": [\n        1,\n        6,\n        13\n      ],\n      \"graph\": {\n        \"adjacent_min_gap\": 0.001751727007933468,\n        \"connected\": true,\n        \"edges\": 435,\n        \"minimum_degree\": 82,\n        \"participants\": 30\n      },\n      \"candidate_curves\": [\n        0.011494252873563218,\n        0.04367816091954023,\n        0.06666666666666667\n      ],\n      \"influence_errors\": [\n        0.0006218251324586531,\n        0.003691780916387418,\n        0.02273957819413045\n      ]\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
