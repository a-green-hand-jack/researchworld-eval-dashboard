ict or request.get(\"op\") not in _OPS:\n        raise ValueError(\"unknown op\")\n    return _OPS[request[\"op\"]](request)\nschema_version = 1\ncode_root = \"src\"\n\n[entrypoint]\npath = \"program.py\"\nlanguage = \"python\"\ntype = \"script\"\n\n[copy]\nexclude = [\n  \"**/__pycache__/**\",\n  \"**/*.pyc\",\n  \".venv/**\",\n  \"node_modules/**\",\n  \".git/**\",\n  \".mypy_cache/**\",\n  \".pytest_cache/**\",\n  \".ruff_cache/**\",\n  \".tox/**\",\n  \".nox/**\",\n  \"dist/**\",\n  \"build/**\",\n]\ninclude = [\n]\n\n[integration]\nkind = \"generic\"\nnotes = \"\"\n{\n  \"completed_at\": \"2026-11-11T14:08:16.189913+00:00\",\n  \"compute_usage\": {\n    \"elapsed_seconds\": 11763.894435166003,\n    \"max_rpc_calls\": 2200,\n    \"objective_counts\": \"advisory\",\n    \"outcome\": \"completed\",\n    \"rpc_calls\": 1804,\n    \"wall_clock_limit_seconds\": 21600\n  },\n  \"correct\": true,\n  \"declared_final_metrics\": [\n    \"combined_score\",\n    \"grok_delay_log_slope\",\n    \"grok_delay_slope_ci_low\",\n    \"grok_delay_slope_ci_high\",\n    \"reference_delay_log_slope\",\n    \"censored_fraction\",\n    \"control_max_val_acc\",\n    \"missing_episodes\"\n  ],\n  \"evaluation_evidence\": {\n    \"candidate_diagnostics_trust\": \"unverified\",\n    \"episode_count\": 4,\n    \"sha256\": \"sha256:4800c58351314db35ac5d143c6d14b0fda69279474f96351722c1f1945ea50de\",\n    \"status\": \"available\"\n  },\n  \"evaluator_sha256\": \"sha256:753e21b8c2a645a79d3c9ca2790b6561e8affe6bf868342781f886cdd0ff97d5\",\n  \"metrics\": {\n    \"censored_fraction\": 0.4,\n    \"combined_score\": 0.7292892858116026,\n    \"control_max_val_acc\": 0.012221041445270989,\n    \"grok_delay_log_slope\": -0.019806689033964053,\n    \"grok_delay_slope_ci_high\": 0.35416286029064337,\n    \"grok_delay_slope_ci_low\": -0.5845759292185315,\n    \"missing_episodes\": 0,\n    \"reference_delay_log_slope\": -0.3676456934115381\n  },\n  \"outcome\": \"qualified\",\n  \"program_tree_sha256\": \