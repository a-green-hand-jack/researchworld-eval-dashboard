_reference acc=5.738576 fit=700 onset=None\ndevelopment 101 128 initial_norm acc=31.934113 fit=300 onset=None\ndevelopment 101 128 zero_decay acc=0.000000 fit=200 onset=None\ndevelopment 101 256 candidate acc=36.875664 fit=200 onset=None\ndevelopment 101 256 fixed_reference acc=4.782147 fit=400 onset=None\ndevelopment 101 256 initial_norm acc=32.784272 fit=200 onset=None\ndevelopment 101 256 zero_decay acc=0.000000 fit=100 onset=None\ndevelopment 211 32 candidate acc=71.519660 fit=2800 onset=None\ndevelopment 211 32 fixed_reference acc=7.651435 fit=None onset=None\ndevelopment 211 32 initial_norm acc=56.163656 fit=3400 onset=None\ndevelopment 211 32 zero_decay acc=0.318810 fit=1600 onset=None\ndevelopment 211 128 candidate acc=26.726886 fit=300 onset=None\ndevelopment 211 128 fixed_reference acc=4.622742 fit=700 onset=None\ndevelopment 211 128 initial_norm acc=26.726886 fit=300 onset=None\ndevelopment 211 128 zero_decay acc=0.000000 fit=200 onset=None\ndevelopment 211 256 candidate acc=41.817216 fit=200 onset=None\ndevelopment 211 256 fixed_reference acc=10.255048 fit=400 onset=None\ndevelopment 211 256 initial_norm acc=41.232731 fit=200 onset=None\ndevelopment 211 256 zero_decay acc=0.000000 fit=100 onset=None\nfinal 60613 32 candidate acc=80.924548 fit=2600 onset=None\nfinal 60613 32 fixed_reference acc=59.351753 fit=9100 onset=None\nfinal 60613 32 initial_norm acc=67.747078 fit=3400 onset=None\nfinal 60613 32 zero_decay acc=0.478215 fit=1600 onset=None\nfinal 60613 128 candidate acc=98.352816 fit=300 onset=17600\nfinal 60613 128 fixed_reference acc=84.272051 fit=700 onset=None\nfinal 60613 128 initial_norm acc=98.352816 fit=300 onset=17600\nfinal 60613 128 zero_decay acc=0.000000 fit=200 onset=None\nfinal 70717 32 candidate acc=88.841658 fit=2400 onset=None\nfinal 70717 32 fixed_reference acc=54.569607 fit=11100 onset=None\nfinal 70717 32 initial_norm acc=50.797024 fit=4500 onset=None\nfinal 70717 32 zero_decay acc=0.743889 fit=1400 onset=None\nfinal 70717 128 candidate acc=97.768332 fit=200 onset=19200\nfinal 70717 128 fixed_reference acc=80.658874 fit=700 onset=None\nfinal 70717 128 initial_norm acc=97.768332 fit=200 onset=19200\nfinal 70717 128 zero_decay acc=0.000000 fit=200 onset=None\nfinal 80821 32 candidate acc=73.432519 fit=3000 onset=None\nfinal 80821 32 fixed_reference acc=65.037194 fit=9600 onset=None\nfinal 80821 32 initial_norm acc=70.828905 fit=3400 onset=None\nfinal 80821 32 zero_decay acc=0.797024 fit=1300 onset=None\nCOUNTS {'development': 6, 'final': 5} ERRORS []\nSOURCE HASH ffa76ecf0b9fd5f32b40654ccc774bfddaa408b5d276289c701507ca7fd32d06 sha256:ffa76ecf0b9fd5f32b40654ccc774bfddaa408b5d276289c701507ca7fd32d06\nPOOL search 4704 [('101', 2822, 1882), ('211', 2822, 1882)]\nPOOL final 4705 [('60613', 2823, 1882), ('70717', 2823, 1882), ('80821', 2823, 1882)]\nPOOL_OVERLAP 0\nDEVELOPMENT_MEAN_SD 32 74.68119022316685 4.4710790096280135\nDEVELOPMENT_MEAN_SD 128 29.330499468650373 3.6820650667524806\nDEVELOPMENT_MEAN_SD 256 39.34643995749203 3.494204604163066\n","exit_code":0,"status":"completed"}}
