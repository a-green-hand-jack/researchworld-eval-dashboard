{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/evaluate_final.py | sed -n '588,788p'\"","aggregated_output":"   588\tdef canonical_document(operation, first, second):\n   589\t    return json.dumps({\"operation\": operation, \"p\": 97, \"a\": first, \"b\": second},\n   590\t                      ensure_ascii=False, separators=(\",\", \":\"))\n   591\t\n   592\t\n   593\tdef raw_digest(operation, first, second):\n   594\t    import unicodedata\n   595\t    text = \" \".join(unicodedata.normalize(\"NFKC\", canonical_document(operation, first, second)).split())\n   596\t    return hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\n   597\t\n   598\t\n   599\tdef expected_rows(operation):\n   600\t    rows = [(raw_digest(operation, first, second), first, second)\n   601\t            for first in range(97) for second in range(97)]\n   602\t    rows.sort()\n   603\t    midpoint = len(rows) // 2\n   604\t    pool = rows[:midpoint] if PLANE == \"search\" else rows[midpoint:]\n   605\t    pool.sort(key=lambda row: hashlib.sha256((\"train-v1:\" + row[0]).encode()).digest())\n   606\t    training_count = len(pool) * 3 // 10\n   607\t    result = []\n   608\t    for index, (digest, first, second) in enumerate(pool):\n   609\t        label = (first + second if operation == \"addition\" else first - second) % 97\n   610\t        result.append({\"source_id\": operation + \"-\" + str(first * 97 + second),\n   611\t                       \"row\": first * 97 + second, \"a\": first, \"b\": second, \"label\": label,\n   612\t                       \"content_sha256\": digest, \"split\": \"train\" if index < training_count else \"heldout\"})\n   613\t    return result\n   614\t\n   615\t\n   616\tdef load_resource():\n   617\t    root = Path(os.environ.get(\"TASK_SOURCE_DIR\", Path(__file__).resolve().parent)) / \"resources\" / PLANE\n   618\t    path = root / \"benchmark.json\"\n   619\t    if path.is_symlink():\n   620\t        raise ValueError(\"resource symlink\")\n   621\t    data = json.loads(path.read_text())\n   622\t    if data[\"schema_version\"] != 1 or data[\"normalization\"] != \"nfkc-canonical-json-v1\":\n   623\t        raise ValueError(\"invalid raw normalization\")\n   624\t    for operation in (\"addition\", \"subtraction\"):\n   625\t        if data[\"examples\"][operation] != expected_rows(operation):\n   626\t            raise ValueError(\"raw content or split provenance mismatch\")\n   627\t        rows = data[\"examples\"][operation]\n   628\t        train = {row[\"content_sha256\"] for row in rows if row[\"split\"] == \"train\"}\n   629\t        test = {row[\"content_sha256\"] for row in rows if row[\"split\"] == \"heldout\"}\n   630\t        if train & test or len(train) + len(test) != len(rows):\n   631\t            raise ValueError(\"normalized content overlap\")\n   632\t    return data\n   633\t\n   634\t\n   635\tdef preflight():\n   636\t    request = {\"op\": \"recipe\", \"steps\": 20000, \"block_steps\": 500, \"min_lr\": .0001, \"max_lr\": .01}\n   637\t    responses = [{\"ok\": True}, {\"initial_lr\": .00010000000000000002, \"decay_rate\": .010000000000000002},\n   638\t                 {\"lr\": .00010000000000000002}]\n   639\t    messages = [request, {\"op\": \"reset\", \"seed\": 2**63 - 1},\n   640\t                {\"op\": \"schedule\", \"step\": 19500, \"steps\": 20000, \"block_steps\": 500}] + responses\n   641\t    for value in messages:\n   642\t        bounded_json_line(value, APPLICATION_LIMIT)\n   643\t        bounded_json_line({\"request\": value, \"response\": value, \"id\": 2**63 - 1,\n   644\t                           \"protocol\": \"python_rpc_v1\", \"metadata\": {\"encoding\": \"utf-8\"}})\n   645\t    operation_table = {\"reset\": 1, \"recipe\": 1, \"schedule\": 40,\n   646\t                       \"training_rpc\": 0, \"control_rpc\": 0, \"transfer_rpc\": 0, \"replay_rpc\": 0}\n   647\t    if sum(operation_table.values()) * 12 * len(SEEDS) != RPC_BUDGET:\n   648\t        raise ValueError(\"RPC operation table mismatch\")\n   649\t    require_joint_workload_budget(search={\"episode_count\": 24, \"method_count\": 1, \"wall_seconds\": 21600,\n   650\t        \"startup_seconds\": 900, \"reset_seconds\": 10, \"cleanup_seconds\": 4, \"finish_seconds\": 300,\n   651\t        \"work_seconds\": 750}, final={\"episode_count\": 36, \"method_count\": 1, \"wall_seconds\": 64800,\n   652\t        \"startup_seconds\": 1800, \"reset_seconds\": 10, \"cleanup_seconds\": 4, \"finish_seconds\": 300,\n   653\t        \"work_seconds\": 1600})\n   654\t\n   655\t\n   656\tdef make_episodes(smoke):\n   657\t    return [{\"operation\": operation, \"decay\": decay, \"width\": width, \"seed\": SEEDS[0] if smoke else seed}\n   658\t            for operation in (\"addition\", \"subtraction\") for decay in (0, 1)\n   659\t            for width in (16, 64, 256) for seed in ([SEEDS[0]] if smoke else SEEDS)]\n   660\t\n   661\t\n   662\tdef worst_case(episode, horizon=20000):\n   663\t    return {\"score\": 0.0, \"complete\": False, \"lag\": float(horizon), \"delayed\": 0.0,\n   664\t            \"gap\": -1.0, \"trace\": [], \"duration\": 0.0, \"memorization\": None, \"generalization\": None}\n   665\t\n   666\t\n   667\tdef run_declared_episodes(episodes, *, hard_deadline, finish_reserve, reset_timeout, episode_overhead,\n   668\t                          rpc_cap, clock, rpc, evaluate, worst_case, record_failure, outcomes=None):\n   669\t    candidate_deadline = hard_deadline - finish_reserve\n   670\t    reset_slot = reset_timeout + episode_overhead\n   671\t    if outcomes is None:\n   672\t        outcomes = [worst_case(episode) for episode in episodes]\n   673\t    if clock() + len(episodes) * reset_slot > candidate_deadline:\n   674\t        raise TimeoutError(\"insufficient declared reset reservations\")\n   675\t    complete = True\n   676\t    for index, episode in enumerate(episodes):\n   677\t        began = clock()\n   678\t        remaining = len(episodes) - index - 1\n   679\t        episode_deadline = candidate_deadline - remaining * reset_slot\n   680\t        work_deadline = episode_deadline - episode_overhead\n   681\t        current_operation = \"reset\"\n   682\t        primary_failure = None\n   683\t\n   684\t        def call(request):\n   685\t            nonlocal current_operation, primary_failure\n   686\t            current_operation = request.get(\"op\", \"unknown\")\n   687\t            try:\n   688\t                timeout = min(rpc_cap, work_deadline - clock())\n   689\t                if timeout <= 0:\n   690\t                    raise TimeoutError(\"episode work budget exhausted\")\n   691\t                return rpc(request, timeout=timeout)\n   692\t            except (TimeoutError, RequiredBaselineFailure, ProtocolError) as error:\n   693\t                if primary_failure is None:\n   694\t                    primary_failure = describe_episode_failure(error, current_operation)\n   695\t                raise\n   696\t\n   697\t        try:\n   698\t            timeout = min(reset_timeout, rpc_cap, work_deadline - clock())\n   699\t            if timeout <= 0:\n   700\t                raise TimeoutError(\"episode reset budget exhausted\")\n   701\t            require_reset_ack(rpc({\"op\": \"reset\", \"seed\": episode[\"seed\"]}, timeout=timeout))\n   702\t            value = evaluate(episode, call, work_deadline)\n   703\t            if clock() > episode_deadline:\n   704\t                raise TimeoutError(\"episode cleanup deadline exceeded\")\n   705\t            outcomes[index] = value\n   706\t        except (TimeoutError, RequiredBaselineFailure, InvalidResetResponse, ProtocolError) as error:\n   707\t            complete = False\n   708\t            failure = primary_failure or describe_episode_failure(error, current_operation)\n   709\t            record_failure(failure)\n   710\t        except BrokerTransportFailure as error:\n   711\t            try:\n   712\t                record_failure(describe_episode_failure(error, current_operation))\n   713\t            except Exception:\n   714\t                error.add_note(\"episode diagnostic recording failed\")\n   715\t            raise\n   716\t        finally:\n   717\t            outcomes[index][\"duration\"] = max(0.0, clock() - began)\n   718\t    return outcomes, complete\n   719\t\n   720\t\n   721\tdef first_sustained(trace, field, threshold):\n   722\t    for index in range(len(trace) - 2):\n   723\t        if all(row[field] >= threshold for row in trace[index:index + 3]):\n   724\t            return trace[index][\"step\"]\n   725\t    return None\n   726\t\n   727\t\n   728\tdef summarize_trace(trace, horizon):\n   729\t    if len(trace) < 5 or any(not finite_number(value) for row in trace for key, value in row.items() if key != \"controls\"):\n   730\t        raise RequiredBaselineFailure(\"baseline_result_failure\")\n   731\t    for row in trace:\n   732\t        if set(row[\"controls\"]) != set(CONTROLS) or any(not finite_number(value) or not 0 <= value <= 1\n   733\t                                                       for value in row[\"controls\"].values()):\n   734\t            raise RequiredBaselineFailure(\"baseline_result_failure\")\n   735\t    memorization = first_sustained(trace, \"train_accuracy\", .99)\n   736\t    generalization = first_sustained(trace, \"heldout_accuracy\", .95)\n   737\t    lag = horizon if memorization is None else max(0, (horizon if generalization is None else generalization) - memorization)\n   738\t    late = trace[-5:]\n   739\t    return {\"score\": statistics.fmean(row[\"heldout_accuracy\"] for row in late), \"complete\": True,\n   740\t            \"lag\": float(lag), \"delayed\": float(memorization is not None and generalization is not None and lag > 0),\n   741\t            \"gap\": statistics.fmean(row[\"heldout_accuracy\"] - row[\"controls\"][control]\n   742\t                                    for row in late for control in CONTROLS),\n   743\t            \"memorization\": memorization, \"generalization\": generalization, \"trace\": trace, \"duration\": 0.0}\n   744\t\n   745\t\n   746\tdef aggregate(episodes, outcomes, horizon):\n   747\t    correct = all(row[\"complete\"] for row in outcomes)\n   748\t    metrics = {\"combined_score\": statistics.fmean(row[\"score\"] for row in outcomes), \"correct\": int(correct)}\n   749\t    if PLANE == \"search\":\n   750\t        return metrics\n   751\t    seed_order = sorted(set(episode[\"seed\"] for episode in episodes))\n   752\t    def contrast(seed, decay):\n   753\t        values = []\n   754\t        for operation in (\"addition\", \"subtraction\"):\n   755\t            grouped = {}\n   756\t            for width in (16, 256):\n   757\t                grouped[width] = statistics.fmean(row[\"lag\"] for episode, row in zip(episodes, outcomes)\n   758\t                    if episode[\"seed\"] == seed and episode[\"operation\"] == operation\n   759\t                    and episode[\"decay\"] == decay and episode[\"width\"] == width)\n   760\t            values.append(grouped[16] - grouped[256])\n   761\t        return statistics.fmean(values)\n   762\t    contrasts = [contrast(seed, 1) for seed in seed_order]\n   763\t    center = statistics.fmean(contrasts)\n   764\t    radius = 2 * horizon if len(contrasts) < 2 else 4.302652729911275 * statistics.stdev(contrasts) / math.sqrt(len(contrasts))\n   765\t    metrics.update(completion_fraction=statistics.fmean(int(row[\"complete\"]) for row in outcomes),\n   766\t                   delayed_fraction=statistics.fmean(row[\"delayed\"] for row in outcomes),\n   767\t                   restricted_mean_lag=statistics.fmean(row[\"lag\"] for row in outcomes),\n   768\t                   width_lag_contrast=center,\n   769\t                   decay_interaction=center - statistics.fmean(contrast(seed, 0) for seed in seed_order),\n   770\t                   width_lag_ci_low=max(-horizon, center - radius),\n   771\t                   width_lag_ci_high=min(horizon, center + radius),\n   772\t                   control_gap=statistics.fmean(row[\"gap\"] for row in outcomes))\n   773\t    return metrics\n   774\t\n   775\t\n   776\tdef evidence(episodes, outcomes):\n   777\t    records = []\n   778\t    for seed in sorted(set(episode[\"seed\"] for episode in episodes)):\n   779\t        selected = [(episode, outcome) for episode, outcome in zip(episodes, outcomes) if episode[\"seed\"] == seed]\n   780\t        records.append({\"seed\": seed, \"score\": statistics.fmean(row[\"score\"] for _, row in selected),\n   781\t                        \"correct\": all(row[\"complete\"] for _, row in selected),\n   782\t                        \"duration_seconds\": sum(row[\"duration\"] for _, row in selected),\n   783\t                        \"solution\": [{\"case\": episode, \"observations\": {key: value for key, value in row.items()\n   784\t                                                                      if key != \"duration\"}}\n   785\t                                     for episode, row in selected]})\n   786\t    return {\"schema_version\": 1, \"episodes\": records}\n   787\t\n   788\t\n","exit_code":0,"status":"completed"}}
