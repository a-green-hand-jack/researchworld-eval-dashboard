\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Supplementary method comparison on original targets. Adaptive flips refit and relinearize after every new edit; frozen flips use the initial ordering. Deletion removes rows under the same sum-loss ridge estimator. ``Linear prediction'' is the frozen first-order cumulative-budget prediction, not a verified finite edit result. Counts across interventions are not exchangeable and do not reproduce published deletion experiments. Sources: \texttt  {artifacts/method\_comparison.csv} and \texttt  {artifacts/baseline.csv}; generated input: \texttt  {paper/tables/methods.tex}.}}{15}{table.7}\protected@file@percent }
\newlabel{tab:methods}{{7}{15}{Supplementary method comparison on original targets. Adaptive flips refit and relinearize after every new edit; frozen flips use the initial ordering. Deletion removes rows under the same sum-loss ridge estimator. ``Linear prediction'' is the frozen first-order cumulative-budget prediction, not a verified finite edit result. Counts across interventions are not exchangeable and do not reproduce published deletion experiments. Sources: \texttt {artifacts/method\_comparison.csv} and \texttt {artifacts/baseline.csv}; generated input: \texttt {paper/tables/methods.tex}}{table.7}{}}
\newlabel{eq:deletion}{{9}{15}{Adaptive flips and same-estimator deletion}{equation.9}{}}
