\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Illustration of sampling $x_{n+1}$ from a tokenized LM $P(t_{k+1}\mid t_1^k)$, continuing the example of Figure~\ref {fig:cover}. Cover encodings longer than $n$ are regrouped by their next byte (step 2), and the canonical encoding is extended by one LM call with accept/reject validity checks (step 3); the two groups are combined (step 4) before sampling (step 5). Probabilities $P({\bm  {t}})$ are omitted for simplicity.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:sampling}{{4}{7}{Illustration of sampling $x_{n+1}$ from a tokenized LM $P(t_{k+1}\mid t_1^k)$, continuing the example of Figure~\ref {fig:cover}. Cover encodings longer than $n$ are regrouped by their next byte (step 2), and the canonical encoding is extended by one LM call with accept/reject validity checks (step 3); the two groups are combined (step 4) before sampling (step 5). Probabilities $P(\vt )$ are omitted for simplicity}{figure.4}{}}
