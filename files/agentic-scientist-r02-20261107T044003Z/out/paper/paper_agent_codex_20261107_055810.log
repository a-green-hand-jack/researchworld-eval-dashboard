, episode_deadline=deadline,\n                        methods_remaining=0, work_seconds=work_seconds, cleanup_seconds=3)\n\n    def candidate_call(request):\n        return call(request, deadline=method_deadline)\n\n    training_transfer(candidate_call, covariates, training_y, basis)\n    locations, factors = prediction_transfer(candidate_call, query, dimension)\n    permutation = np.arange(min(16, len(query)))[::-1]\n    reordered_locations, reordered_factors = prediction_transfer(candidate_call, query[permutation], dimension)\n    subset = permutation[::3]\n    subset_locations, subset_factors = prediction_transfer(candidate_call, query[subset], dimension)\n    for actual, reference in ((reordered_locations, locations[permutation]),\n                              (reordered_factors, factors[permutation]),\n                              (subset_locations, locations[subset]), (subset_factors, factors[subset])):\n        if not np.allclose(actual, reference, rtol=1e-8, atol=1e-9):\n            raise ProtocolError('predictor is not fixed and row-wise')\n    completed.append('query_invariance')\n    parent = 'C2' if episode['case'] in ('C5', 'C6') else episode['case']\n    probe_rng = private_rng(datasets[(parent, episode['seed'])][2], 'volume_probes')\n    probes = probe_rng.dirichlet(np.ones(dimension + 1), size=(anchors, 128 if smoke else PROBES))\n    statistics = region_statistics('candidate', locations, factors, calibration_y, testing_y, basis,\n                                  probes, query, anchors, deadline)\n    references = {}\n    for method, values in methods.items():\n        references[method] = region_statistics(method, values, None, calibration_y, testing_y,\n                                               basis, probes, query, anchors, deadline)\n    start = len(calibration_y)\n    stop = start + len(testing_y)\n    controls = evaluator_controls(locations[start:stop], factors[start:stop], testing_y, basis, probes)\n    completed.extend(('point_copy', 'full_simplex'))\n    require_controls(expected, completed)\n    check_deadline(deadline)\n    paired_integration_se = {}\n    for method, reference in references.items():\n        differences = (reference['_volume_memberships'].astype(float)\n                       - statistics['_volume_memberships'].astype(float))\n        paired_integration_se[method] = float(np.sqrt(np.sum(np.var(differences, axis=1, ddof=1) / differences.shape[1])) / anchors)\n        del reference['_volume_memberships']\n    del statistics['_volume_memberships']\n    gaps = [statistics['coverage'] - references['euclidean']['coverage'],\n            references['euclidean']['volume'] - statistics['volume'],\n            statistics['coverage'] - references['ilr']['coverage'],\n            references['ilr']['volume'] - statistics['volume']]\n    record.update(complete=True, score=statistics['utility'], coverage=statistics['coverage'],\n                  volume=statistics['volume'], strata=statistics['strata'], gaps=gaps,\n                  details={'candidate': statistics, 'baselines': references, 'controls': controls,\n                           'completed_controls': completed, 'paired_volume_mc_se': paired_integration_se})\n    record['_prediction'] = (locations, factors)\n    return record\n\n\ndef fixed_weight_score(values, weights, worst_case):\n    if (not values or len(values) != len(weights)\n\"\"\"Standalone evaluator; all candidate measurements are reconstructed privately.\n\nFrozen resources include raw numeric SHA256 inventories before any ILR/features.\nCandidate/evaluator communication never conveys filesystem names or private targets.\n\"\"\"\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport os\nfrom pathlib import Path\nimport resource\nimport selectors\nimport shutil\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\n\nSTARTED = time.monotonic()\nCPU_IDS = sorted(os.sched_getaffinity(0))\nNATIVE_CPU_IDS = CPU_IDS[4:8] if len(CPU_IDS) >= 8 else CPU_IDS[:4]\nos.sched_setaffinity(0, CPU_IDS[:4])\nfor THREAD_NAME in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):\n    os.environ[THREAD_NAME] = '4'\nos.environ['PYTHONDONTWRITEBYTECODE'] = '1'\nimport numpy as np\n\nPLANE = 'final'\nSEEDS = [1009, 2027, 3049, 4051, 5059]\nCOUNTS = (4096, 2048, 3840)\nPROBES = 4096\nWALL_SECONDS = 3600\nRPC_BUDGET = 775\nMETRICS = ['combined_score', 'marginal_coverage', 'normalized_volume', 'worst_stratum_coverage', 'coverage_gap_vs_euclidean', 'volume_gain_vs_euclidean', 'coverage_gap_vs_ilr', 'volume_gain_vs_ilr']\nCHUNK = 1048576\nMAX_CHUNKS = 4\nWIRE_LIMIT = 8 * 1024 * 1024\nCASE_IDS = ('C1', 'C2', 'C3', 'C4', 'C5', 'C6')\nREPAIR = PLANE == 'search' and (os.environ.get('AGENTIC_TASK_QUALIFICATION') == '1'\n                              or os.environ.get('AGENTIC_TASK_DRAFT_SMOKE') == '1')\n\n\nclass ProtocolError(RuntimeError):\n    pass\n\n\nclass FatalTransportError(RuntimeError):\n    pass\n\n\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {'ok'} or response['ok'] is not True:\n        raise InvalidResetResponse('invalid reset response')\n\n\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"ReferenceProvenance\",\n  \"type\": \"object\",\n  \"required\": [\"generated_at\", \"count\", \"queries\", \"references\"],\n  \"properties\": {\n    \"generated_at\": {\"type\": \"string\"},\n    \"count\": {\"type\": \"integer\", \"minimum\": 0},\n    \"queries\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\"}\n    },\n    \"references\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"paper_id\", \"citation_key\", \"query\", \"source_url\"],\n        \"properties\": {\n          \"id\": {\"type\": \"string\"},\n          \"paper_id\": {\"type\": \"string\"},\n          \"citation_key\": {\"type\": \"string\"},\n          \"title\": {\"type\": [\"string\", \"null\"]},\n          \"year\": {\"type\": [\"integer\", \"null\"]},\n          \"venue\": {\"type\": [\"string\", \"null\"]},\n          \"citation_count\": {\"type\": [\"integer\", \"null\"]},\n          \"query\": {\"type\": \"string\"},\n          \"source_url\": {\"type\": \"string\"},\n          \"retrieved_at\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n# scientific-evidence\n\nThis is the canonical generated spec bundle for the `scientific-evidence` skill.\nUse the skill script as the source of truth for schemas, layout, and wording.\n\n## Scope\n\nThis contract is generic and file-format-agnostic.\nIt supports inline evidence refs in text-like files, adjacent `.prov.json` sidecars for generated artifacts, and a central JSONL ledger.\n\n## Why this exists\n\nThe point of `scientific-evidence` is to make an agent leave a machine-checkable trail for important numbers, figures, tables, and derived outputs.\nA paper or report should not depend on free-form prose alone when those claims can point back to real artifacts.\nAlways use this contract during paper writing whenever the agent adds manuscript numbers, table values, figure inputs, or derived statistics.\n\n## Fixed directory structure\n\n```text\nscientific-evidence/\n  spec.md\n  bundle.manifest.json\n  ledger.jsonl\n  schemas/\n    evidence-reference.schema.json\n    artifact-manifest.schema.json\n    ledger-entry.schema.json\n    verification-report.schema.json\n```\n\nAgents should use this layout exactly. Do not invent alternate bundle directories.\n\n## Grammar\n\n```text\nEvidenceRef   := '@evidence[[' Target [ '#' Locator ] ']]'\nTarget        := non-empty path | absolute path | URI | stable identifier\nLocator       := opaque fragment without closing ']]'\nSidecar       := '<artifact>.prov.json'\nLedger        := 'scientific-evidence/ledger.jsonl'\n```\n\n### Notes\n\n- `Target` stays generic. The verifier may classify it as `path`, `absolute-path`, `uri`, `id`, or `unknown`.\n- `Locator` is opaque unless a verifier adapter knows how to interpret it.\n- Text-like artifacts should use inline `@evidence[[...]]` refs. Binary or generated outputs should carry an adjacent `.prov.json` sidecar.\n\n### Minimal examples\n\n- `@evidence[[TARGET]]`\n- `@evidence[[TARGET#LOCATOR]]`\n- `figure.png.prov.json`\n\n## Verification behavior\n\nA verifier uses this bundle to inspect whether the agent left a connected evidence trail.\nThe base verifier uses three reference states:\n\n- `resolved`: the target exists and the verifier can validate the locator semantics it understands.\n- `anchored`: the target exists, but only path/hash checks were possible or the locator remained opaque.\n- `dangling`: the target does not resolve, the sidecar chain breaks, or the reference is malformed.\n\n### Minimum verifier expectations\n\n1. Resolve every inline evidence ref to a target path, URI, or id when possible.\n2. Mark each ref as `resolved`, `anchored`, or `dangling`.\n3. For manifests, require every `derived_from` edge to resolve to at least `anchored`.\n4. When hashes are recorded, compare them. Missing hashes are allowed.\n5. Do not pretend to interpret unknown locator grammars. Keep them `anchored` unless an adapter proves more.\n\n### What verification should prove\n\nAt a minimum, a downstream verifier should be able to:\n\n- scan text-like artifacts for `@evidence[[...]]` refs\n- read `.prov.json` sidecars for generated artifacts\n- resolve refs against real files or stable ids\n- classify each link as `resolved`, `anchored`, or `dangling`\n- fail when a generated artifact has no input trail or when a claimed source does not exist\n\nThis does not prove every scientific claim automatically. It proves whether the agent left enough structure for later auditing and stricter replay.\nA core paper-writing policy is: do not hardcode result numbers inside plotting or calculation scripts when those values should come from real artifacts. Read from files and leave matching `@evidence[[...]]` refs near the read or derivation logic.\n\n## Schema set\n\nThe generated bundle includes:\n\n- `schemas/evidence-reference.schema.json`\n- `schemas/artifact-manifest.schema.json`\n- `schemas/ledger-entry.schema.json`\n- `schemas/verification-report.schema.json`\n- `spec.md`\n- `bundle.manifest.json`\n- `ledger.jsonl`\n\n### Schema intent\n\n- `evidence-reference`: parsed form of one inline `@evidence[[...]]` token.\n- `artifact-manifest`: canonical sidecar schema for `<artifact>.prov.json`.\n","exit_code":0,"status":"completed"}}
