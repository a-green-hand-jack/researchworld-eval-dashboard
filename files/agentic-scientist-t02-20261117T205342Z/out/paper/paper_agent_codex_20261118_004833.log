nAPPLICATION_LIMIT = 16384\nCONTROLS = (\"constant\", \"copy\", \"deranged\", \"initial\")\nFINAL_METRICS = (\"combined_score\", \"correct\", \"completion_fraction\", \"delayed_fraction\",\n                 \"restricted_mean_lag\", \"width_lag_contrast\", \"decay_interaction\",\n                 \"width_lag_ci_low\", \"width_lag_ci_high\", \"control_gap\")\n\n\nclass InvalidResetResponse(RuntimeError):\n    pass\n\n\ndef require_reset_ack(response):\n    if type(response) is not dict or set(response) != {\"ok\"} or response[\"ok\"] is not True:\n        raise InvalidResetResponse(\"invalid reset response\")\n\n\ndef bounded_failure_name(value, fallback):\n    import re\n    return value if isinstance(value, str) and re.fullmatch(r\"[a-z][a-z0-9_]{0,79}\", value) else fallback\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n129:            errors.append(f\"references[{idx}].citation_key missing\")\n131:        if citation_key in provenance_keys:\n133:                f\"references[{idx}].citation_key duplicates existing key: {citation_key!r}\"\n135:        provenance_keys.add(citation_key)\n137:    missing_in_provenance = sorted(bib_keys - provenance_keys)\n138:    if missing_in_provenance:\n140:            \"references.bib keys missing from references_provenance.json: \"\n141:            + \", \".join(repr(key) for key in missing_in_provenance)\n144:    missing_in_bib = sorted(provenance_keys - bib_keys)\n147:            \"references_provenance.json keys missing from references.bib: \"\n151:    return provenance_ids, errors\n458:        token = item.get(\"raw_reference\") or item.get(\"target\") or \"<unknown-token>\"\n468:        \"until zero dangling references remain.\"\n499:        required_strings = (\"subject_path\", \"subject_kind\", \"raw_reference\", \"target\", \"status\")\n519:        summary[\"total_references\"] == len(results)\n520:        and summary[\"resolved_references\"] == statuses.count(\"resolved\")\n521:        and summary[\"anchored_references\"] == statuses.count(\"anchored\")\n522:        and summary[\"dangling_references\"] == statuses.count(\"dangling\")\n567:        has_dangling = summary[\"dangling_references\"] > 0\n571:                \"dangling reference count\"\n584:    parser.add_argument(\"--references\", required=True, help=\"references_provenance.json\")\n585:    parser.add_argument(\"--bib\", required=True, help=\"references.bib\")\n602:    references = read_json(Path(args.references))\n606:        raise SystemExit(\"No citation keys found in BibTeX file.\")\n613:    provenance_ids, reference_errors = validate_reference_provenance(\n614:        references_payload=references,\n617:    allowed_sources.update(provenance_ids)\n640:        citation_keys = row.get(\"citation_keys\", [])\n641:        if not isinstance(citation_keys, list):\n642:            errors.append(f\"claims[{idx}].citation_keys must be list\")\n644:            for citation_key in citation_keys:\n645:                if not isinstance(citation_key, str) or citation_key not in bib_keys:\n646:                    errors.append(f\"claims[{idx}] unknown citation key: {citation_key!r}\")\n650:    errors = [*reference_errors, *errors, *evidence_errors]\n655:        f\"Validated {len(claim_rows)} grounded claims and {len(provenance_ids)} provenance references.\"\n%%%% ICLR Macros (LaTex)\n%%%% Adapted by Hugo Larochelle from the NIPS stylefile Macros\n%%%% Style File\n%%%% Dec 12, 1990   Rev Aug 14, 1991; Sept, 1995; April, 1997; April, 1999; October 2014\n\n% This file can be used with Latex2e whether running in main mode, or\n% 2.09 compatibility mode.\n%\n% If using main mode, you need to include the commands\n%             \\documentclass{article}\n%             \\usepackage{iclr14submit_e,times}\n%\n\n% Change the overall width of the page.  If these parameters are\n%       changed, they will require corresponding changes in the\n%       maketitle section.\n%\n\\usepackage{eso-pic} % used by \\AddToShipoutPicture\n\\RequirePackage{fancyhdr}\n\\RequirePackage{natbib}\n\n% modification to natbib citations\n\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n\n\\renewcommand{\\topfraction}{0.95}   % let figure take up nearly whole page\n\\renewcommand{\\textfraction}{0.05}  % let figure take up nearly whole page\n\n% Define iclrfinal, set to true if iclrfinalcopy is defined\n\\newif\\ificlrfinal\n\\iclrfinalfalse\n\\def\\iclrfinalcopy{\\iclrfinaltrue}\n\\font\\iclrtenhv  = phvb at 8pt\n\n% Specify the dimensions of each page\n\n\\setlength{\\paperheight}{11in}\n\\setlength{\\paperwidth}{8.5in}\n\n\n\\oddsidemargin .5in    %   Note \\oddsidemargin = \\evensidemargin\n\\evensidemargin .5in\n\\marginparwidth 0.07 true in\n%\\marginparwidth 0.75 true in\n%\\topmargin 0 true pt           % Nominal distance from top of page to top of\n%\\topmargin 0.125in\n\\topmargin -0.625in\n\\addtolength{\\headsep}{0.25in}\n\\textheight 9.0 true in       % Height of text (including footnotes & figures)\n\\textwidth 5.5 true in        % Width of text line.\n\\widowpenalty=10000\n\\clubpenalty=10000\n\n% \\thispagestyle{empty}        \\pagestyle{empty}\n\\flushbottom \\sloppy\n\n% We're never going to need a table of contents, so just flush it to\n% save space --- suggested by drstrip@sandia-2\n\\def\\addcontentsline#1#2#3{}\n\n% Title stuff, taken from deproc.\n","exit_code":0,"status":"completed"}}
