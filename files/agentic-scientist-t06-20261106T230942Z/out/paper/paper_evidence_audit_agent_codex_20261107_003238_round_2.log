{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/flip_search.py | sed -n '194,309p'\"","aggregated_output":"   194\t\n   195\t\n   196\tdef _select_flips(model, theta, counts, contrast, baseline_factor):\n   197\t    participants = model.participants\n   198\t    baseline_rank = np.lexsort((np.arange(participants), -theta[:participants]))\n   199\t    baseline_position = np.empty(participants, dtype=int)\n   200\t    baseline_position[baseline_rank] = np.arange(participants)\n   201\t    first_position, second_position = np.triu_indices(participants, 1)\n   202\t    upper = baseline_rank[first_position]\n   203\t    lower = baseline_rank[second_position]\n   204\t    covariance = cho_solve(baseline_factor, np.eye(model.dimension), check_finite=False)\n   205\t    variance = covariance[upper, upper] + covariance[lower, lower] - 2 * covariance[upper, lower]\n   206\t    scale = np.maximum(.25 * np.sqrt(np.maximum(variance, 0)), 1e-4)\n   207\t    baseline_direction = cho_solve(baseline_factor, contrast, check_finite=False)\n   208\t    baseline_gain = (1 - 2 * model.data[:, 2]) * model.project(baseline_direction)[model.inverse]\n   209\t    eligible_rows = np.flatnonzero(model.data[:, 2] != .5)\n   210\t    fixed_order = eligible_rows[np.lexsort((eligible_rows, -baseline_gain[eligible_rows]))]\n   211\t\n   212\t    def quality(current_theta):\n   213\t        current_rank = np.lexsort((np.arange(participants), -current_theta[:participants]))\n   214\t        current_position = np.empty(participants, dtype=int)\n   215\t        current_position[current_rank] = np.arange(participants)\n   216\t        displacement = int(np.abs(current_position - baseline_position).sum())\n   217\t        inversions = int((current_position[upper] > current_position[lower]).sum())\n   218\t        potential = float(expit((current_theta[lower] - current_theta[upper]) / scale).sum())\n   219\t        return np.array([displacement, inversions, potential])\n   220\t\n   221\t    initial = {\"flipped\": model.empty, \"theta\": theta, \"rows\": np.empty(0, dtype=int),\n   222\t               \"quality\": np.zeros(3), \"count\": 0}\n   223\t    fixed = initial\n   224\t    beam = [initial]\n   225\t\n   226\t    for count in counts:\n   227\t        fixed_rows = fixed_order[:count]\n   228\t        fixed_types = (2 * model.inverse[fixed_rows]\n   229\t                       + (model.data[fixed_rows, 2] == 1).astype(int))\n   230\t        fixed_counts = np.bincount(fixed_types, minlength=len(model.capacity))\n   231\t        fixed_theta = model.fit(fixed_counts, initial=fixed[\"theta\"]) if count != fixed[\"count\"] else fixed[\"theta\"]\n   232\t        fixed = {\"flipped\": fixed_counts, \"theta\": fixed_theta, \"rows\": fixed_rows,\n   233\t                 \"quality\": fixed[\"quality\"] + quality(fixed_theta), \"count\": count}\n   234\t        candidates = [fixed]\n   235\t        for node in beam:\n   236\t            factor = cho_factor(model.hessian(node[\"theta\"]), lower=True, check_finite=False)\n   237\t            inverse_hessian = cho_solve(factor, np.eye(model.dimension), check_finite=False)\n   238\t            current_variance = (inverse_hessian[upper, upper] + inverse_hessian[lower, lower]\n   239\t                                - 2 * inverse_hessian[upper, lower])\n   240\t            gap = node[\"theta\"][upper] - node[\"theta\"][lower]\n   241\t            priority = gap / np.sqrt(np.maximum(current_variance, 1e-12))\n   242\t            unresolved = np.flatnonzero(gap >= 0)\n   243\t            nearest = unresolved[np.argsort(priority[unresolved], kind=\"stable\")[:6]]\n   244\t            directions = [baseline_direction, cho_solve(factor, contrast, check_finite=False)]\n   245\t            for pair_index in nearest:\n   246\t                directions.append(inverse_hessian[:, lower[pair_index]] - inverse_hessian[:, upper[pair_index]])\n   247\t            proposed_counts = []\n   248\t            for direction in directions:\n   249\t                flipped, rows = model.propose(node[\"flipped\"], direction, count - node[\"count\"])\n   250\t                if any(np.array_equal(flipped, previous) for previous in proposed_counts):\n   251\t                    continue\n   252\t                proposed_counts.append(flipped)\n   253\t                current_theta = model.fit(flipped, initial=node[\"theta\"]) if len(rows) else node[\"theta\"]\n   254\t                candidates.append({\"flipped\": flipped, \"theta\": current_theta,\n   255\t                                   \"rows\": np.concatenate((node[\"rows\"], rows)),\n   256\t                                   \"quality\": node[\"quality\"] + quality(current_theta), \"count\": count})\n   257\t        candidates.sort(key=lambda node: tuple(node[\"quality\"]), reverse=True)\n   258\t        beam = []\n   259\t        for candidate in candidates:\n   260\t            if any(np.array_equal(candidate[\"rows\"], previous[\"rows\"]) for previous in beam):\n   261\t                continue\n   262\t            beam.append(candidate)\n   263\t            if len(beam) == 2:\n   264\t                break\n   265\t    incumbent_path = max(beam + [fixed], key=lambda node: tuple(node[\"quality\"]))[\"rows\"]\n   266\t    return _refine_flip_path(model, incumbent_path, counts, theta, baseline_factor,\n   267\t                             quality, upper, lower, scale)\n   268\t\n   269\t\n   270\tclass _PathSearchExhausted(RuntimeError):\n   271\t    pass\n   272\t\n   273\t\n   274\tdef _verify_checkpoint_locality():\n   275\t    current_path = [0, 1, 2, 3]\n   276\t    checkpoints = [1, 2, 2, 4]\n   277\t\n   278\t    def full_checkpoint_keys(path):\n   279\t        return {budget: tuple(sorted(path[:budget])) for budget in checkpoints}\n   280\t\n   281\t    current_keys = full_checkpoint_keys(current_path)\n   282\t    for left in range(len(current_path)):\n   283\t        for right in range(left + 1, len(current_path)):\n   284\t            proposal_path = current_path.copy()\n   285\t            proposal_path[left], proposal_path[right] = proposal_path[right], proposal_path[left]\n   286\t            affected_checkpoints = [budget for budget in checkpoints if left < budget <= right]\n   287\t            local_keys = current_keys.copy()\n   288\t            for budget in affected_checkpoints:\n   289\t                local_keys[budget] = tuple(sorted(proposal_path[:budget]))\n   290\t            full_keys = full_checkpoint_keys(proposal_path)\n   291\t            assert local_keys == full_keys\n   292\t            assert set(affected_checkpoints) == {\n   293\t                budget for budget in checkpoints if current_keys[budget] != full_keys[budget]\n   294\t            }\n   295\t    for position in range(len(current_path)):\n   296\t        replacement_row = 4\n   297\t        proposal_path = current_path.copy()\n   298\t        proposal_path[position] = replacement_row\n   299\t        affected_checkpoints = [budget for budget in checkpoints if budget > position]\n   300\t        local_keys = current_keys.copy()\n   301\t        for budget in affected_checkpoints:\n   302\t            local_keys[budget] = tuple(sorted(proposal_path[:budget]))\n   303\t        full_keys = full_checkpoint_keys(proposal_path)\n   304\t        assert local_keys == full_keys\n   305\t        assert set(affected_checkpoints) == {\n   306\t            budget for budget in checkpoints if current_keys[budget] != full_keys[budget]\n   307\t        }\n   308\t\n   309\t\n","exit_code":0,"status":"completed"}}
