{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nfrom collections import Counter\nfrom pathlib import Path\npaper=json.loads(Path('paper_data.json').read_text())\nrecords={}\nfor seed in paper['final_evaluation']['evaluation_evidence']['episodes']:\n    for episode in seed['solution']['episodes']:\n        if episode['condition']\"'!='\"'normal' or episode['replay']:\n            continue\n        for checkpoint in episode['checkpoints']:\n            counts=Counter(checkpoint['lineage_groups'])\n            weights=[1/(len(counts)*counts[group]) for group in checkpoint['lineage_groups']]\n            truth=checkpoint['references']\n            mae=sum(weight*abs(prediction-reference) for weight,prediction,reference in zip(weights,checkpoint['predictions'],truth))\n            irt=sum(weight*abs(prediction-reference) for weight,prediction,reference in zip(weights,checkpoint['baseline_predictions']['irt_mae'],truth))\n            records.setdefault(episode['case'],{}).setdefault(checkpoint['budget'],[]).append((mae,irt))\nprint('Diagnostic postprocessing only: candidate / local IRT MAE, across-seed means')\nfor case,budgets in records.items():\n    print(case, {budget:[round(sum(value[index] for value in values)/len(values),5) for index in (0,1)] for budget,values in budgets.items()})\nprint('Frozen-manifest scope:')\nfor case in records:\n    manifest=json.loads(Path(f'task/resources/final/{case}_manifest.json').read_text())\n    print(case, {key:manifest.get(key) for key in ('shape','normalization','limitations','lineage_policy','duplicate_provenance_rows')})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
