{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AKP8k6G3JqJ9MUySpywBf3","type":"tool_result","content":"@Article{Davidson1970OnET,\n author = {R. Davidson},\n journal = {Journal of the American Statistical Association},\n pages = {317-328},\n title = {On Extending the Bradley-Terry Model to Accommodate Ties in Paired Comparison Experiments},\n volume = {65},\n year = {1970}\n}\n\n@Article{Simons1999AsymptoticsWT,\n author = {G. Simons and Yi-Ching Yao},\n journal = {Annals of Statistics},\n pages = {1041-1060},\n title = {Asymptotics when the number of parameters tends to infinity in the Bradley-Terry model for paired comparisons},\n volume = {27},\n year = {1999}\n}\n\n@Article{Davidson1977OnET,\n author = {R. Davidson and R. Beaver},\n journal = {Biometrics},\n pages = {693},\n title = {On Extending the Bradley-Terry Model to Incorporate Within-Pair Order Effects},\n volume = {33},\n year = {1977}\n}\n\n@Article{Gao2021UncertaintyQI,\n author = {Chao Gao and Yandi Shen and A. Zhang},\n booktitle = {Information and Inference A Journal of the IMA},\n journal = {Information and Inference: A Journal of the IMA},\n title = {Uncertainty quantification in the Bradley–Terry–Luce model},\n year = {2021}\n}\n\n@Article{Leonard1977AnAB,\n author = {Tom Leonard},\n journal = {Biometrics},\n pages = {121},\n title = {An Alternative Bayesian Approach to the Bradley-Terry Model for Paired Comparisons},\n volume = {33},\n year = {1977}\n}\n\n@Article{Davidson1969MultivariatePC,\n author = {R. Davidson and R. Bradley},\n journal = {Biometrika},\n pages = {81-95},\n title = {Multivariate paired comparisons: The extension of a univariate model and associated estimation and test procedures},\n volume = {56},\n year = {1969}\n}\n\n@Article{Yan2011GROUPEDSP,\n author = {T. Yan and Yaning Yang and Jin-Feng Xu},\n journal = {arXiv: Other Statistics},\n title = {GROUPED SPARSE PAIRED COMPARISONS IN THE BRADLEY-TERRY MODEL},\n year = {2011}\n}\n\n@Article{Causeur2005A2E,\n author = {D. Causeur and F. Husson},\n journal = {Journal of Statistical Planning and Inference},\n pages = {245-259},\n title = {A 2-dimensional extension of the Bradley–Terry model for paired comparisons},\n volume = {135},\n year = {2005}\n}\n\n@Article{Bong2021GeneralizedRF,\n author = {Heejong Bong and A. Rinaldo},\n booktitle = {International Conference on Machine Learning},\n pages = {2160-2177},\n title = {Generalized Results for the Existence and Consistency of the MLE in the Bradley-Terry-Luce Model},\n year = {2021}\n}\n\n@Article{Stern2011ModeratedPC,\n author = {Steven E. Stern},\n journal = {Journal of the Royal Statistical Society: Series C (Applied Statistics)},\n title = {Moderated paired comparisons: a generalized Bradley–Terry model for continuous data using a discontinuous penalized likelihood function},\n volume = {60},\n year = {2011}\n}\n\n@Article{Fageot2023GeneralizedBM,\n author = {J. Fageot and Sadegh Farhadkhani and Lê-Nguyên Hoang and Oscar Villemaud},\n booktitle = {AAAI Conference on Artificial Intelligence},\n pages = {20379-20386},\n title = {Generalized Bradley-Terry Models for Score Estimation from Paired Comparisons},\n year = {2023}\n}\n\n@Article{Genest1999DerivingPF,\n author = {C. Genest and C. E. M'lan},\n journal = {Mathematical and Computer Modelling},\n pages = {87-102},\n title = {Deriving priorities from the Bradley-Terry model},\n volume = {29},\n year = {1999}\n}\n\n@Article{Butler2004TheEO,\n author = {K. Butler and J. Whelan},\n journal = {arXiv: Statistics Theory},\n title = {The existence of maximum likelihood estimates in the Bradley-Terry model and its extensions},\n year = {2004}\n}\n\n@Article{Tian2023ASA,\n author = {Xinyu Tian and Jian Shi and Xiao-Tong T. Shen and Kai Song},\n booktitle = {Stat},\n journal = {Stat},\n title = {A spectral approach for the dynamic Bradley–Terry model},\n volume = {13},\n year = {2023}\n}\n\n@Article{Makur2024MinimaxHT,\n author = {A. Makur and Japneet Singh},\n booktitle = {IEEE Transactions on Information Theory},\n journal = {IEEE Transactions on Information Theory},\n pages = {9163-9202},\n title = {Minimax Hypothesis Testing for the Bradley–Terry–Luce Model},\n volume = {71},\n year = {2024}\n}\n\n@Article{Morel-Balbi2025EstimationOP,\n author = {Sebastian Morel-Balbi and Alec Kirkley},\n booktitle = {Communications Physics},\n journal = {Communications Physics},\n title = {Estimation of partial rankings from sparse, noisy comparisons},\n volume = {9},\n year = {2025}\n}\n\n@Article{Defresne2025PreferenceEF,\n author = {M. Defresne and Jayanta Mandi and Tias Guns},\n booktitle = {International Joint Conference on Artificial Intelligence},\n pages = {2583-2591},\n title = {Preference Elicitation for Multi-objective Combinatorial Optimization with Active Learning and Maximum Likelihood Estimation},\n year = {2025}\n}\n\n@Inproceedings{Yan2025InferenceIA,\n author = {Ting Yan},\n title = {Inference in a generalized Bradley-Terry model for paired comparisons with covariates and a growing number of subjects},\n year = {2025}\n}\n\n@Inproceedings{Li2021ThePO,\n author = {Wan-Shan Li and Shamindra Shrotriya},\n title = {The Performance of the MLE in the Bradley-Terry-Luce Model in (cid:96) ∞ -Loss and under General Graph Topologies},\n year = {2021}\n}\n\n@Inproceedings{Selby2024PageRankAT,\n author = {David Antony Selby},\n title = {PageRank and the Bradley-Terry model},\n year = {2024}\n}\n\n@Article{Varin2024TractableRR,\n author = {Cristiano Varin and D. Firth},\n booktitle = {Stat},\n journal = {Stat},\n title = {Tractable Ridge Regression for Paired Comparisons},\n volume = {13},\n year = {2024}\n}\n\n@Article{Vojnović2019ConvergenceRO,\n author = {M. Vojnović and Seyoung Yun and Kaifang Zhou},\n booktitle = {arXiv.org},\n journal = {ArXiv},\n title = {Convergence Rates of Gradient Descent and MM Algorithms for Generalized Bradley-Terry Models},\n volume = {abs/1901.00150},\n year = {2019}\n}\n\n@Inproceedings{Hussain2013BayesianIO,\n author = {S. K. Hussain and M. Aslam},\n pages = {43-49},\n title = {Bayesian Inference of Log-linear Version of the Bradley-Terry Model for Paired Comparisons Using Uninformative Prior},\n volume = {2},\n year = {2013}\n}\n\n@Inproceedings{Sawadogo2019CombiningMA,\n author = {Amadou Sawadogo and D. Lafon and S. Dossou-Gbété},\n pages = {106-128},\n title = {Combining MM-Algorithms and MCMC Procedures for Maximum Likelihood Estimation in Mallows-Bradley-Terry Models},\n volume = {5},\n year = {2019}\n}\n\n@Inproceedings{Rizvi2026BayesianBF,\n author = {Arshique Rizvi and R. Singh},\n title = {Bayesian Bradley-Terry Framework for Ranking Multi-Indicator Entities: Application to Indian States and Union Territories},\n year = {2026}\n}\n{\n \"status\": \"ready\",\n \"selected_prompt_family\": \"paper_standalone\",\n \"recommended_title\": \"How Few Edits Displace the Top of a Bradley-Terry Leaderboard? A Verified First-Order Influence Attack Across Crowd, Expert, LLM-Judge and Sports Comparison Data\",\n \"central_question\": \"How many edits (0.1% to 2% of comparison rows, by dropping or flipping) does it take for a first-order influence search to dethrone the rank-1 competitor of a ridge Bradley-Terry leaderboard, and does that vulnerability differ across evaluation designs (crowd votes, expert human judgments, LLM-judge judgments, sports results)?\",\n \"central_thesis\": \"Under evaluator-verified exact refits, a single one-shot first-order influence edit search yields very different rank-1 vulnerability across evaluation designs: it displaces rank 1 in every crowd-vote and sports case at the 2% budget but in none of the LLM-judge cases and only in the flip mode for expert-human judgments; this is a measured, bounded result for one attack and one target (rank 1), not a general sensitivity law, and no improved search method was established.\",\n \"narrative_rationale\": \"The only completed, scored evidence is the sealed final evaluation of the frozen selection, which is the original first-order influence starter (selection_kind=baseline, investigation_outcome=completed_no_winner). All three attempted improved search variants were unscored (infrastructure failures), so they are missing evidence, not losses, and cannot support any improvement claim. The final evaluation is qualified/completed and gives (i) a family-averaged edit success of 0.606, (ii) per-design scores (crowd 1.000, sports 0.833, expert-human 0.374, LLM-judge 0.216), (iii) per-design/per-mode top-1 displacement rates at the largest budget, (iv) aggregate evaluator-owned baselines (random 0.071, constant 0.071, win-rate heuristic 0.574), (v) a permuted-input control gap of 0 and a valid proposal rate of 1. This supports a measurement paper whose message is heterogeneity across evaluation designs under a verified attack, with explicit scope limits. A method-improvement narrative would be unsupported; a negative-results framing about the tested method (no improvement over the baseline was established; margin versus the best baseline is 0 because the selected method is the influence baseline) is honest and still informative. The three-way contrast (human crowd vs. MT-Bench human vs. MT-Bench GPT-4 judge vs. NBA) directly answers the task's cross-design question.\",\n \"prior_paper_story_status\": \"rejected\",\n \"edit_framing_decision\": \"Not in edit mode: no prior manuscript exists. A fresh thesis-first framing was chosen over a method-improvement story (rejected because no variant was scored) and over a noise-vs-intent sensitivity story (rejected because the artifacts contain no noise-calibration or subsampling experiments).\",\n \"staged_input_impact\": [\n  \"No staged prior paper or new program inputs; downstream_study shows the frozen selection is byte-identical to the baseline (same program tree hash), so there is a single studied method.\",\n  \"Three attempted variants (re-linearised greedy, pair-class multi-rival greedy, rival-chunked prefix line search) have 0 scored attempts of 3; they appear at most as one sentence in limitations/supplement as unscored design attempts with no performance evidence.\"\n ],\n \"method_groups\": [\n  {\n   \"name\": \"First-order influence edit search (studied method; frozen selection)\",\n   \"role\": \"proposed\",\n   \"include_reason\": \"It is the only method with scored evidence. One ridge-BT fit, a sensitivity direction for the top-vs-runner-up gap via the penalised-Hessian solve, then rank rows by first-order gap change for drop or flip. Present it as the object of study, not as a novel contribution.\"\n  },\n  {\n   \"name\": \"Evaluator-owned reference edit policies: constant, random, win-rate heuristic\",\n   \"role\": \"baseline\",\n   \"include_reason\": \"Give scale to the scores: constant and random sit near 0.071, win-rate near 0.574 (family-averaged). Only aggregate values are available; per-family baseline values must not be invented.\"\n  },\n  {\n   \"name\": \"Verification controls: exact trusted refit, permuted-input control, valid-proposal rate\",\n   \"role\": \"supporting\",\n   \"include_reason\": \"Justify that scores are not self-reported (the evaluator refits the edited data) and that results are not an artifact of row order or identity (permuted-input gap 0; valid proposal rate 1.0).\"\n  },\n  {\n   \"name\": \"Unscored improved-search variants\",\n   \"role\": \"ablation\",\n   \"include_reason\": \"Optional one-paragraph disclosure only (3 attempted, 0 scored); no comparison is drawn.\"\n  }\n ],\n \"results_focus\": [\n  \"Per-design edit success of the influence search (crowd 1.000, sports 0.833, expert-human 0.374, LLM-judge 0.216; equally weighted mean 0.606), sealed final scope.\",\n  \"Top-1 displacement rate at the largest (2%) budget by design and mode: crowd 1/1 (drop/flip), sports 1/1, expert-human 0 (drop) / 1 (flip), LLM-judge 0/0. State that rates are averages over cases and seeds and take only values 0 or 1 here.\",\n  \"Reference scale: constant 0.071, random 0.071, win-rate heuristic 0.574 vs influence 0.606; margin versus the best baseline is computed as 0 for the method as frozen (explain: the studied method is the influence baseline itself, so this is a consistency check, not a comparison).\",\n  \"Validity checks: permuted-input control gap 0.0, valid proposal rate 1.0, qualification outcome qualified with status completed; three evaluation seeds give identical scores (deterministic proposer; seeds relabel episodes only), so there is no between-seed variance to report and no confidence interval is available.\",\n  \"Contrast of the two MT-Bench judge types (expert human vs GPT-4 judge) as a within-source comparison; flag that the data sources differ in gap sizes and row counts and the cause of the difference is untested (do not claim a mechanism).\",\n  \"Separate search from final: search-scope baseline score 0.914 with delta 0.0, 3 of 3 variant attempts unscored; search and sealed-final scores are different scopes and must not be compared or averaged.\"\n ],\n \"figure_plan\": [\n  \"Overview schematic (page 1-2): comparison rows -> ridge BT fit -> top vs runner-up gap -> edit budget k (0.1%-2%) by drop or flip -> trusted refit -> edit success score, with the four evaluation designs shown as inputs.\",\n  \"Two-panel bar figure: (a) edit success by evaluation design for the influence search; (b) family-averaged edit success for constant, random, win-rate heuristic, influence search. Annotate that panel (b) baselines are aggregate only.\",\n  \"Table (not figure): top-1 displacement rate at the 2% budget by design x mode, plus scores; and a setup table listing the four designs, data sources, and cases (crowd: 1 case per mode; expert-human and LLM-judge: MT-Bench; sports: NBA seasons 2008, 2012, 2015).\"\n ],\n \"figure_specs\": [\n  {\n   \"figure_id\": \"overview_protocol\",\n   \"required\": true,\n   \"purpose\": \"Glance-value overview of the studied object: pairwise compari