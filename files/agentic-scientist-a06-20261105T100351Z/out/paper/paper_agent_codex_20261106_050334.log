anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Task\"\n        },\n        \"threshold\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Threshold\"\n        },\n        \"y_range\": {\n          \"anyOf\": [\n            {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"type\": \"array\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Y Range\"\n        }\n      },\n      \"title\": \"RichFigurePanel\",\n      \"type\": \"object\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"description\": \"Top-level figure-manifest document.\",\n  \"properties\": {\n    \"figures\": {\n      \"items\": {\n        \"anyOf\": [\n          {\n            \"$ref\": \"#/$defs/LegacyFigureManifestFigure\"\n          },\n          {\n            \"$ref\": \"#/$defs/RichFigureManifestFigure\"\n          }\n        ]\n      },\n      \"minItems\": 1,\n      \"title\": \"Figures\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"figures\"\n  ],\n  \"title\": \"FigureManifestDocument\",\n  \"type\": \"object\"\n}\n#!/usr/bin/env bash\nset -euo pipefail\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nexec python3 \"$SCRIPT_DIR/scientific_evidence.py\" \"$@\"\nusage: append_memory.py [-h] [--write-conclusions] [--event-json EVENT_JSON]\n                        [--event-file EVENT_FILE]\n                        [--local-memory-md LOCAL_MEMORY_MD]\n                        [--global-memory-md GLOBAL_MEMORY_MD]\n                        [--global-memory-jsonl GLOBAL_MEMORY_JSONL]\n                        [--conclusions-md CONCLUSIONS_MD]\n                        [--conclusions-history-jsonl CONCLUSIONS_HISTORY_JSONL]\n                        [--conclusions-text CONCLUSIONS_TEXT]\n                        [--cycle-index CYCLE_INDEX]\n                        [--worker-index WORKER_INDEX]\n                        [--gate-trigger GATE_TRIGGER]\n                        [--gate-reason GATE_REASON]\n\nAppend one memory event, or atomically rewrite conclusions.md.\n\noptions:\n  -h, --help            show this help message and exit\n  --write-conclusions   Switch into conclusions-write mode (validates and\n                        replaces conclusions.md).\n  --event-json EVENT_JSON\n                        Event payload as JSON object string\n  --event-file EVENT_FILE\n                        Path to event JSON file\n  --local-memory-md LOCAL_MEMORY_MD\n                        Local workspace memory markdown path\n  --global-memory-md GLOBAL_MEMORY_MD\n                        Global markdown memory path (event mode)\n  --global-memory-jsonl GLOBAL_MEMORY_JSONL\n                        Global JSONL memory path (event mode)\n  --conclusions-md CONCLUSIONS_MD\n                        Path of conclusions.md to overwrite (--write-\n                        conclusions mode)\n  --conclusions-history-jsonl CONCLUSIONS_HISTORY_JSONL\n                        Path of conclusions_history.jsonl to append a record\n                        to\n  --conclusions-text CONCLUSIONS_TEXT\n                        Conclusion paragraph (omit to read from stdin)\n  --cycle-index CYCLE_INDEX\n                        Current cycle index for the history record\n  --worker-index WORKER_INDEX\n                        Current worker index for the history record\n  --gate-trigger GATE_TRIGGER\n                        Gate trigger letter (a|b|c|d) recorded in history\n  --gate-reason GATE_REASON\n                        One-sentence reason for the update; for trigger d name\n                        the dimension\n{\n  \"campaign_results_dir\": \"work/results/a06/codex/20261105_100448/investigation\",\n  \"count\": 25,\n  \"generated_at\": \"2026-11-06T05:07:12.060107+00:00\",\n  \"queries\": [\n    \"sample splitting model selection independent test error bias variance\",\n    \"\\\"Valid post-selection inference\\\" Berk Brown Buja Zhang Zhao\",\n    \"\\\"Preserving Statistical Validity in Adaptive Data Analysis\\\" Dwork\",\n    \"\\\"The Ladder: A Reliable Leaderboard for Machine Learning Competitions\\\" Blum Hardt\",\n    \"\\\"Efficient Prompt Optimization Through the Lens of Best Arm Identification\\\" Shi\",\n    \"\\\"Quantifying Language Models' Sensitivity to Spurious Features in Prompt Design\\\" Sclar\",\n    \"\\\"MMLU-Pro: A More Robust and Challenging Multi-Task Language Understanding Benchmark\\\" Wang\",\n    \"Wilson score interval binomial proportion coverage\",\n    \"paired bootstrap accuracy difference dependent observations\"\n  ],\n  \"reference_query_plan\": {\n    \"architectural_shifts\": [],\n    \"benchmarks\": [\n      \"MMLU-Pro: task-specified benchmark context; final real-case records do not independently identify the dataset revision or inference model\"\n    ],\n    \"central_topic\": \"Reliability of accuracy reports after selecting from a frozen LLM prompt bank, comparing selection-data reuse with independent split reporting and distinguishing synthetic population truth from finite real-data audits.\",\n    \"comparators\": [\n      \"Fixed-prompt and random-prompt evaluation\",\n      \"Full-sample winner reporting and same-winner selection-data reuse\",\n      \"Independent holdout and honest half-split reporting\",\n      \"Best-arm identification for prompt selection as related work, not an implemented optimizer\",\n      \"Post-selection inference and adaptive holdout/leaderboard validity as conceptual comparators, not implemented protections\"\n    ],\n    \"core_methods\": [\n      \"Frozen 16-prompt instruction/format bank, evaluated with one or sixteen active prompts\",\n      \"Maximum selection-set accuracy with deterministic tie priority\",\n      \"Seeded randomized half-selection/half-report partition with uniform report weights\",\n      \"95% Wilson score intervals for held-out accuracy\",\n      \"Synthetic known-truth evaluation and separate finite real-data audit comparisons\",\n      \"Recorded paired subject-bootstrap uncertainty diagnostics, with the resampling implementation not independently verified\"\n    ],\n    \"forbidden_query_patterns\": [\n      \"Any attempt to identify, guess, search for, or reconstruct the prohibited paper's title, authors, results, or other identity clues\",\n      \"Any prohibited paper, mirror, preprint, abstract, venue/review page, slide, poster, video, blog, repository, or page citing, discussing, or reproducing it; stop immediately if encountered\",\n      \"Unrestricted recent LLM prompt-tuning benchmark-score bias discovery; expanding the central research question into broad web searches\",\n      \"Citation-graph expansion, cited-by/related-paper browsing, reviews, aggregators, or discussion pages around retrieved works\",\n      \"For the six named starter-work queries, substitutions or broad discovery rather than exact-title resolution to the permitted original; post-2025 reference targets\",\n      \"For the three unnamed statistical queries, broad recent ML/LLM discovery rather than foundational original statistical methodology\",\n      \"Generic optimization, benchmarking, scientific-method, paper-writing, campaign chronology, or citation-abundance queries\",\n      \"Paired selection certificates, multiplier-bootstrap certificates, quarter-split superiority, or stratified-reporting gains presented as completed measured methods\",\n      \"DSPy or MIPRO execution, neural architecture changes, representation transfer, or specific inference-model comparisons not supported by current artifacts\",\n      \"Using null-score timeouts as measured losses, treating the aggregate evaluation score as benchmark accuracy, or treating finite-audit coverage as established population coverage\"\n    ],\n    \"queries\": [\n      {\n        \"category\": \"core_method\",\n        \"query\": \"sample splitting model selection independent test error bias variance\",\n        \"rationale\": \"The retained source uses a half-selection/half-report split; recorded pooled report MSE improves on same-winner reuse but not every comparator. Seek foundational statistical originals on selection bias and the variance cost of independent reporting, not recent LLM-specific discovery.\"\n      },\n      {\n        \"category\": \"baseline_comparator\",\n        \"query\": \"\\\"Valid post-selection inference\\\" Berk Brown Buja Zhang Zhao\",\n        \"rationale\": \"This explicitly permitted starter work supplies selective-inference context for choosing a winner before reporting performance. Its regression setting is an analogy, not evidence that the run implemented simultaneous or selective certificates.\"\n      },\n      {\n        \"category\": \"baseline_comparator\",\n        \"query\": \"\\\"Preserving Statistical Validity in Adaptive Data Analysis\\\" Dwork\",\n        \"rationale\": \"This permitted starter work contextualizes data reuse and independence. Contrast adaptive reuse protections with the run's frozen bank and single nonadaptive partition; do not attribute differential privacy to the implemented policy.\"\n      },\n      {\n        \"category\": \"baseline_comparator\",\n        \"query\": \"\\\"The Ladder: A Reliable Leaderboard for Machine Learning Competitions\\\" Blum Hardt\",\n        \"rationale\": \"This permitted starter work is a reporting-mechanism comparator: repeated leaderboard reuse differs from the recorded one-shot protected report. It is related work, not a measured Ladder baseline.\"\n      },\n      {\n        \"category\": \"baseline_comparator\",\n        \"query\": \"\\\"Efficient Prompt Optimization Through the Lens of Best Arm Identification\\\" Shi\",\n        \"rationale\": \"The run selects the best empirical arm from a finite prompt bank and includes fixed/random controls. This permitted starter work distinguishes selecting a good prompt from accurately estimating its performance; its adaptive allocation algorithm was not run.\"\n      },\n      {\n        \"category\": \"core_method\",\n        \"query\": \"\\\"Quantifying Language Models' Sensitivity to Spurious Features in Prompt Design\\\" Sclar\",\n        \"rationale\": \"The preserved bank varies instructions and output formatting rather than model architecture. This permitted starter work grounds prompt sensitivity and the K=1 versus K=16 comparison without inventing a representation or architecture transition.\"\n      },\n      {\n\"\"\"Candidate-owned prompt-bank and honest-report partition policy (CPU, stdlib).\n\nInterface: python_rpc_v1:handle. Every request/response is finite inline JSON.\nKeep this entrypoint self-contained or use installed packages: native smoke copies\nonly the entrypoint into its filesystem sandbox, not neighboring helper modules.\nNo filesystem exchange, model inference, labels, audit examples, outcome matrices,\nbaseline outputs, scoring feedback, or host paths are supplied to this process.\nArbitrary nonnegative integer seeds initialize randomness, never workload identity.\n\nOperations (additional request and response fields are forbidden):\n  reset: {\"op\":\"reset\", \"seed\": int in [0, 2**63-1]} -> {\"ok\": true}.\n    Initializes a fresh episode's RNG. Exactly one reset per independent episode.\n  update: {\"op\":\"update\", \"arms\": int in [1,16], \"confidence\":0.95,\n           \"slots\":[{\"key\":str, \"stratum\":str}, ...]}.\n    Exactly one update after reset. Slots are distinct unlabelled content hashes\n    (or synthetic slot hashes); length n is a multiple of four. Settings arrive\n    through these fields, not through seeds. The same API serves all workloads.\n    Returns exactly {\"prompts\":list[str], \"selection\":list[str],\n                     \"report\":list[str], \"weights\":list[number],\n                     \"tie_order\":list[int]}.\n    prompts: exactly 16 distinct instruction/format variants, each 1..4096 UTF-8\n    bytes, with DEFAULT_PROMPT at index 0. Bank must be identical for every reset,\n    seed, episode and workload; only its first `arms` prompts are executed. No\n    example-specific rules, answer keys, benchmark lookups, hashes, URLs or IDs.\n    Control characters except tab/newline are forbidden. Selection/report are\n    nonempty disjoint exhaustive lists of supplied keys, without repetitions.\n    Selection size is between n/4 and 3n/4 inclusive. Weights have report length,\n    and each equals 1/len(report) within absolute tolerance 1e-12. tie_order is a\n    permutation of range(arms), defining highest-score tie priority. No tensor or\n    binary values are transferred; there is no state-transfer operation.\n\nThe evaluator uses the actual returned partition and prompt texts. It selects the\nmaximum-accuracy prompt on selection rows, then reports its uniform mean and 95%\nWilson interval on report rows. It privately generates genuine model responses,\nowns targets, and compares against fresh audit accuracy (synthetic known truth).\nNo in-episode feedback/adaptivity is required. Invalid parsed model responses and\ncontext overflow count as incorrect, never disappear. Baselines: fixed, random,\nfull-sample winner/reuse, same-winner selector reuse, and honest half-split.\nMatched constant, copy-arm, contaminated copy-report, effective nonidentity input\npermutation and terminal reset/replay controls are evaluator-owned, not self-reports.\n\nScore: 1 - mean report MSE. Equal weights: synthetic/real families, n/K cases,\nseeds, four synthetic regimes and their replicates. Replay is a control, not an\nextra scored replicate. Missing episodes/controls retain MSE=1, accuracy=coverage=0,\nbias=optimism=width=reversal=failure=1. Search and final correct separately require\ncomplete valid experiments/controls and deterministic replay, NOT superiority,\nsignificance or a positive finding. Publication additionally requires a supported\npaper and reproducibility code; search eligibility does not certify these claims.\nMethods may change this policy, not the estimator or hidden evaluation objectives.\nAll complete JSON messages must stay below 8 MiB operationally and 64 MiB on wire.\n\"\"\"\nimport random\n\nDEFAULT_PROMPT = 'Answer the multiple-choice question. Return only the correct option letter A through J.'\n_random = None\n_updated = False\n\ndef prompt_bank():\n    variants = [\n        'Choose the best answer. Output only its capital letter.',\n        'Solve the question carefully, then give only the option letter.',\n        'Identify the correct option. Respond with a single capital letter.',\n        'Consider each option and select the best one. Print the letter only.',\n        'Your answer must consist solely of the correct choice letter.',\n        'Read the question and choices. Return the correct letter, no explanation.',\n        'Select one answer from the provided options. Give only its letter.',\n        'Please answer this multiple-choice question using one capital letter.',\n        'Determine which option is most accurate. Output the letter only.',\n        'Choose the single best option; omit all text except its capital letter.',\n        'Evaluate the alternatives. Give the correct answer as its option letter.',\n        'Respond to this question with the letter of the best available answer.',\n        'Find the right answer among the listed choices. Return only its letter.',\n        'Pick the most appropriate answer and output its capital letter alone.',\n        'Answer accurately. Use only the capital letter identifying your choice.',\n    ]\n    return [DEFAULT_PROMPT] + variants\n\ndef handle(request):\n    global _random, _updated\n    if type(request) is not dict:\n        raise ValueError('request must be an object')\n    if request.get('op') == 'reset':\n        if set(request) != {'op', 'seed'} or type(request['seed']) is not int or not 0 <= request['seed'] < 2**63:\n            raise ValueError('invalid reset')\n        _random = random.Random(request['seed'])\n        _updated = False\n        return {'ok': True}\n    if request.get('op') != 'update' or set(request) != {'op', 'arms', 'slots', 'confidence'} or _random is None or _updated:\n        raise ValueError('expected one update after reset')\n    arms = request['arms']\n    slots = request['slots']\n    if type(arms) is not int or not 1 <= arms <= 16 or request['confidence'] != .95 or type(slots) is not list or len(slots) < 4 or len(slots) % 4:\n        raise ValueError('invalid workload')\n    keys = [slot['key'] for slot in slots]\n    if len(set(keys)) != len(keys):\n        raise ValueError('duplicate slots')\n    _random.shuffle(keys)\n    midpoint = len(keys) // 2\n    report = keys[midpoint:]\n    _updated = True\n    return {'prompts': prompt_bank(), 'selection': keys[:midpoint], 'report': report,\n            'weights': [1 / len(report)] * len(report), 'tie_order': list(range(arms))}\ncapture.py\nevaluate.py\nevaluate_final.py\nprogram_0\nrequirements.txt\nresources\ntask.md\ntask_contract.json\n","exit_code":0,"status":"completed"}}
