\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Left: a tokenized LM can suffer tokenization bias when a prompt ends mid-token, as in this code completion example, where the correct completion has zero probability. Our method avoids this problem and predicts the correct token using the same model. Right: our method maps the next-token predictions of arbitrary tokenized LMs to statistically equivalent next-byte predictions, which enables ensemble strategies such as averaging.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:teaser}{{1}{4}{Left: a tokenized LM can suffer tokenization bias when a prompt ends mid-token, as in this code completion example, where the correct completion has zero probability. Our method avoids this problem and predicts the correct token using the same model. Right: our method maps the next-token predictions of arbitrary tokenized LMs to statistically equivalent next-byte predictions, which enables ensemble strategies such as averaging}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Illustration of the sampling process for $x_{n+1}$ from a tokenized LM $P(t_{k+1} \mid t_{1:k})$. We omit $P({\bm  {t}})$ for simplicity. See Section~\ref {sec:method}.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:sampling}{{2}{4}{Illustration of the sampling process for $x_{n+1}$ from a tokenized LM $P(t_{k+1} \mid t_{1:k})$. We omit $P(\vt )$ for simplicity. See Section~\ref {sec:method}}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Synthetic tokenization bias}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: representation of $P(x_{n+1} \mid {\bm  {x}})$ with a tokenized LM, showing an example of cover encodings and valid and invalid encodings. Right: illustration of the cover-encoding search. Green ticks and red crosses denote valid and invalid encodings. The termination step is omitted from the algorithm for brevity. BPE is used in this example.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:cover}{{3}{5}{Left: representation of $P(x_{n+1} \mid \vx )$ with a tokenized LM, showing an example of cover encodings and valid and invalid encodings. Right: illustration of the cover-encoding search. Green ticks and red crosses denote valid and invalid encodings. The termination step is omitted from the algorithm for brevity. BPE is used in this example}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Left: tokenization bias on a first-order Markov chain. Given the context token ``A'', the tokenized model never samples ``A'' as the next token, whereas the chain does so with probability $1-\alpha $. Right: tokenization bias on a third-order Markov chain. The byte-token correction accurately recovers $P(x_{n+1} \mid x_{1:n})$ of the original chain.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:bias1}{{4}{5}{Left: tokenization bias on a first-order Markov chain. Given the context token ``A'', the tokenized model never samples ``A'' as the next token, whereas the chain does so with probability $1-\alpha $. Right: tokenization bias on a third-order Markov chain. The byte-token correction accurately recovers $P(x_{n+1} \mid x_{1:n})$ of the original chain}{figure.4}{}}
\newlabel{fig:bias3}{{4}{5}{Left: tokenization bias on a first-order Markov chain. Given the context token ``A'', the tokenized model never samples ``A'' as the next token, whereas the chain does so with probability $1-\alpha $. Right: tokenization bias on a third-order Markov chain. The byte-token correction accurately recovers $P(x_{n+1} \mid x_{1:n})$ of the original chain}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Code infilling}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Pass rates (\%) on the HumanEval Random Span benchmark with CodeLlama-7b. Healing and alignment are heuristic prompt-boundary fixes that apply to SPM only. Best value per column in bold.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:humaneval}{{1}{6}{Pass rates (\%) on the HumanEval Random Span benchmark with CodeLlama-7b. Healing and alignment are heuristic prompt-boundary fixes that apply to SPM only. Best value per column in bold}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Pass rates for the HumanEval Random Span benchmark with CodeLlama-7b for infilling Python. Across all settings, the byte-level predictions yield better completions. We evaluate the PSM and SPM infilling templates and use token healing and token alignment as baselines. The SPM template forces the model to predict from the middle of a token, which the byte-level predictions handle.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:humaneval}{{5}{6}{Pass rates for the HumanEval Random Span benchmark with CodeLlama-7b for infilling Python. Across all settings, the byte-level predictions yield better completions. We evaluate the PSM and SPM infilling templates and use token healing and token alignment as baselines. The SPM template forces the model to predict from the middle of a token, which the byte-level predictions handle}{figure.5}{}}
