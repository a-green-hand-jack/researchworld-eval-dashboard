\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main sweep. Event counts are out of eight. $\bar  T^\tau $ denotes the mean capped endpoint, not an estimated true event time for censored runs. Brackets are unadjusted seed-bootstrap 95\% CIs. Final accuracy uses unprojected logits.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:width}{{2}{5}{Main sweep. Event counts are out of eight. $\bar T^\tau $ denotes the mean capped endpoint, not an estimated true event time for censored runs. Brackets are unadjusted seed-bootstrap 95\% CIs. Final accuracy uses unprojected logits}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Clock-compatible first onsets do not imply lasting acquisition}{5}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Decay interventions. Curves are mean unprojected held-out accuracy; shaded ranges are seed minima--maxima, \emph  {not} confidence intervals. Rows: widths 32 and 128. Left: full update horizon, including zero decay. Right: positive-decay curves on a common clock window, truncated explicitly at $C=10$. Compatible wide-model timing and largely absent narrow-model events are different evidential situations.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:clock}{{2}{6}{Decay interventions. Curves are mean unprojected held-out accuracy; shaded ranges are seed minima--maxima, \emph {not} confidence intervals. Rows: widths 32 and 128. Left: full update horizon, including zero decay. Right: positive-decay curves on a common clock window, truncated explicitly at $C=10$. Compatible wide-model timing and largely absent narrow-model events are different evidential situations}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces All three frozen primary contrasts. W predicts a negative interaction; C predicts a small clock difference. CIs are unadjusted; $p$-values are two-sided. A non-rejection with censored pairs is not equivalence.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:primary}{{3}{6}{All three frozen primary contrasts. W predicts a negative interaction; C predicts a small clock difference. CIs are unadjusted; $p$-values are two-sided. A non-rejection with censored pairs is not equivalence}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Trainability and label controls at fixed budget. Dots are individual seeds and bars are bootstrap 95\% CIs. The shuffled arm is evaluated against shuffled labels, not the true modular rule. The width-1024 frozen comparison addresses training capacity directly; the low-width frozen comparison alone cannot identify a feature-learning requirement.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:controls}{{3}{7}{Trainability and label controls at fixed budget. Dots are individual seeds and bars are bootstrap 95\% CIs. The shuffled arm is evaluated against shuffled labels, not the true modular rule. The width-1024 frozen comparison addresses training capacity directly; the low-width frozen comparison alone cannot identify a feature-learning requirement}{figure.3}{}}
