pendencies_file\": \"requirements-evaluated.txt\",\n                   \"note\": \"Paper extraction/plotting environment is distinct from the recorded evaluation environment. No evaluation rerun.\"}\n    (ROOT / \"derived/environment.json\").write_text(json.dumps(environment, indent=2))\n    provenance = {\n        \"venue\": \"ICLR 2026 anonymous submission\", \"repository\": \"https://github.com/ICLR/Master-Template\",\n        \"download_url\": \"https://github.com/ICLR/Master-Template/archive/refs/heads/master.zip\",\n        \"retrieved_utc\": \"2026-11-07\", \"archive_subdirectory\": \"Master-Template-master/iclr2026\",\n        \"files\": {path: manifest[path] for path in [\"iclr2026_conference.sty\", \"iclr2026_conference.bst\", \"official_template.tex\"]},\n        \"modifications\": \"None to official style, bibliography style, or retained reference template. Manuscript omits identifying authors and does not enable final-copy mode.\",\n        \"geometry\": {\"text_width_inches\": 5.5, \"text_height_inches\": 9.0},\n        \"checklist\": \"No separate checklist is included in the official ICLR 2026 template. Supplement includes reproducibility, limitations and LLM usage disclosures; no checklist from another venue is substituted.\",\n    }\n    (ROOT / \"template_provenance.json\").write_text(json.dumps(provenance, indent=2))\n    upstream = {}\n    for family in [\"helm\", \"openllm\"]:\n        resource = json.loads((ROOT / \"data\" / (family + \".json\")).read_text())\n        upstream[family] = {\"acquired_utc\": resource[\"acquired_utc\"], \"scale\": resource[\"scale\"],\n                            \"tasks\": resource[\"tasks\"], \"license_note\": resource[\"license\"],\n                            \"sources\": sorted({(record[\"source_url\"], record[\"source_sha256\"]) for row in resource[\"rows\"] for record in row[\"provenance\"]})}\n    path = ROOT / \"derived/upstream_provenance.json\"\n    path.write_text(json.dumps(upstream, indent=2))\n    sidecar(path, [\"@evidence[[data/helm.json]]\", \"@evidence[[data/openllm.json]]\"], kind=\"derived\")\n    for name, kind, inputs in [\n        (\"paper.tex\", \"manuscript\", [\"paper_data.json\", \"references_provenance.json\", \"source_evidence/downstream/program/src/program.py\"]),\n        (\"claims_grounding.json\", \"derived\", [\"paper_data.json\", \"references_provenance.json\", \"derived/original_records.json\"]),\n        (\"figure_manifest.json\", \"derived\", [\"paper_strategy.json\", \"derived/original_records.json\"]),\n        (\"paper.pdf\", \"manuscript\", [\"paper.tex\", \"references.bib\", \"figures/score_space_overview.png\", \"figures/paired_mean_median_budgets.pdf\", \"figures/cap_conditioned_reachability.pdf\"]),\n    ]:\n        path = ROOT / name\n        if not path.exists():\n            continue\n        token = \"@\" + \"evidence[[\"\n        payload = {\"schema_name\": \"scientific-evidence.artifact-manifest\",\n                   \"artifact\": {\"path\": name, \"kind\": kind, \"sha256\": hashlib.sha256(path.read_bytes()).hexdigest()},\n                   \"derived_from\": [token + item + \"]]\" for item in inputs]}\n        if name in [\"paper.pdf\", \"figure_manifest.json\"]:\n            payload[\"artifact\"].pop(\"sha256\")\n            payload[\"notes\"] = [\"Parent orchestration renders the overview and recompiles the PDF after this stage. Mutable output has an input trail but no pre-render content digest.\"]\n        Path(str(path) + \".prov.json\").write_text(json.dumps(payload, indent=2))\n    print(\"Wrote file-scope checksums, upstream provenance, template provenance, environment and artifact sidecars.\")\n\n\nif __name__ == \"__main__\":\n    main()\nimport datetime\nimport json\nimport sys\nfrom pathlib import Path\n\n\ndef log_event(step, summary, evidence, next_action):\n    event = {\n        \"timestamp\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n        \"scope\": \"paper\",\n        \"step\": step,\n        \"summary\": summary,\n        \"evidence\": evidence,\n        \"next_action\": next_action,\n    }\n    text = \"\\n### {timestamp} — {step}\\n{summary}\\nEvidence: {evidence}\\nNext: {next_action}\\n\".format(**event)\n    for path in [Path(\"memory.md\"), Path(\"global_memory/memory.md\").resolve()]:\n        with path.open(\"a\") as stream:\n            stream.write(text)\n    with Path(\"global_memory/memory.jsonl\").resolve().open(\"a\") as stream:\n        stream.write(json.dumps(event) + \"\\n\")\n\n\nif __name__ == \"__main__\":\n    log_event(*sys.argv[1:])\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n{\n  \"$defs\": {\n    \"FigureFontSizes\": {\n      \"additionalProperties\": false,\n      \"description\": \"Explicit font sizes for the legacy manifest contract.\",\n      \"properties\": {\n        \"axis\": {\n          \"title\": \"Axis\",\n          \"type\": \"number\"\n        },\n        \"legend\": {\n          \"title\": \"Legend\",\n          \"type\": \"number\"\n        },\n        \"ticks\": {\n          \"title\": \"Ticks\",\n          \"type\": \"number\"\n        },\n        \"title\": {\n          \"title\": \"Title\",\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"title\",\n        \"axis\",\n        \"ticks\",\n        \"legend\"\n      ],\n      \"title\": \"FigureFontSizes\",\n      \"type\": \"object\"\n    },\n    \"LegacyFigureManifestFigure\": {\n      \"additionalProperties\": false,\n      \"allOf\": [\n        {\n          \"else\": {\n            \"properties\": {\n              \"path_pdf\": {\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"path_pdf\"\n            ]\n          },\n          \"if\": {\n            \"anyOf\": [\n              {\n                \"properties\": {\n                  \"generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  }\n                },\n                \"required\": [\n                  \"generator\"\n                ]\n              },\n              {\n                \"properties\": {\n                  \"attempted_generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  },\n                  \"fallback_reason\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  },\n                  \"generator\": {\n                    \"type\": \"null\"\n                  },\n                  \"prompt_log_path\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"generator\",\n                  \"attempted_generator\",\n                  \"prompt_log_path\",\n                  \"fallback_reason\"\n                ]\n              }\n            ]\n          }\n        }\n      ],\n      \"description\": \"Original flat figure-manifest entry shape.\",\n      \"properties\": {\n        \"attempted_generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Attempted Generator\"\n        },\n        \"categories_per_panel\": {\n          \"items\": {\n            \"type\": \"integer\"\n          },\n          \"title\": \"Categories Per Panel\",\n          \"type\": \"array\"\n        },\n        \"estimated_min_rendered_font_pt\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Estimated Min Rendered Font Pt\"\n        },\n        \"fallback_reason\": {\n          \"anyOf\": [\n        