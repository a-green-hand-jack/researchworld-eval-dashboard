, Hoerl, Hu, Jain, Keshavan, Koren, MMLU, MTEB, Mazumder, Metabench, Observational, Owen, PMF, Rubin, Schafer, Sloth, Tiny\nMISSING BIB KEYS: []\nUNCITED BIB KEYS: []\npaper_data.json FIELDS: ['ablation_studies', 'all_programs', 'best_any', 'best_correct', 'downstream_study', 'evidence_sources', 'final_evaluation', 'generated_at', 'grounding_sources', 'idea_titles', 'improvement_trace', 'paper_profile', 'presentation_contract', 'results_dir', 'top_programs', 'totals']\nfinal status: completed\nmetrics: {'combined_score': 0.9527636891226994, 'constant_score': 0.90687688776656, 'control_failure_fraction': 0.0, 'copy_score': 0.920605668187274, 'correct': 1.0, 'corruption_gap': 0.029371934916708625, 'failed_episode_fraction': 0.0, 'medoid_ridge_score': 0.9327472829724573, 'mteb_score': 0.9468974985138557, 'open_llm_score': 0.9586298797315429, 'paired_gain_ci_high': 0.01847801943997085, 'paired_gain_ci_low': 0.014807167765235746, 'permuted_score': 0.9233917542059907, 'random_lowrank_score': 0.9364101694132948, 'reset_replay_ok': 1.0, 'selected_ridge_score': 0.9482262260487015}\nclaims_grounding.json FIELDS: ['scope', 'claims']\nscope: Final evaluation results are independent of search selection. Implementation descriptions use the inspectable retained source, without claiming byte-identical final-snapshot identity.\nclaims: 37\npaper_strategy.json FIELDS: ['status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason']\n","exit_code":0,"status":"completed"}}
