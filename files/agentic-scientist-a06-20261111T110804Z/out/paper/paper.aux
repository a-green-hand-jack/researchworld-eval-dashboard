\newlabel{fig:biascov}{{3}{7}{Diagnostics for the primary cases (mean over eight seeds, whiskers one standard deviation across seeds). (a) Signed bias of the point estimate for the naive and EB-IRT reporters. (b) Empirical coverage of the 90\% intervals; dashed line marks the nominal level. Naive coverage is replayed from the evaluator's code}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mean interval width on the real exhaustive cases ($K=24$) as the number of benchmark questions grows (mean over eight seeds). EB-IRT is wider than the naive interval by a factor of 1.1--1.3 at each $N$ and much narrower than Bonferroni-Wilson. Naive and Bonferroni widths are replayed from the evaluator's code.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:width}{{4}{7}{Mean interval width on the real exhaustive cases ($K=24$) as the number of benchmark questions grows (mean over eight seeds). EB-IRT is wider than the naive interval by a factor of 1.1--1.3 at each $N$ and much narrower than Bonferroni-Wilson. Naive and Bonferroni widths are replayed from the evaluator's code}{figure.4}{}}
