el\"].astype(np.int64))\n    tr = torch.from_numpy(task[\"train\"])\n    xt, yt = x_all[tr], y_all[tr]\n    train_acc, val_acc = [], []\n    vi = torch.from_numpy(task[\"val\"])\n    for _ in range(spec[\"n_checkpoints\"]):\n        for _ in range(spec[\"probe_every\"]):\n            loss = nn.functional.cross_entropy(model(xt), yt)\n            opt.zero_grad(set_to_none=True)\n            loss.backward()\n            opt.step()\n        self.heads = heads\n        self.embed = nn.Embedding(p + 1, d)  # token p is the \"=\" separator\n        self.pos = nn.Parameter(torch.randn(3, d) * 0.02)\n        self.qkv = nn.Linear(d, 3 * d, bias=False)\n        self.proj = nn.Linear(d, d, bias=False)\n        self.fc1 = nn.Linear(d, 4 * d)\n        self.fc2 = nn.Linear(4 * d, d)\n        self.unembed = nn.Linear(d, p, bias=False)\n        nn.init.normal_(self.embed.weight, std=1.0 / math.sqrt(d))\n\n    def forward(self, x):\n        z = self.embed(x) + self.pos\n        b, t, d = z.shape\n        q, k, v = self.qkv(z).view(b, t, 3, self.heads, d // self.heads).permute(2, 0, 3, 1, 4)\n        a = nn.functional.scaled_dot_product_attention(q, k, v).transpose(1, 2).reshape(b, t, d)\n        z = z + self.proj(a)\n        z = z + self.fc2(torch.relu(self.fc1(z)))\n        return self.unembed(z[:, -1])\n\n\ndef _decode(obj, ndim, last):\n    if (type(obj) is not dict or set(obj) != {\"dtype\", \"shape\", \"encoding\", \"data\"}\n            or obj[\"dtype\"] != \"int16\" or obj[\"encoding\"] != \"base64-le\"):\n        raise ValueError(\"bad array envelope\")\n    shape = obj[\"shape\"]\n453:def shuffled_labels(labels, seed, p, min_changed):\n456:        shuffled = labels[perm]\n457:        changed = float(np.mean(shuffled != labels))\n459:            return shuffled, changed\n460:    raise ValueError(\"vacuous label-shuffle control\")\n909:    episodes.append({\"kind\": \"control_shuffle\", \"seed\": cseed, \"width\": wl[\"control_width\"]})\n910:    episodes.append({\"kind\": \"