{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,re\nfrom pathlib import Path\ntex=Path('paper.tex').read_text()\nbib=Path('references.bib').read_text()\nprovenance=json.loads(Path('references_provenance.json').read_text())\nprint('PROVENANCE FIELDS:', list(provenance))\nfor key,value in provenance.items():\n    if not isinstance(value,list): print(key, str(value)[:700])\n    else:\n        print(key, 'records:',len(value))\n        for entry in value:\n            if isinstance(entry,dict): print({k:entry.get(k) for k in ['citation_key','title','read_scope','content_path'] if k in entry})\ncited=set()\nfor cluster in re.findall(r'\\\\\\\\cite\\\\w*\\\\{([\"'^}]+)'\"\\\\}',tex): cited.update(cluster.split(','))\nkeys=set(re.findall(r'@\\\\w+\\\\{([\"'^,]+),'\"',bib))\nprint('CITED:', ', '.join(sorted(cited)))\nprint('MISSING BIB KEYS:',sorted(cited-keys))\nprint('UNCITED BIB KEYS:',sorted(keys-cited))\nfor filename in ['paper_data.json','claims_grounding.json','paper_strategy.json']:\n    data=json.loads(Path(filename).read_text())\n    print(filename, 'FIELDS:',list(data))\n    if filename=='paper_data.json':\n        final=data.get('final_evaluation',{})\n        print('final status:',final.get('status'));print('metrics:',final.get('metrics'))\n    elif filename=='claims_grounding.json':\n        print('scope:',data.get('scope'));print('claims:',len(data.get('claims',[])))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
