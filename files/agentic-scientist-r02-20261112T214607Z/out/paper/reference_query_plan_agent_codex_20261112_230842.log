logs(family['incumbent'], family['tail'],\n                                          features[validation_indices])\n            held_out += family['alignment_offsets']\n            fold_losses.append(pinball_loss(log_norms[validation_indices, None],\n                                            held_out, quantile).mean(axis=0))\n        fold_losses = np.asarray(fold_losses)\n        mean_losses = fold_losses.mean(axis=0)\n        standard_errors = fold_losses.std(axis=0, ddof=1) / np.sqrt(len(folds))\n        best_index = int(np.argmin(mean_losses))\n        selection_limit = mean_losses[best_index] + standard_errors[best_index]\n        simplicity_order = (0, 1, 2, 3, 4, 5)\n        selected_index = next(index for index in simplicity_order if mean_losses[index] <= selection_limit)\n    min_leaf = max(20, math.ceil(0.03 * len(log_norms)))\n    tail_model = fit_quantile_stumps(features, log_norms, quantile, max_rounds, min_leaf)\n    model = fit_scale_family(features, residual_norms, log_norms, tail_model, quantile)\n    model['selected_index'] = selected_index\n    return model\n\n\n{\n  \"schema_version\": 1,\n  \"canonical_task\": {\n    \"path\": \"task.md\",\n    \"sha256\": \"e8cc2efa334e69b5e59cec03ddcdd75b097f2d59336988b391cd3a092ecb18f1\"\n  },\n  \"method\": {\n    \"class\": \"train_only_local_scale_split_conformal\",\n    \"description\": \"Continuous logistic-normal compositional responses, dimensions3/10, H interior homoscedastic, B boundary heteroscedastic, S covariate shift. Shared train-only ILR ridge center; candidate fits positive residual-scale regression from designated scale training examples only. Evaluator owns calibration, raw L-infinity, Bonferroni, global ILR, uncalibrated training-quantile, full-simplex and singleton geometries. Reliability/efficiency evidence may be negative or inconclusive. No learning/adaptivity/superiority gate is inferred from state flags or aspirational publication claims.\"\n  },\n  \"candidate\": {\n    \"interface\