t], 1e-12))\n89:            conditional_variance = np.maximum(conditional_variance - column ** 2, 1e-12)\n91:            selected[current] = True\n96:def ridge_fit(features, target, strength):\n104:def fit_rasch(source_scores, source_groups):\n105:    weights = group_weights(source_groups)\n118:def make_profile(source_scores, rasch_probs, residual_weight):\n124:def particle_prior(source_groups):\n125:    unique, group_inverse, group_counts = np.unique(source_groups, return_inverse=True, return_counts=True)\n126:    n_groups = len(unique)\n127:    source_log_prior = -np.log(n_groups) - np.log(group_counts[group_inverse])\n129:    particle_log_prior = (source_log_prior[:, None] + offset_log_prior[None, :]).reshape(-1)\n130:    assert np.isclose(np.exp(particle_log_prior).sum(), 1.0)\n131:    group_mass = np.bincount(group_inverse, weights=np.exp(source_log_prior))\n132:    assert np.allclose(group_mass, 1.0 / n_groups)\n133:    return particle_log_prior\n136:def make_particles(profile_probs, offset_scale):\n139:    particle_probs = expit(logit(profile_probs)[:, None, :] + ability_offsets[None, :, None]).reshape(-1, n_items)\n140:    return particle_probs\n143:def particle_summary(profile_probs, offset_scale, query_order):\n146:    selected_probs = expit(logit(profile_probs[:, query_order])[:, None, :] + ability_offsets[None, :, None]).reshape(-1, len(query_order))\n155:    return selected_probs, totals\n158:def predict_summary(observed_probs, particle_log_prior, totals, n_items, observations):\n162:    log_posterior += log_failure.sum(axis=1)[None, :] + particle_log_prior[None, :]\n171:def predict_particles(particle_probs, particle_log_prior, totals, observed_indices, observations):\n173:    n_items = particle_probs.shape[1]\n174:    observed_probs = particle_probs[:, observed_indices]\n176:        return predict_summary(observed_probs, particle_log_prior, totals, n_items, observations)\n179:    log_posterior = particle_log_prior + log_likelihood\n184:    particle_prediction = (observed_answers.sum() + posterior_weights @ particle_probs[:, remaining_mask].sum(axis=1)) / n_items\n185:    assert np.isfinite(particle_prediction)\n186:    return np.clip(np.array([particle_prediction]), 0.0, 1.0)\n189:def linear_predict(model, observations):\n194:def grouped_mae(predictions, target, validation_groups):\n196:    group_mae = np.array([absolute_errors[validation_groups == group].mean() for group in np.unique(validation_groups)])\n197:    validation_risk = group_mae.mean()\n201:def fit_models(source, source_groups, budgets, seed, uniform=False):\n212:    unique_groups = np.unique(source_groups)\n213:    if len(unique_groups) >= 2:\n215:        fold_groups = np.array_split(random.permutation(unique_groups), min(3, len(unique_groups)))\n217:        particle_oof = np.empty((len(configurations), len(budgets), len(source)), dtype=np.float64)\n218:        for held_groups in fold_groups:\n219:            validation_indices = np.flatnonzero(np.isin(source_groups, held_groups))\n220:            fit_indices = np.flatnonzero(~np.isin(source_groups, held_groups))\n221:            assert set(source_groups[fit_indices]).isdisjoint(set(source_groups[validation_indices]))\n223:            fit_groups = source_groups[fit_indices]\n224:            linear_query_order = select_anchors(fit_source, fit_groups, seed, max(budgets), uniform)\n233:                    fitted = ridge_fit(fit_features, target[fit_indices], strength)\n237:            rasch_probs = fit_rasch(fit_source, fit_groups)\n238:            particle_log_prior = particle_prior(fit_groups)\n243:                    selected_probs, totals = particle_summary(profile_probs, offset_scale, mixture_query_order)\n246:                        particle_oof[config_index, budget_index, validation_indices] = predict_summary(selected_probs[:, :budget], particle_log_prior, totals, source.shape[1], observations)\n247:        validation_weights = group_weights(source_groups)\n254:        best_risk = grouped_mae(linear_prediction, target, source_groups)\n256:            particle_prediction = particle_oof[config_index]\n258:                blended_prediction = (1.0 - mixture_weight) * linear_prediction + mixture_weight * particle_prediction\n259:                validation_risk = grouped_mae(blended_prediction, target, source_groups)\n264:    linear_query_order = select_anchors(source, source_groups, seed, max(budgets), uniform)\n272:        models[budget] = (*ridge_fit(source[:, query_order[:budget]].astype(np.float64), target, strength), shrinkage)\n274:    particles = None\n277:        rasch_probs = fit_rasch(source_scores, source_groups)\n279:        particle_probs = make_particles(profile_probs, offset_scale)\n280:        particle_log_prior = particle_prior(source_groups)\n281:        particles = (particle_probs, particle_log_prior, particle_probs.sum(axis=1))\n282:    return query_order, models, mixture_weight, particles\n285:def handle(request):\n320:        if mode not in ('primary', 'no_diversity', 'no_calibration'):\n325:        source_groups = np.asarray(request['source_groups'])\n326:        if source_groups.shape != (len(source),) or not np.issubdtype(source_groups.dtype, np.integer):\n327:            raise ValueError('invalid source groups')\n328:        anchors, models, mixture_weight, particles = fit_models(source, source_groups, budgets, STATE['seed'], mode == 'no_diversity')\n332:        STATE['particles'] = particles\n351:        if STATE['mode'] == 'no_calibration':\n359:                particle_probs, particle_log_prior, totals = STATE['particles']\n360:                particle_prediction = predict_particles(particle_probs, particle_log_prior, totals, mixture_query_order, observations)\n361:                blended_prediction = (1.0 - mixture_weight) * linear_prediction + mixture_weight * particle_prediction\n","exit_code":0,"status":"completed"}}
