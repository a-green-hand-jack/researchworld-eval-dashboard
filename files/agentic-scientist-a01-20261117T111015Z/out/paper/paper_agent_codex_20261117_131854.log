le': 20, 'optimal': 52}), ('openllm', 'trimmed', 0.5, 67, {'infeasible': 5, 'optimal': 67}), ('openllm', 'mean', 1.0, 72, {'optimal': 72}), ('openllm', 'median', 1.0, 72, {'optimal': 72}), ('openllm', 'trimmed', 1.0, 72, {'optimal': 72})]\nsupport [('helm', 0.5, [14, 13, 13], {'mean': {'lower': 0.482584666795193, 'upper': 0.482584666795193}, 'median': {'lower': 0.017543859649122806, 'upper': 0.36437246963562747}, 'trimmed': {'lower': 0.20532099479467902, 'upper': 0.41350170297538713}}), ('helm', 1.0, [24, 24, 24], {'mean': {'lower': 0.27850877192982454, 'upper': 0.27850877192982454}, 'median': {'lower': 0.017543859649122806, 'upper': 0.3296783625730994}, 'trimmed': {'lower': 0.1530214424951267, 'upper': 0.3043372319688109}}), ('openllm', 0.5, [18, 17, 17], {'mean': {'lower': 0.6761074800290489, 'upper': 0.6761074800290489}, 'median': {'lower': 0.5675381263616558, 'upper': 0.5675381263616558}, 'trimmed': {'lower': 0.5675381263616558, 'upper': 0.5675381263616558}}), ('openllm', 1.0, [24, 24, 24], {'mean': {'lower': 0.3819444444444444, 'upper': 0.3819444444444444}, 'median': {'lower': 0.4837962962962963, 'upper': 0.4837962962962963}, 'trimmed': {'lower': 0.4212962962962963, 'upper': 0.4212962962962963}})]\npools {'helm': 60, 'openllm': 3057, 'bbh': 53}\n","exit_code":0,"status":"completed"}}
