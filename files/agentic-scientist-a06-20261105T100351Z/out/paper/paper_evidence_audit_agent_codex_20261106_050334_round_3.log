{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport ast,json,hashlib,random\nfrom pathlib import Path\nimport numpy as np\nmodule=ast.parse(Path('source_evidence/downstream/program/src/program.py').read_text())\ndefault=next(ast.literal_eval(node.value) for node in module.body if isinstance(node,ast.Assign) and any(isinstance(target,ast.Name) and target.id=='DEFAULT_PROMPT' for target in node.targets))\nfunction=next(node for node in module.body if isinstance(node,ast.FunctionDef) and node.name=='prompt_bank')\nvariants=ast.literal_eval(function.body[0].value)\nrows=json.loads(Path('source_evidence/resources/examples.json').read_text())\ndata=json.loads(Path('paper_data.json').read_text())\ndef digest(value):\n    return hashlib.sha256(json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()\nmatched=0\nmismatches=[]\nfor episode in data['final_evaluation']['evaluation_evidence']['episodes']:\n    seed=episode['seed']\n    for case in episode['solution']['cases']:\n        family=case['case'][0]\n        size,arms=map(int,case['case'][1:].split('K'))\n        if family=='S':keys=[digest(['slot',index]) for index in range(size)]\n        else:keys=[rows[int(index)]['content_hash'] for index in np.random.default_rng(seed).permutation(len(rows))[:size]]\n        random.Random(seed).shuffle(keys)\n        report=keys[size//2:]\n        plan={'prompts':[default]+variants,'selection':keys[:size//2],'report':report,'weights':[1/len(report)]*len(report),'tie_order':list(range(arms))}\n        if digest(plan)==case['plan_hash']:matched+=1\n        else:mismatches.append((seed,case['case']))\nprint('Source-defined plans match retained final plan hashes:',matched,'of 40; mismatches:',mismatches)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
