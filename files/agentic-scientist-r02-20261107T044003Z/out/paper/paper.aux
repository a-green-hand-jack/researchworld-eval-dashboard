\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Descriptive sign-stratum reliability in heteroskedastic and shifted conditions. Dots show each held-out seed and bars show means. Masks for different covariates overlap; their coverage rates are not simultaneous guarantees. The nominal line is a reference only. No empty-mask zero encodings are plotted.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:strata}{{3}{7}{Descriptive sign-stratum reliability in heteroskedastic and shifted conditions. Dots show each held-out seed and bars show means. Masks for different covariates overlap; their coverage rates are not simultaneous guarantees. The nominal line is a reference only. No empty-mask zero encodings are plotted}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Equal-weight contrasts across all six conditions. Positive values favor adaptive ILR. Intervals resample five paired seed blocks and retain all conditions together; few-seed percentile intervals are unstable and not multiplicity-adjusted. They are not per-condition error bars.}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:contrasts}{{2}{7}{Equal-weight contrasts across all six conditions. Positive values favor adaptive ILR. Intervals resample five paired seed blocks and retain all conditions together; few-seed percentile intervals are unstable and not multiplicity-adjusted. They are not per-condition error bars}{table.caption.8}{}}
