and Alex Gammerman},\n  year = {2002},\n  doi = {10.1007/3-540-36755-1_29},\n  journal = {Lecture Notes in Computer Science},\n  pages = {345-356}\n}\n\n@article{Lei2018,\n  title = {Distribution-Free Predictive Inference for Regression},\n  author = {Jing Lei and Max G’Sell and Alessandro Rinaldo and Ryan J. Tibshirani and Larry Wasserman},\n  year = {2018},\n  doi = {10.1080/01621459.2017.1307116},\n  journal = {Journal of the American Statistical Association},\n  volume = {113},\n  number = {523},\n  pages = {1094-1111}\n}\n\n@article{LeiWasserman2014,\n  title = {Distribution-free Prediction Bands for Non-parametric Regression},\n  author = {Jing Lei and Larry Wasserman},\n  year = {2013},\n  doi = {10.1111/rssb.12021},\n  journal = {Journal of the Royal Statistical Society Series B: Statistical Methodology},\n  volume = {76},\n  number = {1},\n  pages = {71-96}\n}\n\n@article{Aitchison1982,\n  title = {The Statistical Analysis of Compositional Data},\n  author = {J. Aitchison},\n  year = {1982},\n  doi = {10.1111/j.2517-6161.1982.tb01195.x},\n  journal = {Journal of the Royal Statistical Society Series B: Statistical Methodology},\n  volume = {44},\n  number = {2},\n  pages = {139-160}\n}\n\n@article{Egozcue2003,\n  title = {Isometric Logratio Transformations for Compositional Data Analysis},\n  author = {J. J. Egozcue and V. Pawlowsky-Glahn and G. Mateu-Figueras and C. Barceló-Vidal},\n  year = {2003},\n  doi = {10.1023/A:1023818214614},\n  journal = {Mathematical Geology},\n  volume = {35},\n  number = {3},\n  pages = {279-300}\n}\n\n@article{AitchisonShen1980,\n  title = {Logistic-normal distributions:Some properties and uses},\n  author = {J. ATCHISON and S.M. SHEN},\n  year = {1980},\n  doi = {10.1093/biomet/67.2.261},\n  journal = {Biometrika},\n  volume = {67},\n  number = {2},\n  pages = {261-272}\n}\n\n@article{KoenkerBassett1978,\n  title = {Regression Quantiles},\n  author = {Roger Koenker and Gilbert Bassett},\n  year = {1978},\n  doi = {10.2307/1913643},\n  journal = {Econometrica},\n  volume = {46},\n  number = {1},\n  pages = {33}\n}\n\n@article{KoenkerHallock2001,\n  title = {Quantile Regression},\n  author = {Roger Koenker and Kevin F Hallock},\n  year = {2001},\n  doi = {10.1257/jep.15.4.143},\n  journal = {Journal of Economic Perspectives},\n  volume = {15},\n  number = {4},\n  pages = {143-156}\n}\n\n@article{Friedman2001,\n  title = {Greedy function approximation: A gradient boosting machine.},\n  author = {Jerome H. Friedman},\n  year = {2001},\n  doi = {10.1214/aos/1013203451},\n  journal = {The Annals of Statistics},\n{\n  \"status\": \"ready\",\n  \"selected_prompt_family\": \"paper_standalone\",\n  \"recommended_title\": \"Local Residual Scaling for Compositional Conformal Prediction: Benefits and Limits\",\n  \"central_question\": \"When does training-only local residual scaling improve the coverage–reference-mass tradeoff of split-conformal regions for continuous compositions, and what do homoscedastic and covariate-shift controls reveal about its limits?\",\n  \"central_thesis\": \"In the evaluated logistic-normal settings, the frozen training-only scale-selection procedure improves measured coverage–reference-mass tradeoffs over global ILR calibration under boundary-concentrated heteroscedasticity, provides no consistent homoscedastic advantage, and performs favorably under the tested shift without establishing shifted-distribution validity or a contribution attributable specifically to quantile stumps.\",\n  \"narrative_rationale\": \"This is a controlled empirical study of a positive scale function inside a fixed compositional conformal construction, not a new geometry, universal reliability guarantee, or search-success narrative. Six final seed episodes provide matched global-ILR, raw-simplex and Bonferroni comparisons, two nominal levels, fixed subgroups, reference-mass estimates, controls, and paired aggregate uncertainty. The strong contrast between homoscedastic and boundary-concentrated heteroscedastic conditions supplies a coherent scientific question; shifted cases supply a limited stress test rather than another validity theorem. Direct source inspection identifies a complete ridge/constant/tail-blend selection procedure, but no selected-component diagnostics or matched final ridge-only comparison. Conditional empirical benefits therefore beat both a universal-superiority story and an unsupported stump-specific mechanism story. A latent-count bridge was not implemented and an interaction extension has no usable performance evidence. Publication-worthiness is a framing judgment, not an additional qualification result.\",\n  \"prior_paper_story_status\": \"recentered\",\n  \"edit_framing_decision\": \"Edit mode is not evidenced: no resolved edit-context file, previous_paper directory, aggregated directory, or extra_tasks directory is present. No prior manuscript is claimed to have been revised. The enum 'recentered' describes centering the broad source-task/proposal context on the actually evaluated local-scale procedure. Compared candidate framings were: preserve broad compositional reliability or latent-target motivation; broaden to a shared count-noise/interaction/scale family; recenter on matched residual-scale evidence. The first two exceed the implemented and evaluated scope; the third is selected.\",\n  \"staged_input_impact\": [\n    \"No prior manuscript or separate staged new/old implementation package was supplied; edit placeholders remain unresolved. Task and evaluated implementation files, rather than a prior title or figure plan, determine the story.\",\n    \"The final_evaluation object was read independently of downstream_study, which is absent. The declared qualification sources report completed, qualified, and true; this run has no failed final qualification to disclose. Candidate self-diagnostics are explicitly unverified, and unspecified gate diagnostics remain unknown.\",\n    \"Direct inspection of results/ideas/02_cross_fitted_tail_adaptive_residual_scaling/program_1/src/program.py and METHOD.md establishes the full training-only scale-selection family. The final result manifest and program-tree hash identify the frozen evaluated selection; no exact-byte hash match between the workspace source and frozen tree was independently recomputed, so source-to-final linkage is documented rather than newly cryptographically verified.\",\n    \"task/evaluate_final.py and task/resources/final/manifest.json establish H/B/S logistic-normal conditions in dimensions 3 and 10, distinct center/scale/calibration/test splits, shared centers, fixed groups and reference probes. These change the research scope from generic classifier probabilities to continuous simplex-valued responses.\",\n    \"The original quadratic-feature ridge scale is available as code and search context, but not as a matched repeated-final comparator. Do not substitute the global-ILR baseline for it or compare its search score to final scores. No study.* sources exist here, so do not report selection deltas or scored/unscored attempt counts as study-grounded findings.\"\n  ],\n  \"method_groups\": [\n    {\n      \"name\": \"Training-only local scale selection in ILR space\",\n      \"role\": \"proposed\",\n      \"include_reason\": \"The frozen evaluated procedure selects among a quadratic-feature ridge log-scale, a constant, and four ridge/tail log-space blends using three training folds, fitting-only alignment, and a one-standard-error heuristic. Describe and evaluate the entire procedure, not a proven quantile-stump winner.\"\n    },\n    {\n      \"name\": \"Global ILR split conformal\",\n      \"role\": \"baseline\",\n      \"include_reason\": \"Primary matched comparator: same training-only ridge center, ILR Euclidean residual geometry, calibration split and corrected rank, without covariate-dependent scaling. It isolates scale adaptivity more cleanly than cross-geometry comparisons and is not the original ridge-scale implementation.\"\n    },\n    {\n      \"name\": \"Raw-simplex L-infinity split conformal\",\n      \"role\": \"baseline\",\n      \"include_reason\": \"Grounded alternative representation and region shape, evaluated on the same target compositions, splits, centers and reference probes. It contextualizes the ILR comparison without claiming geometry is independently ablated.\"\n    },\n    {\n      \"name\": \"Coordinatewise Bonferroni regions\",\n      \"role\": \"baseline\",\n      \"include_reason\": \"Grounded simultaneous-coordinate comparator using corrected per-coordinate calibration at alpha divided by dimension; expose its coverage and reference-mass tradeoffs rather than reducing comparison to one aggregate score.\"\n    },\n    {\n      \"name\": \"Constant-scale and permuted-residual controls\",\n      \"role\": \"supporting\",\n      \"include_reason\": \"Training controls examine scale invariance and the dependence on covariate–residual alignment. Constant scale numerically reproduces global ILR; do not plot it as another independent baseline. Permuted residuals support an alignment interpretation but do not isolate stumps, blend weights, or the selection rule.\"\n    },\n    {\n      \"name\": \"Calibration and degenerate-region sanity comparators\",\n      \"role\": \"supporting\",\n      \"include_reason\": \"Uncalibrated residual quantiles, the full simplex and a singleton center are available for supplementary checks of coverage–mass interpretation. They are not competing learned methods and need not dominate the main narrative.\"\n    }\n  ],\n  \"results_focus\": [\n    \"Main comparison: four scientifically meaningful methods, grouped by homoscedastic (H), boundary-concentrated heteroscedastic (B), and shifted heteroscedastic (S) conditions, with dimension 3 versus 10 treated as adaptations under one thesis rather than independent experiments.\",\n    \"Show coverage at nominal 0.95 and 0.90 separately, not only absolute errors. Show reference mass separately from coverage so that an apparently small region cannot hide undercoverage. Efficiency is probability mass under the fixed mixed probe distribution, not geometric volume, expected cardinality, or a distribution-free quantity.\",\n    \"Keep fixed-subgroup evidence in the main paper: a compact six-condition table compares the local procedure, global ILR and permuted-residual control using mean absolute subgroup coverage error over both groups and both levels. Supporting tables retain the signed per-group, per-level coverage and per-seed Wilson intervals; empirical group diagnostics are not conditional guarantees.\",\n    \"Homoscedastic cases show little benefit and small aggregate-utility disadvantages relative to global ILR; do not omit them. Boundary heteroscedastic cases support the strongest joint subgroup-error/reference-mass comparison. Boundary concentration and heteroscedasticity change together, so neither factor is independently causally identified.\",\n    \"Shifted cases have favorable observed coverage relative to the matched global comparator, but exchangeability is not supplied by the unweighted algorithm. In shifted dimension 3 the local method has larger reference mass than global ILR, so do not claim uniformly smaller regions or a free efficiency gain.\",\n    \"An aggregate main-text table may report mean utility 0.8772268474776957 with its stored 95% seed-bootstrap interval [0.8766236679621646, 0.8781275287778212], mean marginal absolute coverage error 0.011729600694444453, mean fixed-group absolute coverage error 0.015105333854689552, and reference mass 0.4508402082655165, with sensible rounding. Sources: final.metric.* entries with matching names. Define utility from evaluator code as 1 - [0.375 marginal error + 0.375 group error + 0.25 reference mass]; it is a chosen evaluation weighting, not universal reliability.\",\n    \"The aggregate local-minus-global utility difference is 0.04762325792650014 (final.metric.global_ilr_score_gap); its stored paired six-seed bootstrap interval is [0.043901240346666696, 0.050616967867983816] (final.evidence.episodes). Interpret it as a fixed-six-case aggregate, not evidence of per-case superiority or proof that stumps improve the original ridge-scale method.\",\n    \"Final uncertainty uses six seeds [1009, 2003, 3001, 4001, 5003, 6007] and stored 2000-resample paired seed-bootstrap intervals. Repeated copies of the same aggregate interval inside episodes are one estimate, not six independent estimates. Coverage Wilson intervals describe within-seed test hits; do not average interval endpoints or use a mass Wilson interval as an independent-query population interval.\"\n  ],\n  \"figure_plan\": [\n    \"Figure 1, early conceptual overview: interior-simplex response -> ILR center and training-only positive scale -> held-out normalized-score calibration -> separate coverage, subgroup and reference-mass evaluation; mark the shifted condition outside the exchangeability guarantee.\",\n    \"Figure 2, main reliability comparison: four panels in a 2-by-2 grid for dimension and nominal level, comparing the four main methods across H/B/S with all six seed points and an arithmetic-mean marker. Nominal coverage is a horizontal line, not an attainment-rate label.\",\n    \"Figure 3, companion efficiency comparison: two dimension panels comparing reference mass across H/B/S and the same four methods, explicitly averaged over the two nominal levels within each seed. Read alongside Figure 2 and the main subgroup table, never as a standalone superiority ranking.\"\n  ],\n  \"figure_specs\": [\n    {\n      \"figure_id\": \"conceptual_overview\",\n      \"required\": true,\n      \"purpose\": \"Make the target, training/calibration separation, learned scale, and limited meaning of the evidence legible before quantitative results.\",\n      \"figure_type\": \"diagram\",\n      \"preferred_generator\": \"generate-concept-figure\",\n      \"group_by\": \"scientific_object_and_information_split\",\n      \"metric\": \"not_applicable_conceptual_only\",\n      \"split_by\": \"training_calibration_and_evaluation_roles\",\n      \"preferred_span\": \"full_width\",\n      \"target_width_fraction\": 1.0,\n      \"layout_rationale\": \"The inspected ICLR paper.sty gives one 5.5-inch text column and a 9-inch text height; full width is also column width here. Target a 5.5-by-1.9-inch overview on page 1 or 2, about 0.25 page including caption. One left-to-right schematic with at most six short labeled blocks and a shift caveat is readable at 9-point text; avoid mini-panels, data-shaped decorative regions and invented observations.\",\n      \"allow_progression\": false,\n      \"max_panels\": 1,\n      \"max_panels_per_row\": 1,\n      \"max_categories_per_panel\": 6,\n      \"max_series_per_panel\": 4\n    },\n    {\n      \"figure_id\": \"coverage_by_condition\",\n      \"required\": true,\n      \"purpose\": \"Expose condition-dependent empirical reliability, both nominal levels, and the absence of a uniform advantage.\",\n      \"figure_type\": \"faceted_seed_dot_plot\",\n      \"preferred_generator\": \"matplotlib\",\n      \"group_by\": \"H_B_S_condition\",\n      \"metric\": \"empirical_joint_composition_coverage\",\n      \"split_by\": \"dimension_3_or_10_and_nominal_coverage_0.95_or_0.90\",\n      \"preferred_span\": \"full_width\",\n      \"target_width_fraction\": 1.0,\n      \"layout_rationale\": \"Use the full 5.5-inch single-column width, approximately 4.2 inches high, about 0.55 page including caption. Four panels in two rows leave each plotting area roughly 2.5 inches wide; restrict to three condition labels, four method colors, six small offset seed dots per method and one shared legend. Labels at least 9 points, ticks at least 8 points; use the same coverage axis across panels and avoid connecting H/B/S as a trajectory. Show seed variability rather than inventing condition-specific bootstrap intervals.\",\n      \"allow_progression\": false,\n      \"max_panels\": 4,\n      \"max_panels_per_row\": 2,\n      \"max_categories_per_panel\": 3,\n      \"max_series_per_panel\": 4\n    },\n    {\n      \"figure_id\": \"reference_mass_by_condition\",\n      \"required\": true,\n      \"purpose\": \"Compare the specific measured size proxy without hiding coverage failures or the shifted dimension-3 mass increase.\",\n      \"figure_type\": \"faceted_seed_dot_plot\",\n      \"preferred_generator\": \"matplotlib\",\n      \"group_by\": \"H_B_S_condition\",\n      \"metric\": \"reference_mass_averaged_over_nominal_levels_within_seed\",\n      \"split_by\": \"dimension_3_or_10\",\n      \"preferred_span\": \"full_width\",\n","exit_code":0,"status":"completed"}}
