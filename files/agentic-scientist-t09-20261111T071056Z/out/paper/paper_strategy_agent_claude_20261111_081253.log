{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XC7nkgpeNDG65pAVL9P8W9","type":"tool_result","content":"#!/usr/bin/env python3\n\"\"\"search-plane evaluator: regression-based GATE estimation under network interference.\n\nSelf-contained: needs only numpy/scipy, the search resource root (``resources/search``) and\nthe harness broker.  The evaluator generates every instance itself, keeps the interference\nmechanism and the true GATE private, runs four evaluator-owned baselines, and sends the\ncandidate (through ``handle``) only the permitted dataset fields.  Per episode: exactly one\n``reset`` followed by four ``estimate`` requests (primary dataset + three matched negative\ncontrols, evaluator-private order), plus one mandatory trailing replay episode.\n\nAggregation (declared before evaluation): per primary episode e = min(|est-G|/|G|, 2);\na failed/missing episode takes e = 2 (signed +2, not covered, width 4); per-case RMSE over the\nplane's seeds (equal seed weights); plane score = unweighted mean over the 8 cases (weight 1/8);\ncombined_score = -mean.  Controls and the replay never enter combined_score.\n\"\"\"\n\nimport os\n\nfor _name in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\"):\n    os.environ.setdefault(_name, \"2\")\n\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport re\nimport resource\nimport selectors\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nimport scipy.sparse as sp\n\nPLANE = \"search\"\nSEEDS = [101, 102, 103, 104, 105, 106, 107, 108]\nWALL_SECONDS = 1800\nMAX_CANDIDATE_RPC_CALLS = 400\n\nBROKER_PROXY_PATH = \"/broker-code/candidate_proxy.py\"\nWIRE_LIMIT = 64 * 1024 * 1024\nPAYLOAD_TARGET = 8 * 1024 * 1024\nN_CASES = 8\nOPS_PER_EPISODE = 5  # 1 reset + 4 estimate\n\nSTARTUP_ALLOWANCE = 30.0\nFINISH_RESERVE = 20.0\nRESET_TIMEOUT = 4.0\nESTIMATE_TIMEOUT = 3.0\nSOFT_OP_SECONDS = 2.5\n# terminate/kill/reap of the candidate (2 waits) + dispatch/bookkeeping/transition\nEPISODE_OVERHEAD = 4.0\n        self.deg = np.asarray(self.adj.sum(axis=1)).ravel()\n        self.adj2 = two_hop(self.adj) if need_two_hop else None\n        self.deg2 = np.asarray(self.adj2.sum(axis=1)).ravel() if need_two_hop else None\n\n\ndef mean_outcome(mech, x, g, z):\n    \"\"\"Noise-free potential-outcome mean for assignment vector ``z`` (privileged).\"\"\"\n    own = (mech[\"tau0\"] + mech[\"tau1\"] * x[:, 0]) * z\n    base = mech[\"intercept\"] + x @ np.asarray(mech[\"beta\"]) + own\n    form = mech[\"form\"]\n    count = g.adj @ z\n    e1 = count / np.maximum(g.deg, 1.0)\n    if form == \"fraction\":\n        extra = mech[\"gamma\"] * e1\n    elif form == \"fraction_2hop\":\n        e2 = (g.adj2 @ z) / np.maximum(g.deg2, 1.0)\n        extra = mech[\"gamma\"] * e1 + mech[\"gamma2\"] * e2\n    elif form == \"sigmoid\":\n        extra = mech[\"gamma\"] / (1.0 + np.exp(-mech[\"steepness\"] * (e1 - mech[\"center\"])))\n    elif form == \"count_deg\":\n        extra = mech[\"kappa\"] * count * np.sqrt(mech[\"m_ref\"] / np.maximum(g.deg, 1.0))\n    else:\n        raise ValueError(\"unknown mechanism form\")\n    return base + extra\n\n\ndef sha(*chunks):\n    h = hashlib.sha256()\n    for chunk in chunks:\n        h.update(chunk)\n    return h.hexdigest()\n    perm_rel = []\n    for case in range(1, N_CASES + 1):\n        rs = [r for r in primary if r[\"case\"] == case]\n        bias.append(abs(sum(signed_error(None if r[\"primary\"] is None else r[\"primary\"][0], r[\"gate\"])\n                            for r in rs) / len(rs)))\n        c, w, pr = [], [], []\n        for r in rs:\n            if r[\"primary\"] is None or r[\"gate\"] is None:\n                c.append(0.0)\n                w.append(WIDTH_CAP)\n            else:\n                _, lo, hi = r[\"primary\"]\n                c.append(1.0 if lo <= r[\"gate\"] <= hi else 0.0)\n                w.append(min((hi - lo) / abs(r[\"gate\"]), WIDTH_CAP))\n            pe = r[\"ctrl\"][\"perm_outcome\"]\n            pr.append(REL_CAP if pe is None or r[\"gate\"] is None else min(abs(pe) / abs(r[\"gate\"]), REL_CAP))\n        cover.append(sum(c) / len(c))\n        width.append(sum(w) / len(w))\n        perm_rel.append(sum(pr) / len(pr))\n    base = {}\n    for name in BASELINES:\n        base[name], _ = plane_rmse(primary, lambda r, name=name: r[\"base\"][name])\n    graph_rmse, _ = plane_rmse(primary, lambda r: r[\"ctrl\"][\"perm_graph\"])\n    const_vals = [CONST_ABS_WORST if r[\"ctrl\"][\"constant\"] is None else abs(r[\"ctrl\"][\"constant\"])\n                  for r in records]\n    if (replay_record[\"primary\"] is None or first_record[\"primary\"] is None):\n        replay_diff = REPLAY_WORST\n    else:\n        replay_diff = abs(replay_record[\"primary\"][0] - first_record[\"primary\"][0])\n    failed = sum(1 for r in primary if r[\"ok_ops\"] < len(OPS))\n    metrics = {\n        \"combined_score\": -rmse, \"rmse_rel\": rmse,\n        \"bias_rel_abs_mean\": sum(bias) / len(bias),\n        \"ci_coverage\": sum(cover) / len(cover),\n        \"ci_width_rel\": sum(width) / len(width),\n        \"baseline_dim_rmse_rel\": base[\"dim\"], \"baseline_linear_rmse_rel\": base[\"linear\"],\n        \"baseline_ht_rmse_rel\": base[\"ht\"], \"baseline_oracle_rmse_rel\": base[\"oracle\"],\n        \"ratio_to_linear_baseline\": rmse / max(base[\"linear\"], 1e-9),\n        \"ratio_to_dim_baseline\": rmse / max(base[\"dim\"], 1e-9),\n        \"control_constant_max_abs_est\": max(const_vals),\n        \"control_permuted_outcome_mean_abs_rel_est\": sum(perm_rel) / len(perm_rel),\n        \"control_permuted_graph_rmse_rel\": graph_rmse,\n        \"control_vacuity_violations\": float(sum(r[\"vacuity\"] for r in records)),\n        \"missing_or_failed_episodes\": float(failed),\n        \"replay_abs_diff\": replay_diff,\n    }\n    for k, value in enumerate(per_case, start=1):\n        metrics[f\"rmse_rel_case_{k}\"] = value\n    if set(metrics) != set(METRIC_NAMES) or not all(math.isfinite(v) for v in metrics.values()):\n        raise ValueError(\"invalid metric record\")\n    return {name: float(metrics[name]) for name in METRIC_NAMES}\n\n\n# ----------------------------------------------------------------------------------------\n# setup / main\n# ----------------------------------------------------------------------------------------\nprogram.py\n\"\"\"Regression-based GATE estimator under network interference (starter candidate).\n\nInterface: ``python_rpc_v1:handle``.  ``handle(request) -> response`` takes and returns\nfinite JSON-compatible values only.  The candidate owns all of its state in memory; it\nshares no filesystem with the evaluator and must not read or write evaluator paths.\n\nOperations\n----------\n``{\"op\": \"reset\", \"seed\": <int >= 0>}``\n    Clears ALL candidate state and seeds the candidate RNG.  The seed only initializes\n    randomness; it never identifies a plane, case or workload.  Any non-negative integer\n    is valid.  Response: exactly ``{\"ok\": true}`` (no other keys).\n\n``{\"op\": \"estimate\", ...}``\n    One full dataset from one randomized experiment on a network.  The evaluator sends\n    exactly one ``reset`` per episode and then four ``estimate`` requests in an\n    evaluator-private order.  All four have the identical format and size and the same\n    budget; the candidate must treat every request as an ordinary dataset and must not\n    try to detect which one is which.  Each ``estimate`` is independent: return the best\n    estimate for the request in hand.\n\n    Request fields (all present, no others):\n      op         \"estimate\"\n      n          int, number of nodes (nodes are 0..n-1)\n      edges      array object, undirected unique edges (u < v), dtype int32, shape [E, 2]\n      covariates array object, node covariates, dtype float64, shape [n, 2]\n      treatment  array object, realized treatment assignment, dtype uint8 (0/1), shape [n]\n      outcomes   array object, observed outcomes, dtype float64, shape [n]\n      design     {\"kind\": \"bernoulli\" | \"cluster\",\n                  \"probability\": float,   # marginal treatment probability of the design\n                  \"cluster_labels\": array object (int32, shape [n]) or null}\n                 \"bernoulli\": each node treated independently with ``probability``.\n                 \"cluster\":   whole clusters (``cluster_labels``) are treated together;\n                              exactly round(K*probability) of the K clusters are treated,\n                              chosen uniformly at random.\n      workload   {\"max_op_seconds\": float,  # soft per-request time budget (hard cap is a\n                                            # little larger; exceeding it fails the episode)\n                  \"ci_level\": float}        # nominal level of the requested interval\n\n    Array objects are ``{\"dtype\": \"<name>\", \"shape\": [...], \"encoding\": \"base64-le\",\n    \"data\": \"<base64 of the C-order little-endian buffer>\"}``; see ``decode_array``.\n\n    Target: the global average treatment effect (GATE), i.e. the mean over nodes of\n    Y_i(all nodes treated) - Y_i(all nodes control) for the (hidden) potential outcomes.\n    The interference mechanism, its parameters and the true GATE are never revealed.\n\n    Response (JSON object): required keys ``estimate``, ``ci_low``, ``ci_high``\n    (finite numbers with ci_low <= estimate <= ci_high); optional key ``diagnostics``\n    (a JSON object, at most 4096 bytes serialized; ignored for scoring).  Any other key,\n    a non-finite number, a malformed type or an interval that does not contain the\n    estimate makes that request invalid (the episode keeps its worst-case contribution).\n\nLimits (enforced by the evaluator; a violation is a failed request, never retried):\n  * ``reset`` must answer within 4 s (it includes process/import start-up);\n  * each ``estimate`` must answer within 3 s wall clock (``workload.max_op_seconds`` = 2.5 s\n    is the soft budget to aim for); at most 4 threads of CPU are available;\n  * a complete request is below 0.5 MiB and a complete response must stay far below the\n    64 MiB wire limit (a valid response is < 5 KiB);\n  * no filesystem or network is shared with the evaluator; do not read or write evaluator paths.\nDeterminism: all candidate randomness must derive from the ``reset`` seed, because the evaluator\nreplays one episode after a fresh ``reset`` and requires the primary estimate to agree to 1e-6\n(relative to max(1, |estimate|)).\n\nScoring (evaluator-owned): per episode relative error min(|estimate - GATE| / |GATE|, 2),\na failed/invalid request counts as 2 (and as \"not covered\" with worst-case width);\nRMSE over seeds per case, mean over the 8 cases, ``combined_score`` = -that mean.\nThe evaluator additionally runs matched negative controls (permuted outcomes, node-relabelled\ngraph, constant outcome) through the same operation; a constant-outcome request must\nreturn an estimate within 1e-4 of 0, and the run must be deterministic given the reset seed.\n\"\"\"\n\nimport base64\n\nimport numpy as np\nimport scipy.sparse as sp\n\n_STATE = {\"rng\": None, \"seed\": None}\n\n_DTYPES = {\"int32\": \"<i4\", \"float64\": \"<f8\", \"uint8\": \"u1\"}\n\n\ndef decode_array(obj):\n    \"\"\"Decode an array object (see module docstring) into a numpy array.\"\"\"\n    if obj is None:\n        return None\n    if obj[\"encoding\"] != \"base64-le\" or obj[\"dtype\"] not in _DTYPES:\n        raise ValueError(\"unsupported array encoding\")\n    buf = base64.b64decode(obj[\"data\"])\n    return np.frombuffer(buf, dtype=np.dtype(_DTYPES[obj[\"dtype\"]])).reshape(obj[\"shape\"]).copy()\n\n\ndef _adjacency(n, edges):\n    if len(edges) == 0:\n        return sp.csr_matrix((n, n))\n    u, v = edges[:, 0], edges[:, 1]\n    rows = np.concatenate([u, v])\n    cols = np.concatenate([v, u])\n    return sp.csr_matrix((np.ones(len(rows)), (rows, cols)), shape=(n, n))\n\n\ndef _features(adj, deg, z, x, treated_all):\n    \"\"\"Design matrix [1, own treatment, neighbour-treated fraction, covariates].\"\"\"\n    if treated_all is None:\n        frac = (adj @ z) / np.maximum(deg, 1.0)\n        own = z\n    else:\n        frac = np.where(deg > 0, float(treated_all), 0.0)\n        own = np.full(len(z), float(treated_all))\n    return np.column_stack([np.ones(len(z)), own, frac, x])\n\n\ndef _parse(request):\n    n = int(request[\"n\"])\n    edges = decode_array(request[\"edges\"])\n    x = decode_array(request[\"covariates\"])\n    z = decode_array(request[\"treatment\"]).astype(np.float64)\n    y = decode_array(request[\"outcomes\"])\n    adj = _adjacency(n, edges)\n    deg = np.asarray(adj.sum(axis=1)).ravel()\n    return n, x, z, y, adj, deg","is_error":false}]},"parent_tool_use_id":null,"session_id":"4581458c-0466-42c1-a7f4-b485a5a4f923","uuid":"79166f98-f1a9-47fc-9b06-a66caa02a7cc","timestamp":"2026-11-11T08:15:31.758Z","tool_use_result":{"stdout":"#!/usr/bin/env python3\n\"\"\"search-plane evaluator: regression-based GATE estimation under network interference.\n\nSelf-contained: needs only numpy/scipy, the search resource root (``resources/search``) and\nthe harness broker.  The evaluator generates every instance itself, keeps the interference\nmechanism and the true GATE private, runs four evaluator-owned baselines, and sends the\ncandidate (through ``handle``) only the permitted dataset fields.  Per episode: exactly one\n``reset`` followed by four ``estimate`` requests (primary dataset + three matched negative\ncontrols, evaluator-private order), plus one mandatory trailing replay episode.\n\nAggregation (declared before evaluation): per primary episode e = min(|est-G|/|G|, 2);\na failed/missing episode takes e = 2 (signed +2, not covered, width 4); per-case RMSE over the\nplane's seeds (equal seed weights); plane score = unweighted mean over the 8 cases (weight 1/8);\ncombined_score = -mean.  Controls and the replay never enter combined_score.\n\"\"\"\n\nimport os\n\nfor _name in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\"):\n    os.environ.setdefault(_name, \"2\")\n\nimport argparse\nimport base64\nimport collections\nimport hashlib\nimport importlib.util\nimport json\nimport math\nimport re\nimport resource\nimport selectors\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nimport scipy.sparse as sp\n\nPLANE = \"search\"\nSEEDS = [101, 102, 103, 104, 105, 106, 107, 108]\nWALL_SECONDS = 1800\nMAX_CANDIDATE_RPC_CALLS = 400\n\nBROKER_PROXY_PATH = \"/broker-code/candidate_proxy.py\"\nWIRE_LIMIT = 64 * 1024 * 1024\nPAYLOAD_TARGET = 8 * 1024 * 1024\nN_CASES = 8\nOPS_PER_EPISODE = 5  # 1 reset + 4 estimate\n\nSTARTUP_ALLOWANCE = 30.0\nFINISH_RESERVE = 20.0\nRESET_TIMEOUT = 4.0\nESTIMATE_TIMEOUT = 3.0\nSOFT_OP_SECONDS = 2.5\n# terminate/kill/reap of the candidate (2 waits) + dispatch/bookkeeping/transition\nEPISODE_OVERHEAD = 4.0\n        self.deg = np.asarray(self.adj.sum(axis=1)).ravel()\n        self.adj2 = two_hop(self.adj) if need_two_hop else None\n        self.deg2 = np.asarray(self.adj2.sum(axis=1)).ravel() if need_two_hop else None\n\n\ndef mean_outcome(mech, x, g, z):\n    \"\"\"Noise-free potential-outcome mean for assignment vector ``z`` (privileged).\"\"\"\n    own = (mech[\"tau0\"] + mech[\"tau1\"] * x[:, 0]) * z\n    base = mech[\"intercept\"] + x @ np.asarray(mech[\"beta\"]) + own\n    form = mech[\"form\"]\n    count = g.adj @ z\n    e1 = count / np.maximum(g.deg, 1.0)\n    if form == \"fraction\":\n        extra = mech[\"gamma\"] * e1\n    elif form == \"fraction_2hop\":\n        e2 = (g.adj2 @ z) / np.maximum(g.deg2, 1.0)\n        extra = mech[\"gamma\"] * e1 + mech[\"gamma2\"] * e2\n    elif form == \"sigmoid\":\n        extra = mech[\"gamma\"] / (1.0 + np.exp(-mech[\"steepness\"] * (e1 - mech[\"center\"])))\n    elif form == \"count_deg\":\n        extra = mech[\"kappa\"] * count * np.sqrt(mech[\"m_ref\"] / np.maximum(g.deg, 1.0))\n    else:\n        raise ValueError(\"unknown mechanism form\")\n    return base + extra\n\n\ndef sha(*chunks):\n    h = hashlib.sha256()\n    for chunk in chunks:\n        h.update(chunk)\n    return h.hexdigest()\n    perm_rel = []\n    for case in range(1, N_CASES + 1):\n        rs = [r for r in primary if r[\"case\"] == case]\n        bias.append(abs(sum(signed_error(None if r[\"primary\"] is None else r[\"primary\"][0], r[\"gate\"])\n                            for r in rs) / len(rs)))\n        c, w, pr = [], [], []\n        for r in rs:\n            if r[\"primary\"] is None or r[\"gate\"] is None:\n                c.append(0.0)\n                w.append(WIDTH_CAP)\n            else:\n                _, lo, hi = r[\"primary\"]\n                c.append(1.0 if lo <= r[\"gate\"] <= hi else 0.0)\n                w.append(min((hi - lo) / abs(r[\"gate\"]), WIDTH_CAP))\n            pe = r[\"ctrl\"][\"perm_outcome\"]\n            pr.append(REL_CAP if pe is None or r[\"gate\"] is None else min(abs(pe) / abs(r[\"gate\"]), REL_CAP))\n        cover.append(sum(c) / len(c))\n        width.append(sum(w) / len(w))\n        perm_rel.append(sum(pr) / len(pr))\n    base = {}\n    for name in BASELINES:\n        base[name], _ = plane_rmse(primary, lambda r, name=name: r[\"base\"][name])\n    graph_rmse, _ = plane_rmse(primary, lambda r: r[\"ctrl\"][\"perm_graph\"])\n    const_vals = [CONST_ABS_WORST if r[\"ctrl\"][\"constant\"] is None else abs(r[\"ctrl\"][\"constant\"])\n                  for r in records]\n    if (replay_record[\"primary\"] is None or first_record[\"primary\"] is None):\n        replay_diff = REPLAY_WORST\n    else:\n        replay_diff = abs(replay_record[\"primary\"][0] - first_record[\"primary\"][0])\n    failed = sum(1 for r in primary if r[\"ok_ops\"] < len(OPS))\n    metrics = {\n        \"combined_score\": -rmse, \"rmse_rel\": rmse,\n        \"bias_rel_abs_mean\": sum(bias) / len(bias),\n        \"ci_coverage\": sum(cover) / len(cover),\n        \"ci_width_rel\": sum(width) / len(width),\n        \"baseline_dim_rmse_rel\": base[\"dim\"], \"baseline_linear_rmse_rel\": base[\"linear\"],\n        \"baseline_ht_rmse_rel\": base[\"ht\"], \"baseline_oracle_rmse_rel\": base[\"oracle\"],\n        \"ratio_to_linear_baseline\": rmse / max(base[\"linear\"], 1e-9),\n        \"ratio_to_dim_baseline\": rmse / max(base[\"dim\"], 1e-9),\n        \"control_constant_max_abs_est\": max(const_vals),\n        \"control_permuted_outcome_mean_abs_rel_est\": sum(perm_rel) / len(perm_rel),\n        \"control_permuted_graph_rmse_rel\": graph_rmse,\n        \"control_vacuity_violations\": float(sum(r[\"vacuity\"] for r in records)),\n        \"missing_or_failed_episodes\": float(failed),\n        \"replay_abs_diff\": replay_diff,\n    }\n    for k, value in enumerate(per_case, start=1):\n        metrics[f\"rmse_rel_case_{k}\"] = value\n    if set(metrics) != set(METRIC_NAMES) or not all(math.isfinite(v) for v in metrics.values()):\n        raise ValueError(\"invalid metric record\")\n    return {name: float(metrics[name]) for name in METRIC_NAMES}\n\n\n# ----------------------------------------------------------------------------------------\n# setup / main\n# ----------------------------------------------------------------------------------------\nprogram.py\n\"\"\"Regression-based GATE estimator under network interference (starter candidate).\n\nInterface: ``python_rpc_v1:handle``.  ``handle(request) -> response`` takes and returns\nfinite JSON-compatible values only.  The candidate owns all of its state in memory; it\nshares no filesystem with the evaluator and must not read or write evaluator paths.\n\nOperations\n----------\n``{\"op\": \"reset\", \"seed\": <int >= 0>}``\n    Clears ALL candidate state and seeds the candidate RNG.  The seed only initializes\n    randomness; it never identifies a plane, case or workload.  Any non-negative integer\n    is valid.  Response: exactly ``{\"ok\": true}`` (no other keys).\n\n``{\"op\": \"estimate\", ...}``\n    One full dataset from one randomized experiment on a network.  The evaluator sends\n    exactly one ``reset`` per episode and then four ``estimate`` requests in an\n    evaluator-private order.  All four have the identical format and size and the same\n    budget; the candidate must treat every request as an ordinary dataset and must not\n    try to detect which one is which.  Each ``estimate`` is independent: return the best\n    estimate for the request in hand.\n\n    Request fields (all present, no others):\n      op         \"estimate\"\n      n          int, number of nodes (nodes are 0..n-1)\n      edges      array object, undirected unique edges (u < v), dtype int32, shape [E, 2]\n      covariates array object, node covariates, dtype float64, shape [n, 2]\n      treatment  array object, realized treatment assignment, dtype uint8 (0/1), shape [n]\n      outcomes   array object, observed outcomes, dtype float64, shape [n]\n      design     {\"kind\": \"bernoulli\" | \"cluster\",\n                  \"probability\": float,   # marginal treatment probability of the design\n                  \"cluster_labels\": array object (int32, shape [n]) or null}\n                 \"bernoulli\": each node treated independently with ``probability``.\n                 \"cluster\":   whole clusters (``cluster_labels``) are treated together;\n                              exactly round(K*probability) of the K clusters are treated,\n                              chosen uniformly at random.\n      workload   {\"max_op_seconds\": float,  # soft per-request time budget (hard cap is a\n                                            # little larger; exceeding it fails the episode)\n                  \"ci_level\": float}        # nominal level of the requested interval\n\n    Array objects are ``{\"dtype\": \"<name>\", \"shape\": [...], \"encoding\": \"base64-le\",\n    \"data\": \"<base64 of the C-order little-endian buffer>\"}``; see ``decode_array``.\n\n    Target: the global average treatment effect (GATE), i.e. the mean over nodes of\n    Y_i(all nodes treated) - Y_i(all nodes control) for the (hidden) potential outcomes.\n    The interference mechanism, its parameters and the true GATE are never revealed.\n\n    Response (JSON object): required keys ``estimate``, ``ci_low``, ``ci_high``\n    (finite numbers with ci_low <= estimate <= ci_high); optional key ``diagnostics``\n    (a JSON object, at most 4096 bytes serialized; ignored for scoring).  Any other key,\n    a non-finite number, a malformed type or an interval that does not contain the\n    estimate makes that request invalid (the episode keeps its worst-case contribution).\n\nLimits (enforced by the evaluator; a violation is a failed request, never retried):\n  * ``reset`` must answer within 4 s (it includes process/import start-up);\n  * each ``estimate`` must answer within 3 s wall clock (``workload.max_op_seconds`` = 2.5 s\n    is the soft budget to aim for); at most 4 threads of CPU are available;\n  * a complete request is below 0.5 MiB and a complete response must stay far below the\n    64 MiB wire limit (a valid response is < 5 KiB);\n  * no filesystem or network is shared with the evaluator; do not read or write evaluator paths.\nDeterminism: all candidate randomness must derive from the ``reset`` seed, because the evaluator\nreplays one episode after a fresh ``reset`` and requires the primary estimate to agree to 1e-6\n(relative to max(1, |estimate|)).\n\nScoring (evaluator-owned): per episode relative error min(|estimate - GATE| / |GATE|, 2),\na failed/invalid request counts as 2 (and as \"not covered\" with worst-case width);\nRMSE over seeds per case, mean over the 8 cases, ``combined_score`` = -that mean.\nThe evaluator additionally runs matched negative controls (permuted outcomes, node-relabelled\ngraph, constant outcome) through the same operation; a constant-outcome request must\nreturn an estimate within 1e-4 of 0, and the run must be deterministic given the reset seed.\n\"\"\"\n\nimport base64\n\nimport numpy as np\nimport scipy.sparse as sp\n\n_STATE = {\"rng\": None, \"seed\": None}\n\n_DTYPES = {\"int32\": \"<i4\", \"float64\": \"<f8\", \"uint8\": \"u1\"}\n\n\ndef decode_array(obj):\n    \"\"\"Decode an array object (see module docstring) into a numpy array.\"\"\"\n    if obj is None:\n        return None\n    if obj[\"encoding\"] != \"base64-le\" or obj[\"dtype\"] not in _DTYPES:\n        raise ValueError(\"unsupported array encoding\")\n    buf = base64.b64decode(obj[\"data\"])\n    return np.frombuffer(buf, dtype=np.dtype(_DTYPES[obj[\"dtype\"]])).reshape(obj[\"shape\"]).copy()\n\n\ndef _adjacency(n, edges):\n    if len(edges) == 0:\n        return sp.csr_matrix((n, n))\n    u, v = edges[:, 0], edges[:, 1]\n    rows = np.concatenate([u, v])\n    cols = np.concatenate([v, u])\n    return sp.csr_matrix((np.ones(len(rows)), (rows, cols)), shape=(n, n))\n\n\ndef _features(adj, deg, z, x, treated_all):\n    \"\"\"Design matrix [1, own treatment, neighbour-treated fraction, covariates].\"\"\"\n    if treated_all is None:\n        frac = (adj @ z) / np.maximum(deg, 1.0)\n        own = z\n    else:\n        frac = np.where(deg > 0, float(treated_all), 0.0)\n        own = np.full(len(z), float(treated_all))\n    return np.column_stack([np.ones(len(z)), own, frac, x])\n\n\ndef _parse(request):\n    n = int(request[\"n\"])\n    edges = decode_array(request[\"edges\"])\n    x = decode_array(request[\"covariates\"])\n    z = decode_array(request[\"treatment\"]).astype(np.float64)\n    y = decode_array(request[\"outcomes\"])\n    adj = _adjacency(n, edges)\n    deg = np.asarray(adj.sum(axis=1)).ravel()\n    return n, x, z, y, adj, deg","stderr":"","interrupted":f