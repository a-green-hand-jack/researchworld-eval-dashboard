{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"nl -ba source_evidence/evaluate_final.py | sed -n '566,624p'; nl -ba source_evidence/evaluate_final.py | sed -n '670,738p'\"","aggregated_output":"   566\tdef basis(dimension):\n   567\t    result = np.zeros((dimension, dimension - 1))\n   568\t    for index in range(dimension - 1):\n   569\t        result[:index + 1, index] = 1 / math.sqrt((index + 1) * (index + 2))\n   570\t        result[index + 1, index] = -(index + 1) / math.sqrt((index + 1) * (index + 2))\n   571\t    return result\n   572\t\n   573\t\n   574\tdef simplex(latent, matrix):\n   575\t    logits = latent @ matrix.T\n   576\t    logits -= logits.max(axis=-1, keepdims=True)\n   577\t    probabilities = np.exp(logits)\n   578\t    return probabilities / probabilities.sum(axis=-1, keepdims=True)\n   579\t\n   580\t\n   581\tdef quantile(values, alpha):\n   582\t    rank = math.ceil((len(values) + 1) * (1 - alpha))\n   583\t    if rank > len(values):\n   584\t        return np.full(np.shape(values)[1:], np.inf)\n   585\t    return np.sort(values, axis=0)[rank - 1]\n   586\t\n   587\t\n   588\tdef geometry_tests():\n   589\t    for dimension in (3, 10):\n   590\t        matrix = basis(dimension)\n   591\t        assert np.allclose(matrix.T @ matrix, np.eye(dimension - 1), atol=1e-14)\n   592\t        assert np.allclose(matrix.sum(axis=0), 0, atol=1e-14)\n   593\t        latent = np.arange(dimension - 1)[None, :] / 10\n   594\t        response = simplex(latent, matrix)\n   595\t        assert np.all(response > 0) and np.allclose(response.sum(axis=1), 1)\n   596\t        assert np.allclose(np.log(response) @ matrix, latent)\n   597\t    assert quantile(np.arange(9), .2) == 7\n   598\t    assert math.isinf(float(quantile(np.arange(3), .05)))\n   599\t    assert np.array_equal(quantile(np.array([[1, 9], [3, 5], [2, 8]]), .5), [2, 8])\n   600\t    assert np.linalg.norm(np.array([3., 4.])) == 5\n   601\t    assert np.max(np.abs(np.array([.2, -.1, -.1]))) == .2\n   602\t\n   603\t\n   604\tdef generate_raw(case, lineage, sizes):\n   605\t    \"\"\"Reproduce the frozen original raw examples, before transforms or features.\"\"\"\n   606\t    dimension = int(case[1:])\n   607\t    matrix = basis(dimension)\n   608\t    rng = np.random.default_rng(np.random.SeedSequence(lineage))\n   609\t    covariates = rng.normal(size=(sum(sizes), 6))\n   610\t    if case[0] == 'S':\n   611\t        covariates[-sizes[-1]:, 0] += 1.25\n   612\t    coefficients = np.random.default_rng(333 + dimension).normal(0, .18, size=(6, dimension - 1))\n   613\t    latent_mean = covariates @ coefficients\n   614\t    if case[0] != 'H':\n   615\t        dominant = np.zeros(dimension)\n   616\t        dominant[0] = 4.5\n   617\t        latent_mean += dominant @ matrix\n   618\t    sigma = (np.full(len(covariates), .35) if case[0] == 'H'\n   619\t             else .12 + .8 / (1 + np.exp(-1.5 * covariates[:, 0])))\n   620\t    latent = latent_mean + sigma[:, None] * rng.normal(size=latent_mean.shape)\n   621\t    responses = simplex(latent, matrix)\n   622\t    if not np.isfinite(responses).all() or not np.all(responses > 0):\n   623\t        raise ValueError('invalid generated composition')\n   624\t    return covariates, responses\n   670\tdef wilson(hits, count):\n   671\t    if count <= 0:\n   672\t        raise ValueError('empty coverage group')\n   673\t    proportion = hits / count\n   674\t    denominator = 1 + 1.96**2 / count\n   675\t    center = (proportion + 1.96**2 / (2 * count)) / denominator\n   676\t    radius = 1.96 * math.sqrt(proportion * (1 - proportion) / count + 1.96**2 / (4 * count**2)) / denominator\n   677\t    return [max(0., center - radius), min(1., center + radius)]\n   678\t\n   679\t\n   680\tdef summarize(context, calibration_scores, test_scores, probe_scores, coordinatewise=False, conformal=True):\n   681\t    errors, group_errors, masses, details = [], [], [], []\n   682\t    for alpha in (.05, .10):\n   683\t        threshold = (quantile(calibration_scores, alpha / context['dimension'] if coordinatewise else alpha)\n   684\t                     if conformal else np.sort(calibration_scores, axis=0)[math.ceil(len(calibration_scores) * (1 - alpha)) - 1])\n   685\t        test_hits = np.all(test_scores <= threshold, axis=-1) if coordinatewise else test_scores <= threshold\n   686\t        probe_hits = np.all(probe_scores <= threshold, axis=-1) if coordinatewise else probe_scores <= threshold\n   687\t        coverage = float(test_hits.mean())\n   688\t        group_values, intervals = [], []\n   689\t        for group in (context['groups'], ~context['groups']):\n   690\t            if not group.any():\n   691\t                raise RequiredBaselineFailure('empty_fixed_group')\n   692\t            group_values.append(float(test_hits[group].mean()))\n   693\t            intervals.append(wilson(int(test_hits[group].sum()), int(group.sum())))\n   694\t        mass = float(probe_hits.mean())\n   695\t        errors.append(abs(coverage - (1 - alpha)))\n   696\t        group_errors.append(float(np.mean(np.abs(np.array(group_values) - (1 - alpha)))))\n   697\t        masses.append(mass)\n   698\t        details.append(dict(alpha=alpha, coverage=coverage, coverage_ci=wilson(int(test_hits.sum()), len(test_hits)),\n   699\t                            group_coverage=group_values, group_ci=intervals, reference_mass=mass,\n   700\t                            reference_mass_ci=wilson(int(probe_hits.sum()), probe_hits.size)))\n   701\t    marginal, group_error, mass = float(np.mean(errors)), float(np.mean(group_errors)), float(np.mean(masses))\n   702\t    utility = 1 - (.75 * (.5 * marginal + .5 * group_error) + .25 * mass)\n   703\t    if not all(math.isfinite(value) and 0 <= value <= 1 for value in (marginal, group_error, mass, utility)):\n   704\t        raise ValueError('nonfinite metric')\n   705\t    return dict(utility=utility, marginal=marginal, group=group_error, mass=mass, details=details)\n   706\t\n   707\t\n   708\tdef deranged_targets(residuals):\n   709\t    permutation = np.roll(np.arange(len(residuals)), 1)\n   710\t    if (np.any(permutation == np.arange(len(residuals)))\n   711\t            or np.array_equal(residuals[permutation], residuals)):\n   712\t        raise RequiredBaselineFailure('vacuous_permutation')\n   713\t    return permutation\n   714\t\n   715\t\n   716\tdef prepare_context(case, seed, raw, smoke):\n   717\t    covariates, responses, sizes = raw\n   718\t    dimension = responses.shape[1]\n   719\t    matrix = basis(dimension)\n   720\t    latent = np.log(responses) @ matrix\n   721\t    boundaries = np.cumsum([0] + sizes)\n   722\t    center_slice, train_slice, calibration_slice, test_slice = [slice(boundaries[index], boundaries[index + 1])\n   723\t                                                               for index in range(4)]\n   724\t    design = np.column_stack((np.ones(len(covariates)), covariates))\n   725\t    center_design = design[center_slice]\n   726\t    penalty = np.eye(7) * .01\n   727\t    penalty[0, 0] = 0\n   728\t    coefficients = np.linalg.solve(center_design.T @ center_design + penalty,\n   729\t                                   center_design.T @ latent[center_slice])\n   730\t    center = design @ coefficients\n   731\t    residual_vectors = latent - center\n   732\t    residuals = np.linalg.norm(residual_vectors, axis=1)\n   733\t    context = dict(dimension=dimension, train_x=covariates[train_slice], residuals=residuals[train_slice],\n   734\t                   calibration_x=covariates[calibration_slice], test_x=covariates[test_slice],\n   735\t                   calibration_residuals=residuals[calibration_slice], test_residuals=residuals[test_slice],\n   736\t                   groups=covariates[test_slice, 0] < 0)\n   737\t    count, probes = (8, 32) if smoke else (128, 1024)\n   738\t    selected = np.linspace(0, sizes[3] - 1, count, dtype=int)\n","exit_code":0,"status":"completed"}}
