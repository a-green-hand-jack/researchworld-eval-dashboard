{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,90p' build_paper_artifacts.py; sed -n '1,180p' .codex/skills/validate-paper/scripts/validate_figures.py; sed -n '1,200p' .codex/skills/validate-paper/scripts/compile_latex.sh; sed -n '1,110p' .codex/skills/memory-log/scripts/append_memory.py; ls source_evidence; cat concept_figure_run.log | tail -15; sed -n '1,85p' paper.tex; cat draft_reference_gaps.json; cat postdraft_reference_query_plan.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,90p' build_paper_artifacts.py; sed -n '1,180p' .codex/skills/validate-paper/scripts/validate_figures.py; sed -n '1,200p' .codex/skills/validate-paper/scripts/compile_latex.sh; sed -n '1,110p' .codex/skills/memory-log/scripts/append_memory.py; ls source_evidence; cat concept_figure_run.log | tail -15; sed -n '1,85p' paper.tex; cat draft_reference_gaps.json; cat postdraft_reference_query_plan.json\"","aggregated_output":"import json\nimport csv\nimport re\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFont\nfrom scipy.stats import spearmanr, kendalltau\n\nROOT = Path(__file__).resolve().parent\nFIGURES = ROOT / 'figures'\nTABLES = ROOT / 'tables'\nCASES = ['bbh', 'gpqa', 'musr', 'openllm_math', 'commonsense', 'gsm', 'legalbench', 'math', 'med_qa', 'mmlu']\nLABELS = ['BBH', 'GPQA', 'MuSR', 'OL-Math', 'Commonsense', 'GSM', 'LegalBench', 'MATH', 'MedQA', 'MMLU']\nCOLORS = ['#2166ac', '#d95f02', '#7570b3', '#419a75']\n\n\ndef provenance(path, inputs=None):\n    record = dict(schema_name='scientific-evidence.artifact-manifest',\n                  artifact=dict(path=str(path.relative_to(ROOT)), kind='figure' if path.suffix in ['.pdf', '.png'] else 'derived'),\n                  derived_from=inputs or ['@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]'],\n                  generated_by=dict(script_path='build_paper_artifacts.py', command=['python', 'build_paper_artifacts.py']))\n    Path(str(path) + '.prov.json').write_text(json.dumps(record, indent=2))\n\n\ndef export(figure, stem):\n    for extension in ['pdf', 'png']:\n        path = FIGURES / f'{stem}.{extension}'\n        figure.savefig(path, dpi=300)\n        provenance(path)\n    plt.close(figure)\n\n\ndef predictions(case, method):\n    if method in case['conditions']:\n        condition = case['conditions'][method]\n        if not condition['completed']:\n            return None\n        values = condition['predictions']\n    else:\n        values = (case['baseline_predictions'] or {}).get(method)\n    return None if values is None else np.asarray(values, dtype=float)\n\n\ndef main():\n    FIGURES.mkdir(exist_ok=True)\n    TABLES.mkdir(exist_ok=True)\n    # @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    data = json.loads((ROOT / 'paper_data.json').read_text())\n    episodes = data['final_evaluation']['evaluation_evidence']['episodes']\n    seeds = [episode['seed'] for episode in episodes]\n    methods = ['primary', 'no_diversity', 'anchor', 'irt']\n    budget_methods = ['primary', 'no_diversity', 'no_calibration', 'uniform']\n    method_values = np.full((len(CASES), len(seeds), len(methods)), np.nan)\n    errors = np.full((len(CASES), len(seeds), len(budget_methods), 3), np.nan)\n    ranks = errors.copy()\n    support = {}\n    audit = []\n    complete_rows = []\n    primary_rows = []\n    for case_index, name in enumerate(CASES):\n        support[name] = []\n        for seed_index, episode in enumerate(episodes):\n            case = episode['solution']['cases'][name]\n            truth = np.asarray(case['target_full_means'])\n            for method in list(case['conditions']) + ['anchor', 'irt', 'uniform', 'source_mean']:\n                values = predictions(case, method)\n                condition = case['conditions'].get(method)\n                for budget_index, budget in enumerate(episode['solution']['budgets']):\n                    row = dict(case=name, seed=episode['seed'], budget=budget, method=method,\n                               target_count=len(truth), target_group_count=len(set(case['target_lineages'])),\n                               available=values is not None,\n                               structural_failure=condition['structural_failure'] if condition else None,\n                               mae=None, rmse=None, spearman=None, kendall_tau_b=None)\n                    if values is not None:\n                        predicted = values[budget_index]\n                        row['mae'] = float(np.abs(predicted - truth).mean())\n                        row['rmse'] = float(np.sqrt(np.mean((predicted - truth) ** 2)))\n                        row['spearman'] = float(spearmanr(truth, predicted).statistic) if np.ptp(predicted) > 0 and np.ptp(truth) > 0 else 0.0\n                        row['kendall_tau_b'] = float(kendalltau(truth, predicted).statistic) if np.ptp(predicted) > 0 and np.ptp(truth) > 0 else 0.0\n                    complete_rows.append(row)\n            primary = case['conditions']['primary']\n            metrics_text = ' & '.join(f'{primary[metric]:.4f}' for metric in ['mae', 'rmse', 'spearman', 'kendall_tau_b']) if primary['completed'] else r'\\multicolumn{4}{c}{Missing; not a measured loss}'\n            primary_rows.append(f'{LABELS[case_index]} & {episode[\"seed\"]} & {len(truth)} & {len(set(case[\"target_lineages\"]))} & {metrics_text}' + r' \\\\')\n            arrays = [predictions(case, method) for method in methods]\n            if all(array is not None for array in arrays):\n                support[name].append(episode['seed'])\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n\ndef _markdown_entry(event: dict[str, Any]) -> str:\n    \"\"\"Handle markdown entry logic for this module.\"\"\"\n    lines = [\n        f\"### {event['timestamp']} | step={event['step']} | scope={event['scope']}\",\n        f\"- summary: {event['summary']}\",\n        f\"- evidence: {event['evidence']}\",\n        f\"- next_action: {event['next_action']}\",\n    ]\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = event.get(key)\n        if isinstance(value, str) and value.strip():\n            lines.append(f\"- {key}: {value.strip()}\")\n\nMETHOD.md\nREADME.md\nevaluate_final.py\nfinal_data_manifest.json\nprogram_spec.toml\nselected_method.py\nsnapshot_manifest.json\n{\"type\":\"thread.started\",\"thread_id\":\"01a1d652-d953-7780-8c49-1861c9b10ae7\"}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_0\",\"type\":\"error\",\"message\":\"Model metadata for `gpt-6.1-sol` not found. Defaulting to fallback metadata; this can degrade performance and cause issues.\"}}\n{\"type\":\"turn.started\"}\n{\"type\":\"error\",\"message\":\"Missing environment variable: `RWE_CODEX_API_KEY`.\"}\n{\"type\":\"turn.failed\",\"error\":{\"message\":\"Missing environment variable: `RWE_CODEX_API_KEY`.\"}}\n{\"usage\":{\"agent\":\"codex\",\"provider\":\"openai\",\"model\":\"gpt-6.1-sol\",\"inputTokens\":0,\"cacheReadTokens\":0,\"cacheWriteTokens\":0,\"outputTokens\":0,\"reasoningOutputTokens\":0,\"totalTokens\":0,\"usageStatus\":\"missing\",\"cost\":null,\"costBasis\":null,\"pricingSource\":null,\"pricingStatus\":\"missing\",\"billing\":{\"attempts\":[{\"route\":\"native\",\"usage\":{\"agent\":\"codex\",\"provider\":\"openai\",\"model\":\"gpt-6.1-sol\",\"inputTokens\":0,\"cacheReadTokens\":0,\"cacheWriteTokens\":0,\"outputTokens\":0,\"reasoningOutputTokens\":0,\"totalTokens\":0,\"usageStatus\":\"missing\",\"cost\":null,\"costBasis\":null,\"pricingSource\":null,\"pricingStatus\":\"missing\"}}]}}}\n\nPipeline finished · failed · 3s\n\nRun summary\nphase   time  tokens\n1 plan  0s    0.0k\n────────────────────\ntotal   3s    0.0k\nrenderer exit_code=1\n\\documentclass{article}\n% --- watermark (auto-inserted) ---\n\\usepackage{xcolor}\n\\usepackage{xfp}% \\fpeval; in the kernel since 2022, harmless on older LaTeX\n\\usepackage{draftwatermark}\n\\newlength{\\watermarkTextWidth}\n\\AddToHook{begindocument/end}{%\n  \\SetWatermarkText{\\normalfont Generated by The Agentic Scientist}%\n  \\SetWatermarkFontSize{10pt}%\n  \\SetWatermarkLightness{0.85}%\n  \\settowidth{\\watermarkTextWidth}{\\normalfont\\fontsize{10pt}{12pt}\\selectfont Generated by The Agentic Scientist}%\n  \\edef\\watermarkScale{\\fpeval{0.8 * sqrt(\\paperwidth**2 + \\paperheight**2) / \\watermarkTextWidth}}%\n  \\edef\\watermarkAngle{\\fpeval{atand(\\paperheight/\\paperwidth)}}%\n  \\SetWatermarkScale{\\watermarkScale}%\n  \\SetWatermarkAngle{\\watermarkAngle}%\n}\n% --- end watermark ---\n\n\\usepackage{paper,times}\n\\usepackage[T1]{fontenc}\n\\usepackage[utf8]{inputenc}\n\\usepackage{amsmath,amssymb,booktabs,graphicx,subcaption}\n\\usepackage{hyperref,url}\n\\title{Score-Targeted Item Selection for LLM Benchmark Prediction:\\\\Accuracy and Evaluation Limits}\n\\author{}\n\\newcommand{\\clip}{\\operatorname{clip}_{[0,1]}}\n\\newcommand{\\sigmoid}{\\operatorname{sigmoid}}\n\\begin{document}\n\\maketitle\n\n\\begin{abstract}\nPredicting a language model's benchmark score from a few responses can reduce evaluation cost, but prediction accuracy and evaluation completeness are different requirements. We study a source-only estimator that selects items by their conditional covariance with the full score and combines ridge prediction with an optional Rasch-residual profile mixture. A frozen evaluation covers ten fixed benchmark cases, three grouped model splits, and budgets of 8, 16, and 32 items. On common available support, the estimator's mean absolute error decreases from 0.0439 to 0.0278 across these budgets; its Spearman correlation increases from 0.7787 to 0.8858. These are conditional descriptions, not qualified overall results. The evaluation completed but failed qualification: primary and reference predictions are missing for two Commonsense splits, and matched structural checks fail. The reported aggregate MAE of 0.0880 includes missing-output penalties. We separate measured prediction errors, scoring defaults, and unresolved diagnostics, establishing an evidence-bounded assessment rather than an overall selection-advantage claim.\n\\end{abstract}\n% @evidence[[paper_data.json#/final_evaluation]]\n% @evidence[[derived_results.json#/budget_mae]]\n% @evidence[[derived_results.json#/budget_spearman]]\n\n\\section{Introduction}\nFull-benchmark evaluation repeatedly measures the same item universe across language models, checkpoints, or inference settings. Historical item-level responses may therefore contain useful information about which questions distinguish model behavior. The practical question is whether a new model can answer a small, fixed subset while a source-trained estimator reconstructs its full score and preserves model rankings. This setting differs from accelerating generation: the savings come from querying fewer items, not from changing the evaluated language model.\n\nExisting benchmark-compression methods exploit response similarity, latent ability, or predictive dependencies \\citep{Vivek2024,Polo2024,Kipnis2025,Pacchiardi2024,Li2025}. A complementary design objective is to select questions directly for the scalar score of interest. An item can distinguish source response patterns without being especially informative about their average. Conversely, correlated items can remain useful if their residual variation predicts that average. This motivates conditioning on already selected items and greedily targeting the remaining covariance with the full source score.\n\nWe study this design together with a source-trained reconstruction family. A linear ridge predictor provides a simple fallback; a group-balanced mixture of Rasch-shrunk source profiles offers nonlinear response-pattern matching. Both use the same nested item prefixes, and their combination is selected using source-group holdouts. The scientific hypothesis is that source response structure can improve score reconstruction at a fixed query budget. The available evaluation does not isolate a benefit from the profile component, nor does it establish a generally advantageous selector.\n\nThe decisive evidence boundary is evaluation integrity. The frozen assessment completed but did not qualify. Missing primary predictions coincide with missing reference predictions in part of the Commonsense evidence; matched structural checks also fail there. The retained predictions can describe accuracy on available pairs, but cannot supply the missing outcomes or restore qualification. Treating penalty-scored aggregate errors as ordinary prediction errors would obscure this distinction.\n% @evidence[[paper_data.json#/final_evaluation/outcome]]\n% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n\nOur contributions are consequently bounded: a precise description of a score-targeted, source-only reconstruction method; a common-support comparison across fixed benchmarks and item budgets; and an explicit account of how incomplete records restrict the interpretation of those comparisons. We report the unsuccessful qualification alongside the conditional results rather than selecting whichever summary gives the most favorable ordering. The resulting study addresses what these measurements establish, and what remains unmeasured.\n\n\\begin{figure}[t]\n\\centering\n\\includegraphics[width=\\linewidth]{figures/method_and_evidence_overview.png}\n\\caption{Source-only item design and score reconstruction, with an explicit evidence boundary. Source responses determine a fixed nested item order, ridge fitting, and an optional residual-profile mixture. Target responses update prediction only. Measured prediction error is distinguished from missing records and failed checks; the latter cannot be repaired by conditioning on available predictions.}\n\\label{fig:overview}\n\\end{figure}\n\n\\section{Related Work}\n\\paragraph{Few-item language-model evaluation.}\nAnchor Points selects a small set of representative examples from cross-model response structure \\citep{Vivek2024}. tinyBenchmarks studies efficient score estimation with curated subsets, and metabench uses latent abilities to compress reasoning and knowledge evaluation \\citep{Polo2024,Kipnis2025}. Reference-instance assessors predict model performance on other instances \\citep{Pacchiardi2024}; learned evaluation-acquisition policies model dependencies between test outcomes \\citep{Li2025}. Our fixed source-only order is not target-adaptive acquisition. The local anchor and IRT references below are explicitly defined implementations, not certified reproductions of these published systems.\n\n\\paragraph{Design and reconstruction.}\nChoosing observations for a scalar target relates to optimal allocation in regression \\citep{Elfving1952}, whereas information criteria for a whole parameter vector address a different objective \\citep{Kiefer1960}. Our empirical covariance rule is a regularized linear-prediction heuristic, not an optimal-design theorem for shifted binary responses. Ridge regression supplies a stabilized linear estimator \\citep{Hoerl1970}; standard statistical-learning and probabilistic-modeling texts provide broader background \\citep{Hastie2009,Bishop2006}. The profile model is a finite mixture, but it does not fit mixture weights by expectation maximization \\citep{Dempster1977}. Likewise, its fixed-ability difficulty fitting should not be confused with conditional maximum-likelihood estimation \\citep{Andersen1970}.\n\n\\paragraph{Assessment under dependence and missingness.}\nCross-validation distinguishes choosing a predictor from assessing it \\citep{Stone1974,Arlot2010}; evaluating a configuration on the same validation evidence used to tune it can be optimistic \\citep{Varma2006}. Grouped validation addresses dependence, but the blocking scheme determines which extrapolation question is tested \\citep{Roberts2017}. Domain-shift theory further motivates caution about transferring source accuracy to new response distributions \\citep{BenDavid2010}. Missing-data inference requires assumptions about the missingness process \\citep{Rubin1976,Little2019}; we make no such assumptions here. HELM motivates multi-metric evaluation \\citep{Liang2023}, and distinct benchmark constructions, such as MMLU-Pro, should not be conflated with the fixed MMLU case studied here \\citep{Wang2024}. These distinctions motivate reporting error, ranking, and evidence availability separately.\n\n\\section{Method}\n\\subsection{Problem Setup and Design Rationale}\nLet $X\\in\\{0,1\\}^{S\\times N}$ contain complete item responses of source models, and let $y\\in\\{0,1\\}^{N}$ denote a target model's responses. Its reference score is $s(y)=N^{-1}\\sum_{j=1}^{N}y_j$. Only $y_Q$ is observable to the estimator, for a subset $Q$ of size $b\\ll N$. Source rows have supplied group labels $g(i)$; target identities, target groups, and full target scores are unavailable during fitting and prediction. The goal is a bounded estimate $\\hat s_b(y_Q)$ with small absolute and squared score error and accurate target-model ordering.\n\nThe studied budgets are $b\\in\\{8,16,32\\}$. A single source-only order gives nested prefixes $Q_b$, with no repeated items. This is not a claim that these budgets suffice for every benchmark. The rationale is to combine task-directed acquisition with conservative reconstruction: selection targets the full-score functional, while a tuned linear fallback limits reliance on an overly specific source-profile model. Equal total source-group mass reduces the influence of densely represented groups in selection and profile priors, without asserting that groups perfectly recover training ancestry.\n% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes/0/solution/budgets]]\n% @evidence[[source_evidence/selected_method.py#L1-L28]]\n\n\\subsection{Score-Targeted Fixed Prefixes}\nFor $G$ source groups with sizes $n_g$, define $w_i=(G n_{g(i)})^{-1}$, source item means $\\mu_j=\\sum_i w_iX_{ij}$, and full source scores $t_i=N^{-1}\\sum_jX_{ij}$. With $\\bar t=\\sum_iw_it_i$, form\n\\begin{equation}\n Z_{ij}=\\sqrt{w_i}(X_{ij}-\\mu_j),\\qquad\n u_i=\\sqrt{w_i}(t_i-\\bar t),\\quad\n C=Z^\\top Z+D,\\quad c=Z^\\top u,\n\\end{equation}\nwhere $D_{jj}=0.1\\max\\{\\mu_j(1-\\mu_j),0.05\\}$. For the selected prefix $Q$, residual covariance and variance are\n\\begin{equation}\n c_{j\\mid Q}=c_j-C_{jQ}C_{QQ}^{-1}c_Q,\\qquad\n{\n  \"status\": \"ready\",\n  \"summary\": \"Two paragraph-specific gaps justify a small retrieval pass for Open LLM Leaderboard benchmark context and direct Rasch/IRT foundations; the existing related-work coverage needs no expansion.\",\n  \"missing_literatures\": [\n    \"Open LLM Leaderboard benchmark collection provenance\",\n    \"Rasch and two-parameter logistic item-response model foundations\"\n  ],\n  \"rewrite_targets\": [\n    {\n      \"target_id\": \"evaluation-leaderboard-context\",\n      \"section\": \"Evaluation Protocol and Evidence Availability\",\n      \"priority\": \"medium\",\n      \"citation_intent\": \"benchmark_context\",\n      \"reason\": \"The opening benchmark paragraph names four Open LLM Leaderboard-derived cases without a direct reference to that collection, and the bibliography contains no dedicated Leaderboard source. Liang2023 already supplies HELM context and can be reused locally without retrieval. One authoritative Leaderboard collection reference would identify the upstream evaluation context; it must not be used to substantiate the staged case counts, exact snapshot, filtering, or benchmark-version equivalence, which remain artifact-grounded.\",\n      \"anchor_text\": \"four Open LLM Leaderboard-derived cases (BBH, GPQA, MuSR, and OpenLLM Math)\",\n      \"search_topics\": [\n        \"Open LLM Leaderboard benchmark collection documentation BBH GPQA MuSR OpenLLM Math\"\n      ]\n    },\n    {\n      \"target_id\": \"method-rasch-irt-foundations\",\n      \"section\": \"Method\",\n      \"priority\": \"medium\",\n      \"citation_intent\": \"background\",\n      \"reason\": \"The reconstruction paragraph introduces a Rasch response model without a direct foundational citation. Related Work cites Andersen1970 specifically to distinguish conditional maximum-likelihood estimation, not to explain the response-model family; its stored abstract concerns conditional estimation. The later local comparator uses a two-parameter logistic model and fitted item information, also without a direct foundational reference. One or two authoritative IRT sources could support these named model families and their distinction without implying that the custom fitting procedure is standard, that the local comparator reproduces a published system, or that the profile branch has an established empirical benefit.\",\n      \"anchor_text\": \"The nonlinear branch retains source response profiles while smoothing them with a Rasch model.\",\n      \"search_topics\": [\n        \"Rasch logistic item-response model ability item difficulty foundational reference\",\n        \"two-parameter logistic item-response model discrimination Fisher item information authoritative reference\"\n      ]\n    }\n  ],\n  \"failure_reason\": \"\"\n}\n{\n  \"status\": \"ready\",\n  \"central_topic\": \"Evidence-bounded prediction of LLM full binary benchmark scores and rankings from fixed 8-, 16-, or 32-item prefixes using source-only score-covariance selection and ridge/Rasch-residual reconstruction; incremental citation support is needed only for upstream Open LLM Leaderboard collection context and Rasch/2PL foundations.\",\n  \"core_methods\": [\n    \"Source-only score-targeted fixed nested prefixes with grouped tuning and ridge score reconstruction; existing methodological citations require no new search\",\n    \"Rasch ability-minus-difficulty response probabilities used to smooth source profiles; direct model-family foundations are missing at paper.tex:86\",\n    \"Fixed-ability, group-weighted penalized fitting and optional residual-profile blending remain artifact-grounded custom implementation details, not claims licensed by a foundational citation\"\n  ],\n  \"comparators\": [\n    \"The local penalized two-parameter logistic comparator uses item discrimination and fitted Fisher item information; foundational support is needed at paper.tex:130 and paper.tex:293\",\n    \"Anchor Points, tinyBenchmarks, metabench, reference-instance prediction, and active evaluation acquisition already have direct citations; no comparator-family expansion is needed\"\n  ],\n  \"benchmarks\": [\n    \"Open LLM Leaderboard-derived final cases BBH, GPQA, MuSR, and OpenLLM Math need one authoritative upstream collection reference at paper.tex:115; staged identities, counts, filtering, and snapshot details remain artifact-grounded\",\n    \"HELM-derived final cases Commonsense, GSM, LegalBench, MATH, MedQA, and MMLU need no new retrieval; reuse Liang2023 for HELM collection context, and do not use Wang2024 (MMLU-Pro) as provenance for staged MMLU\"\n  ],\n  \"architectural_shifts\": [],\n  \"result_driven_themes\": [\n    \"Completed but unqualified evaluation, missing predictions, structural diagnostics, and retained-support results are artifact-grounded; additional references cannot repair or explain them\",\n    \"No citation enrichment should imply selector superiority, an isolated residual-profile benefit, calibrated target uncertainty, or official reproduction of a published comparator\"\n  ],\n  \"queries\": [\n    {\n      \"query\": \"Open LLM Leaderboard benchmark collection documentation BBH GPQA MuSR OpenLLM Math\",\n      \"category\": \"benchmark_context\",\n      \"rationale\": \"Fills evaluation-leaderboard-context at the opening paragraph of Evaluation Protocol and Evidence Availability / Fixed Benchmarks and Grouped Model Holdouts (paper.tex:115). Seek one authoritative collection source documenting the upstream benchmark composition. The initial plan already targeted Leaderboard context, but the 25-entry bibliography and provenance contain no dedicated collection source, so this is an unresolved gap rather than a literature refresh. Support only the named collection context, not staged case counts, filtering, snapshot identity, or equivalence with public benchmark versions. Reuse Liang2023 for HELM without another query; Wang2024 concerns MMLU-Pro, not staged MMLU.\"\n    },\n    {\n      \"query\": \"Rasch logistic item-response model ability item difficulty foundational reference\",\n      \"category\": \"core_method\",\n      \"rationale\": \"Fills method-rasch-irt-foundations at Method / Linear and Residual-Profile Reconstruction, specifically 'The nonlinear branch retains source response profiles while smoothing them with a Rasch model.' (paper.tex:86). Seek an authoritative foundation for the logistic ability-minus-difficulty response family, preferably also explaining the 2PL distinction and item information so the source can be reused for the local comparator. Andersen1970 is already cited specifically for conditional maximum-likelihood estimation, which the draft does not use; its stored abstract does not directly close this model-family gap. Do not characterize the fixed-ability penalized custom fit as standard joint Rasch estimation or infer empirical profile benefit.\"\n    },\n    {\n      \"query\": \"two-parameter logistic item-response model discrimination Fisher item information authoritative reference\",\n      \"category\": \"baseline_comparator\",\n      \"rationale\": \"Conditional complement within method-rasch-irt-foundations: execute only if the Rasch source does not also support the local 2PL comparator in Evaluation Protocol and Evidence Availability / Comparators and Control Semantics (paper.tex:130) and Supplementary Information / Local Reference Implementations (paper.tex:293). Seek at most one complementary authoritative source for variable discrimination and Fisher information a^2 p(1-p), checking consistency with the draft's theta*a-d parameterization. This is model-family framing, not a new comparator search or evidence that the local penalized fit reproduces tinyBenchmarks or another published package.\"\n    }\n  ],\n  \"forbidden_query_patterns\": [\n    \"Broad LLM benc