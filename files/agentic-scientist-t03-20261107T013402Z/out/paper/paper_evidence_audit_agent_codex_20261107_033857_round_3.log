{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json, re, statistics\nfrom pathlib import Path\nregistry=json.loads(Path('paper_data.json').read_text())\ntext=Path('paper.tex').read_text()\nerrors=[]\nreference_sign=[]\nmetrics=[[],[],[],[]]\nuncertainty={}\nfor episode in registry['final_evaluation']['evaluation_evidence']['episodes']:\n    for case in episode['solution']['cases']:\n        if case['replay'] or case['case']=='controls': continue\n        name=case['case']\n        label=('German' if name.startswith('german') else 'ACS')+' / '+name.split('_')[1]\n        observations=case['observations']\n        uncertainty.setdefault(name,[]).extend(value for row in observations['reference_uncertainty'] for value in row)\n        for cap_index,cap in enumerate([64,256,1024]):\n            cells=[cell for repeat in case['cells'][cap_index] for cell in repeat]\n            means=[statistics.mean(cell[index] for cell in cells) for index in range(4)]\n            for index,mean in enumerate(means): metrics[index].append(mean)\n            reference_sign.append(means[2])\n            expected=f\\\"{episode['seed']} & {label} & {cap} & {observations['baseline_metrics']['standard'][cap_index][0]:.4f} & {observations['baseline_metrics']['multistart'][cap_index][0]:.4f} & {means[0]:.4f}\\\"\n            if expected not in text: errors.append(expected)\n            arrays=observations['attributions'][cap_index]\n            if any(array \"'!= arrays[0] for array in arrays): errors.append('\"'Repeat mismatch '+name)\n        expected=f\\\"{episode['seed']} & {label} & [{observations['fidelity_instance_bootstrap_ci95'][0]:.10f}, {observations['fidelity_instance_bootstrap_ci95'][1]:.10f}]\\\"\n        if expected not in text: errors.append(expected)\n        if any(value \"'!= 1 for cap in case['\"'repeat_pairs'] for pair in cap for instance in pair for value in instance): errors.append('Pair mismatch '+name)\nprint('Numerical table/repeat mismatches:', errors)\nprint('Aggregated cell metrics:', [statistics.mean(values) for values in metrics])\nprint('Mean reference half-differences:', {name:statistics.mean(values) for name,values in uncertainty.items()})\nprint('Qualification:', {key:value['value'] for key,value in registry['grounding_sources'].items() if key.startswith('final.qualification.')})\nprint('Model diagnostics:')\nfor episode in registry['final_evaluation']['evaluation_evidence']['episodes']:\n    print(episode['seed'],[(case['case'],case['observations']['model_diagnostics']) for case in episode['solution']['cases'] if not case['replay'] and case['case']\"'!='\"'controls'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
