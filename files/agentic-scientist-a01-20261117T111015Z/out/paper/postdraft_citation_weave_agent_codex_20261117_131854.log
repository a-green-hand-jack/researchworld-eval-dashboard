ind', 'source_attempt_id', 'source_evidence', 'source_program_dir', 'source_tree_sha256'])\nreferences_provenance.json 25\ntop keys dict_keys(['campaign_results_dir', 'count', 'generated_at', 'queries', 'reference_query_plan', 'reference_query_plans', 'references', 'results_dir'])\npostdraft_references_provenance.json 25\ntop keys dict_keys(['references', 'count', 'generated_at', 'queries'])\n{\n  \"id\": \"MMLU\",\n  \"citation_key\": \"MMLU\",\n  \"title\": \"Measuring Massive Multitask Language Understanding\",\n  \"paper_id\": \"https://arxiv.org/abs/2009.03300\",\n  \"query\": \"Exact permitted canonical record: Measuring Massive Multitask Language Understanding\",\n  \"source_url\": \"https://arxiv.org/abs/2009.03300\",\n  \"retrieved_at\": \"2026-11-17\",\n  \"url\": \"https://arxiv.org/abs/2009.03300\",\n  \"source\": \"arxiv\",\n  \"evidence_path\": \"literature/MMLU.json\",\n  \"sha256\": \"03c49535bf302210a5a4ad028750906693c0b5e9340b1ffab9541e919d793f4c\",\n  \"reading_scope\": \"Canonical record metadata and abstract only; no citation graph or related links followed.\"\n}\n{\n  \"id\": \"BBH\",\n  \"citation_key\": \"BBH\",\n  \"title\": \"Challenging BIG-Bench Tasks and Whether Chain-of-Thought Can Solve Them\",\n  \"paper_id\": \"https://arxiv.org/abs/2210.09261\",\n  \"query\": \"Exact permitted canonical record: Challenging BIG-Bench Tasks and Whether Chain-of-Thought Can Solve Them\",\n  \"source_url\": \"https://arxiv.org/abs/2210.09261\",\n  \"retrieved_at\": \"2026-11-17\",\n  \"url\": \"https://arxiv.org/abs/2210.09261\",\n  \"source\": \"arxiv\",\n  \"evidence_path\": \"literature/BBH.json\",\n  \"sha256\": \"f8713dce4e174cec58a21e65525fe56ba3dc322dc33cb405ce286b80c5c6dd5e\",\n  \"reading_scope\": \"Canonical record metadata and abstract only; no citation graph or related links followed.\"\n}\n{\n  \"id\": \"HELM\",\n  \"citation_key\": \"HELM\",\n  \"title\": \"Holistic Evaluation of Language Models\",\n  \"paper_id\": \"https://arxiv.org/abs/