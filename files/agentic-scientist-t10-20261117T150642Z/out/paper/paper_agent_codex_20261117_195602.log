327 328 329 330 331 332 333 334 335 336 337 338  ction for the complete frozen procedure relative to the supplied references. The non-benefits show why that 7 \n8 2950 Generated by The Agentic Scientist 378 379 380 381 382 383 384 385 386 387 388 389 390 391 392  ting functions are not provided in the available manifest; we do not reconstruct them from condition names. 8 \n9 2300 Generated by The Agentic Scientist 432 433 434 435 436 437 438 439 440 441 442 443 444 445 446  separating calibration from studen- tization. Those are unresolved requirements, not outcomes claimed here. 9 \n10 2874 Generated by The Agentic Scientist 486 487 488 489 490 491 492 493 494 495 496 497 498 499 500  009753 .010365 Uninformative .002890 .003532 Constant score .006128 .006150 Permuted score .002856 .003529 10 \n11 4561 Generated by The Agentic Scientist 540 541 542 543 544 545 546 547 548 549 550 551 552 553 554  r the re- tained references, local evidence records the exact-work metadata and available abstracts; where 11 \n12 2052 Generated by The Agentic Scientist 594 595 596 597 598 599 600 601 602 603 604 605 606 607 608  generated prose or prior qualitative summaries, determine the reported measurements and their limitations. 12 \n#!/usr/bin/env python3\n\"\"\"Validate the exact TeX and BibTeX inputs observed during compilation.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nAGENT_SKILL_DIR_PREFIXES = (\n    (\".claude\", \"skills\"),\n    (\".codex\", \"skills\"),\n    (\".cursor\", \"skills\"),\n    (\".opencode\", \"skills\"),\n    (\".gemini\", \"skills\"),\n    (\".pi\", \"agent\", \"skills\"),\n)\nLATEX_SYSTEM_INPUT_ROOTS = tuple(\n    Path(path)\n    for path in (\n        \"/etc/texmf\",\n        \"/opt/texlive\",\n        \"/usr/local/share/miktex-texmf\",\n        \"/usr/local/share/texmf\",\n        \"/usr/local/texlive\",\n        \"/usr/share/texlive\",\n        \"/usr/share/texmf\",\n        \"/usr/share/texmf-dist\",\n        \"/var/lib/miktex-texmf\",\n        \"/var/lib/texmf\",\n        \"/nix/store\",\n    )\n)\nBIBTEX_AUX_DATA_RE = re.compile(r\"\\\\bibdata\\s*\\{(?P<targets>[^{}]+)\\}\")\nBIBTEX_AUX_DATA_COMMAND_RE = re.compile(r\"\\\\bibdata(?![A-Za-z@])\")\nBIBTEX_AUX_STYLE_RE = re.compile(r\"\\\\bibstyle\\s*\\{(?P<target>[^{}]+)\\}\")\nBIBTEX_AUX_STYLE_COMMAND_RE = re.compile(r\"\\\\bibstyle(?![A-Za-z@])\")\nBIBTEX_AUX_INPUT_RE = re.compile(r\"\\\\@input\\s*\\{(?P<target>[^{}]+)\\}\")\nBIBTEX_AUX_INPUT_COMMAND_RE = re.compile(r\"\\\\@input(?![A-Za-z@])\")\nLATEX_ENV_ALLOWLIST = (\n    \"PATH\",\n    \"LANG\",\n    \"LC_ALL\",\n    \"LC_CTYPE\",\n    \"TZ\",\n    \"SOURCE_DATE_EPOCH\",\n    \"FORCE_SOURCE_DATE\",\n)\n\n\ndef _uses_agent_skill_path(path: Path) -> bool:\n    return any(\n        path.parts[: len(prefix)] == prefix for prefix in AGENT_SKILL_DIR_PREFIXES\n    )\n\n\ndef _is_approved_latex_system_input(input_path: Path) -> bool:\n    for system_root in LATEX_SYSTEM_INPUT_ROOTS:\n        if not input_path.is_relative_to(system_root):\n            continue\n        if not input_path.exists():\n            return True\n        try:\n            resolved_input = input_path.resolve(strict=True)\n            resolved_root = system_root.resolve(strict=True)\n        except OSError:\n            return False\n        return resolved_input.is_relative_to(resolved_root)\n    return False\n\n\ndef validate_latex_recorder_inputs(paper_dir: Path, fls_name: str) -> None:\n    root = paper_dir.resolve()\n    fls_path = root / fls_name\n    if not fls_path.is_file():\n        raise RuntimeError(f\"LaTeX recorder output missing: {fls_path}\")\n    recorder_lines = fls_path.read_text(\n        encoding=\"utf-8\", errors=\"replace\"\n    ).splitlines()\n    recorded_pwd = next(\n        (\n            Path(line.removeprefix(\"PWD \").strip())\n            for line in recorder_lines\n            if line.startswith(\"PWD \") and line.removeprefix(\"PWD \").strip()\n        ),\n        root,\n    )\n    for line in recorder_lines:\n        if not line.startswith(\"INPUT \"):\n            continue\n        input_text = line.removeprefix(\"INPUT \").strip()\n        if not input_text:\n            continue\n        input_path = Path(input_text)\n        relative_candidate: Path | None = None\n        if input_path.is_absolute():\n            input_path = Path(os.path.abspath(input_path))\n            for workspace_root in (root, recorded_pwd):\n                try:\n                    relative_candidate = input_path.relative_to(workspace_root)\n                    break\n                except ValueError:\n                    continue\n            if relative_candidate is None and _is_approved_latex_system_input(input_path):\n                continue\n        else:\n            recorded_candidate = Path(os.path.abspath(recorded_pwd / input_path))\n            try:\n                relative_candidate = recorded_candidate.relative_to(recorded_pwd)\n            except ValueError:\n                relative_candidate = None\n        if relative_candidate is None:\n            raise RuntimeError(\n                \"compiled paper dependency is outside approved TeX roots: \"\n                f\"{input_path.as_posix()}\"\n            )\n        workspace_candidates = [relative_candidate]\n        host_candidate = root / relative_candidate\n        if host_candidate.exists():\n            resolved_candidate = host_candidate.resolve(strict=True)\n            try:\n                resolved_relative = resolved_candidate.relative_to(root)\n            except ValueError as exc:\n                raise RuntimeError(\n                    \"compiled paper dependency escapes the paper workspace: \"\n                    f\"{relative_candidate.as_posix()}\"\n                ) from exc\nValidated 70 grounded claims and 25 provenance references.\n310:        errors.append(\"Supplementary Information must appear af