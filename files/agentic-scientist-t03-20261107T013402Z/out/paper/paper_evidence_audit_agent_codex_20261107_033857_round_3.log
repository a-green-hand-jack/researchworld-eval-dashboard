{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,statistics\nfrom pathlib import Path\nregistry=json.loads(Path('paper_data.json').read_text())\nmean=statistics.mean\nprint('Final condition means: library / split cap / structure / reference signs')\nfor name in ['german_logistic','german_forest','acs_logistic','acs_forest']:\n    cases=[case for episode in registry['final_evaluation']['evaluation_evidence']['episodes'] for case in episode['solution']['cases'] if case['case']==name and not case['replay']]\n    for index,cap in enumerate([64,256,1024]):\n        print(name,cap,[round(mean(case['observations']['baseline_metrics'][method][index][0] for case in cases),7) for method in ['standard','multistart']],round(mean(cell[0] for case in cases for repeat in case['cells'][index] for cell in repeat),7),round(mean(cell[2] for case in cases for repeat in case['cells'][index] for cell in repeat),7))\nprint('Development condition agreements by configuration and cap:')\nfor configuration,program in enumerate(registry['all_programs']):\n    for name in ['german_logistic','german_forest','acs_logistic','acs_forest']:\n        cases=[case for episode in program['evaluation_evidence']['episodes'] for case in episode['solution']['cases'] if case['case']==name and not case['replay']]\n        print(configuration,name,[[round(mean(cell[0] for repeat in case['cells'][index] for cell in repeat),7) for case in cases] for index in range(2)])\nclaims=json.loads(Path('claims_grounding.json').read_text())['claims']\nmissing={source for claim in claims for source in claim.get('source_ids',[]) if source not in registry['grounding_sources']}\nprint('Claim source identifiers missing from registry:',sorted(missing))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
