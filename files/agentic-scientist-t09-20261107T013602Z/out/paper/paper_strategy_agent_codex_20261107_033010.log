{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nfrom pathlib import Path\nstrategy=json.loads(Path('paper_strategy.json').read_text())\npaper=json.loads(Path('paper_data.json').read_text())\nmemo=Path('paper_strategy.md').read_text()\nexpected={'status','selected_prompt_family','recommended_title','central_question','central_thesis','narrative_rationale','prior_paper_story_status','edit_framing_decision','staged_input_impact','method_groups','results_focus','figure_plan','figure_specs','supplementary_plan','forbidden_headings','forbidden_phrases','notes_for_writer','failure_reason'}\nassert set(strategy)==expected, set(strategy)\"'^expected\nassert strategy['\"'status']=='ready' and strategy['selected_prompt_family']=='paper_standalone'\nassert strategy['prior_paper_story_status'] in {'preserved','broadened','recentered','rejected'}\nassert strategy['failure_reason']==''\nfor key in ['recommended_title','central_question','central_thesis']:\n    assert strategy[key] in memo, key\nassert len(strategy['method_groups'])==4\nassert {group['role'] for group in strategy['method_groups']}=={'proposed','baseline'}\nfigure_keys={'figure_id','required','purpose','figure_type','preferred_generator','group_by','metric','split_by','preferred_span','target_width_fraction','layout_rationale','allow_progression','max_panels','max_categories_per_panel','max_series_per_panel'}\nfor figure in strategy['figure_specs']:\n    assert set(figure)==figure_keys\n    assert figure['figure_id'] in memo\n    assert figure['required'] and not figure['allow_progression']\n    assert figure['max_panels']<=4 and figure['max_categories_per_panel']<=6 and figure['max_series_per_panel']<=4\n    assert figure['preferred_span']=='full_width'\n    assert '5.5in' in figure['layout_rationale'] or '5.5in' in figure['layout_rationale'].replace(' ','')\nassert sum(figure['preferred_generator']=='generate-concept-figure' for figure in strategy['figure_specs'])==1\nsupplement=strategy['supplementary_plan']\nassert supplement['purpose'] and supplement['planned_subsections']\nsource_ids=set()\nfor subsection in supplement['planned_subsections']:\n    assert subsection['heading'] in memo, subsection['heading']\n    assert subsection['grounded_content']\n    for source_id in subsection['source_ids']:\n        assert source_id in paper['grounding_sources'], source_id\n        source_ids.add(source_id)\nassert paper['grounding_sources']['final.qualification.status']['value']=='completed'\nassert paper['grounding_sources']['final.qualification.outcome']['value']=='qualified'\nassert paper['grounding_sources']['final.qualification.correct']['value'] is True\nassert not any(source_id.startswith('study.') for source_id in paper['grounding_sources'])\nassert not paper.get('downstream_study') and not paper['ablation_studies']\ncases=[case for episode in paper['final_evaluation']['evaluation_evidence']['episodes'] for case in episode['solution']['cases'] if case['kind']=='scientific']\nassert len(cases)==576 and all(case['completed'] for case in cases)\nassert all(not case['validated']['clipped'] for case in cases)\nassert all(set(['difference_in_means','own_treatment_ols','one_hop_ols'])<=set(case['validated']['baseline_estimates']) for case in cases)\nassert abs(sum([.40,1.10,.65,.90,1.50,.95,2.15,.85,.25])-8.75)<1e-10\nassert not Path('paper.tex').exists() and not Path('claims_grounding.json').exists()\nprint('PASS: strategy-only contract checks; no final-paper validator invoked.')\nprint('Checked: exact JSON keys, mirrored question/thesis/title, four methods, three required figures, six substantive supplement sections, existing source IDs, final qualification, all 576 scientific records, no clipping, 8.75-page allocation, drafting boundary.')\nprint('Referenced grounding IDs:', ', '.join(sorted(source_ids)))\nprint('Output sizes:', {name:Path(name).stat().st_size for name in ['paper_strategy.json','pap