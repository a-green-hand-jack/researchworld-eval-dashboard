{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nimport re\nfrom pathlib import Path\n\nstrategy = json.loads(Path('paper_strategy.json').read_text())\ndata = json.loads(Path('paper_data.json').read_text())\nmemo = Path('paper_strategy.md').read_text()\nfeedback = json.loads(Path('strategy_validation_feedback.json').read_text())\nerrors = []\ndef check(condition, message):\n    if not condition:\n        errors.append(message)\n\nrequired_fields = {'status', 'selected_prompt_family', 'recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'prior_paper_story_status', 'edit_framing_decision', 'staged_input_impact', 'method_groups', 'results_focus', 'figure_plan', 'figure_specs', 'supplementary_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer', 'failure_reason'}\ncheck(set(strategy) == required_fields, 'Strategy top-level output contract differs')\ncheck(strategy['status'] == 'ready', 'Strategy is not ready')\ncheck(strategy['selected_prompt_family'] == 'paper_standalone', 'Wrong prompt family')\ncheck(strategy['failure_reason'] == '', 'Ready strategy has a failure reason')\ncheck(strategy['prior_paper_story_status'] in {'preserved', 'broadened', 'recentered', 'rejected'}, 'Invalid framing decision')\nfor field in ('recommended_title', 'central_question', 'central_thesis', 'narrative_rationale', 'edit_framing_decision'):\n    check(isinstance(strategy[field], str) and bool(strategy[field].strip()), f'{field} must be non-empty')\nfor field in ('staged_input_impact', 'results_focus', 'figure_plan', 'forbidden_headings', 'forbidden_phrases', 'notes_for_writer'):\n    check(isinstance(strategy[field], list) and bool(strategy[field]) and all(isinstance(entry, str) and entry.strip() for entry in strategy[field]), f'{field} must contain non-empty strings')\nfor group in strategy['method_groups']:\n    check(set(group) == {'name', 'role', 'include_reason'}, 'Invalid method-group fields')\n    check(group['role'] in {'baseline', 'proposed', 'ablation', 'supporting'}, 'Invalid method role')\n    check(bool(group['name'].strip()) and bool(group['include_reason'].strip()), 'Empty method description')\n\nsupplement = strategy['supplementary_plan']\ncheck(isinstance(supplement.get('purpose'), str) and bool(supplement['purpose'].strip()), 'Supplement purpose missing')\ncheck(bool(supplement.get('planned_subsections')), 'No grounded supplement entries')\nfor index, section in enumerate(supplement['planned_subsections']):\n    check(set(section) == {'heading', 'grounded_content', 'source_ids'}, f'Supplement entry {index}: invalid fields')\n    check(bool(section['heading'].strip()) and bool(section['grounded_content'].strip()), f'Supplement entry {index}: empty content')\n    source_ids = section['source_ids']\n    check(isinstance(source_ids, list) and bool(source_ids), f'Supplement entry {index}: source_ids must be a non-empty list')\n    for source_id in source_ids:\n        check(source_id in data['grounding_sources'], f'Unknown source ID: {source_id}')\n    check(section['heading'] in memo and section['grounded_content'] in memo, f'Memo does not mirror supplement entry {index}')\n\nfigures = strategy['figure_specs']\ncheck(len({figure['figure_id'] for figure in figures}) == len(figures), 'Duplicate figure IDs')\ncheck(sum(figure['preferred_generator'] == 'generate-concept-figure' for figure in figures) <= 1, 'Multiple concept-figure generators')\nfor figure in figures:\n    figure_id = figure['figure_id']\n    check(figure['preferred_span'] in {'column', 'full_width'}, f'{figure_id}: invalid span')\n    check(0 < figure['target_width_fraction'] <= 1, f'{figure_id}: invalid width')\n    check(bool(figure['layout_rationale'].strip()), f'{figure_id}: no layout rationale')\n    check(figure['max_panels'] <= 4, f'{figure_id}: too many panels')\n    check(figure['max_categories_per_panel'] <= 6, f'{figure_id}: too many categories')\n    check(figure['max_series_per_panel'] <= 4, f'{figure_id}: too many series')\n    check(not figure['allow_progression'], f'{figure_id}: unsupported progression')\n    if figure['required'] and figure['figure_type'] == 'diagram':\n        check(figure['preferred_generator'] == 'generate-concept-figure', f'{figure_id}: overview generator mismatch')\n    for source_id in figure.get('source_ids', []):\n        check(source_id in data['grounding_sources'], f'{figure_id}: unknown source {source_id}')\n\nfor source_id in set(re.findall(r'\\\\b(?:final\\\\.(?:metric|qualification)\\\\.[A-Za-z0-9_]+|final\\\\.evidence\\\\.episodes|result\\\\.top_program_\\\\d+)\\\\b', json.dumps(strategy))):\n    check(source_id in data['grounding_sources'], f'Unknown referenced source {source_id}')\nfor field in ('status', 'outcome', 'correct'):\n    check(data['final_evaluation'][field] == data['grounding_sources']['final.qualification.' + field]['value'], f'Final qualification disagreement: {field}')\ncheck(data['final_evaluation']['status'] == 'completed' and data['final_evaluation']['outcome'] == 'qualified', 'Strategy qualification differs from authoritative evaluation')\ncheck('downstream_study' not in data, 'Reassess newly available downstream study')\ncheck(not any(source_id.startswith('study.') for source_id in data['grounding_sources']), 'Reassess newly available study sources')\ncheck(any('LLM Usage' in note and 'process disclosure' in note and 'research ideation' in note for note in strategy['notes_for_writer']), 'Required process disclosure instructions lost')\ncheck('**LLM Usage**' in memo and 'Required process disclosure' in memo, 'Memo process disclosure missing')\nfor filename in ('paper.tex', 'claims_grounding.json'):\n    check(not Path(filename).exists(), f'Forbidden stage output: {filename}')\ncheck('5.5' in memo and '8.5' in memo and '300' in memo and '2400' in memo, 'Layout/export contract missing')\n\nreport = {'validation_scope': 'strategy_only', 'ok': no