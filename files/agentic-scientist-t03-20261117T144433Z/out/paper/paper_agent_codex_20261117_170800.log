ter', 'failure_reason']\n[\n  {\n    \"figure_id\": \"fixed_game_overview\",\n    \"required\": true,\n    \"purpose\": \"Make the fixed empirical game, compared estimators, exact versus approximate anchors, and allocation contrast legible at a glance without implying sampler superiority.\",\n    \"figure_type\": \"diagram\",\n    \"preferred_generator\": \"generate-concept-figure\",\n    \"group_by\": \"evidence_role\",\n    \"metric\": \"none; conceptual structure only\",\n    \"split_by\": \"reference_kind\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"paper.sty sets a single 5.5-inch text column and 9-inch text height. Use the full 5.5-inch text width, approximately 1.8-2.0 inches high plus caption, near page 2. A half-text-width diagram would make six semantic groups and reference annotations unreadable.\",\n    \"allow_progression\": false,\n    \"max_panels\": 1,\n    \"max_panels_per_row\": 1,\n    \"max_categories_per_panel\": 6,\n    \"max_series_per_panel\": 4,\n    \"intended_placement\": \"page 1 or 2, preferably page 2 after the research question\",\n    \"estimated_min_rendered_font_pt\": 9,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_spec\": \"At most six semantic groups: fixed model/input/background and probability estimand; coalition sampling; repeated attributions and library comparator; agreement and fidelity readouts; exact ACSIncome/two approximate German references; four short versus one long allocation. Mark evidence scope and unverified diagnostics in the caption. Arrows denote data dependencies, not discovery order or a production certification pipeline.\"\n  },\n  {\n    \"figure_id\": \"agreement_and_reference_fidelity\",\n    \"required\": true,\n    \"purpose\": \"Contrast repeatability with reference-sensitive quality without conflating metrics or datasets.\",\n    \"figure_type\": \"point_interval\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"model_family\",\n    \"metric\": \"top-three-set overlap and normalized L1 reference-fidelity quality in separate panels\",\n    \"split_by\": \"dataset and metric\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"At the inspected 5.5-inch single-column width, a 2-by-2 layout gives roughly 2.5 inches per panel, sufficient for three short model labels and two fitted-seed markers. Allocate roughly 2.8 inches plus caption on pages 5-6; use at least 8.5-point final labels and never shrink to half text width.\",\n    \"allow_progression\": false,\n    \"max_panels\": 4,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 3,\n    \"max_series_per_panel\": 2,\n    \"intended_placement\": \"main results, pages 5-6\",\n    \"estimated_min_rendered_font_pt\": 8.5,\n    \"source_ids\": [\n      \"final.evidence.episodes\",\n      \"final.metric.repeat_agreement\",\n      \"final.metric.reference_fidelity\"\n    ],\n    \"content_spec\": \"Rows: German Credit/ACSIncome; columns: repeat overlap/reference fidelity. Show two fits individually. Use case means and stored input_cluster_intervals, both pooled over the same background/budget levels. Caption labels intervals descriptive within-fit 95% input-cluster bootstrap intervals; do not attach pooled intervals to budget-specific points. Explain that exact and approximate fidelity anchors differ.\"\n  },\n  {\n    \"figure_id\": \"budget_allocation_contrast\",\n    \"required\": true,\n    \"purpose\": \"Show the observed cost-allocation result and uncertainty, retaining negative and uncertain effects.\",\n    \"figure_type\": \"point_interval\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"model_family\",\n    \"metric\": \"quality(mean of four additional 64-coalition runs, reference) minus quality(first 256-coalition run, reference)\",\n    \"split_by\": \"dataset\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Two side-by-side panels across the single 5.5-inch text column support three model labels, two seed markers, intervals, and a visible zero line. Target about 1.9-2.1 inches plus caption on page 6 or 7; reserve caption space for the exact contrast and reference definition.\",\n    \"allow_progression\": false,\n    \"max_panels\": 2,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 3,\n    \"max_series_per_panel\": 2,\n    \"intended_placement\": \"main results, pages 6-7\",\n    \"estimated_min_rendered_font_pt\": 8.5,\n    \"source_ids\": [\n      \"final.evidence.episodes\",\n      \"final.metric.matched_budget_gain\"\n    ],\n    \"content_spec\": \"Show both fitted seeds separately with stored gain intervals and one common signed interpretation. German gain uses the mean reference vector, whereas its ordinary fidelity metric averages qualities to each reference. Equal coalition count also yields equal candidate oracle masked-row count for a fixed background; it does not imply equal runtime. No significance stars or universal loss claim.\"\n  },\n  {\n    \"figure_id\": \"deployment_estimator_comparison\",\n    \"required\": true,\n    \"purpose\": \"Retain a meaningful measured deployment comparator and expose budget- and fit-specific fidelity behavior.\",\n    \"figure_type\": \"grouped_dot\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"model_family\",\n    \"metric\": \"reference-fidelity quality reconstructed with the evaluator definition\",\n    \"split_by\": \"dataset and fitted_seed\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Four panels in a 2-by-2 grid over 5.5 inches keep three model categories and four estimator/budget series readable at a minimum of 8.5 points. Target about 2.8 inches plus caption on pages 7-8. Use short legend labels and a shared external legend rather than reducing font size.\",\n    \"allow_progression\": false,\n    \"max_panels\": 4,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 3,\n    \"max_series_per_panel\": 4,\n    \"intended_placement\": \"main results, pages 7-8\",\n    \"estimated_min_rendered_font_pt\": 8.5,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_spec\": \"Four series: studied-64, studied-256, library-64, library-256. Average within retained input/background cells and candidate repeats, preserving the two fitted seeds in separate panels. Package calls have no estimated seed-to-seed variance. Reconstruct only deterministic summaries from stored vectors, verify candidate reductions against existing summaries, and record formulas and sources. Plot no fabricated error bars. Do not identify the library implementation with the original independent sampler; nominal coalition budgets need not imply identical prediction-row costs.\"\n  }\n]\n\nREFS\nkeys dict_keys(['campaign_results_dir', 'count', 'generated_at', 'queries', 'reference_query_plan', 'references', 'results_dir'])\nref.s2.442e10a3c6640ded9408622005e3c2a8906ce4c2 A Unified Approach to Interpreting Model Predictions None None\nref.s2.71f1d46eb773a8d2c2c17a1fba4480c26c51f247 A Principal Odor Map Unifies Diverse Tasks in Olfactory Perception None None\nref.s2.59002ecb49fb734ed181224e8884e37e21e8a9da A review of the transition from Shapley values and SHAP values to RGE None None\nref.s2.29da8e12664d5f3a5e45d9688bbedb964505b1f2 A Principal Odor Map Unifies Diverse Tasks in Human Olfactory Perception None None\nref.s2.7550fabbb449c99784788eae5cb939eb9063c6ec Precision calibration of calorimeter signals in the ATLAS experiment using an uncertainty-aware neural network None None\nref.s2.3ce1638e573e3fbf8ee2270d0e25c855fbe620fb The corrosion of potlining refractories: A unified approach None None\nref.s2.0a93627a1446eaaa608321ec3263f42fc7bcf29f Alzheimer’s disease prediction via an explainable CNN usin