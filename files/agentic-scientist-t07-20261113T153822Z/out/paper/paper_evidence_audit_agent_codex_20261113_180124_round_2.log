{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/sh -lc \"PYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport json, csv, re\nimport numpy as np\nfrom scipy.stats import spearmanr, kendalltau\nfrom pathlib import Path\nregistry=json.loads(Path('paper_data.json').read_text())\nderived=json.loads(Path('derived_results.json').read_text())\nepisodes=registry['final_evaluation']['evaluation_evidence']['episodes']\nissues=[]\nmethods=derived['methods']; budget_methods=derived['budget_methods']; cases=derived['cases']\nweights=[.5/4]*4+[.5/6]*6\ncase_means=[]; budget_mae=np.zeros((4,3)); budget_rank=np.zeros((4,3)); ledger={}\nfor index,name in enumerate(cases):\n    available=[]; errors=[]; ranks=[]; case_metrics=[]\n    for episode in episodes:\n        case=episode['solution']['cases'][name]\n        truth=np.asarray(case['target_full_means'])\n        values={key:np.asarray(value['predictions']) if value['completed'] and value['predictions'] is not None else None for key,value in case['conditions'].items()}\n        values.update({key:np.asarray(value) for key,value in (case['baseline_predictions'] or {}).items()})\n        if all(values.get(method) is not None for method in methods):\n            available.append(episode['seed'])\n            case_metrics.append([np.abs(values[method]-truth).mean() for method in methods])\n        if all(values.get(method) is not None for method in budget_methods):\n            errors.append([np.abs(values[method]-truth).mean(axis=1) for method in budget_methods])\n            ranks.append([[float(spearmanr(truth,row).statistic) if np.ptp(truth)>0 and np.ptp(row)>0 else 0. for row in values[method]] for method in budget_methods])\n        for method in list(case['conditions'])+['anchor','irt','uniform','source_mean']:\n            for budget_index,budget in enumerate(episode['solution']['budgets']):\n                predicted=values.get(method)\n                metrics=None\n                if predicted is not None:\n                    predicted=predicted[budget_index]\n                    constant=np.ptp(truth)==0 or np.ptp(predicted)==0\n                    metrics=[float(np.abs(predicted-truth).mean()),float(np.sqrt(np.mean((predicted-truth)**2))),0. if constant else float(spearmanr(truth,predicted).statistic),0. if constant else float(kendalltau(truth,predicted).statistic)]\n                ledger[name,episode['seed'],budget,method]=metrics\n        for method,condition in case['conditions'].items():\n            if condition['completed']:\n                expected=np.mean([ledger[name,episode['seed'],budget,method] for budget in episode['solution']['budgets']],axis=0)\n                recorded=[condition[key] for key in ['mae','rmse','spearman','kendall_tau_b']]\n                if not np.allclose(expected,recorded,atol=1e-12): issues.append(('recorded metrics',name,episode['seed'],method,expected.tolist(),recorded))\n    if available\"'!=derived['\"'common_support'][name]: issues.append(('support',name))\n    case_means.append(np.mean(case_metrics,axis=0))\n    budget_mae+=weights[index]*np.mean(errors,axis=0)\n    budget_rank+=weights[index]*np.mean(ranks,axis=0)\nfor label,calculated in [('case_mae',case_means),('budget_mae',budget_mae),('budget_spearman',budget_rank)]:\n    if not np.allclose(calculated,derived[label],atol=1e-12): issues.append(('derived',label))\nrows=list(csv.DictReader(Path('complete_metrics.csv').open()))\nfor row in rows:\n    key=row['case'],int(row['seed']),int(row['budget']),row['method']\n    expected=ledger.pop(key)\n    actual=[row[field] for field in ['mae','rmse','spearman','kendall_tau_b']]\n    if expected is None:\n        if any(actual): issues.append(('missing ledger',key))\n    elif not np.allclose(expected,list(map(float,actual)),atol=1e-12): issues.append(('ledger',key))\nif ledger: issues.append(('missing CSV rows',len(ledger)))\ntext=Path('paper.tex').read_text()\nfor label,path in [('case_mae','tables/case_mae.tex'),('budget_metrics','tables/budget_metrics.tex'),('primary_seed_metrics','tables/primary_seed_metrics.tex')]:\n    body=text.split('% BEGIN GENERATED '+label+'\\\\n')[1].split('% END GENERATED '+label)[0]\n    if body.strip()\"'!=Path(path).read_text().strip(): issues.append(('\"'embedded table mismatch',label))\nprint('Numerical inconsistencies:',issues)\nprint('Verified CSV rows:',len(rows))\nprint('Primary vs fitted uniform case means:',np.asarray(case_means)[:,:2].tolist())\nprint('Budget MAEs:',budget_mae.tolist())\nprint('Budget Spearman:',budget_rank.tolist())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
