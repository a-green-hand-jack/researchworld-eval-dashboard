    hashes.append(aggregate.hexdigest())\n   957\t                details.append({'regime':regime,'metrics':{name:average([value[name] for value in regime_values]) for name in ORDINARY},'permutation_report_mean':average(control_values),'copy_report_independence_audit_passed':False,'report_mse_standard_error':float(np.std([value['report_mse'] for value in regime_values],ddof=1)/math.sqrt(len(regime_values)))})\n   958\t            expected=synthetic_manifest['episodes'][f\"{seed}-{size}-{arms}-{episode['reps']}\"]\n   959\t            if hashes!=expected:\n   960\t                raise RuntimeError('synthetic raw-content hash audit failed')\n   961\t        else:\n   962\t            inference_deadline=min(deadline-8,time.monotonic()+episode['work_seconds'])\n   963\t            predictions=baseline.call({'rows':[{key:row[key] for key in ['question','options','content_hash']} for row in items],'prompts':bank[:arms]},timeout=max(.001,inference_deadline-time.monotonic()))\n   964\t            if type(predictions) is not dict or set(predictions)!={'predictions'}:\n   965\t                baseline.fail('baseline_result_failure')\n   966\t            outputs=np.asarray(predictions['predictions'])\n   967\t            if outputs.shape!=(len(items),arms) or outputs.dtype.kind not in 'iu' or np.any((outputs< -1)|(outputs>9)):\n   968\t                baseline.fail('baseline_result_failure')\n   969\t            labels=np.asarray([row['answer_index'] for row in items])\n   970\t            matrix=(outputs[:size]==labels[:size,None]).astype(np.float64)\n   971\t            truth=(outputs[size:]==labels[size:,None]).mean(axis=0)\n   972\t            changed=None\n   973\t            for shift in range(1,size):\n   974\t                candidate=np.roll(labels[:size],shift)\n   975\t                if np.count_nonzero(candidate!=labels[:size])>=2:\n   976\t                    changed=candidate\n   977\t                    break\n   978\t            if changed is None:\n   979\t                raise ProtocolFailure('vacuous answer permutation')\n   980\t            control_values=controls(matrix,selection,report,order,(outputs[:size]==changed[:,None]).astype(np.float64),int(np.count_nonzero(changed!=labels[:size])))\n   981\t            for remaining in range(5,-1,-1):\n   982\t                reserved_method_deadline(now=time.monotonic(),episode_deadline=deadline,methods_remaining=remaining,work_seconds=1,cleanup_seconds=.1)\n   983\t            value,detail=summarize(matrix,truth,selection,report,order,random_arm)\n   984\t            measured.append(value)\n   985\t            differences=(outputs[size:,detail['winner']]==labels[size:]).astype(float)-(outputs[size:,0]==labels[size:]).astype(float)\n   986\t            subject_indices=collections.defaultdict(list)\n   987\t            for index,row in enumerate(items[size:]):\n   988\t                subject_indices[row['category']].append(index)\n   989\t            generator=np.random.default_rng(seed+76531)\n   990\t            subjects=sorted(subject_indices)\n   991\t            bootstrap=[]\n   992\t            for repeat in range(200):\n   993\t                if time.monotonic()+7>deadline:\n   994\t                    raise TimeoutError()\n   995\t                sample=generator.choice(subjects,len(subjects),replace=True)\n   996\t                indices=[index for subject in sample for index in subject_indices[subject]]\n   997\t                bootstrap.append(float(differences[indices].mean()))\n   998\t            label_marginals=np.bincount(labels[:size],minlength=10)/size\n   999\t            permutation_null=[float(sum(np.count_nonzero(outputs[:size,arm]==label)*label_marginals[label]/size for label in range(10))) for arm in range(arms)]\n  1000\t            detail.update(paired_subject_bootstrap_interval=np.quantile(bootstrap,[.025,.975]).tolist(),invalid_answer_count=int(np.count_nonzero(outputs<0)),audit_size=len(items)-size,controls=control_values,permutation_null_by_arm=permutation_null)\n  1001\t            details=[detail]\n  1002\t        category=baseline.status()\n  1003\t        if category is not None:\n  1004\t            baseline.fail(category)\n  1005\t        metrics={name:average([value[name] for value in measured]) for name in ORDINARY}\n  1006\t        solution={'case':episode['family']+str(size)+'K'+str(arms),'plan_hash':digest(response),'metrics':metrics,'details':details,'completed_controls':sorted(EXPECTED_CONTROLS)}\n  1007\t        signature=digest({'response':response,'metrics':metrics,'details':details})\n  1008\t        if first is None:\n  1009\t            first=signature\n  1010\t        if episode.get('replay'):\n  1011\t            replay_match=first==signature\n_random = None\n_updated = False\n\ndef prompt_bank():\n    variants = [\n        'Choose the best answer. Output only its capital letter.',\n        'Solve the question carefully, then give only the option letter.',\n        'Identify the correct option. Respond with a single capital letter.',\n        'Consider each option and select the best one. Print the letter only.',\n        'Your answer must consist solely of the correct choice letter.',\n        'Read the question and choices. Return the correct letter, no explanation.',\n        'Select one answer from the provided options. Give only its letter.',\n        'Please answer this multiple-choice question using one capital letter.',\n        'Determine which option is most accurate. Output the letter only.',\n        'Choose the single best option; omit all text except its capital letter.',\n        'Evaluate the alternatives. Give the correct answer as its option letter.',\n        'Respond to this question with the letter of the best available answer.',\n        'Find the right answer among the listed choices. Return only its letter.',\n        'Pick the most appropriate answer and output its capital letter alone.',\n        'Answer accurately. Use only the capital letter identifying your choice.',\n    ]\n    return [DEFAULT_PROMPT] + variants\n\ndef handle(request):\n    global _random, _updated\n    if type(request) is not dict:\n        raise ValueError('request must be an object')\n    if request.get('op') == 'reset':\n        if set(request) != {'op', 'seed'} or type(request['seed']) is not int or not 0 <= request['seed'] < 2**63:\n            raise ValueError('invalid reset')\n        _random = random.Random(request['seed'])\n        _updated = False\n        return {'ok': True}\n    if request.get('op') != 'update' or set(request) != {'op', 'arms', 'slots', 'confidence'} or _random is None or _updated:\n        raise ValueError('expected one update after reset')\n    arms = request['arms']\n    slots = request['slots']\n    if type(arms) is not int or not 1 <= arms <= 16 or request['confidence'] != .95 or type(slots) is not list or len(slots) < 4 or len(slots) % 4:\n        raise ValueError('invalid workload')\n    keys = [slot['key'] for slot in slots]\n    if len(set(keys)) != len(keys):\n        raise ValueError('duplicate slots')\n    _random.shuffle(keys)\n    midpoint = len(keys) // 2\n    report = keys[midpoint:]\n    _updated = True\n    return {'prompts': prompt_bank(), 'selection': keys[:midpoint], 'report': report,\n            'weights': [1 / len(report)] * len(report), 'tie_order': list(range(arms))}\n","exit_code":0,"status":"completed"}}
