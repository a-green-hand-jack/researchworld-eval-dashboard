\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Held-out accuracy of all predictors (family-weighted mean absolute log error, lower is better; the error factor is $e^{\text  {error}}$). Paired $\Delta $ is our predictor's error minus the comparator's, with 95\% two-level bootstrap CI; dashes mark comparisons for which the evaluator reports no paired interval. ``Full graph'' marks predictors that need the adjacency matrix.}}{6}{table.caption.11}\protected@file@percent }
\newlabel{tab:main}{{2}{6}{Held-out accuracy of all predictors (family-weighted mean absolute log error, lower is better; the error factor is $e^{\text {error}}$). Paired $\Delta $ is our predictor's error minus the comparator's, with 95\% two-level bootstrap CI; dashes mark comparisons for which the evaluator reports no paired interval. ``Full graph'' marks predictors that need the adjacency matrix}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Held-out mean absolute log error by predictor. (a) Fitted predictors and the permuted-feature control; the error bar on our predictor is its 95\% two-level bootstrap CI. (b) Bound-based predictors. The Matthews reference needs the full graph. The x-axis is shared across panels.}}{6}{figure.caption.12}\protected@file@percent }
\newlabel{fig:plane}{{2}{6}{Held-out mean absolute log error by predictor. (a) Fitted predictors and the permuted-feature control; the error bar on our predictor is its 95\% two-level bootstrap CI. (b) Bound-based predictors. The Matthews reference needs the full graph. The x-axis is shared across panels}{figure.caption.12}{}}
