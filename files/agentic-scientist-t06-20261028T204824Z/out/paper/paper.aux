\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Evaluation protocol. Comparison rows from four evaluation designs are fitted with a ridge Bradley--Terry model, which fixes the rank-1 competitor and its gap $G$ to the runner-up. A proposer returns at most $k$ rows to drop or reverse, with $k$ from 0.1\% to 2\% of the rows. The evaluator refits the edited data, reports whether rank 1 changed, and otherwise reports the fraction of the gap closed.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{Evaluation protocol. Comparison rows from four evaluation designs are fitted with a ridge Bradley--Terry model, which fixes the rank-1 competitor and its gap $G$ to the runner-up. A proposer returns at most $k$ rows to drop or reverse, with $k$ from 0.1\% to 2\% of the rows. The evaluator refits the edited data, reports whether rank 1 changed, and otherwise reports the fraction of the gap closed}{figure.caption.1}{}}
