{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,csv,statistics,re,hashlib\np=json.load(open('paper_data.json'));eps=p['final_evaluation']['evaluation_evidence']['episodes'];s=json.load(open('analysis/summary.json')); cs=[(e['seed'],c) for e in eps for c in e['solution']['cases']];errs=[]\nfor key,means in s['condition_means'].items():\n for m,v in means.items():\n  actual=statistics.mean(c['metrics'][m] for seed,c in cs if c['case']==key)\n  if abs(actual-v)>1e-12:errs.append((key,m,actual,v))\nfor reg,regmeans in s['regime_means'].items():\n for key,means in regmeans.items():\n  for m,v in means.items():\n   actual=statistics.mean(c['details'][int(reg)]['metrics'][m] for seed,c in cs if c['case']==key)\n   if abs(actual-v)>1e-12:errs.append(('REGIME',reg,key,m,actual,v))\nfor row in csv.DictReader(open('analysis/condition_results.csv')):\n c=next(c for seed,c in cs if seed==int(row['seed']) and c['case']==row['case'])\n for k,v in c['metrics'].items():\n  if abs(float(row[k])-v)>1e-12:errs.append(('CSV',row['case'],k))\ntext=open('paper.tex').read()\nfor line in text.splitlines():\n if not re.match(r'\"'^'\"\\\\d{4} &',line):continue\n fields=line.rstrip('\\\\\\\\').split(' & '); seed,n,kind,arms=fields[:4];case=('S' if kind=='Synth.' else 'R')+n+'K'+arms\n c=next(c for se,c in cs if se==int(seed) and c['case']==case)\n for field,k,mult in zip(fields[4:],['report_mse','reuse_mse','selected_accuracy','coverage','interval_width'],[1000,1000,1,1,1]):\n  if abs(float(field)-mult*c['metrics'][k])>0.000050001:errs.append(('SEED TABLE',seed,case,k,field))\nprint('NUMERIC CROSS-CHECK ERRORS:',errs)\nprint('CONDITION MEANS')\nfor key,ms in s['condition_means'].items():print(key,{k:round(ms[k],9) for k in ['report_mse','reuse_mse','full_budget_naive_mse','honest_half_mse','fixed_prompt_mse','random_prompt_mse','coverage','selected_accuracy','decision_reversal_rate']})\nprint('EVALUATOR DIGEST:',hashlib.sha256(open('source_evidence/evaluate_final.py','rb').read()).hexdigest())\nprint('BASELINE IDENTICAL:',open('source_evidence/downstream/program/src/program.py','rb').read()==open('source_evidence/downstream/baseline/src/program.py','rb').read())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
