00404f47322989d\",\n    88\t))\n    89\t# ----------------------------------------------------------------------------------------\n    90\t\n    91\tSTARTUP_ALLOWANCE = 20.0\n    92\tFINISH_RESERVE = 5.0\n    93\tRESET_TIMEOUT = 20.0\n    94\tRPC_CAP = 45.0\n    95\tEPISODE_WORK_SECONDS = 45.0\n    96\t# candidate terminate(2)+kill(2) waits + stderr teardown(1) + bookkeeping(1)\n    97\tEPISODE_OVERHEAD = 6.0\n    98\tMC_WALKS = 300\n    99\tSMOKE_MC_WALKS = 20\n   100\tVALIDATION_WALKS_PER_START = 300\n   101\tERR_CLIP = 10.0\n   102\tPERM_TOL = 1e-6\n   103\tPERM_DEV_WORST = 1e6\n   104\tMC_SE_WORST = 1e6\n   105\tWIRE_LIMIT = 64 * 1024 * 1024\n   106\tENVELOPE_ALLOWANCE = 4096\n   107\tCHUNK = 16\n   108\tPROXY_PATH = \"/broker-code/candidate_proxy.py\"\n   109\tMETRIC_NAMES = (\n   110\t    \"combined_score\", \"macro_log_mae\", \"bound_macro_log_mae\", \"const_macro_log_mae\",\n   111\t    \"shuffle_macro_log_mae\", \"improvement_vs_bound\", \"perm_max_rel_dev\", \"mc_rel_se_median\",\n   112\t)\n   113\t\n   114\t\n   115\t# ----------------------------------------------------------------------------------------\n   116\t# Generic bounded helpers\n   117\t# ----------------------------------------------------------------------------------------\n   118\tdef cpu_limit_seconds(wall_seconds, allowed_threads):\n   119\t    if (type(wall_seconds) not in (int, float) or not math.isfinite(wall_seconds)\n   120\t            or wall_seconds <= 0 or type(allowed_threads) is not int or allowed_threads <= 0):\n   121\t        raise ValueError(\"invalid CPU budget\")\n   122\t    return math.ceil(wall_seconds * allowed_threads)\n   123\t\n   124\t\n   125\tdef bounded_json_line(value, wire_limit=WIRE_LIMIT):\n   126\t    encoded = json.dumps(value, allow_nan=False, separators=(\",\", \":\")).encode(\"utf-8\") + b\"\\n\"\n   127\t    if len(encoded) + ENVELOPE_ALLOWANCE >= wire_limit:\n   128\t        raise ValueError(\"complete message exceeds wire limit\")\n   129\t    return encoded\n   130\t\n   131\t\n   132\tdef finite_budget_seconds(value):\n   133\t    if type(value) not in (int, float) or not math.isfinite(value) or value < 0:\n   134\t        raise ValueError(\"invalid time allowance\")\n   135\t    return value\n   136\t\n   137\t\n   138\tdef positive_work_seconds(value):\n   139\t    if finite_budget_seconds(value) == 0:\n   140\t        raise ValueError(\"work allowance must be positive\")\n   141\t    return value\n   142\t\n   143\t\n   144\tdef require_joint_workload_budget(*, plane_profile):\n   145\t    profile = plane_profile\n   146\t    episodes, methods = profile[\"episode_count\"], profile[\"method_count\"]\n   147\t    if any(type(count) is not int or count <= 0 for count in (episodes, methods)):\n   148\t        raise ValueError(\"invalid episode or method count\")\n   149\t    times = {name: finite_budget_seconds(profile[name]) for name in (\n   150\t        \"wall_seconds\", \"startup_seconds\", \"reset_seconds\", \"cleanup_seconds\", \"finish_seconds\")}\n   151\t    work = positive_work_seconds(profile[\"work_seconds\"])\n   152\t    needed = (times[\"startup_seconds\"] + times[\"finish_seconds\"]\n   153\t              + episodes * (times[\"reset_seconds\"] + methods * (work + times[\"cleanup_seconds\"])))\n   154\t    finite_budget_seconds(needed)\n   155\t    if needed > times[\"wall_seconds\"]:\n   156\t        raise ValueError(\"productive work exceeds the declared wall budget\")\n   157\t    return needed\n   158\t\n   159\t\n   160\tdef fixed_weight_score(values, weights, worst_case):\n   161\t    if (not values or len(values) != len(weights)\n   162\t            or any(not math.isfinite(w) or w < 0 for w in weights)\n   163\t            or not math.isclose(sum(weights), 1.0, rel_tol=0, abs_tol=1e-12)):\n   164\t        raise ValueError(\"invalid predeclared aggregation weights\")\n   165\t    retained = [worst_case if value is None else value for value in values]\n   166\t    if not all(math.isfinite(value) for value in retained):\n   167\t        raise ValueError(\"nonfinite contribution\")\n   168\t    return sum(value * weight for value, weight in zip(retained, weights))\n   169\t\n   170\t\n   171\tdef candidate_subprocess_settings(parent_environment):\n   172\t    runtime_names = (\n   173\t        \"PATH\", \"LD_LIBRARY_PATH\", \"LANG\", \"LC_ALL\", \"TZ\",\n   174\t        \"CUDA_VISIBLE_DEVICES\", \"NVIDIA_VISIBLE_DEVICES\", \"NVIDIA_DRIVER_CAPABILITIES\",\n   175\t        \"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\",\n   176\t        \"XLA_PYTHON_CLIENT_PREALLOCATE\", \"XLA_PYTHON_CLIENT_MEM_FRACTION\",\n   177\t        \"XLA_PYTHON_CLIENT_ALLOCATOR\",\n   178\t    )\n   179\t    environment = {name: parent_environment[name] for name in runtime_names if name in parent_environment}\n   180\t    environment.update(\n   181\t        HOME=\"/nonexistent\",\n   182\t        PYTHONNOUSERSITE=\"1\",\n   183\t        PYTHONDONTWRITEBYTECODE=\"1\",\n   184\t        PYTHONUNBUFFERED=\"1\",\n   185\t        OMP_NUM_THREADS=\"1\",\n   186\t        OPENBLAS_NUM_THREADS=\"1\",\n   187\t        MKL_NUM_THREADS=\"1\",\n   188\t        NUMEXPR_NUM_THREADS=\"1\",\n   189\t    )\n   190\t    return parent_environment.get(\"TASK_PYTHON\", sys.executable), environment\n   191\t\n   192\t\n   193\t# ----------------------------------------------------------------------------------------\n   194\t# Failure identity helpers\n   195\t# ----------------------------------------------------------------------------------------\n   196\tclass InvalidResetResponse(RuntimeError):\n   197\t    pass\n   198\t\n   199\t\n   200\tdef require_reset_ack(response):\n   201\t    if type(response) is not dict or set(response) != {\"ok\"} or response[\"ok\"] is not True:\n   202\t        raise InvalidResetResponse(\"invalid reset response\")\n   203\t\n   204\t\n   205\tdef bounded_failure_name(value, fallback):\n   206\t    import re\n   207\t    return value if isinstance(value, str) and re.fullmatch(r\"[a-z][a-z0-9_]{0,79}\", value) else fallback\n   208\t\n   209\t\n   210\tclass RequiredBaselineFailure(RuntimeError):\n   211\t    def __init__(self, category):\n   212\t        self.category = bounded_failure_name(category, \"invalid_baseline_diagnostic\")\n   213\t        super().__init__(\"required baseline failed\")\n   214\t\n   215\t\n   216\tclass CandidateProtocolError(RuntimeError):\n   217\t    \"\"\"Expected candidate-side protocol failure with a fixed bounded category.\"\"\"\n   218\t\n   219\t    def __init__(self, category):\n   220\t        self.category = bounded_failure_name(category, \"protocol_error\")\n   221\t        super().__init__(\"candidate protocol failure\")\n   222\t\n   223\t\n   224\tdef describe_episode_failure(error, operation):\n   225\t    context = error\n   226\t    for _ in range(8):\n   227\t        if isinstance(context, InvalidResetResponse):\n   228\t            return {\"component\": \"candidate\", \"category\": \"invalid_reset_response\", \"operation\": \"reset\"}\n   229\t        if isinstance(context, RequiredBaselineFailure):\n   230\t            return {\"component\": \"baseline\", \"category\": context.category, \"operation\": \"baseline_worker\"}\n   231\t        if isinstance(context, CandidateProtocolError):\n   232\t            return {\"component\": \"candidate\", \"category\": context.category,\n   233\t                    \"operation\": bounded_failure_name(operation, \"unknown\")}\n   234\t        context = context.__context__\n   235\t        if context is None:\n   236\t            break\n   237\t    return {\"component\": \"candidate\", \"category\": \"timeout\",\n   238\t            \"operation\": bounded_failure_name(operation, \"unknown\")}\n   239\t\n   240\t\n   241\tdef fail_required_baseline(category, cancel_work, record_failure):\n   242\t    failure = RequiredBaselineFailure(category)\n   243\t    try:\n   244\t        record_failure(failure.category)\n   245\t    except Exception:\n   246\t        failure.add_note(\"baseline diagnostic recording failed\")\n   247\t    try:\n   248\t        cancel_work()\n   249\t    except Exception:\n   250\t        failure.add_note(\"baseline cleanup failed\")\n   251\t    raise failure from None\n   252\t\n   253\t\n   254\tclass BoundedWorkerStderr:\n   255\t    LIMIT = 4096\n   256\t\n   257\t    def __init__(self, stream):\n   258\t        self.stream = stream\n   259\t        self.fd = stream.fileno()\n   260\t        os.set_blocking(self.fd, False)\n   261\t        self.lines = collections.deque()\n   262\t        self.pending = bytearray()\n   263\t        self.dropping_line = False\n   264\t        self.observed_bytes = 0\n   265\t        self.retained_bytes = 0\n   266\t        self.truncated = False\n   267\t        self.capture_error = None\n   268\t        self.stop = threading.Event()\n   269\t        self.result = None\n   270\t        self.reader = threading.Thread(target=self._drain, name=\"worker-stderr-reader\")\n   271\t        self.reader.start()\n   272\t\n   273\t    def _accept(self, chunk):\n   274\t        self.observed_bytes += len(chunk)\n   275\t        for segment in chunk.splitlines(keepends=True):\n   276\t            complete = segment.endswith(b\"\\n\")\n   277\t            if not self.dropping_line:\n   278\t                if len(self.pending) + len(segment) > self.LIMIT:\n   279\t                    self.pending.clear()\n   280\t                    self.dropping_line = True\n   281\t                    self.truncated = True\n   282\t                else:\n   283\t                    self.pending.extend(segment)\n   284\t            if complete:\n   285\t                if not self.dropping_line:\n   286\t                    line = bytes(self.pending).decode(\"utf-8\", errors=\"replace\")\n   287\t                    size = len(line.encode(\"utf-8\"))\n   288\t                    if size <= self.LIMIT:\n   289\t             