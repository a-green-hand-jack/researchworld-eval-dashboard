{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,hashlib,statistics,math\nfrom pathlib import Path\np=json.loads(Path('paper_data.json').read_text())\nder=json.loads(Path('derived/observations.json').read_text())['rows']\nerrors=[]; counts={}\nfor scope,key in [('development','best_correct'),('final','final_evaluation')]:\n for ep in p[key]['evaluation_evidence']['episodes']:\n  for rec in ep['solution']['widths']:\n   if rec is None: continue\n   counts[scope]=counts.get(scope,0)+1\n   for arm,obs in rec['arms'].items():\n    curve=obs['curves']; evt=rec['events'][arm]\n    def onset(field,threshold):\n     return next((window[0]['step'] for index in range(len(curve)-2) if all(pt[field]>=threshold for pt in (window:=curve[index:index+3]))),None)\n    fit=onset('train_accuracy',.99); gen=onset('evaluation_accuracy',.95)\n    match=[row for row in der if (row['scope'],row['seed'],row['width'],row['arm'])==(scope,ep['seed'],rec['width'],arm)]\n    if len(match)\"'!=1: errors.append(('\"'derived match',scope,ep['seed'],rec['width'],arm)); continue\n    row=match[0]\n    comparisons={'fit':fit,'generalize':gen,'accuracy':curve[-1]['evaluation_accuracy'],'train_accuracy':curve[-1]['train_accuracy'],'train_loss':curve[-1]['train_loss'],'evaluation_loss':curve[-1]['evaluation_loss'],'initial_norm':curve[0]['global_norm'],'final_norm':curve[-1]['global_norm'],'parameter_count':292*rec['width']+97,'initial_hash':obs['initial_state_sha256'],'final_hash':obs['final_state_sha256'],'updates':obs['updates'],'duration_seconds':obs['duration_seconds'],'configuration':rec['configuration']}\n    for field,value in comparisons.items():\n     if row[field]\"'!=value: errors.append(('\"'derived mismatch',scope,ep['seed'],rec['width'],arm,field))\n    if fit\"'!=evt['\"'memorization_step'] or gen\"'!=evt['\"'generalization_step']:errors.append(('event mismatch',scope,ep['seed'],rec['width'],arm))\n    if [pt['step'] for pt in curve]\"'!=list(range(0,rec['\"'horizon']+1,100)): errors.append(('checkpoints mismatch',scope,ep['seed'],rec['width'],arm))\n    print(scope,ep['seed'],rec['width'],arm,'acc=%.6f'%(100*curve[-1]['evaluation_accuracy']),'fit='+str(fit),'onset='+str(gen))\n   if rec['width']==128:\n    studied=rec['arms']['candidate']; norm=rec['arms']['initial_norm']\n    if any(studied[field]\"'!=norm[field] for field in ['\"'initial_state_sha256','final_state_sha256']):errors.append(('duplicate hash mismatch',scope,ep['seed']))\n    if [{k:v for k,v in pt.items() if k\"'!='\"'wall_seconds'} for pt in studied['curves']] \"'!= [{k:v for k,v in pt.items() if k!='\"'wall_seconds'} for pt in norm['curves']]:errors.append(('duplicate curve mismatch',scope,ep['seed']))\nprint('COUNTS',counts,'ERRORS',errors)\nprint('SOURCE HASH',hashlib.sha256(Path('source_evidence/task/evaluate_final.py').read_bytes()).hexdigest(),p['final_evaluation']['evaluator_sha256'])\nfor pool in ['search','final']:\n data=json.loads(Path(f'source_evidence/task/resources/{pool}/dataset.json').read_text())\n print('POOL',pool,data['pool_size'],[(seed,len(split['train']),len(split['evaluation'])) for seed,split in data['splits'].items()])\nsearch=json.loads(Path('source_evidence/task/resources/search/dataset.json').read_text()); final=json.loads(Path('source_evidence/task/resources/final/dataset.json').read_text())\nprint('POOL_OVERLAP',len({tuple(row[:2]) for row in search['rows']} & {tuple(row[:2]) for row in final['rows']}))\nfor width in [32,128,256]:\n values=[row['accuracy']*100 for row in der if row['scope']=='development' and row['arm']=='candidate' and row['width']==width]\n print('DEVELOPMENT_MEAN_SD',width,statistics.mean(values),statistics.stdev(values))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
