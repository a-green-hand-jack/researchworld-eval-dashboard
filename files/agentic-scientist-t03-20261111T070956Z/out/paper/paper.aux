\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Protocol overview. A trained model and an explained instance yield one assessed Kernel SHAP run at budget $4d$ or $16d$. Eight independent reruns define the reproducibility label (mean top-3 Jaccard with the assessed run). The self-diagnostic sees only the assessed run and returns $\hat  r$, which is scored by squared error against the label and compared with three baselines and a pairing-permuted control.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{Protocol overview. A trained model and an explained instance yield one assessed Kernel SHAP run at budget $4d$ or $16d$. Eight independent reruns define the reproducibility label (mean top-3 Jaccard with the assessed run). The self-diagnostic sees only the assessed run and returns $\rhat $, which is scored by squared error against the label and compared with three baselines and a pairing-permuted control}{figure.caption.2}{}}
