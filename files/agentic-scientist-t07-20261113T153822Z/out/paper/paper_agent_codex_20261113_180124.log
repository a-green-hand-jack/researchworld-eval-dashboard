{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport requests,re,subprocess,pathlib\nfor package,prefix in [('gpgme1.0','libgpgmepp6_'),('gpgmepp','libgpgmepp6_')]:\n url=f'https://deb.debian.org/debian/pool/main/g/{package}/'; response=requests.get(url)\n names=[x for x in re.findall(r'href=\\\"([\"'^\"]*amd64.deb)\"'\"',response.text) if x.startswith(prefix)]\n print(package,names[-4:])\n if names:\n  name=next((x for x in names if '1.24' in x or '1.23' in x),names[-1]); path=pathlib.Path('/tmp')/name; path.write_bytes(requests.get(url+name).content); subprocess.run(['dpkg-deb','-x',str(path),'/tmp/poppler'],check=True)\nPY\nLD_LIBRARY_PATH=/tmp/poppler/usr/lib/x86_64-linux-gnu /tmp/poppler/usr/bin/pdftotext -v\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
