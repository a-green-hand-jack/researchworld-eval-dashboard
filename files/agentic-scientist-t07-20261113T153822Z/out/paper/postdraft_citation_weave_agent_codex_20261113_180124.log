i = {10.1080/00401706.1970.10488634}\n}\n\n@misc{Elfving1952,\n title = {Optimum Allocation in Linear Regression Theory},\n author = {G. Elfving},\n year = {1952},\n howpublished = {The Annals of Mathematical Statistics},\n doi = {10.1214/aoms/1177729442}\n}\n\n@misc{Kiefer1960,\n title = {The Equivalence of Two Extremum Problems},\n author = {J. Kiefer and Jacob Wolfowitz},\n year = {1960},\n howpublished = {Canadian Journal of Mathematics},\n doi = {10.4153/CJM-1960-030-4}\n}\n\n@misc{Andersen1970,\n title = {Asymptotic Properties of Conditional Maximum-Likelihood Estimators},\n author = {Erling Bernhard Andersen},\n year = {1970},\n howpublished = {Journal of the Royal Statistical Society Series B (Statistical Methodology)},\n doi = {10.1111/j.2517-6161.1970.tb00842.x}\n}\n\n@misc{Dempster1977,\n title = {Maximum Likelihood from Incomplete Data Via the EM Algorithm},\n author = {A. P. Dempster and Nan M. Laird and Donald B. Rubin},\n year = {1977},\n howpublished = {Journal of the Royal Statistical Society Series B (Statistical Methodology)},\n doi = {10.1111/j.2517-6161.1977.tb01600.x}\n}\n\n@misc{Hastie2009,\n title = {The Elements of Statistical Learning},\n author = {Trevor J. Hastie and Robert John Tibshirani and Jerome H. Friedman},\n year = {2009},\n howpublished = {Springer series in statistics},\n doi = {10.1007/978-0-387-84858-7}\n}\n\n@misc{Bishop2006,\n title = {Pattern Recognition and Machine Learning},\n author = {Chris Bishop},\n year = {2006},\n howpublished = {Springer eBooks},\n doi = {10.1007/978-0-387-45528-0}\n}\n\n@misc{Efron1979,\n title = {Bootstrap Methods: Another Look at the Jackknife},\n author = {Bradley Efron},\n year = {1979},\n howpublished = {The Annals of Statistics},\n doi = {10.1214/aos/1176344552}\n}\n\n@misc{Rubin1976,\n title = {Inference and Missing Data},\n author = {Donald B. Rubin},\n year = {1976},\n howpublished = {Biometrika},\n doi = {10.1093/biomet/63.3.581}\n}\n\n@misc{Little2019,\n title = {Statistical Analysis with Missing Data},\n author = {Roderick J. A. Little and Donald B. Rubin},\n year = {2002},\n howpublished = {Wiley series in probability and statistics},\n doi = {10.1002/9781119013563}\n}\n\n@misc{Roberts2017,\n title = {Cross‐validation strategies for data with temporal, spatial, hierarchical, or phylogenetic structure},\n author = {David R. Roberts and Volker Bahn and Simone Ciuti and Mark S. Boyce and Jane Elith and Gurutzeta Guillera‐Arroita and Severin Hauenstein and José Joaquín Lahoz‐Monfort and Boris Schröder and Wilfried Thuiller and David I. Warton and Brendan Anthony Wintle and Florian Hartig and Carsten F. Dormann},\n year = {2016},\n howpublished = {Ecography},\n doi = {10.1111/ecog.02881}\n}\n\n@misc{Varma2006,\n title = {Bias in error estimation when using cross-validation for model selection},\n author = {Sudhir Varma and Richard M Simon},\n year = {2006},\n howpublished = {BMC Bioinformatics},\n doi = {10.1186/1471-2105-7-91}\n}\n\n@misc{Arlot2010,\n title = {A survey of cross-validation procedures for model selection},\n author = {Sylvain Arlot and Alain Célisse},\n year = {2010},\n howpublished = {Statistics Surveys},\n doi = {10.1214/09-SS054}\n}\n\n@misc{Stone1974,\n title = {Cross-Validatory Choice and Assessment of Statistical Predictions},\n author = {M. Stone},\n year = {1974},\n howpublished = {Journal of the Royal Statistical Society Series B (Statistical Methodology)},\n doi = {10.1111/j.2517-6161.1974.tb00994.x}\n}\n\n@misc{Kendall1938,\n title = {A NEW MEASURE OF RANK CORRELATION},\n author = {Maurice G. Kendall},\n year = {1938},\n howpublished = {Biometrika},\n doi = {10.1093/biomet/30.1-2.81}\n}\n\n@misc{Spearman1904,\n title = {The Proof and Measurement of Association between Two Things},\n author = {C. Spearman},\n year = {1904},\n howpublished = {The American Journal of Psychology},\n doi = {10.2307/1412159}\n}\n\n@misc{BenDavid2010,\n title = {A theory of learning from different domains},\n author = {Shai Ben-David and John C. Blitzer and Koby Crammer and Alex Kulesza and Fernando M. B. Pereira and Jennifer Wortman Vaughan},\n year = {2009},\n howpublished = {Machine Learning},\n doi = {10.1007/s10994-009-5152-4}\n}\n\n@misc{Brier1950,\n title = {VERIFICATION OF FORECASTS EXPRESSED IN TERMS OF PROBABILITY},\n author = {Glenn W. Brier},\n year = {1950},\n howpublished = {Monthly Weather Review},\n doi = {10.1175/1520-0493(1950)078<0001:VOFEIT>2.0.CO;2}\n}\n{\n  \"generated_at\": \"2026-11-13T18:27:39.477580+00:00\",\n  \"count\": 25,\n  \"queries\": [\n    \"Exact DOI: 10.48550/arXiv.2309.08638\",\n    \"Exact DOI: 10.48550/arXiv.2402.14992\",\n    \"Exact DOI: 10.48550/arXiv.2407.12844\",\n    \"Exact DOI: 10.48550/arXiv.2409.03563\",\n    \"Exact DOI: 10.48550/arXiv.2410.05952\",\n    \"Exact DOI: 10.48550/arXiv.2211.09110\",\n    \"Exact DOI: 10.48550/arXiv.2406.01574\",\n    \"Exact DOI: 10.1080/00401706.1970.10488634\",\n    \"Exact DOI: 10.1214/aoms/1177729442\",\n    \"Exact DOI: 10.4153/CJM-1960-030-4\",\n    \"Exact DOI: 10.1111/j.2517-6161.1970.tb00842.x\",\n    \"Exact DOI: 10.1111/j.2517-6161.1977.tb01600.x\",\n    \"Exact DOI: 10.1007/978-0-387-84858-7\",\n    \"Exact DOI: 10.1007/978-0-387-45528-0\",\n    \"Exact DOI: 10.1214/aos/1176344552\",\n    \"Exact DOI: 10.1093/biomet/63.3.581\",\n    \"Exact DOI: 10.1002/9781119013563\",\n    \"Exact DOI: 10.1111/ecog.02881\",\n    \"Exact DOI: 10.1186/1471-2105-7-91\",\n    \"Exact DOI: 10.1214/09-SS054\",\n    \"Exact DOI: 10.1111/j.2517-6161.1974.tb00994.x\",\n    \"Exact DOI: 10.1093/biomet/30.1-2.81\",\n    \"Exact DOI: 10.2307/1412159\",\n    \"Exact DOI: 10.1007/s10994-009-5152-4\",\n    \"Exact DOI: 10.1175/1520-0493(1950)078<0001:VOFEIT>2.0.CO;2\"\n  ],\n  \"references\": [\n    {\n      \"id\": \"ref.openalex.W4411630215\",\n      \"paper_id\": \"https://openalex.org/W4411630215\",\n      \"citation_key\": \"Vivek2024\",\n      \"title\": \"Anchor Points: Benchmarking Models with Much Fewer Examples\",\n      \"year\": 2024,\n      \"venue\": \"Conference of the European Chapter of the Association for Computational Linguistics\",\n      \"query\": \"Exact DOI: 10.48550/arXiv.2309.08638\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.48550/arXiv.2309.08638\",\n      \"retrieved_at\": \"2026-11-13T18:27:33.577497+00:00\",\n      \"abstract\": \"Modern language models often exhibit powerful but brittle behavior, leading to the development of larger and more diverse benchmarks to reliably assess their behavior.Here, we suggest that model performance can be benchmarked and elucidated with much smaller evaluation sets.We first show that in six popular language classification benchmarks, model confidence in the correct class on many pairs of points is strongly correlated across models.We build upon this phenomenon to propose Anchor Point Selection, a technique to select small subsets of datasets that capture model behavior across the entire dataset.Anchor points reliably rank models: across 87 diverse language model-prompt pairs, evaluating models using 1-30 anchor points outperforms uniform sampling and other baselines at accurately ranking models.Moreover, just a dozen anchor points can be used to estimate model per-class predictions on all other points in a dataset with low error, sufficient for gauging where the model is likely to fail.Lastly, we present Anchor Point Maps for visualizing these insights and facilitating comparisons of the performance of different models on various regions within the dataset distribution.\",\n      \"doi\": \"10.48550/arXiv.2309.08638\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W4392181972\",\n      \"paper_id\": \"https://openalex.org/W4392181972\",\n      \"citation_key\": \"Polo2024\",\n      \"title\": \"tinyBenchmarks: evaluating LLMs with fewer examples\",\n      \"year\": 2024,\n      \"venue\": \"arXiv (Cornell University)\",\n      \"query\": \"Exact DOI: 10.48550/arXiv.2402.14992\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.48550/arXiv.2402.14992\",\n      \"retrieved_at\": \"2026-11-13T18:27:33.383236+00:00\",\n      \"abstract\": \"The versatility of large language models (LLMs) led to the creation of diverse benchmarks that thoroughly test a variety of language models' abilities. These benchmarks consist of tens of thousands of examples making evaluation of LLMs very expensive. In this paper, we investigate strategies to reduce the number of evaluations needed to assess the performance of an LLM on several key benchmarks. For example, we show that to accurately estimate the performance of an LLM on MMLU, a popular multiple-choice QA benchmark consisting of 14K examples, it is sufficient to evaluate this LLM on 100 curated examples. We release evaluation tools and tiny versions of popular benchmarks: Open LLM Leaderboard, MMLU, HELM, and AlpacaEval 2.0. Our empirical analysis demonstrates that these tools and tiny benchmarks are sufficient to reliably and efficiently reproduce the original evaluation results.\",\n      \"doi\": \"10.48550/arXiv.2402.14992\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W4406058560\",\n      \"paper_id\": \"https://openalex.org/W4406058560\",\n      \"citation_key\": \"Kipnis2025\",\n      \"title\": \"metabench -- A Sparse Benchmark of Reasoning and Knowledge in Large Language Models\",\n      \"year\": 2024,\n      \"venue\": \"arXiv (Cornell University)\",\n      \"query\": \"Exact DOI: 10.48550/arXiv.2407.12844\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.48550/arXiv.2407.12844\",\n      \"retrieved_at\": \"2026-11-13T18:27:33.762496+00:00\",\n      \"abstract\": \"Large Language Models (LLMs) vary in their abilities on a range of tasks. Initiatives such as the Open LLM Leaderboard aim to quantify these differences with several large benchmarks (sets of test items to which an LLM can respond either correctly or incorrectly). However, high correlations within and between benchmark scores suggest that (1) there exists a small set of common underlying abilities that these benchmarks measure, and (2) items tap into redundant information and the benchmarks may thus be considerably compressed. We use data from n > 5000 LLMs to identify the most informative items of six benchmarks, ARC, GSM8K, HellaSwag, MMLU, TruthfulQA and WinoGrande (with d = 28,632 items in total). From them we distill a sparse benchmark, metabench, that has less than 3% of the original size of all six benchmarks combined. This new sparse benchmark goes beyond point scores by yielding estimators of the underlying benchmark-specific abilities. We show that these estimators (1) can be used to reconstruct each original individual benchmark score with, on average, 1.24% root mean square error (RMSE), (2) reconstruct the original total score with 0.58% RMSE, and (3) have a single underlying common factor whose Spearman correlation with the total score is r = 0.94.\",\n      \"doi\": \"10.48550/arXiv.2407.12844\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W4403556531\",\n      \"paper_id\": \"https://openalex.org/W4403556531\",\n      \"citation_key\": \"Pacchiardi2024\",\n      \"title\": \"100 instances is all you need: predicting the success of a new LLM on unseen data by testing on a few instances\",\n      \"year\": 2024,\n      \"venue\": \"arXiv (Cornell University)\",\n      \"query\": \"Exact DOI: 10.48550/arXiv.2409.03563\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.48550/arXiv.2409.03563\",\n      \"retrieved_at\": \"2026-11-13T18:27:33.628072+00:00\",\n      \"abstract\": \"Predicting the performance of LLMs on individual task instances is essential to ensure their reliability in high-stakes applications. To do so, a possibility is to evaluate the considered LLM on a set of task instances and train an assessor to predict its performance based on features of the instances. However, this approach requires evaluating each new LLM on a sufficiently large set of task instances to train an assessor specific to it. In this work, we leverage the evaluation results of previously tested LLMs to reduce the number of evaluations required to predict the performance of a new LLM. In practice, we propose to test the new LLM on a small set of reference instances and train a generic assessor which predicts the performance of the LLM on an instance based on the performance of the former on the reference set and features of the instance of interest. We conduct empirical studies on HELM-Lite and KindsOfReasoning, a collection of existing reasoning datasets that we introduce, where we evaluate all instruction-fine-tuned OpenAI models until the January 2024 version of GPT4. When predicting performance on instances with the same distribution as those used to train the generic assessor, we find this achieves performance comparable to the LLM-specific assessors trained on the full set of instances. Additionally, we find that randomly selecting the reference instances performs as well as some advanced selection methods we tested. For out of distribution, however, no clear winner emerges and the overall performance is worse, suggesting that the inherent predictability of LLMs is low.\",\n      \"doi\": \"10.48550/arXiv.2409.03563\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W4403344243\",\n      \"paper_id\": \"https://openalex.org/W4403344243\",\n      \"citation_key\": \"Li2025\",\n      \"title\": \"Active Evaluation Acquisition for Efficient LLM Benchmarking\",\n      \"year\": 2024,\n      \"venue\": \"arXiv (Cornell University)\",\n      \"query\": \"Exact DOI: 10.48550/arXiv.2410.05952\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.48550/arXiv.2410.05952\",\n      \"retrieved_at\": \"2026-11-13T18:27:34.649008+00:00\",\n      \"abstract\": \"As large language models (LLMs) become increasingly versatile, numerous large scale benchmarks have been developed to thoroughly assess their capabilities. These benchmarks typically consist of diverse datasets and prompts to evaluate different aspects of LLM performance. However, comprehensive evaluations on hundreds or thousands of prompts incur tremendous costs in terms of computation, money, and time. In this work, we investigate strategies to improve evaluation efficiency by selecting a subset of examples from each benchmark using a learned policy. Our approach models the dependencies across test examples, allowing accurate prediction of the evaluation outcomes for the remaining examples based on the outcomes of the selected ones. Consequently, we only need to acquire the actual evaluation outcomes for the selected subset. We rigorously explore various subset selection policies and introduce a novel RL-based policy that leverages the captured dependencies. Empirical results demonstrate that our approach significantly reduces the number of evaluation prompts required while maintaining accurate performance estimates compared to previous methods.\",\n      \"doi\": \"10.48550/arXiv.2410.05952\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W4320003957\",\n      \"paper_id\": \"https://openalex.org/W4320003957\",\n      \"citation_key\": \"Liang2023\",\n      \"title\": \"Holistic Evaluation of Language Models\",\n      \"year\": 2022,\n      \"venue\": \"arXiv (Cornell University)\",\n      \"query\": \"Exact DOI: 10.48550/arXiv.2211.09110\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.48550/arXiv.2211.09110\",\n      \"retrieved_at\": \"2026-11-13T18:27:34.917766+00:00\",\n      \"abstract\": \"Language models (LMs) are becoming the foundation for almost all major language technologies, but their capabilities, limitations, and risks are not well understood. We present Holistic Evaluation of Language Models (HELM) to improve the transparency of language models. First, we taxonomize the vast space of potential scenarios (i.e. use cases) and metrics (i.e. desiderata) that are of interest for LMs. Then we select a broad subset based on coverage and feasibility, noting what's missing or underrepresented (e.g. question answering for neglected English dialects, metrics for trustworthiness). Second, we adopt a multi-metric approach: We measure 7 metrics (accuracy, calibration, robustness, fairness, bias, toxicity, and efficiency) for each of 16 core scenarios when possible (87.5% of the time). This ensures metrics beyond accuracy don't fall to the wayside, and that trade-offs are clearly exposed. We also perform 7 targeted evaluations, based on 26 targeted scenarios, to analyze specific aspects (e.g. reasoning, disinformation). Third, we conduct a large-scale evaluation of 30 prominent language models (spanning open, limited-access, and closed models) on all 42 scenarios, 21 of which were not previously used in mainstream LM evaluation. Prior to HELM, models on average were evaluated on just 17.9% of the core HELM scenarios, with some prominent models not sharing a single scenario in common. We improve this to 96.0%: now all 30 models have been densely benchmarked on the same core scenarios and metrics under standardized conditions. Our evaluation surfaces 25 top-level findings. For full transparency, we release all raw model prompts and completions publicly for further analysis, as well as a general modular toolkit. We intend for HELM to be a living benchmark for the community, continuously updated with new scenarios, metrics, and models.\",\n      \"doi\": \"10.48550/arXiv.2211.09110\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W4415796274\",\n      \"paper_id\": \"https://openalex.org/W4415796274\",\n      \"citation_key\": \"Wang2024\",\n      \"title\": \"MMLU-Pro: A More Robust and Challenging Multi-Task Language Understanding Benchmark\",\n      \"year\": 2024,\n      \"venue\": \"neural information processing systems\",\n      \"query\": \"Exact DOI: 10.48550/arXiv.2406.01574\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.48550/arXiv.2406.01574\",\n      \"retrieved_at\": \"2026-11-13T18:27:34.576274+00:00\",\n      \"abstract\": \"In the age of large-scale language models, benchmarks like the Massive Multitask Language Understanding (MMLU) have been pivotal in pushing the boundaries of what AI can achieve in language comprehension and reasoning across diverse domains. However, as models continue to improve, their performance on these benchmarks has begun to plateau, making it increasingly difficult to discern differences in model capabilities. This paper introduces MMLU-Pro, an enhanced dataset designed to extend the mostly knowledge-driven MMLU benchmark by integrating more challenging, reasoning-focused questions and expanding the choice set from four to ten options. Additionally, MMLU-Pro eliminates the trivial and noisy questions in MMLU. Our experimental results show that MMLU-Pro not only raises the challenge, causing a significant drop in accuracy by 16% to 33% compared to MMLU but also demonstrates greater stability under varying prompts. With 24 different prompt styles tested, the sensitivity of model scores to prompt variations decreased from 4-5% in MMLU to just 2% in MMLU-Pro. Additionally, we found that models utilizing Chain of Thought (CoT) reasoning achieved better performance on MMLU-Pro compared to direct answering, which is in stark contrast to the findings on the original MMLU, indicating that MMLU-Pro includes more complex reasoning questions. Our assessments confirm that MMLU-Pro is a more discriminative benchmark to better track progress in the field.\",\n      \"doi\": \"10.48550/arXiv.2406.01574\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W4234698323\",\n      \"paper_id\": \"https://openalex.org/W4234698323\",\n      \"citation_key\": \"Hoerl1970\",\n      \"title\": \"Ridge Regression: Biased Estimation for Nonorthogonal Problems\",\n      \"year\": 1970,\n      \"venue\": \"Technometrics\",\n      \"query\": \"Exact DOI: 10.1080/00401706.1970.10488634\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1080/00401706.1970.10488634\",\n      \"retrieved_at\": \"2026-11-13T18:27:34.731151+00:00\",\n      \"abstract\": \"In multiple regression it is shown that parameter estimates based on minimum residual sum of squares have a high probability of being unsatisfactory, if not incorrect, if the prediction vectors are not orthogonal. Proposed is an estimation procedure based on adding small positive quantities to the diagonal of X\\u2032X. Introduced is the ridge trace, a method for showing in two dimensions the effects of nonorthogonality. It is then shown how to augment X\\u2032X to obtain biased estimates with smaller mean square error.\",\n      \"doi\": \"10.1080/00401706.1970.10488634\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W1968867201\",\n      \"paper_id\": \"https://openalex.org/W1968867201\",\n      \"citation_key\": \"Elfving1952\",\n      \"title\": \"Optimum Allocation in Linear Regression Theory\",\n      \"year\": 1952,\n      \"venue\": \"The Annals of Mathematical Statistics\",\n      \"query\": \"Exact DOI: 10.1214/aoms/1177729442\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1214/aoms/1177729442\",\n      \"retrieved_at\": \"2026-11-13T18:27:35.611214+00:00\",\n      \"abstract\": \"If for the estimation of $\\\\beta_1, \\\\beta_2$ different observations (``sources'') of form (1.1) are potentially available, each of them being repeatable as many times as we please, the question arises which of them the experimenter should utilize, and in what proportions. With appropriate optimality conventions the answer is the following. For the estimation of a single quantity of form $\\\\theta = \\\\alpha_1\\\\beta_1 + \\\\alpha_2\\\\beta_2$ the optimum allocation comprises two sources only; for the estimation of both parameters, the corresponding number is two or three; the best proportions are indicated in Sections 2 and 4 below. Generalizations to more than two parameters and to observations at different costs are briefly discussed. The problem is related to Hotelling's weighing problem [2] and to the topics treated by David and Neyman in [1].\",\n      \"doi\": \"10.1214/aoms/1177729442\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2064868327\",\n      \"paper_id\": \"https://openalex.org/W2064868327\",\n      \"citation_key\": \"Kiefer1960\",\n      \"title\": \"The Equivalence of Two Extremum Problems\",\n      \"year\": 1960,\n      \"venue\": \"Canadian Journal of Mathematics\",\n      \"query\": \"Exact DOI: 10.4153/CJM-1960-030-4\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.4153/CJM-1960-030-4\",\n      \"retrieved_at\": \"2026-11-13T18:27:35.683989+00:00\",\n      \"abstract\": \"Let f1 , \\u2026, fk be linearly independent real functions on a space X, such that the range R of (f1, \\u2026, fk) is a compact set in k dimensional Euclidean space. (This will happen, for example, if the fi are continuous and X is a compact topological space.) Let S be any Borel field of subsets of X which includes X and all sets which consist of a finite number of points, and let C = {\\u03b5} be any class of probability measures on S which includes all probability measures with finite support (that is, which assign probability one to a set consisting of a finite number of points), and which are such that is defined. In all that follows we consider only probability measures \\u03b5 which are in C.\",\n      \"doi\": \"10.4153/CJM-1960-030-4\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2117450242\",\n      \"paper_id\": \"https://openalex.org/W2117450242\",\n      \"citation_key\": \"Andersen1970\",\n      \"title\": \"Asymptotic Properties of Conditional Maximum-Likelihood Estimators\",\n      \"year\": 1970,\n      \"venue\": \"Journal of the Royal Statistical Society Series B (Statistical Methodology)\",\n      \"query\": \"Exact DOI: 10.1111/j.2517-6161.1970.tb00842.x\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1111/j.2517-6161.1970.tb00842.x\",\n      \"retrieved_at\": \"2026-11-13T18:27:35.978252+00:00\",\n      \"abstract\": \"Summary The problem of obtaining consistent estimates for structural parameters in the presence of infinitely many incidental parameters was discussed first by Neyman and Scott (1948). In this paper a maximum-likelihood method based on the conditional distribution given minimal sufficient statistics for the incidental parameters is suggested. It is proved that conditional maximum-likelihood estimates in the regular case are consistent and asymptotically normally distributed with a simple asymptotic variance. The efficiency problem of this new estimator is discussed in particular with respect to some situations with ancillary information.\",\n      \"doi\": \"10.1111/j.2517-6161.1970.tb00842.x\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2049633694\",\n      \"paper_id\": \"https://openalex.org/W2049633694\",\n      \"citation_key\": \"Dempster1977\",\n      \"title\": \"Maximum Likelihood from Incomplete Data Via the EM Algorithm\",\n      \"year\": 1977,\n      \"venue\": \"Journal of the Royal Statistical Society Series B (Statistical Methodology)\",\n      \"query\": \"Exact DOI: 10.1111/j.2517-6161.1977.tb01600.x\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1111/j.2517-6161.1977.tb01600.x\",\n      \"retrieved_at\": \"2026-11-13T18:27:35.863003+00:00\",\n      \"abstract\": \"Summary A broadly applicable algorithm for computing maximum likelihood estimates from incomplete data is presented at various levels of generality. Theory showing the monotone behaviour of the likelihood and convergence of the algorithm is derived. Many examples are sketched, including missing value situations, applications to grouped, censored or truncated data, finite mixture models, variance component estimation, hyperparameter estimation, iteratively reweighted least squares and factor analysis.\",\n      \"doi\": \"10.1111/j.2517-6161.1977.tb01600.x\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2787894218\",\n      \"paper_id\": \"https://openalex.org/W2787894218\",\n      \"citation_key\": \"Hastie2009\",\n      \"title\": \"The Elements of Statistical Learning\",\n      \"year\": 2009,\n      \"venue\": \"Springer series in statistics\",\n      \"query\": \"Exact DOI: 10.1007/978-0-387-84858-7\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1007/978-0-387-84858-7\",\n      \"retrieved_at\": \"2026-11-13T18:27:36.810810+00:00\",\n      \"abstract\": \"\",\n      \"doi\": \"10.1007/978-0-387-84858-7\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W4212863985\",\n      \"paper_id\": \"https://openalex.org/W4212863985\",\n      \"citation_key\": \"Bishop2006\",\n      \"title\": \"Pattern Recognition and Machine Learning\",\n      \"year\": 2006,\n      \"venue\": \"Springer eBooks\",\n      \"query\": \"Exact DOI: 10.1007/978-0-387-45528-0\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1007/978-0-387-45528-0\",\n      \"retrieved_at\": \"2026-11-13T18:27:36.655641+00:00\",\n      \"abstract\": \"\",\n      \"doi\": \"10.1007/978-0-387-45528-0\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2117897510\",\n      \"paper_id\": \"https://openalex.org/W2117897510\",\n      \"citation_key\": \"Efron1979\",\n      \"title\": \"Bootstrap Methods: Another Look at the Jackknife\",\n      \"year\": 1979,\n      \"venue\": \"The Annals of Statistics\",\n      \"query\": \"Exact DOI: 10.1214/aos/1176344552\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1214/aos/1176344552\",\n      \"retrieved_at\": \"2026-11-13T18:27:36.788924+00:00\",\n      \"abstract\": \"We discuss the following problem: given a random sample $\\\\mathbf{X} = (X_1, X_2, \\\\cdots, X_n)$ from an unknown probability distribution $F$, estimate the sampling distribution of some prespecified random variable $R(\\\\mathbf{X}, F)$, on the basis of the observed data $\\\\mathbf{x}$. (Standard jackknife theory gives an approximate mean and variance in the case $R(\\\\mathbf{X}, F) = \\\\theta(\\\\hat{F}) - \\\\theta(F), \\\\theta$ some parameter of interest.) A general method, called the \\\"bootstrap,\\\" is introduced, and shown to work satisfactorily on a variety of estimation problems. The jackknife is shown to be a linear approximation method for the bootstrap. The exposition proceeds by a series of examples: variance of the sample median, error rates in a linear discriminant analysis, ratio estimation, estimating regression parameters, etc.\",\n      \"doi\": \"10.1214/aos/1176344552\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2100358124\",\n      \"paper_id\": \"https://openalex.org/W2100358124\",\n      \"citation_key\": \"Rubin1976\",\n      \"title\": \"Inference and Missing Data\",\n      \"year\": 1976,\n      \"venue\": \"Biometrika\",\n      \"query\": \"Exact DOI: 10.1093/biomet/63.3.581\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1093/biomet/63.3.581\",\n      \"retrieved_at\": \"2026-11-13T18:27:36.859994+00:00\",\n      \"abstract\": \"When making sampling distribution inferences about the parameter of the data, \\u03b8, it is appropriate to ignore the process that causes missing data if the missing data are \\u2018missing at random\\u2019 and the observed data are \\u2018observed at random\\u2019, but these inferences are generally conditional on the observed pattern of missing data. When making direct-likelihood or Bayesian inferences about \\u03b8, it is appropriate to ignore the process that causes missing data if the missing data are missing at random and the parameter of the missing data process is \\u2018distinct\\u2019 from \\u03b8. These conditions are the weakest general conditions under which ignoring the process that causes missing data always leads to correct inferences.\",\n      \"doi\": \"10.1093/biomet/63.3.581\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2480680997\",\n      \"paper_id\": \"https://openalex.org/W2480680997\",\n      \"citation_key\": \"Little2019\",\n      \"title\": \"Statistical Analysis with Missing Data\",\n      \"year\": 2002,\n      \"venue\": \"Wiley series in probability and statistics\",\n      \"query\": \"Exact DOI: 10.1002/9781119013563\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1002/9781119013563\",\n      \"retrieved_at\": \"2026-11-13T18:27:37.651262+00:00\",\n      \"abstract\": \"Praise for the First Edition of Statistical Analysis with Missing Data \\\"An important contribution to the applied statistics literature.... I give the book high marks for unifying and making accessible much of the past and current work in this important area.\\\" \\u2014William E. Strawderman, Rutgers University \\\"This book...provide[s] interesting real-life examples, stimulating end-of-chapter exercises, and up-to-date references. It should be on every applied statistician\\u2019s bookshelf.\\\" \\u2014The Statistician \\\"The book should be studied in the statistical methods d\",\n      \"doi\": \"10.1002/9781119013563\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2560136348\",\n      \"paper_id\": \"https://openalex.org/W2560136348\",\n      \"citation_key\": \"Roberts2017\",\n      \"title\": \"Cross\\u2010validation strategies for data with temporal, spatial, hierarchical, or phylogenetic structure\",\n      \"year\": 2016,\n      \"venue\": \"Ecography\",\n      \"query\": \"Exact DOI: 10.1111/ecog.02881\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1111/ecog.02881\",\n      \"retrieved_at\": \"2026-11-13T18:27:37.770365+00:00\",\n      \"abstract\": \"Ecological data often show temporal, spatial, hierarchical (random effects), or phylogenetic structure. Modern statistical approaches are increasingly accounting for such dependencies. However, when performing cross\\u2010validation, these structures are regularly ignored, resulting in serious underestimation of predictive error. One cause for the poor performance of uncorrected (random) cross\\u2010validation, noted often by modellers, are dependence structures in the data that persist as dependence structures in model residuals, violating the assumption of independence. Even more concerning, because often overlooked, is that structured data also provides ample opportunity for overfitting with non\\u2010causal predictors. This problem can persist even if remedies such as autoregressive models, generalized least squares, or mixed models are used. Block cross\\u2010validation, where data are split strategically rather than randomly, can address these issues. However, the blocking strategy must be carefully considered. Blocking in space, time, random effects or phylogenetic distance, while accounting for dependencies in the data, may also unwittingly induce extrapolations by restricting the ranges or combinations of predictor variables available for model training, thus overestimating interpolation errors. On the other hand, deliberate blocking in predictor space may also improve error estimates when extrapolation is the modelling goal. Here, we review the ecological literature on non\\u2010random and blocked cross\\u2010validation approaches. We also provide a series of simulations and case studies, in which we show that, for all instances tested, block cross\\u2010validation is nearly universally more appropriate than random cross\\u2010validation if the goal is predicting to new data or predictor space, or for selecting causal predictors. We recommend that block cross\\u2010validation be used wherever dependence structures exist in a dataset, even if no correlation structure is visible in the fitted model residuals, or if the fitted models account for such correlations.\",\n      \"doi\": \"10.1111/ecog.02881\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2141007997\",\n      \"paper_id\": \"https://openalex.org/W2141007997\",\n      \"citation_key\": \"Varma2006\",\n      \"title\": \"Bias in error estimation when using cross-validation for model selection\",\n      \"year\": 2006,\n      \"venue\": \"BMC Bioinformatics\",\n      \"query\": \"Exact DOI: 10.1186/1471-2105-7-91\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1186/1471-2105-7-91\",\n      \"retrieved_at\": \"2026-11-13T18:27:37.931629+00:00\",\n      \"abstract\": \"BACKGROUND: Cross-validation (CV) is an effective method for estimating the prediction error of a classifier. Some recent articles have proposed methods for optimizing classifiers by choosing classifier parameter values that minimize the CV error estimate. We have evaluated the validity of using the CV error estimate of the optimized classifier as an estimate of the true error expected on independent data. RESULTS: We used CV to optimize the classification parameters for two kinds of classifiers; Shrunken Centroids and Support Vector Machines (SVM). Random training datasets were created, with no difference in the distribution of the features between the two classes. Using these \\\"null\\\" datasets, we selected classifier parameter values that minimized the CV error estimate. 10-fold CV was used for Shrunken Centroids while Leave-One-Out-CV (LOOCV) was used for the SVM. Independent test data was created to estimate the true error. With \\\"null\\\" and \\\"non null\\\" (with differential expression between the classes) data, we also tested a nested CV procedure, where an inner CV loop is used to perform the tuning of the parameters while an outer CV is used to compute an estimate of the error. The CV error estimate for the classifier with the optimal parameters was found to be a substantially biased estimate of the true error that the classifier would incur on independent data. Even though there is no real difference between the two classes for the \\\"null\\\" datasets, the CV error estimate for the Shrunken Centroid with the optimal parameters was less than 30% on 18.5% of simulated training data-sets. For SVM with optimal parameters the estimated error rate was less than 30% on 38% of \\\"null\\\" data-sets. Performance of the optimized classifiers on the independent test set was no better than chance. The nested CV procedure reduces the bias considerably and gives an estimate of the error that is very close to that obtained on the independent testing set for both Shrunken Centroids and SVM classifiers for \\\"null\\\" and \\\"non-null\\\" data distributions. CONCLUSION: We show that using CV to compute an error estimate for a classifier that has itself been tuned using CV gives a significantly biased estimate of the true error. Proper use of CV for estimating true error of a classifier developed using a well defined algorithm requires that all steps of the algorithm, including classifier parameter tuning, be repeated in each CV loop. A nested CV procedure provides an almost unbiased estimate of the true error.\",\n      \"doi\": \"10.1186/1471-2105-7-91\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W1981552604\",\n      \"paper_id\": \"https://openalex.org/W1981552604\",\n      \"citation_key\": \"Arlot2010\",\n      \"title\": \"A survey of cross-validation procedures for model selection\",\n      \"year\": 2010,\n      \"venue\": \"Statistics Surveys\",\n      \"query\": \"Exact DOI: 10.1214/09-SS054\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1214/09-SS054\",\n      \"retrieved_at\": \"2026-11-13T18:27:37.924887+00:00\",\n      \"abstract\": \"Used to estimate the risk of an estimator or to perform model selection, cross-validation is a widespread strategy because of its simplicity and its (apparent) universality. Many results exist on model selection performances of cross-validation procedures. This survey intends to relate these results to the most recent advances of model selection theory, with a particular emphasis on distinguishing empirical statements from rigorous theoretical results. As a conclusion, guidelines are provided for choosing the best cross-validation procedure according to the particular features of the problem in hand.\",\n      \"doi\": \"10.1214/09-SS054\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2112081648\",\n      \"paper_id\": \"https://openalex.org/W2112081648\",\n      \"citation_key\": \"Stone1974\",\n      \"title\": \"Cross-Validatory Choice and Assessment of Statistical Predictions\",\n      \"year\": 1974,\n      \"venue\": \"Journal of the Royal Statistical Society Series B (Statistical Methodology)\",\n      \"query\": \"Exact DOI: 10.1111/j.2517-6161.1974.tb00994.x\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1111/j.2517-6161.1974.tb00994.x\",\n      \"retrieved_at\": \"2026-11-13T18:27:38.712101+00:00\",\n      \"abstract\": \"Summary A generalized form of the cross-validation criterion is applied to the choice and assessment of prediction using the data-analytic concept of a prescription. The examples used to illustrate the application are drawn from the problem areas of univariate estimation, linear regression and analysis of variance.\",\n      \"doi\": \"10.1111/j.2517-6161.1974.tb00994.x\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W1985514943\",\n      \"paper_id\": \"https://openalex.org/W1985514943\",\n      \"citation_key\": \"Kendall1938\",\n      \"title\": \"A NEW MEASURE OF RANK CORRELATION\",\n      \"year\": 1938,\n      \"venue\": \"Biometrika\",\n      \"query\": \"Exact DOI: 10.1093/biomet/30.1-2.81\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1093/biomet/30.1-2.81\",\n      \"retrieved_at\": \"2026-11-13T18:27:38.760815+00:00\",\n      \"abstract\": \"\",\n      \"doi\": \"10.1093/biomet/30.1-2.81\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2078483536\",\n      \"paper_id\": \"https://openalex.org/W2078483536\",\n      \"citation_key\": \"Spearman1904\",\n      \"title\": \"The Proof and Measurement of Association between Two Things\",\n      \"year\": 1904,\n      \"venue\": \"The American Journal of Psychology\",\n      \"query\": \"Exact DOI: 10.2307/1412159\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.2307/1412159\",\n      \"retrieved_at\": \"2026-11-13T18:27:38.806169+00:00\",\n      \"abstract\": \"\",\n      \"doi\": \"10.2307/1412159\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2104094955\",\n      \"paper_id\": \"https://openalex.org/W2104094955\",\n      \"citation_key\": \"BenDavid2010\",\n      \"title\": \"A theory of learning from different domains\",\n      \"year\": 2009,\n      \"venue\": \"Machine Learning\",\n      \"query\": \"Exact DOI: 10.1007/s10994-009-5152-4\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1007/s10994-009-5152-4\",\n      \"retrieved_at\": \"2026-11-13T18:27:39.045593+00:00\",\n      \"abstract\": \"Discriminative learning methods for classification perform well when training and test data are drawn from the same distribution. Often, however, we have plentiful labeled training data from a source domain but wish to learn a classifier which performs well on a target domain with a different distribution and little or no labeled training data. In this work we investigate two questions. First, under what conditions can a classifier trained from source data be expected to perform well on target data? Second, given a small amount of labeled target data, how should we combine it during training with the large amount of labeled source data to achieve the lowest target error at test time? We address the first question by bounding a classifier\\u2019s target error in terms of its source error and the divergence between the two domains. We give a classifier-induced divergence measure that can be estimated from finite, unlabeled samples from the domains. Under the assumption that there exists some hypothesis that performs well in both domains, we show that this quantity together with the empirical source error characterize the target error of a source-trained classifier. We answer the second question by bounding the target error of a model which minimizes a convex combination of the empirical source and target errors. Previous theoretical work has considered minimizing just the source error, just the target error, or weighting instances from the two domains equally. We show how to choose the optimal combination of source and target error as a function of the divergence, the sample sizes of both domains, and the complexity of the hypothesis class. The resulting bound generalizes the previously studied cases and is always at least as tight as a bound which considers minimizing only the target error or an equal weighting of source and target errors.\",\n      \"doi\": \"10.1007/s10994-009-5152-4\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    },\n    {\n      \"id\": \"ref.openalex.W2073241381\",\n      \"paper_id\": \"https://openalex.org/W2073241381\",\n      \"citation_key\": \"Brier1950\",\n      \"title\": \"VERIFICATION OF FORECASTS EXPRESSED IN TERMS OF PROBABILITY\",\n      \"year\": 1950,\n      \"venue\": \"Monthly Weather Review\",\n      \"query\": \"Exact DOI: 10.1175/1520-0493(1950)078<0001:VOFEIT>2.0.CO;2\",\n      \"source_url\": \"https://api.openalex.org/works/https://doi.org/10.1175/1520-0493(1950)078<0001:VOFEIT>2.0.CO;2\",\n      \"retrieved_at\": \"2026-11-13T18:27:39.458734+00:00\",\n      \"abstract\": \"\",\n      \"doi\": \"10.1175/1520-0493(1950)078<0001:VOFEIT>2.0.CO;2\",\n      \"consulted_scope\": \"OpenAlex title, metadata and abstract where available; no citation links traversed\"\n    }\n  ],\n  \"retrieval_note\": \"Semantic Scholar exact-ID requests returned HTTP 429. OpenAlex exact-DOI fallback. Replaces unrelated supplied retrieval hits; no broad search or citation traversal.\"\n}---\nname: memory-log\ndescription: Maintain a continuous, append-only `./memory.md` log of discoveries, evaluations, failures, and next hypotheses during agent runs.\n---\n\n# What the skill is about\nKeep durable run memory so idea evolution and program evidence are never lost between steps.\n\n# When to use the skill\n- At run start to initialize memory.\n- After every meaningful step (`idea`, `edit`, `evaluate`, `verify`, `paper`, `draft`).\n- Immediately after every `evaluate-program -> verify-rubrics` pair.\n\n# What to do\n1. Initialize `./memory.md` if missing with these section headers:\n- `# Memory Log`\n- `## Context`\n- `## Idea Discoveries`\n- `## Program Evaluations`\n- `## Failures / Regressions`\n- `## Next Hypotheses`\n2. Also initialize global files if missing:\n- `./global_memory/memory.md`\n- `./global_memory/memory.jsonl`\n3. Never delete or rewrite prior entries; append only.\n4. For each appended entry, include:\n- timestamp\n- step type\n- change/discovery summary\n- concrete evidence\n- next action\n5. After every `evaluate-program -> verify-rubrics` pair, append a `Program Evaluations` entry that includes:\n- `program_<idx>`\n- `combined_score`\n- `correct`\n- rubric pass/fail summary\n- `next_recommendation`\n6. For regressions or failed rubrics, append one root-cause hypothesis under `Failures / Regressions`.\n7. Before exit, append final status (`rubric_pass`, `cap_reached`, or task-specific stop reason) and next hypothesis under `Next Hypotheses`.\n8. When command execution is unavailable, use read/edit/write tools to append directly\nto the required markdown and JSONL files. Preserve all existing content. When command\nexecution is available, prefer the helper for deterministic dual-write:\n- script: detect the active agent config directory first, then use `<that-dir>/skills/memory-log/scripts/append_memory.py`\n- command template:\n```bash\nMEMORY_HELPER=\"$(find ./.claude ./.codex ./.cursor ./.opencode ./.gemini ./.pi -path '*/skills/memory-log/scripts/append_memory.py' -print -quit 2>/dev/null)\"\npython \"${MEMORY_HELPER}\" \\\n  --global-memory-md \"./global_memory/memory.md\" \\\n  --global-memory-jsonl \"./global_memory/memory.jsonl\" \\\n  --event-json '{\"step\":\"evaluate\",\"scope\":\"attempt\",\"summary\":\"...\",\"evidence\":\"...\",\"next_action\":\"...\",\"attempt_id\":\"{{ATTEMPT_ID}}\",\"idea_id\":\"{{IDEA_ID}}\",\"program_id\":\"program_2\",\"metrics\":{\"combined_score\":2.54,\"correct\":true}}'\n```\n9. JSONL event schema (required keys):\n- `timestamp` (auto-filled if omitted)\n- `step` (`idea|edit|evaluate|verify|paper|draft|final|conclusions_skip`)\n- `scope` (`idea|attempt|paper|campaign`)\n- `summary`\n- `evidence`\n- `next_action`\n- optional: `idea_id`, `attempt_id`, `program_id`, `metrics`, `rubrics`, `tags`\n\n10. Update distilled conclusions (`conclusions.md`).\n**Purpose.** `conclusions.md` is a *forward-looking guide* for the next worker (or your future self in a later cycle). Its job is to help readers (a) focus their effort on directions you've found promising, and (b) avoid spending compute on directions you've already shown to be unpromising. Each sentence should either point at a lead worth pursuing or warn against a dead end, framed so a researcher who has not read your `memory.md` can still act on it. Avoid chronology, restate-of-results, and post-mortem narration — those belong in `memory.md`. Conclusions are the synthesis layer that makes other workers' next cycles more efficient.\n\n**When.** After every memory-append in the cycle (idea / edit / evaluate / verify / paper / final), evaluate whether `conclusions.md` should be updated.\n\n**Update gate (the only valid triggers).**\n- (a) cycle **contradicts** an existing sentence → rewrite that sentence.\n- (b) cycle opens a **new category** not yet covered → add a sentence.\n- (c) cycle **flips a Do/Don't** recommendation → flip it.\n- (d) cycle **meaningfully refines** an existing sentence — narrows the conditions under which a rule holds, broadens its applicability to a config it wasn't known to apply to, sharpens a tentative claim into a confident one, or adds a qualifier the prior phrasing didn't cover → edit the sentence to incorporate the refinement. Simple re-confirmation in the same regime is **not** sufficient; you must identify the refinement dimension (narrow / broaden / sharpen / qualify) in `--gate-reason`.\n- otherwise → **keep**, do not invoke the helper.\n\n**Format constraints.** Single paragraph. ≤300 words. No blank lines (`\\n\\n`). Avoid detailed numerical figures — use qualitative thresholds (e.g. \"low LR\", \"small batch\") instead of precise floats like `LR=0.205`.\n\n**Update mechanism.** When execution is unavailable, apply the same validation rules\nand update the conclusions files directly with read/edit/write tools. When execution\nis available, use this helper invocation:\n```bash\npython \"${MEMORY_HELPER}\" --write-conclusions \\\n  --conclusions-md \"{{CONCLUSIONS_MD_FILE}}\" \\\n  --conclusions-history-jsonl \"{{CONCLUSIONS_HISTORY_FILE}}\" \\\n  --cycle-index {{CYCLE_INDEX}} \\\n  --worker-index {{WORKER_INDEX}} \\\n  --gate-trigger <a|b|c|d> \\\n  --gate-reason \"<one sentence; for (d) name the dimension>\" \\\n  --conclusions-text \"<the full new paragraph>\"\n```\n\n**Pre-flight self-check.** Before invoking the helper, count words (`len(paragraph.split())`) and confirm ≤300, and that the paragraph contains no blank line. Most validation rejections can be avoided here.\n\n**Retry budget — exactly 3 attempts per cycle.** On non-zero exit, read the stderr error, shorten the paragraph (drop the least-decisive sentence, merge two related sentences, or remove qualifiers), and retry. After **3 total attempts** with no success, the update is **discarded** for this cycle: do not retry further, do not write the rejected text anywhere, and append a single memory event with `step=\"conclusions_skip\"` whose `summary` names the last validation error. Underlying findings are not lost — they are already durable in `memory.md`.\n\n**Always log the gate decision.** Inside the regular memory append for the cycle, include `gate=<updated|kept|skipped>; trigger=<a|b|c|d|none>; reason=<one sentence>` in the entry's `summary` or `tags`. Use `skipped` only after the 3-attempt budget is exhausted.\n\n# Example evaluation entry\n```markdown\n### 2026-02-13T16:58:00Z | step=evaluate\n- program: program_3\n- combined_score: 2.54\n- correct: true\n- rubrics: uses_restarts=pass, constraint_optimization=pass, score_threshold=fail\n- evidence: late-stage overlap still visible in stdout trace\n- next_recommendation: raise late-stage overlap penalty and diversify restart seeds\n```\n---\nname: write-paper-standalone\ndescription: Write a grounded LaTeX paper as one coherent standalone scientific study centered on a single defensible thesis rather than the run chronology.\n---\n\n# What the skill is about\nGenerate `paper.tex` and `claims_grounding.json` from grounded artifacts only, with a clean standalone-paper narrative.\n\n# When to use the skill\n- Final paper step when the default paper-writing skill keeps drifting into a search diary.\n- Need a standalone scientific paper built around one central method, hypothesis, or comparison story.\n- Need to hide run order and expose only the subset of baselines and ablations that support a coherent grounded manuscript.\n\n# What to do\n1. Read:\n- `results_readme.md` — campaign-level overview of all tasks, variants, and where to find results. Use this to understand the full scope of the campaign beyond the primary task passed via `--task-dir`.\n- `paper_data.json`\n- `references.bib`\n- `references_provenance.json`\n- `contributions.md` (if provided) — optional base for framing the claimed contributions; not a grounding source\n- `global_memory_summary.md` (if provided)\n- Aggregated CSVs in `/` for fine-grained analysis (install and use pandas) — when available\n- generated figures in `figures/`\n- when `paper_data.json.paper_profile == \"standalone\"`, also follow `presentation_contract` as a visible-language contract\n2. Use `templates/iclr/paper.tex` to keep section order stable. The paper format is **iclr**.\nInspect the selected template and any venue guidance before drafting so the author block, section structure, and framing expectations match the chosen format.\n3. Before drafting, choose one central thesis that is strongly supported by grounded evidence. Do not choose the paper story by recency alone.\n4. Group related implementations into a small number of named method families. Keep only the baseline, proposed method, and ablations needed to support the central thesis.\n5. If the artifacts do not support one coherent paper story, fail clearly instead of narrating the full search process.\n6. Write required sections:\n- abstract\n- introduction\n- related work\n- method\n- results\n- conclusion\n- references\nThe Supplementary Information section is mandatory.\nEmbed it in the same `paper.tex`, after the references, in this order: `\\clearpage`, bibliography, `\\clearpage`, `\\appendix`, and `\\section{Supplementary Information}`.\nReplace the template scaffold with substantive grounded content, including at least one meaningful subsection, table, or figure supported by the available artifacts. Suitable material includes extended methods, reproducibility details, additional ablations, robustness or failure analyses, and extra grounded tables or figures. Never move evidence essential to the central claim out of the main paper.\nRoute `appendix`-ranked posthoc analyses to Supplementary Information by default. Do not promote or drop them merely because of the main-body page budget.\n7. Generate comparative figures with Python + matplotlib by constructing analysis code yourself during the run:\n- inline `python - <<'PY' ... PY`, or\n- ad-hoc scripts in the paper workspace (for reproducibility).\n8. Prefer comparison figures over chronology figures. Use progression-style plots only when they directly support the main scientific claim.\n9. When multiple benchmarks, datasets, or settings are included, organize the visible paper around a shared hypothesis and condition-specific adaptations or limits, not around campaign chronology.\n10. If `paper_strategy.json` includes `figure_specs`, implement those figures first and keep every generated figure within the declared readability budgets.\n11. Use a logically consistent color scheme across all figures in the paper. Reuse the same colors for the same methods, baselines, conditions, or semantic roles whenever they recur, and avoid remapping meanings between figures without a clear reason.\n12. When a `figure_specs[*]` entry sets `preferred_generator` to `generate-concept-figure`, your job is to wire it in, not to render it. Do not invoke `autoillustrate` or the `generate-concept-figure` pipeline. Reference `./figures/<figure_id>.png` in the manuscript, create a lightweight placeholder PNG and `{}` prompt-log stub so the draft compiles, and register `generator: generate-concept-figure` plus `prompt_log_path: figures/<figure_id>.prompts.json` in `figure_manifest.json`. The orchestrator replaces those placeholders synchronously after the draft stage. Any reusable placeholder script must skip generation when `.concept_figure_complete` exists so repair rounds cannot overwrite the rendered asset.\n13. Do not satisfy a required overview-style `diagram` figure with a hand-built matplotlib/TikZ schematic unless the concept-figure workflow failed or was impossible; if that fallback happens, record the reason in `./memory.md`, `./global_memory/memory.md`, and the matching `figure_manifest.json` entry.\n14. Write `figure_manifest.json` for every figure referenced in `paper.tex`. Use `../validate-paper/templates/figure_manifest.schema.json` as the canonical contract. Legacy flat rows and richer nested rows are both acceptable if they validate against that schema.\n15. Record generator provenance in `figure_manifest.json` when possible: `generator`, `prompt_log_path`, and `fallback_reason` when a preferred generator was skipped.\nWhen evidence-audit feedback requires changing an orchestrator-owned concept figure, turn the correction into a complete documented fallback: export both `./figures/<figure_id>.png` and `./figures/<figure_id>.pdf`, set `generator` to the actual fallback generator (`matplotlib`, `tikz`, `native_latex`, or `manual`), set `attempted_generator: generate-concept-figure`, retain the original `prompt_log_path`, and set a non-empty `fallback_reason` describing why the orchestrator render was replaced. Use exactly those canonical artifact paths, and do not create or modify `./figures/<figure_id>.png.prov.json`; the orchestrator issues request-bound provenance after accepting the repair. Do not patch only the PNG while leaving `generator: generate-concept-figure`; that falsely claims ownership and allows figure preparation to restore the old render. Do not alter `paper_strategy.json` solely to bypass concept-figure orchestration, and do not create, delete, or modify `.concept_figure_complete`; the orchestrator owns that marker.\n16. Before choosing figure widths, inspect the selected paper template or style files to understand the practical column width, full-width span, and text footprint for the current paper format.\n17. Record final-layout hints in `figure_manifest.json` when possible: `placement`, `intended_latex_width_fraction`, and `estimated_min_rendered_font_pt`.\n18. Keep figures readable by default: max 4 total panels, max 3 panels per row, max 6 categories per panel, max 4 series per panel, readable fonts, and abbreviated labels instead of tiny text unless the strategy explicitly allows a denser layout.\n19. Choose each LaTeX figure width from the actual generated figure dimensions, aspect ratio, the inspected template geometry, and intended paper footprint. If a figure becomes unreadable at column width, regenerate/simplify it or place it full-width instead of shrinking the same dense figure further.\n20. If `validation_feedback.json` or `validation_feedback.md` is present, treat it as a repair pass: fix every listed hard error first, rerun validation, and keep iterating until the hard errors are gone or the grounded inputs are insufficient.\n21. Do not create visible section or subsection titles centered on `milestones`, `progression`, `timeline`, `phase`, `stage`, `round`, `Experiment A`, `Experiment B`, `first success`, or similar chronology-shaped labels unless the central claim is explicitly about dynamics.\n22. Do not use phrases like `first valid result`, `subsequent improvements`, `next-best`, `later variants`, or `we then tried` in the visible paper unless that wording is strictly necessary inside a brief protocol description.\n23. Keep visible paper text free of internal pipeline terms such as `eligible`, `correct and eligible`, `correctness rate`, `worker_01`, `worker_02`, `combined_score`, or `rubric`.\n24. If you need a thresholded rate, name it with one reader-facing meaning per figure, such as target attainment rate, successful-run fraction, or non-collapse rate. Do not reuse one label for different task-specific thresholds.\n25. When `paper_data.json.ablation_studies` is non-empty, prefer its variant summaries, replicate statistics, and explicit comparisons over inferring ablations from `all_programs` alone.\n26. Use only numbers present in `paper_data.json`.\n27. Use only citation keys present in `references.bib`.\n28. Use `global_memory_summary.md` only as private qualitative framing; do not use it for quantitative claims or `source_ids`.\n29. If `paper_strategy.md` and `paper_strategy.json` are present, treat them as the framing contract for the final draft; fail clearly if they contradict grounded evidence.\n30. Keep visible paper text free of run-diary wording such as discovery order, iteration order, or agent-loop narration.\n31. Write claim mapping JSON:\n```json\n{\n  \"claims\": [\n    {\n      \"claim\": \"text\",\n      \"source_ids\": [\"result.best_correct_score\"],\n      \"citation_keys\": [\"SomeKey2024\"]\n    }\n  ]\n}\n```\n32. Run validator:\n```bash\npython scripts/validate_claims.py \\\n  --paper-data paper_data.json \\\n  --references references_provenance.json \\\n  --bib references.bib \\\n  --claims claims_grounding.json \\\n  --paper-dir .\n```\nThis validator also checks that `references.bib` and `references_provenance.json` stay in sync, and traces every `@evidence[[...]]` link under `--paper-dir` against the `scientific-evidence/` bundle via the `scientific-evidence` skill verifier. Every link must classify as `resolved` or `anchored`; any `dangling` link is a hard error you must fix before finalization. If paper text carries `@evidence[[...]]` tokens but the bundle is missing, generate it first with `bash ../scientific-evidence/scripts/scientific_evidence.sh emit-bundle --root-dir .`.\n33. During repair passes, also rerun the full `validate-paper` workflow after each fix round so the next round starts from fresh feedback, not stale assumptions.\n34. When venue guidance is present, make the title, abstract, introduction, and conclusion explicitly reader-facing for that venue's scientific questions whenever the grounded evidence supports that framing.\n35. If `./paper_authors.tex` exists, treat it as the canonical author source. Keep `\\input{paper_authors.tex}` inside `\\author{...}` when possible; otherwise copy the exact file contents without edits.\n36. Keep the template's watermark block (`% --- watermark (auto-inserted) ---` … `% --- end watermark ---`) in `paper.tex` unchanged; the orchestrator regenerates it before every host compile.\n\n# Outputs\n- `paper.tex`\n- `claims_grounding.json`\n- `figure_manifest.json` when figures are generated or required by strategy\n- Optional extra figures in `figures/` (grounded only, no cross-agent aggregate plots).\n","exit_code":0,"status":"completed"}}
