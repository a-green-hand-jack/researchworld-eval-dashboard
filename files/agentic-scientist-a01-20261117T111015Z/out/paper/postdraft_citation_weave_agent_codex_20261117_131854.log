   \"exclude_references\",\n    }\n)\n\n\nclass VenueSpecError(ValueError):\n    \"\"\"A venue file is missing, malformed, or references missing assets.\"\"\"\n\n\n@dataclass(frozen=True)\nclass PageBudget:\n    \"\"\"Page budget enforced by ``validate_page_budget``.\"\"\"\n\n    max_body_pages: int\n    min_body_pages: int | None = None\n    min_last_body_page_fill_ratio: float | None = None\n    body_columns: int = 1\n    exclude_references: bool = False\n\n    def as_limits(self) -> dict[str, int | float | bool]:\n        \"\"\"Return the mapping shape ``validate_page_budget`` consumes.\"\"\"\n        limits: dict[str, int | float | bool] = {\n            \"max_body_pages\": self.max_body_pages,\n            \"body_columns\": self.body_columns,\n            \"exclude_references\": self.exclude_references,\n        }\n        if self.min_body_pages is not None:\n            limits[\"min_body_pages\"] = self.min_body_pages\n        if self.min_last_body_page_fill_ratio is not None:\n            limits[\"min_last_body_page_fill_ratio\"] = self.min_last_body_page_fill_ratio\n        return limits\n\n\n@dataclass(frozen=True)\nclass VenueSpec:\n    \"\"\"One paper venue as declared in ``configs/venue/<name>.yaml``.\"\"\"\n\n    name: str\n\"\"\"Mandatory manuscript watermark inserted before every host-side LaTeX compile.\n\nThe orchestrator owns this block. It is inserted (or regenerated in place) each time\n``validate_and_compile_paper`` runs, so every published ``paper.pdf`` carries the\nwatermark regardless of what the writing agent did to ``paper.tex``. There is\ndeliberately no configuration surface: text, fill, angle, and lightness are fixed.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport re\nimport stat\nimport tempfile\nfrom pathlib import Path\n\nWATERMARK_TEXT = \"Generated by The Agentic Scientist\"\nWATERMARK_BLOCK_START = \"% --- watermark (auto-inserted) ---\"\nWATERMARK_BLOCK_END = \"% --- end watermark ---\"\n\n# Fixed rendering parameters; see build_watermark_block for their meaning.\n_FILL = 0.8\n_LIGHTNESS = 0.85\n\n_MAX_TEX_BYTES = 8 * 1024 * 1024\n\nDOCCLASS_RE = re.compile(r\"\\\\documentclass\\s*(\\[[^\\]]*\\])?\\s*\\{[^}]*\\}\")\n_MANAGED_BLOCK_RE = re.compile(\n    r\"\\n?\" + re.escape(WATERMARK_BLOCK_START) + r\"\\n.*?\" + re.escape(WATERMARK_BLOCK_END) + r\"\\n\",\n    re.DOTALL,\n)\n\nclass PaperWatermarkError(ValueError):\n    \"\"\"Raised when the mandatory watermark cannot be applied to ``paper.tex``.\"\"\"\n\n\ndef strip_comment(line: str) -> str:\n    \"\"\"Return the part of a line before an unescaped ``%`` comment.\"\"\"\n    return re.sub(r\"(?<!\\\\)%.*$\", \"\", line)\n\n\ndef find_documentclass_end(src: str) -> int:\n    \"\"\"Index in ``src`` just after the (non-commented) ``\\\\documentclass`` command.\"\"\"\n    for match in DOCCLASS_RE.finditer(src):\n        line_start = src.rfind(\"\\n\", 0, match.start()) + 1\n        if \"\\\\documentclass\" in strip_comment(src[line_start : match.end()]):\n            return match.end()\n    raise PaperWatermarkError(\"No \\\\documentclass found; paper.tex must be a full LaTeX document\")\n\n\ndef escape_latex(text: str) -> str:\n    \"\"\"Escape characters that are special in LaTeX text mode.\"\"\"\n    specials = {\n        \"\\\\\": r\"\\textbackslash{}\",\n        \"&\": r\"\\&\",\n        \"%\": r\"\\%\",\n        \"$\": r\"\\$\",\n        \"#\": r\"\\#\",\n        \"_\": r\"\\_\",\n        \"{\": r\"\\{\",\n852:def read_pdf_page_layouts(pdf_path: Path) -> list[dict[str, Any]]:\n%%%% ICLR Macros (LaTex)\n%%%% Adapted by Hugo Larochelle from the NIPS stylefile Macros\n%%%% Style File\n%%%% Dec 12, 1990   Rev Aug 14, 1991; Sept, 1995; April, 1997; April, 1999; October 2014\n\n% This file can be used with Latex2e whether running in main mode, or\n% 2.09 compatibility mode.\n%\n","exit_code":0,"status":"completed"}}
