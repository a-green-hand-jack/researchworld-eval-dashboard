14,\n    1315,\n    1316,\n    1317,\n    1318,\n    1319,\n    1320,\n    1321,\n    1322,\n    1323,\n    1324,\n    1325,\n    1326,\n    1327,\n    1328,\n    1329,\n    1330,\n    1331,\n    1332,\n    1333,\n    1334,\n    1335,\n    1336,\n    1337,\n    1338,\n    1339,\n    1340,\n    1341,\n    1342,\n    1343,\n    1344,\n    1345,\n    1346,\n    1347,\n    1348,\n    1349,\n    1350,\n    1351,\n    1352,\n    1353,\n    1354,\n    1355,\n    1356,\n    1357,\n    1358,\n    1359,\n    1360,\n    1361,\n    1362,\n    1363,\n    1364,\n    1365,\n    1366,\n    1367,\n    1368,\n    1369,\n    1370,\n    1371,\n    1372,\n    1373,\n    1374,\n    1375,\n    1376,\n    1377,\n    1378,\n    1379,\n    1380,\n    1381,\n    1382,\n    1383,\n    1384,\n    1385,\n    1386,\n    1387,\n    1388,\n    1389,\n    1390,\n    1391,\n    1392,\n    1393,\n    1394,\n    1395,\n    1396,\n    1397,\n    1398,\n    1399\n  ],\n  \"raw_shapes\": {\n    \"synthetic\": [\n      8320,\n      2\n    ],\n    \"labeled\": 128,\n    \"unlabeled\": 8192,\n    \"smoke_labeled\": 32,\n    \"smoke_unlabeled\": 256\n  },\n  \"sampling\": \"Synthetic independent Uniform(0,1) X, frozen f(X)=X, Bernoulli conditionals. NumPy PCG64 SeedSequence([seed,case_index,17923]). Real independent with-replacement labeled/unlabeled draws from unique normalized source groups; empirical-source mean, not external truth.\",\n  \"source\": {\n    \"url\": \"https://drive.google.com/uc?export=download&id=17PwlvAAKeBYGLXPz9L2LVnNJ66XjuyZd\",\n    \"download_sha256\": \"72565d2d88ed6a16331b3423da5dee036e97f2220fad054eb139ced1942e3303\",\n    \"repository_revision\": \"6b8475b53f0303e4abc4d1eb0b94aa8052f9b940\",\n    \"original_source\": \"Vaishnav et al., Nature 603,455-463 (2022), as consulted in allowed upstream examples/gene_expression.ipynb\",\n    \"license\": \"Independent npz license not declared upstream; local benchmark use only. Resolve redistribution rights before publication.\",\n    \"raw_example_limitation\": \"Only available scalar outcome/prediction records can be normalized; underlying promoter strings unavailable. No claim of verified underlying sequence disjointness.\"\n  },\n  \"split\": \"Hash-sort normalized unique real records; first floor(unique/3) search, remainder final; duplicate groups never split. source_rows/group_offsets preserve original indices. Synthetic axes identify case, statistical seed, row; controls intentionally reuse nonlinear records.\",\n  \"disjointness\": {\n    \"checked_before_features\": true,\n    \"cross_plane_normalized_hash_intersection\": 0,\n    \"search_hash_index_sha256\": \"aca3f32b5923776138eb3f6f4152079ce3e672bf118463dd741149a7ded23d41\",\n    \"final_hash_index_sha256\": \"32e33339d0ad00851b9b569913399c15d849459efbba632c673b9a00eac86594\"\n  },\n  \"files\": {\n    \"gene_expression.npz\": \"d69ed1e0af709b6f42ec46a0c1f7e13cfb74cc4f05e10e84593bbf1e9a7101f4\",\n    \"linear.npz\": \"f8f8ffa5ded064ccb44d0bbcc2f8699e4f95a1a5b5d64f205d625c50faf97ae3\",\n    \"nonlinear.npz\": \"c86016a27d9025bfd4b90eaa7549a2a2e376a363800f3712c2d8059ae752efbf\",\n    \"rare_outcome.npz\": \"d47c9954254a1e2f3a0eea6d9a9cb64cf985e5a205a66315bbeb029098ed42cf\",\n    \"raw_hashes.npy\": \"32e33339d0ad00851b9b569913399c15d849459efbba632c673b9a00eac86594\",\n    \"uninformative.npz\": \"d1520de93f9a6adb20e6600b0a5189477fc98ff2372a6de58ecc329583eddfd3\"\n  },\n  \"controls\": {\n    \"copy\": \"identical infer endpoints within absolute 1e-12\",\n    \"reset\": \"one first-case first-seed replay after all primary episodes; endpoints within 1e-10\",\n    \"constant_nonlinear\": \"scores 0.5; require candidate label-only exact binomial interval within 1e-10\",\n    \"permuted_nonlinear\": \"separate deterministic permutations of labeled/unlabeled nonlinear scores; reject identity or numeric-equivalent transformations; report paired width uncertainty, no compulsory no-gain threshold\"\n  },\n  \"aggregation\": \"Seven cases in stated order, equal seeds within case then 1/7 per case. Copy/reset diagnostics have zero score weight but are mandatory. Missing: coverage=0,ratio=100,utility=0,failure=1; hard integrity failure combined_score=-9.5. Score percase=mean utility-10*max(0,0.95-coverage).\",\n  \"scientific_limits\": \"Scientific_validity fixed conservative 0: arbitrary candidate theoretical variance assumptions cannot be certified by RPC. Empirical validity diagnostics with simultaneous uncertainty do not prove nominal coverage. correct means operational/integrity/evidence/control completion, not narrowing or publication readiness; honest negative findings eligible. Paper/theory/novelty/rights reviewed separately.\",\n  \"uncertainty\": \"Clopper-Pearson case coverage CIs with Bonferroni 7 cases and 4 methods (joint 95%); paired seed bootstrap 512 resamples, RNG seed 79231, percentile simultaneous differences at 0.05/(7*3), only for complete paired widths, otherwise null with fixed failure contributions retained.\"\n}\n{\n  \"program.py\": {\n    \"original_path\": \"results/ideas/02_offset_invariant_risk_adaptive_control_variates/program_1/src/program.py\",\n    \"sha256\": \"677115b582955e7b5351e833466b4120d40a405edbc31968ace58be7410ca2bf\",\n    \"association\": \"result.top_program_01 identifies selected source location; final source-tree digest is not independently reconstructed.\"\n  },\n  \"METHOD.md\": {\n    \"original_path\": \"results/ideas/02_offset_invariant_risk_adaptive_control_variates/program_1/src/METHOD.md\",\n    \"sha256\": \"b82e7cc755be4961e0199a8bd55f401bd862edfdbe3d82baa92ddc278d664302\",\n    \"association\": \"result.top_program_01 identifies selected source location; final source-tree digest is not independently reconstructed.\"\n  },\n  \"test_controls.py\": {\n    \"original_path\": \"results/ideas/02_offset_invariant_risk_adaptive_control_variates/program_1/src/test_controls.py\",\n    \"sha256\": \"89cc8b808e9524ff54ebdc4d751b481b9ac2ed6b5211f53b3c92b8cadedd81