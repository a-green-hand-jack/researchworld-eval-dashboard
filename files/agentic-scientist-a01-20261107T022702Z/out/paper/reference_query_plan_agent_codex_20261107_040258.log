tions if o['rule']==rule and o['fraction']==fraction]\n   print(rule, fraction, 'statuses',dict(collections.Counter(o['allocation']['status'] for o in selected)), 'budgets',[len(o['allocation']['tasks']) if o['allocation']['status']=='feasible' else None for o in selected], 'reference_exact',sum(o['reference']['exact'] for o in selected))\nPY\"","aggregated_output":"FAMILY helm\nfractions [0.5, 1.0]\nrules ['borda', 'mean', 'median']\nmean 0.5 statuses {'feasible': 5, 'unattainable': 3} budgets [1, 23, 36, 40, 49, None, None, None] reference_exact 8\nmean 1.0 statuses {'feasible': 8} budgets [1, 9, 12, 13, 16, 21, 25, 46] reference_exact 8\nmedian 0.5 statuses {'feasible': 5, 'unattainable': 3} budgets [0, 12, 16, 18, 21, None, None, None] reference_exact 8\nmedian 1.0 statuses {'feasible': 8} budgets [0, 12, 16, 18, 21, 24, 29, 29] reference_exact 8\nborda 0.5 statuses {'feasible': 4, 'unattainable': 4} budgets [4, 39, 50, 52, None, None, None, None] reference_exact 8\nborda 1.0 statuses {'feasible': 8} budgets [4, 34, 41, 41, 46, 50, 51, 53] reference_exact 8\nFAMILY openllm\nfractions [0.5, 1.0]\nrules ['borda', 'mean', 'median']\nmean 0.5 statuses {'feasible': 7, 'unattainable': 1} budgets [1, 3, 4, 4, 5, 5, 6, None] reference_exact 8\nmean 1.0 statuses {'feasible': 8} budgets [1, 2, 2, 2, 2, 3, 3, 4] reference_exact 8\nmedian 0.5 statuses {'feasible': 6, 'unattainable': 2} budgets [1, 3, 3, 4, 4, 4, None, None] reference_exact 8\nmedian 1.0 statuses {'feasible': 8} budgets [1, 2, 3, 3, 3, 3, 3, 4] reference_exact 8\nborda 0.5 statuses {'feasible': 3, 'unattainable': 5} budgets [1, 5, 5, None, None, None, None, None] reference_exact 8\nborda 1.0 statuses {'feasible': 8} budgets [1, 5, 5, 6, 6, 6, 6, 6] reference_exact 8\n","exit_code":0,"status":"completed"}}
