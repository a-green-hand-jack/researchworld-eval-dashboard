count\n    23\t   (roughly 20-130). Timeout: 45 s.\n    24\t\n    25\t3. ``{\"op\": \"predict\", \"X\": [[float]*6]*N}`` -> ``{\"pred\": [float]*N}`` (exactly this one key):\n    26\t   one strictly positive finite predicted expected cover time per row, in request order.\n    27\t   Each episode issues exactly three predict calls after fit, on held-out graphs (rows may\n    28\t   be reordered or re-paired between calls); predictions should be a pure function of the\n    29\t   six statistics of each row. Timeout: 10 s per call.\n    30\t\n    31\tAny other response shape (wrong keys, wrong length, non-numeric or non-finite values, an\n    32\texception) fails the whole episode. Non-positive predictions are scored as worst case.\n    33\tScoring (evaluator-side): per-graph error min(|ln pred - ln C|, ln 1000), averaged per graph\n    34\tfamily with equal family weights; lower error is better. Requests never contain graph\n    35\tidentifiers, family labels, adjacency, held-out labels or scores.\n    36\t\"\"\"\n    37\t\n    38\timport math\n    39\t\n    40\timport numpy as np\n    41\t\n    42\t_STATE = {}\n    43\t\n    44\t\n    45\tdef _design(X):\n    46\t    X = np.asarray(X, dtype=float)\n    47\t    n, m, mean_deg, max_deg, min_deg, diam = (X[:, i] for i in range(6))\n    48\t    cols = [np.ones(len(X)), np.log(n), np.log(m), np.log(mean_deg), np.log(max_deg),\n    49\t            np.log(min_deg), np.log(diam), np.log(n) * np.log(diam)]\n    50\t    return np.column_stack(cols)\n    51\t\n    52\t\n    53\tdef _reset(request):\n    54\t    seed = request.get(\"seed\")\n    55\t    if type(seed) is not int or seed < 0:\n    56\t        raise ValueError(\"invalid seed\")\n    57\t    _STATE.clear()\n    58\t    _STATE[\"seed\"] = seed\n    59\t    return {\"ok\": True}\n    60\t\n    61\t\n    62\tdef _fit(request):\n    63\t    A = _design(request[\"X\"])\n    64\t    y = np.log(np.asarray(request[\"y\"], dtype=float))\n    65\t    mu = A[:, 1:].mean(axis=0)\n    66\t    sd = A[:, 1:].std(axis=0)\n    67\t    sd[sd < 1e-12] = 1.0\n    68\t    Z = np.column_stack([A[:, 0], (A[:, 1:] - mu) / sd])\n    69\t    ridge = 1e-3 * np.eye(Z.shape[1])\n    70\t    ridge[0, 0] = 0.0\n    71\t    beta = np.linalg.solve(Z.T @ Z + ridge, Z.T @ y)\n    72\t    _STATE.update(mu=mu, sd=sd, beta=beta, fallback=float(y.mean()))\n    73\t    return {\"ok\": True, \"method\": \"ridge_log_linear_v0\"}\n    74\t\n    75\t\n    76\tdef _predict(request):\n    77\t    if \"beta\" not in _STATE:\n    78\t        raise RuntimeError(\"predict before fit\")\n    79\t    A = _design(request[\"X\"])\n    80\t    Z = np.column_stack([A[:, 0], (A[:, 1:] - _STATE[\"mu\"]) / _STATE[\"sd\"]])\n    81\t    log_pred = np.clip(Z @ _STATE[\"beta\"], -50.0, 50.0)\n    82\t    log_pred = np.where(np.isfinite(log_pred), log_pred, _STATE[\"fallback\"])\n    83\t    return {\"pred\": [float(math.exp(v)) for v in log_pred]}\n    84\t\n    85\t\n    86\tdef handle(request):\n    87\t    op = request.get(\"op\") if isinstance(request, dict) else None\n    88\t    if op == \"reset\":\n    89\t        return _reset(request)\n    90\t    if op == \"fit\":\n    91\t        return _fit(request)\n    92\t    if op == \"predict\":\n    93\t        return _predict(request)\n    94\t    raise ValueError(\"unknown op\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
