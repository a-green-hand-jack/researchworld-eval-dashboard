{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"sed -n '1005,1078p' task/evaluate_final.py; sed -n '985,1004p' task/evaluate_final.py; sed -n '1,105p' results/ideas/03_rasch_residual_profile_mixtures_on_fixed_score_targeted_prefixes/program_1/src/program.py; sed -n '285,370p' results/ideas/03_rasch_residual_profile_mixtures_on_fixed_score_targeted_prefixes/program_1/src/program.py; python - <<'PY'\nimport json\np=json.load(open('paper_data.json')); print('episode-source', json.dumps(p['grounding_sources']['final.evidence.episodes'],indent=2)); m=json.load(open('task/resources/final/manifest.json')); print('case schema', type(m['cases']).__name__)\nif isinstance(m['cases'],dict):\n for k,v in m['cases'].items(): print(k,{kk:vv for kk,vv in v.items() if len(str(vv))<600})\nelse:\n for c in m['cases']: print(c if not isinstance(c,dict) else {k:v for k,v in c.items() if len(str(v))<600})\nprint('provenance type', type(json.load(open('references_provenance.json'))).__name__)\nprint('bib keys');\nimport re\nprint(re.findall(r'@\\\\w+\\\\{([\"'^,]+)'\"',open('references.bib').read()))\nPY\"","aggregated_output":"def aggregate(episodes, outcomes, investigation):\n    import numpy as np\n    cases = list(investigation.cases)\n    seeds = SEEDS[:1] if investigation.smoke else SEEDS\n    families = sorted({investigation.cases[name]['family'] for name in cases})\n    weights = {name: 1 / len(families) / sum(investigation.cases[other]['family'] == investigation.cases[name]['family'] for other in cases) for name in cases}\n    records = {(episode['case'], episode['seed'], episode['condition']): outcome for episode, outcome in zip(episodes[:-1], outcomes[:-1])}\n\n    def mean_condition(condition, metric):\n        return sum(weights[name] / len(seeds) * records[name, seed, condition][metric] for name in cases for seed in seeds)\n\n    metrics = {name: 1.0 for name in METRICS}\n    for metric in ('mae', 'rmse', 'spearman', 'kendall_tau_b'):\n        metrics[metric] = mean_condition('primary', metric)\n    metrics['combined_score'] = 1 - metrics['mae']\n    for condition in CONDITIONS[1:]:\n        metrics[condition + '_mae'] = mean_condition(condition, 'mae')\n    deltas = {}\n    paired = True\n    for method in ('uniform', 'source_mean', 'anchor', 'irt'):\n        value = 0.0\n        for name in cases:\n            for seed in seeds:\n                baseline = investigation.baselines.get((name, seed))\n                truth = investigation.pairs[name, seed][1].mean(axis=1)\n                error = 1.0 if baseline is None else float(np.abs(baseline[method] - truth).mean())\n                value += weights[name] / len(seeds) * error\n                if method == 'anchor':\n                    primary = records[name, seed, 'primary']\n                    if baseline is None or primary['predictions'] is None:\n                        paired = False\n                        deltas[name, seed] = None\n                    else:\n                        deltas[name, seed] = (np.abs(primary['predictions'] - truth) - np.abs(baseline[method] - truth)).mean(axis=0)\n        metrics[method + '_mae'] = value\n    metrics['delta_anchor_mae'] = float(sum(weights[name] / len(seeds) * (1.0 if deltas[name, seed] is None else deltas[name, seed].mean()) for name in cases for seed in seeds))\n    metrics['delta_anchor_ci_low'], metrics['delta_anchor_ci_high'] = -1.0, 1.0\n    if paired:\n        random = np.random.default_rng(1729)\n        lineages = sorted({group for pair in investigation.pairs.values() for group in pair[3]})\n        draws = []\n        for repeat in range(1000):\n            seed_indices = random.integers(0, len(seeds), len(seeds))\n            counts = np.bincount(random.integers(0, len(lineages), len(lineages)), minlength=len(lineages))\n            value = 0.0\n            supported = True\n            for name in cases:\n                for seed_index in seed_indices:\n                    seed = seeds[int(seed_index)]\n                    multipliers = np.asarray([counts[lineages.index(group)] for group in investigation.pairs[name, seed][3]])\n                    if multipliers.sum() == 0:\n                        supported = False\n                        break\n                    value += weights[name] / len(seeds) * float(np.average(deltas[name, seed], weights=multipliers))\n            if not supported:\n                draws = []\n                break\n            draws.append(value)\n        if draws:\n            metrics['delta_anchor_ci_low'], metrics['delta_anchor_ci_high'] = map(float, np.quantile(draws, [.025, .975]))\n    replay = outcomes[-1]\n    first = outcomes[0]\n    reset_error = 1.0\n    if replay['success'] and first['success'] and replay['anchors'] == first['anchors']:\n        reset_error = float(np.max(np.abs(replay['predictions'] - first['predictions'])))\n    metrics['reset_mae'] = replay['mae']\n    metrics['reset_max_abs_error'] = reset_error\n    metrics['control_failure_rate'] = (sum(mean_condition(condition, 'control_failure') for condition in ('constant', 'copy', 'permuted')) + float(reset_error > 1e-10)) / 4\n    metrics['missing_episode_rate'] = sum(not outcome['success'] for outcome in outcomes) / len(episodes)\n    correct = all(outcome['success'] and outcome['control_failure'] == 0 for outcome in outcomes) and reset_error <= 1e-10 and investigation.baseline_complete and all(investigation.baselines.get((name, seed)) is not None for name in cases for seed in seeds)\n    metrics['correct'] = int(correct)\n    if set(metrics) != set(METRICS) or not all(type(value) in (int, float) and math.isfinite(value) for value in metrics.values()):\n        raise ValueError('invalid aggregate metrics')\n    evidence = []\n            predictions = np.asarray(predictions)\n            outcome = {'mae': float(np.abs(predictions - truth).mean()), 'rmse': float(np.sqrt(np.mean((predictions - truth) ** 2, axis=1)).mean()), 'spearman': float(np.mean([correlation(spearmanr, truth, row) for row in predictions])), 'kendall_tau_b': float(np.mean([correlation(kendalltau, truth, row) for row in predictions])), 'control_failure': float(np.mean(structural_failures)), 'success': True, 'predictions': predictions, 'anchors': anchors, 'duration': time.monotonic() - started}\n            if condition == 'primary' and not episode.get('replay'):\n                self.originals[name, seed] = outcome\n            return outcome\n        except (TimeoutError, RequiredBaselineFailure, ProtocolError, InvalidResetResponse) as error:\n            primary_error = error\n            raise\n        finally:\n            if baseline is not None:\n                try:\n                    baseline.cancel()\n                except (RuntimeError, subprocess.TimeoutExpired) as cleanup_error:\n                    if primary_error is None:\n                        raise\n                    primary_error.add_note('secondary baseline cleanup failure')\n                if self.baselines[name, seed] is None:\n                    self.baseline_complete = False\n\n\n\"\"\"Score-targeted prefixes with group-balanced Rasch-residual mixtures.\n\nFinite JSON RPC, handle(request)->dict; extra response fields are forbidden.\nEvery episode: reset, source_chunk (1..2 calls), fit, observe (8,16,32), release.\nNo files, target IDs, benchmark identities, or private target scores are provided.\nSeeds initialize randomness only; arbitrary nonnegative integer seeds are valid.\n\nreset: {op:'reset',seed:int} -> {ok:true}. Clears all buffers and fitted state.\nsource_chunk: {op,encoding:'base64',dtype:'uint8',shape:[S,N],offset:int,\ntotal_bytes:S*N,chunk_count:int,data:str} -> {ok:true}. C-order contiguous bytes,\nin order, at most two chunks, each <=4194304 decoded bytes; S<=512,N<=16384.\nThe first chunk allocates candidate-owned RAM; no filesystem exchange exists.\nfit: {op,mode:'primary'|'no_diversity'|'no_calibration',budgets:[8,16,32],\nsource_groups:[int]*S} -> {anchors:[int]*32}. Requires complete source bytes.\nAnchors are distinct indices in [0,N), ordered nested prefixes for each budget.\nOpaque source groups permit source-only grouped CV; target data never calibrates.\nobserve: {op,budget:int,encoding:'base64',dtype:'uint8',shape:[T,budget],\ndata:str} -> {encoding:'base64',dtype:'<f8',shape:[T],data:str}.\nInput contains ONLY cumulative queried target correctness bits, C-order. Each\ncheckpoint supplies the complete legal prefix (not additional target queries).\nPrediction bytes are finite little-endian float64 probabilities in [0,1].\nTargets have no persistent identities: identical queried rows must receive equal\npredictions. Evaluator may supply matched constant/copied/permuted observations.\nNo response flag or internal-state claim contributes to scientific validity.\nrelease: {op:'release'} -> {ok:true}. Releases source and fit RAM. No other ops.\n\nThe editable directory may contain method/paper sources. Research conclusions,\nPDF/template compliance, genuine ablation interpretation and novelty require\nhuman-readable evidence beyond these operational prediction metrics. Search is\ndevelopment-only: no comparative baseline threshold is an eligibility gate.\n\"\"\"\n\nimport base64\nimport numpy as np\n\nSTATE = {}\n\n\ndef expit(values):\n    return 1.0 / (1.0 + np.exp(-values))\n\n\ndef logit(values):\n    return np.log(values) - np.log1p(-values)\n\n\ndef logsumexp(values, axis=None, keepdims=False):\n    maximum = np.max(values, axis=axis, keepdims=True)\n    result = maximum + np.log(np.exp(values - maximum).sum(axis=axis, keepdims=True))\n    if keepdims:\n        return result\n    return np.squeeze(result, axis=axis)\n\n\ndef group_weights(source_groups):\n    unique, group_inverse, group_counts = np.unique(source_groups, return_inverse=True, return_counts=True)\n    return 1.0 / (len(unique) * group_counts[group_inverse])\n\n\ndef select_anchors(source, source_groups, seed, count, uniform=False):\n    random = np.random.default_rng(seed)\n    if uniform:\n        query_order = random.permutation(source.shape[1])[:count]\n    else:\n        weights = group_weights(source_groups)\n        source_scores = source.astype(np.float64)\n        item_mean = weights @ source_scores\n        full_scores = source_scores.mean(axis=1)\n        centered = (source_scores - item_mean) * np.sqrt(weights[:, None])\n        score_centered = (full_scores - weights @ full_scores) * np.sqrt(weights)\n        score_covariance = centered.T @ score_centered\n        noise = 0.1 * np.maximum(item_mean * (1.0 - item_mean), 0.05)\n        conditional_variance = np.sum(centered * centered, axis=0) + noise\n        factors = np.zeros((source.shape[1], count), dtype=np.float64)\n        selected = np.zeros(source.shape[1], dtype=bool)\n        query_order = np.empty(count, dtype=np.int64)\n        for step in range(count):\n            gains = score_covariance ** 2 / np.maximum(conditional_variance, 1e-12)\n            gains[selected] = -np.inf\n            current = int(np.argmax(gains))\n            query_order[step] = current\n            pivot = np.sqrt(max(conditional_variance[current], 1e-12))\n            column = centered.T @ centered[:, current]\n            if step:\n                column -= factors[:, :step] @ factors[current, :step]\n            column[current] += noise[current]\n            column /= pivot\n            score_covariance -= column * (score_covariance[current] / pivot)\n            conditional_variance = np.maximum(conditional_variance - column ** 2, 1e-12)\n            factors[:, step] = column\n            selected[current] = True\n    assert np.unique(query_order).size == query_order.size\n    return query_order\n\n\ndef ridge_fit(features, target, strength):\n    center = features.mean(axis=0)\n    mean = float(target.mean())\n    centered = features - center\n    coefficient = np.linalg.solve(centered.T @ centered + strength * np.eye(features.shape[1]), centered.T @ (target - mean))\n    return center, mean, coefficient\n\n\ndef fit_rasch(source_scores, source_groups):\n    weights = group_weights(source_groups)\ndef handle(request):\n    operation = request['op']\n    if operation == 'reset':\n        if type(request['seed']) is not int or request['seed'] < 0:\n            raise ValueError('invalid seed')\n        STATE.clear()\n        STATE['seed'] = request['seed']\n        STATE['received'] = 0\n        return {'ok': True}\n    if operation == 'source_chunk':\n        shape = request['shape']\n        total = request['total_bytes']\n        if len(shape) != 2 or not (1 <= shape[0] <= 512 and 1 <= shape[1] <= 16384):\n            raise ValueError('invalid source shape')\n        if request['encoding'] != 'base64' or request['dtype'] != 'uint8':\n            raise ValueError('invalid source encoding')\n        if request['offset'] != STATE['received'] or total != int(np.prod(shape)) or total > 8388608:\n            raise ValueError('invalid source transfer')\n        if request['offset'] == 0:\n            STATE['buffer'] = bytearray(total)\n            STATE['shape'] = shape\n        elif shape != STATE['shape'] or total != len(STATE['buffer']):\n            raise ValueError('inconsistent source shape')\n        chunk = base64.b64decode(request['data'], validate=True)\n        offset = STATE['received']\n        if not chunk or len(chunk) > 4194304 or offset + len(chunk) > total:\n            raise ValueError('invalid chunk')\n        STATE['buffer'][offset:offset + len(chunk)] = chunk\n        STATE['received'] += len(chunk)\n        return {'ok': True}\n    if operation == 'fit':\n        source = np.frombuffer(STATE['buffer'], dtype=np.uint8).reshape(STATE['shape'])\n        if STATE['received'] != source.size or not np.isin(source, [0, 1]).all():\n            raise ValueError('incomplete or invalid source')\n        mode = request['mode']\n        if mode not in ('primary', 'no_diversity', 'no_calibration'):\n            raise ValueError('invalid mode')\n        budgets = tuple(request['budgets'])\n        if not budgets or any(type(budget) is not int or budget <= 0 or budget > source.shape[1] for budget in budgets) or tuple(sorted(set(budgets))) != budgets:\n            raise ValueError('invalid budgets')\n        source_groups = np.asarray(request['source_groups'])\n        if source_groups.shape != (len(source),) or not np.issubdtype(source_groups.dtype, np.integer):\n            raise ValueError('invalid source groups')\n        anchors, models, mixture_weight, particles = fit_models(source, source_groups, budgets, STATE['seed'], mode == 'no_diversity')\n        STATE['anchors'] = anchors\n        STATE['models'] = models\n        STATE['mixture_weight'] = mixture_weight\n        STATE['particles'] = particles\n        STATE['mode'] = mode\n        STATE['budgets'] = budgets\n        return {'anchors': anchors.tolist()}\n    if operation == 'observe':\n        budget = request['budget']\n        if budget not in STATE['budgets'] or request['encoding'] != 'base64' or request['dtype'] != 'uint8':\n            raise ValueError('invalid observation request')\n        shape = request['shape']\n        if len(shape) != 2 or shape[0] < 0 or shape[1] != budget:\n            raise ValueError('invalid observation shape')\n        observations = np.frombuffer(base64.b64decode(request['data'], validate=True), dtype=np.uint8).reshape(request['shape']).astype(float)\n        if not np.isin(observations, [0, 1]).all():\n            raise ValueError('invalid observations')\n        query_order = STATE['anchors']\n        assert np.unique(query_order).size == query_order.size\n        linear_query_order = query_order[:budget]\n        mixture_query_order = query_order[:budget]\n        assert np.array_equal(linear_query_order, mixture_query_order)\n        if STATE['mode'] == 'no_calibration':\n            predictions = observations.mean(axis=1)\n        else:\n            linear_prediction = linear_predict(STATE['models'][budget], observations)\n            mixture_weight = STATE['mixture_weight']\n            if mixture_weight == 0.0:\n                predictions = linear_prediction\n            else:\n                particle_probs, particle_log_prior, totals = STATE['particles']\n                particle_prediction = predict_particles(particle_probs, particle_log_prior, totals, mixture_query_order, observations)\n                blended_prediction = (1.0 - mixture_weight) * linear_prediction + mixture_weight * particle_prediction\n                predictions = blended_prediction\n        assert np.isfinite(predictions).all()\n        predictions = np.clip(predictions, 0, 1).astype('<f8')\n        return {'encoding': 'base64', 'dtype': '<f8', 'shape': [len(predictions)], 'data': base64.b64encode(predictions.tobytes()).decode('ascii')}\n    if operation == 'release':\n        STATE.clear()\n        return {'ok': True}\n    raise ValueError('unknown operation')\nepisode-source {\n  \"candidate_diagnostics_trust\": \"unverified\",\n  \"episode_count\": 3,\n  \"evaluation_scope\": \"sealed_final\",\n  \"id\": \"final.evidence.episodes\",\n  \"json_pointer\": \"/episodes\",\n  \"manifest_path\": \"work/results/t07/codex/20261113_154315/final_evaluation/final_manifest.json\",\n  \"path\": \"work/results/t07/codex/20261113_154315/final_evaluation/results/evaluation_evidence.json\",\n  \"program_tree_sha256\": \"sha256:77ebd04716aca9a891abe431721b2f9325d49b809838128cdabb1946058fedc2\",\n  \"results_tree_sha256\": \"sha256:5488369a549aefaf53ec49c14170d7ff7d6ac090aadc3d3025f336e89f10db4e\",\n  \"sha256\": \"sha256:e114d8fae2e02cd5693102944686b9d6dba9c5390ccefb0c66c8695ac394e4d7\",\n  \"type\": \"evaluation_evidence\"\n}\ncase schema dict\nbbh {'domain': 'openllm', 'shape': [446, 5761], 'matrix_sha256': '286590a0b670eac1d0c81b75821afef2ad778f3192457d083b49f7a266cff608', 'audit_sha256': 'ec0edb24cbcd60098d410b70ca38f2305a702f706