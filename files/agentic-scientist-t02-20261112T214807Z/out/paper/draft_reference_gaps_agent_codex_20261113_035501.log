{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json\nfor path in ['claims_grounding.json','paper_strategy.json','paper_data.json','references_provenance.json']:\n    with open(path) as stream: data=json.load(stream)\n    print('\\\\n'+path)\n    print('top-level:', list(data) if isinstance(data,dict) else type(data).__name__)\n    if path=='paper_strategy.json':\n        for key,value in data.items():\n            if any(term in key for term in ['thesis','reference','citation','literature','scope','claim']):\n                print(key, json.dumps(value,ensure_ascii=False))\n    if path=='claims_grounding.json':\n        claims=data.get('claims',[])\n        print('claim_count:',len(claims))\n        for claim in claims:\n            print(json.dumps(claim, ensure_ascii=False))\n    if path=='paper_data.json':\n        for key,value in data.items():\n            print(key, type(value).__name__, list(value)[:18] if isinstance(value,dict) else len(value) if isinstance(value,list) else str(value)[:200])\n    if path=='references_provenance.json':\n        for key,value in data.items():\n            if key not in ['references','queries']: print(key, json.dumps(value,ensure_ascii=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
