tion/ideas/01_cross_fitted_recalibrated_ppi_intervals/program_1\", \"program_id\": \"program_1\", \"type\": \"\nresult.improvement_001 {\"attempt_id\": \"cycle01_crppi_mean_ci_attempt_01\", \"id\": \"result.improvement_001\", \"idea_id\": \"cycle01_crppi_mean_ci\", \"program_dir\": \"work/results/t10/claude/20261111_094019/investigation/ideas/01_cross_fitted_recalibrated_ppi_intervals/program_1\", \"program_id\": \"program_1\", \"type\": \"met\nresult.top_program_01 {\"attempt_id\": \"cycle01_crppi_mean_ci_attempt_01\", \"id\": \"result.top_program_01\", \"idea_id\": \"cycle01_crppi_mean_ci\", \"program_dir\": \"work/results/t10/claude/20261111_094019/investigation/ideas/01_cross_fitted_recalibrated_ppi_intervals/program_1\", \"program_id\": \"program_1\", \"type\": \"metr\nresult.top_program_02 {\"attempt_id\": \"cycle03_stacked_calibration_ppi_attempt_01\", \"id\": \"result.top_program_02\", \"idea_id\": \"cycle03_stacked_calibration_ppi\", \"program_dir\": \"work/results/t10/claude/20261111_094019/investigation/ideas/03_repeated_cross_fitted_stacked_calibration_ppi_intervals/program_1\", \"pro\nresult.top_program_03 {\"attempt_id\": \"cycle02_label_free_basis_ppi_press_attempt_01\", \"id\": \"result.top_program_03\", \"idea_id\": \"cycle02_label_free_basis_ppi_press\", \"program_dir\": \"work/results/t10/claude/20261111_094019/investigation/ideas/02_label_free_basis_ppi_with_press_selection/program_1\", \"program_id\"\nresult.total_attempts {\"id\": \"result.total_attempts\", \"type\": \"count\", \"value\": 3}\nresult.total_correct_programs {\"id\": \"result.total_correct_programs\", \"type\": \"count\", \"value\": 3}\nresult.total_evaluated_programs {\"id\": \"result.total_evaluated_programs\", \"type\": \"count\", \"value\": 3}\nresult.total_ideas {\"id\": \"result.total_ideas\", \"type\": \"count\", \"value\": 3}\n{\"correct\": true, \"evaluation_evidence\": {\"candidate_diagnostics_trust\": \"unverified\", \"episode_count\": 5, \"episodes\": [{\"correct\": true, \"duration_seconds\": 266.8915313690377, \"score\": 0.024705316246250573, \"seed\": 9101}, {\"correct\": true, \"duration_seconds\": 266.3548038339941, \"score\": 0.021967059669624443, \"seed\": 9102}, {\"correct\": true, \"duration_seconds\": 267.2391358438763, \"score\": 0.02025146167172233, \"seed\": 9103}, {\"correct\": true, \"duration_seconds\": 266.2905360660079, \"score\": 0.021251543513267603, \"seed\": 9104}, {\"correct\": true, \"duration_seconds\": 265.4892824500421, \"score\": 0.023451491343454315, \"seed\": 9105}], \"path\": \"work/results/t10/claude/20261111_094019/final_evaluation/results/evaluation_evidence.json\", \"sha256\": \"sha256:c1e22df618ca879861086c6b241f8652974044c35bbba02d710f76339c5314bb\", \"status\": \"available\"}, \"evaluator_sha256\": \"sha256:7c9fd8c1b61b0545a1c457d86f3dab5a7ce7f7eaf3c5478be8b545d524e98205\", \"manifest_path\": \"work/results/t10/claude/20261111_094019/final_evaluation/final_manifest.json\", \"metrics\": {\"claim_status_code\": 2, \"combined_score\": 0.021991753274392033, \"controls_passed\": 1.0, \"coverage_min_family\": 0.91, \"coverage_pooled\": 0.934, \"log_ratio_vs_classical_mean\": 0.35808310279357997, \"log_ratio_vs_ppi_family_census_education\": 0.002334567173404467, \"log_ratio_vs_ppi_family_census_healthcare\": 0.0017633852937115081, \"log_ratio_vs_ppi_family_census_income\": 0.028708610323750924, \"log_ratio_vs_ppi_family_plankton\": 0.035886302679557024, \"log_ratio_vs_ppi_family_synthetic\": 0.04126590090153626, \"log_ratio_vs_ppi_lambda1_mean\": 0.07013300750758658, \"n_failed_episodes\": 0}, \"outcome\": \"qualified\", \"program_tree_sha256\": \"sha256:1bca6b10ac3c7c0a282c8d585c3a5be97f73152cbfad09e81dde1a10b91518c6\", \"results_tree_sha256\": \"sha256:42b108ebf383cc0006b96edc75985c1457472ddd19ad2fe066640f4e860354fb\", \"status\": \"completed\", \"task_tree_sha256\": \"sha256:2d77c3c5723ad18934f7d3ba539a5f47b21a327f3ef8b49c0544e919a34fe5a6\"}\nanalysis:\nheadroom.py\nheadroom_derived.json\nmake_f