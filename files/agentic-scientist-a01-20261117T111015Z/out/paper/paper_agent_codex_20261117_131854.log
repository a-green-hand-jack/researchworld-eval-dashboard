es', 'notes_for_writer', 'failure_reason'])\nFIGURES [\n  {\n    \"figure_id\": \"investment_overview\",\n    \"required\": true,\n    \"purpose\": \"Make the counterfactual investment object, fixed-rival assumption, aggregation conditions, and certificate outcomes legible before quantitative results.\",\n    \"figure_type\": \"diagram\",\n    \"preferred_generator\": \"generate-concept-figure\",\n    \"group_by\": \"score intervention and certificate scope\",\n    \"metric\": \"none; qualitative specification only\",\n    \"split_by\": \"fixed scores, bounded intervention, aggregation and support outcome\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"In the inspected single-column ICLR style, full width is 5.5 inches, not a two-column spread. Use a shallow approximately 5.5-by-1.8-inch diagram on page 1 or 2; a half-width 2.75-inch rendering would compress the update equation and outcome labels. Keep at most six visual groups and three aggregator branches, with at least 9-point rendered labels.\",\n    \"allow_progression\": false,\n    \"max_panels\": 1,\n    \"max_panels_per_row\": 1,\n    \"max_categories_per_panel\": 6,\n    \"max_series_per_panel\": 3,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_constraints\": \"Show x_j changing to x_j+alpha(1-x_j) only on the selected support and label rivals fixed. Three aggregators are conditions, not sequential improvements. Distinguish exact, infeasible, and bounded outcomes. Do not draw training, an architecture transition, a novel certificate mechanism, or numerical toy measurements.\"\n  },\n  {\n    \"figure_id\": \"exact_rule_contrast\",\n    \"required\": true,\n    \"purpose\": \"Display the exact within-snapshot mean\\u2013median ordering reversal without infeasibility penalties, composition changes across response conditions, or search chronology.\",\n    \"figure_type\": \"paired_difference_dotplot\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"final sampling seed\",\n    \"metric\": \"mean exact median-minus-mean support fraction on a fixed jointly attainable cohort\",\n    \"split_by\": \"alpha=0.5 versus alpha=1.0 on the ordinary Open LLM primary panel\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"Two side-by-side panels occupy approximately 5.5 by 2.1 inches in the 5.5-inch single text column. Each panel has three seed categories and one contrast series, so 9-point labels and a common signed y scale remain readable; include a horizontal zero line and cohort counts in the caption. Do not connect response conditions as a time trajectory.\",\n    \"allow_progression\": false,\n    \"max_panels\": 2,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 3,\n    \"max_series_per_panel\": 1,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_constraints\": \"Filter ordinary primary Open LLM decisions, join rule/alpha cells by seed and slot, and intersect attainability under both rules at both response conditions. Each seed retains the same cohort in both panels. Plot exact support-count differences divided by six; show individual seed summaries, not invented confidence intervals or a pooled population p-value.\"\n  },\n  {\n    \"figure_id\": \"attainability_and_support_scope\",\n    \"required\": true,\n    \"purpose\": \"Show which targets can attain first place and how much support is established, while exposing differences between exact and bounded evidence.\",\n    \"figure_type\": \"attainment_points_and_support_intervals\",\n    \"preferred_generator\": \"matplotlib\",\n    \"group_by\": \"aggregation rule\",\n    \"metric\": \"left: target attainment rate; right: normalized support lower and feasible upper bounds\",\n    \"split_by\": \"HELM 57-subject panel versus Open LLM six-task panel\",\n    \"preferred_span\": \"full_width\",\n    \"target_width_fraction\": 1.0,\n    \"layout_rationale\": \"A 2-by-2 figure at approximately 5.5 by 3.4 inches uses the full single-column width. Two panels per row, three ceiling categories at most, three rule series, shared scales, and a common legend avoid shrinking a dashboard. Use at least 9-point final labels and a short caption explicitly defining the support cohorts and interval semantics.\",\n    \"allow_progression\": false,\n    \"max_panels\": 4,\n    \"max_panels_per_row\": 2,\n    \"max_categories_per_panel\": 3,\n    \"max_series_per_panel\": 3,\n    \"source_ids\": [\n      \"final.evidence.episodes\"\n    ],\n    \"content_constraints\": \"Left panels include every ordinary primary target at all three recorded ceilings and use one attainment definition: a verified strict-first support with a supported claim. Right panels use only alpha=0.5 and 1.0, intersect attainable targets across all three rules within each seed and ceiling, and report the cohort sizes. Average the within-seed lower and upper support fractions with declared equal seed weights; the interval is an identification/certification range, not a confidence interval. Cohorts here may differ across ceilings, unlike Figure 2. Exact costs collapse to points. Never draw the infeasible sentinel m+1 as an actual cost. If a required joint cohort is empty, show not estimable rather than imputation.\"\n  }\n]\nPROV {'campaign_results_dir': 'work/results/a01/codex/20261117_111437/investigation', 'count': 25, 'generated_at': '2026-11-17T13:24:11.464046+00:00', 'queries': ['median trimmed mean finite-sample replacement breakdown order statistics', '\"Evaluating Agents using Social Choice Theory\" 2312.03121', '\"Leaderboard Incentives: Model Rankings under Strategic Post-Training\" 2603.08371', '\"The Benchmark Lottery\" 2107.07002', '\"Measuring Massive Multitask Language Understanding\" 2009.03300', '\"Holistic Evaluation of Language Models\" 2211.09110', '\"Challenging BIG-Bench Tasks and Whether Ch