{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/sh -lc \"sed -n '100,215p' scripts/build_artifacts.py; sed -n '1,180p' scripts/check_paper.py; printf '\\\\n--- SOURCE INVENTORY ---\\\\n'; rg --files --hidden -g '\"'!scientific-evidence/**'\"' -g '\"'!literature/**'\"' -g '\"'!source_evidence/**'\"' -g '\"'!paper_diagnostics/**'\"' | head -100; printf '\\\\n--- CONCEPT REFERENCES ---\\\\n'; rg -l --hidden 'frozen_score_overview|ImageDraw' scripts .codex figures memory.md; printf '\\\\n--- PREVIOUS CHECK REPORT ---\\\\n'; cat repair_validation_report.json; printf '\\\\n--- PAPER GEOMETRY ---\\\\n'; head -60 paper.tex\"","aggregated_output":"        for method, label in zip(METHODS[1:], LABELS[1:]):\n            value = row[\"differences\"][method]\n            differences.append(f'C{row[\"case\"]} & {label} & {value[\"mean\"]:+.6f} & [{value[\"lower95\"]:+.6f}, {value[\"upper95\"]:+.6f}]' + r\" \\\\\")\n        differences.append(r\"\\midrule\")\n    path = ROOT / \"tables\" / \"differences.tex\"\n    path.write_text(\"% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\\n\" + \"\\n\".join(differences) + \"\\n\\\\bottomrule\\n\")\n    provenance(path)\n    plt.rcParams.update({\"font.size\": 9, \"axes.titlesize\": 9, \"axes.labelsize\": 9,\n                         \"xtick.labelsize\": 8.5, \"ytick.labelsize\": 9,\n                         \"axes.spines.top\": False, \"axes.spines.right\": False,\n                         \"pdf.fonttype\": 42, \"ps.fonttype\": 42})\n    plotted = [0, 1, 3, 4]\n    figure, axes = plt.subplots(2, 2, figsize=(5.5, 4.3), gridspec_kw={\"width_ratios\": [1, 1.1]})\n    for group_index, indices in enumerate([range(4), range(4, 7)]):\n        coverage_axis, width_axis = axes[group_index]\n        offsets = np.linspace(-.23, .23, len(plotted))\n        for method_index, offset in zip(plotted, offsets):\n            for local_index, case_index in enumerate(indices):\n                value = results[case_index][\"methods\"][METHODS[method_index]]\n                coverage_axis.errorbar(value[\"coverage\"], local_index + offset,\n                    xerr=[[value[\"coverage\"] - value[\"coverage_lower95\"]], [value[\"coverage_upper95\"] - value[\"coverage\"]]],\n                    fmt=\"o\", ms=3.4, lw=.8, color=COLORS[method_index], capsize=1.5)\n        for method_index, offset in zip([1, 3, 4], [-.18, 0, .18]):\n            for local_index, case_index in enumerate(indices):\n                value = results[case_index][\"differences\"][METHODS[method_index]]\n                width_axis.errorbar(1000 * value[\"mean\"], local_index + offset,\n                    xerr=[[1000 * (value[\"mean\"] - value[\"lower95\"])], [1000 * (value[\"upper95\"] - value[\"mean\"])]],\n                    fmt=\"o\", ms=3.4, lw=.8, color=COLORS[method_index], capsize=1.5)\n        for axis in [coverage_axis, width_axis]:\n            axis.set_yticks(range(len(indices)), [f\"C{position + 1}\" for position in indices])\n            axis.set_ylim(len(indices)-.5, -.5)\n            axis.grid(axis=\"x\", alpha=.13)\n        coverage_axis.axvline(.95, ls=\"--\", lw=.8, color=\"#444444\")\n        coverage_axis.set_xlim((.84, 1.005) if group_index == 0 else (.48, 1.015))\n        width_axis.axvline(0, ls=\"--\", lw=.8, color=\"#444444\")\n    axes[0, 0].set_title(\"(a) Coverage: C1–C4\", loc=\"left\")\n    axes[0, 1].set_title(\"(b) Width differences: C1–C4\", loc=\"left\")\n    axes[1, 0].set_title(\"(c) Coverage: C5–C7\", loc=\"left\")\n    axes[1, 1].set_title(\"(d) Width differences: C5–C7\", loc=\"left\")\n    axes[1, 0].set_xlabel(\"Empirical coverage\")\n    axes[1, 1].set_xlabel(\"Width difference (×10⁻³)\")\n    handles = [plt.Line2D([], [], color=COLORS[index], marker=\"o\", ms=4, lw=1, label=LABELS[index]) for index in plotted]\n    figure.legend(handles=handles, loc=\"upper center\", ncol=2, frameon=False, fontsize=9, bbox_to_anchor=(.51, 1.005))\n    figure.subplots_adjust(left=.09, right=.98, bottom=.13, top=.79, wspace=.46, hspace=.62)\n    save_panel(figure, \"coverage_width_comparison\")\n    figure, axes = plt.subplots(1, 2, figsize=(5.5, 2.3), gridspec_kw={\"width_ratios\": [1.25, 1]})\n    rare = results[4]\n    for method_index in [0, 1, 2, 4]:\n        values = np.sort(rare[\"methods\"][METHODS[method_index]][\"widths\"])\n        axes[0].step(np.r_[0, values], np.r_[0, np.arange(1, len(values)+1)/len(values)], where=\"post\", color=COLORS[method_index], lw=1.25, label=LABELS[method_index])\n    axes[0].set(xlabel=\"Interval width\", ylabel=\"Empirical CDF\", ylim=(0, 1.03), xlim=(0, None))\n    axes[0].set_title(\"(a) C5 width distribution\", loc=\"left\")\n    selected = [0, 1, 2, 4]\n    counts = [rare[\"methods\"][METHODS[index]][\"zero_width_count\"] for index in selected]\n    axes[1].barh(range(4), counts, color=[COLORS[index] for index in selected], height=.6)\n    axes[1].set_yticks(range(4), [LABELS[index] for index in selected], fontsize=8.5)\n    axes[1].invert_yaxis()\n    axes[1].set_xlim(0, max(counts)*1.25)\n    axes[1].set_xlabel(\"Zero-width intervals\")\n    for position, count in enumerate(counts):\n        axes[1].text(count + 2, position, str(count), va=\"center\", fontsize=9)\n    axes[1].set_title(\"(b) Collapse counts\", loc=\"left\")\n    handles, labels = axes[0].get_legend_handles_labels()\n    figure.legend(handles, labels, loc=\"upper center\", ncol=4, frameon=False, fontsize=8.5, bbox_to_anchor=(.5, 1.015), handlelength=1.2, columnspacing=.9)\n    figure.subplots_adjust(left=.1, right=.99, bottom=.24, top=.73, wspace=.67)\n    save_panel(figure, \"rare_outcome_diagnostic\")\n    concept = ROOT / \"figures\" / \"frozen_score_overview.png\"\n    prompt_log = concept.with_suffix(\".prompts.json\")\n    if not (ROOT / \".concept_figure_complete\").exists() and not concept.exists():\n        from PIL import Image, ImageDraw\n        image = Image.new(\"RGB\", (2400, 630), \"white\")\n        draw = ImageDraw.Draw(image)\n        draw.text((50, 280), \"Concept figure reserved for synchronous rendering\", fill=\"#666666\")\n        image.save(concept)\n    if not prompt_log.exists():\n        prompt_log.write_text(\"{}\\n\")\n    figures = []\n    specifications = {item[\"figure_id\"]: item for item in\n                      json.loads((ROOT / \"paper_strategy.json\").read_text())[\"figure_specs\"]}\n    for name, panels, categories, series, height in [\n        (\"frozen_score_overview\", 1, 4, 2, 1.8),\n        (\"coverage_width_comparison\", 4, 4, 4, 4.3),\n        (\"rare_outcome_diagnostic\", 2, 4, 4, 2.3)]:\n        entry = {\"figure_id\": name, \"path_png\": f\"figures/{name}.png\",\n                 \"figure_type\": specifications[name][\"figure_type\"],\n                 \"n_panels\": panels, \"panels_per_row\": 1 if panels == 1 else 2,\n                 \"categories_per_panel\": [categories] * panels, \"series_per_panel\": [series] * panels,\n                 \"max_label_chars\": 30, \"font_sizes\": {\"title\": 9, \"axis\": 9, \"legend\": 8.5, \"ticks\": 8.5},\n                 \"uses_abbrev_labels\": True, \"uses_progression\": False,\n                 \"source_ids\": [] if panels == 1 else [\"final.evidence.episodes\"],\n                 \"generator\": \"generate-concept-figure\" if panels == 1 else \"matplotlib\",\n                 \"placement\": \"full_width\", \"intended_latex_width_fraction\": 1.0,\n                 \"estimated_min_rendered_font_pt\": 8.5}\n        if panels == 1:\n            entry[\"prompt_log_path\"] = f\"figures/{name}.prompts.json\"\n        else:\n            entry[\"path_pdf\"] = f\"figures/{name}.pdf\"\n        figures.append(entry)\n    (ROOT / \"figure_manifest.json\").write_text(json.dumps({\"figures\": figures}, indent=2) + \"\\n\")\n    for row in results:\n        print(\"C\", row[\"case\"], \"truth\", row[\"truths\"], \"coverage\", row[\"methods\"][\"candidate\"][\"coverage\"], \"width\", row[\"methods\"][\"candidate\"][\"width\"][\"mean\"], \"PPI++ difference\", row[\"differences\"][METHODS[1]])\n\n\nif __name__ == \"__main__\":\n    main()\nimport importlib.util\nimport json\nimport re\nfrom pathlib import Path\n\nimport jsonschema\nimport pymupdf\n\nROOT = Path(__file__).resolve().parent.parent\n\n\ndef main():\n    data = json.loads((ROOT / \"paper_data.json\").read_text())\n    strategy = json.loads((ROOT / \"paper_strategy.json\").read_text())\n    manifest = json.loads((ROOT / \"figure_manifest.json\").read_text())\n    schema = json.loads((ROOT / \".codex/skills/validate-paper/templates/figure_manifest.schema.json\").read_text())\n    jsonschema.validate(manifest, schema)\n    specifications = {item[\"figure_id\"]: item for item in strategy[\"figure_specs\"]}\n    manuscript = (ROOT / \"paper.tex\").read_text()\n    declared_paths = set()\n    for figure in manifest[\"figures\"]:\n        spec = specifications[figure[\"figure_id\"]]\n        assert figure[\"figure_type\"] == spec[\"figure_type\"], figure[\"figure_id\"]\n        assert figure[\"n_panels\"] <= spec[\"max_panels\"]\n        assert max(figure[\"categories_per_panel\"]) <= spec[\"max_categories_per_panel\"]\n        assert max(figure[\"series_per_panel\"]) <= spec[\"max_series_per_panel\"]\n        assert figure[\"panels_per_row\"] <= spec[\"max_panels_per_row\"]\n        assert figure[\"estimated_min_rendered_font_pt\"] >= 8\n        assert set(figure[\"source_ids\"]) <= set(data[\"grounding_sources\"])\n        for field in [\"path_png\", \"path_pdf\", \"prompt_log_path\"]:\n            if field in figure:\n                assert (ROOT / figure[field]).is_file()\n                declared_paths.add(figure[field])\n    for included in re.findall(r\"\\\\includegraphics(?:\\[[^\\]]*\\])?\\{([^}]+)\\}\", manuscript):\n        assert included in declared_paths, included\n    assert set(specifications) == {item[\"figure_id\"] for item in manifest[\"figures\"]}\n    resolved_json = 0\n    resolved_lines = 0\n    for token in re.findall(r\"@evidence\\[\\[([^\\]]+)\\]\\]\", manuscript):\n        target, separator, locator = token.partition(\"#\")\n        path = ROOT / target\n        assert path.is_file(), token\n        if path.suffix == \".json\" and locator.startswith(\"/\"):\n            value = json.loads(path.read_text())\n            for part in locator[1:].split(\"/\"):\n                part = part.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\n                value = value[int(part)] if isinstance(value, list) else value[part]\n            resolved_json += 1\n        if re.fullmatch(r\"L\\d+(?:-L?\\d+)?\", locator):\n            numbers = [int(value) for value in re.findall(r\"\\d+\", locator)]\n            assert max(numbers) <= len(path.read_text().splitlines()), token\n            resolved_lines += 1\n    pdf = pymupdf.open(ROOT / \"paper.pdf\")\n    texts = [page.get_text() for page in pdf]\n    reference_index = next(index for index, text in enumerate(texts) if re.search(r\"\\bREFERENCES\\b\", text))\n    supplement_index = next(index for index, text in enumerate(texts) if \"SUPPLEMENTARY INFORMATION\" in text)\n    assert reference_index in [8, 9], reference_index\n    assert supplement_index > reference_index\n    assert \"LLM USAGE\" in \"\\n\".join(texts)\n    forbidden = r\"\\b(?:ideas?|programs?|attempts?|eligible|worker_01|worker_02|combined_score|rubric)\\b\"\n    for page_text in texts:\n        scrubbed = re.sub(r\"program\\.py\", \"source-file\", page_text)\n        assert not re.search(forbidden, scrubbed, re.I), re.search(forbidden, scrubbed, re.I)\n    body_last = pdf[reference_index - 1]\n    rectangles = []\n    for block in body_last.get_text(\"dict\")[\"blocks\"]:\n        for line in block.get(\"lines\", []):\n            spans = [span for span in line[\"spans\"] if span[\"bbox\"][0] >= 106 and span[\"bbox\"][2] <= 506\n                     and 70 <= span[\"bbox\"][1] < 730 and not span[\"text\"].isdigit()]\n            rectangles.extend(span[\"bbox\"] for span in spans)\n    extent = max(rectangle[3] for rectangle in rectangles) - min(rectangle[1] for rectangle in rectangles)\n    fill = extent / 648\n    assert fill >= .75 if reference_index == 8 else True\n    specification = importlib.util.spec_from_file_location(\"rendered_si\", ROOT / \".codex/skills/validate-paper/scripts/validate_rendered_si.py\")\n    validator = importlib.util.module_from_spec(specification)\n    specification.loader.exec_module(validator)\n    body_texts = [page.get_text(clip=pymupdf.Rect(105, 65, 507, 750), sort=True) for page in pdf]\n    errors = validator.validate_rendered_supplementary_information(body_texts)\n    assert not errors, errors\n    summary = json.loads((ROOT / \"scientific-evidence/verification-report.json\").read_text())[\"summary\"]\n    assert summary[\"dangling_references\"] == 0\n    report = {\"status\": \"local_checks_passed\", \"body_pages\": reference_index, \"total_pages\": len(pdf),\n              \"last_body_page_vertical_extent_fraction\": fill,\n              \"geometry_note\": \"Local text-span extent, excluding margin counters; not the parent orchestrator's authoritative occupancy metric.\",\n              \"figure_schema\": \"passed\", \"strategy_figure_budgets\": \"passed\", \"figures\": len(manifest[\"figures\"]),\n              \"resolved_manuscript_json_pointers\": resolved_json, \"resolved_source_line_locators\": resolved_lines,\n              \"rendered_supplement\": \"passed canonical heading/content function on PyMuPDF text within the official text frame\",\n              \"dangling_evidence_references\": 0,\n              \"canonical_tooling_limits\": [\n                  \"Standalone figure-validator entrypoint cannot import the absent parent src.orchestrator module; canonical JSON schema and strategy budgets checked locally.\",\n                  \"compile_latex.sh recorder checker rejects a system texmf.cnf symlink crossing two approved TeX roots. Sanitized pdflatex/BibTeX commands compile successfully; parent revalidation remains authoritative.\",\n                  \"System pdftotext is unavailable. Rendered SI checked from independent PyMuPDF extraction within the official text frame, excluding margin counters.\",\n                  \"Concept image is an orchestrator-owned placeholder until synchronous post-draft rendering.\"\n              ]}\n    (ROOT / \"local_validation_report.json\").write_text(json.dumps(report, indent=2) + \"\\n\")\n    print(json.dumps(report, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n\n--- SOURCE INVENTORY ---\npaper_evidence_audit_agent_codex_20261107_044409_round_2.log\npaper.sty\n.postdraft_reference_enrichment_complete\nreference_query_plan_validation_feedback.md\nreference_query_plan_validation_feedback.json\nVENUE.md\npaper_strategy_agent_codex_20261107_044409.log\npaper_agent_codex_20261107_044409.log\nconcept_figure_run.log\nscripts/consult_references.py\nscripts/check_paper.py\nscripts/capture_environment.py\nscripts/map_claims.py\nscripts/build_artifacts.py\nscripts/__pycache__/check_paper.cpython-312.pyc\nscripts/__pycache__/consult_references.cpython-312.pyc\nscripts/__pycache__/build_artifacts.cpython-312.pyc\nscripts/finalize_references.py\nfigure_manifest.json\ndraft_reference_gaps.md\ncompilation.log\npaper_strategy.json\nglobal_memory_recent.json\nanalysis_results.json\nreproduction_environment.json.prov.json\ndraft_reference_gaps_validation_feedback.json\nstrategy_validation_feedback.json\npaper_evidence_audit_feedback.md\nstrategy_validation_feedback.md\nvalidation_report.json\nreference_query_plan_prompt.md\npaper.fls\nglobal_memory_summary.md\nfigures/frozen_score_overview.prompts.json\npaper.tex\npaper_strategy_resolution.json\nreference_query_plan_agent_codex_20261107_044409.log\npaper_strategy_prompt.md\npaper.blg\npaper.aux\nvalidation_feedback.md\npaper.bbl\nreferences_provenance.json\nbibtex.log\nfigures/frozen_score_overview.png\nfigures/rare_outcome_diagnostic.pdf.prov.json\nfigures/rare_outcome_diagnostic.png\nfigures/coverage_width_comparison.pdf\nfigures/rare_outcome_diagnostic.pdf\nfigures/coverage_width_comparison.pdf.prov.json\nfigures/rare_outcome_diagnostic.png.prov.json\nfigures/coverage_width_comparison.png\nfigures/coverage_width_comparison.png.prov.json\npaper_prep_20261107_044409.json\nmemory.md\npaper_evidence_audit_input_sha256.json\npaper_figure_quality_repair_agent_codex_20261107_044409.log\npaper.pdf\nreferences.bib\npaper.bst\ndraft_reference_gaps_agent_codex_20261107_044409.log\nreference_retrieval.log\nanalysis_results.json.prov.json\ndraft_reference_gaps.json\npaper_evidence_audit_prompt_round_2.md\npaper_repair_prompt_round_1.md\npaper_evidence_audit.json\nreference_query_plan.json\n.agentic_paper_workspace.json\npaper_repair_agent_codex_20261107_044409_round_1.log\nlocal_validation_report.json\niclr2026_conference.sty\npaper_diagnostics_20261107_044409_197126.log\npaper_evidence_audit_agent_codex_20261107_044409.log\n.codex/skills/scientific-evidence/scripts/scientific_evidence.sh\nreference_query_plan.md\ndraft_reference_gaps_prompt.md\n.codex/skills/scientific-evidence/scripts/scientific_evidence.py\n.paper_two_stage_enabled\npaper_evidence_audit.md\n.codex/skills/scientific-evidence/SKILL.md\niclr2026_conference.bst\npaper_evidence_audit_feedback.json\nREPRODUCIBILITY.md\npaper_evidence_audit_packet.md\n.codex/skills/memory-log/scripts/append_memory.py\n.codex/skills/memory-log/SKILL.md\npaper_figure_quality_repair_prompt.md\npaper_prompt.md\npaper_evidence_audit_raw.txt\npaper.log\nvalidation_feedback.json\npaper_data.json\npaper_evidence_audit_prompt.md\n.codex/skills/generate-concept-figure/SKILL.md\n.codex/skills/validate-paper/scripts/validate_compile_inputs.py\n.codex/skills/validate-paper/scripts/compile_latex.sh\ntables/coverage.tex.prov.json\npaper_events_20261107_044409.jsonl\n.codex/skills/validate-paper/scripts/validate_figures.py\n\n--- CONCEPT REFERENCES ---\nscripts/build_artifacts.py\n\n--- PREVIOUS CHECK REPORT ---\n{\n  \"status\": \"targeted_repairs_locally_validated\",\n  \"repair\": \"Normalize both quantitative strategy figure types to the canonical composite enum; preserve all designs, evidence, and manuscript claims.\",\n  \"figure_manifest_schema\": \"passed\",\n  \"strategy_manifest_type_agreement\": \"passed\",\n  \"strategy_density_budgets\": \"passed\",\n  \"sections_and_citations\": \"passed\",\n  \"claim_mapping\": \"passed\",\n  \"evidence_verification\": \"passed_zero_dangling_references\",\n  \"sanitized_latex_bibtex_compilation\": \"passed\",\n  \"rendered_supplement_local_check\": \"passed\",\n  \"protected_content_hashes\": \"unchanged: manuscript, claims, paper_data, bibliography, reference provenance, derived numerical results\",\n  \"regression_prevention\": \"Builder takes types from the strategy; checker requires exact strategy/manifest type equality in addition to schema validation.\",\n  \"remaining_soft_feedback\": \"Original figure readability warnings are unchanged; no plotted or concept image was overwritten.\",\n  \"authoritative_parent_revalidation\": \"required\",\n  \"canonical_tooling_limits\": [\n    \"Figure CLI cannot import absent src.orchestrator; canonical schema and strategy equality were checked locally.\",\n    \"Full compile wrapper cannot run without pdftotext; sanitized LaTeX/BibTeX passes and independent rendered-PDF checks succeeded.\",\n    \"Local text-span extent is not the parent geometric page-occupancy metric.\"\n  ]\n}\n\n--- PAPER GEOMETRY ---\n\\documentclass{article}\n% --- watermark (auto-inserted) ---\n\\usepackage{xcolor}\n\\usepackage{xfp}% \\fpeval; in the kernel since 2022, harmless on older LaTeX\n\\usepackage{draftwatermark}\n\\newlength{\\watermarkTextWidth}\n\\AddToHook{begindocument/end}{%\n  \\SetWatermarkText{\\normalfont Generated by The Agentic Scientist}%\n  \\SetWatermarkFontSize{10pt}%\n  \\SetWatermarkLightness{0.85}%\n  \\settowidth{\\watermarkTextWidth}{\\normalfont\\fontsize{10pt}{12pt}\\selectfont Generated by The Agentic Scientist}%\n  \\edef\\watermarkScale{\\fpeval{0.8 * sqrt(\\paperwidth**2 + \\paperheight**2) / \\watermarkTextWidth}}%\n  \\edef\\watermarkAngle{\\fpeval{atand(\\paperheight/\\paperwidth)}}%\n  \\SetWatermarkScale{\\watermarkScale}%\n  \\SetWatermarkAngle{\\watermarkAngle}%\n}\n% --- end watermark ---\n\\usepackage{iclr2026_conference,times}\n\\usepackage{amsmath,amssymb,booktabs,graphicx,subcaption,longtable}\n\\usepackage{hyperref,url}\n\\newcommand{\\E}{\\mathbb{E}}\n\\newcommand{\\Var}{\\operatorname{Var}}\n\\newcommand{\\clip}{\\operatorname{clip}}\n\\title{Frozen-Score Controls for Mean Inference:\\\\Width Gains and Coverage Limitations}\n\\author{}\n\n\\begin{document}\n\\maketitle\n\n\\begin{abstract}\nCan confidence intervals become narrower when labels, unlabeled observations, and the predictor are unchanged? We examine inference-side calibration of frozen scores for a binary population mean, using paired interval records from seven evaluation conditions and 256 repetitions per condition. The associated implementation fits honest, regularized score controls and returns a stabilized asymptotic interval; its bounded finite-sample construction is separate and unmeasured. Relative to the evaluated PPI++ comparator, mean width decreases in only one condition, by 0.000302, and increases in the other six. In the condition with population mean 0.0068, PPI++ coverage is 0.551 and 115 intervals collapse, whereas score-control coverage is 0.930 without collapse. However, the score-control width difference from exact-binomial inference is inconclusive, and pooled empirical coverage of 0.943 does not establish nominal validity. These results support condition-specific comparisons, not uniformly shorter valid intervals. Missing condition generators, sample-size metadata, and a matched calibration ablation limit reproducibility and mechanistic attribution.\n% @evidence[[paper_data.json#/final_evaluation]]\n% @evidence[[analysis_results.json#/cases]]\n% @evidence[[source_evidence/calibration/program.py#L123-L192]]\n\\end{abstract}\n\n\\section{Introduction}\nScientific inference increasingly uses a small collection of expensive gold-standard labels together with predictions available on a larger collection of observations. The scientific target is often simpler than individual prediction: a prevalence, an average response, or another population summary. Prediction-powered inference uses labels to correct prediction error rather than treating machine predictions as truth \\citep{Angelopoulos2023PPI}. This distinction matters when the predictor is useful but imperfect. It also motivates a constrained question: once the observations and predictor are fixed, is there still room to improve the uncertainty attached to the population mean?\n\nThe constraint excludes acquiring labels, enlarging the unlabeled sample, or replacing the prediction model. It does not exclude fitting an inference-side transformation of its scalar output. A nonlinear transformation might make the score a better control variate for the outcome. Yet estimating this transformation consumes statistical information, and an interval can become shorter simply because its uncertainty calculation is inadequate. Thus, width alone cannot answer the question. Any efficiency claim must distinguish information extraction from estimation noise and must confront repeated-sampling coverage.\n\nWe study \\emph{honest frozen-score controls}: complementary labeled subsets fit a small regularized calibration family, while held-out labels correct its errors. A fixed-control variance identity explains the potential benefit of approximating the conditional outcome mean given the score. It also identifies a boundary on what calibration can accomplish: it cannot recover information absent from the frozen score. The evaluated interval uses a stabilized asymptotic variance approximation. A distinct bounded construction clarifies what a finite-sample argument would require, but its empirical efficiency is not observed here.\n\nOur central empirical finding is limited and asymmetric. Among seven conditions, only C2 has a negative paired mean-width difference relative to the evaluated PPI++ interval; the remaining six differences are positive. A low-prevalence condition exposes severe undercoverage and collapsed intervals for two asymptotic comparators. The score-control interval avoids these observed collapses but does not establish nominal coverage or an advantage over exact inference. These are comparisons of recorded intervals, not a causal test of nonlinear calibration.\n% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes/0/solution/case_summaries]]\n\nThe contributions are threefold: separating fixed-score efficiency potential from inference assumptions; a complete paired comparison retaining favorable and unfavorable conditions; and a failure analysis distinguishing non-collapse, narrowness, and validity. Missing generators and controlled ablations remain explicit limitations rather than being filled with inferred mechanisms.\n\n\\begin{figure}[t]\n\\centering\n\\begin{minipage}[c][1.8in][c]{\\textwidth}\n\\centering\n\\includegraphics[width=\\textwidth,height=1.8in,keepaspectratio]{figures/frozen_score_overview.png}\n\\end{minipage}\n\\caption{Inference with unchanged observations and a frozen predictor. Complementary labeled folds fit score-only controls; held-out residual correction targets the population mean. The evaluated stabilized asymptotic interval and the separate, unmeasured bounded safety construction must not be conflated. No new labels or predictor training are part of this comparison.}\n\\label{fig:overview}\n% @evidence[[source_evidence/calibration/program.py#L123-L192]]\n\\end{figure}\n\n\\section{Related Work}\n","exit_code":0,"status":"completed"}}
