gins/plugins/product-design/templates/prototype/AGENTS.md\n../task_drafting/_task_drafting/draft_20261106_231456_1794006896030685056/.agent_home/.codex/.tmp/plugins/plugins/product-design/templates/mobile-app/AGENTS.md\n{\n  \"figures\": [\n    {\n      \"attempted_generator\": \"generate-concept-figure\",\n      \"estimated_min_rendered_font_pt\": 9,\n      \"fallback_reason\": \"generate-concept-figure exited non-zero (rc=1)\",\n      \"figure_id\": \"sensitivity_overview\",\n      \"figure_type\": \"diagram\",\n      \"files\": {\n        \"png\": \"figures/sensitivity_overview.png\"\n      },\n      \"generator\": null,\n      \"intended_latex_width_fraction\": 1.0,\n      \"min_font_size_pt\": 9,\n      \"panel_count\": 2,\n      \"panels\": [\n        {\n          \"category_count\": 6,\n          \"label\": \"a\",\n          \"series_count\": 1\n        },\n        {\n          \"category_count\": 6,\n          \"label\": \"b\",\n          \"series_count\": 1\n        }\n      ],\n      \"panels_per_row\": 2,\n      \"placement\": \"full_width\",\n      \"prompt_log_path\": \"figures/sensitivity_overview.prompts.json\",\n      \"required\": true,\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"uses_abbrev_labels\": true,\n      \"uses_progression\": false\n    },\n    {\n      \"estimated_min_rendered_font_pt\": 8,\n      \"figure_id\": \"final_disruption_comparison\",\n      \"figure_type\": \"scatter\",\n      \"files\": {\n        \"pdf\": \"figures/final_disruption_comparison.pdf\",\n        \"png\": \"figures/final_disruption_comparison.png\"\n      },\n      \"generator\": \"matplotlib\",\n      \"intended_latex_width_fraction\": 1.0,\n      \"min_font_size_pt\": 8,\n      \"panel_count\": 3,\n      \"panels\": [\n        {\n          \"category_count\": 6,\n          \"label\": \"a\",\n          \"series_count\": 4\n        },\n        {\n          \"category_count\": 6,\n          \"label\": \"b\",\n          \"series_count\": 4\n        },\n        {\n          \"category_count\": 6,\n          \"label\": \"c\",\n          \"series_count\": 4\n        }\n      ],\n      \"panels_per_row\": 1,\n      \"placement\": \"full_width\",\n      \"required\": true,\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"uses_abbrev_labels\": true,\n      \"uses_progression\": false\n    },\n    {\n      \"estimated_min_rendered_font_pt\": 8,\n      \"figure_id\": \"paired_effect_uncertainty\",\n      \"figure_type\": \"composite\",\n      \"files\": {\n        \"pdf\": \"figures/paired_effect_uncertainty.pdf\",\n        \"png\": \"figures/paired_effect_uncertainty.png\"\n      },\n      \"generator\": \"matplotlib\",\n      \"intended_latex_width_fraction\": 1.0,\n      \"min_font_size_pt\": 8,\n      \"panel_count\": 3,\n      \"panels\": [\n        {\n          \"category_count\": 6,\n          \"label\": \"a\",\n          \"series_count\": 3\n        },\n        {\n          \"category_count\": 6,\n          \"label\": \"b\",\n          \"series_count\": 3\n        },\n        {\n          \"category_count\": 6,\n          \"label\": \"c\",\n          \"series_count\": 3\n        }\n      ],\n      \"panels_per_row\": 1,\n      \"placement\": \"full_width\",\n      \"required\": true,\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"uses_abbrev_labels\": true,\n      \"uses_progression\": false\n    }\n  ]\n}\nimport datetime\nimport hashlib\nimport json\nimport re\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom PIL import Image, ImageDraw\n\n\nROOT = Path(__file__).resolve().parent\nDATA = json.loads((ROOT / 'paper_data.json').read_text())\nEPISODES = DATA['final_evaluation']['evaluation_evidence']['episodes']\n# @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\nPROTOCOL = json.loads(json.loads((ROOT / 'source_evidence/task_contract.json').read_text())['method']['description'])\nNOMINAL = [float(value) for value in re.search(r'Fractions ([.0-9,]+) of', PROTOCOL['scientific_workload']).group(1).split(',')]\n# @evidence[[source_evidence/task_contract.json#/method]]\nCASES = [case['case'] for case in EPISODES[0]['solution']['cases']]\nLABELS = ['Arena', 'NBA 11', 'NBA 12', 'NBA 13', 'NBA 14', 'NBA 15']\nMETHODS = ['candidate', 'random_flip_score', 'degree_matched_score', 'margin_heuristic_score']\nNAMES = ['Guided refit', 'Uniform', 'Degree-stratified', 'Small margin']\nCOLORS = ['#0072B2', '#777777', '#009E73', '#D55E00']\nMARKERS = ['o', 's', '^', 'D']\nFIGURES = ROOT / 'figures'\nFIGURES.mkdir(exist_ok=True)\nplt.rcParams.update({'font.size': 9, 'axes.labelsize': 9, 'axes.titlesize': 9,\n                     'xtick.labelsize': 8, 'ytick.labelsize': 8,\n                     'legend.fontsize': 8, 'font.family': 'DejaVu Sans',\n                     'pdf.fonttype': 42, 'ps.fonttype': 42,\n                     'axes.spines.top': False, 'axes.spines.right': False})\n\n\ndef sidecar(path, inputs=None):\n    payload = {\n        'schema_name': 'scientific-evidence.artifact-manifest',\n        'artifact': {'path': str(path.relative_to(ROOT)), 'kind': 'figure' if path.suffix in ['.png', '.pdf'] else 'derived-data',\n                     'sha256': hashlib.sha256(path.read_bytes()).hexdigest()},\n        'derived_from': inputs or ['@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]'],\n        'generated_by': {'script_path': 'build_figures.py', 'command': ['python', 'build_figures.py']}}\n    Path(str(path) + '.prov.json').write_text(json.dumps(payload, indent=2))\n\n\ndef save(figure, figure_id):\n    for extension in ['pdf', 'png']:\n        path = FIGURES / f'{figure_id}.{extension}'\n        figure.savefig(path, dpi=300, facecolor='white')\n        sidecar(path)\n    plt.close(figure)\n\n\ndef curves(case_name, method):\n    values = []\n    for episode in EPISODES:\n        case = next(case for case in episode['solution']['cases'] if case['case'] == case_name)\n        values.append(case['candidate_curves'] if method == 'candidate' else case['baseline_curves'][method])\n    return np.asarray(values)\n\n\ndef overview_placeholder():\n    image_path = FIGURES / 'sensitivity_overview.png'\n    log_path = FIGURES / 'sensitivity_overview.prompts.json'\n    if (ROOT / '.concept_figure_complete').exists():\n        return\n    if log_path.exists() and json.loads(log_path.read_text()):\n        return\n    if not image_path.exists():\n        image = Image.new('RGB', (2400, 740), 'white')\n        draw = ImageDraw.Draw(image)\n        draw.text((100, 330), 'Concept overview reserved for orchestrator rendering', fill='#777777')\n        image.save(image_path)\n    if not log_path.exists():\n        log_path.write_text('{}\\n')\n\n\noverview_placeholder()\nfigure, axes = plt.subplots(3, 1, figsize=(5.5, 3.95), sharex=True, sharey=True)\nfigure.subplots_adjust(left=.12, right=.98, bottom=.12, top=.83, hspace=.29)\nfor budget, axis in enumerate(axes):\n    for method_index, method in enumerate(METHODS):\n        values = [curves(case, method).mean(axis=0)[budget] * 100 for case in CASES]\n        axis.plot(np.arange(len(CASES)) + (method_index - 1.5) * .12, values,\n                  marker=MARKERS[method_index], linestyle='none', markersize=4.5,\n                  color=COLORS[method_index], label=NAMES[method_index])\n    axis.set_title(f'({chr(97 + budget)}) Nominal edits: {100 * NOMINAL[budget]:.1f}%', loc='left', pad=2)\n    axis.set_ylim(-.3, 12.2)\n    axis.set_yticks([0, 5, 10])\n    axis.grid(axis='y', alpha=.18)\n    axis.set_ylabel('Disruption (%)')\naxes[-1].set_xticks(np.arange(len(CASES)), LABELS)\nfigure.legend(*axes[0].get_legend_handles_labels(), ncol=2, loc='upper center', frameon=False,\n              bbox_to_anchor=(.53, 1), columnspacing=1.4)\nsave(figure, 'final_disruption_comparison')\n\nfigure, axes = plt.subplots(3, 1, figsize=(5.5, 4.95), sharex=True)\nfigure.subplots_adjust(left=.15, right=.98, bottom=.105, top=.91, hspace=.39)\nstyles = ['solid', 'dashed', 'dotted']\nfor baseline_index, axis in enumerate(axes):\n    method = METHODS[baseline_index + 1]\n    for seed_index, episode in enumerate(EPISODES):\n        for case_index, case in enumerate(episode['solution']['cases']):\n            low, high = np.asarray(case['paired_intervals'][method]) * 100\n            axis.plot([low, high], [case_index + (seed_index - 1) * .19] * 2,\n                      color=COLORS[baseline_index + 1], linewidth=1.35, linestyle=styles[seed_index])\n    axis.axvline(0, color='black', linewidth=.7)\n    axis.set_yticks(np.arange(len(CASES)), LABELS)\n    axis.invert_yaxis()\n    axis.set_title(f'({chr(97 + baseline_index)}) Guided refit minus {NAMES[baseline_index + 1].lower()}', loc='left', pad=3)\n    axis.set_xlim(-2.5, 8.4)\n    axis.grid(axis='x', alpha=.16)\naxes[-1].set_xlabel('Paired disruption difference (percentage points)')\nlegend_lines = [plt.Line2D([], [], color='#333333', linestyle=style, label=f'Seed {episode[\"seed\"]}')\n                for episode, style in zip(EPISODES, styles)]\nfigure.legend(handles=legend_lines, ncol=3, loc='upper center', frameon=False,\n              bbox_to_anchor=(.56, 1))\nsave(figure, 'paired_effect_uncertainty')\n\nsummary = {'seeds': [episode['seed'] for episode in EPISODES], 'cases': {}}\nfor case_index, case_name in enumerate(CASES):\n    summary['cases'][case_name] = {method: curves(case_name, method).mean(axis=0).tolist() for method in METHODS}\n    summary['cases'][case_name]['counts'] = EPISODES[0]['solution']['cases'][case_index]['counts']\n    summary['cases'][case_name]['seed_budget_means'] = {\n        method: curves(case_name, method).mean(axis=1).tolist() for method in METHODS}\nsummary_path = ROOT / 'derived_summary.json'\nsummary_path.write_text(json.dumps(summary, indent=2))\nsidecar(summary_path)\n\ntable = ['\\\\begin{tabular}{lrrrrrr}', '\\\\toprule',\n         'Panel & $p$ & Edges & Min. degree & $k_{.001}$ & $k_{.005}$ & $k_{.01}$\\\\\\\\', '\\\\midrule']\nfor case, label in zip(EPISODES[0]['solution']['cases'], LABELS):\n    graph = case['graph']\n    entries = [graph['participants'], graph['edges'], graph['minimum_degree'], *case['counts']]\n    table.append(label + ' & ' + ' & '.join(map(str, entries)) + '\\\\\\\\')\ntable += ['\\\\bottomrule', '\\\\end{tabular}']\ntable_path = ROOT / 'panel_table.tex'\ntable_path.write_text('\\n'.join(table) + '\\n')\nsidecar(table_path)\n\ntable = ['\\\\begin{tabular}{llrrrr}', '\\\\toprule',\n         'Panel & Seed & Guided & Uniform & Degree & Margin\\\\\\\\', '\\\\midrule']\nfor case_name, label in zip(CASES, LABELS):\n    for seed_index, episode in enumerate(EPISODES):\n        means = [curves(case_name, method)[seed_index].mean() * 100 for method in METHODS]\n        table.append(f'{label} & {episode[\"seed\"]} & ' + ' & '.join(f'{value:.3f}' for value in means) + '\\\\\\\\')\ntable += ['\\\\bottomrule', '\\\\end{tabular}']\ntable_path = ROOT / 'seed_table.tex'\ntable_path.write_text('\\n'.join(table) + '\\n')\nsidecar(table_path)\n\nspecs = json.loads((ROOT / 'paper_strategy.json').read_text())['figure_specs']\nmanifest = {'figures': []}\nfor spec in specs:\n    concept = spec['figure_type'] == 'diagram'\n    figure_id = spec['figure_id']\n    panels = 2 if concept else 3\n    entry = {\n        'figure_id': figure_id, 'figure_type': {'grouped_dot': 'scatter', 'forest': 'composite'}.get(spec['figure_type'], spec['figure_type']),\n        'files': {'png': f'figures/{figure_id}.png', **({} if concept else {'pdf': f'figures/{figure_id}.pdf'})},\n        'panel_count': panels,\n        'panels': [{'label': chr(97 + index), 'category_count': 6,\n                    'series_count': 1 if concept else (4 if figure_id == 'final_disruption_comparison' else 3)}\n                   for index in range(panels)],\n        'uses_progression': False, 'generator': 'generate-concept-figure' if concept else 'matplotlib',\n        'source_ids': ['final.evidence.episodes'], 'placement': 'full_width',\n        'intended_latex_width_fraction': 1., 'estimated_min_rendered_font_pt': 9 if concept else 8,\n        'min_font_size_pt': 9 if concept else 8, 'panels_per_row': 2 if concept else 1,\n        'uses_abbrev_labels': True, 'required': True}\n    if concept:\n        entry['prompt_log_path'] = f'figures/{figure_id}.prompts.json'\n    manifest['figures'].append(entry)\n(ROOT / 'figure_manifest.json').write_text(json.dumps(manifest, indent=2))\nprint('Generated descriptive plots and tables from sealed final evidence; no fits or evaluations rerun.')\ncompile_latex.sh\nvalidate_compile_inputs.py\nvalidate_figures.py\nvalidate_rendered_si.py\nvalidate_tex_refs.py\nvalidate_claims.py\nappend_memory.py\nscientific_evidence.py\nscientific_evidence.sh\n# Agentic evidence audit feedback\n\n- generated_at: `2026-11-07T01:24:01.213611+00:00`\n- ok: `True`\n- verdict: `pass`\n- finding_count: `0`\n- audit_json_path: `work/results/t06/codex/20261106_231454/paper/paper_evidence_audit.json`\n- audit_markdown_path: `work/results/t06/codex/20261106_231454/paper/paper_evidence_audit.md`\n- raw_output_path: `work/results/t06/codex/20261106_231454/paper/paper_evidence_audit_raw.txt`\n\n## Summary\nMain-paper and supplementary claims match the current evidence, including final qualification, measured comparisons, conditional uncertainty, and implementation limitations.\n\n## Findings\n- None.\n# ICLR 2026 Venue Brief\n\nUse this brief to tailor the manuscript for the International Conference on Learning\nRepresentations 2026 submission.\n\n## Hard Constraints\n- Target venue: ICLR 2026.\n- Submission type: conference paper.\n- Body-page budget: 8 to 9 pages, excluding references. A body of 8 pages counts only when its final page is at least 75% full; a shorter or sparser body fails validation.\n- Review model: double-blind. The submission must be fully anonymized.\n- Omit author names, affiliations, acknowledgements, and funding statements from the manuscript.\n- Do not include self-identifying links such as personal repositories, lab pages, or internal URLs.\n- Refer to your own prior work in the third person; never write phrasing that reveals authorship.\n- Include a separate `LLM Usage` section, which may appear in the appendix, describing the precise role\n  of LLMs in research ideation and writing. Significant LLM use must be disclosed; nondisclosure can\n  cause desk rejection.\n- The paper must satisfy the ICLR template and formatting rules selected by `--paper-format iclr`.\n\n## Audience\n- Machine learning researchers working on representation learning, optimization, architectures, and\n  empirical methodology.\n- Readers expect a clearly stated contribution, honest baselines, controlled comparisons, ablations\n  that isolate the mechanism, and explicit statements of scope and limitations.\n- Reviewers reward reproducibility and calibrated claims far more than headline numbers.\n\n## Framing Priorities\n- Lead with the research question and the specific claim the evidence supports.\n- State the contribution precisely in the abstract and introduction: what is new, what it improves,\n  and under which conditions.\n- Motivate the method mechanistically. Explain why it should work, not only that it does.\n- Support the central claim with controlled comparisons against meaningful baselines.\n- Use ablations to attribute the gain to the proposed component rather than to incidental changes.\n- Report variance across seeds or runs whenever the artifacts provide it.\n- Be explicit about the regime studied and where the result is not expected to hold.\n\n## Manuscript Guidance\n- Prefer a title and abstract that name the mechanism and the setting, not a generic improvement claim.\n- In the introduction, make the contribution list concrete and verifiable against the artifacts.\n- In the method section, give enough detail to reimplement: objective, architecture, and the\n  hyperparameters that matter.\n- In the results section, foreground controlled comparisons, ablations, sensitivity, and failure modes.\n- Include a limitations discussion that a reviewer would otherwise raise.\n- Figures must meet top-tier conference standards in both design (clean typography, consistent colors,\n  proper labels and legends, high resolution) and scientific content (clear message, no filler).\n- The template is single-column: size figures for the full text width and keep axis labels legible.\n\n## Anti-Goals\n- Do not deanonymize the submission in any way.\n- Do not overclaim generality beyond the settings actually evaluated.\n- Do not present a benchmark delta as a mechanistic insight without evidence connecting the two.\n- Do not omit baselines or ablations that the grounded artifacts already support.\n- Do not describe results as state of the art unless the comparison in the artifacts establishes it.\n- Do not pad the paper to fill the page budget.\n\n## Decision Rule\n- When venue framing and grounded evidence conflict, follow the grounded evidence.\n- Use this brief to choose emphasis, terminology, and narrative framing, not to invent stronger claims\n  than the run supports.\n","exit_code":0,"status":"completed"}}
