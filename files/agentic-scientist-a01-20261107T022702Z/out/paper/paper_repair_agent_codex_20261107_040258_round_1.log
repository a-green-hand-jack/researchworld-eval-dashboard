         \"type\": \"integer\"\n        },\n        \"panels_per_row\": {\n          \"exclusiveMinimum\": 0,\n          \"title\": \"Panels Per Row\",\n          \"type\": \"integer\"\n        },\n        \"path_pdf\": {\n          \"default\": \"\",\n          \"title\": \"Path Pdf\",\n          \"type\": \"string\"\n        },\n        \"path_png\": {\n          \"minLength\": 1,\n          \"title\": \"Path Png\",\n          \"type\": \"string\"\n        },\n        \"placement\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"column\",\n                \"full_width\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Placement\"\n        },\n        \"prompt_log_path\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Prompt Log Path\"\n        },\n        \"series_per_panel\": {\n          \"items\": {\n            \"type\": \"integer\"\n          },\n          \"title\": \"Series Per Panel\",\n          \"type\": \"array\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"uses_abbrev_labels\": {\n          \"title\": \"Uses Abbrev Labels\",\n          \"type\": \"boolean\"\n        },\n        \"uses_progression\": {\n          \"title\": \"Uses Progression\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"figure_id\",\n        \"path_png\",\n        \"figure_type\",\n        \"n_panels\",\n        \"panels_per_row\",\n        \"categories_per_panel\",\n        \"series_per_panel\",\n        \"max_label_chars\",\n        \"font_sizes\",\n        \"uses_abbrev_labels\",\n        \"uses_progression\"\n      ],\n      \"title\": \"LegacyFigureManifestFigure\",\n      \"type\": \"object\"\n    },\n    \"RichFigureFiles\": {\n      \"additionalProperties\": false,\n      \"description\": \"Nested artifact paths used by the richer manifest shape.\",\n      \"properties\": {\n        \"pdf\": {\n          \"default\": \"\",\n          \"title\": \"Pdf\",\n          \"type\": \"string\"\n        },\n        \"png\": {\n          \"minLength\": 1,\n          \"title\": \"Png\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"png\"\n      ],\n      \"title\": \"RichFigureFiles\",\n      \"type\": \"object\"\n    },\n    \"RichFigureManifestFigure\": {\n      \"additionalProperties\": false,\n      \"allOf\": [\n        {\n          \"else\": {\n            \"properties\": {\n              \"files\": {\n                \"properties\": {\n                  \"pdf\": {\n                    \"minLength\": 1\n                  }\n                },\n                \"required\": [\n                  \"pdf\"\n                ]\n              }\n            }\n          },\n          \"if\": {\n            \"anyOf\": [\n              {\n                \"properties\": {\n                  \"generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  }\n                },\n                \"required\": [\n                  \"generator\"\n                ]\n              },\n              {\n                \"properties\": {\n                  \"attempted_generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  },\n                  \"fallback_reason\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  },\n                  \"generator\": {\n                    \"type\": \"null\"\n                  },\n                  \"prompt_l