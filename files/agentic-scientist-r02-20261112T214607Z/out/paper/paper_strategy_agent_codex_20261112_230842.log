s/memory-log/scripts/append_memory.py\", line 405, in _run_append_event\n    _append_text(global_memory_md_path, _markdown_entry(event), header=GLOBAL_MEMORY_HEADER)\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 126, in _append_text\n    fd = _open_regular_for_append(path)\n         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 161, in _open_regular_for_append\n    directory_fd = _walk_directory_no_follow(path.parent)\n                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/workspace/paper/.codex/skills/memory-log/scripts/append_memory.py\", line 198, in _walk_directory_no_follow\n    next_descriptor = os.open(component, flags, dir_fd=descriptor)\n                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\nNotADirectoryError: [Errno 20] Not a directory: 'global_memory'\n","exit_code":1,"status":"failed"}}
