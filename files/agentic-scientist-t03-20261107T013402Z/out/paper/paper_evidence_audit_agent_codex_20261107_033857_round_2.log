   },\n    {\n      \"configuration\": 1,\n      \"seed\": 1729,\n      \"case\": \"german_forest\",\n      \"cap\": 64,\n      \"agreement\": 0.9924479226795999\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 1729,\n      \"case\": \"german_forest\",\n      \"cap\": 256,\n      \"agreement\": 0.9924479226795999\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 1729,\n      \"case\": \"acs_logistic\",\n      \"cap\": 64,\n      \"agreement\": 0.9625197018469516\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 1729,\n      \"case\": \"acs_logistic\",\n      \"cap\": 256,\n      \"agreement\": 0.9353802192750965\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 1729,\n      \"case\": \"acs_forest\",\n      \"cap\": 64,\n      \"agreement\": 0.9999999999999996\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 1729,\n      \"case\": \"acs_forest\",\n      \"cap\": 256,\n      \"agreement\": 0.9999999999999996\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 2718,\n      \"case\": \"german_logistic\",\n      \"cap\": 64,\n      \"agreement\": 0.9462859254791982\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 2718,\n      \"case\": \"german_logistic\",\n      \"cap\": 256,\n      \"agreement\": 0.9168457611940626\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 2718,\n      \"case\": \"german_forest\",\n      \"cap\": 64,\n      \"agreement\": 0.9928614556826991\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 2718,\n      \"case\": \"german_forest\",\n      \"cap\": 256,\n      \"agreement\": 0.9928614556826991\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 2718,\n      \"case\": \"acs_logistic\",\n      \"cap\": 64,\n      \"agreement\": 0.9609211698970599\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 2718,\n      \"case\": \"acs_logistic\",\n      \"cap\": 256,\n      \"agreement\": 0.940106595789448\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 2718,\n      \"case\": \"acs_forest\",\n      \"cap\": 64,\n      \"agreement\": 0.9999999999999992\n    },\n    {\n      \"configuration\": 1,\n      \"seed\": 2718,\n      \"case\": \"acs_forest\",\n      \"cap\": 256,\n      \"agreement\": 0.9999999999999992\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 1729,\n      \"case\": \"german_logistic\",\n      \"cap\": 64,\n      \"agreement\": 0.9962474632755443\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 1729,\n      \"case\": \"german_logistic\",\n      \"cap\": 256,\n      \"agreement\": 0.9962474632755443\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 1729,\n      \"case\": \"german_forest\",\n      \"cap\": 64,\n      \"agreement\": 0.9924479226795999\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 1729,\n      \"case\": \"german_forest\",\n      \"cap\": 256,\n      \"agreement\": 0.9924479226795999\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 1729,\n      \"case\": \"acs_logistic\",\n      \"cap\": 64,\n      \"agreement\": 0.9999999999901937\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 1729,\n      \"case\": \"acs_logistic\",\n      \"cap\": 256,\n      \"agreement\": 0.9999999999901937\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 1729,\n      \"case\": \"acs_forest\",\n      \"cap\": 64,\n      \"agreement\": 0.9999999999999996\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 1729,\n      \"case\": \"acs_forest\",\n      \"cap\": 256,\n      \"agreement\": 0.9999999999999996\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 2718,\n      \"case\": \"german_logistic\",\n      \"cap\": 64,\n      \"agreement\": 0.9962879737624297\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 2718,\n      \"case\": \"german_logistic\",\n      \"cap\": 256,\n      \"agreement\": 0.9962879737624297\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 2718,\n      \"case\": \"german_forest\",\n      \"cap\": 64,\n      \"agreement\": 0.9928614556826991\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 2718,\n      \"case\": \"german_forest\",\n      \"cap\": 256,\n      \"agreement\": 0.9928614556826991\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 2718,\n      \"case\": \"acs_logistic\",\n      \"cap\": 64,\n      \"agreement\": 0.9999999999901937\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 2718,\n      \"case\": \"acs_logistic\",\n      \"cap\": 256,\n      \"agreement\": 0.9999999999901937\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 2718,\n      \"case\": \"acs_forest\",\n      \"cap\": 64,\n      \"agreement\": 0.9999999999999992\n    },\n    {\n      \"configuration\": 2,\n      \"seed\": 2718,\n      \"case\": \"acs_forest\",\n      \"cap\": 256,\n      \"agreement\": 0.9999999999999992\n    }\n  ],\n  \"reference_uncertainty\": {\n    \"german_logistic\": 0.00010498441729058304,\n    \"german_forest\": 0.00012034405187816677,\n    \"acs_logistic\": 0.0,\n    \"acs_forest\": 0.0\n  },\n  \"reference_sign_mean\": 0.9994791666666667,\n  \"max_repeat_vector_difference\": 0.0\n}\nimport ast\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom PIL import Image, ImageDraw\n\n\nROOT = Path(__file__).resolve().parent\nCOLORS = {'standard': '#c17b14', 'multistart': '#956ba5', 'structure': '#176b8c'}\nCASE_NAMES = {'german_logistic': 'German / logistic', 'german_forest': 'German / forest', 'acs_logistic': 'ACS / logistic', 'acs_forest': 'ACS / forest'}\nplt.rcParams.update({'font.size': 10, 'axes.labelsize': 10, 'axes.titlesize': 10, 'xtick.labelsize': 9, 'ytick.labelsize': 9, 'legend.fontsize': 9, 'pdf.fonttype': 42, 'ps.fonttype': 42, 'axes.spines.top': False, 'axes.spines.right': False})\n\n\ndef provenance(path, inputs):\n    manifest = {'schema_name': 'scientific-evidence.artifact-manifest', 'artifact': {'path': str(path), 'kind': 'figure' if str(path).endswith(('.png', '.pdf')) else 'derived', 'sha256': hashlib.sha256(Path(path).read_bytes()).hexdigest()}, 'derived_from': inputs, 'generated_by': {'script_path': 'build_artifacts.py', 'command': ['python', 'build_artifacts.py']}}\n    Path(str(path) + '.prov.json').write_text(json.dumps(manifest, indent=2))\n\n\ndef save_plot(figure, figure_id, inputs):\n    for extension in ('pdf', 'png'):\n        output = Path('figures') / (figure_id + '.' + extension)\n        figure.savefig(output, dpi=300)\n        provenance(output, inputs)\n    plt.close(figure)\n\n\ndef get_caps():\n    tree = ast.parse(Path('source_evidence/evaluation/evaluate_final.py').read_text())\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Dict):\n            for key, value in zip(node.keys, node.values):\n                if isinstance(key, ast.Constant) and key.value == 'budgets' and isinstance(value, ast.IfExp):\n                    return ast.literal_eval(value.orelse.orelse), ast.literal_eval(value.orelse.body)\n    raise RuntimeError('No grounded budget configuration')\n\n\ndef selected_cases(episodes):\n    return [(episode['seed'], case) for episode in episodes for case in episode['solution']['cases'] if case['case'] != 'controls' and not case['replay']]\n\n\ndef main():\n    Path('figures').mkdir(exist_ok=True)\n    Path('tables').mkdir(exist_ok=True)\n    data = json.loads(Path('paper_data.json').read_text())\n    final_caps, development_caps = get_caps()\n    final_episodes = data['final_evaluation']['evaluation_evidence']['episodes']\n    final = selected_cases(final_episodes)\n    source = ['@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]']\n    rows = []\n    for seed, case in final:\n        observations = case['observations']\n        cells = np.asarray(case['cells'])\n        repeat_pairs = np.asarray(case['repeat_pairs'])\n        for cap_index, cap in enumerate(final_caps):\n            rows.append({'seed': seed, 'case': case['case'], 'cap': cap, 'structure': cells[cap_index].mean(axis=(0, 1)).tolist(), 'standard': observations['baseline_metrics']['standard'][cap_index], 'multistart': observations['baseline_metrics']['multistart'][cap_index], 'repeat': repeat_pairs[cap_index].mean(axis=(0, 1)).tolist(), 'bootstrap_ci95': observations['fidelity_instance_bootstrap_ci95']})\n    summary = {'final': rows, 'final_caps': final_caps, 'development_caps': development_caps}\n    # @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    summary['reference_sign_mean'] = float(np.mean([row['structure'][2] for row in rows]))\n    summary['min_reference_sign'] = float(min(row['structure'][2] for row in rows))\n    summary['max_repeat_vector_difference'] = float(max(np.ptp(np.asarray(case['observations']['attributions']), axis=1).max() for seed, case in final))\n    summary['reference_uncertainty'] = {name: float(np.mean([np.mean(case['observations']['reference_uncertainty']) for seed, case in final if case['case'] == name])) for name in CASE_NAMES}\n    figure, axes = plt.subplots(2, 2, figsize=(5.5, 3.85), sharex=True, sharey=True)\n    markers = {'standard': 'o', 'multistart': 's', 'structure': 'D'}\n    labels = {'standard': 'Library one-shot', 'multistart': 'Two-start, split cap', 'structure': 'Structure-aware'}\n    for axis, name in zip(axes.flat, CASE_NAMES):\n        for offset, method in enumerate(labels):\n            means = []\n            for cap_index, cap in enumerate(final_caps):\n                values = [row[method][0] for row in rows if row['case'] == name and row['cap'] == cap]\n                positions = np.full(len(values), cap_index + (offset - 1) * .1)\n                axis.scatter(positions, values, color=COLORS[method], marker=markers[method], alpha=.5, s=13, zorder=4)\n                means.append(np.mean(values))\n            axis.plot(np.arange(len(final_caps)) + (offset - 1) * .1, means, color=COLORS[method], marker=markers[method], markersize=4, label=labels[method], linewidth=1.1)\n        axis.set_title(CASE_NAMES[name] + '\\n' + ('approximate reference' if name.startswith('german') else 'exhaustive reference'), pad=5)\n        axis.set_xticks(range(len(final_caps)), final_caps)\n        axis.set_ylim(0, 1.05)\n        axis.set_yticks([0, .5, 1])\n        axis.grid(axis='y', alpha=.18)\n    for axis in axes[1]:\n        axis.set_xlabel('Coalition cap')\n    for axis in axes[:, 0]:\n        axis.set_ylabel('Reference agreement')\n    handles, legend_labels = axes[0, 0].get_legend_handles_labels()\n    figure.legend(handles, legend_labels, loc='lower center', ncol=3, frameon=False, handlelength=1.1, columnspacing=.7)\n    figure.subplots_adjust(left=.12, right=.985, top=.88, bottom=.20, hspace=.72, wspace=.22)\n    save_plot(figure, 'final_reference_comparison', source)\n    # @evidence[[paper_data.json#/all_programs]]\n    development = []\n    for config_index, config in enumerate(data['all_programs']):\n        for seed, case in selected_cases(config['evaluation_evidence']['episodes']):\n            for cap_index, cap in enumerate(development_caps):\n                development.append({'configuration': config_index, 'seed': seed, 'case': case['case'], 'cap': cap, 'agreement': float(np.asarray(case['cells'])[cap_index, :, :, 0].mean())})\n    summary['development'] = development\n    figure, axes = plt.subplots(1, 2, figsize=(5.5, 2.65), sharey=True)\n    for axis, kind, before, after in zip(axes, ('forest', 'logistic'), (0, 1), (1, 2)):\n        categories = [(dataset + '_' + kind, cap) for dataset in ('german', 'acs') for cap in development_caps]\n        for config_index, offset, color, label in ((before, -.09, '#9b9b9b', 'Without component'), (after, .09, '#176b8c', 'With component')):\n            for category_index, (name, cap) in enumerate(categories):\n                values = [row['agreement'] for row in development if row['configuration'] == config_index and row['case'] == name and row['cap'] == cap]\n                axis.scatter(np.full(len(values), category_index + offset), values, color=color, s=19, label=label if category_index == 0 else None, zorder=3)\n                axis.plot([category_index + offset - .055, category_index + offset + .055], [np.mean(values)] * 2, color=color, linewidth=2)\n        axis.set_xticks(range(len(categories)), [name.split('_')[0].replace('german', 'Ger').replace('acs', 'ACS') + '\\n' + str(cap) for name, cap in categories])\n        axis.set_title('Exact forest component' if kind == 'forest' else 'Logistic integration component')\n        axis.set_ylim(.80, 1.01)\n        axis.set_yticks([.8, .9, 1.])\n        axis.grid(axis='y', alpha=.18)\n    axes[0].set_ylabel('Reference agreement')\n    figure.legend(*axes[0].get_legend_handles_labels(), loc='lower center', ncol=2, frameon=False)\n    figure.subplots_adjust(left=.12, right=.985, top=.85, bottom=.28, wspace=.25)\n    save_plot(figure, 'component_comparison', ['@evidence[[paper_data.json#/all_programs]]'])\n    figure, axes = plt.subplots(1, 2, figsize=(5.5, 2.65))\n    for axis, name in zip(axes, ('german_logistic', 'german_forest')):\n        for seed, case in final:\n            if case['case'] != name:\n                continue\n            reference = np.asarray(case['observations']['reference'])\n            estimate = np.asarray(case['observations']['attributions'])[0, 0]\n            half_difference = np.abs(np.asarray(case['observations']['reference_uncertainty'])).sum(axis=-1)\n            observed_distance = np.abs(estimate - reference).sum(axis=-1)\n            axis.scatter(half_difference, observed_distance, alpha=.6, s=12)\n        maximum = max(axis.get_xlim()[1], axis.get_ylim()[1])\n        axis.plot([0, maximum], [0, maximum], color='#777777', linestyle='--', linewidth=.8)\n        axis.set_title(CASE_NAMES[name])\n        axis.set_xlabel('Reference half-difference, L1')\n        axis.set_xlim(left=0)\n        axis.set_ylim(bottom=0)\n        axis.grid(alpha=.15)\n    axes[0].set_ylabel('Estimate-to-reference L1')\n    figure.subplots_adjust(left=.13, right=.98, bottom=.25, top=.86, wspace=.40)\n    save_plot(figure, 'reference_diagnostics', source)\n    concept = Path('figures/fixed_game_overview.png')\n    log = Path('figures/fixed_game_overview.prompts.json')\n    if not Path('.concept_figure_complete').exists() and not (log.exists() and json.loads(log.read_text())) and not concept.exists():\n        image = Image.new('RGB', (2400, 680), 'white')\n        drawing = ImageDraw.Draw(image)\n        drawing.text((80, 300), 'Conceptual overview reserved for synchronous rendering', fill='#555555')\n        image.save(concept)\n        log.write_text('{}\\n')\n    Path('analysis_summary.json').write_text(json.dumps(summary, indent=2))\n    provenance(Path('analysis_summary.json'), source + ['@evidence[[paper_data.json#/all_programs]]'])\n    table_lines = []\n    for name in CASE_NAMES:\n        chosen = [row for row in rows if row['case'] == name and row['cap'] == final_caps[0]]\n        means = {method: np.mean([row[method][0] for row in chosen]) for method in labels}\n        signs = np.mean([row['structure'][2] for row in chosen])\n        table_lines.append(f\"{CASE_NAMES[name]} & {means['standard']:.4f} & {means['multistart']:.4f} & {means['structure']:.4f} & {signs:.4f} \\\\\\\\\")\n    Path('tables/main_rows.tex').write_text('% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\\n' + '\\n'.join(table_lines) + '\\n')\n    provenance(Path('tables/main_rows.tex'), source)\n    extended = []\n    for row in rows:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"reasoning","text":"**Checking reference consistency**"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"sed -n '1245,1276p' source_evidence/evaluation/evaluate_final.py; sed -n '687,796p' source_evidence/evaluation/evaluate_final.py; sed -n '817,875p' source_evidence/evaluation/evaluate_final.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"sed -n '1245,1276p' source_evidence/evaluation/evaluate_final.py; sed -n '687,796p' source_evidence/evaluation/evaluate_final.py; sed -n '817,875p' source_evidence/evaluation/evaluate_final.py\"","aggregated_output":"\n\ndef make_episodes(seeds,settings):\n    episodes = [{'case':case,'seed':seed,'replay':False} for case in ('german_logistic','german_forest','acs_logistic','acs_forest','controls') for seed in seeds]\n    episodes.append({'case':'german_logistic','seed':seeds[0],'replay':True})\n    for episode in episodes:\n        episode['outcome'] = initial_outcome(episode,settings)\n    return episodes\n\n\ndef aggregate(outcomes,settings,complete,elapsed):\n    primary = [outcome for outcome in outcomes if not outcome['replay']]\n    empirical = [outcome for outcome in primary if outcome['case']!='controls']\n    controls = [outcome for outcome in primary if outcome['case']=='controls']\n    empirical_metrics = np.mean([empirical_summary(outcome,settings) for outcome in empirical],axis=0)\n    control_pass = float(np.mean([outcome['controls'] for outcome in controls]))\n    first = outcomes[0]\n    replay = outcomes[-1]\n    replay_error = 1.\n    if first['valid'] and replay['valid'] and first['solution'] is not None and replay['solution'] is not None:\n        replay_error = float(min(1,np.max(abs(np.asarray(first['solution']['attributions'])-np.asarray(replay['solution']['attributions'])))))\n    metrics = dict(zip(('reference_fidelity','top3_overlap','signed_agreement','efficiency_error'),map(float,empirical_metrics)))\n    metrics.update(control_pass_rate=control_pass,failed_fraction=float(sum(not outcome['valid'] for outcome in primary)/len(primary)),replay_error=replay_error,wall_seconds=float(elapsed))\n    if PLANE=='search':\n        metrics['combined_score'] = .8*metrics['reference_fidelity']+.2*control_pass\n    if not complete or not all(outcome['operational'] for outcome in outcomes):\n        metrics['wall_seconds'] = float(WALL_SECONDS)\n    correct = bool(complete and all(outcome['valid'] for outcome in outcomes) and control_pass==1 and replay_error<=1e-10)\n    return metrics,correct\n\n\ndef evidence_records(outcomes,settings):\ndef encode_dataset(dataset,smoke):\n    training = [record for record in dataset['records'] if record['role']=='train']\n    if smoke:\n        training = training[:64]\n    else:\n        training = training[:20000]\n    explanations = [record for record in dataset['records'] if record['role']=='explanation']\n    validation = [record for record in dataset['records'] if record['role']=='validation']\n    dimension = len(dataset['features'])\n    numeric = set(dataset['numeric'])\n    vocabularies = {}\n    for column in range(dimension):\n        if column not in numeric:\n            vocabularies[column] = {value:index for index,value in enumerate(sorted({record['raw'][column] for record in training if record['raw'][column] is not None}))}\n    def transform(records):\n        matrix = np.zeros((len(records),dimension))\n        for row_index,record in enumerate(records):\n            for column,value in enumerate(record['raw']):\n                matrix[row_index,column] = float(value) if column in numeric and value not in (None,'') else vocabularies.get(column,{}).get(value,-1) if column not in numeric else np.nan\n        return matrix\n    train = transform(training)\n    medians = np.nanmedian(train,axis=0)\n    medians = np.nan_to_num(medians)\n    train = np.where(np.isfinite(train),train,medians)\n    mean = train.mean(axis=0)\n    scale = train.std(axis=0)\n    scale[scale<1e-12] = 1\n    def standardized(records):\n        values = transform(records)\n        return (np.where(np.isfinite(values),values,medians)-mean)/scale\n    return (train-mean)/scale, np.array([record['y'] for record in training],dtype=int), standardized(explanations), standardized(validation), np.array([record['y'] for record in validation],dtype=int)\n\n\ndef predict(model,rows):\n    rows = np.asarray(rows,dtype=np.float64)\n    parameters = model['parameters']\n    if model['kind'] in ('logistic','affine'):\n        linear = rows@np.asarray(parameters['coef'])+parameters['intercept']\n        return linear if model['kind']=='affine' else 1/(1+np.exp(-np.clip(linear,-700,700)))\n    output = np.zeros(len(rows))\n    converted = rows.astype(np.float32)\n    for tree in parameters['trees']:\n        left,right,features,thresholds,probabilities = (np.asarray(tree[key]) for key in ('left','right','feature','threshold','probability'))\n        nodes = np.zeros(len(rows),dtype=np.int64)\n        for depth in range(7):\n            active = left[nodes]>=0\n            if not active.any():\n                break\n            selected = nodes[active]\n            nodes[active] = np.where(converted[active][np.arange(len(selected)),features[selected]] <= thresholds[selected],left[selected],right[selected])\n        output += probabilities[nodes]\n    return output/len(parameters['trees'])\n\n\ndef serialize_model(estimator,kind,background):\n    if kind == 'logistic':\n        parameters = {'coef':estimator.coef_[0].tolist(),'intercept':float(estimator.intercept_[0])}\n    else:\n        trees = []\n        for member in estimator.estimators_:\n            tree = member.tree_\n            distribution = tree.value[:,0,:]\n            trees.append({'left':tree.children_left.tolist(),'right':tree.children_right.tolist(),'feature':tree.feature.tolist(),'threshold':tree.threshold.tolist(),'probability':(distribution[:,1]/distribution.sum(axis=1)).tolist()})\n        parameters = {'trees':trees}\n    model = {'kind':kind,'dimension':background.shape[1],'background':background.tolist(),'parameters':parameters}\n    if len(compact(model))>MAX_DOCUMENT_BYTES:\n        raise RuntimeError('model serialization bound')\n    return model\n\n\ndef library_kernel(model,queries,budget,seed,counter):\n    def oracle(rows):\n        counter[0] += len(rows)\n        return predict(model,rows)\n    state = np.random.get_state()\n    try:\n        np.random.seed(seed%(2**32))\n        explainer = shap.KernelExplainer(oracle,np.asarray(model['background']),link='identity')\n        values = explainer.shap_values(np.asarray(queries),nsamples=budget,l1_reg=0.0,silent=True)\n        output = np.asarray(values,dtype=float)\n        if output.shape != np.asarray(queries).shape or not np.isfinite(output).all():\n            raise RuntimeError('invalid library reference')\n        return output\n    finally:\n        np.random.set_state(state)\n\n\ndef exact_reference(model,queries,counter):\n    dimension = model['dimension']\n    background = np.asarray(model['background'])\n    numbers = np.arange(1<<dimension,dtype=np.uint32)\n    masks = ((numbers[:,None]>>np.arange(dimension))&1).astype(bool)\n    references = []\n    for query in queries:\n        values = []\n        for offset in range(0,len(masks),128):\n            chunk = masks[offset:offset+128]\n            hybrids = np.where(chunk[:,None,:],query,background[None,:,:])\n            flattened = hybrids.reshape(-1,dimension)\n            counter[0] += len(flattened)\n            values.extend(predict(model,flattened).reshape(len(chunk),len(background)).mean(axis=1))\n        values = np.asarray(values)\n        reference = []\n        sizes = masks.sum(axis=1)\n        for feature in range(dimension):\n            absent = numbers[~masks[:,feature]]\n            weights = np.array([1/(dimension*math.comb(dimension-1,int(size))) for size in sizes[absent]])\n            reference.append(float(np.dot(weights,values[absent|(1<<feature)]-values[absent])))\n        references.append(reference)\n    return np.asarray(references)\ndef baseline_work(request):\n    science()\n    os.sched_setaffinity(0,sorted(os.sched_getaffinity(0))[:1])\n    resource.setrlimit(resource.RLIMIT_AS,(8*1024**3,8*1024**3))\n    resource.setrlimit(resource.RLIMIT_CPU,(cpu_limit_seconds(WALL_SECONDS,1),cpu_limit_seconds(WALL_SECONDS,1)+1))\n    smoke = request['smoke']\n    if request['case']=='controls':\n        return control_baseline(request)\n    settings = request['settings']\n    work = request['work_seconds']\n    dataset_name,kind = request['case'].split('_',1)\n    root = Path(request['root'])\n    def train():\n        dataset = load_data(root,dataset_name)\n        train_rows,labels,explanations,validation,targets = encode_dataset(dataset,smoke)\n        if len(np.unique(labels))!=2:\n            raise RuntimeError('training classes absent')\n        if kind=='logistic':\n            estimator = LogisticRegression(max_iter=500,random_state=request['seed'],solver='lbfgs',tol=1e-7)\n        else:\n            estimator = RandomForestClassifier(n_estimators=4 if smoke else 64,max_depth=6,random_state=request['seed'],n_jobs=1)\n        estimator.fit(train_rows,labels)\n        background = train_rows[:settings['background']]\n        queries = explanations[:settings['instances']]\n        model = serialize_model(estimator,kind,background)\n        probe = np.concatenate([queries,background])\n        if not np.allclose(predict(model,probe),estimator.predict_proba(probe)[:,1],rtol=1e-9,atol=1e-10):\n            raise RuntimeError('safe model serialization mismatch')\n        accuracy = float(np.mean(estimator.predict(validation)==targets))\n        diagnostics = {'validation_accuracy':accuracy,'fit_iterations':int(estimator.n_iter_[0]) if kind=='logistic' else 0,'fit_converged':bool(kind!='logistic' or estimator.n_iter_[0]<500)}\n        return model,queries,diagnostics\n    (model,queries,diagnostics),training_seconds = run_stage(train,work)\n    counters = {'reference':[0],'standard':[0],'multistart':[0]}\n    def references():\n        if model['dimension']<=10:\n            values = exact_reference(model,queries,counters['reference'])\n            return values,np.zeros_like(values)\n        budget = 64 if smoke else 4096\n        first = library_kernel(model,queries,budget,request['seed']+100000,counters['reference'])\n        second = library_kernel(model,queries,budget,request['seed']+200000,counters['reference'])\n        return (first+second)/2,abs(first-second)/2\n    (references,uncertainty),reference_seconds = run_stage(references,work)\n    def standard():\n        return [library_kernel(model,queries,budget,request['seed']+300000+index,counters['standard']).tolist() for index,budget in enumerate(settings['budgets'])]\n    standard_values,standard_seconds = run_stage(standard,work)\n    def multistart():\n        outputs = []\n        for index,budget in enumerate(settings['budgets']):\n            first = library_kernel(model,queries,max(1,budget//2),request['seed']+400000+2*index,counters['multistart'])\n            second = library_kernel(model,queries,max(1,budget//2),request['seed']+400001+2*index,counters['multistart'])\n            outputs.append(((first+second)/2).tolist())\n        return outputs\n    multistart_values,multistart_seconds = run_stage(multistart,work)\n    return {'model':model,'queries':queries.tolist(),'reference':references.tolist(),'reference_uncertainty':uncertainty.tolist(),'standard':standard_values,'multistart':multistart_values,'diagnostics':diagnostics,\n            'productive_seconds':{'training':training_seconds,'reference':reference_seconds,'standard':standard_seconds,'multistart':multistart_seconds},'prediction_rows':{key:value[0] for key,value in counters.items()}}\n\n\nclass BaselineWorker:\n    def __init__(self,request,deadline):\n","exit_code":0,"status":"completed"}}
