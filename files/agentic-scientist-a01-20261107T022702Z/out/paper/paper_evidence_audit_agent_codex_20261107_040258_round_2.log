{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport json,hashlib\np=json.load(open('paper_data.json'))\nfor file in ['data/protocol.json','derived/upstream_provenance.json','derived/checksums.json','derived/witness_verification.json','derived/local_audit.json']:\n x=json.load(open(file)); print(file,list(x));\n if file.endswith(('checksums.json','upstream_provenance.json','local_audit.json')): print(json.dumps(x,indent=1)[:10500])\n elif file.endswith('protocol.json'):\n  for k,v in x.items():print(k,json.dumps(v)[:2400])\n else:print(json.dumps(x)[:1200])\nfor family in ['helm','openllm']:\n x=json.load(open('data/'+family+'.json')); print('DATA',family,{k:v for k,v in x.items() if k not in ['rows','tasks']});print('tasks',x['tasks']); print('row0 keys',list(x['rows'][0])); print('provenance0',x['rows'][0].get('provenance'))\nprint('evaluator SHA',hashlib.sha256(open('source_evidence/evaluation.py','rb').read()).hexdigest())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
