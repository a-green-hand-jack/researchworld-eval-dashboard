  },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"original\",\n      \"seed\": 42017,\n      \"replay\": false,\n      \"index\": 14,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"permutation\",\n      \"seed\": 42011,\n      \"replay\": false,\n      \"index\": 15,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"permutation\",\n      \"seed\": 42013,\n      \"replay\": false,\n      \"index\": 16,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"permutation\",\n      \"seed\": 42017,\n      \"replay\": false,\n      \"index\": 17,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"constant\",\n      \"seed\": 42011,\n      \"replay\": false,\n      \"index\": 18,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"constant\",\n      \"seed\": 42013,\n      \"replay\": false,\n      \"index\": 19,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"constant\",\n      \"seed\": 42017,\n      \"replay\": false,\n      \"index\": 20,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"copy\",\n      \"seed\": 42011,\n      \"replay\": false,\n      \"index\": 21,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"copy\",\n      \"seed\": 42013,\n      \"replay\": false,\n      \"index\": 22,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"openllm\",\n      \"case\": \"copy\",\n      \"seed\": 42017,\n      \"replay\": false,\n      \"index\": 23,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    },\n    {\n      \"family\": \"helm\",\n      \"case\": \"original\",\n      \"seed\": 42011,\n      \"replay\": true,\n      \"index\": 24,\n      \"operation_counts\": {\n        \"reset\": 1,\n        \"upload_start\": 1,\n        \"upload_chunk\": 16,\n        \"upload_commit\": 1,\n        \"solve\": 1,\n        \"release\": 1\n      },\n      \"max_rpc_calls\": 21\n    }\n  ],\n  \"max_candidate_rpc_calls\": 525,\n  \"max_chunks\": 16,\n  \"max_raw_chunk_bytes\": 1048576,\n  \"max_logical_bytes\": 16777216,\n  \"max_response_decisions\": 48,\n  \"max_response_indices\": 100,\n  \"transfer_storage\": \"candidate-owned memory only; upload start/chunks/commit, no export/download or state transfer operations\",\n  \"targets\": 8,\n  \"rules\": [\n    \"mean\",\n    \"median\",\n    \"borda\"\n  ],\n  \"cap_fractions\": [\n    1.0,\n    0.5\n  ],\n  \"copy_cap_fractions\": [\n    0.0,\n    0.0\n  ],\n  \"normalization\": \"NFKC and whitespace fixed before splitting; structured raw score content canonical sorted Decimal strings excluding IDs/provenance; features only after raw-hash assignment. Scores /1 HELM, /100 normalized Open LLM columns; no Raw columns as separate tasks. Float64, rounded 10 decimals, aggregate co-first tolerance 1e-10. No causal training-efficacy interpretation.\",\n  \"target_selection\": \"Rank-stratified nonwinners under the original arithmetic mean; stable content-hash row order; linearly spaced positions including best nonwinner and worst. Freeze full eligible population before search. Smoke first 12 rows and one target only.\",\n  \"aggregation\": {\n    \"target_rule_cap\": \"Equal target weights, three rules weight 1/3 each, two caps weight 1/2 each\",\n    \"seed\": \"Equal primary-seed weights within case\",\n    \"case_weights\": {\n      \"original\": 0.7,\n      \"permutation\": 0.1,\n      \"constant\": 0.1,\n      \"copy\": 0.1\n    },\n    \"family_weights\": {\n      \"helm\": 0.5,\n      \"openllm\": 0.5\n    },\n    \"replay_weight\": 0.0,\n    \"worst_case\": 0.0,\n    \"failed_policy\": \"Retain every failed/missing contribution in fixed denominator; never retry or renormalize; missing mandatory controls make qualification/correctness infeasible.\"\n  },\n  \"decision_score\": \"Verified witness: 1 - selected_tasks/task_count. Honest independently certified unattainability: 1. Unresolved, missing, failed, malformed or unsupported answer: 0. Candidate self-report cannot certify ranks/optimality or validity.\",\n  \"canonical_controls\": {\n    \"constant\": \"Every score 0.5; empty allocation must be co-first under all rules/caps.\",\n    \"copy\": \"Zero allowed headroom; empty witness for already co-first, otherwise independently certified unattainability.\",\n    \"permutation\": \"Rotate task columns by one with IDs/caps; reject identity and content-invariant permutations. Trusted attainable status and certified exact minima invariant; approximate witnesses need not be identical.\",\n    \"reset_replay\": \"Reset at terminal first-seed replay restores validated status/effort signature; compare bounded serialized behavior, not candidate state flags.\"\n  },\n  \"baselines\": {\n    \"none\": \"No intervention\",\n    \"random\": \"One seeded uniform random full task order per decision, evaluate prefixes k=0..D until first win\",\n    \"greedy\": \"Actual marginal gap improvement with deterministic column-order ties\",\n    \"reference\": \"Exhaustive all subsets for six-task board; exact mean sorting and odd-median threshold; bounded SciPy HiGHS binary Borda gap model. Verify feasible witnesses directly; retain unresolved bound intervals.\"\n  },\n  \"budgets\": {\n    \"wall_seconds\": 1800,\n    \"startup_allowance_seconds\": 180,\n    \"finish_reserve_seconds\": 20,\n    \"reset_timeout_seconds\": 5,\n    \"episode_overhead_seconds\": 5,\n    \"methods_per_episode\": 5,\n    \"matched_work_seconds_per_method\": 8,\n    \"cleanup_seconds_per_method_joint_preflight\": 1,\n    \"baseline_worker_transport_extra_seconds\": 2,\n    \"oracle_milp_seconds_per_decision\": 0.15,\n    \"baseline_productive_floor\": null,\n    \"cpu_cores_total\": 2,\n    \"evaluator_threads\": 1,\n    \"candidate_threads\": 1,\n    \"candidate_memory_gib\": 6\n  },\n  \"smoke\": {\n    \"episodes_including_replay\": 9,\n    \"wall_seconds\": 120,\n    \"startup_allowance_seconds\": 10,\n    \"finish_reserve_seconds\": 5,\n    \"work_seconds_per_method\": 0.75,\n    \"target_count\": 1,\n    \"max_competitors\": 12,\n    \"max_rpc_calls\": 189,\n    \"seed\": 42011,\n    \"reset_timeout_seconds\": 2\n  },\n  \"scientific_validity\": \"Independent input integrity, rank/witness/bound checks, real code execution, matched nonvacuous controls and replay. No candidate flags certify learning, exactness or validity. No adaptivity or learning-state gate: this is static discrete optimization.\",\n  \"search_correct\": \"Sound responses and required controls/replay, intact provenance/protocol; honest unresolved originals retain zero and do not imply fabrication. No superiority, exactness-completion or publication threshold.\",\n  \"final_correct\": \"Separate sealed frozen-candidate evidence with same soundness gates; missing/failed original evidence retains zero, missing controls/baselines/integrity failures deny correctness. No automatic publication or universal-ordering claim.\",\n  \"limitations\": [\n    \"Cluster-level hash threshold targets 40/60 only in expectation; realized population imbalance is retained, not tuned using final outcomes.\",\n    \"Known names/base model/model-sha aliases are clustered, including HELM/HF namespace conventions; unrecorded model-family lineage remains ambiguous. No unseen-family generalization claim.\",\n    \"No causal link from counterfactual score ceilings to training data, dollars, tokens or attainable joint improvements.\",\n    \"One random baseline order has limited variability; statistical seeds and target populations support paired descriptive uncertainty, not universal generalization.\",\n    \"Paper PDF/LaTeX, current official conference template/checklist, literature verification and claim-specific uncertainty/novelty assessment are subsequent required deliverables, not fabricated by this scaffold.\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
