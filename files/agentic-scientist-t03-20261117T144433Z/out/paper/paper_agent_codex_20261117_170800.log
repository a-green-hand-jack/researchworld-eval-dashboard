      },\n        \"uses_progression\": {\n          \"title\": \"Uses Progression\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"figure_id\",\n        \"path_png\",\n        \"figure_type\",\n        \"n_panels\",\n        \"panels_per_row\",\n        \"categories_per_panel\",\n        \"series_per_panel\",\n        \"max_label_chars\",\n        \"font_sizes\",\n        \"uses_abbrev_labels\",\n        \"uses_progression\"\n      ],\n      \"title\": \"LegacyFigureManifestFigure\",\n      \"type\": \"object\"\n    },\n    \"RichFigureFiles\": {\n      \"additionalProperties\": false,\n      \"description\": \"Nested artifact paths used by the richer manifest shape.\",\n      \"properties\": {\n        \"pdf\": {\n          \"default\": \"\",\n          \"title\": \"Pdf\",\n          \"type\": \"string\"\n        },\n        \"png\": {\n          \"minLength\": 1,\n          \"title\": \"Png\",\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"png\"\n      ],\n      \"title\": \"RichFigureFiles\",\n      \"type\": \"object\"\n    },\n    \"RichFigureManifestFigure\": {\n      \"additionalProperties\": false,\n      \"allOf\": [\n        {\n          \"else\": {\n            \"properties\": {\n              \"files\": {\n                \"properties\": {\n                  \"pdf\": {\n                    \"minLength\": 1\n                  }\n                },\n                \"required\": [\n                  \"pdf\"\n                ]\n              }\n            }\n          },\n          \"if\": {\n            \"anyOf\": [\n              {\n                \"properties\": {\n                  \"generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  }\n                },\n                \"required\": [\n                  \"generator\"\n                ]\n              },\n              {\n                \"properties\": {\n                  \"attempted_generator\": {\n                    \"const\": \"generate-concept-figure\"\n                  },\n                  \"fallback_reason\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  },\n                  \"generator\": {\n                    \"type\": \"null\"\n                  },\n                  \"prompt_log_path\": {\n                    \"minLength\": 1,\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"generator\",\n                  \"attempted_generator\",\n                  \"prompt_log_path\",\n                  \"fallback_reason\"\n                ]\n              }\n            ]\n          }\n        }\n      ],\n      \"description\": \"Richer manifest shape used by newer standalone paper runs.\",\n      \"properties\": {\n        \"attempted_generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Attempted Generator\"\n        },\n        \"caption_short\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Caption Short\"\n        },\n        \"estimated_min_rendered_font_pt\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Estimated Min Rendered Font Pt\"\n        },\n        \"fallback_reason\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Fallback Reason\"\n        },\n        \"figure_id\": {\n          \"minLength\": 1,\n          \"title\": \"Figure Id\",\n          \"type\": \"string\"\n        },\n        \"figure_type\": {\n          \"enum\": [\n            \"grouped_bar\",\n            \"bar\",\n            \"line\",\n            \"box\",\n            \"violin\",\n            \"scatter\",\n            \"heatmap\",\n            \"table_matrix\",\n            \"table\",\n            \"composite\",\n            \"diagram\"\n          ],\n          \"title\": \"Figure Type\",\n          \"type\": \"string\"\n        },\n        \"files\": {\n          \"$ref\": \"#/$defs/RichFigureFiles\"\n        },\n        \"font_sizes\": {\n          \"anyOf\": [\n            {\n              \"$ref\": \"#/$defs/FigureFontSizes\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null\n        },\n        \"generator\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"generate-concept-figure\",\n                \"matplotlib\",\n                \"tikz\",\n                \"native_latex\",\n                \"manual\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Generator\"\n        },\n        \"intended_latex_width_fraction\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"maximum\": 1,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Intended Latex Width Fraction\"\n        },\n        \"label\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Label\"\n        },\n        \"max_label_chars\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Max Label Chars\"\n        },\n        \"min_font_size_pt\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"number\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Min Font Size Pt\"\n        },\n        \"note\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Note\"\n        },\n        \"panel_count\": {\n          \"exclusiveMinimum\": 0,\n          \"title\": \"Panel Count\",\n          \"type\": \"integer\"\n        },\n        \"panels\": {\n          \"items\": {\n            \"$ref\": \"#/$defs/RichFigurePanel\"\n          },\n          \"title\": \"Panels\",\n          \"type\": \"array\"\n        },\n        \"panels_per_row\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Panels Per Row\"\n        },\n        \"placement\": {\n          \"anyOf\": [\n            {\n              \"enum\": [\n                \"column\",\n                \"full_width\"\n              ],\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Placement\"\n        },\n        \"prompt_log_path\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Prompt Log Path\"\n        },\n        \"required\": {\n          \"anyOf\": [\n            {\n              \"type\": \"boolean\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Required\"\n        },\n        \"source_ids\": {\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"title\": \"Source Ids\",\n          \"type\": \"array\"\n        },\n        \"uses_abbrev_labels\": {\n          \"anyOf\": [\n            {\n              \"type\": \"boolean\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Uses Abbrev Labels\"\n        },\n        \"uses_progression\": {\n          \"title\": \"Uses Progression\",\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"figure_id\",\n        \"figure_type\",\n        \"files\",\n        \"panel_count\",\n        \"panels\",\n        \"uses_progression\"\n      ],\n      \"title\": \"RichFigureManifestFigure\",\n      \"type\": \"object\"\n    },\n    \"RichFigurePanel\": {\n      \"additionalProperties\": false,\n      \"description\": \"Panel-level metadata for the richer manifest shape.\",\n      \"properties\": {\n        \"categories\": {\n          \"anyOf\": [\n            {\n              \"items\": {\n                \"type\": \"string\"\n              },\n              \"type\": \"array\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Categories\"\n        },\n        \"category_count\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Category Count\"\n        },\n        \"content\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Content\"\n        },\n        \"label\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Label\"\n        },\n        \"metric\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Metric\"\n        },\n        \"panel_id\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Panel Id\"\n        },\n        \"series_count\": {\n          \"anyOf\": [\n            {\n              \"exclusiveMinimum\": 0,\n              \"type\": \"integer\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Series Count\"\n        },\n        \"task\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Task\"\n        },\n        \"threshold\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Threshold\"\n        },\n        \"y_range\": {\n          \"anyOf\": [\n            {\n              \"items\": {\n                \"type\": \"number\"\n              },\n              \"type\": \"array\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ],\n          \"default\": null,\n          \"title\": \"Y Range\"\n        }\n      },\n      \"title\": \"RichFigurePanel\",\n      \"type\": \"object\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"description\": \"Top-level figure-manifest document.\",\n  \"properties\": {\n    \"figures\": {\n      \"items\": {\n        \"anyOf\": [\n          {\n            \"$ref\": \"#/$defs/LegacyFigureManifestFigure\"\n          },\n          {\n            \"$ref\": \"#/$defs/RichFigureManifestFigure\"\n          }\n        ]\n      },\n      \"minItems\": 1,\n      \"title\": \"Figures\",\n      \"type\": \"array\"\n    }\n  },\n  \"required\": [\n    \"figures\"\n  ],\n  \"title\": \"FigureManifestDocument\",\n  \"type\": \"object\"\n}\n#!/usr/bin/env bash\nset -euo pipefail\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nexec python3 \"$SCRIPT_DIR/scientific_evidence.py\" \"$@\"\n#!/usr/bin/env python3\n\"\"\"Append validated local/global memory entries for idea workflows.\n\nTwo modes:\n\n* default (event append) — appends one memory event to ``memory.md`` (local +\n  global) plus one JSONL record to ``memory.jsonl``. Existing behavior.\n* ``--write-conclusions`` — atomically replaces ``conclusions.md`` with a\n  validated single-paragraph distilled summary and appends a record to\n  ``conclusions_history.jsonl``. Validation rejects empty input,\n  multi-paragraph input, or input over 300 words.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport fcntl\nimport json\nimport os\nimport stat\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nCONCLUSIONS_WORD_LIMIT = 300\nGATE_TRIGGER_VALUES = (\"a\", \"b\", \"c\", \"d\")\n\nLOCAL_MEMORY_HEADERS = \"\"\"# Memory Log\n\n## Context\n## Idea Discoveries\n## Program Evaluations\n## Failures / Regressions\n## Next Hypotheses\n\"\"\"\n\nGLOBAL_MEMORY_HEADER = \"# Global Memory Log\\n\\n\"\n\n\ndef utc_now() -> str:\n    \"\"\"Return the current UTC timestamp string.\"\"\"\n    return datetime.now(timezone.utc).isoformat()\n\n\ndef _load_event(*, event_json: str | None, event_file: Path | None) -> dict[str, Any]:\n    \"\"\"Load event.\"\"\"\n    if event_json:\n        parsed = json.loads(event_json)\n    elif event_file is not None:\n        parsed = json.loads(event_file.read_text(encoding=\"utf-8\"))\n    else:\n        raw = input().strip()\n        if not raw:\n            raise ValueError(\"missing event payload\")\n        parsed = json.loads(raw)\n    if not isinstance(parsed, dict):\n        raise ValueError(\"event payload must be a JSON object\")\n    return parsed\n\n\ndef _ensure_required_fields(event: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Ensure required fields.\"\"\"\n    normalized = dict(event)\n    if not isinstance(normalized.get(\"timestamp\"), str) or not normalized[\"timestamp\"].strip():\n        normalized[\"timestamp\"] = utc_now()\n\n    required_string_fields = (\"step\", \"scope\", \"summary\", \"evidence\", \"next_action\")\n    for key in required_string_fields:\n        value = normalized.get(key)\n        if not isinstance(value, str) or not value.strip():\n            raise ValueError(f\"missing required string field: {key}\")\n        normalized[key] = value.strip()\n\n    for key in (\"idea_id\", \"attempt_id\", \"program_id\"):\n        value = normalized.get(key)\n        if value is None:\n            continue\n        if not isinstance(value, str):\n            normalized[key] = str(value)\n        normalized[key] = normalized[key].strip() or None\n\n    metrics = normalized.get(\"metrics\")\n    if metrics is not None and not isinstance(metrics, dict):\n        raise ValueError(\"metrics must be an object when present\")\n    rubrics = normalized.get(\"rubrics\")\n    if rubrics is not None and not isinstance(rubrics, list):\n        raise ValueError(\"rubrics must be an array when present\")\n    tags = normalized.get(\"tags\")\n    if tags is not None:\n        if not isinstance(tags, list):\n            raise ValueError(\"tags must be an array when present\")\n        normalized[\"tags\"] = [str(item).strip() for item in tags if str(item).strip()]\n    return normalized\n\n\ndef _markdown_entry(event: dict[str, Any]) -> str:\n    \"\"\"Handle markdown entry logic for this module.\"\"\"\n    lines = [\n        f\"### {event['timestamp']} | step={event['step']} | scope={event['scope']}\",\nschema_version = 1\ncode_root = \"src\"\n\n[entrypoint]\npath = \"program.py\"\nlanguage = \"python\"\ntype = \"script\"\n\n[copy]\nexclude = [\n  \"**/__pycache__/**\",\n  \"**/*.pyc\",\n  \".venv/**\",\n  \"node_modules/**\",\n  \".git/**\",\n  \".mypy_cache/**\",\n  \".pytest_cache/**\",\n  \".ruff_cache/**\",\n  \".tox/**\",\n  \".nox/**\",\n  \"dist/**\",\n  \"build/**\",\n]\ninclude = [\n]\n\n[integration]\nkind = \"generic\"\nnotes = \"\"\n\"\"\"Finite-budget interventional Kernel SHAP, CPU/NumPy, handle-only API.\n\nAll requests/responses are finite JSON objects. Extra response keys are forbidden.\nSeeds are arbitrary nonnegative integers and initialize randomness, never workload.\nEvery episode starts with reset; subsequent independent explanations use start.\n\nreset: {\"op\":\"reset\",\"seed\":int} -> {\"ok\":true}. Erases all state.\nstart: {\"op\":\"start\", \"features\":int in [2,20], \"budget\":int in [32,256],\n        \"stream\":nonnegative int, \"input\":list[features],\n        \"background\":list[1..32][features], \"output\":\"positive_probability\",\n        \"value_function\":\"interventional_grouped\"}\n  Original columns are the players; numeric/string category values are opaque.\n  The evaluator masks complete original columns before training-fitted encoding.\n  Returns {\"masks\":list[budget][features]} of integer 0/1 values, first empty,\n  second full. All interior masks must be nonempty/nonfull. One live explanation;\n  start may discard prior state after a failure. No paths or model labels exist.\nobserve: {\"op\":\"observe\",\"values\":list[budget] of finite probabilities}\n  Supplies the background-averaged black-box model values in mask order.\n  Returns {\"phi\":list[features] of finite numbers, abs(value)<=1e6} on the\n  probability scale. Strings and booleans are not attribution numbers.\n  Consumes the live explanation. Solve a Shapley-kernel sampled constrained\n  regression: sampling a size proportional to 1/(size*(d-size)), then a uniform\n  subset, makes the interior least-squares weights equal. This implementation\n  stratifies that distribution, pairs complements when the design has enough\n  rows, and covers each size stratum without replacement before recycling.\n  Samples are dependent within a run, with the same kernel marginals.\n  Empty/full endpoints\n  impose exact efficiency (lstsq rcond=1e-10). Regression auditing uses\n  rtol=1e-6, atol=1e-7. The evaluator checks masks, budgets, the regression,\n  synthetic exact controls and reset replay, not candidate internal claims.\n\nBudgets include endpoints, duplicates and all model evaluations. No optimization\nor metric feedback is delivered. Independent repetitions have distinct stream\nIDs; same reset/stream/settings must replay deterministically. No training,\nstate export, file exchange, or large-value transport is needed: all bounded\nmessages fit below 64 MiB including JSON/envelope/framing. Larger shapes are\ninvalid, not requests to load files. Each run has exactly start + observe RPCs.\nSearch ranks evidence completion, not a favorable reliability conclusion. The\npaper still needs real results, uncertainty, references, official conference\ntemplate/checklist and all reproduction code; this starter is not a paper.\n\"\"\"\n\nfrom math import comb\n\nimport numpy as np\n\n_seed = 0\n_active = None\n\n\ndef _stratified_sizes(feature_count, count, generator):\n    \"\"\"Sample unordered complement strata with kernel-proportional marginals.\"\"\"\n    if count == 0:\n        return np.empty(0, dtype=np.int64)\n    sizes = np.arange(1, feature_count // 2 + 1, dtype=np.int64)\n    weights = 1.0 / (sizes * (feature_count - sizes))\n    weights *= np.where(2 * sizes == feature_count, 1.0, 2.0)\n    cumulative = np.cumsum(weights / weights.sum())\n    cumulative[-1] = 1.0\n    positions = (np.arange(count) + generator.random(count)) / count\n    selected = sizes[np.searchsorted(cumulative, positions, side=\"right\")]\n    generator.shuffle(selected)\n    return selected\n\n\ndef _draw_mask(feature_count, size, generator, visited):\n    \"\"\"Draw a uniformly oriented pair, without replacement within each cycle.\"\"\"\n    full_mask = (1 << feature_count) - 1\n    capacity = comb(feature_count, size)\n    if 2 * size == feature_count:\n        capacity //= 2\n    seen = visited.setdefault(size, set())\n    if len(seen) == capacity:\n        seen.clear()\n    while True:\n        columns = generator.choice(feature_count, size=size, replace=False)\n        encoded = sum(1 << int(column_index) for column_index in columns)\n        if 2 * size == feature_count:\n            encoded = min(encoded, full_mask ^ encoded)\n        if encoded not in seen:\n            seen.add(encoded)\n            break\n    if generator.integers(2):\n        encoded = full_mask ^ encoded\n    return np.asarray(\n        [(encoded >> column_index) & 1 for column_index in range(feature_count)],\n        dtype=np.int64,\n    )\n\n\ndef _coalition_design(feature_count, budget, generator):\n    \"\"\"Spend exactly budget rows, retaining rank headroom before pairing.\"\"\"\n    masks = np.zeros((budget, feature_count), dtype=np.int64)\n    masks[1] = 1\n    interior_count = budget - 2\n    pair_count = min(\n        interior_count // 2,\n        max(0, interior_count - 2 * (feature_count - 1)),\n    )\n    single_count = interior_count - 2 * pair_count\n    pair_sizes = _stratified_sizes(feature_count, pair_count, generator)\n    single_sizes = _stratified_sizes(feature_count, single_count, generator)\n    visited = {}\n    row_index = 2\n    for size in pair_sizes:\n        mask = _draw_mask(feature_count, int(size), generator, visited)\n        masks[row_index] = mask\n        masks[row_index + 1] = 1 - mask\n        row_index += 2\n    for size in single_sizes:\n        masks[row_index] = _draw_mask(feature_count, int(size), generator, visited)\n        row_index += 1\n    generator.shuffle(masks[2:])\n    return masks\n\n\ndef handle(request):\n    global _seed, _active\n    operation = request[\"op\"]\n    if operation == \"reset\":\n        if type(request[\"seed\"]) is not int or request[\"seed\"] < 0:\n            raise ValueError(\"invalid seed\")\n        _seed = request[\"seed\"]\n        _active = None\n        return {\"ok\": True}\n    if operation == \"start\":\n        features = request[\"features\"]\n        budget = request[\"budget\"]\n        if not 2 <= features <= 20 or not 32 <= budget <= 256:\n            raise ValueError(\"unsupported shape\")\n        generator = np.random.default_rng(np.random.SeedSequence([_seed, request[\"stream\"]]))\n        masks = _coalition_design(features, budget, generator)\n        _active = masks\n        return {\"masks\": masks.tolist()}\n    if operation == \"observe\":\n        if _active is None:\n            raise ValueError(\"no active explanation\")\n        masks = _active\n        values = np.asarray(request[\"values\"], dtype=np.float64)\n        total = values[1] - values[0]\n        design = masks[2:, :-1] - masks[2:, -1:]\n        target = values[2:] - values[0] - masks[2:, -1] * total\n        partial = np.linalg.lstsq(design, target, rcond=1e-10)[0]\n        attribution = np.append(partial, total - partial.sum())\n        _active = None\n        return {\"phi\": attribution.tolist()}\n    raise ValueError(\"unknown operation\")\n","exit_code":0,"status":"completed"}}
