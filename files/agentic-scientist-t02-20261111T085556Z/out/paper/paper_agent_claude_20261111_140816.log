dths, dtype=float))\n    xc = x - x.mean()\n    denom = float((xc ** 2).sum())\n    point = ols_slope(np.repeat(x, len(seeds)), log_gap.ravel())\n    if denom == 0.0:\n        return point, point, point\n    rng = np.random.default_rng(BOOTSTRAP_SEED)\n    draws = rng.integers(0, len(seeds), size=(BOOTSTRAP_RESAMPLES, len(seeds)))\n    # a seed resamples all of its widths together (cluster bootstrap over seeds)\n    means = log_gap[:, draws].mean(axis=2)                       # [width, resample]\n    slopes = (xc[:, None] * means).sum(axis=0) / denom\n    low, high = np.percentile(slopes, [2.5, 97.5])\n    return point, float(low), float(high)\n\n\ndef aggregate_plane(wl, episodes, outcomes, complete, reference, baseline_failures, elapsed, hard_deadline,\n                    total_rpc, rpc_count, reset_log, sequence):\n    prim = [i for i, e in enumerate(episodes) if e[\"kind\"] == \"primary\"]\n    ctrl = [i for i, e in enumerate(episodes) if e[\"kind\"] != \"primary\"]\n    n_p = len(prim)\n    passed = [False] * len(episodes)\n    for i in prim:\n        passed[i] = outcomes[i][\"complete\"]\n    for i in ctrl:\n        passed[i] = control_passes(outcomes[i])\n    point, low, high = slope_statistics(wl, episodes, outcomes)\n    if reference is None:\n        ref_slope = 0.0\n    else:\n        ref_slope = ols_slope(np.log2(np.asarray(wl[\"widths\"], dtype=float)),\n                              [math.log(g) for g in reference[\"gaps\"]])\n    metrics = {\n        \"combined_score\": seed_width_score(episodes, outcomes, wl),\n        \"grok_delay_log_slope\": point,\n        \"grok_delay_slope_ci_low\": low,\n        \"grok_delay_slope_ci_high\": high,\n        \"reference_delay_log_slope\": ref_slope,\n        \"censored_fraction\": weighted_mean([1.0 if outcomes[i][\"censored\"] else 0.0 for i in prim],\n                                           [1.0 / n_p] * n_p),\n        \"control_max_val_acc\": max(outcomes[i][\"max_val\"] for i in ctrl),\n        \"missing