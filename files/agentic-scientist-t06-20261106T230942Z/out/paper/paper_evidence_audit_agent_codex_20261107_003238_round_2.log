troduction excerpts inspected\nBroderick2020\tAn Automatic Finite-Sample Robustness Metric: When Can Dropping a Little Data Make a Big Difference?\tOriginal abstract and original PDF abstract/introduction excerpts inspected\nChiang2024\tChatbot Arena: An Open Platform for Evaluating LLMs by Human Preference\tOriginal abstract and original PDF abstract/introduction excerpts inspected\n{\"cases\":{\"arena\":{\"groups\":37842,\"participants\":64,\"rows\":43205},\"nba-2011\":{\"groups\":1311,\"participants\":30,\"rows\":1311},\"nba-2012\":{\"groups\":1074,\"participants\":30,\"rows\":1074},\"nba-2013\":{\"groups\":1314,\"participants\":30,\"rows\":1314},\"nba-2014\":{\"groups\":1319,\"participants\":30,\"rows\":1319},\"nba-2015\":{\"groups\":1311,\"participants\":30,\"rows\":1311}},\"content_disjoint\":true,\"group_rule\":\"sha256(split-v1:minimum-content-hash) modulo 4 equals 0 for search\",\"hash_count\":290358,\"nba_exclusions\":[],\"normalization\":\"v1 NFC line endings preserve case/whitespace; additional NFKC whitespace-collapsed audit; JSON parsed before hashing; swapped example canonicalization; transitive document groups\",\"source_disjoint\":true,\"sources\":{\"arena\":[\"18c298340948c0e7f7727399fd459cca6ce0ca6f\",\"0692154aaf20fc6649090c3f49b6b5dd1e693a765ecb5f0856ae0da5946f5be2\"],\"nba\":[\"4c1ff5e3aef1816ae04af63218015066e186c147\",\"d46ed3540ee8d9eca31b3e94cc8c777e0be5156173d814ebf65b8195e8d616bc\"]}}\n","exit_code":0,"status":"completed"}}
