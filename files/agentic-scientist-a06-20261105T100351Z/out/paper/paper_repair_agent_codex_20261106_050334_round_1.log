urncode:\n        raise RuntimeError(' '.join(command) + '\\n' + result.stdout[-2000:] + result.stderr[-2000:])\n    return result.stdout\n\n\ndef compile_paper():\n    commands = [['pdflatex', '-recorder', '-no-shell-escape', '-interaction=nonstopmode', '-halt-on-error', 'paper.tex'],\n                ['bibtex', 'paper'],\n                ['pdflatex', '-recorder', '-no-shell-escape', '-interaction=nonstopmode', '-halt-on-error', 'paper.tex'],\n                ['pdflatex', '-recorder', '-no-shell-escape', '-interaction=nonstopmode', '-halt-on-error', 'paper.tex']]\n    for command in commands:\n        if command[0] == 'bibtex':\n            run([sys.executable, CHECKER, 'bibtex', '--paper-dir', '.', '--aux', 'paper.aux'])\n        run([sys.executable, CHECKER, 'run', '--'] + command)\n    raw = subprocess.run([sys.executable, CHECKER, 'recorder', '--paper-dir', '.', '--fls', 'paper.fls'],\n                         cwd=ROOT, text=True, capture_output=True)\n    recorder = Path('paper.fls').read_text()\n    mappings = []\n    lines = []\n    for line in recorder.splitlines():\n        if line.startswith('INPUT /'):\n            original = Path(line[6:])\n            if original.is_symlink():\n                resolved = original.resolve(strict=True)\n                if not original.samefile(resolved):\n                    raise RuntimeError('Symlink normalization changed the actual file')\n                mappings.append({'original': str(original), 'canonical': str(resolved),\n                                 'sha256': hashlib.sha256(original.read_bytes()).hexdigest()})\n                line = 'INPUT ' + str(resolved)\n        lines.append(line)\n    Path('analysis/canonical_compile_inputs.fls').write_text('\\n'.join(lines) + '\\n')\n    run([sys.executable, CHECKER, 'recorder', '--paper-dir', '.', '--fls', 'analysis/canonical_compile_inputs.fls'])\n    report = {'raw_recorder_returncode': raw.returncode,\n              'raw_recorder_message': (raw.stdout + raw.stderr).strip(),\n              'canonical_recorder_validated': True, 'system_symlink_mappings': mappings,\n              'note': 'The untouched original recorder is paper.fls. Canonical paths identify exactly the same input files.'}\n    Path('analysis/compile_path_resolution.json').write_text(json.dumps(report, indent=2) + '\\n')\n    return report\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--compile', action='store_true')\n    args = parser.parse_args()\n    report = {}\n    if args.compile:\n        report['compile'] = compile_paper()\n    report['sections_citations'] = run([sys.executable, '.codex/skills/validate-paper/scripts/validate_tex_refs.py',\n                                       '--tex', 'paper.tex', '--bib', 'references.bib']).strip()\n    report['claims_evidence'] = run([sys.executable, '.codex/skills/write-paper-standalone/scripts/validate_claims.py',\n                                    '--paper-data', 'paper_data.json', '--references', 'references_provenance.json',\n                                    '--bib', 'references.bib', '--claims', 'claims_grounding.json', '--paper-dir', '.']).strip()\n    manifest = json.loads(Path('figure_manifest.json').read_text())\n    schema = json.loads(Path('.codex/skills/validate-paper/templates/figure_manifest.schema.json').read_text())\n    jsonschema.validate(manifest, schema)\n    strategy = json.loads(Path('paper_strategy.json').read_text())\n    by_id = {figure['figure_id']: figure for figure in manifest['figures']}\n    for spec in strategy['figure_specs']:\n        figure = by_id[spec['figure_id']]\n        for actual, limit in [('n_panels', 'max_panels'), ('panels_per_row', 'max_panels_per_row')]:\n            if figure[actual] > spec[limit]:\n                raise RuntimeError(f'Figure density exceeds {limit}')\n        for actual, limit in [('categories_per_panel', 'max_categories_per_panel'), ('series_per_panel', 'max_series_per_panel')]:\n            if max(figure[actual]) > spec[limit]:\n                raise RuntimeError(f'Figure density exceeds {limit}')\n        for field in ['path_png', 'path_pdf', 'prompt_log_path']:\n            if field in figure and not Path(figure[field]).is_file():\n                raise RuntimeError('Missing figure artifact: ' + figure[field])\n    tex = Path('paper.tex').read_text()\n    included = set(re.findall(r'\\\\includegraphics(?:\\[[^\\]]*\\])?\\{([^}]+)\\}', tex))\n    declared = {figure[field] for figure in manifest['figures'] for field in ['path_png', 'path_pdf'] if field in figure}\n    if not included.issubset(declared):\n        raise RuntimeError('Unregistered figure references')\n    report['figure_schema_and_strategy_budgets'] = 'passed'\n    evidence = json.loads(Path('paper_data.json').read_text())\n    actual_hash = hashlib.sha256(Path('source_evidence/evaluate_final.py').read_bytes()).hexdigest()\n    if actual_hash != evidence['final_evaluation']['evaluator_sha256'].removeprefix('sha256:'):\n        raise RuntimeError('Evaluator source digest mismatch')\n    if Path('source_evidence/downstream/program/src/program.py').read_bytes() != Path('source_evidence/downstream/baseline/src/program.py').read_bytes():\n        raise RuntimeError('Retained policy differs from preserved baseline')\n    report['source_identity_checks'] = 'passed for evaluator file and preserved policy bytes only'\n    reference_keys = set(re.findall(r'@\\w+\\{([^,]+),', Path('references.bib').read_text()))\n    if not 25 <= len(reference_keys) <= 30:\n        raise RuntimeError('Reference budget not satisfied')\n    report['reference_count'] = len(reference_keys)\n    document = pymupdf.open('paper.pdf')\n    body_pages = None\n    for index, page in enumerate(document):\n        text = page.get_text()\n        if re.search(r'\\bREFERENCES\\b', text):\n            body_pages = index\n            break\n    if body_pages is None or not 8 <= body_pages <= 9:\n        raise RuntimeError(f'Body-page budget failed: {body_pages}')\n    page = document[body_pages - 1]\n    spans = [span for block in page.get_text('dict')['blocks'] if 'lines' in block\n             for line in block['lines'] for span in line['spans']\n#!/bin/bash\nset -euo pipefail\n\nif [ $# -ne 1 ]; then\n  echo \"Usage: bash compile_latex.sh <paper.tex>\" >&2\n  exit 2\nfi\n\nTEX_ARGUMENT=\"$1\"\nif [ ! -f \"$TEX_ARGUMENT\" ]; then\n  echo \"Missing TeX file: $TEX_ARGUMENT\" >&2\n  exit 2\nfi\n\nif ! command -v pdflatex >/dev/null 2>&1; then\n  echo \"Missing required command: pdflatex\" >&2\n  exit 2\nfi\nif ! command -v bibtex >/dev/null 2>&1; then\n  echo \"Missing required command: bibtex\" >&2\n  exit 2\nfi\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"Missing required command: python3\" >&2\n  exit 2\nfi\nif ! command -v pdftotext >/dev/null 2>&1; then\n  echo \"Missing required command: pdftotext\" >&2\n  exit 2\nfi\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPAPER_DIR=\"$(cd \"$(dirname \"$TEX_ARGUMENT\")\" && pwd)\"\nTEX_FILE=\"$(basename \"$TEX_ARGUMENT\")\"\nBASE=\"${TEX_FILE%.tex}\"\nRECORDER_FILE=\"${BASE}.fls\"\nAUX_FILE=\"${BASE}.aux\"\n\ncd \"$PAPER_DIR\"\n\nrun_sanitized() {\n  python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" run -- \"$@\"\n}\n\nrun_pdflatex() {\n  rm -f -- \"$RECORDER_FILE\"\n  set +e\n  run_sanitized pdflatex \\\n    -recorder -no-shell-escape -interaction=nonstopmode -halt-on-error \"$TEX_FILE\"\n  local return_code=$?\n  set -e\n  if [ -f \"$RECORDER_FILE\" ]; then\n    python3 \"$SCRIPT_DIR/validate_compile_inputs.py\" recorder \\\n      --paper-dir \"$PAPER_DIR\" --fls \"$RECORDER_FILE\"\n  elif [ \"$return_code\" -eq 0 ]; then\n    echo \"LaTeX recorder output missing: $PAPER_DIR/$RECORDER_FILE\" >&2\n    return 1\n  fi\n  return \"$return_code\"\n}\n\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_compile_inputs.py\" bibtex \\\n  --paper-dir \"$PAPER_DIR\" --aux \"$AUX_FILE\"\nrun_sanitized bibtex \"$BASE\"\nrun_pdflatex\nrun_pdflatex\npython3 \"$SCRIPT_DIR/validate_rendered_si.py\" --pdf \"${BASE}.pdf\"\n#!/usr/bin/env python3\n\"\"\"Validate figure manifest artifacts and basic figure readability budgets.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nfrom src.orchestrator.paper_step import read_json, validate_figure_manifest\nfrom src.orchestrator.tex_graphics import read_tex_file_bounded\n\n\ndef parse_args() -> argparse.Namespace:\n    \"\"\"Parse command-line arguments.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Validate figure manifest artifacts.\")\n    parser.add_argument(\"--paper-dir\", default=\".\")\n    return parser.parse_args()\n\n\ndef main() -> int:\n    \"\"\"Run the command-line entry point.\"\"\"\n    args = parse_args()\n    paper_dir = Path(args.paper_dir).resolve()\n    tex_path = paper_dir / \"paper.tex\"\n    paper_data_path = paper_dir / \"paper_data.json\"\n    references_path = paper_dir / \"references_provenance.json\"\n\n    if not tex_path.exists():\n        raise SystemExit(f\"Missing required artifact: {tex_path}\")\n\n    tex_text = read_tex_file_bounded(tex_path)\n    paper_data = read_json(paper_data_path)\n    references = read_json(references_path)\n    grounding_sources = paper_data.get(\"grounding_sources\")\n    if not isinstance(grounding_sources, dict):\n        raise SystemExit(\"paper_data missing grounding_sources object.\")\n    allowed_source_ids = set(str(key) for key in grounding_sources)\n    refs = references.get(\"references\")\n    if isinstance(refs, list):\n        for row in refs:\n            if isinstance(row, dict):\n                source_id = row.get(\"id\")\n                if isinstance(source_id, str) and source_id.strip():\n                    allowed_source_ids.add(source_id)\n\n    report = validate_figure_manifest(\n        paper_dir,\n        tex_text=tex_text,\n        allowed_source_ids=allowed_source_ids,\n    )\n    if not bool(report.get(\"checked\", False)):\n        print(\"No figures referenced or required; figure validation skipped.\")\n        return 0\n\n    hard_errors = report.get(\"hard_errors\", [])\n    if not isinstance(hard_errors, list):\n        raise SystemExit(\"figure_manifest validation returned invalid hard_errors payload\")\n    soft_warnings = report.get(\"soft_warnings\", [])\n    if not isinstance(soft_warnings, list):\n        raise SystemExit(\"figure_manifest validation returned invalid soft_warnings payload\")\n    if hard_errors:\n        raise SystemExit(\"Figure validation failed: \" + \"; \".join(str(error) for error in hard_errors))\n    if soft_warnings:\n        print(\"Figure validation warnings: \" + \"; \".join(str(message) for message in soft_warnings))\n\n    print(\n        f\"Validated {int(report.get('figure_count', 0))} figures with manifest and readability budgets.\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n{\n  \"sections_citations\": \"Validated sections and 25 citation key references.\",\n  \"claims_evidence\": \"Validated 127 grounded claims and 25 provenance references.\",\n  \"figure_schema_and_strategy_budgets\": \"passed\",\n  \"source_identity_checks\": \"passed for evaluator file and preserved policy bytes only\",\n  \"reference_count\": 25,\n  \"body_pages\": 8,\n  \"last_body_page_text_bounds_pt\": [\n    84.26844787597656,\n    663.5068359375\n  ],\n  \"last_body_page_geometric_vertical_occupancy\": 0.8938864013295115,\n  \"page_measurement_note\": \"Local rendered geometric check, not the unavailable parent orchestrator verdict.\",\n  \"visible_language_and_resolved_citations\": \"passed\",\n  \"rendered_supplement\": \"Validated rendered Supplementary Information.\",\n  \"overview_status\": \"orchestrator-owned placeholder\"\n}\n{\n  \"global_memory_dir\": \"work/results/a06/codex/20261105_100448/investigation\",\n  \"output_dir\": \"work/results/a06/codex/20261105_100448/paper\",\n  \"results_dir\": \"work/results/a06/codex/20261105_100448/investigation\",\n  \"schema_version\": 1,\n  \"task_dir\": \"work/results/a06/codex/20261105_100448/task\"\n}\nnode-compile-cache\nopencode\n","exit_code":0,"status":"completed"}}
