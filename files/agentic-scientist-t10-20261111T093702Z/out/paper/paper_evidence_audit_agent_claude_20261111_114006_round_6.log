nd, \"rep\": j})\n    for i, ep in enumerate(plan):\n        ep[\"seed\"] = SEEDS[0] if smoke else SEEDS[i % len(SEEDS)]\n    return plan\n\n\ndef reset_sequence(smoke):\n    return [ep[\"seed\"] for ep in make_plan(smoke)]\n\n\ndef episode_workload(ep, pools, perm_pools):\n    \"\"\"Deterministic evaluator-private draw for an episode. Returns dict of arrays and truth.\"\"\"\n    base, kind, rep = ep[\"base\"], ep[\"kind\"], ep[\"rep\"]\n    if base == \"synthetic\":\n        rng = np.random.default_rng([MASTER_SEED, 9999, rep])\n        j = rep\n15:  controls (const / perm / shift) are aggregated separately and enter only `correct` (gate).\n52:    \"plankton\": (\"plankton.npz\", \"Y_unlabeled\", \"Yhat_unlabeled\", 500, 20000),\n58:    \"plankton.npz\": \"b6e44b67805bd0f5df8e71a6ca5b1436e8bd6756a79de1c365de0e24788b00a1\",\n60:MAIN_FAMILIES = [\"census_income\", \"census_healthcare\", \"census_education\", \"plankton\", \"synthetic\"]\n61:CONTROL_BASES = [\"census_income\", \"plankton\"]\n75:              (\"plankton\", \"main\"), (\"synthetic\", \"main\"),\n76:              (\"census_income\", \"const\"), (\"census_income\", \"perm\"), (\"census_income\", \"shift\")]\n80:CONTROL_TYPES = [\"const\", \"perm\", \"shift\"]\n97:SHIFT_TOL = 0.10\n386:    \"\"\"Permute Yhat across pool records; reject vacuous permutations (redraw, bounded).\"\"\"\n391:        perm = rng.permutation(m)\n479:    if kind == \"shift\":\n480:        shift = 5.0 * pool[\"sd\"]\n481:        y = y + shift\n482:        yhat = yhat + shift\n483:        truth = truth + shift\n508:                # Exactly constant predictor: the tuning ratio is 0/0; PPI++ is its limit lam=0.\n716:            return json.loads(line, parse_constant=_reject_constant)\n721:def _reject_constant(token):\n722:    raise ValueError(\"non-finite JSON constant\")\n845:        if kind == \"shift\" and pairs:\n853:            ok = ok and float(np.mean(diffs)) <= SHIFT_TOL","is_error":false}]},"parent_tool_use_id":null,"session_