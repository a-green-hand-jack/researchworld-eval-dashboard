{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"head -55 paper.sty; sed -n '1,180p' .codex/skills/write-paper-standalone/scripts/validate_claims.py; cat .codex/skills/retrieve-references/templates/provenance.schema.json; sed -n '1,130p' task/prepare_data.py; sed -n '1,140p' .codex/skills/validate-paper/scripts/validate_tex_refs.py; ls -la ../investigation | head -25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"head -55 paper.sty; sed -n '1,180p' .codex/skills/write-paper-standalone/scripts/validate_claims.py; cat .codex/skills/retrieve-references/templates/provenance.schema.json; sed -n '1,130p' task/prepare_data.py; sed -n '1,140p' .codex/skills/validate-paper/scripts/validate_tex_refs.py; ls -la ../investigation | head -25\"","aggregated_output":"%%%% ICLR Macros (LaTex)\n%%%% Adapted by Hugo Larochelle from the NIPS stylefile Macros\n%%%% Style File\n%%%% Dec 12, 1990   Rev Aug 14, 1991; Sept, 1995; April, 1997; April, 1999; October 2014\n\n% This file can be used with Latex2e whether running in main mode, or\n% 2.09 compatibility mode.\n%\n% If using main mode, you need to include the commands\n%             \\documentclass{article}\n%             \\usepackage{iclr14submit_e,times}\n%\n\n% Change the overall width of the page.  If these parameters are\n%       changed, they will require corresponding changes in the\n%       maketitle section.\n%\n\\usepackage{eso-pic} % used by \\AddToShipoutPicture\n\\RequirePackage{fancyhdr}\n\\RequirePackage{natbib}\n\n% modification to natbib citations\n\\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}\n\n\\renewcommand{\\topfraction}{0.95}   % let figure take up nearly whole page\n\\renewcommand{\\textfraction}{0.05}  % let figure take up nearly whole page\n\n% Define iclrfinal, set to true if iclrfinalcopy is defined\n\\newif\\ificlrfinal\n\\iclrfinalfalse\n\\def\\iclrfinalcopy{\\iclrfinaltrue}\n\\font\\iclrtenhv  = phvb at 8pt\n\n% Specify the dimensions of each page\n\n\\setlength{\\paperheight}{11in}\n\\setlength{\\paperwidth}{8.5in}\n\n\n\\oddsidemargin .5in    %   Note \\oddsidemargin = \\evensidemargin\n\\evensidemargin .5in\n\\marginparwidth 0.07 true in\n%\\marginparwidth 0.75 true in\n%\\topmargin 0 true pt           % Nominal distance from top of page to top of\n%\\topmargin 0.125in\n\\topmargin -0.625in\n\\addtolength{\\headsep}{0.25in}\n\\textheight 9.0 true in       % Height of text (including footnotes & figures)\n\\textwidth 5.5 true in        % Width of text line.\n\\widowpenalty=10000\n\\clubpenalty=10000\n\n% \\thispagestyle{empty}        \\pagestyle{empty}\n\\flushbottom \\sloppy\n\n#!/usr/bin/env python3\n\"\"\"Validate generated claim-grounding artifacts before paper finalization.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nEVIDENCE_REF_RE = re.compile(r\"@evidence\\[\\[[^\\]]+\\]\\]\")\nTEX_INPUT_RE = re.compile(\n    r\"\\\\(?:input|include)(?![A-Za-z@])\\s*\"\n    r\"(?:\\{(?P<braced>[^{}]+)\\}|(?P<unbraced>[^\\s%{}]+))\"\n)\nTEX_IMPORT_COMMAND_RE = re.compile(r\"\\\\(?:input|include)(?![A-Za-z@])\")\nTEX_LOCAL_SUPPORT_RE = re.compile(\n    r\"\\\\(?P<command>usepackage|RequirePackage|documentclass|LoadClass)\"\n    r\"(?![A-Za-z@])(?:\\s*\\[[^\\]]*\\])?\\s*\\{(?P<targets>[^{}]+)\\}\"\n)\nTEX_LOCAL_SUPPORT_COMMAND_RE = re.compile(\n    r\"\\\\(?:usepackage|RequirePackage|documentclass|LoadClass)(?![A-Za-z@])\"\n)\nDYNAMIC_TEX_IMPORT_RE = re.compile(r\"\\\\csname\\s*(?:input|include)\\s*\\\\endcsname\")\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\if[a-zA-Z@]+\\b|\\\\else\\b|\\\\fi\\b\")\nVERBATIM_ENV_RE = re.compile(\n    r\"\\\\begin\\s*\\{(?P<env>verbatim\\*?|lstlisting|minted)\\}.*?\"\n    r\"\\\\end\\s*\\{(?P=env)\\}\",\n    re.DOTALL,\n)\nPROMPT_ARTIFACT_RE = re.compile(r\".+_prompt(?:_round_\\d+(?:_contract_retry_\\d+)?)?\\.md$\")\nGENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\n    \"validation_feedback.json\",\n    \"validation_feedback.md\",\n    \"verification-report.json\",\n}\nROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES = {\"validation_report.json\"}\nGENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES = (\n    \"paper_evidence_audit\",\n)\nEVIDENCE_BUNDLE_DIRNAME = \"scientific-evidence\"\nEVIDENCE_SCAN_SUFFIXES = (\n    \".tex\",\n    \".md\",\n    \".json\",\n    \".yaml\",\n    \".yml\",\n    \".py\",\n    \".sh\",\n    \".r\",\n    \".csv\",\n    \".tsv\",\n)\nEVIDENCE_SKIP_DIR_NAMES = {\n    \".git\",\n    \"__pycache__\",\n    EVIDENCE_BUNDLE_DIRNAME,\n}\nAGENT_SKILL_DIR_PREFIXES = (\n    (\".claude\", \"skills\"),\n    (\".codex\", \"skills\"),\n    (\".cursor\", \"skills\"),\n    (\".opencode\", \"skills\"),\n    (\".gemini\", \"skills\"),\n    (\".pi\", \"agent\", \"skills\"),\n)\nVERIFICATION_SUMMARY_KEYS = (\n    \"total_references\",\n    \"resolved_references\",\n    \"anchored_references\",\n    \"dangling_references\",\n    \"manifests_checked\",\n)\nSCIENTIFIC_EVIDENCE_SCRIPT = (\n    Path(__file__).resolve().parent.parent.parent\n    / \"scientific-evidence\"\n    / \"scripts\"\n    / \"scientific_evidence.py\"\n)\n\n\ndef read_json(path: Path) -> dict[str, Any]:\n    \"\"\"Read JSON data from disk when available.\"\"\"\n    try:\n        payload = json.loads(path.read_text(encoding=\"utf-8\"))\n    except json.JSONDecodeError as exc:\n        raise SystemExit(f\"Invalid JSON in {path}: {exc}\") from exc\n    if not isinstance(payload, dict):\n        raise SystemExit(f\"Expected JSON object in {path}\")\n    return payload\n\n\ndef read_bib_keys(path: Path) -> set[str]:\n    \"\"\"Read bib keys.\"\"\"\n    text = path.read_text(encoding=\"utf-8\")\n    return {match.group(1).strip() for match in KEY_RE.finditer(text) if match.group(1).strip()}\n\n\ndef validate_reference_provenance(*, references_payload: dict[str, Any], bib_keys: set[str]) -> tuple[set[str], list[str]]:\n    \"\"\"Validate references_provenance.json against references.bib.\"\"\"\n    errors: list[str] = []\n    refs = references_payload.get(\"references\")\n    if not isinstance(refs, list):\n        return set(), [\"references_provenance.json must contain a `references` list.\"]\n\n    provenance_keys: set[str] = set()\n    provenance_ids: set[str] = set()\n    for idx, row in enumerate(refs):\n        if not isinstance(row, dict):\n            errors.append(f\"references[{idx}] must be object\")\n            continue\n        source_id = row.get(\"id\")\n        if not isinstance(source_id, str) or not source_id.strip():\n            errors.append(f\"references[{idx}].id missing\")\n        else:\n            if source_id in provenance_ids:\n                errors.append(f\"references[{idx}].id duplicates existing id: {source_id!r}\")\n            provenance_ids.add(source_id)\n\n        citation_key = row.get(\"citation_key\")\n        if not isinstance(citation_key, str) or not citation_key.strip():\n            errors.append(f\"references[{idx}].citation_key missing\")\n            continue\n        if citation_key in provenance_keys:\n            errors.append(\n                f\"references[{idx}].citation_key duplicates existing key: {citation_key!r}\"\n            )\n        provenance_keys.add(citation_key)\n\n    missing_in_provenance = sorted(bib_keys - provenance_keys)\n    if missing_in_provenance:\n        errors.append(\n            \"references.bib keys missing from references_provenance.json: \"\n            + \", \".join(repr(key) for key in missing_in_provenance)\n        )\n\n    missing_in_bib = sorted(provenance_keys - bib_keys)\n    if missing_in_bib:\n        errors.append(\n            \"references_provenance.json keys missing from references.bib: \"\n            + \", \".join(repr(key) for key in missing_in_bib)\n        )\n\n    return provenance_ids, errors\n\n\ndef is_excluded_evidence_scan_path(path: Path, *, paper_dir: Path) -> bool:\n    \"\"\"Return True for operational artifacts that should not enter evidence scans.\"\"\"\n    rel_parts = path.relative_to(paper_dir).parts\n    if any(rel_parts[: len(prefix)] == prefix for prefix in AGENT_SKILL_DIR_PREFIXES):\n        return True\n    if any(part in EVIDENCE_SKIP_DIR_NAMES for part in rel_parts):\n        return True\n    if len(rel_parts) == 1 and rel_parts[0] in ROOT_GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES:\n        return True\n    if path.name in GENERATED_EVIDENCE_SCAN_ARTIFACT_NAMES:\n        return True\n    if any(path.name.startswith(prefix) for prefix in GENERATED_EVIDENCE_SCAN_ARTIFACT_PREFIXES):\n        return True\n    return bool(PROMPT_ARTIFACT_RE.fullmatch(path.name))\n\n\ndef strip_tex_comments(tex_text: str) -> str:\n    \"\"\"Remove LaTeX comments while preserving escaped percent signs.\"\"\"\n    cleaned_lines: list[str] = []\n    for line in tex_text.splitlines():\n        comment_at = len(line)\n        index = 0\n        while index < len(line):\n            if line.startswith(r\"\\verb\", index):\n                delimiter_index = index + len(r\"\\verb\")\n                if delimiter_index < len(line) and line[delimiter_index] == \"*\":\n                    delimiter_index += 1\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"ReferenceProvenance\",\n  \"type\": \"object\",\n  \"required\": [\"generated_at\", \"count\", \"queries\", \"references\"],\n  \"properties\": {\n    \"generated_at\": {\"type\": \"string\"},\n    \"count\": {\"type\": \"integer\", \"minimum\": 0},\n    \"queries\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\"}\n    },\n    \"references\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"id\", \"paper_id\", \"citation_key\", \"query\", \"source_url\"],\n        \"properties\": {\n          \"id\": {\"type\": \"string\"},\n          \"paper_id\": {\"type\": \"string\"},\n          \"citation_key\": {\"type\": \"string\"},\n          \"title\": {\"type\": [\"string\", \"null\"]},\n          \"year\": {\"type\": [\"integer\", \"null\"]},\n          \"venue\": {\"type\": [\"string\", \"null\"]},\n          \"citation_count\": {\"type\": [\"integer\", \"null\"]},\n          \"query\": {\"type\": \"string\"},\n          \"source_url\": {\"type\": \"string\"},\n          \"retrieved_at\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n\"\"\"Pinned, offline-capable preparation: python prepare_data.py --arena data/train.csv --nba data/nbaallelo.csv.\nRaw downloads stay outside the submission; this deterministic script records all derived provenance.\n\"\"\"\nimport argparse\nimport csv\nimport hashlib\nimport json\nimport pathlib\nimport unicodedata\nfrom collections import defaultdict\n\nSOURCES = {\n    \"arena\": (\"18c298340948c0e7f7727399fd459cca6ce0ca6f\", \"0692154aaf20fc6649090c3f49b6b5dd1e693a765ecb5f0856ae0da5946f5be2\"),\n    \"nba\": (\"4c1ff5e3aef1816ae04af63218015066e186c147\", \"d46ed3540ee8d9eca31b3e94cc8c777e0be5156173d814ebf65b8195e8d616bc\"),\n}\n\n\ndef canonical(value):\n    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False)\n\n\ndef digest(value):\n    return hashlib.sha256(canonical(value).encode()).hexdigest()\n\n\ndef normalize(value, strict=False):\n    if isinstance(value, str):\n        value = unicodedata.normalize(\"NFKC\" if strict else \"NFC\", value.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\"))\n        return \" \".join(value.split()) if strict else value\n    if isinstance(value, list):\n        return [normalize(item, strict) for item in value]\n    return value\n\n\ndef prepare(arena_path, nba_path, root):\n    for name, path in ((\"arena\", arena_path), (\"nba\", nba_path)):\n        if hashlib.sha256(path.read_bytes()).hexdigest() != SOURCES[name][1]:\n            raise ValueError(\"source checksum mismatch: \" + name)\n    csv.field_size_limit(16 * 1024 * 1024)\n    arena, parent, owners = [], [], {}\n\n    def find(index):\n        while parent[index] != index:\n            parent[index] = parent[parent[index]]\n            index = parent[index]\n        return index\n\n    with arena_path.open(newline=\"\", encoding=\"utf-8\") as stream:\n        for source_row, row in enumerate(csv.DictReader(stream), 2):\n            model_a, model_b = row[\"model_a\"], row[\"model_b\"]\n            flags = [int(row[key]) for key in (\"winner_model_a\", \"winner_model_b\", \"winner_tie\")]\n            if sum(flags) != 1 or model_a == model_b:\n                continue\n            outcome = 1.0 if flags[0] else 0.0 if flags[1] else 0.5\n            prompt, answer_a, answer_b = [json.loads(row[key]) for key in (\"prompt\", \"response_a\", \"response_b\")]\n            hashes = set()\n            for strict in (False, True):\n                documents = [normalize(doc, strict) for doc in (prompt, answer_a, answer_b)]\n                hashes.update(digest(doc) for doc in documents if any(str(item).strip() for item in doc))\n                left = [model_a, documents[1]]\n                right = [model_b, documents[2]]\n                if canonical(left) > canonical(right):\n                    left, right, mapped = right, left, 1 - outcome\n                else:\n                    mapped = outcome\n                hashes.add(digest([documents[0], left, right, mapped]))\n            index = len(arena)\n            parent.append(index)\n            for content_hash in sorted(hashes):\n                if content_hash in owners:\n                    parent[find(index)] = find(owners[content_hash])\n                else:\n                    owners[content_hash] = index\n            arena.append({\"source_id\": row[\"id\"], \"source_row\": source_row, \"a\": model_a, \"b\": model_b,\n                          \"y\": outcome, \"z\": 0.0, \"hashes\": sorted(hashes)})\n    members = defaultdict(list)\n    for index in range(len(arena)):\n        members[find(index)].append(index)\n    panels = {\"search\": {\"arena\": []}, \"final\": {\"arena\": []}}\n    for indices in members.values():\n        group = min(content_hash for index in indices for content_hash in arena[index][\"hashes\"])\n        plane = \"search\" if int(hashlib.sha256((\"split-v1:\" + group).encode()).hexdigest(), 16) % 4 == 0 else \"final\"\n        for index in indices:\n            arena[index][\"group\"] = group\n            panels[plane][\"arena\"].append(arena[index])\n    games = defaultdict(list)\n    with nba_path.open(newline=\"\", encoding=\"utf-8\") as stream:\n        for source_row, row in enumerate(csv.DictReader(stream), 2):\n            if int(row[\"year_id\"]) in (2006, 2007, 2008, 2011, 2012, 2013, 2014, 2015):\n                games[row[\"game_id\"]].append((source_row, row))\n    exclusions = []\n    for identity, rows in sorted(games.items()):\n        primary = [item for item in rows if item[1][\"_iscopy\"] == \"0\"]\n        if len(primary) != 1 or len(rows) != 2:\n            exclusions.append([identity, \"incomplete_reciprocal\", int(rows[0][1][\"year_id\"])])\n            continue\n        source_row, row = primary[0]\n        other = next(item[1] for item in rows if item[1][\"_iscopy\"] == \"1\")\n        if not (row[\"team_id\"] == other[\"opp_id\"] and row[\"opp_id\"] == other[\"team_id\"]\n                and row[\"pts\"] == other[\"opp_pts\"] and row[\"opp_pts\"] == other[\"pts\"]):\n            raise ValueError(\"inconsistent reciprocal game\")\n        year = int(row[\"year_id\"])\n        plane = \"search\" if year < 2010 else \"final\"\n        teams = sorted([row[\"team_id\"], row[\"opp_id\"]])\n        scores = {row[\"team_id\"]: int(row[\"pts\"]), row[\"opp_id\"]: int(row[\"opp_pts\"])}\n        location = {\"H\": 1.0, \"A\": -1.0, \"N\": 0.0}[row[\"game_location\"]]\n        home = row[\"team_id\"] if location == 1 else row[\"opp_id\"] if location == -1 else None\n        raw = [row[\"date_game\"], year, teams, [scores[team] for team in teams], home, row[\"is_playoffs\"]]\n        content_hash = digest(raw)\n        example_hash = digest([teams, [scores[team] for team in teams], row[\"date_game\"], home])\n        record = {\"source_id\": identity, \"source_row\": source_row, \"reciprocal_rows\": [item[0] for item in rows],\n                  \"a\": row[\"team_id\"], \"b\": row[\"opp_id\"], \"y\": float(int(row[\"pts\"]) > int(row[\"opp_pts\"])),\n                  \"z\": location, \"hashes\": [content_hash, example_hash], \"group\": content_hash}\n        panels[plane].setdefault(\"nba-\" + str(year), []).append(record)\n    sets = {plane: {content_hash for records in cases.values() for row in records for content_hash in row[\"hashes\"]}\n            for plane, cases in panels.items()}\n    if sets[\"search\"] & sets[\"final\"]:\n        raise ValueError(\"normalized raw document/example overlap\")\n    ids = {plane: {row[\"source_id\"] for cases in panels[plane].values() for row in cases} for plane in panels}\n    if ids[\"search\"] & ids[\"final\"]:\n        raise ValueError(\"source ID overlap\")\n    for plane, cases in panels.items():\n        destination = root / \"resources\" / plane\n        destination.mkdir(parents=True, exist_ok=True)\n        manifest = {\"normalization\": \"v1 NFC line endings preserve case/whitespace; additional NFKC whitespace-collapsed audit; JSON parsed before hashing; swapped example canonicalization; transitive document groups\",\n                    \"sources\": SOURCES, \"content_disjoint\": True, \"source_disjoint\": True,\n                    \"hash_count\": len(sets[plane]), \"group_rule\": \"sha256(split-v1:minimum-content-hash) modulo 4 equals 0 for search\",\n                    \"nba_exclusions\": [item for item in exclusions if (item[2] < 2010) == (plane == \"search\")], \"cases\": {}}\n        for case, records in cases.items():\n            records.sort(key=lambda row: row[\"source_row\"])\n#!/usr/bin/env python3\n\"\"\"Validate that paper citations align with bibliography entries.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport re\nfrom pathlib import Path\n\nSECTION_PATTERNS = {\n    \"abstract\": re.compile(\n        r\"\\\\begin\\{abstract\\}|\\\\section\\*?\\{[^}]*abstract[^}]*\\}\",\n        re.IGNORECASE,\n    ),\n    \"introduction\": re.compile(r\"\\\\section\\*?\\{[^}]*introduction[^}]*\\}\", re.IGNORECASE),\n    \"related work\": re.compile(r\"\\\\section\\*?\\{[^}]*related work[^}]*\\}\", re.IGNORECASE),\n    \"method\": re.compile(r\"\\\\section\\*?\\{[^}]*method[^}]*\\}\", re.IGNORECASE),\n    \"results\": re.compile(r\"\\\\section\\*?\\{[^}]*results[^}]*\\}\", re.IGNORECASE),\n    \"conclusion\": re.compile(r\"\\\\section\\*?\\{[^}]*conclusion[^}]*\\}\", re.IGNORECASE),\n    \"references\": re.compile(\n        r\"\\\\bibliography\\{|\\\\printbibliography|\\\\begin\\{thebibliography\\}|\\\\section\\*?\\{[^}]*references[^}]*\\}\",\n        re.IGNORECASE,\n    ),\n}\nCITE_RE = re.compile(r\"\\\\cite[a-zA-Z*]*\\{([^}]+)\\}\")\nKEY_RE = re.compile(r\"@\\w+\\{([^,]+),\")\nSUPPLEMENT_HEADING_RE = re.compile(\n    r\"\\\\section\\s*\\{\\s*supplementary\\s+information\\s*\\}\",\n    re.IGNORECASE,\n)\nBIBLIOGRAPHY_RE = re.compile(\n    r\"\\\\bibliography\\s*\\{[^}]+\\}|\\\\printbibliography\\b(?:\\[[^\\]]*\\])?\"\n    r\"|\\\\begin\\s*\\{thebibliography\\}\",\n    re.IGNORECASE,\n)\nCLEARPAGE_RE = re.compile(r\"\\\\clearpage\\b\", re.IGNORECASE)\nNEXT_SECTION_RE = re.compile(r\"\\\\section\\*?\\s*(?:\\[[^\\[\\]]*\\]\\s*)?\\{\")\nLET_SECTION_ALIAS_RE = re.compile(\n    r\"\\\\let\\s*\\\\[a-zA-Z@]+\\s*=?\\s*\\\\section\\b\", re.IGNORECASE\n)\nNEWCOMMAND_DEFINITION_RE = re.compile(\n    r\"\\\\(?:newcommand|renewcommand)\\*?\\s*\\{\", re.IGNORECASE\n)\nDEF_DEFINITION_RE = re.compile(\n    r\"\\\\(?:def|gdef|edef|xdef)\\s*\\\\[a-zA-Z@]+\", re.IGNORECASE\n)\nTEX_IMPORT_RE = re.compile(r\"\\\\(?:input|include)\\b\", re.IGNORECASE)\nSUBSTANTIVE_SUPPLEMENT_RE = re.compile(\n    r\"\\\\subsection\\*?\\s*\\{|\\\\begin\\s*\\{(?:table|figure)\\*?\\}\",\n    re.IGNORECASE,\n)\nSUPPLEMENT_PLACEHOLDER_TEXTS = (\n    \"add supplementary material only when grounded artifacts support it\",\n    \"replace with grounded extended methods, reproducibility details, additional analyses, or supporting tables and figures\",\n)\nCONDITIONAL_TOKEN_RE = re.compile(r\"\\\\[a-zA-Z@]+\")\nNEWIF_RE = re.compile(r\"\\\\newif\\s*(?P<name>\\\\if[a-zA-Z@]+)\")\nCONDITIONAL_OPENERS = frozenset(\n    {\n        r\"\\if\",\n        r\"\\ifcase\",\n        r\"\\ifcat\",\n        r\"\\ifcondition\",\n        r\"\\ifcsname\",\n        r\"\\ifdefined\",\n        r\"\\ifdim\",\n        r\"\\ifeof\",\n        r\"\\iffalse\",\n        r\"\\iffontchar\",\n        r\"\\ifhbox\",\n        r\"\\ifhmode\",\n        r\"\\ifincsname\",\n        r\"\\ifinner\",\n        r\"\\ifluatex\",\n        r\"\\ifmmode\",\n        r\"\\ifnum\",\n        r\"\\ifodd\",\n        r\"\\ifpdf\",\n        r\"\\ifpdfabsdim\",\n        r\"\\ifpdfabsnum\",\n        r\"\\ifpdfprimitive\",\n        r\"\\iftrue\",\n        r\"\\ifvbox\",\n        r\"\\ifvmode\",\n        r\"\\ifvoid\",\n        r\"\\ifx\",\n        r\"\\ifxetex\",\n    }\n)\nNON_CONDITIONAL_IF_MACROS = frozenset(\n    {\n        r\"\\ifblank\",\n        r\"\\ifbool\",\n        r\"\\ifboolexpr\",\n        r\"\\ifcsdef\",\n        r\"\\ifcsempty\",\n        r\"\\ifcsequal\",\n        r\"\\ifcsmacro\",\n        r\"\\ifcsparam\",\n        r\"\\ifcsprotected\",\n        r\"\\ifcsstring\",\n        r\"\\ifcsundef\",\n        r\"\\ifcsvoid\",\n        r\"\\ifdimcomp\",\n        r\"\\ifdimequal\",\n        r\"\\ifdimgreater\",\n        r\"\\ifdimless\",\n        r\"\\ifdef\",\n        r\"\\ifdefempty\",\n        r\"\\ifdefequal\",\n        r\"\\ifdefltxprotect\",\n        r\"\\ifdefmacro\",\n        r\"\\ifdefparam\",\n        r\"\\ifdefprotected\",\n        r\"\\ifdefstring\",\n        r\"\\ifdefvoid\",\n        r\"\\iflanguage\",\n        r\"\\ifltxcount\",\n        r\"\\ifltxcounter\",\n        r\"\\ifnumcomp\",\n        r\"\\ifnumequal\",\n        r\"\\ifnumgreater\",\n        r\"\\ifnumless\",\n        r\"\\ifstrequal\",\n        r\"\\ifstrempty\",\n        r\"\\ifthenelse\",\n        r\"\\iftoggle\",\n        r\"