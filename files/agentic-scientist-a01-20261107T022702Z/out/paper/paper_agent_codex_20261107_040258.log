{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/bin/sh -lc \"rg -n 'def .*greedy|greedy|node|milp|target.*select|work_seconds' task/evaluate.py | head -30; head -45 task/evaluate_final.py; sed -n '1,80p' task/resources/search/acquire.py | tail -10; sed -n '80,150p' task/resources/search/acquire.py\"","aggregated_output":"35:from scipy.optimize import Bounds, LinearConstraint, milp\n648:            result = milp(np.ones(count), integrality=np.ones(count), bounds=Bounds(0, 1), constraints=constraints,\n665:        if name in ('greedy', 'reference'):\n677:    for name in ('none', 'random', 'greedy', 'reference'):\n679:        deadline = begin + request['work_seconds']\n696:        request = {'matrix': matrix.tolist(), 'targets': targets, 'fractions': fractions, 'seed': seed, 'work_seconds': work}\n698:        if type(result) is not dict or set(result) != {'methods'} or [item['name'] for item in result['methods']] != ['none', 'random', 'greedy', 'reference']:\n741:def positive_work_seconds(value):\n754:        work = positive_work_seconds(profile['work_seconds'])\n762:def reserved_method_deadline(*, now, episode_deadline, methods_remaining, work_seconds, cleanup_seconds):\n765:    work = positive_work_seconds(work_seconds)\n796:                    timeout = min(timeout, request['work_seconds'])\n846:                               finish_seconds=20, work_seconds=work)\n870:                                 work_seconds=work, cleanup_seconds=1)\n883:                                                   methods_remaining=0, work_seconds=work, cleanup_seconds=1)\n885:                         'cap_fractions': fractions, 'tolerance': TOLERANCE, 'work_seconds': work})\n\"\"\"Offline, evaluator-owned counterfactual investment benchmark.\n\nRuntime: Linux x86_64, CPython 3.12, one evaluator and one candidate CPU thread.\nScientific soundness, search eligibility, and publication claims are distinct.\nNo superiority threshold is an eligibility gate. See the frozen plane plan.\n\"\"\"\n\nimport time\nSTART = time.monotonic()\nimport argparse\nimport base64\nimport collections\nimport contextlib\nimport decimal\nimport hashlib\nimport importlib.util\nimport itertools\nimport json\nimport math\nimport os\nimport pathlib\nimport re\nimport resource\nimport selectors\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport unicodedata\n\nfor thread_name in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):\n    os.environ[thread_name] = '1'\nimport numpy as np\nfrom scipy.optimize import Bounds, LinearConstraint, milp\nfrom scipy.stats import rankdata\n\nPLANE = 'final'\nSEEDS = [42011, 42013, 42017]\nTARGET_COUNT = 8\nWALL_SECONDS = 1800\nRPC_BUDGET = 525\nRESOURCE_HASHES = {'helm': '8fd2ddf4a665fc82af56cda4abacc2d122357334a934c92e309c8a3809254906', 'openllm': 'a81323ea4cb07f55e4897073c5917a70c8b6cfc808b33c6232b88c9bb6588384'}\nPLAN_HASH = '3a5b6d7b8a6170437d90407f9f2239d3c71bfb6255c47e3af41a31d6e70d2236'\nWIRE_LIMIT = 64 * 1024 * 1024\n    counts[family] = {'source_rows': len(rows), 'eligible_rows': len(eligible), 'excluded_rows': len(rows) - len(eligible)}\n    records.extend(eligible)\nparents = list(range(len(records)))\ndef find(index):\n    while parents[index] != index:\n        parents[index] = parents[parents[index]]\n        index = parents[index]\n    return index\ndef model_alias(value):\n    value = canonical(value).lower()\n    value = canonical(value).lower()\n    if '/' not in value and '_' in value:\n        value = value.replace('_', '/', 1)\n    if value.startswith('meta/'):\n        value = 'meta-llama/' + value[len('meta/'):]\n    if value.endswith('-turbo'):\n        value = value[:-len('-turbo')]\n    if value.startswith('meta-llama/') and value.endswith('-hf'):\n        value = value[:-len('-hf')]\n    return value\nseen = {}\nfor index, row in enumerate(records):\n    aliases = ['hash:' + row['raw_hash'], 'id:' + canonical(row['id']).lower(), 'model:' + model_alias(row['id'])]\n    for alias in row.get('aliases', []):\n        if alias and canonical(alias).lower() not in ('none', 'unknown', 'n/a'):\n            aliases.extend(['alias:' + canonical(alias).lower(), 'id:' + canonical(alias).lower(), 'model:' + model_alias(alias)])\n    row['model_aliases'] = sorted(set(aliases))\n    for alias in aliases:\n        if alias in seen:\n            parents[find(index)] = find(seen[alias])\n        else:\n            seen[alias] = index\ngroups = {}\nfor index, row in enumerate(records):\n    groups.setdefault(find(index), []).append(row)\npartitions = {'search': {'helm': [], 'openllm': []}, 'final': {'helm': [], 'openllm': []}}\nfor group in groups.values():\n    cluster = hashlib.sha256(('split-20261027:' + min(row['raw_hash'] for row in group)).encode()).hexdigest()\n    plane = 'search' if int(cluster[:16], 16) / 2**64 < .4 else 'final'\n    for row in group:\n        row['cluster'] = cluster\n        partitions[plane][row['family']].append(row)\nsearch_hashes = {row['raw_hash'] for family in partitions['search'].values() for row in family}\nfinal_hashes = {row['raw_hash'] for family in partitions['final'].values() for row in family}\nassert not search_hashes & final_hashes\nfor row in records:\n    tasks, _, scale = families[row['family']]\n    row['scores'] = [row['raw'][task] / scale for task in tasks]\nfor plane, family_rows in partitions.items():\n    directory = ROOT / plane\n    directory.mkdir(parents=True, exist_ok=True)\n    for family, rows in family_rows.items():\n        unique = {}\n        for row in sorted(rows, key=lambda row: (row['raw_hash'], row['id'])):\n            if row['raw_hash'] not in unique:\n                unique[row['raw_hash']] = row\n            else:\n                unique[row['raw_hash']]['provenance'].extend(row['provenance'])\n        payload = {'schema_version': 1, 'family': family, 'tasks': families[family][0], 'scale': families[family][2], 'rows': list(unique.values()), 'source_counts': counts[family], 'duplicate_rows_collapsed': len(rows) - len(unique), 'split': {'seed': 20261027, 'algorithm': 'NFKC whitespace/Decimal stable raw-score hashes; union exact content, fullname, known base model and model-sha aliases before hash-threshold 40/60 assignment', 'cross_plane_raw_overlap': 0, 'cross_plane_cluster_overlap': 0}, 'license': 'No separate score-data license declared by source; public research analysis with attribution. Code/per-model licenses do not license these data. Redistribution permission uncertain; frozen minimal score excerpts for isolated research runtime. Reacquire via source URLs for reproduction; seek permission before public redistribution.', 'acquired_utc': '2026-11-07'}\n        (directory / (family + '.json')).write_text(json.dumps(payload, ensure_ascii=False, allow_nan=False, separators=(',', ':')) + '\\n')\n        print(plane, family, len(unique), len(families[family][0]), counts[family])\nprint('raw_overlap', len(search_hashes & final_hashes))\n","exit_code":0,"status":"completed"}}
