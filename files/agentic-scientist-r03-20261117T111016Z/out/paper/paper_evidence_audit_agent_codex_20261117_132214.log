{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"jq 'keys' literature_evidence/MTEB.json; jq 'keys' references_provenance.json; jq '{ok,feedback,evidence_validation,supplementary_information_validation}' validation_report.json; jq 'keys' source_evidence_manifest.json; sed -n '77,125p' build_paper_artifacts.py; sed -n '1020,1065p' source_evidence/evaluate_final.py\"","aggregated_output":"[\n  \"abstract_inverted_index\",\n  \"authorships\",\n  \"biblio\",\n  \"display_name\",\n  \"doi\",\n  \"id\",\n  \"primary_location\",\n  \"publication_date\",\n  \"publication_year\",\n  \"referenced_works\",\n  \"retrieval_url\",\n  \"title\",\n  \"type\"\n]\n[\n  \"count\",\n  \"generated_at\",\n  \"queries\",\n  \"references\"\n]\n{\n  \"ok\": true,\n  \"feedback\": {\n    \"figure_validation_errors\": [],\n    \"figure_validation_warnings\": [],\n    \"language_validation_warnings\": []\n  },\n  \"evidence_validation\": {\n    \"bundle_path\": \"work/results/r03/codex/20261117_111425/paper/scientific-evidence\",\n    \"bundle_present\": true,\n    \"checked\": true,\n    \"dangling\": [],\n    \"hard_errors\": [],\n    \"paper_token_count\": 166,\n    \"summary\": {\n      \"anchored_references\": 79,\n      \"dangling_references\": 0,\n      \"manifests_checked\": 15,\n      \"resolved_references\": 125,\n      \"total_references\": 204\n    },\n    \"verification_report_path\": \"work/results/r03/codex/20261117_111425/paper/scientific-evidence/verification-report.json\"\n  },\n  \"supplementary_information_validation\": {\n    \"appendix_present\": true,\n    \"checked\": true,\n    \"clearpage_present\": true,\n    \"hard_errors\": [],\n    \"heading_present\": true,\n    \"placed_after_references\": true,\n    \"pre_bibliography_clearpage_present\": true,\n    \"rendered_checked\": true,\n    \"rendered_heading_present\": true,\n    \"rendered_visible_character_count\": 9922,\n    \"substantive_element_count\": 9,\n    \"supplement_pages\": 3,\n    \"supplement_start_page\": 11,\n    \"visible_character_count\": 9623\n  }\n}\n[\n  \"evaluator_original\",\n  \"files\",\n  \"original_predictor\",\n  \"resources_original\",\n  \"selected_original\"\n]\n        axis.grid(axis='y', alpha=.16)\n    axes[0].set_ylabel('Sealed-target MAE')\n    handles, labels = axes[0].get_legend_handles_labels()\n    figure.legend(handles, labels, loc='lower center', ncol=2, frameon=False, columnspacing=1.1)\n    figure.subplots_adjust(left=.12, right=.98, bottom=.37, top=.87, wspace=.12)\n    save_plot(figure, 'budget_comparison')\n    figure, axis = plt.subplots(figsize=(4.95, 1.95))\n    for offset, method in zip([-.12, 0, .12], [5, 0, 3]):\n        means = [arrays[case][:, method].mean() for case in ['A', 'C', 'D']]\n        deviation = [arrays[case][:, method].mean(axis=1).std(ddof=1) for case in ['A', 'C', 'D']]\n        axis.errorbar(np.arange(3) + offset, means, yerr=deviation, color=COLORS[method], marker='o', capsize=3, linestyle='none', markersize=5, label=METHODS[method])\n    axis.set(xticks=range(3), xticklabels=['Intact', 'Constant', 'Column-shifted'], ylabel='Sealed-target MAE', ylim=(.025, .082))\n    axis.grid(axis='y', alpha=.16)\n    figure.legend(loc='lower center', ncol=3, frameon=False, columnspacing=.7, handletextpad=.3)\n    figure.subplots_adjust(left=.14, right=.98, bottom=.30, top=.95)\n    save_plot(figure, 'history_structure_controls')\n    create_overview_placeholder()\n    create_manifest()\n\n\ndef resample_bounds(episodes):\n    \"\"\"@evidence[[source_evidence/evaluate_final.py#L999-L1017]]\"\"\"\n    groups = sorted({group for episode in episodes for case in ['A', 'B'] for group in episode['solution']['cases'][case]['resampling_components']})\n    group_index = {group: index for index, group in enumerate(groups)}\n    rng = np.random.default_rng(424242)\n    samples = np.zeros((400, 5))\n    for resample in range(len(samples)):\n        multiplicity = np.bincount(rng.integers(len(groups), size=len(groups)), minlength=len(groups))\n        for episode in episodes:\n            for case in ['A', 'B']:\n                condition = episode['solution']['cases'][case]\n                weights = np.asarray([multiplicity[group_index[group]] for group in condition['resampling_components']], dtype=float)\n                if weights.sum() == 0:\n                    samples[resample] -= np.ones(5) / (2 * len(episodes))\n                else:\n                    gains = np.asarray(condition['baseline_mae_by_method_row_checkpoint']).mean(axis=2) - np.asarray(condition['mae_by_row_checkpoint']).mean(axis=1)\n                    samples[resample] += gains @ weights / weights.sum() / (2 * len(episodes))\n    return np.quantile(samples, [.005, .995], axis=0)\n\n\ndef create_tables(summary):\n    evidence = '% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\\n'\n    lines = [evidence, r'\\begin{tabular}{lrrr}', r'\\toprule', r'Estimator & Model holdout & Family holdout & Overall \\\\', r'\\midrule']\n    for index, method in enumerate(METHODS):\n        means = [summary['cases'][case]['mean'][index] for case in ['A', 'B']] + [summary['primary_mean'][index]]\n        lines.append(method + ' & ' + ' & '.join(f'{value:.5f}' for value in means) + r' \\\\')\n    lines.extend([r'\\bottomrule', r'\\end{tabular}'])\n    Path('tables/main_comparison.tex').write_text('\\n'.join(lines) + '\\n')\n    lines = [evidence, r'\\begin{tabular}{llrrrr}', r'\\toprule', r'Holdout & Estimator & $k=1$ & $k=2$ & $k=4$ & $k=8$ \\\\', r'\\midrule']\ndef make_evaluation_evidence(episodes, outcomes, rows, seeds):\n    records = []\n    for seed in seeds:\n        indices = [index for index, episode in enumerate(episodes) if episode['seed']==seed and not episode['replay']]\n        scored = [index for index in indices if episodes[index]['case'] in ['A', 'B']]\n        solution = {'cases': {}}\n        for index in indices:\n            outcome, episode = outcomes[index], episodes[index]\n            solution['cases'][episode['case']] = {\n                'completed': outcome['complete'], 'mae_by_row_checkpoint': outcome['mae'].tolist(),\n                'all_unqueried_mae_by_row_checkpoint': outcome['all_unqueried_mae'].tolist(),\n                'baseline_mae_by_method_row_checkpoint': outcome['baselines'].tolist(),\n                'selected_indices': outcome['queries'],\n                'observed_counts': [sum(value is not None for value in rows[row]['values']) for row in episode['test']],\n                'resampling_components': [rows[row]['component'] for row in episode['test']]}\n        seed_correct = all(outcomes[index]['complete'] for index, episode in enumerate(episodes) if episode['seed']==seed)\n        if seed == episodes[0]['seed']:\n            original, replay = outcomes[0], outcomes[-1]\n            seed_correct = bool(seed_correct and original['queries'] == replay['queries']\n                                and original['predictions'] is not None and replay['predictions'] is not None\n                                and np.max(np.abs(np.asarray(original['predictions'])-np.asarray(replay['predictions']))) <= 1e-10)\n        records.append({'seed': seed, 'score': 1-fixed_average([float(outcomes[index]['mae'].mean()) for index in scored]),\n                        'correct': seed_correct,\n                        'duration_seconds': sum(outcomes[index]['duration'] for index, episode in enumerate(episodes) if episode['seed']==seed),\n                        'solution': solution})\n    return {'schema_version': 1, 'episodes': records}\n\n\ndef write_outputs(directory, metrics, correct, feasible, evidence=None):\n    directory = pathlib.Path(directory)\n    directory.mkdir(parents=True, exist_ok=True)\n    if set(metrics) != set(METRIC_NAMES) or any(type(value) not in (float, int) or not math.isfinite(value) for value in metrics.values()):\n        raise RuntimeError('metric schema violation')\n    objects = {'metrics.json': metrics, 'correct.json': {'correct': bool(correct)}}\n    if os.environ.get('AGENTIC_TASK_QUALIFICATION') == '1':\n        objects['qualification.json'] = {'schema_version': 1, 'feasible': bool(feasible)}\n    if evidence is not None:\n        serialized = bounded_json_line(evidence)\n        if len(serialized) >= 16 * 1024**2:\n            raise RuntimeError('evidence size exceeded')\n        objects['evaluation_evidence.json'] = evidence\n    for name, value in objects.items():\n        destination = directory / name\n        temporary = directory / (name + '.tmp')\n        temporary.write_bytes(json.dumps(value, allow_nan=False, separators=(',', ':')).encode() + b'\\n')\n        temporary.replace(destination)\n","exit_code":0,"status":"completed"}}
