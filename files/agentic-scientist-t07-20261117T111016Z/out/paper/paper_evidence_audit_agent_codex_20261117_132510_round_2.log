ables/case_budget.tex.prov.json\",\n      \"target\": \"tables/case_budget.tex\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[analysis/paper_statistics.json]]\",\n      \"resolved_path\": \"analysis/paper_statistics.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/case_budget.tex.prov.json\",\n      \"target\": \"analysis/paper_statistics.json\"\n    },\n    {\n      \"messages\": [\n        \"generated_by.script_path exists.\"\n      ],\n      \"raw_reference\": \"<generated_by.script_path>\",\n      \"resolved_path\": \"scripts/build_paper_artifacts.py\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/case_budget.tex.prov.json\",\n      \"target\": \"scripts/build_paper_artifacts.py\"\n    },\n    {\n      \"messages\": [\n        \"Manifest artifact.path exists.\"\n      ],\n      \"raw_reference\": \"<artifact.path>\",\n      \"resolved_path\": \"tables/seeds.tex\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/seeds.tex.prov.json\",\n      \"target\": \"tables/seeds.tex\"\n    },\n    {\n      \"hash_checked\": true,\n      \"messages\": [\n        \"Recorded sha256 matches file contents.\"\n      ],\n      \"raw_reference\": \"<artifact.sha256>\",\n      \"resolved_path\": \"tables/seeds.tex\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/seeds.tex.prov.json\",\n      \"target\": \"tables/seeds.tex\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[analysis/paper_statistics.json]]\",\n      \"resolved_path\": \"analysis/paper_statistics.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/seeds.tex.prov.json\",\n      \"target\": \"analysis/paper_statistics.json\"\n    },\n    {\n      \"messages\": [\n        \"generated_by.script_path exists.\"\n      ],\n      \"raw_reference\": \"<generated_by.script_path>\",\n      \"resolved_path\": \"scripts/build_paper_artifacts.py\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/seeds.tex.prov.json\",\n      \"target\": \"scripts/build_paper_artifacts.py\"\n    }\n  ],\n  \"root_dir\": \"work/results/t07/codex/20261117_111440/.paper_evidence_audit_workspaces-1000/agentic-evidence-audit-1000-20261117_132510-paper_evidence_audit_round_2-6matuxv4/workspace\",\n  \"schema_name\": \"scientific-evidence.verification-report\",\n  \"summary\": {\n    \"anchored_references\": 87,\n    \"dangling_references\": 0,\n    \"manifests_checked\": 18,\n    \"resolved_references\": 148,\n    \"total_references\": 235\n  },\n  \"verified_at\": \"2026-11-17T14:49:22.520392+00:00\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/sh -lc \"nl -ba paper.tex | sed -n '1,220p'; cat validation_report.json; ls paper_evidence_audit_stage_feedback.* 2>/dev/null; command -v jq\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/sh -lc \"nl -ba paper.tex | sed -n '1,220p'; cat validation_report.json; ls paper_evidence_audit_stage_feedback.* 2>/dev/null; command -v jq\"","aggregated_output":"     1\t\\documentclass{article}\n     2\t% --- watermark (auto-inserted) ---\n     3\t\\usepackage{xcolor}\n     4\t\\usepackage{xfp}% \\fpeval; in the kernel since 2022, harmless on older LaTeX\n     5\t\\usepackage{draftwatermark}\n     6\t\\newlength{\\watermarkTextWidth}\n     7\t\\AddToHook{begindocument/end}{%\n     8\t  \\SetWatermarkText{\\normalfont Generated by The Agentic Scientist}%\n     9\t  \\SetWatermarkFontSize{10pt}%\n    10\t  \\SetWatermarkLightness{0.85}%\n    11\t  \\settowidth{\\watermarkTextWidth}{\\normalfont\\fontsize{10pt}{12pt}\\selectfont Generated by The Agentic Scientist}%\n    12\t  \\edef\\watermarkScale{\\fpeval{0.8 * sqrt(\\paperwidth**2 + \\paperheight**2) / \\watermarkTextWidth}}%\n    13\t  \\edef\\watermarkAngle{\\fpeval{atand(\\paperheight/\\paperwidth)}}%\n    14\t  \\SetWatermarkScale{\\watermarkScale}%\n    15\t  \\SetWatermarkAngle{\\watermarkAngle}%\n    16\t}\n    17\t% --- end watermark ---\n    18\t\n    19\t\\usepackage{iclr2026_conference,times}\n    20\t\\usepackage[T1]{fontenc}\n    21\t\\usepackage[utf8]{inputenc}\n    22\t\\usepackage{amsmath,amssymb,booktabs,graphicx,url,hyperref}\n    23\t\\usepackage{subcaption}\n    24\t\\title{Score-Targeted Subsets for Predicting LLM Benchmark Accuracy}\n    25\t\\author{}\n    26\t\\newcommand{\\clip}{\\operatorname{clip}_{[0,1]}}\n    27\t\\newcommand{\\sigmoid}{\\operatorname{sigmoid}}\n    28\t\n    29\t\\begin{document}\n    30\t\\maketitle\n    31\t\n    32\t\\begin{abstract}\n    33\tHistorical item-level evaluations offer a way to estimate a language model's benchmark accuracy without evaluating every item. We examine a frozen subset-and-decoder package that targets covariance with full-benchmark accuracy, rather than item representativeness alone. Its source-trained, nested query path is shared across target models; a source-selected decoder maps observed responses to estimated full scores. Recorded held-out evaluations cover nine benchmark matrices, three seeds, and budgets of 5, 10, and 25 items. The package attains mean absolute error of 3.90 percentage points, compared with 5.91 for a local item-response estimator and 10.52 for uniform sampling. A paired lineage-block interval for its error difference from local item response is $[-2.57,-1.46]$ percentage points, conditional on these benchmarks. However, the comparison reverses on several benchmark--budget combinations, including every evaluated budget on HELM MATH. These results support an average package-level advantage within the frozen snapshot, not universal superiority, isolated component effects, or guaranteed transfer to new model families.\n    34\t% @evidence[[paper_data.json#/final_evaluation/metrics]]\n    35\t% @evidence[[analysis/paper_statistics.json#/uncertainty]]\n    36\t% @evidence[[analysis/paper_statistics.json#/local_irt_reversals]]\n    37\t\\end{abstract}\n    38\t\n    39\t\\section{Introduction}\n    40\tEvaluating a language model throughout training or across prompting configurations repeatedly measures an entire benchmark, even when only its aggregate accuracy is needed. Historical evaluations contain more information than a list of aggregate scores: each item supplies a response pattern across source models. Such patterns can identify items whose outcomes are informative about an unseen model's full score. The practical question is not merely whether a benchmark can be compressed, but what should be preserved by the compression and how failures should be detected.\n    41\t\n    42\tAn item subset that represents typical response patterns need not be the subset that best predicts the mean. Some diverse items may contribute little information about differences in full accuracy; conversely, strongly correlated items can be redundant once another item has been observed. This motivates a score-directed criterion: select an item by its remaining covariance with the full score, relative to its conditional variance. A decoder can then use the complete observed response vector, rather than interpreting the queried fraction as an ordinary miniature test.\n    43\t\n    44\tWe study this principle through a frozen acquisition-and-decoding package and paired local comparators. The source-trained query path is common to all target models, while the predicted score depends on each target's answers. This is nonadaptive item selection with respect to target responses. It is not a target-specific testing policy, and it does not require item text or target-model identity at inference. The readable implementation also contains a source-selected nonlinear decoding option, but the retained evaluation does not establish which decoder branch was active for each case. Our scientific object is therefore the complete evaluated package, not a claimed nonlinear mechanism.\n    45\t\n    46\tThe contributions are deliberately bounded. We describe the score-directed acquisition objective and compatible score decoding in the supplied source counterpart. We reconcile the recorded held-out predictions with aggregate accuracy and lineage-level ranking metrics, using budget-matched local baselines. Finally, we show where the aggregate advantage breaks down and distinguish fixed-benchmark uncertainty from evidence about unseen benchmarks. No controlled component ablations are available, so no part of the comparison identifies the isolated benefit of acquisition, linear decoding, or nonlinear residual correction.\n    47\t\n    48\tAcross the retained evaluation, lower average error coexists with unfavorable comparisons on HELM MATH, LegalBench, and MedQA at particular budgets. Those reversals are central evidence, not exceptions to be removed. A useful compact evaluator must be assessed both as an estimator of absolute accuracy and as a ranking device, with its source dependence and uncertainty made explicit.\n    49\t% @evidence[[analysis/paper_statistics.json#/local_irt_reversals]]\n    50\t\n    51\t\\begin{figure}[t]\n    52\t\\centering\n    53\t\\includegraphics[width=\\textwidth,height=2in,keepaspectratio]{figures/score_prediction_overview.png}\n    54\t\\caption{Estimation setting and information boundary. Source response matrices determine a shared score-directed item path and source-selected decoder. Only the target responses at the queried items enter prediction; retained full-benchmark target scores are used for evaluation. The optional decoder branch is not independently attested per case.}\n    55\t\\label{fig:overview}\n    56\t\\end{figure}\n    57\t\n    58\t\\section{Related Work}\n    59\t\\paragraph{Compact benchmark evaluation.}\n    60\tAnchor Points uses correlations in model responses to construct small representative evaluation sets \\citep{Vivek2024}. tinyBenchmarks studies curated subsets and score estimation across established evaluation suites \\citep{Polo2024}; metabench compresses reasoning and knowledge tests using informative items and ability estimates \\citep{Kipnis2025}. These works motivate source-response reuse, but their reported results are not experimental baselines here. Our anchor and item-response comparators are the specific local implementations described below, not reproductions of every feature of those systems.\n    61\t\n    62\tSupervised assessors can predict a new model's performance from its responses on reference instances and features of the instance to be predicted \\citep{Pacchiardi2024}. Our setting instead predicts the aggregate score directly from binary response histories, without using item-text features. Learned acquisition policies offer another route to efficient evaluation \\citep{Li2025}. In contrast, the item path considered here is fixed from source data before target responses arrive. Adaptive evaluation with continuous bounded scores \\citep{Balkir2026} addresses a broader observation model and stopping problem; our evidence is restricted to fixed-budget binary matrices. ONEBench studies aggregation over heterogeneous, incomplete evaluations \\citep{Ghosh2024}, whereas the present target is a retained benchmark's arithmetic mean.\n    63\t\n    64\t\\paragraph{Targeted design and regularization.}\n    65\tSelecting measurements for a particular linear functional, rather than estimating all parameters equally well, is a classical experimental-design distinction \\citep{Elfving1952}. The score-directed criterion below is an empirical, regularized covariance construction, not a claim to solve that general design problem optimally. Ridge regularization stabilizes regression when observations are correlated \\citep{Hoerl1970}. Here both the acquisition criterion and decoder depend on source-derived covariance, making source-to-target stability an empirical assumption rather than a consequence of regularization.\n    66\t\n    67\t\\paragraph{Evaluation discipline.}\n    68\tModel selection can overfit its own validation criterion \\citep{Cawley2010}, and repeated adaptive reuse of evaluation data requires care \\citep{Dwork2015}. We consequently separate development feedback from the recorded held-out comparison. Bootstrap uncertainty \\citep{Efron1979} is reported under the evaluator's actual resampling unit, not as a distribution-free certificate. None of these methodological connections turns the observed comparison into evidence of universal benchmark predictability.\n    69\t\n    70\t\\section{Method}\n    71\t\\subsection{Problem and Estimation Target}\n    72\tFor one benchmark, let $X\\in\\{0,1\\}^{M\\times N}$ contain source-model responses on $N$ retained item columns. A target model has response vector $y\\in\\{0,1\\}^{N}$ and full accuracy\n    73\t\\begin{equation}\n    74\ts(y)=\\frac{1}{N}\\sum_{j=1}^{N}y_j.\n    75\t\\label{eq:target}\n    76\t\\end{equation}\n    77\tOnly responses on a subset $Q_k$, of size $k$, are made available to the estimator. The output is $\\hat s(y_{Q_k};X)\\in[0,1]$. Historical source responses can be used in fitting and tuning; unqueried target responses and full target scores cannot. The target is the mean over retained columns, not a claim to recover an unreconciled original benchmark or a differently weighted official leaderboard score.\n    78\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes/0/solution/episodes/0/checkpoints]]\n    79\t% @evidence[[source_evidence/evaluator/evaluate_final.py#L844]]\n    80\t\n    81\tSource rows have nonnegative weights $w_m$ summing to unity. The supplied protocol gives each metadata-defined source lineage equal total weight and distributes that weight equally among its rows. Item-content groups constrain selection: at most one item from any group is queried. However, all retained columns, including their multiplicities, remain in Equation~\\ref{eq:target}. Thus query uniqueness and score weighting are distinct operations. The same nested path $Q_5\\subset Q_{10}\\subset Q_{25}$ serves all targets within a fitted case.\n    82\t% @evidence[[source_evidence/evaluator/evaluate_final.py#L556]]\n    83\t% @evidence[[source_evidence/selected/src/program.py#L99]]\n    84\t\n    85\t\\subsection{Score-Directed Shared Acquisition}\n    86\tDefine the weighted item means $\\mu_j=\\sum_m w_mX_{mj}$, source full scores $s_m=N^{-1}\\sum_jX_{mj}$, and weighted score mean $\\bar s=\\sum_mw_ms_m$. Let\n    87\t\\begin{equation}\n    88\tZ_{mj}=\\sqrt{w_m}(X_{mj}-\\mu_j),\\quad\n    89\tu_m=\\sqrt{w_m}(s_m-\\bar s),\\quad C=Z^\\top Z,\\quad c=Z^\\top u.\n    90\t\\label{eq:covariance}\n    91\t\\end{equation}\n    92\tThe vector $c$ targets full accuracy explicitly. A high item variance alone does not imply a high score covariance; a high marginal covariance can also become redundant after other items are selected.\n    93\t% @evidence[[source_evidence/selected/src/surrogate.py#L6]]\n    94\t\n    95\tFor regularization $\\lambda>0$, a partial subset $Q$ has regularized score information $c_Q^\\top(C_{QQ}+\\lambda I)^{-1}c_Q$. A Schur-complement expansion yields the incremental criterion\n    96\t\\begin{equation}\n    97\tg(j\\mid Q)=\n    98\t\\frac{\\left[c_j-C_{jQ}(C_{QQ}+\\lambda I)^{-1}c_Q\\right]^2}\n    99\t{C_{jj}+\\lambda-C_{jQ}(C_{QQ}+\\lambda I)^{-1}C_{Qj}}.\n   100\t\\label{eq:gain}\n   101\t\\end{equation}\n   102\tThe readable selector greedily adds the legal item maximizing this quantity, masking every item in an already queried content group. Empty-set terms vanish. This construction optimizes a source empirical linear-prediction surrogate; it neither guarantees target MAE reduction nor proves that the greedy subset is globally optimal. Ridge regularization also changes the acquisition ranking, not merely the final regression fit.\n   103\t% @evidence[[source_evidence/selected/src/surrogate.py#L31]]\n   104\t\n   105\tThe rationale is to prefer responses that explain residual variation in the quantity actually being estimated. In contrast, response-space coverage can emphasize diversity without accounting for whether that diversity changes the full mean. This is a design hypothesis: the available comparison changes the decoder as well as the query path, so it cannot establish that Equation~\\ref{eq:gain} alone explains the measured advantage.\n   106\t\n   107\t\\subsection{All-Observation Score Decoding}\n   108\tFor observed history $z=y_Q$, the linear decoder uses\n   109\t\\begin{align}\n   110\t\\beta_Q&=(C_{QQ}+\\lambda I)^{-1}c_Q,\\\\\n   111\t\\hat s_{\\mathrm{ridge}}(z)&=\\bar s+(z-\\mu_Q)^\\top\\beta_Q,\\qquad\n   112\t\\hat s_{\\mathrm{offset}}(z)=\\bar s+\\frac{1}{|Q|}\\sum_{j\\in Q}(z_j-\\mu_j),\\\\\n   113\t\\hat s_L(z)&=\\clip\\left[\\alpha\\hat s_{\\mathrm{ridge}}(z)+(1-\\alpha)\\hat s_{\\mathrm{offset}}(z)\\right].\n   114\t\\label{eq:linear}\n   115\t\\end{align}\n   116\tThe offset term corrects the source score mean using the target's average deviation from source item means. Every queried answer contributes to decoding; identical answer histories map to the same prediction. With no observations, the fallback is the source score mean. Clipping bounds predictions but does not supply confidence intervals or unbiasedness.\n   117\t% @evidence[[source_evidence/selected/src/surrogate.py#L75]]\n   118\t\n   119\tThe supplied implementation also admits an optional decoder that infers a regularized scalar log-odds shift from queried answers, averages its predicted probabilities over retained items, and adds a source-fitted residual ridge correction. It can blend this estimate with Equation~\\ref{eq:linear}, including a purely linear fallback. Its residual features and fitted shifts use the same query prefix during training and inference. Supplementary Information gives the equations. Since no per-case branch selections or component ablations are attested, we do not label the measured gain a nonlinear-decoder effect.\n   120\t% @evidence[[source_evidence/selected/src/nonlinear_decoder.py#L18]]\n   121\t% @evidence[[source_evidence/selected/src/nonlinear_decoder.py#L233]]\n   122\t\n   123\t\\subsection{Source-Only Selection of Settings}\n   124\tSettings are selected with lineage-disjoint source folds. Within each fold, item statistics and the acquisition path are refitted on fitting rows, and accuracy estimates are assessed on held-out source lineages. Loss averages absolute errors over the evaluation prefixes, then gives held-out lineages equal weight. The optional decoder adds an outer source split that refits the linear selector and its tuning within the fitting partition. No target full score is supplied for these choices.\n   125\t% @evidence[[source_evidence/selected/src/surrogate.py#L111]]\n   126\t% @evidence[[source_evidence/selected/src/nonlinear_decoder.py#L142]]\n   127\t\n   128\tThe source counterpart is inspectable, but the retained final source-tree digest does not itself prove byte identity with that available tree. We therefore distinguish an implementation-grounded description of the supplied counterpart from the directly attested final predictions. This boundary is particularly important for settings or conditional branches absent from the measurement records. The empirical conclusions below require the recorded predictions, not an assumption about which optional branch produced them.\n   129\t% @evidence[[source_evidence/inventory.json]]\n   130\t% @evidence[[paper_data.json#/final_evaluation/program_tree_sha256]]\n   131\t\n   132\t\\section{Experimental Protocol}\n   133\t\\subsection{Data, Splits, and Budget Matching}\n   134\tThe recorded final evaluation covers nine binary benchmark matrices. The leaderboard-derived group contains BBH \\citep{Suzgun2022}, GPQA \\citep{Rein2023}, MMLU-Pro \\citep{Wang2024}, MuSR \\citep{Sprague2023}, and a MATH subset \\citep{Hendrycks2021}. The HELM-derived group \\citep{Liang2023} contains LegalBench \\citep{Guha2023}, MATH, MedQA \\citep{Jin2020}, and MMLU \\citep{Hendrycks2020}. These are the supplied retained matrices, not newly collected LLM outputs. Distinguishing leaderboard MATH from HELM MATH is essential because they are separate evaluation cases.\n   135\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n   136\t\n   137\tDevelopment feedback concerned ARC-Challenge, IFEval, Commonsense, and GSM matrices; it is not pooled with the final metrics. The frozen package is refitted from the source rows of each final benchmark. Hence this is evaluation across held-out benchmark cases with per-benchmark source fitting, not transfer of a single fixed set of coefficients across tasks. No additional evaluated task family is supplied beyond this benchmark-prediction setting.\n   138\t% @evidence[[paper_data.json#/best_correct/evaluation_evidence/episodes]]\n   139\t\n   140\tThe frozen resource manifests describe model-lineage separation and conservative item-content reconciliation across development and final data. Anonymous group identifiers, rather than model names or item text, reach the estimator. Known aliases and declared base-model relations guide grouping; undocumented derivatives can remain related across partitions. Common-stem normalization likewise does not establish semantic or pretraining disjointness. These are metadata-based safeguards, not proof of independent source and target populations.\n   141\t% @evidence[[source_evidence/manifests/bbh_manifest.json#/lineage_policy]]\n   142\t% @evidence[[source_evidence/manifests/bbh_manifest.json#/limitations]]\n   143\t\n   144\tEvaluation uses seeds 1009, 2003, and 3001 and cumulative query budgets 5, 10, and 25. This yields 81 non-replay benchmark--budget--seed cells. Each reset discards fitted state. A repeated normal BBH record checks deterministic replay but is excluded from performance averages. Identical-history and duplicated-target checks assess prediction consistency; additional perturbed observations are reported separately, not counted as ordinary performance measurements.\n   145\t% @evidence[[analysis/paper_statistics.json#/cell_count]]\n   146\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n   147\t\n   148\t\\subsection{Compared Estimators}\n   149\tAll nonzero-cost estimators use the same reported item budget, but not necessarily the same items or fitting cost. The \\textbf{source prior} returns the weighted source mean and uses no target answers. \\textbf{Uniform sampling} selects a random prefix of content-group representatives and scales observed outcomes by each group's retained-column mass. Its clipped, group-mass-weighted estimate is not simply an unweighted mean when group sizes differ. \\textbf{Local anchors} constructs normalized source response embeddings, chooses representatives by a farthest-point rule, assigns all retained items to selected representatives, and uses assignment masses to weight their target outcomes. This is a local anchor estimator rather than an exact published Anchor Points reproduction.\n   150\t% @evidence[[source_evidence/evaluator/evaluate_final.py#L580]]\n   151\t% @evidence[[source_evidence/evaluator/evaluate_final.py#L598]]\n   152\t\n   153\t\\textbf{Local IRT} uses a logistic ability--difficulty model with regularized ability fitting. It shares the uniform baseline's item path, estimates target ability from the queried answers, and averages predicted probabilities across retained items. Its source-fitted difficulties and implementation details are specified in Supplementary Information. The \\textbf{score-targeted package} changes both selection and decoding. Accordingly its comparison with IRT is a package comparison at matched observation budgets, not a selector-only or decoder-only ablation. None of the local comparators establishes a state-of-the-art comparison with the full published systems.\n   154\t% @evidence[[source_evidence/evaluator/evaluate_final.py#L636]]\n   155\t\n   156\t\\subsection{Metrics and Conditional Uncertainty}\n   157\tWithin each cell, each target lineage receives equal total weight, distributed equally among its models. MAE is the resulting weighted absolute error, and RMSE is the square root of weighted squared error. Ranking metrics are Spearman correlation and Kendall's $\\tau_b$ between lineage-mean predictions and lineage-mean true scores, not correlations over individual rows. Aggregate metrics average cells equally, giving each benchmark, budget, and seed equal weight. In particular, aggregate RMSE is a mean of cell RMSEs, not a pooled squared-error statistic.\n   158\t% @evidence[[source_evidence/evaluator/evaluate_final.py#L556]]\n   159\t% @evidence[[analysis/paper_statistics.json#/aggregate]]\n   160\t\n   161\tThe evaluator supplies paired percentile intervals from 200 lineage-block bootstrap draws. Within a benchmark, lineage blocks retain their predictions across budgets and seeds; benchmarks retain equal weights. The same aggregate uncertainty object is repeated in the outer seed records and is used only once. These intervals condition on the fixed cases and stored fitting outcomes. They do not resample benchmarks, refit source data, quantify future-family transfer, or provide individual-target prediction intervals. They are the recorded percentile procedure, not higher-order corrected intervals \\citep{Efron1987}. No failed normal cells are recorded. The evaluator's completion and qualification outcome are both affirmative; that procedural result does not certify scientific generality.\n   162\t% @evidence[[analysis/paper_statistics.json#/uncertainty]]\n   163\t% @evidence[[paper_data.json#/final_evaluation/status]]\n   164\t% @evidence[[paper_data.json#/final_evaluation/outcome]]\n   165\t\n   166\t\\section{Results}\n   167\t\\subsection{Average Accuracy and Ranking}\n   168\tTable~\\ref{tab:main} reports the frozen final comparison. The score-targeted package has MAE 3.90 percentage points versus 5.91 for local IRT, the strongest recorded aggregate baseline by MAE. Uniform sampling, the source prior, and local anchors have MAE 10.52, 8.34, and 15.67 percentage points, respectively. The package's RMSE is 4.84 percentage points, compared with 7.30 for local IRT. These are averages under the stated weighting, not a guarantee for every target or benchmark.\n   169\t% @evidence[[paper_data.json#/final_evaluation/metrics]]\n   170\t% @evidence[[analysis/paper_statistics.json#/aggregate]]\n   171\t\n   172\t\\begin{table}[t]\n   173\t\\centering\n   174\t\\caption{Equal-cell averages over the retained final cases. Error units are percentage points (pp); rank correlations use lineage means. Only the source prior uses no target answers. Baseline RMSE and correlations are reconstructed from the recorded prediction arrays; a constant prior cannot provide a meaningful ranking, so its correlations are omitted.}\n   175\t\\label{tab:main}\n   176\t\\input{tables/aggregate.tex}\n   177\t% @evidence[[analysis/paper_statistics.json#/aggregate]]\n   178\t\\end{table}\n   179\t\n   180\tThe mean Spearman correlation is 0.816 for the package, versus 0.603 for local IRT; the corresponding Kendall values are 0.672 and 0.491. Uniform sampling has similar aggregate ranking correlations to local IRT despite substantially higher score error. Thus absolute accuracy estimation and ordering are empirically distinct objectives. Our MAE uncertainty analysis should not be read as a significance test for the differences in either ranking metric. Nor does lineage-level correlation establish that every pair of closely matched individual models is reliably ordered.\n   181\t% @evidence[[analysis/paper_statistics.json#/aggregate]]\n   182\t\n   183\t\\begin{figure}[t]\n   184\t\\centering\n   185\t\\includegraphics[width=\\textwidth]{figures/paired_error_comparison.pdf}\n   186\t\\caption{Paired aggregate MAE differences with the recorded 95\\% lineage-block percentile intervals. Negative values favor the score-targeted package. Budgets and seeds remain within each lineage block, and benchmarks are not resampled. All intervals are conditional on the fixed benchmark collection.}\n   187\t\\label{fig:paired}\n   188\t% @evidence[[analysis/paper_statistics.json#/uncertainty]]\n   189\t\\end{figure}\n   190\t\n   191\tFigure~\\ref{fig:paired} quantifies the aggregate comparisons without discarding their pairing. The package-minus-IRT MAE difference is $-2.01$ percentage points, with interval $[-2.57,-1.46]$. The corresponding differences are $-6.62$ against uniform sampling, $-4.44$ against the prior, and $-11.78$ against local anchors; each recorded interval lies below zero. This is evidence for an average error reduction within the fixed evaluation. It does not estimate the probability that a newly chosen benchmark would favor the package.\n   192\t% @evidence[[analysis/paper_statistics.json#/uncertainty/comparisons]]\n   193\t\n   194\t\\subsection{Budget Dependence and Seed Consistency}\n   195\tAveraging over benchmarks and seeds, package MAE decreases from 4.67 percentage points at 5 items to 3.95 at 10 and 3.08 at 25. Local IRT decreases from 7.32 to 5.88 and 4.54, respectively. Package Spearman correlation rises from 0.763 to 0.802 and 0.882 across these budgets. Supplementary Figure~\\ref{fig:budget} shows the paired budget profiles alongside the other nonconstant estimators. These are measurements at nested subsets, not a claim of monotonic improvement for each benchmark or every fitted subset.\n   196\t% @evidence[[analysis/paper_statistics.json#/by_budget]]\n   197\t\n   198\tThe package's aggregate MAEs for the three recorded seeds are 3.816, 4.006, and 3.876 percentage points. Its error is lower than the aggregate local IRT error for each seed. This descriptive consistency is useful, but the seeds reuse the same frozen source and target splits; they are not independent samples of future benchmark environments. Source-prior and deterministic anchor predictions also do not become independent replications merely because their values appear in multiple seed records.\n   199\t% @evidence[[analysis/paper_statistics.json#/by_seed]]\n   200\t\n   201\t\\subsection{Where the Comparison Reverses}\n   202\tFigure~\\ref{fig:reversals} shows benchmark--budget differences from local IRT, averaging the recorded seeds. On each leaderboard-derived matrix, the package has lower MAE at every evaluated budget. The HELM-derived matrices are mixed: LegalBench favors IRT at 5 and 25 items, HELM MATH favors IRT at all budgets, and MedQA favors IRT at 10 and 25 items. MMLU favors the package across these budgets. These are descriptive cell means; no cell-specific confidence intervals or multiplicity-adjusted tests are supplied.\n   203\t% @evidence[[analysis/paper_statistics.json#/by_case_budget]]\n   204\t% @evidence[[analysis/paper_statistics.json#/local_irt_reversals]]\n   205\t\n   206\t\\begin{figure}[t]\n   207\t\\centering\n   208\t\\includegraphics[width=\\textwidth]{figures/case_budget_reversals.pdf}\n   209\t\\caption{Benchmark-specific package-minus-local-IRT MAE, averaged over seeds. Shapes distinguish query budgets. Left of zero favors the package; right favors IRT. The shared horizontal scale preserves both the larger leaderboard advantages and the HELM reversals. Panels separate matrix provenance, not independently randomized treatment groups. No benchmark-specific intervals are inferred from the aggregate interval.}\n   210\t\\label{fig:reversals}\n   211\t% @evidence[[analysis/paper_statistics.json#/by_case_budget]]\n   212\t\\end{figure}\n   213\t\n   214\tThe HELM MATH contrast is substantial enough to matter to the interpretation: at 5 items the package's MAE is 11.63 percentage points, compared with 9.53 for IRT; at 25 items the respective values are 6.19 and 5.61. MedQA is also nonmonotonic for the package: its MAE increases from 6.68 at 5 items to 7.47 at 10, before falling to 5.54 at 25. Additional observations therefore do not ensure lower realized error under a changed regression prefix. We do not diagnose these reversals as saturation, lineage shift, or decoder activation: the retained evidence does not isolate those causes.\n   215\t% @evidence[[analysis/paper_statistics.json#/by_case_budget/math]]\n   216\t% @evidence[[analysis/paper_statistics.json#/by_case_budget/med_qa]]\n   217\t\n   218\tThe contrast between matrix groups is likewise not a causal ecosystem effect. Dataset composition, model populations, item reconciliation, and source-target relationships change together. The results support a heterogeneous estimator comparison, not a claim that leaderboard provenance is intrinsically easier to predict. Reporting only the aggregate would conceal meaningful local failures; reporting only the failures would conceal the paired aggregate advantage.\n   219\t\n   220\t\\subsection{Observation Perturbations and Attribution Limits}\n{\n  \"bibtex_key_count\": 25,\n  \"citation_count\": 25,\n  \"claim_count\": 66,\n  \"error\": null,\n  \"evidence_validation\": {\n    \"bundle_path\": \"work/results/t07/codex/20261117_111440/paper/scientific-evidence\",\n    \"bundle_present\": true,\n    \"checked\": true,\n    \"dangling\": [],\n    \"hard_errors\": [],\n    \"paper_token_count\": 190,\n    \"summary\": {\n      \"anchored_references\": 87,\n      \"dangling_references\": 0,\n      \"manifests_checked\": 18,\n      \"resolved_references\": 148,\n      \"total_references\": 235\n    },\n    \"verification_report_path\": \"work/results/t07/codex/20261117_111440/paper/scientific-evidence/verification-report.json\"\n  },\n  \"feedback\": {\n    \"figure_validation_errors\": [],\n    \"figure_validation_warnings\": [],\n    \"language_validation_warnings\": [\n      \"visible standalone paper text uses discouraged phrasing 'implementations'; prefer reader-facing language\"\n    ]\n  },\n  \"figure_validation\": {\n    \"checked\": true,\n    \"errors\": [],\n    \"figure_count\": 4,\n    \"hard_errors\": [],\n    \"manifest_path\": \"work/results/t07/codex/20261117_111440/paper/figure_manifest.json\",\n    \"referenced_paths\": [\n      \"figures/budget_sensitivity.pdf\",\n      \"figures/budget_sensitivity.png\",\n      \"figures/case_budget_reversals.pdf\",\n      \"figures/case_budget_reversals.png\",\n      \"figures/paired_error_comparison.pdf\",\n      \"figures/paired_error_comparison.png\",\n      \"figures/score_prediction_overview.png\"\n    ],\n    \"required\": true,\n    \"soft_warnings\": []\n  },\n  \"latex_logs\": [\n    {\n      \"command\": [\n        \"/usr/local/bin/docker\",\n        \"run\",\n        \"--rm\",\n        \"--network\",\n        \"rwe-b1-agentic-scientist-t07-20261117T111016Z-net\",\n        \"--user\",\n        \"1000:1000\",\n        \"-v\",\n        \"work/results/t07/codex/20261117_111440/paper: