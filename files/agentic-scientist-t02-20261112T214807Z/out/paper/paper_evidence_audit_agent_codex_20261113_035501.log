   \"hash_checked\": true,\n      \"messages\": [\n        \"Recorded sha256 matches file contents.\"\n      ],\n      \"raw_reference\": \"<artifact.sha256>\",\n      \"resolved_path\": \"repair_validation_report.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"repair_validation_report.json.prov.json\",\n      \"target\": \"repair_validation_report.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper.pdf]]\",\n      \"resolved_path\": \"paper.pdf\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"repair_validation_report.json.prov.json\",\n      \"target\": \"paper.pdf\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper.tex]]\",\n      \"resolved_path\": \"paper.tex\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"repair_validation_report.json.prov.json\",\n      \"target\": \"paper.tex\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[claims_grounding.json]]\",\n      \"resolved_path\": \"claims_grounding.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"repair_validation_report.json.prov.json\",\n      \"target\": \"claims_grounding.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[figure_manifest.json]]\",\n      \"resolved_path\": \"figure_manifest.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"repair_validation_report.json.prov.json\",\n      \"target\": \"figure_manifest.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper_data.json]]\",\n      \"resolved_path\": \"paper_data.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"repair_validation_report.json.prov.json\",\n      \"target\": \"paper_data.json\"\n    },\n    {\n      \"messages\": [\n        \"generated_by.script_path exists.\"\n      ],\n      \"raw_reference\": \"<generated_by.script_path>\",\n      \"resolved_path\": \"scripts/check_outputs.py\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"repair_validation_report.json.prov.json\",\n      \"target\": \"scripts/check_outputs.py\"\n    },\n    {\n      \"locator\": \"/final_evaluation\",\n      \"messages\": [\n        \"Target path exists, but locator semantics were not interpreted by the base verifier.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper_data.json#/final_evaluation]]\",\n      \"resolved_path\": \"paper_data.json\",\n      \"status\": \"anchored\",\n      \"subject_kind\": \"ledger-entry\",\n      \"subject_path\": \"scientific-evidence/ledger.jsonl:1\",\n      \"target\": \"paper_data.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[claims_grounding.json]]\",\n      \"resolved_path\": \"claims_grounding.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"ledger-entry\",\n      \"subject_path\": \"scientific-evidence/ledger.jsonl:1\",\n      \"target\": \"claims_grounding.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[derived/observations.json]]\",\n      \"resolved_path\": \"derived/observations.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"ledger-entry\",\n      \"subject_path\": \"scientific-evidence/ledger.jsonl:1\",\n      \"target\": \"derived/observations.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[validation_report.json]]\",\n      \"resolved_path\": \"validation_report.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"ledger-entry\",\n      \"subject_path\": \"scientific-evidence/ledger.jsonl:1\",\n      \"target\": \"validation_report.json\"\n    }\n  ],\n  \"root_dir\": \"work/results/t02/codex/20261112_215258/.paper_evidence_audit_workspaces-1000/agentic-evidence-audit-1000-20261113_035501-paper_evidence_audit_round_2-5c1t4zl5/workspace\",\n  \"schema_name\": \"scientific-evidence.verification-report\",\n  \"summary\": {\n    \"anchored_references\": 106,\n    \"dangling_references\": 0,\n    \"manifests_checked\": 16,\n    \"resolved_references\": 96,\n    \"total_references\": 202\n  },\n  \"verified_at\": \"2026-11-13T04:58:34.589074+00:00\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/sh -lc \"wc -l paper.tex paper_evidence_audit_packet.md claims_grounding.json validation_report.json; ls -l paper_evidence_audit_stage_feedback* 2>/dev/null; printf '\\\\n--- manuscript 1 ---\\\\n'; nl -ba paper.tex | sed -n '1,190p'; printf '\\\\n--- claims ---\\\\n'; cat claims_grounding.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/sh -lc \"wc -l paper.tex paper_evidence_audit_packet.md claims_grounding.json validation_report.json; ls -l paper_evidence_audit_stage_feedback* 2>/dev/null; printf '\\\\n--- manuscript 1 ---\\\\n'; nl -ba paper.tex | sed -n '1,190p'; printf '\\\\n--- claims ---\\\\n'; cat claims_grounding.json\"","aggregated_output":"   378 paper.tex\n   975 paper_evidence_audit_packet.md\n   421 claims_grounding.json\n   231 validation_report.json\n  2005 total\n\n--- manuscript 1 ---\n     1\t\\documentclass{article}\n     2\t% --- watermark (auto-inserted) ---\n     3\t\\usepackage{xcolor}\n     4\t\\usepackage{xfp}% \\fpeval; in the kernel since 2022, harmless on older LaTeX\n     5\t\\usepackage{draftwatermark}\n     6\t\\newlength{\\watermarkTextWidth}\n     7\t\\AddToHook{begindocument/end}{%\n     8\t  \\SetWatermarkText{\\normalfont Generated by The Agentic Scientist}%\n     9\t  \\SetWatermarkFontSize{10pt}%\n    10\t  \\SetWatermarkLightness{0.85}%\n    11\t  \\settowidth{\\watermarkTextWidth}{\\normalfont\\fontsize{10pt}{12pt}\\selectfont Generated by The Agentic Scientist}%\n    12\t  \\edef\\watermarkScale{\\fpeval{0.8 * sqrt(\\paperwidth**2 + \\paperheight**2) / \\watermarkTextWidth}}%\n    13\t  \\edef\\watermarkAngle{\\fpeval{atand(\\paperheight/\\paperwidth)}}%\n    14\t  \\SetWatermarkScale{\\watermarkScale}%\n    15\t  \\SetWatermarkAngle{\\watermarkAngle}%\n    16\t}\n    17\t% --- end watermark ---\n    18\t\n    19\t\\usepackage{paper,times}\n    20\t\\usepackage{amsmath,amssymb,graphicx,booktabs,subcaption}\n    21\t\\usepackage{hyperref,url,placeins}\n    22\t\\hypersetup{hidelinks}\n    23\t\\title{Width and Delayed Generalization in Finite-Horizon Modular Addition}\n    24\t\\author{}\n    25\t\\newcommand{\\fit}{t_{\\mathrm{fit}}}\n    26\t\\newcommand{\\gen}{t_{\\mathrm{gen}}}\n    27\t\\begin{document}\n    28\t\\maketitle\n    29\t\n    30\t\\begin{abstract}\n    31\tIncreasing model width can accelerate training-set fitting without improving generalization on the same training budget. We examine this distinction in modular addition using a fixed two-embedding network, a common optimizer configuration, and paired zero-decay and initial-norm controls. In the short-horizon development data, increasing hidden width from 32 to 256 reduces sustained fitting onset from 2,200--2,800 to 200 updates, yet held-out endpoint accuracy is nonmonotone in width. In a separate, longer-horizon final evaluation, the two retained width-128 trajectories exhibit delayed generalization, whereas three width-32 trajectories remain right-censored. Only five of nine planned width--seed records are available; no width-256 final record is retained. The final evaluation completed but failed scientific qualification, with no diagnostic identifying the cause. These observations support a conditional distinction between fitting speed and finite-horizon generalization, not a qualified model-size law. Initial-global-norm matching and zero-decay comparisons constrain simple interpretations but do not identify a mechanism or resolve missing outcomes.\n    32\t% @evidence[[paper_data.json#/best_correct/evaluation_evidence/episodes]]\n    33\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    34\t% @evidence[[paper_data.json#/final_evaluation/outcome]]\n    35\t\\end{abstract}\n    36\t\n    37\t\\section{Introduction}\n    38\tThe time needed to fit a training set need not predict the time needed to generalize. Small algorithmic datasets make this distinction especially clear: a neural network can achieve nearly perfect training accuracy while its performance on unseen inputs remains poor, and only much later improve. This phenomenon, termed grokking by \\citet{Power2022GrokkingGB}, provides a controlled setting in which optimization, memorization, and generalization can be examined separately. Model size is a natural experimental variable, but its interpretation requires care. A wider network changes representational capacity, initialization geometry, and optimization simultaneously. Earlier fitting alone does not demonstrate an earlier discovery of the underlying algorithm.\n    39\t\n    40\tWe ask how hidden width relates to training-fit onset and held-out generalization in a fixed modular-addition architecture. Our working explanation is deliberately operational: width can shorten the fitting timescale without shortening the timescale for a well-generalizing solution enough to be observable at a fixed horizon. A simple alternative predicts that increasing width should improve both fitting speed and held-out endpoint accuracy under the same training budget. The available comparisons test that monotone prediction directly. They do not measure the internal computation needed to turn a timescale separation into a causal theory.\n    41\t\n    42\tThe study varies width while retaining the task, model family, loss, and common optimizer settings. Matched comparisons include a fixed reference configuration, removal of weight decay, and rescaling to a common initial global parameter norm. Short-horizon data contain complete paired width comparisons; the longer-horizon final data have incomplete width coverage. We keep these evidence sets separate because their seeds, input pools, and training horizons differ. Their contrast cannot be interpreted as an intervention on training duration alone.\n    43\t\n    44\tThe main empirical finding is a dissociation: larger widths fit earlier in the development data, but held-out accuracy is not monotone in width. Two retained intermediate-width final trajectories show substantial delays between fitting and generalization. However, the final evaluation completed without scientific qualification. Its missing qualification diagnostics do not establish whether the failure arose from performance, uncertainty, validity, adaptivity, or another criterion. Incomplete observations are a documented limitation, not an explanation of that failure.\n    45\t% @evidence[[paper_data.json#/final_evaluation]]\n    46\t\n    47\tOur contributions are a source-linked comparison of fitting and generalization across the measured widths, a control-aware interpretation that separates actual interventions from duplicated conditions, and a censoring-aware account of what remains unidentified. These are bounded empirical contributions. We neither introduce a new optimizer nor claim a scaling law, statistical superiority, a circuit explanation, or a validated decay-clock mechanism. The value of the study lies in distinguishing observations that survive close inspection from stronger conclusions that the available design cannot support.\n    48\t\n    49\t\\begin{figure}[t]\n    50\t\\centering\n    51\t\\includegraphics[width=\\textwidth]{figures/study_overview.pdf}\n    52\t\\caption{Design and observation states, not a mechanistic explanation. Width varies within a fixed modular-addition network and paired control conditions. A recorded generalization onset, a trajectory censored at the observation horizon, and an unavailable record are distinct evidence states. None overrides the failed final scientific qualification.}\n    53\t\\label{fig:overview}\n    54\t\\end{figure}\n    55\t% @evidence[[source_evidence/task/evaluate_final.py#L801]]\n    56\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n    57\t% @evidence[[paper_data.json#/grounding_sources/final.qualification.outcome]]\n    58\t\n    59\t\\section{Related Work}\n    60\t\\paragraph{Algorithmic generalization and internal progress.}\n    61\t\\citet{Power2022GrokkingGB} established small algorithmically generated datasets as a setting for generalization well after training-set fitting. \\citet{Nanda2023Progress} reverse-engineered a Fourier-based algorithm in small Transformers trained on modular addition and developed progress measures based on that computation. Our network instead sums learned input embeddings before a GELU and a linear readout. We measure threshold onsets and endpoint behavior, not Fourier circuits or representation-specific progress. Consequently, architectural or mechanistic conclusions from those Transformers are not evidence for the internal computation of the present network.\n    62\t\n    63\t\\paragraph{Norm, efficiency, and feature learning.}\n    64\t\\citet{Liu2022OmnigrokGB} relate grokking to training and test loss landscapes as a function of weight norm. \\citet{Varma2023ExplainingGT} explain delayed generalization through competition between memorizing and generalizing circuits with different norm efficiency and learning speed. \\citet{Kumar2023GrokkingAT} study a lazy-to-rich transition, including polynomial regression in which delayed generalization occurs without weight decay. These accounts motivate different diagnostics: initial norm, efficiency of task-relevant computations, and evolving features are not interchangeable quantities. Our norm-rescaling and zero-decay controls address limited observable consequences. They do not measure circuit efficiency, kernel alignment, or the onset of feature learning, and cannot select among these explanations.\n    65\t\n    66\t\\paragraph{Capacity and duration.}\n    67\t\\citet{Davies2023Unifying} propose a pattern-learning-speed framework connecting grokking and double descent, including changes in model capacity. \\citet{Nakkiran2020Double} show that model size and training duration can each produce nonmonotone test behavior. These works motivate joint attention to width and observation horizon, rather than an assumption that larger networks must generalize better at every endpoint. Our narrow width sweep is not an estimate of a double-descent curve. Finally, AdamW decouples weight decay from the adaptive loss-gradient update \\citep{Loshchilov2019AdamW}. Matching the nominal decay factor is therefore a useful optimizer description, not proof of equal effective regularization or equal post-fit exposure.\n    68\t\n    69\t\\section{Method}\n    70\t\\subsection{Problem Setup and Evaluation Target}\n    71\tThe task is classification of $y=(a+b)\\bmod p$ for integer residues $a,b\\in\\{0,\\ldots,p-1\\}$ with $p=97$. The full domain contains $p^2$ ordered input pairs. The supplied development and final resources partition that domain into disjoint pools of 4,704 and 4,705 inputs. Each seed defines a training/evaluation split within its pool, with training fraction 0.6. Development splits contain 2,822 training and 1,882 evaluation examples; final splits contain 2,823 and 1,882, respectively. The fixed pools and seed-specific splits, rather than the full operation table, define the measured generalization target. No additional task with recorded results is present.\n    72\t% @evidence[[source_evidence/task/resources/search/dataset.json#/pool_size]]\n    73\t% @evidence[[source_evidence/task/resources/final/dataset.json#/splits]]\n    74\t% @evidence[[paper_data.json#/best_correct/evaluation_evidence/episodes]]\n    75\t\n    76\tFor hidden width $w$, the logits are\n    77\t\\begin{equation}\n    78\t z_\\theta(a,b)=\\operatorname{GELU}\\!\\left(E^{(1)}_{a,:}+E^{(2)}_{b,:}+c\\right)W+d,\n    79\t \\label{eq:model}\n    80\t\\end{equation}\n    81\twhere $E^{(1)},E^{(2)}\\in\\mathbb{R}^{p\\times w}$, $c\\in\\mathbb{R}^{w}$, $W\\in\\mathbb{R}^{w\\times p}$, and $d\\in\\mathbb{R}^{p}$. Full-batch cross-entropy is minimized using AdamW in float32 on CPU. Widths are $32,128,256$, with $292w+97$ trainable parameters: 9,441, 37,473, and 74,849. All biases start at zero. The model has no attention, recurrence, or depth intervention. The inspected final training source implements this architecture directly (Supplementary Information, Section~\\ref{sec:source}).\n    82\t% @evidence[[source_evidence/task/evaluate_final.py#L801]]\n    83\t% @evidence[[derived/observations.json#/rows]]\n    84\t\n    85\t\\subsection{Hypotheses and Interventions}\n    86\tWe distinguish two observable predictions. A \\emph{monotone width-benefit prediction} expects earlier fitting and no reduction in held-out endpoint accuracy as width increases at fixed training horizon. A \\emph{separated-timescale explanation} allows earlier fitting alongside worse short-horizon generalization; it predicts that fitting onset alone will not order held-out performance. A stronger claim that width systematically shortens the post-fit delay would require comparable, observed generalization onsets across widths. Our evidence can challenge the monotone prediction but cannot establish that stronger claim.\n    87\t\n    88\tInitialization is coupled by seed across widths: Gaussian embedding and readout tensors are drawn at the maximum width, then sliced. Embeddings are multiplied by a common multiplier $m$, and the readout is scaled by $m/\\sqrt{w}$. This pairing reduces arbitrary initialization differences without making different widths functionally equivalent. The studied condition uses learning rate $\\eta=0.003$, weight decay $\\lambda=1.0$, and $m=0.5$. It is common across widths and seeds, not adapted using training curves. It was selected using development evaluations; those observations therefore remain selection-conditioned rather than confirmatory.\n    89\t% @evidence[[source_evidence/task/evaluate_final.py#L803]]\n    90\t% @evidence[[source_evidence/controllers/studied/src/program.py#L37]]\n    91\t% @evidence[[paper_data.json#/best_correct/evaluation_evidence/episodes]]\n    92\t\n    93\tEach retained width--seed cell contains the following matched conditions:\n    94\t\\begin{itemize}\n    95\t\\item \\textbf{Studied:} the common configuration above.\n    96\t\\item \\textbf{Reference:} $\\eta=0.001$, $\\lambda=1.0$, $m=1.0$, with the same width, seed, split, and horizon. Because both learning rate and initialization differ, this is a configuration comparison, not a component-specific test.\n    97\t\\item \\textbf{No decay:} the studied configuration with $\\lambda=0$. This isolates removal of decay within the measured setting, not its necessity for all delayed generalization.\n    98\t\\item \\textbf{Norm matched:} the studied initialization is rescaled so its global Euclidean parameter norm equals that of the same-seed width-128 initialization. Learning rate and decay are unchanged. This matches one scalar, not capacity, layerwise geometry, or initial function.\n    99\t\\end{itemize}\n   100\t% @evidence[[source_evidence/task/evaluate_final.py#L795]]\n   101\t% @evidence[[source_evidence/task/evaluate_final.py#L821]]\n   102\tAt width 128 the norm-matching target is the original model itself. The retained initial/final state hashes and scientific metric trajectories match the studied condition there. This duplicate supplies neither an independent replication nor an additional delayed event.\n   103\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n   104\t\n   105\t\\subsection{Training Protocol and Event Definitions}\n   106\tDevelopment observations use seeds 101 and 211 and a horizon of 6,000 updates. Final observations use seeds 60613, 70717, and 80821 with a planned horizon of 24,000 updates. Accuracy is recorded at initialization and every 100 updates. All four conditions in a retained cell use the same split. Distinct development/final pools prevent exact input overlap across those resources, but the longer final horizon also changes alongside the seeds and data. No paired duration-only contrast is available.\n   107\t% @evidence[[paper_data.json#/best_correct/evaluation_evidence/episodes]]\n   108\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n   109\t\n   110\tFor a checkpoint accuracy sequence $A(t)$, define a sustained threshold onset as\n   111\t\\begin{equation}\n   112\t T_q[A]=\\min\\{t_j:\\ A(t_j),A(t_{j+1}),A(t_{j+2})\\geq q\\},\n   113\t \\qquad\n   114\t \\fit=T_{0.99}[A_{\\mathrm{train}}],\\quad\n   115\t \\gen=T_{0.95}[A_{\\mathrm{eval}}].\n   116\t \\label{eq:onset}\n   117\t\\end{equation}\n   118\tThe onset is the first checkpoint in the qualifying triplet, not the confirmation time. When both onsets exist, the delay is $\\max(0,\\gen-\\fit)$. A delayed event requires a delay of at least 1,000 updates. If either onset is absent, the evaluator records censoring and a normalized capped-delay value of one. This last convention is a reporting functional, not an observed event time. Three consecutive checkpoints suppress single-checkpoint spikes but do not guarantee persistent accuracy after the qualifying window. We retain the distinction between threshold-defined delayed generalization and a mechanistically verified transition.\n   119\t% @evidence[[source_evidence/task/evaluate_final.py#L1001]]\n   120\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n   121\t\n   122\t\\subsection{Reporting, Missingness, and Uncertainty}\n   123\tThe unit of replication is the seed, not the evaluation example, checkpoint, or matched condition. We report all retained seed values and descriptive sample standard deviations where appropriate. Paired differences use only seeds shared by the compared widths. We do not replace the planned widest-minus-narrowest final contrast with an intermediate-minus-narrowest contrast without explicitly naming that change in estimand. Missing width records have no performance outcome; they are not measured losses, censored trajectories, or zero-accuracy models.\n   124\t\n   125\tFor transparency, we also give exact binomial intervals for delayed-event counts conditional on retained records. These intervals describe what a hypothetical independent-seed sampling model would allow; the small sample and unknown missingness preclude a population interpretation. No inferential test uses examples or checkpoints as extra replications. Failed final qualification applies independently of these descriptive calculations. The final summary supplies no criterion-specific diagnostics, so neither the observed missingness nor the retained controls can certify validity or identify the cause of non-qualification.\n   126\t% @evidence[[paper_data.json#/final_evaluation/limitations]]\n   127\t% @evidence[[derived/summary.json#/cells]]\n   128\t\n   129\t\\section{Results}\n   130\t\\subsection{Evidence Coverage and Scientific Qualification}\n   131\tTable~\\ref{tab:coverage} gives the full final observation pattern for the studied condition. Only five of nine planned width--seed cells are retained: three at width 32, two at width 128, and none at width 256. All retained cells contain complete-horizon trajectories for the matched conditions. At width 32, failure to observe the sustained generalization threshold is right censoring at the recorded horizon. At width 256, absence of trajectories provides no information about onset or endpoint accuracy. The missing width-128 seed is likewise unavailable, not evidence against generalization.\n   132\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n   133\t\n   134\t\\begin{table}[t]\n   135\t\\centering\n   136\t\\caption{Final coverage for the studied condition. C: recorded trajectory, generalization onset censored at 24,000 updates; D: recorded delayed event; M: missing record. A missing cell is not assigned an accuracy or a censoring time. All conditions in each retained cell were recorded.}\n   137\t\\label{tab:coverage}\n   138\t\\begin{tabular}{lccc}\n   139\t\\toprule\n   140\tSeed & Width 32 & Width 128 & Width 256 \\\\\n   141\t\\midrule\n   142\t60613 & C & D & M \\\\\n   143\t70717 & C & D & M \\\\\n   144\t80821 & C & M & M \\\\\n   145\t\\bottomrule\n   146\t\\end{tabular}\n   147\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n   148\t\\end{table}\n   149\t\n   150\tThe final evaluation completed but did not qualify. We preserve that conclusion rather than interpreting selection as scientific acceptance. No supplied diagnostic distinguishes a statistical/performance failure from a validity or adaptivity failure. Retained observations can describe the measured trajectories, but they cannot restore claims that would require qualification. In particular, neither complete trajectories in individual cells nor successful execution of local controls establishes general validity of the final comparison.\n   151\t% @evidence[[paper_data.json#/grounding_sources/final.qualification.status]]\n   152\t% @evidence[[paper_data.json#/grounding_sources/final.qualification.outcome]]\n   153\t% @evidence[[paper_data.json#/grounding_sources/final.qualification.correct]]\n   154\t\n   155\t\\subsection{Width Accelerates Fitting but Does Not Order Short-Horizon Accuracy}\n   156\tThe short-horizon comparisons show a consistent fitting order. In the studied condition, width-32 fitting onsets are 2,200 and 2,800 updates; width 128 fits at 300 updates in both seeds; width 256 fits at 200 in both seeds. The paired widest-minus-narrowest differences are thus $-2,000$ and $-2,600$ updates. Yet held-out endpoint accuracy is highest at width 32, lowest at width 128, and intermediate at width 256 in each seed (Table~\\ref{tab:development}, Figure~\\ref{fig:endpoint}). Earlier training fit therefore does not order generalization at this horizon.\n   157\t% @evidence[[derived/summary.json#/cells]]\n   158\t% @evidence[[derived/summary.json#/paired/development_256_minus_32]]\n   159\t\n   160\t\\begin{table}[t]\n   161\t\\centering\n   162\t\\caption{Studied condition at the 6,000-update development horizon. Accuracy is mean $\\pm$ sample SD over the two seeds, in percent. Onsets are listed by seed rather than averaged with unobserved values. No sustained held-out onset is observed at any width.}\n   163\t\\label{tab:development}\n   164\t\\begin{tabular}{lrrr}\n   165\t\\toprule\n   166\tWidth & Parameters & Training-fit onsets & Held-out accuracy (\\%) \\\\\n   167\t\\midrule\n   168\t32 & 9,441 & 2,200; 2,800 & $74.68\\pm4.47$ \\\\\n   169\t128 & 37,473 & 300; 300 & $29.33\\pm3.68$ \\\\\n   170\t256 & 74,849 & 200; 200 & $39.35\\pm3.49$ \\\\\n   171\t\\bottomrule\n   172\t\\end{tabular}\n   173\t% @evidence[[derived/summary.json#/cells]]\n   174\t% @evidence[[derived/observations.json#/rows]]\n   175\t\\end{table}\n   176\t\n   177\tThe monotone width-benefit prediction is contradicted by these measured endpoints. This does not refute every possible benefit of width: intermediate held-out performance may depend on the optimization path, and the observation horizon may precede a later transition. Nor does the pattern establish a double-descent curve, which would require a broader sweep and a justified interpolation-regime interpretation. The supported statement is narrower: a shared training budget and common optimizer settings do not make greater width synonymous with better held-out accuracy in these development observations.\n   178\t\n   179\t\\begin{figure}[t]\n   180\t\\centering\n   181\t\\includegraphics[width=\\textwidth]{figures/width_endpoint_comparison.pdf}\n   182\t\\caption{Matched-condition endpoint comparisons. (a) Development observations at 6,000 updates. (b) Retained final observations at 24,000 updates. Each dot is a recorded seed; no missing cell is plotted at zero. The panels use different seeds and disjoint input pools, so their contrast is not a duration-only intervention. At width 128, norm matching duplicates the studied scientific trajectory; horizontally separated symbols do not denote independent evidence.}\n   183\t\\label{fig:endpoint}\n   184\t% @evidence[[derived/observations.json#/rows]]\n   185\t\\end{figure}\n   186\t\n   187\t\\subsection{Retained Delayed Events at Intermediate Width}\n   188\tAt the final horizon, the two retained width-128 studied trajectories first fit at 300 and 200 updates and first satisfy the sustained held-out threshold at 17,600 and 19,200 updates, respectively. Their observed delays are therefore 17,300 and 19,000 updates. Their endpoints are 98.353\\% and 97.768\\%. In contrast, width-32 fitting onsets are 2,600, 2,400, and 3,000 updates, with no sustained held-out onset by 24,000 updates; endpoints are 80.925\\%, 88.842\\%, and 73.433\\%. Figure~\\ref{fig:onsets} separates these delayed events from right censoring and missing records.\n   189\t% @evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\n   190\t% @evidence[[derived/observations.json#/rows]]\n\n--- claims ---\n{\n  \"claims\": [\n    {\n      \"claim\": \"The final evaluation completed, did not qualify, and has a false qualification decision; the supplied diagnostics do not identify the cause.\",\n      \"source_ids\": [\n        \"final.qualification.status\",\n        \"final.qualification.outcome\",\n        \"final.qualification.correct\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation\",\n        \"paper_data.json#/grounding_sources/final.qualification.outcome\"\n      ]\n    },\n    {\n      \"claim\": \"Five of nine planned final width-seed records are retained, with coverage 3/2/0 at widths 32/128/256; absent records are not measured non-events or accuracy losses.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"final.metric.complete_episode_fraction\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"The two retained width-128 studied final records show delayed events; all three width-32 held-out onsets are right-censored at 24000 updates.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"Development fitting onsets in seed order 101/211 are 2200/2800 at width32, 300/300 at width128, and 200/200 at width256.\",\n      \"source_ids\": [\n        \"result.top_program_01\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/best_correct/evaluation_evidence/episodes\"\n      ],\n      \"source_scope_note\": \"The registry ID identifies the selected configuration only; it does not substantiate the scientific numbers. The raw evidence_refs, not the selection score, support this claim.\"\n    },\n    {\n      \"claim\": \"Development widest-minus-narrowest paired fit differences are -2000 and -2600 updates; fitting is earlier but endpoint accuracy is nonmonotone in width in both retained seeds.\",\n      \"source_ids\": [\n        \"result.top_program_01\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/best_correct/evaluation_evidence/episodes\",\n        \"derived/summary.json#/paired/development_256_minus_32\"\n      ],\n      \"source_scope_note\": \"The registry ID identifies the selected configuration only; it does not substantiate the scientific numbers. The raw evidence_refs, not the selection score, support this claim.\"\n    },\n    {\n      \"claim\": \"Development studied endpoint means plus sample SD are 74.68+/-4.47, 29.33+/-3.68, and 39.35+/-3.49 percent at widths32/128/256, over two seeds each.\",\n      \"source_ids\": [\n        \"result.top_program_01\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/best_correct/evaluation_evidence/episodes\",\n        \"derived/summary.json#/cells\"\n      ],\n      \"source_scope_note\": \"The registry ID identifies the selected configuration only; it does not substantiate the scientific numbers. The raw evidence_refs, not the selection score, support this claim.\"\n    },\n    {\n      \"claim\": \"The task is modulo97 addition, learned by two summed embeddings, GELU, and linear output, with widths32/128/256 and 9441/37473/74849 parameters.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"source_evidence/task/evaluate_final.py#L801\",\n        \"derived/observations.json#/rows\"\n      ],\n      \"source_scope_note\": \"Model and training details are substantively supported by readable source whose digest matches the final evaluator; the final evidence supplies measured parameter counts and widths.\"\n    },\n    {\n      \"claim\": \"Development/final pools have4704/4705 disjoint pairs with per-seed train/evaluation sizes2822/1882 and2823/1882, respectively; measured results cover one modular operation.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"result.top_program_01\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"source_evidence/task/resources/search/dataset.json\",\n        \"source_evidence/task/resources/final/dataset.json\",\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"paper_data.json#/best_correct/evaluation_evidence/episodes\"\n      ],\n      \"source_scope_note\": \"Pool/split definitions come from inspectable resources used by the evaluated implementation, not an aggregate score.\"\n    },\n    {\n      \"claim\": \"The studied learning-rate/decay/initialization configuration is(0.003,1,0.5), common to all retained widths and seeds; reference(0.001,1,1) differs in two settings.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"source_evidence/task/evaluate_final.py#L795\",\n        \"source_evidence/controllers/studied/src/program.py#L37\"\n      ]\n    },\n    {\n      \"claim\": \"Zero decay changes only the studied decay to0; norm matching rescales to the same-seed width128 global norm, not to equal capacity or function.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"source_evidence/task/evaluate_final.py#L795\",\n        \"source_evidence/task/evaluate_final.py#L821\"\n      ]\n    },\n    {\n      \"claim\": \"Width128 norm-matched scientific curves and initial/final hashes duplicate the studied records; they are not additional independent delayed events.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"paper_data.json#/best_correct/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"Development uses seeds101/211 at6000 updates; final uses60613/70717/80821 at24000, with checkpoints every100 updates; pools and seeds differ along with duration.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"result.top_program_01\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"paper_data.json#/best_correct/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"Training-fit/held-out onsets require thresholds0.99/0.95 sustained for three consecutive checkpoints, timestamped at the first; a delayed event requires at least1000 updates between onsets.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"source_evidence/task/evaluate_final.py#L1001\",\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\"\n      ]\n    },\n    {\n      \"claim\": \"Final width128 seeds60613/70717 fit at300/200 and generalize at17600/19200; observed delays are17300/19000 updates; endpoints98.353/97.768 percent.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"derived/observations.json#/rows\"\n      ]\n    },\n    {\n      \"claim\": \"Final width32 seeds60613/70717/80821 fit at2600/2400/3000, have censored held-out onset at24000, and endpoints80.925/88.842/73.433 percent.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"derived/observations.json#/rows\"\n      ]\n    },\n    {\n      \"claim\": \"The retained seed-paired final width128-minus32 endpoint differences are17.428 and8.927 percentage points, not the planned256-minus32 contrast.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"derived/summary.json#/paired/final_128_minus_32\"\n      ]\n    },\n    {\n      \"claim\": \"Conditional on retained final records, event counts2/2 and0/3 have exact95-percent binomial intervals[0.158,1] and[0,0.708]; these exploratory intervals neither resolve missingness nor establish population or mechanistic validity.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"derived/summary.json#/cells\",\n        \"scripts/build_artifacts.py\"\n      ]\n    },\n    {\n      \"claim\": \"Retained final no-decay width32 endpoints0.478--0.797 percent and width128 endpoints0 percent coexist with fit onsets1300--1600 and200, respectively; this is a finite-horizon configuration contrast only.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"derived/observations.json#/rows\"\n      ]\n    },\n    {\n      \"claim\": \"Development norm-matched width32 endpoints70.510/56.164 percent exceed width128 endpoints31.934/26.727 in both seeds; scalar norm matching does not remove that ordering.\",\n      \"source_ids\": [\n        \"result.top_program_01\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/best_correct/evaluation_evidence/episodes\"\n      ],\n      \"source_scope_note\": \"The registry ID identifies the selected configuration only; it does not substantiate the scientific numbers. The raw evidence_refs, not the selection score, support this claim.\"\n    },\n    {\n      \"claim\": \"Retained final reference endpoints54.570--65.037 percent atwidth32 and80.659--84.272 atwidth128 show no sustained held-out threshold crossing; these are multi-setting reference comparisons.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"derived/observations.json#/rows\"\n      ]\n    },\n    {\n      \"claim\": \"Final event fraction0.222222 is design-weighted over nine cells, mean endpoint functional0.488133 includes missing-cell zero weighting, and capped delay0.945833 includes missing-cell cap weighting; these are not population event rates, observed endpoint means, or uncensored mean event times.\",\n      \"source_ids\": [\n        \"final.metric.grokking_incidence\",\n        \"final.metric.mean_final_accuracy\",\n        \"final.metric.restricted_mean_delay\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/metrics\",\n        \"source_evidence/task/evaluate_final.py#L1066\"\n      ]\n    },\n    {\n      \"claim\": \"The descriptive mean of the five observed final studied endpoints is0.878640, distinct from the failure-weighted registry functional.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"derived/summary.json#/final_observed_endpoint_mean\"\n      ]\n    },\n    {\n      \"claim\": \"Related development settings are(0.003,1,1),(0.003,1,0.5),(0.006,0.5,0.5); the faster setting has an unavailable width256 seed211 record, not a measured zero or known failure cause.\",\n      \"source_ids\": [\n        \"result.top_program_01\",\n        \"result.top_program_02\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/all_programs/0/evaluation_evidence/episodes\",\n        \"paper_data.json#/all_programs/1/evaluation_evidence/episodes\",\n        \"paper_data.json#/all_programs/2/evaluation_evidence/episodes\"\n      ],\n      \"source_scope_note\": \"Selection IDs identify related selected configurations only. All sensitivity numbers and missingness are supported by explicit raw registry pointers, not these scalar IDs.\"\n    },\n    {\n      \"claim\": \"The evaluated source uses CPU float32, full-batch AdamW, deterministic algorithms, at most two CPU threads and one inter-op thread; requirements pin numpy2.1.3 and torch2.5.1+cpu.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"source_evidence/task/evaluate_final.py#L765\",\n        \"source_evidence/task/evaluate_final.py#L781\",\n        \"source_evidence/task/requirements.txt\"\n      ]\n    },\n    {\n      \"claim\": \"The readable final evaluator digest matches the registry evaluator digest; hash agreement is provenance, while code contents support architecture and optimizer details.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"derived/source_manifest.json\",\n        \"source_evidence/task/evaluate_final.py\",\n        \"paper_data.json#/final_evaluation/evaluator_sha256\"\n      ]\n    },\n    {\n      \"claim\": \"Recorded selected-development seed evaluation durations are981/754 seconds, and final seed totals3199/2794/3488 seconds after rounding; incomplete final coverage prevents extrapolating complete-grid runtime.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\",\n        \"result.top_program_01\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"paper_data.json#/best_correct/evaluation_evidence/episodes\",\n        \"derived/summary.json#/runtime_by_scope_seconds\"\n      ]\n    },\n    {\n      \"claim\": \"All five retained final studied endpoints have training accuracy1.0, with different residual train cross-entropies; initial/final global norms increase in every record, including delayed-event records. Table norms/losses are individual measured endpoints, not a norm-trajectory mediation test.\",\n      \"source_ids\": [\n        \"final.evidence.episodes\"\n      ],\n      \"citation_keys\": [],\n      \"evidence_refs\": [\n        \"paper_data.json#/final_evaluation/evaluation_evidence/episodes\",\n        \"derived/observations.json#/rows\",\n        \"derived/norm_loss_records.tex\"\n      ]\n    },\n    {\n      \"claim\": \"Power et al. document delayed generalization on small algorithmic datasets.\",\n      \"source_ids\": [\n        \"ref.arxiv.2201.02177\"\n      ],\n      \"citation_keys\": [\n        \"Power2022GrokkingGB\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/literature/2201.02177_opening.txt\"\n      ]\n    },\n    {\n      \"claim\": \"Nanda et al. reverse-engineer a Fourier-based modular-addition computation in small Transformers; our architecture and measurements do not establish the same mechanism.\",\n      \"source_ids\": [\n        \"ref.arxiv.2301.05217\"\n      ],\n      \"citation_keys\": [\n        \"Nanda2023Progress\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/literature/2301.05217_opening.txt\"\n      ]\n    },\n    {\n      \"claim\": \"Liu et al. relate grokking to loss landscapes as a function of weight norm.\",\n      \"source_ids\": [\n        \"ref.arxiv.2210.01117\"\n      ],\n      \"citation_keys\": [\n        \"Liu2022OmnigrokGB\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/literature/2210.01117_opening.txt\"\n      ]\n    },\n    {\n      \"claim\": \"Varma et al. propose differing learning speeds and norm efficiencies of memorizing and generalizing circuits.\",\n      \"source_ids\": [\n        \"ref.arxiv.2309.02390\"\n      ],\n      \"citation_keys\": [\n        \"Varma2023ExplainingGT\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/literature/2309.02390_opening.txt\"\n      ]\n    },\n    {\n      \"claim\": \"Kumar et al. study lazy-to-rich dynamics, including polynomial regression exhibiting grokking without regularization.\",\n      \"source_ids\": [\n        \"ref.arxiv.2310.06110\"\n      ],\n      \"citation_keys\": [\n        \"Kumar2023GrokkingAT\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/literature/2310.06110_opening.txt\"\n      ]\n    },\n    {\n      \"claim\": \"Davies et al. connect grokking and double descent through pattern-learning speeds and capacity variation.\",\n      \"source_ids\": [\n        \"ref.arxiv.2303.06173\"\n      ],\n      \"citation_keys\": [\n        \"Davies2023Unifying\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/literature/2303.06173_opening.txt\"\n      ]\n    },\n    {\n      \"claim\": \"Nakkiran et al. document nonmonotone generalization as model size or duration varies; the present narrow sweep does not establish double descent.\",\n      \"source_ids\": [\n        \"ref.arxiv.1912.02292\"\n      ],\n      \"citation_keys\": [\n        \"Nakkiran2020Double\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/literature/1912.02292_opening.txt\"\n      ]\n    },\n    {\n      \"claim\": \"AdamW decouples weight decay from adaptive loss-gradient updates; nominal shrinkage is not a measured complete dynamical clock.\",\n      \"source_ids\": [\n        \"ref.arxiv.1711.05101\"\n      ],\n      \"citation_keys\": [\n        \"Loshchilov2019AdamW\"\n      ],\n      \"evidence_refs\": [\n        \"source_evidence/literature/1711.05101_opening.txt\"\n      ]\n    }\n  ],\n  \"mapping_policy\": \"Host paper_data.json is read-only. Scientific raw pointers supplement selection identity IDs; no scalar search ID is used as substantive support for trajectory values. Final qualification remains failed with unknown cause.\"\n}\n","exit_code":0,"status":"completed"}}
