4) if best is None else np.asarray(best, dtype=np.int64)\n    return {\"removed\": _encode_u32(chosen), \"diagnostics\": {\"refits\": float(refits), \"k\": float(len(chosen))}}\n\n\ndef handle(request):\n    op = request.get(\"op\")\n    if op == \"reset\":\n        _STATE.clear()\n        _STATE.update(_fresh(request[\"seed\"]))\n        return {\"ok\": True}\n    if not _STATE:\n        raise RuntimeError(\"reset required\")\n    if op == \"load_chunk\":\n        a = _decode(request[\"a\"], np.uint16)\n        b = _decode(request[\"b\"], np.uint16, len(a))\n        y = _decode(request[\"y\"], np.uint8, len(a))\n        if request[\"chunk_index\"] != len(_STATE[\"chunks\"]):\n            raise ValueError(\"chunk out of order\")\n        _STATE[\"chunks\"].append((a, b, y))\n        _STATE.update(n_chunks=request[\"n_chunks\"], n_rows=request[\"n_rows_total\"], n_models=request[\"n_models\"])\n        return {\"ok\": True}\n    if op == \"analyze\":\n        if len(_STATE[\"chunks\"]) != _STATE[\"n_chunks\"]:\n            raise ValueError(\"table incomplete\")\n        return _analyze(request, _STATE)\n    raise ValueError(\"unknown op\")\n{\n \"results\": [\n  {\n   \"locator\": \"cases.F3.k_over_cap\",\n   \"messages\": [\n    \"Target path exists, but locator semantics were not interpreted by the base verifier.\"\n   ],\n   \"raw_reference\": \"@evidence[[derived/final_stats.json#cases.F3.k_over_cap]]\",\n   \"resolved_path\": \"derived/final_stats.json\",\n   \"status\": \"anchored\",\n   \"subject_kind\": \"text-artifact\",\n   \"subject_path\": \"paper.tex\",\n   \"target\": \"derived/final_stats.json\"\n  },\n  {\n   \"locator\": \"final_evaluation.evaluation_evidence.episodes\",\n   \"messages\": [\n    \"Target path exists, but locator semantics were not interpreted by the base verifier.\"\n   ],\n   \"raw_reference\": \"@evidence[[paper_data.json#final_evaluation.evaluation_evidence.episodes]]\",\n   \"resolved_path\": \"paper_data.json\",\n   \"status\": 