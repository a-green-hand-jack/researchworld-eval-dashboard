{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport json, re, math\nimport numpy as np\nfrom scipy.stats import binomtest,t\nfrom pathlib import Path\npaper=json.loads(Path('paper_data.json').read_text()); analysis=json.loads(Path('analysis_results.json').read_text()); claims=json.loads(Path('claims_grounding.json').read_text())['claims']; tex=Path('paper.tex').read_text(); episodes=paper['final_evaluation']['evaluation_evidence']['episodes']; errors=[]\nlabels={'Score control':'candidate','PPI++':'ppi_plus_plus_mean','PPI':'prediction_powered_mean','Label normal':'labeled_only_asymptotic_mean','Exact binomial':'labeled_only_exact_binomial'}\nfor position, case in enumerate(analysis['cases']):\n    records=[episode['solution']['cases'][position] for episode in episodes]\n    assert all(record['case']==position+1 for record in records)\n    assert case['truths']==sorted(set(record['truth'] for record in records))\n    widths={}\n    for method, stated in case['methods'].items():\n        endpoints=[record['response'] if method=='candidate' else record['baselines'][method] for record in records]\n        values=np.array([item['upper']-item['lower'] for item in endpoints]); widths[method]=values\n        covers=[item['lower']<=record['truth']<=item['upper'] for item,record in zip(endpoints,records)]\n        interval=binomtest(sum(covers),len(covers)).proportion_ci(method='exact')\n        for key, actual in [('coverage',np.mean(covers)),('covered',sum(covers)),('coverage_lower95',interval.low),('coverage_upper95',interval.high),('zero_width_count',sum(values==0))]:\n            if not math.isclose(stated[key],actual,abs_tol=1e-12): errors.append((position,method,key))\n        assert np.allclose(stated['widths'],values,atol=1e-14)\n        assert math.isclose(stated['width']['mean'],np.mean(values),abs_tol=1e-12)\n    for method, stated in case['differences'].items():\n        values=widths['candidate']-widths[method]; mean=np.mean(values); margin=t.ppf(.975,len(values)-1)*np.std(values,ddof=1)/np.sqrt(len(values))\n        for key,actual in [('mean',mean),('lower95',mean-margin),('upper95',mean+margin)]:\n            if not math.isclose(stated[key],actual,abs_tol=1e-12): errors.append((position,method,key))\n    for record in records:\n        assert record['baselines']['full_range_sanity_interval']['lower']==0 and record['baselines']['full_range_sanity_interval']['upper']==1\nmarginal_count=paired_count=0\nfor line in tex.splitlines():\n    if not line.startswith('C') or '&' not in line: continue\n    fields=[item.strip() for item in line.rstrip(' \\\\\\\\').split('&')]\n    if len(fields)==5:\n        case=int(fields[0][1:])-1; method=labels[fields[1]]; value=analysis['cases'][case]['methods'][method]\n        expected=[f\\\"{value['coverage']:.3f} [{value['coverage_lower95']:.3f}, {value['coverage_upper95']:.3f}]\\\",f\\\"{value['width']['mean']:.5f}\\\",str(value['zero_width_count'])]\n        if fields[2:]\"'!=expected: errors.append(('\"'tex-marginal',line,expected))\n        marginal_count+=1\n    elif len(fields)==4:\n        case=int(fields[0][1:])-1; method=labels[fields[1]]; value=analysis['cases'][case]['differences'][method]\n        expected=[f\\\"{value['mean']:+.6f}\\\",f\\\"[{value['lower95']:+.6f}, {value['upper95']:+.6f}]\\\"]\n        if fields[2:]\"'!=expected: errors.append(('\"'tex-paired',line,expected))\n        paired_count+=1\nfor name,metric,fmt in [('coverage','coverage','.3f'),('width','width','.5f')]:\n    for line in Path(f'tables/{name}.tex').read_text().splitlines():\n        if not re.match(r'C\\\\d',line):continue\n        fields=[item.strip() for item in line.rstrip(' \\\\\\\\').split('&')]; case=analysis['cases'][int(fields[0][1:])-1]\n        expected=[format(case['methods'][method][metric]['mean'] if metric=='width' else case['methods'][method][metric],fmt) for method in labels.values()]\n        if fields[1:]\"'!=expected:errors.append(('\"'main-table',name,line,expected))\nassert analysis['seeds']==list(range(1001,1257));assert len(episodes)==256\nassert math.isclose(np.mean([case['methods']['candidate']['coverage'] for case in analysis['cases']]),paper['final_evaluation']['metrics']['coverage'],abs_tol=1e-12)\nassert math.isclose(np.mean([case['methods']['candidate']['width']['mean'] for case in analysis['cases']]),paper['final_evaluation']['metrics']['mean_width'],abs_tol=1e-12)\nprint('Verified raw endpoint-derived summaries for 7 conditions and 5 methods; 35 supplementary marginal rows; 28 supplementary paired rows; 14 main table rows; seeds; pooled coverage and width.')\nprint('Discrepancies:',errors)\nprint('Missing grounding source IDs:',sorted({source for claim in claims for source in claim['source_ids'] if source not in paper['grounding_sources']}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
