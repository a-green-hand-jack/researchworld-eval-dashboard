 \"raw_reference\": \"@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\",\n      \"resolved_path\": \"paper_data.json\",\n      \"status\": \"anchored\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/openllm_complete.tex.prov.json\",\n      \"target\": \"paper_data.json\"\n    },\n    {\n      \"messages\": [\n        \"generated_by.script_path exists.\"\n      ],\n      \"raw_reference\": \"<generated_by.script_path>\",\n      \"resolved_path\": \"scripts/build_results.py\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"manifest\",\n      \"subject_path\": \"tables/openllm_complete.tex.prov.json\",\n      \"target\": \"scripts/build_results.py\"\n    },\n    {\n      \"locator\": \"/final_evaluation/evaluation_evidence/episodes\",\n      \"messages\": [\n        \"Target path exists, but locator semantics were not interpreted by the base verifier.\"\n      ],\n      \"raw_reference\": \"@evidence[[paper_data.json#/final_evaluation/evaluation_evidence/episodes]]\",\n      \"resolved_path\": \"paper_data.json\",\n      \"status\": \"anchored\",\n      \"subject_kind\": \"ledger-entry\",\n      \"subject_path\": \"scientific-evidence/ledger.jsonl:1\",\n      \"target\": \"paper_data.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[claims_grounding.json]]\",\n      \"resolved_path\": \"claims_grounding.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"ledger-entry\",\n      \"subject_path\": \"scientific-evidence/ledger.jsonl:1\",\n      \"target\": \"claims_grounding.json\"\n    },\n    {\n      \"messages\": [\n        \"Target path exists.\"\n      ],\n      \"raw_reference\": \"@evidence[[figure_manifest.json]]\",\n      \"resolved_path\": \"figure_manifest.json\",\n      \"status\": \"resolved\",\n      \"subject_kind\": \"ledger-entry\",\n      \"subject_path\": \"scientific-evidence/ledger.jsonl:1\",\